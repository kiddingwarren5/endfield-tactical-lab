"101","115","122","130","137","144","151","155","158","162"]},{"label":"每点敏捷增加的治疗值","values":[0.17,0.2,0.24,0.27,0.29,0.3,0.32,0.34,0.35,0.36,0.37,0.38],"raw":["0.17","0.2","0.24","0.27","0.29","0.3","0.32","0.34","0.35","0.36","0.37","0.38"]}]},"rawRows":[]},"ultimate":{"name":"晨星的协奏曲","type":"终结技","description":"治疗全队，同时进入高歌姿态，持续释放舞台焰火造成电磁伤害，随后引发华彩爆点，对大范围内的敌人造成电磁伤害，并强制施加导电。\n高歌姿态：代替演唱姿态，持续期间提升全队攻击力，并施加受意志提升的电磁增幅和自然增幅。歌声对范围内的敌人持续造成电磁伤害，并持续治疗范围内的友方干员。结束时，对范围内敌人造成3倍单次歌声伤害，并为全队回复3倍单次治疗量的生命值，提前结束时该效果不会生效。\n持续期间战技替换为姿态中止，施放将提前结束高歌姿态且不消耗技力。","segments":[{"id":"ultimate1","label":"舞台焰火伤害倍率","ratio":[142,156,171,185,199,213,228,242,256,274,295,320],"element":"electric","elementOrigin":"description","kind":"ultimate"},{"id":"ultimate2","label":"华彩爆点伤害倍率","ratio":[284,313,341,370,398,427,455,483,512,547,590,640],"element":"electric","elementOrigin":"description","kind":"ultimate"},{"id":"ultimate3","label":"单次歌声伤害倍率","ratio":[27,29,32,35,37,40,42,45,48,51,55,60],"element":"electric","elementOrigin":"description","kind":"ultimate"}],"params":{"energyCost":[{"label":"所需终结技能量","values":[160,160,160,160,160,160,160,160,160,160,160,160],"raw":["160","160","160","160","160","160","160","160","160","160","160","160"]}],"cooldown":[{"label":"冷却时间","values":[20,20,20,20,20,20,20,20,20,20,20,20],"raw":["20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒"]}],"modifier":[{"label":"攻击力提升","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10%","10%","10%","10%","10%","10%","10%","10%","10%","10%","10%","10%"]},{"label":"每点意志提升的增幅效果","values":[0.018,0.02,0.021,0.023,0.025,0.027,0.028,0.03,0.032,0.034,0.037,0.04],"raw":["0.018%","0.02%","0.021%","0.023%","0.025%","0.027%","0.028%","0.03%","0.032%","0.034%","0.037%","0.04%"]},{"label":"意志提升的增幅上限","values":[40,40,40,40,45,45,45,45,45,50,55,60],"raw":["40%","40%","40%","40%","45%","45%","45%","45%","45%","50%","55%","60%"]}],"heal":[{"label":"初次治疗基础治疗值","values":[324,389,454,518,551,583,616,648,680,697,713,729],"raw":["3