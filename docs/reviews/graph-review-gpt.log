// 图谱校验：node tools/validate_graph.mjs —— 构图、按词表与引用关系校验、写出 docs/graph-report.md。errors 非空时退出码 1。
import fs from 'node:fs';
import operators from '../dist/data/operators.js'; import weapons from '../dist/data/weapons.js'; import gear from '../dist/data/gear.js'; import sets from '../dist/data/sets.js'; import consumables from '../dist/data/consumables.js'; import effects from '../dist/data/effects.js'; import mechanics from '../dist/data/mechanics.js';
import {buildGraph} from '../dist/engine/graph.js';
export const DATA={operators,weapons,gear,sets,consumables,effects,mechanics};
export function graphReport(g,res){
  const L=[]; L.push('# 图谱报告（由 tools/validate_graph.mjs 生成）',`\n生成：${new Date().toISOString()}`,'\n## 规模\n','| 节点类型 | 数量 |','|---|---|',...Object.entries(res.stats.nodes).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`| ${k} | ${v} |`),'','| 关系 | 数量 |','|---|---|',...Object.entries(res.stats.edges).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`| ${k} | ${v} |`));
  L.push('\n## 校验\n',`错误 ${res.errors.length} 条，待裁定 ${res.warnings.length} 条。`,...res.errors.map(e=>`- 错误：${e}`),...res.warnings.map(w=>`- 待裁定：${w}`));
  const byKind={}; for(const n of g.nodes.values()) if(n.type==='effect'){ const k=n.ref.owner?.kind; byKind[k]=byKind[k]||{}; byKind[k][n.conditionality]=(byKind[k][n.conditionality]||0)+1; }
  L.push('\n## 效果条件性（配装分析用：static 看面板就能算，其余取决于轴）\n','| 来源 | static | eventDriven | stateDriven | handled | unmodeled | informational |','|---|---|---|---|---|---|---|',...Object.entries(byKind).map(([k,c])=>`| ${k} | ${c.static||0} | ${c.eventDriven||0} | ${c.stateDriven||0} | ${c.handled||0} | ${c.unmodeled||0} | ${c.informational||0} |`));
  L.push('\n## 套装与武器：是否受轴影响\n','| 物品 | 全队唯一 | static | 受轴影响 | 不算 |','|---|---|---|---|---|');
  for(const n of [...g.nodes.values()].filter(x=>x.type==='gearSet'||x.type==='weapon').sort((a,b)=>a.type.localeCompare(b.type)||a.label.localeCompare(b.label))){ const s=g.itemSensitivity(n.id); const total=Object.values(s.counts).reduce((a,b)=>a+b,0); if(!total) continue; L.push(`| ${n.label} | ${n.teamUnique?'是':''} | ${s.counts.static} | ${s.counts.eventDriven+s.counts.stateDriven+s.counts.handled} | ${s.counts.unmodeled+s.counts.informational} |`); }
  L.push('\n## 连携技发动条件与能满足它的人（硬依赖）\n','| 干员 | 条件 | 能满足的人 |','|---|---|---|');
  for(const n of [...g.nodes.values()].filter(x=>x.type==='operator'&&!x.preview)){ const reqs=g.comboRequirements(n.ref.id); for(const r of reqs){ const cond=[r.type,r.element?flat(r.element).join('/'):'',r.min?`≥${r.min}`:'',r.anomalies?r.anomalies.join('/'):'',r.event||'',r.state||'',r.requires?r.requires.join('+'):''].filter(Boolean).join(' '); const who=r.providers.map(p=>p.label).filter((x,i,a)=>a.indexOf(x)===i); L.push(`| ${n.label}${r.alt?'（或）':''} | ${cond} | ${who.length?who.slice(0,12).join('、')+(who.length>12?' …':''):'无'} |`); } }
  const tu=[...g.nodes.values()].filter(x=>x.type==='effect'&&x.teamUnique).map(x=>x.label); L.push('\n## 全队唯一（同名不叠加）的效果\n',...tu.map(x=>`- ${x}`));
  return L.join('\n');
}
