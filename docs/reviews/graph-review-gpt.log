    40	      if(m.zone==='other'&&(m.unit==='x'||/倍/.test(m.literal||''))&&mv>0){ target.value=target.value*mv; target.label=`${target.label} ×${mv}（${m.owner?.ref||m.name}）`; target.modifiedBy=[...(target.modifiedBy||[]),m.id]; }
    41	      else if(m.zone===target.effect.zone&&typeof mv==='number'){ target.value=target.value+mv; target.label=`${target.label} +${mv}（${m.owner?.ref||m.name}）`; target.modifiedBy=[...(target.modifiedBy||[]),m.id]; } } }
    42	}
    43	export function appliedFor({candidates,seg,segIndex=null,bIdx=0,toggles={},data,overrides,stacks,vars,memberModes={}}){
    44	  const applied=[]; const ctx={data,overrides,stacks,vars};
    45	  for(const c of candidates){ const e=c.effect; if(!effectApplies(e,seg)) continue; if(Array.isArray(e.modifies)&&e.modifies.length&&!e.fragileMultiplier) continue; // modifiers are folded into their targets
    46	    const st=segmentStatus(c,seg,segIndex,bIdx); if(st==='disabled') continue; if(st!=='auto'&&!isOn(e,toggles)) continue; const {value,dependency}=resolveValue(c,ctx); applied.push({effect:e,value,label:e.name,ownerIdx:c.ownerIdx,dependency,mode:st==='auto'?'segment-auto':(e.condition?.mode||'auto')}); }
    47	  applyModifiers(applied,candidates,toggles,ctx);
    48	  return applied;
43:n = 触发时消耗的附着/破防层数（1–4）。90 级等级系数：法术 1+(90−1)/196 = 1.45408；物理 1+(90−1)/392 = 1.22704（与解包 attr 49 / 25 的 90 级值一致）。【研究 + 解包】
49:| 碎冰 | 120%(1+n) | 研究用法术等级系数 |
53:- 机制伤害按**触发者**攻击力/等级/技艺结算；碎冰归属打碎冻结者。【研究】
54:- n 的定义按机制：异常初始伤害 n=消耗层数；碎冰取冻结时的等级；击飞/倒地固定；强制施加的异常没有初始伤害（官方教学）。异常可暴击、DoT 不可（研究，单一来源）；异常只吃属性类增伤，不吃“战技/连携/终结技伤害加成”（研究 + 封测实测）。
111:### C16 法术附着与异常
112:- 物理侧：首次物理异常只施加破防不造成伤害；击飞/倒地 +1 层破防、10 失衡；猛击/碎甲消耗全部破防；碎冰由对冻结目标施加破防或物理异常触发（官方教学）。
113:- 常规附着上限 4 层；同属性再施加 → 法术爆发（不需 4 层）；不同属性 → 由后施加属性决定异常（灼热→燃烧、电磁→导电、寒冷→冻结、自然→腐蚀），消耗原附着；异常等级 = 消耗层数（≤4）。【官方教学】
114:- 附着自然消退时间**未确认**。
161:1. 非主控自动普攻衰减与频率；2. 附着消退时间（单一来源 20 s）；3. 伤害跳字取整；4. 充能效率上限与百分比回能道具是否吃效率；5. 食药同类叠加（单一来源：只生效一个、后吃覆盖）；6. 长息/拓荒多人取值与刷新；7. 返还技力消耗顺序；8. 食药固定攻击位置；9. 别礼二天赋是否放大法术脆弱。

