   104	export function teamUniqueConflicts(g,itemNodeIds){ const byEffect={}; for(const id of itemNodeIds) for(const e of g.out(id,'hasEffect')){ const n=g.node(e.to); if(n.teamUnique) (byEffect[n.ref.id]=byEffect[n.ref.id]||[]).push(id); } return Object.entries(byEffect).filter(([,ids])=>ids.length>1).map(([effect,ids])=>({effect,items:ids})); }
