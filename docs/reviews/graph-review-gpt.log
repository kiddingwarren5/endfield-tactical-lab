","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}]},"rawRows":[]},"ultimate":{"name":"大当家盯着呢！","type":"终结技","description":"汤汤揭开眼罩，释放眼中的古老图形，对范围内的敌人施加一段时间的定身，并造成持续的寒冷伤害。\n古老图形演化结束时降下巨浪，对范围内敌人造成大量寒冷伤害。\n若主控干员在古老图形中下落攻击，会提前结束演化降下巨浪，巨浪造成的寒冷伤害提升。","segments":[{"id":"ultimate1","label":"持续伤害总倍率","ratio":[142,156,171,185,199,213,228,242,256,274,295,320],"element":"cold","elementOrigin":"description","kind":"ultimate"},{"id":"ultimate2","label":"巨浪伤害倍率","ratio":[178,196,213,231,249,267,284,302,320,342,369,400],"element":"cold","elementOrigin":"description","kind":"ultimate"},{"id":"ultimate3","label":"提前降下巨浪伤害倍率","ratio":[311,342,373,404,436,467,498,529,560,599,646,700],"element":"cold","elementOrigin":"description","kind":"ultimate"}],"params":{"energyCost":[{"label":"所需终结技能量","values":[90,90,90,90,90,90,90,90,90,90,90,90],"raw":["90","90","90","90","90","90","90","90","90","90","90","90"]}],"cooldown":[{"label":"冷却时间","values":[20,20,20,20,20,20,20,20,20,20,20,20],"raw":["20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒","20秒"]}],"duration":[{"label":"古老图形持续时间（秒）","values":[4,4,4,4,4,4,4,4,4,4,4,4],"raw":["4","4","4","4","4","4","4","4","4","4","4","4"]}],"poise":[{"label":"巨浪失衡值","values":[15,15,15,15,15,15,15,15,15,15,15,15],"raw":["15","15","15","15","15","15","15","15","15","15","15","15"]},{"label":"提前降下巨浪失衡值","values":[20,20,20,20,20,20,20,20,20,20,20,20],"raw":["20","20","20","20","20","20","20","20","20","20","20","20"]}]},"rawRows":[]}},"talents":[{"name":"肝胆相照","stages":[{"stage":"肝胆相照·一","description":"涡流附近5米范围内，友方干员获得10%加速，敌人受到20%缓速，\n离开范围后该效果持续3秒。","unlock":"晋升至精英化阶段1"},{"stage":"肝胆相照·二","description":"涡流附近5米范围内，友方干员获得20%加速，敌人受到40%缓速，\n离开范围后该效果持续3秒。","unlock":"晋升至精英化阶段2"}]},{"name":"呼风唤浪","stages":[{"stage":"呼风唤浪·一","description":"主控干员在古老图形中进行下落攻击，提前结束演化时，形成一个\n水龙卷，并消耗附近所有涡流使其形成额外的水龙卷。\n 此次形成的水龙卷效果同战技踏潮卷浪！，造成的伤害+40%。","unlock":"晋升至精英化阶段2"},{"stage":"呼风唤浪·二","description":"主控干员在古老图形中进行下落攻击，提前结束演化时，形成一个\n水龙卷，并消耗附近所有涡流使其形成额外的水龙卷。\n 此次形成的水龙卷效果同战技踏潮卷浪！，造成的伤害+60%。","unlock":"晋升至精英化阶段3"}]}],"potentials":[{"level":1,"name":"财宝储备","description":"连携技河水，助我！的伤害倍率提升至原本的1.2倍，冷却时间-2秒。 战技踏潮卷浪！每消耗一处涡流形成水龙卷，额外返还5点技力。"},{"level":2,"name":"河流的女儿","description":"敏捷+20，寒冷伤害+10%。"},{"level":3,"name":"当家气魄","description":"战技踏潮卷浪！伤害倍率提升至原本的1.1倍，且同时形成多个水龙卷时造成的法术脆弱效果额外+5%。"},{"level":4,"name":"清波修炼法","description":"终结技大当家盯着呢！所需的终结技能量-15%。"},{"level":5,"name":"魔眼效能","description":"终结技大当家盯着呢！的伤害倍率提升至原本的1.15倍。 天赋呼风唤浪效果加强：终结技大当家盯着呢！形成的水龙卷伤害提升效果额外+80%。"}],"source":{"official":{"itemId":"1130","url":"https://wiki.skland.com/endfield/detail?mainTypeId=1&subTypeId=1&gameEntryId=1130&header=0","fetchedAt":"2026-10-28T09:29:36.005Z"},"mined":{"id":"chr_0027_tangtang","version":"1.6","slug":"tangtang"}}},{"id":"chr_0030_zhuangfy","itemId":"1132","name":"庄方宜","rarity":6,"profession":"assault","element":"electric","weaponType":"arts","mainAttr":"will","subAttr":"int","icon":"./assets/icons/operators/1132.png","base90":{"hp":5495,"atk":326,"str":99,"agi":99,"int":123,"will":184},"exact90":{"hp":5495,"atk":326,"str":99,"agi":99,"int":123.91142436356016,"will":184.27940248264306,"critRate":0.05,"artsLevelFactor":1.45408163265306,"physicalLevelFactor":1.22704081632653,"extra":{"12":10,"15":100,"90":10}},"talentStats":{"will":60},"skills":{"normal":{"name":"疾电法","type":"普通攻击","description":"普通攻击：\n对敌人进行至多5段攻击，造成电磁伤害。作为主控干员时，重击会造成18点失衡。\n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成电磁伤害。\n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量电磁伤害并恢复一定技力。","segments":[{"id":"normal1","label":"普攻第一段倍率","ratio":[16,18,19,21,22,24,26,27,29,31,33,36],"element":"electric","elementOrigin":"description","kind":"normal"},{"id":"normal2","label":"普攻第二段倍率","ratio":[24,26,29,31,34,36,38,41,43,46,50,54],"element":"electric","elementOrigin":"description","kind":"normal"},{"id":"normal3","label":"普攻第三段倍率","ratio":[32,35,39,42,45,48,52,55,58,62,67,72],"element":"electric","elementOrigin":"description","kind":"normal"},{"id":"normal4","label":"普攻第四段倍率","ratio":[45,50,54,59,63,68,72,77,81,87,93,101],"element":"electric","elementOrigin":"description","kind":"normal"},{"id":"normal5","label":"普攻第五段倍率","ratio":[48,53,58,62,67,72,77,82,86,92,100,108],"element":"electric","elementOrigin":"description","kind":"normal"},{"id":"normal6","label":"处决攻击倍率","ratio":[400,440,480,520,560,600,640,680,720,770,830,900],"element":"electric","elementOrigin":"description","kind":"normal"},{"id":"normal7","label":"下落攻击倍率","ratio":[80,88,96,104,112,120,128,136,144,154,166,180],"element":"electric","elementOrigin":"description","kind":"normal"}],"params":{},"rawRows":[]},"skill":{"name":"惊霆诀","type":"战技","description":"消耗目标的导电状态，使本次战技伤害倍率提高，并生成相当于所消耗导电的异常等级+1柄青霆剑，若现存的青霆剑少于3柄，即使未消耗目标的导电状态仍能生成1柄青霆剑。\n随后引导附近的青霆剑依次雷击目标，造成电磁伤害并额外获得终结技能量，最后一次雷击造成6倍伤害。\n一次战技最多生成3柄青霆剑。","segments":[{"id":"skill1","label":"雷击伤害倍率","ratio":[20,22,24,26,28,30,32,34,36,39,42,45],"element":"electric","elementOrigin":"description","kind":"skill"},{"id":"skill2","label":"消耗每级导电额外伤害倍率","ratio":[3,4,4,4,5,5,5,6,6,7,8,9],"element":"electric","elementOrigin":"description","kind":"skill","per":"unit"},{"id":"skill3","label":"终结技期间雷击伤害倍率","ratio":[36,40,43,47,50,54,58,61,65,69,75,81],"element":"electric","elementOrigin":"description","kind":"skill"},{"id":"skill4","label":"终结技期间消耗每级导电额外伤害倍率","ratio":[8,9,10,11,11,12,13,14,15,16,17,18],"element":"electric","elementOrigin":"description","kind":"skill","per":"unit"}],"params":{"spCost":[{"label":"技力消耗","values":[100,100,100,100,100,100,100,100,100,100,100,100],"raw":["100","100","100","100","100","100","100","100","100","100","100","100"]}],"poise":[{"label":"总失衡值","values":[15,15,15,15,15,15,15,15,15,15,15,15],"raw":["15","15","15","15","15","15","15","15","15","15","15","15"]}],"energyGain":[{"label":"每次雷击额外终结技能量","values":[6,6,6,6,6,6,6,6,6,6,6,6],"raw":["6","6","6","6","6","6","6","6","6","6","6","6"]}],"modifier":[{"label":"青霆剑数量限制","values":[9,9,9,9,9,9,9,9,9,9,9,9],"raw":["9","9","9","9","9","9","9","9","9","9","9","9"]}],"duration":[{"label":"青霆剑存在时间（秒）","values":[36,36,36,36,36,36,36,36,36,36,36,36],"raw":["36","36","36","36","36","36","36","36","36","36","36","36"]}]},"rawRows":[]},"combo":{"name":"一息万变","type":"连携技","description":"主控干员的重击或处决，命中处于电磁附着状态的敌人后可以发动。\n构造息雷阵法攻击敌人，造成电磁伤害。命中处于电磁附着的敌人时，消耗其电磁附着，强制施加导电，并基于消耗的层数额外获得终结技能量。\n若强制施加导电时，敌人已处于导电状态，则所施加导电的异常等级+1。","segments":[{"id":"combo1","label":"伤害倍率","ratio":[160,176,192,208,224,240,256,272,288,308,332,360],"element":"electric","elementOrigin":"description","kind":"combo"},{"id":"combo2","label":"终结技期间伤害倍率","ratio":[240,264,288,312,336,360,384,408,432,462,498,540],"element":"electric","elementOrigin":"description","kind":"combo"}],"params":{"cooldown":[{"label":"冷却时间","values":[18,18,18,18,18,18,18,18,18,18,18,17],"raw":["18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","17秒"]}],"poise":[{"label":"失衡值","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}],"energyGain":[{"label":"获得终结技能量","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]},{"label":"消耗每层附着额外终结技能量","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}]},"rawRows":[]},"ultimate":{"name":"万钧风雷","type":"终结技","description":"进入天理合真状态：\n普通攻击得到强化。自身行动更不容易被打断。\n战技惊霆诀伤害倍率提高，伤害范围扩大，最后一次雷击命中时施加电磁附着。\n连携技一息万变对一定范围内的敌人生效，伤害倍率提高，冷却恢复速度提升至原本的4倍。\n首次施放战技惊霆诀不消耗技力与导电，若存在目标，则无论其是否处于导电状态，必定生成3柄青霆剑。\n作为主控干员时，终结技期间普攻第三段后会造成18点失衡。","segments":[{"id":"ultimate1","label":"终结技期间普攻第一段倍率","ratio":[67,73,80,86,93,100,106,113,120,128,138,150],"element":"electric","elementOrigin":"operator","kind":"ultimate"},{"id":"ultimate2","label":"终结技期间普攻第二段倍率","ratio":[94,103,112,122,131,140,150,159,168,180,194,210],"element":"electric","elementOrigin":"operator","kind":"ultimate"},{"id":"ultimate3","label":"终结技期间普攻第三段倍率","ratio":[134,147,160,174,187,200,214,227,240,257,277,300