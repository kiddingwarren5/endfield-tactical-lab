   126	    const tr=m.combo?.trigger; if(tr){ for(const t of [tr,...(tr.or||[])]){ if(!V.COMBO_TRIGGER_TYPES.includes(t.type)) err('连携条件类型',`${o.name} ${t.type}`); if(t.type==='custom'&&t.event&&!V.CUSTOM_EVENTS.includes(t.event)) err('自定义事件',`${o.name} ${t.event}`); for(const a of (t.anomalies||[])) if(![...V.ABNORMALS.arts,...V.ABNORMALS.physical].includes(a)) err('连携异常条件',`${o.name} ${a}`); }
   127	      const reqs=comboRequirements(g,o.id); if(reqs.length&&reqs.every(r=>!r.providers.length)) warn('连携条件无人能满足',`${o.name}：${reqs.map(r=>r.type+(r.event?'/'+r.event:'')).join('，')}`); } }
   128	  const stats={nodes:{},edges:{}}; for(const n of g.nodes.values()) stats.nodes[n.type]=(stats.nodes[n.type]||0)+1; for(const e of g.edges) stats.edges[e.rel]=(stats.edges[e.rel]||0)+1;
   129	  return {errors,warnings,stats};
