   120	    if(e.teamUnique&&o.kind==='operator') warn('干员自带效果标了全队唯一',e.id);
   121	    for(const m of (e.modifies||[])) if(!effects.some(x=>x.id===m)) err('modifies 引用',`${e.id} → ${m}`); }
