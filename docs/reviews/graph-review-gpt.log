   111	const PREFIX={'intGeWill&':0,'willGtInt&':1};
   112	// 返回 {specs:[...], modeGate, code} 或 null（无代码）
   113	export function specFor(code){
   114	  if(!code||code==='always') return null;
   115	  let gate=null, key=code; for(const [p,m] of Object.entries(PREFIX)){ if(code.startsWith(p)){ gate=m; break; } }
   116	  let raw=TRIGGERS[key]; if(raw===undefined&&gate!=null){ raw=TRIGGERS[key.slice(key.indexOf('&')+1)]; }
   117	  if(raw===undefined) return {code,specs:null,modeGate:gate,unknown:true};
   118	  const specs=Array.isArray(raw)?raw:[raw];
   119	  return {code,specs,modeGate:gate};
   120	}
   121	export function triggerCoverage(effects){
   122	  const rows=[]; for(const e of effects){ const code=e.condition?.trigger; if(!code||code==='always') continue; const s=specFor(code); let kind=!s||s.unknown?'unknown':s.specs.some(x=>x.on)?'event':s.specs.some(x=>x.state)?'state':s.specs.some(x=>x.handled)?'handled':'unmodeled'; if((kind==='event'||kind==='state')&&e.zone==='other') kind='event-noop'; /* “其他”区的效果触发了也不进伤害/资源结算 */ rows.push({id:e.id,code,kind,reason:s?.specs?.find(x=>x.unmodeled)?.unmodeled||''}); }
   123	  return rows;
   124	}
     1	# 效果目录（Effect Catalog）编写规范
     2	
     3	每条效果是一个 JSON 对象，放入对应文件的数组中。只录入**与伤害/属性/资源/输出节奏有关**的效果；纯治疗/护盾/移动速度/后勤效果不录（但可在 `notes` 提一句“未录入：治疗”）。
     4	
     5	```json
     6	{
     7	  "id": "wpn_claym_0013.p1",                 // 稳定 id：<实体id>.<短名>；同一实体多条用 p1/p2 或语义名
     8	  "owner": {"kind": "weapon", "id": "wpn_claym_0013", "name": "赫拉芬格"},
     9	  "name": "赫拉芬格 · 战技施加寒冷附着后",     // 界面显示名（中文，带来源前缀）
    10	  "literal": "寒冷伤害+{v}%",                // 原文的效果类型短语，保留原措辞（用于日后重新归区）
    11	  "zone": "bonus",                           // 见下表
    12	  "stat": null,                              // zone 为 stat 类时填 str/agi/int/will/main/all/atkPct/atkFlat/critRate/critDmg/chargeEff/artsStrength/hpPct
    13	  "value": {"byRank": [10,12,14,16,18,20,22,24,28]},   // 或 {"fixed": 16} / {"perStack": 8, "maxStacks": 4} / {"formula": "8+3*layers", "vars": ["layers"]} / {"dependsOn": {"attr": "int", "of": "owner", "base": 24, "per": 0.03, "cap": 36}}
    14	  "unit": "%",                               // "%" 或 "flat"
    15	  "beneficiary": "self",                     // self | team | others(队友不含自己) | mainControl | target(作用于敌人的减益)
    16	  "applies": {"elements": ["cold"], "kinds": ["normal","skill","combo","ultimate","mech"], "damageClass": "any"},
    17	  "condition": {"text": "装备者通过战技施加寒冷附着时", "trigger": "afterSkillAttach", "mode": "user"},
    18	  "duration": 15, "stacking": "none",        // none(无法叠加/刷新) | stack | highest | independent(每层单独计时)
    19	  "exclusiveGroup": null, "teamUnique": false, "oncePerBattle": false, "cooldown": null,
    20	  "evidence": {"text": "装备者通过战技施加寒冷附着时，获得寒冷伤害+10.0%，持续15秒。", "category": "official", "where": "weapons.json skills[2].rankTexts"},
    21	  "notes": "两种效果独立生效"
    22	}
    23	```
    24	
    25	## zone 取值与判定规则（按原文措辞）
    26	| zone | 原文典型措辞 | 说明 |
    27	|---|---|---|
    28	| `bonus` | “X伤害+N%”“所有技能伤害+N%”“战技/连携技/终结技/普通攻击伤害+N%”“造成的伤害+N%”“物理/法术伤害+N%”“对失衡/破防目标伤害+N%” | 增伤区，同区加算。`literal` 保留原措辞以便区分子类 |
    29	| `amp` | 明确写“增幅”（寒冷增幅/法术增幅/灼热增幅…） | 增幅区 |
    30	| `fragile` | 明确写“脆弱”（寒冷脆弱/法术脆弱/物理脆弱…，施加在敌人身上） | 脆弱区，beneficiary=target |
    31	| `vulnerable` | “使目标受到的伤害+N%”“受到的X伤害+N%”（未写脆弱/增幅） | 易伤区，beneficiary=target |
    32	| `atkPct` / `atkFlat` | “攻击力+N%” / “攻击力+N” | stat 类，进面板攻击 |
    33	| `ability` | “力量+20”“全能力+22.4%”“主能力值+132” | stat=str/agi/int/will/main/all；unit=% 或 flat |
    34	| `critRate` / `critDmg` | “暴击率+N%”“暴击伤害+N%” | |
    35	| `chargeEff` | “终结技充能效率+N%” | |
    36	| `artsStrength` | “源石技艺强度+N” | |
    37	| `ratioMul` | “伤害倍率提升至原本的1.15倍”“伤害提升至原本的1.2倍” | value.fixed=1.15；applies.skills 写明哪个技能/段 |
    38	| `ratioAdd` | “伤害倍率+N%”（直接加倍率） | |
    39	| `spRefund` / `spRegen` | “返还N点技力”“恢复技力” | 资源 |
    40	| `energyCost` | “所需终结技能量-15%” | value 为负百分比 |
    41	| `energyGain` | “获得终结技能量+N” | |
    42	| `cdr` | “冷却时间-2秒”“冷却缩减+15%” | |
    43	| `poise` | 失衡值相关 | 只记录，不进伤害 |
    44	| `other` | 无法归类 | notes 写明 |
    45	
    46	## 其他规则
    47	- `value.byRank`：武器第三技能 9 个 Rank 各一个值（从 rankTexts 逐 Rank 提取，不要用公式推算）。
    48	- 干员天赋按最高阶（满天赋）录入，但 `stages` 字段可附各阶数值：`"stages": [{"stage":"·一","value":2},{"stage":"·二","value":4}]`。
    49	- 潜能逐条录入，`owner.potential: 2` 标明潜能等级；界面按潜能等级启用。
    50	- 一段原文含多个效果 → 拆成多条，id 加后缀。
    51	- 条件 `mode`：`auto`（配装即生效，如“所有技能伤害+56%”）、`user`（需用户勾选的命中条件）、`segment`（计算中按段顺序必然触发，如“连携技命中寒冷附着的敌人后”对该技能后续段生效）。
    52	- `teamUnique: true` 仅当原文写明“其他队友”“全队”且语义为同名不叠加（如长息）。
    53	- 依赖施加者属性的（赛希终结技智识）用 `dependsOn`，并写明 `of: "owner"`。
    54	- 不确定的归区，写入 `uncertain: true` 并在 notes 说明两种可能；不要猜数值。

