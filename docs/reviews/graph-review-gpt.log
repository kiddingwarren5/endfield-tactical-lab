   110	  for(const o of operators){ if(!V.ELEMENTS.includes(o.element)) err('干员元素',`${o.name} ${o.element}`); if(!V.PROFESSIONS.includes(o.profession)) err('干员职业',`${o.name} ${o.profession}`); if(!V.WEAPON_TYPES.includes(o.weaponType)) err('干员武器类型',`${o.name} ${o.weaponType}`); }
