// Merge sources/curated/effects-*.json into dist/data/effects.js with schema validation. Usage: node tools/build_effects.mjs
import fs from 'node:fs';
const ZONES=new Set(['bonus','amp','fragile','vulnerable','atkPct','atkFlat','ability','critRate','critDmg','chargeEff','artsStrength','ratioMul','ratioAdd','spRefund','spRegen','energyCost','energyGain','cdr','poise','other']);
const files=fs.readdirSync('sources/curated').filter(f=>/^effects-.*\.json$/.test(f)).sort();
const all=[]; const problems=[]; const ids=new Set();
for(const f of files){ let arr; try{ arr=JSON.parse(fs.readFileSync('sources/curated/'+f,'utf8')); }catch(e){ problems.push(`${f}: JSON 解析失败 ${e.message}`); continue; } if(!Array.isArray(arr)){ problems.push(`${f}: 不是数组`); continue; }
  for(const e of arr){ const where=`${f}#${e.id||'?'}`; if(!e.id){ problems.push(where+': 缺 id'); continue; } if(ids.has(e.id)){ problems.push(where+': id 重复'); continue; } ids.add(e.id);
    if(!e.owner?.kind||!e.owner?.id) problems.push(where+': 缺 owner'); if(!ZONES.has(e.zone)) problems.push(where+': zone 非法 '+e.zone); if(!e.value||typeof e.value!=='object'){ if(e.zone==='other'){ e.value={fixed:0}; e.informational=true; } else problems.push(where+': 缺 value'); }
    if(e.value?.byRank&&!Array.isArray(e.value.byRank)) problems.push(where+': byRank 非数组'); if(!e.beneficiary) problems.push(where+': 缺 beneficiary'); if(!e.evidence?.text) problems.push(where+': 缺 evidence.text');
    if(e.owner?.id==='official_89') e.owner.id='chr_0003_endminf_m'; if(e.owner?.id==='chr_0003_endminf'&&String(e.owner.itemId)==='89') e.owner.id='chr_0003_endminf_m';
    if(e.zone==='ratioMul'){ const v=e.value?.fixed; if(typeof v==='number'&&(v<0.3||v>8)) problems.push(where+': ratioMul 数值疑似不是倍数 '+v); e.unit='x'; }
    if(e.id==='chr_0026_lastrite.talent.brittle'){ // 别礼二天赋：终结技中“适用的寒冷脆弱”视为1.5倍；用户实测法术脆弱同样×1.5（见 rules.md H4）。引擎用 fragileMultiplier 对脆弱区全部项生效，仅限终结技。
      e.fragileMultiplier=1.5; e.applies={elements:['cold'],kinds:['ultimate'],damageClass:'any'}; e.condition={...(e.condition||{}),mode:'auto',text:'终结技临终别礼造成伤害时，目标处于寒冷脆弱/法术脆弱'}; e.evidence.category='official+user'; }
    e.file=f; all.push(e); } }
fs.mkdirSync('dist/data',{recursive:true});
fs.writeFileSync('dist/data/effects.js',`// Generated by tools/build_effects.mjs — do not edit.\nexport default ${JSON.stringify(all)};\n`);
fs.writeFileSync('docs/effects-build-report.md',`# 效果目录构建报告\n\n生成时间：${new Date().toISOString()}\n\n文件：${files.join(', ')}\n\n条数：${all.length}；uncertain：${all.filter(e=>e.uncertain).length}；问题：${problems.length}\n\n${problems.map(p=>'- '+p).join('\n')}\n`);
console.log('effects',all.length,'uncertain',all.filter(e=>e.uncertain).length,'problems',problems.length); if(problems.length) console.log(problems.slice(0,30).join('\n'));
# 武器与装备数据入口

- 官方干员及物品图鉴：https://wiki.skland.com/endfield/catalog?mainTypeId=1&subTypeId=1&filterIds=&header=0
- 全武器分类、名称及逐件详情：https://warfarin.wiki/cn/weapons
- 全装备套装、槽位、名称及逐件详情：https://warfarin.wiki/cn/gear

当前 Demo 只实现别礼、赫拉芬格及截图中的四件装备。武器与装备图标来自华法琳 Wiki 的 itemicon 静态资源，已复制到 dist/assets；当前道具的详情地址可从上述完整图鉴进入。华法琳 Wiki 是玩家维护的数据源；接入可更换装备时，应逐项对照官方图鉴并在本地版本化属性、精锻数组、套装效果和图标。

数据结构下一步需要按“道具 ID、名称、槽位/武器类型、等级、三条属性及各自精锻、套装效果/武器技能、潜能对应等级、图标来源”保存，而不是把当前装备对象写死在计算器中。
