skill {"description":"骑上多利先生冲撞目标，对目标造成自然伤害，若目标处于腐蚀状态，消耗其腐蚀状态，并对其施加物理脆弱与法术脆弱。","params":{"spCost":[{"label":"技力消耗","values":[100,100,100,100,100,100,100,100,100,100,100,100],"raw":["100","100","100","100","100","100","100","100","100","100","100","100"]}],"poise":[{"label":"失衡值","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}],"modifier":[{"label":"脆弱效果","values":[12,12,12,13,13,13,14,14,16,17,18,20],"raw":["12%","12%","12%","13%","13%","13%","14%","14%","16%","17%","18%","20%"]}],"duration":[{"label":"脆弱持续时间（秒）","values":[30,30,30,30,30,30,30,30,30,30,30,30],"raw":["30","30","30","30","30","30","30","30","30","30","30","30"]}]}}
combo {"description":"当主控干员对不处于破防或法术附着状态的敌人造成重击后可以发动。\n发射一团火山云抛向目标敌人，到达目标身边后对目标造成自然伤害。火山云会跟踪目标，短暂延迟后爆炸，对周围其他敌人造成一半的自然伤害，并强制施加短暂的腐蚀。","params":{"cooldown":[{"label":"冷却时间","values":[18,18,18,18,18,18,18,18,18,18,18,17],"raw":["18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","18秒","17秒"]}],"poise":[{"label":"失衡值","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}],"duration":[{"label":"腐蚀持续时间（秒）","values":[7,7,7,7,7,7,7,7,7,7,7,7],"raw":["7","7","7","7","7","7","7","7","7","7","7","7"]}],"energyGain":[{"label":"获得终结技能量","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}]}}
ultimate {"description":"艾尔黛拉进入可移动的持续施法状态，召唤多利先生的帮助，随机向四周散射多利先生的分身。每个分身命中敌人时对其造成自然伤害，每个敌人每0.3秒最多受到一次伤害。","params":{"energyCost":[{"label":"所需终结技能量","values":[90,90,90,90,90,90,90,90,90,90,90,90],"raw":["90","90","90","90","90","90","90","90","90","90","90","90"]}],"cooldown":[{"label":"冷却时间","values":[15,15,15,15,15,15,15,15,15,15,15,15],"raw":["15秒","15秒","15秒","15秒","15秒","15秒","15秒","15秒","15秒","15秒","15秒","15秒"]}],"poise":[{"label":"失衡值","values":[2,2,2,2,2,2,2,2,2,3,3,3],"raw":["2","2","2","2","2","2","2","2","2","3","3","3"]}],"duration":[{"label":"持续时间（秒）","values":[3,3,3,3,3,3,3,3,3,3,3,3],"raw":["3","3","3","3","3","3","3","3","3","3","3","3"]}]}}
TALENTS [{"name":"朋友的身影","stages":[{"stage":"朋友的身影·一","description":"战技奔腾的多利命中敌人后生成3个多利先生的影子，终结技毛茸茸派对散射的多利先生的分身落地时有10%概率生成多利先生的影子。\n主控干员触碰多利先生的影子后，\n艾尔黛拉为其回复[45+意志×0.38]点生命值。\n主控干员生命值已满时，将转而治疗小队中生命值百分比最低的干员。\n多利先生的影子持续10秒，最多同时存在10个。","unlock":"/"},{"stage":"朋友的身影·二","description":"战技奔腾的多利命中敌人后生成3个多利先生的影子，终结技毛茸茸派对散射的多利先生的分身落地时有10%概率生成多利先生的影子。\n主控干员触碰多利先生的影子后，\n艾尔黛拉为其回复[63+意志×0.53]点生命值。\n主控干员生命值已满时，将转而治疗小队中生命值百分比最低的干员。\n多利先生的影子持续10秒，最多同时存在10个。","unlock":"晋升至精英化阶段1"},{"stage":"朋友的身影·三","description":"战技奔腾的多利命中敌人后生成3个多利先生的影子，终结技毛茸茸派对散射的多利先生的分身落地时有10%概率生成多利先生的影子。\n主控干员触碰多利先生的影子后，\n艾尔黛拉为其回复[90+意志×0.75]点生命值。\n主控干员生命值已满时，将转而治疗小队中生命值百分比最低的干员。\n多利先生的影子持续10秒，最多同时存在10个。","unlock":"晋升至精英化阶段2"}]},{"name":"山顶冲浪","stages":[{"stage":"山顶冲浪","description":"当艾尔黛拉的战技奔腾的多利成功触发额外效果后，\n若附近存在其他处于腐蚀状态的敌人，会立即再对其发动一次战技。\n每次主动施放战技只会触发一次该效果。","unlock":"晋升至精英化阶段2"}]}]
POTENTIALS [{"level":1,"name":"羊的乐园","description":"战技奔腾的多利消耗腐蚀后施加的物理脆弱与法术脆弱效果+8%。"},{"level":2,"name":"游戏奖励","description":"天赋朋友的身影效果加强：当主控干员触碰多利先生的影子后，艾尔黛拉会以一半的效果额外治疗另一名生命值百分比最低的友方干员。"},{"level":3,"name":"爆炸式喷发","description":"终结技毛茸茸派对的持续时间+1秒，且生成多利先生的影子的概率提升至原本的1.2倍。"},{"level":4,"name":"岩中花朵","description":"终结技毛茸茸派对所需的终结技能量-15%。"},{"level":5,"name":"火山蒸汽","description":"连携技火山蘑菇云冷却时间-2秒，伤害倍率提升至原本的1.2倍，施加的腐蚀效果持续时间+4秒。"}]
