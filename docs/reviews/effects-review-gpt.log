],"modifier":[{"label":"施放能量次数","values":[4,4,4,4,4,4,4,4,4,4,4,4],"raw":["4","4","4","4","4","4","4","4","4","4","4","4"]}],"poise":[{"label":"爆炸失衡值","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}],"energyGain":[{"label":"获得终结技能量","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]},{"label":"额外获得终结技能量","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","10","10","10","10","10","10"]}]},"rawRows":[]},"ultimate":{"name":"冷冻射手","type":"终结技","description":"立即部署小嘀嗒进行辅助，并切换至主控干员。\n在接下来一定时间内，伊冯的普通攻击会得到强化，每次普通攻击都会增加自己的暴击率。当叠加至最大层数后，自身暴击伤害增加。持续时间结束前的最后一次普通攻击会变为重击，造成大量寒冷伤害。\n如果敌人处于冻结状态，额外造成一次寒冷伤害后，消耗其冻结状态。","segments":[{"id":"ultimate1","label":"普通攻击伤害倍率","ratio":[8.9,9.8,10.7,11.6,12.5,13.4,14.3,15.1,16,17.2,18.5,20],"element":"cold","elementOrigin":"description","kind":"ultimate"},{"id":"ultimate2","label":"强力攻击伤害倍率","ratio":[133,147,160,173,186,200,213,226,240,256,276,300],"element":"cold","elementOrigin":"description","kind":"ultimate"},{"id":"ultimate3","label":"额外攻击伤害倍率","ratio":[267,294,320,347,374,400,427,454,480,514,554,600],"element":"cold","elementOrigin":"description","kind":"ultimate"}],"params":{"energyCost":[{"label":"所需终结技能量","values":[220,220,220,220,220,220,220,220,220,220,220,220],"raw":["220","220","220","220","220","220","220","220","220","220","220","220"]}],"cooldown":[{"label":"冷却时间","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10秒","10秒","10秒","10秒","10秒","10秒","10秒","10秒","10秒","10秒","10秒","10秒"]}],"duration":[{"label":"持续时间（秒）","values":[7,7,7,7,7,7,7,7,7,7,7,7],"raw":["7","7","7","7","7","7","7","7","7","7","7","7"]}],"poise":[{"label":"强力攻击失衡值","values":[20,20,20,20,20,20,20,20,20,20,20,20],"raw":["20","20","20","20","20","20","20","20","20","20","20","20"]}],"modifier":[{"label":"最大叠加层数","values":[10,10,10,10,10,10,10,10,10,10,10,10],"raw":["10","10","10","10","10","10","1