// Panel stats from a member loadout. Pure; returns values + trace lines. Formula references: docs/rules.md §B.
import {ownedEffects,valueOf,setCounts,STAT_ZONES} from './effects.js';
const floor=x=>Math.floor(x+1e-9);
const ABIL=['str','agi','int','will'];
// Weapon skill ranks: slot1/2 = 3(培养满) + 基质加级(0–6)；slot3 = 1 + 潜能(0–5) + 匹配基质加级(0–3)。默认基质满（9/9/4），与“0潜=Rank4”继承规则一致（rules D22）。
export function weaponRanks(w){ if(!w) return [9,9,4]; if(w.substrate){ const s=w.substrate; return [Math.min(9,3+(s[0]??6)),Math.min(9,3+(s[1]??6)),Math.min(9,1+(w.potential??0)+(s[2]??3))]; } return w.ranks||[9,9,4]; }
export const MAIN_PER_POINT=0.005, SUB_PER_POINT=0.002; // 主能力每点 +0.5% 攻击，副能力每点 +0.2%（规则 B8，待校正）

export function getStats(member,data,opts={}){
  const trace=[]; const op=data.operators.find(o=>o.id===member.operatorId); if(!op) throw new Error('unknown operator '+member.operatorId);
  const weapon=member.weapon?.id?data.weapons.find(w=>w.id===member.weapon.id):null;
  const wr=weaponRanks(member.weapon);
  // --- ability flat sources
  const flat={str:0,agi:0,int:0,will:0}; const pct={str:0,agi:0,int:0,will:0};
  const addFlat=(stat,v,why)=>{ const keys=stat==='main'?[op.mainAttr]:stat==='sub'?[op.subAttr]:stat==='all'?ABIL:[stat]; for(const k of keys){ flat[k]+=v; trace.push({part:'ability',stat:k,value:v,why}); } };
  const addPct=(stat,v,why)=>{ const keys=stat==='main'?[op.mainAttr]:stat==='sub'?[op.subAttr]:stat==='all'?ABIL:[stat]; for(const k of keys){ pct[k]+=v; trace.push({part:'abilityPct',stat:k,value:v,why}); } };
  for(const k of ABIL){ addFlat(k,op.base90[k],`${op.name} 90级基础`); if(op.talentStats?.[k]) addFlat(k,op.talentStats[k],'能力值天赋(满)'); }
  let atkPct=0, atkFlatBefore=0, atkFlatAfter=0, critRate=5, critDmg=50, chargeEff=0, artsStrength=0; const bonuses={};
  const addBonus=(key,v,why)=>{ bonuses[key]=(bonuses[key]||0)+v; trace.push({part:'bonus',stat:key,value:v,why}); };
  if(weapon){ weapon.skills.forEach((s,i)=>{ if(s.kind!=='attr') return; const rank=wr[i]??(i===2?4:9); const v=s.values[Math.max(0,Math.min(s.values.length-1,rank-1))]; const why=`${weapon.name}·${s.name} Rank${rank}`;
      if(['str','agi','int','will','main'].includes(s.stat)) addFlat(s.stat,v,why); else if(s.stat==='atkPct'){ atkPct+=v; trace.push({part:'atkPct',value:v,why}); } else if(s.stat==='critRate'){ critRate+=v; trace.push({part:'critRate',value:v,why}); } else if(s.stat==='artsStrength'){ artsStrength+=v; trace.push({part:'artsStrength',value:v,why}); } else if(s.stat==='chargeEff'){ chargeEff+=v; trace.push({part:'chargeEff',value:v,why}); } else if(s.stat==='dmgBonus'){ addBonus('elem:'+s.element,v,why); } else if(s.stat==='hpPct'||s.stat==='healEff'){ trace.push({part:'ignored',stat:s.stat,value:v,why}); } }); }
  for(const slot of ['armor','gloves','kit1','kit2']){ const g=member.gear?.[slot]; if(!g?.id) continue; const item=data.gear.find(x=>x.id===g.id); if(!item) continue; const refine=g.refine||[3,3,3];
    item.attrs.forEach((a,i)=>{ const r=Math.max(0,Math.min(3,refine[i]??3)); const v=a.values[r]; const why=`${item.name}·${a.name} 精锻+${r}`;
      if(['str','agi','int','will'].includes(a.stat)) addFlat(a.stat,v,why); else if(a.stat==='main'||a.stat==='sub'||a.stat==='all'){ a.pct?addPct(a.stat,v,why):addFlat(a.stat,v,why); } else if(a.stat==='atkFlat'){ atkFlatBefore+=v; trace.push({part:'atkFlat',value:v,why}); } else if(a.stat==='critRate'){ critRate+=v; trace.push({part:'critRate',value:v,why}); } else if(a.stat==='chargeEff'){ chargeEff+=v; trace.push({part:'chargeEff',value:v,why}); } else if(a.stat==='artsStrength'){ artsStrength+=v; trace.push({part:'artsStrength',value:v,why}); } else if(a.stat) addBonus(a.stat,v,why); }); }
  // --- auto stat effects from catalog (potentials, set auto stats, consumables)
  const catalog=data.effects||[]; const owned=ownedEffects(catalog,member,data,opts);
  for(const {effect:e,rank} of owned){ if(e.condition?.mode&&e.condition.mode!=='auto') continue; if(!STAT_ZONES.has(e.zone)) continue; const v=valueOf(e,{rank}); const why=e.name;
    if(e.zone==='ability'){ if(e.stat==='hpPct'||e.stat==='hp'){ trace.push({part:'ignored',stat:e.stat,value:v,why}); } else e.unit==='%'?addPct(e.stat,v,why):addFlat(e.stat,v,why); } else if(e.zone==='atkPct'){ atkPct+=v; trace.push({part:'atkPct',value:v,why}); } else if(e.zone==='atkFlat'){ if(e.owner?.kind==='consumable'){ atkFlatAfter+=v; trace.push({part:'atkFlatAfter',value:v,why}); } else { atkFlatBefore+=v; trace.push({part:'atkFlat',value:v,why}); } } else if(e.zone==='critRate'){ critRate+=v; trace.push({part:'critRate',value:v,why}); } else if(e.zone==='critDmg'){ critDmg+=v; trace.push({part:'critDmg',value:v,why}); } else if(e.zone==='chargeEff'){ chargeEff+=v; trace.push({part:'chargeEff',value:v,why}); } else if(e.zone==='artsStrength'){ artsStrength+=v; trace.push({part:'artsStrength',value:v,why}); } }
  // --- conditional / teammate-provided stat effects already resolved by the caller (per segment or per hit)
  for(const x of opts.extraStats||[]){ const v=x.value, why=x.why||x.label||x.id; if(x.zone==='ability'){ if(x.stat==='hpPct'||x.stat==='hp') continue; x.unit==='%'?addPct(x.stat,v,why):addFlat(x.stat,v,why); } else if(x.zone==='atkPct'){ atkPct+=v; trace.push({part:'atkPct',value:v,why}); } else if(x.zone==='atkFlat'){ atkFlatBefore+=v; trace.push({part:'atkFlat',value:v,why}); } else if(x.zone==='critRate'){ critRate+=v; trace.push({part:'critRate',value:v,why}); } else if(x.zone==='critDmg'){ critDmg+=v; trace.push({part:'critDmg',value:v,why}); } else if(x.zone==='chargeEff'){ chargeEff+=v; trace.push({part:'chargeEff',value:v,why}); } else if(x.zone==='artsStrength'){ artsStrength+=v; trace.push({part:'artsStrength',value:v,why}); } }
  // --- finalize abilities: floor((flat)*(1+pct%)) per ability (面板取整，见 rules B9)
  const abilities={}; for(const k of ABIL) abilities[k]=floor(flat[k]*(1+pct[k]/100));
  const main=abilities[op.mainAttr], sub=abilities[op.subAttr];
  const charBase=op.base90.atk, weaponBase=weapon?.baseAtk90??0;
  const abilityMul=1+main*MAIN_PER_POINT+sub*SUB_PER_POINT;
  // rules B8: [(角色基础+武器基础)×(1+攻击%)+装备固定攻击]×(1+0.005主+0.002副) + 食药固定攻击（用户实测：主副能力乘算后再加）
  const foodInside=opts.foodFlatMode==='inside'; // 研究（封测实测）认为食药固定攻击也在括号内；用户实测为乘算后相加（默认）
  const atkRaw=((charBase+weaponBase)*(1+atkPct/100)+atkFlatBefore+(foodInside?atkFlatAfter:0))*abilityMul+(foodInside?0:atkFlatAfter);
  const sets=setCounts(member,data);
  return {operator:op,weapon,abilities,main,sub,flatAbilities:flat,pctAbilities:pct,atk:{charBase,weaponBase,atkPct,abilityMul,atkFlatBefore,atkFlatAfter,foodFlatMode:foodInside?'inside':'after',raw:atkRaw,panel:floor(atkRaw)},critRate,critDmg,chargeEff,artsStrength,bonuses,sets,trace};
}
// Single-segment damage with multiplier zones and a full trace. Formula status: docs/rules.md §A (current implementation inherited from demo; marked where unverified).
export const ENGINE_VERSION='0.2.0';
export const GRADE_RESISTANCE={D:0,C:20,B:50}; // 评级→抗性%，待规则核对（rules A3）
const sum=a=>a.reduce((x,y)=>x+y,0);
const clamp=(x,lo,hi)=>Math.min(hi,Math.max(lo,Number.isFinite(Number(x))?Number(x):lo));
export const isArts=el=>el!=='physical';

// Gear/weapon panel bonuses that apply to this segment (increase zone, additive)
export function panelBonusItems(stats,seg){
  const items=[]; const b=stats.bonuses||{}; const el=seg.element, kind=seg.kind;
  const push=(k,label,cond)=>{ if(b[k]&&cond) items.push({label,value:b[k],source:'panel'}); };
  push('coldElecDmg','装备 · 寒冷和电磁伤害加成',el==='cold'||el==='electric');
  push('heatNatureDmg','装备 · 灼热和自然伤害加成',el==='heat'||el==='nature');
  push('physicalDmg','装备 · 物理伤害加成',el==='physical');
  push('artsDmg','装备 · 法术伤害加成',isArts(el));
  push('allSkillDmg','装备 · 所有技能伤害加成',['skill','combo','ultimate'].includes(kind));
  push('skillDmg','装备 · 战技伤害加成',kind==='skill'); push('comboDmg','装备 · 连携技伤害加成',kind==='combo'); push('ultDmg','装备 · 终结技伤害加成',kind==='ultimate'); push('normalDmg','装备 · 普通攻击伤害加成',kind==='normal');
  for(const [k,v] of Object.entries(b)) if(k.startsWith('elem:')){ const e={寒冷:'cold',灼热:'heat',电磁:'electric',自然:'nature',物理:'physical'}[k.slice(5)]||k.slice(5); if(e==='法术'?isArts(el):e===el) items.push({label:`武器 · ${k.slice(5)}伤害提升`,value:v,source:'panel'}); }
  return items;
}
export function effectApplies(e,seg){
  const a=e.applies||{}; if(a.elements?.length&&!a.elements.includes(seg.element)&&!a.elements.includes('any')) return false;
  if(a.kinds?.length&&!a.kinds.includes(seg.kind)) return false;
  if(a.damageClass==='arts'&&!isArts(seg.element)) return false; if(a.damageClass==='physical'&&seg.element!=='physical') return false;
  if(a.skills?.length&&seg.skillKey&&!a.skills.includes(seg.skillKey)) return false;
  if(a.segments?.length&&seg.id&&!a.segments.includes(seg.id)) return false;
  if(a.anomaly?.length&&seg.kind!=='mech') return false;
  return true;
}
// applied: [{effect, value, label, zone}] already resolved by the caller (effects.js / skills.js)
export function calcSegment({stats,seg,rank=12,enemy,critMode='never',applied=[],vars={},options={}}){
  const buckets={bonus:[],amp:[],fragile:[],vulnerable:[]}; const mods={ratioMul:[],ratioAdd:[],fragileMul:[],other:[]};
  for(const it of panelBonusItems(stats,seg)) buckets.bonus.push(it);
  for(const ap of applied){ const e=ap.effect; if(!effectApplies(e,seg)) continue; const item={label:ap.label||e.name,value:ap.value,source:e.id};
    if(buckets[e.zone]) buckets[e.zone].push(item); else if(e.zone==='ratioMul') mods.ratioMul.push(item); else if(e.zone==='ratioAdd') mods.ratioAdd.push(item); else if(e.fragileMultiplier) mods.fragileMul.push({...item,value:e.fragileMultiplier}); else mods.other.push(item); }
  if(mods.fragileMul.length){ const m=mods.fragileMul.reduce((a,b)=>a*b.value,1); buckets.fragile=buckets.fragile.map(x=>({...x,label:`${x.label} · 脆弱×${m}`,value:x.value*m,base:x.value})); }
  // ratio
  const rIdx=Math.max(0,Math.min(seg.ratio.length-1,rank-1)); let ratio=seg.ratio[rIdx]; const ratioTrace=[{label:seg.label,value:ratio}];
  if(seg.per==='unit'){ const n=vars.layers??vars.units??0; ratioTrace.push({label:`×${n} 层`,value:n}); ratio=ratio*n; }
  for(const m of mods.ratioAdd){ ratio+=m.value; ratioTrace.push({label:m.label,value:'+'+m.value}); }
  for(const m of mods.ratioMul){ ratio*=m.value; ratioTrace.push({label:m.label,value:'×'+m.value}); }
  const crit=critMode==='never'?1:critMode==='always'?1+stats.critDmg/100:1+(clamp(stats.critRate,0,100)/100)*(stats.critDmg/100);
  const def=clamp(enemy?.defence??100,0,99999); const grade=enemy?.resistances?.[seg.element]??'D';
  const resistance=grade==='custom'?clamp(enemy?.custom?.[seg.element]??0,-100,100):(GRADE_RESISTANCE[grade]??0);
  const mech=seg.kind==='mech'; // 机制伤害：等级系数与技艺强度，沿用 demo（rules A5/A6 待核）
  const lf=stats.operator?.exact90; const levelFactor=mech?(isArts(seg.element)?(lf?.artsLevelFactor??1+89/196):(lf?.physicalLevelFactor??1+89/392)):1; // rules A5：法术 1+(l-1)/196，物理 1+(l-1)/392（解包 attr 49/25 一致）
  const artsFactor=mech?1+clamp(stats.artsStrength,0,9999)/100:1;
  const factors={attack:stats.atk.panel,ratio:ratio/100,crit,bonus:1+sum(buckets.bonus.map(x=>x.value))/100,amp:1+sum(buckets.amp.map(x=>x.value))/100,fragile:1+sum(buckets.fragile.map(x=>x.value))/100,vulnerable:1+sum(buckets.vulnerable.map(x=>x.value))/100,combo:1+clamp(options.combo??0,0,999)/100,stagger:1+clamp(options.stagger??0,0,999)/100,defence:100/(100+def),resistance:1-resistance/100,reduction:1-clamp(options.reduction??0,0,100)/100,level:levelFactor,artsStrength:artsFactor};
  const damage=Object.values(factors).reduce((a,b)=>a*b,1);
  return {segmentId:seg.id,label:seg.label,element:seg.element,kind:seg.kind,rank,damage,factors,buckets,mods,ratioTrace,resistance,grade,defence:def,rounding:'引擎不取整；界面显示四舍五入到整数'};
}
// Skill-level calculation: per-segment results + total (= sum of segments). Also exposes total definitions.
import {calcSegment} from './damage.js';
export function skillSegments(op,skillKey,mode){ const sk=op.skills[skillKey]; if(!sk) return []; const src=(mode!=null&&sk.modeVariants)?sk.modeVariants[mode]:sk; return (src.segments||[]).map(s=>({...s,skillKey})); }
export function mechSegments(element){ // 机制伤害：倍率沿用 demo（rules A5 待核；异常等级 1–4 作为 vars.abnormal）
  const mk=(id,label,el,base,scale)=>({id,label,element:el,kind:'mech',ratio:[base],base,scale});
  return [mk('artsBurst','法术爆发',element,160,0),mk('iceShatter','碎冰','cold',120,1),mk('burn','燃烧 · 初始','heat',80,1),mk('burnTick','燃烧 · 每秒','heat',12,1),mk('conduct','导电','electric',80,1),mk('corrosion','腐蚀 · 初始','nature',80,1),mk('freeze','冻结','cold',80,1),mk('knockup','击飞','physical',120,0),mk('knockdown','倒地','physical',120,0),mk('crush','猛击','physical',150,1),mk('armorBreak','碎甲','physical',50,1)];
}
export function calcSkill({stats,segments,rank,enemy,critMode,appliedFor,vars,options}){
  const results=segments.map(seg=>{ const applied=typeof appliedFor==='function'?appliedFor(seg):(appliedFor||[]); let s=seg; if(seg.kind==='mech'){ const ab=Math.max(1,Math.min(4,vars?.abnormal??1)); s={...seg,ratio:[seg.base*(seg.scale?1+ab:1)]}; } return calcSegment({stats,seg:s,rank,enemy,critMode,applied,vars,options}); });
  return {segments:results,total:results.reduce((a,r)=>a+r.damage,0)};
}

