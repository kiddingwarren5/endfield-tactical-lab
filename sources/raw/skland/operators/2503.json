:"text","text":{"text":"“当下决断之时，我一定会在您身边，您大可相信你我之间的默契。”"}}],"kind":"body"}},"eBBGBmFOOTYI":{"id":"eBBGBmFOOTYI","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"kind":"text","text":{"text":"“执锐披坚，就不讲点到为止了。”"}}],"kind":"body"}}},"authorMap":{},"version":"1.0.0"},"associate":null,"dotType":"label_type_preview","subTypeList":[{"subTypeId":"10000","value":"10006"},{"subTypeId":"10100","value":"10102"},{"subTypeId":"10200","value":"10201"},{"subTypeId":"10207","value":"10212"},{"subTypeId":"10208","value":"10219"}],"composite":null,"disableCoverShowInDetail":false,"redirectLink":"","redirectLinkMobile":""},"status":2,"publishedAtTs":"1791290078","lastAuditPassedAt":"1792330692","tagIds":["10201","10006","10102","10212","10219"]}}}