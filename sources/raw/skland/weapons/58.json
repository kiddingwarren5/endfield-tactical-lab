,"backgroundColor":"","verticalAlign":"unknown"}},"description":"","rowHeader":true,"colHeader":false}},"eJIqHwI5pfA7":{"id":"eJIqHwI5pfA7","parentId":"WoMxUC_Uyamkf","align":"center","kind":"text","text":{"inlineElements":[{"bold":true,"kind":"text","text":{"text":"推荐刷取能量淤积点"}}],"kind":"body"}},"hOiRPz0Y9xHf":{"id":"hOiRPz0Y9xHf","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"kind":"text","text":{"text":"注："}}],"kind":"body"}},"ltNhMu0vBJ6I":{"id":"ltNhMu0vBJ6I","parentId":"5THgDn_MfS608","align":"center","kind":"text","text":{"inlineElements":[{"kind":"entry","entry":{"id":"464","showType":"link-imgText","count":"0"}}],"kind":"body"}},"mwnyd4DYfy5D":{"id":"mwnyd4DYfy5D","parentId":"WoMxUC_MfS608","align":"center","kind":"text","text":{"inlineElements":[{"bold":true,"kind":"text","text":{"text":"推荐武器基质"}}],"kind":"body"}}},"authorMap":{},"version":"1.0.0"},"XcFzVir6":{"id":"document-id","blockIds":["yl5lhXfQRcYk","GDtVQ4cOXLn6","pn0LL6WvQDyz","zVWtsKdiIfL6","pqhb7lTXSig0","75e88hQ1qqUK","8pN5jBBJKIP4","sdgDNPXiHZWl","h8tk6JVg7aD1","HZ2xkTX9LYja"],"blockMap":{"75e88hQ1qqUK":{"id":"75e88hQ1qqUK","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":"记录C：有办法了，还好我点子多！我们决定把无人机的螺旋桨拆下来，反正它的飞航系统也坏了，这样至少能派上点用场。再把螺旋桨和观测设备的支架组合在一起……合金叶片非常非常坚固，边缘也挺锋利的。这样一来，我们就有武器了！"}}],"kind":"body"}},"8pN5jBBJKIP4":{"id":"8pN5jBBJKIP4","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":" "}}],"kind":"body"}},"GDtVQ4cOXLn6":{"id":"GDtVQ4cOXLn6","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":"记录A：求助，求助，有任何人能听到吗？这里是终末地工业在侵蚀区的探索小队……滋滋……存者，我们遭到袭……滋滋……远程通信设备受损。我们将在这个频道上持续发送位置信息，请提供援助！"}}],"kind":"body"}},"HZ2xkTX9LYja":{"id":"HZ2xkTX9LYja","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":"记录E：躺在病床上的这段时间里，我进一步完善了它的设计，希望这款单手剑能让武库的大人物满意。这样一来，我那两根手指就不算白丢了。"}}],"kind":"body"}},"h8tk6JVg7aD1":{"id":"h8tk6JVg7aD1","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":" "}}],"kind":"body"}},"pn0LL6WvQDyz":{"id":"pn0LL6WvQDyz","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":" "}}],"kind":"body"}},"pqhb7lTXSig0":{"id":"pqhb7lTXSig0","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":" "}}],"kind":"body"}},"sdgDNPXiHZWl":{"id":"sdgDNPXiHZWl","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":"记录D：我们……我们把拦路的东西赶跑了，损失轻微。老天，真没想到应急的武器能这么管用！接下来只需要再步行半天，小队就能离开侵蚀区域，向最近的商会城镇求救了！希望他们开出的费用账单不会太长。"}}],"kind":"body"}},"yl5lhXfQRcYk":{"id":"yl5lhXfQRcYk","parentId":"document-id","kind":"horizontalLine","horizontalLine":{"kind":"5"}},"zVWtsKdiIfL6":{"id":"zVWtsKdiIfL6","parentId":"document-id","align":"left","kind":"text","text":{"inlineElements":[{"color":"light_text_primary","kind":"text","text":{"text":"记录B：六个小时了，依然没有任何回应，看来我们只能靠自己了。小队的制式武装……都被侵蚀弄坏了，我们需要新的武器，才有机会从这里活着走出去。生存手册上的办法够我们活命了，但是拿磨尖的石头和信号弹驱赶裂地者？这行不通。"}}],"kind":"body"}}},"authorMap":{},"version":"1.0.0"}},"chapterGroup":[{"title":"武器资料","widgets":[{"id":"D8rCWoJ0","title":"武器资料","size":"large"},{"id":"wcPjheGa","title":"武器展示","size":"large"}],"id":"0"},{"title":"武器总览","widgets":[{"id":"jv9XYQhp","title":"武器信息","size":"large"},{"id":"Q7G3CSMa","title":"武器技能","size":"large"}],"id":"1"},{"title":"武器推荐","widgets":[{"id":"qN2vezT1","title":"武器推荐","size":"large"}],"id":"2"},{"title":"武器档案","widgets":[{"id":"wIlLMjLW","title":"基础信息","size":"large"}],"id":"3"}],"extraInfo":{"showType":"","illustration":