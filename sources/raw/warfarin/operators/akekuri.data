:3906},5832,{"_36":55,"_38":3908},339,{"_36":58,"_38":37},{"_36":60,"_38":3911},1.48469387755102,{"_36":62,"_38":3913},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3933,"_101":64},{"_33":3934},[3935,3937,3939,3941,3943,3945,3947,3949,3950,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970],{"_36":37,"_38":3936},97,{"_36":41,"_38":3938},118.06690511256049,{"_36":44,"_38":3940},150.82305912055588,{"_36":47,"_38":3942},114.23059120555465,{"_36":50,"_38":3944},115.80138859667578,{"_36":39,"_38":3946},5888,{"_36":55,"_38":3948},342,{"_36":58,"_38":37},{"_36":60,"_38":3951},1.48979591836735,{"_36":62,"_38":2014},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3972,"_101":64},{"_33":3973},[3974,3975,3977,3979,3981,3983,3985,3987,3988,3990,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009],{"_36":37,"_38":925},{"_36":41,"_38":3976},119.15716389648644,{"_36":44,"_38":3978},152.2362718283194,{"_36":47,"_38":3980},115.29055333473623,{"_36":50,"_38":3982},116.9110035766884,{"_36":39,"_38":3984},5944,{"_36":55,"_38":3986},345,{"_36":58,"_38":37},{"_36":60,"_38":3989},1.49489795918367,{"_36":62,"_38":3991},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4011,"_101":64},{"_33":4012},[4013,4015,4017,4019,4021,4023,4025,4027,4028,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048],{"_36":37,"_38":4014},99,{"_36":41,"_38":4016},120.24742268041237,{"_36":44,"_38":4018},153.64948453608292,{"_36":47,"_38":4020},116.3505154639178,{"_36":50,"_38":4022},118.02061855670102,{"_36":39,"_38":4024},6000,{"_36":55,"_38":4026},348,{"_36":58,"_38":37},{"_36":60,"_38":4029},1.5,{"_36":62,"_38":2052},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4051,4052,4053],"tag_05","tag_04","tag_18","charId","charIllustInitPos",{"_4057":4058,"_4059":4060},"x",149,"y",-335,"charPassiveUIPrefabName","","charTypeId","Fire","cvName",{"_4067":4068,"_4069":4070,"_4071":4072,"_4073":4074,"_4054":16},"ChiCVName","萧清源","EngCVName","Shu Uchida","JapCVName","长月葵","KorCVName","金怡侒","defaultWeaponId","wpn_sword_0003","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Akekuri","mainAttrType","phoneticName","profession","profileRecord",[4088,4099,4104,4109,4114,4119],{"_4054":16,"_15":4089,"_4090":4091,"_4092":4093,"_4094":39,"_4095":4096,"_4097":37,"_4098":37},"chr_0019_karin_1","recordDesc","【代号】秋栗\n【性别】女\n【身份认证】终末地工业\n【生日】3月31日\n【种族】佩洛\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：标准\n战术规划：优良\n源石技艺适应性：普通","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4054":16,"_15":4100,"_4090":4101,"_4092":4102,"_4094":55,"_4095":4103,"_4097":37,"_4098":37},"chr_0019_karin_2","干员秋栗，本名斯波红叶，毕业于新都筑高等商学院，以预备干员身份加入终末地工业。现为特种技术部门Z7行动组组长，负责指挥和管理工作。\n\n以她的履历，本可以通过推荐进入环塔商会任何一家赫赫有名的大企业任职，却选择了来到终末地；即便在终末地，她也可以选择文职岗位，却在特种技术部门轮岗时主动提交申请，接下了重建Z7行动组的重担，成为前线行动人员。只能说，她心中一直奔腾着理想与热忱，是终末地最需要的年轻血液。\n在候选人提问环节，她问了一个问题——终末地作为一个“伟大企业”的愿景是什么，想要如何实现？我想，答案最好由管理员亲自告诉她。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4054":16,"_15":4105,"_4090":4106,"_4092":4107,"_4094":58,"_4095":4108,"_4097":37,"_4098":37},"chr_0019_karin_3","【新都筑高等商学院校报特刊】\n在毕业典礼前夕，本报记者对优秀毕业生斯波红叶进行了专访。\n“红叶学姐，您连续四年绩点位列专业第一，两次获得‘环塔青年综合商赛’金奖。请问，是什么支撑您始终保持高标准的自我要求？”\n她微笑着回答：“习惯吧，也可能是因为我妈妈从小就这样教我做事。”\n斯波红叶曾在环塔商会多家知名企业实习，包括在四之洲商事总部的实地经营岗位轮训，也参与了环塔物流协同调度系统的商业策划案制定，并提出了风险评估模型的关键优化建议，最终获得了企业方的高度评价。但是谈到她在四年里最骄傲的事迹，斯波红叶却把公益社团“萤之光”挂在嘴边。\n“我一直相信，商业和管理能力的意义不仅体现在利润上，更体现在人与人之间的支持与互助。‘萤之光’让我学会了如何调动有限的资源，去照亮尽量多的人。”\n谈及毕业后的去向，“您母亲是芝商社的代表取缔役社长，很多人都认为您会继承这份家业，您也从未公开表达过其他意向。现在毕业在即，可以透露一下未来的打算吗？”\n面对这个问题，斯波红叶只是轻轻地摇了摇头，露出了俏皮的微笑：“我已经做好决定了。不过嘛，现在还不方便说。”\n\n【一封自荐信】\n致终末地工业人事部：\n您好，我是斯波红叶，来自新都筑高等商学院。我希望能加入终末地工业，参与涉及资源管理与人员调度的工作。\n我深知自己并非技术出身，也不是战斗人员，但我擅长统筹、调度与现场应变。我相信，这些能力同样可以发挥作用。我愿接受任何培训与考核，也愿意投身前线，只为一个目标：成为值得依靠的支援者，为更多人提供帮助。\n感谢您的审阅。后附简历、成绩单、实习记录与比赛案例，希望得到您的回复！\n\n斯波红叶","CN_03","档案资料·一",{"_4054":16,"_15":4110,"_4090":4111,"_4092":4112,"_4094":64,"_4095":4113,"_4097":64,"_4098":3439},"chr_0019_karin_4","《Z7行动组岗位申请书》\n申请人：秋栗\n职位：特种技术部门轮岗干员\n尊敬的佩丽卡监督：\n我留意到，行动中枢正在终末地工业内部招募Z7行动组的新队长，负责行动组重建及后续任务，我正式自荐担任该项工作。\nZ7行动组原为多用途支援编队，其原有成员皆已晋升或调配至其他行动组，番号现已停用。鉴于终末地工业当前正面临的多线作战压力，以及特种技术部门持续的人力资源紧张状况，我将致力于在不消耗过多资源的前提下，组建一支灵活、高效的支援型小队，专注于中低风险任务的独立执行，并在需要时对其他行动组提供辅助支持。\n本人已完成所有战地适应课程训练，并在32次实地任务与超过200次模拟任务中获得A级以上评价，具备一定的现场指挥与协调能力。\n如果需要的话，我可以承担相应的事务性协调与管理工作，并对接管理中枢与行动中枢。\n若获批准，我将立即启动人员招募与训练计划，确保小队在最短时间内成型并投入实战。\n后附计划书摘要与详案，敬请审阅。\n此致\n敬礼\n\n怪不得那个小姑娘缠着我整整一个月，巨细靡遗地询问每一个战术位置的功能细分、能力需求、训练方案……最后在计划书里还把我的名字也列了上去。\n——终末地安全专家 卡拉德\n\n老实说，秋栗干员为Z7行动组新招募的某些队员……确实让人事部有点为难。但既然有佩丽卡监督的首肯和她自己的担保，我就先设个“观察期”吧。\n——终末地人事助理 马丁·马文·马伦\n\n秋栗那边邀请我去帮忙训练新人呢，演示如何运用战术机动来应对重装目标。咦，你也是吗？\n——陈千语干员某次在走廊与余烬干员相遇时的对话\n\n在三个月内如期通过了合格评审，大家辛苦了！我准备了热饮和茶点，休息好之后，一起看看我们的第一次任务吧！\n——Z7行动组组长 秋栗","CN_04","档案资料·二",{"_4054":16,"_15":4115,"_4090":4116,"_4092":4117,"_4094":66,"_4095":4118,"_4097":64,"_4098":3439},"chr_0019_karin_5","【环塔商会相关函件】\n来函方：芝商社\n收函方：终末地工业人力资源事务部\n\n尊敬的终末地工业人力资源事务部：\n您好。\n我是斯波红叶的母亲，斯波阳子。请原谅我以这样的方式打扰贵方。\n作为商社的负责人，我习惯于以理性和效率处理事务。但提笔写下这封信时，我的内心却充满了复杂的情感。\n红叶是我唯一的女儿。她的父亲与我的弟弟在讨伐天使的军旅中相识，因此与我结缘，然后有了红叶。在她的成长过程中，我是严格的教导者，而她那充满理想主义的父亲和舅舅则是带她游戏、玩耍的“大朋友”。\n直到十年前那场对天使的远征结束后，她的舅舅再也没能回来，她生还的父亲也变了一个人，最后离开了我们的生活。\n从那时候起，我便将红叶视为家庭唯一的延续，悉心培养她成为商社的继承人。她远离了那些葬送了我们的家庭的东西，再也不玩“打天使”的游戏，而成了优秀的学生，聪明，勤奋，始终不负我的期望。\n然而，在毕业之际，她却选择了加入终末地工业，甚至投身于充满危险的前线工作。\n起初，我对此感到震惊和恼怒。我们为此争执不休，关系紧张。\n我并非不理解她，相反，我比任何一个人都清楚，她并非一时冲动。她的身体里依然流着她父亲的血，流着那份对理想、对正义的热血与执着——尽管这断送了她的童年。\n我不再试图阻止她的决定。她愿意拼尽全力，只为证明自己的价值——这是我无法否定的理由。\n我恳请贵方，在可能范围内确保她的安全。但也请相信，我的女儿不是只会念书的孩子。\n谢谢你们的照顾。\n\n斯波阳子","CN_05","档案资料·三",{"_4054":16,"_15":4120,"_4090":4121,"_4092":4122,"_4094":68,"_4095":4123,"_4097":64,"_4098":4124},"chr_0019_karin_6","对曾经的“斯波红叶”而言，总结过去从不是难事。学生时代，她总能把一年中的进步与成果条分缕析，配上恰到好处的图表与注解，顺理成章地收获最佳评价。\n但这一次却不太一样。Z7行动组成立满一年了，比起数字和案例，更多涌上心头的是……特殊的“感触”。\n秋栗常常担心卡契尔——作为队伍的“盾”与后勤，他就像照顾家人一样照顾每一个人……他会不会太累了？\n秋栗挂念着埃特拉的身体状况。外人或许觉得这个姑娘散漫、缺乏干劲，但秋栗知道，她在修复自己虚弱身体的同时，也在帮助Z7行动组修复这个世界的创伤——这很了不起。\n秋栗更在意萤石的情绪波动，而不是时不时的“惹是生非”“我行我素”“冒犯他人”……秋栗常常反思自己，有没有成为足够稳妥的“缓冲”，让萤石感受到更多理解与信任？\n秋栗也担心安塔尔的孤独。这个总被视作“怪人”的队员，其实热情且可靠，只是表达方式太过不同。她知道，安塔尔一直在努力与大家同步。\n正因为有他们，才有了如今的Z7。\n她感谢这一切——感谢他们总会说“组长下令就好”，也感谢他们让这支新人小队摆脱了质疑。\n更多的感触，则关于秋栗自己：这一年，是否实现了自己的期待——调动有限的资源，去照亮尽量多的人，并且……最终照亮自己？\n有时候秋栗会想，只要终末地的理想实现，和平真的到来——或许那个时候，父母就可以冰释前嫌，她可以像记忆里小时候那样，回到家里，和他们一起，好好吃一顿晚餐。\n她正为此倾尽自己所有的努力。\n\n《年度述职报告》\n呈报人：Z7行动组组长 秋栗\n\n佩丽卡监督：\n一年过去，Z7行动组交出了这样的答卷——\n全年执行任务40次（成功率95%，全员零伤亡），含跨区物资押运16次、荒野侦察协同9次、高危工程护卫7次、紧急救援8次。\n我们的定位逐渐从“实验性补充力量”过渡为“稳定支援编制”。\nP.S. 虽然年度考核中，Z7行动组的正面战斗力评级依然为普通，但支援、指挥和管理等评级名列前茅。\n…………\n此外，关于传说中“管理员”的苏醒，虽然我未能有幸亲眼目睹，但从前辈们的言语中，我感受到了一种前所未有的期待。如果可能的话，请务必让Z7行动组参与管理员指挥的任务！我想亲手把战术板和任务报告递到管理员的面前，并和管理员一起，实现终末地的愿景，为塔卫二带来和平……","CN_06","档案资料·四",1500,"profileVoice",[4127,4135,4139,4143,4147,4151,4155,4160,4165,4170,4175,4180,4185,4190,4195,4200,4205,4210,4215,4220,4225,4230,4235,4240,4245,4250,4255,4260,4265,4270,4275,4280,4285,4290,4295,4300,4305,4310,4315,4320,4325,4330,4335,4340,4345,4350,4355,4360,4365,4370,4375,4380,4385,4390,4395,4400,4405,4410,4415,4420,4425,4430,4435,4440,4445,4450,4455,4460,4465,4470,4475,4480,4485,4490,4495,4500,4505,4510,4515,4520],{"_4054":16,"_15":4089,"_4097":37,"_4098":37,"_4128":4129,"_4130":4131,"_4132":39,"_4133":4134},"voId","chr_0019_karin_chrbark_squad_01","voiceDesc","刚完成预案推演，随时可以出发！","voiceIndex","voiceTitle","行动准备1",{"_4054":16,"_15":4100,"_4097":37,"_4098":37,"_4128":4136,"_4130":4137,"_4132":55,"_4133":4138},"chr_0019_karin_chrbark_squad_02","这次行动能积累宝贵的经验。","行动准备2",{"_4054":16,"_15":4105,"_4097":37,"_4098":37,"_4128":4140,"_4130":4141,"_4132":58,"_4133":4142},"chr_0019_karin_chrbark_join_01","Z7行动组，秋栗，很高兴加入这次行动！请期待我的表现！","编入队伍1",{"_4054":16,"_15":4110,"_4097":37,"_4098":37,"_4128":4144,"_4130":4145,"_4132":64,"_4133":4146},"chr_0019_karin_chrbark_join_02","是管理员的安排！太好了，没有比这更好的学习机会了！","编入队伍2",{"_4054":16,"_15":4115,"_4097":37,"_4098":37,"_4128":4148,"_4130":4149,"_4132":66,"_4133":4150},"chr_0019_karin_chrbark_weap_01","新武器……感觉很不一样呢。可以有新的战术安排和行动方式了！","更换武器",{"_4054":16,"_15":4120,"_4097":37,"_4098":37,"_4128":4152,"_4130":4153,"_4132":68,"_4133":4154},"chr_0019_karin_chrbark_gear_01","嗯，很合身。后续的使用体验，我会报告给武库。","更换装备",{"_4054":16,"_15":4156,"_4097":37,"_4098":37,"_4128":4157,"_4130":4158,"_4132":70,"_4133":4159},"chr_0019_karin_7","chr_0019_karin_chrup_skill_01","就像拿学分的感觉一样，不过这次不是从课堂上得到的。","激活天赋阵列",{"_4054":16,"_15":4161,"_4097":37,"_4098":37,"_4128":4162,"_4130":4163,"_4132":88,"_4133":4164},"chr_0019_karin_8","chr_0019_karin_chrup_level_01","这就是精英干员的行动复盘吗……真是受益匪浅！","观看作战记录",{"_4054":16,"_15":4166,"_4097":55,"_4098":39,"_4128":4167,"_4130":4168,"_4132":90,"_4133":4169},"chr_0019_karin_9","chr_0019_karin_chrup_promt01_01","晋升？太荣幸了！这既是对我的勉励，也是对整个Z7行动组的嘉奖。我们会继续努力的！","精英化晋升1",{"_4054":16,"_15":4171,"_4097":55,"_4098":55,"_4128":4172,"_4130":4173,"_4132":411,"_4133":4174},"chr_0019_karin_10","chr_0019_karin_chrup_promt02_01","以后要参加更危险的行动了？不，我不是害怕，而是开心。对还在积累经验的行动组来说，这意味着莫大的肯定。","精英化晋升2",{"_4054":16,"_15":4176,"_4097":55,"_4098":58,"_4128":4177,"_4130":4178,"_4132":100,"_4133":4179},"chr_0019_karin_11","chr_0019_karin_chrup_promt03_01","管理员，谈话结束后有空吗？行动组的大家为我准备了一个小小的庆祝会，我给您预留了蒙布朗蛋糕，别错过哦。","精英化晋升3",{"_4054":16,"_15":4181,"_4097":55,"_4098":64,"_4128":4182,"_4130":4183,"_4132":95,"_4133":4184},"chr_0019_karin_12","chr_0019_karin_chrup_promt04_01","我在课堂上学到过一个理论，说一个人最终会晋升到自己无法胜任的位置上。所以如果我“停滞”了太久，管理员，请您第一时间给我督促和指导吧。","精英化晋升4",{"_4054":16,"_15":4186,"_4097":37,"_4098":37,"_4128":4187,"_4130":4188,"_4132":528,"_4133":4189},"chr_0019_karin_13","chr_0019_karin_introduce_01","终末地Z7行动组组长，秋栗，向管理员报到！备忘摘要、预算评估、行动预案都已经做好了，您要先过目哪一份？","干员报到",{"_4054":16,"_15":4191,"_4097":37,"_4098":37,"_4128":4192,"_4130":4193,"_4132":567,"_4133":4194},"chr_0019_karin_14","chr_0019_karin_mono_switch_01","一个健康的团队不应该有短板。","待命1",{"_4054":16,"_15":4196,"_4097":37,"_4098":37,"_4128":4197,"_4130":4198,"_4132":97,"_4133":4199},"chr_0019_karin_15","chr_0019_karin_mono_switch_02","让我为终末地做些什么吧！","待命2",{"_4054":16,"_15":4201,"_4097":37,"_4098":37,"_4128":4202,"_4130":4203,"_4132":645,"_4133":4204},"chr_0019_karin_16","chr_0019_karin_sim_assign_work_01","放心交给我吧，我在轮岗时做过这份工作。","进驻设施",{"_4054":16,"_15":4206,"_4097":37,"_4098":37,"_4128":4207,"_4130":4208,"_4132":685,"_4133":4209},"chr_0019_karin_17","chr_0019_karin_sim_hello_lower_01","好巧，管理员，您也刚出完任务吗？","打招呼1",{"_4054":16,"_15":4211,"_4097":64,"_4098":3439,"_4128":4212,"_4130":4213,"_4132":724,"_4133":4214},"chr_0019_karin_18","chr_0019_karin_sim_hello_max_01","管理员，要我帮您煮一壶热咖啡吗？","打招呼2",{"_4054":16,"_15":4216,"_4097":37,"_4098":37,"_4128":4217,"_4130":4218,"_4132":764,"_4133":4219},"chr_0019_karin_19","chr_0019_karin_sim_talk_lv01_01","管理员，您好呀！我是秋栗，隶属于重建不久的Z7行动组……没关系，虽然现在我们的工作并不起眼，但很快就会让您记住的。","帝江号闲聊1",{"_4054":16,"_15":4221,"_4097":64,"_4098":3439,"_4128":4222,"_4130":4223,"_4132":803,"_4133":4224},"chr_0019_karin_20","chr_0019_karin_sim_talk_lv02_01","他们都说管理员是从终末地建立至今，一直以来的领导者……没想到竟然这么有亲和力。我懂我懂，这也是体现领导力的一环。","帝江号闲聊2",{"_4054":16,"_15":4226,"_4097":64,"_4098":3439,"_4128":4227,"_4130":4228,"_4132":874,"_4133":4229},"chr_0019_karin_21","chr_0019_karin_sim_talk_lv02_02","比起新都筑的“高端场合”，还是帝江号的大厅更适合我。在这里，每个人显得那么轻松，而且做的事情远比那些“商业精英”们有意义。","帝江号闲聊3",{"_4054":16,"_15":4231,"_4097":64,"_4098":4124,"_4128":4232,"_4130":4233,"_4132":913,"_4133":4234},"chr_0019_karin_22","chr_0019_karin_sim_talk_max_01","管理员，您尝过“生八桥”吗？那是一种东国风格的甜点，有红豆、抹茶，还有烤栗子味的。想试试的话，下次可以列席Z7行动组的行动部署会哦。","帝江号闲聊4",{"_4054":16,"_15":4236,"_4097":64,"_4098":4124,"_4128":4237,"_4130":4238,"_4132":953,"_4133":4239},"chr_0019_karin_23","chr_0019_karin_sim_talk_max_02","来，管理员，这里有热红茶，坐下来，听我们讲讲这次任务的见闻吧。","帝江号闲聊5",{"_4054":16,"_15":4241,"_4097":64,"_4098":4124,"_4128":4242,"_4130":4243,"_4132":992,"_4133":4244},"chr_0019_karin_24","chr_0019_karin_sim_talk_max_03","我喜欢在帝江号的舰桥眺望塔卫二，这里能看到我长大的地方、家人最后踏足的地方，还有被管理员改变过的地方——别惊讶，星球地理学和近代史我都拿了A+。","帝江号闲聊6",{"_4054":16,"_15":4246,"_4097":37,"_4098":37,"_4128":4247,"_4130":4248,"_4132":62,"_4133":4249},"chr_0019_karin_25","chr_0019_karin_sim_gift_give_01","管理员，这次外勤任务，我带回来了一些小纪念品，请收下！","赠送礼物",{"_4054":16,"_15":4251,"_4097":37,"_4098":37,"_4128":4252,"_4130":4253,"_4132":1070,"_4133":4254},"chr_0019_karin_26","chr_0019_karin_sim_gift_recv_01","哇，管理员的礼物！我猜一猜，这是奖励吗？还是……","接收礼物",{"_4054":16,"_15":4256,"_4097":37,"_4098":37,"_4128":4257,"_4130":4258,"_4132":1110,"_4133":4259},"chr_0019_karin_27","chr_0019_karin_mono_self_line01","为什么新都筑的年度模范毕业生会选择终末地？其实我更感激终末地选择了我。比起商会职场里的晋升阶梯，我更喜欢行动组的一切——在这里，我既是战斗者，也是开拓者。","信赖对话1",{"_4054":16,"_15":4261,"_4097":64,"_4098":3439,"_4128":4262,"_4130":4263,"_4132":1149,"_4133":4264},"chr_0019_karin_28","chr_0019_karin_mono_self_line02","我的愿望？希望爸爸和妈妈和解吧。我觉得无论是与天使奋战的爸爸，还是打理家庭商店的妈妈，他们之间没有成为“敌人”的理由，对吧？在终末地工业，两者不就能兼得吗？","信赖对话2",{"_4054":16,"_15":4266,"_4097":64,"_4098":3439,"_4128":4267,"_4130":4268,"_4132":1189,"_4133":4269},"chr_0019_karin_29","chr_0019_karin_mono_self_line03","记得很小的时候，爸爸和舅舅经常带我玩“打天使”的游戏，那时我骑在他们的肩膀上，就像个指挥官。十年前，舅舅作为忍客被征召去了北边，再也没有回来，爸爸也和妈妈永不相见。我几乎忘了那时候的“战斗”经历，直到终末地让我再次回忆起来。","信赖对话3",{"_4054":16,"_15":4271,"_4097":64,"_4098":4124,"_4128":4272,"_4130":4273,"_4132":56,"_4133":4274},"chr_0019_karin_30","chr_0019_karin_mono_self_line04","在申请重建Z7行动组之后，我经历了一年多的高难度培训和挑战。但真正重要的，是找到了卡契尔、萤石、埃特拉和安塔尔——他们都是无价之宝，是他们给了Z7行动组能够重新成立的资格。","信赖对话4",{"_4054":16,"_15":4276,"_4097":64,"_4098":4124,"_4128":4277,"_4130":4278,"_4132":1267,"_4133":4279},"chr_0019_karin_31","chr_0019_karin_mono_self_line05","啊，管理员，您都知道啦？妈妈把我送去念商科，是希望我将来在环塔商会里成为她的左右手。但现在我背离了她所规划的道路。所以您必须让终末地工业成为塔卫二最伟大的企业，要不然，我就得回去继承家业了。对了，如果去环带购物，记得带上这张卡——嘘，别念出来，就是大家都知道的那家。","信赖对话5",{"_4054":16,"_15":4281,"_4097":37,"_4098":37,"_4128":4282,"_4130":4283,"_4132":1306,"_4133":4284},"chr_0019_karin_32","chr_0019_karin_mono_chat_line01","我知道自己的战斗力不算惊人，因此队友们的信任与配合才是最可靠的保障。您现在知道这支信号铳的重要性了吧！","交谈1",{"_4054":16,"_15":4286,"_4097":37,"_4098":37,"_4128":4287,"_4130":4288,"_4132":117,"_4133":4289},"chr_0019_karin_33","chr_0019_karin_mono_chat_line02","想知道与我的队友们相处的诀窍吗？卡契尔做的饭菜要吃干净，送萤石捕蝇草，陪埃特拉听噪音，在安塔尔的笑话冷场时第一个大声笑出来……就好了！","交谈2",{"_4054":16,"_15":4291,"_4097":37,"_4098":37,"_4128":4292,"_4130":4293,"_4132":1384,"_4133":4294},"chr_0019_karin_34","chr_0019_karin_mono_chat_line03","我忘不了Z7小队执行的第一个任务，很简单，护送终末地的建设人员到开拓区边陲修建水坝。那一次我们闹出来的笑话足以写一本《初级行动组避坑指南》，但我忘不了大坝落成时的感觉：泡在齐腰深水里的冰冰凉凉，还有充斥胸腔的、炽热的成就感。","交谈3",{"_4054":16,"_15":4296,"_4097":37,"_4098":37,"_4128":4297,"_4130":4298,"_4132":1424,"_4133":4299},"chr_0019_karin_35","chr_0019_karin_mono_chat_line04","如果管理员指挥我们……可以让埃特拉和安塔尔来打掩护，我和卡契尔来吸引火力，安排萤石来发出最后一击！欸？您有截然不同的设想吗？","交谈4",{"_4054":16,"_15":4301,"_4097":37,"_4098":37,"_4128":4302,"_4130":4303,"_4132":156,"_4133":4304},"chr_0019_karin_36","chr_0019_karin_mono_chat_line05","想看我的成绩单？唔，每一门成绩都是A+，除了二年级的商业竞争模拟。当时迫于同组同学的压力，我把其他组扮演的“对手”都逼到了破产。但最后教授告诉我，在塔卫二，零和并不是最好的策略。这是我拿的第一个也是最后一个A−。","交谈5",{"_4054":16,"_15":4306,"_4097":37,"_4098":37,"_4128":4307,"_4130":4308,"_4132":1502,"_4133":4309},"chr_0019_karin_37","chr_0019_karin_mono_about_line01","大家都说卡契尔是个好同伴，其实他是最需要同伴关爱的人呢。他甚至会因为怕影响到大家，而在行动组周会上默默喝了两个月的咖啡——直到被发现咖啡过敏，才换成热巧克力。","话题：卡契尔",{"_4054":16,"_15":4311,"_4097":37,"_4098":37,"_4128":4312,"_4130":4313,"_4132":1541,"_4133":4314},"chr_0019_karin_38","chr_0019_karin_mono_about_line02","有些人害怕萤石……因为那“不怀好意”的语气和危险的“帮派”身份。但只要稍稍了解她，就能看到深藏在兜帽下的勇气和正义感。相信我，不会错的。","话题：萤石",{"_4054":16,"_15":4316,"_4097":37,"_4098":37,"_4128":4317,"_4130":4318,"_4132":41,"_4133":4319},"chr_0019_karin_39","chr_0019_karin_mono_about_line03","又有人投诉埃特拉干劲不足吗？不是哦，看看行动履历就知道了，其实她对于刺激、冒险和体力劳动都乐在其中呢！","话题：埃特拉",{"_4054":16,"_15":4321,"_4097":37,"_4098":37,"_4128":4322,"_4130":4323,"_4132":44,"_4133":4324},"chr_0019_karin_40","chr_0019_karin_mono_about_line04","没法理解安塔尔的笑话吗？唔，其实换个角度，设身处地感受他编笑话时的脑回路，是不是就能被逗乐起来……噗……哈哈哈哈……","话题：安塔尔",{"_4054":16,"_15":4326,"_4097":37,"_4098":37,"_4128":4327,"_4130":4328,"_4132":47,"_4133":4329},"chr_0019_karin_41","chr_0019_karin_explore_point_common_01","好像有一些值得注意的东西，去查看一下吧？","发现资源1",{"_4054":16,"_15":4331,"_4097":37,"_4098":37,"_4128":4332,"_4130":4333,"_4132":50,"_4133":4334},"chr_0019_karin_42","chr_0019_karin_explore_point_valub_01","发现高价值目标，申请开展收集行动。","发现资源2",{"_4054":16,"_15":4336,"_4097":37,"_4098":37,"_4128":4337,"_4130":4338,"_4132":232,"_4133":4339},"chr_0019_karin_43","chr_0019_karin_explore_find_locked_01","报告未知区域，有进一步行动指示吗？","发现未探索区域",{"_4054":16,"_15":4341,"_4097":37,"_4098":37,"_4128":4342,"_4130":4343,"_4132":1804,"_4133":4344},"chr_0019_karin_44","chr_0019_karin_explore_find_danger_01","确认高危险目标，别慌，我们演习过应对策略。","发现强敌",{"_4054":16,"_15":4346,"_4097":37,"_4098":37,"_4128":4347,"_4130":4348,"_4132":1844,"_4133":4349},"chr_0019_karin_45","chr_0019_karin_interact_mine_valub_01","这些矿物是对终末地有用的物资。","采集矿物1",{"_4054":16,"_15":4351,"_4097":37,"_4098":37,"_4128":4352,"_4130":4353,"_4132":270,"_4133":4354},"chr_0019_karin_46","chr_0019_karin_interact_mine_valub_echo2_01","我也来帮忙，我们是搭档嘛！","采集矿物2",{"_4054":16,"_15":4356,"_4097":37,"_4098":37,"_4128":4357,"_4130":4358,"_4132":1922,"_4133":4359},"chr_0019_karin_47","chr_0019_karin_interact_treasure_valub_01","嗯，我们收获不小啊！","打开储藏箱",{"_4054":16,"_15":4361,"_4097":37,"_4098":37,"_4128":4362,"_4130":4363,"_4132":72,"_4133":4364},"chr_0019_karin_48","chr_0019_karin_interact_etherium_01","醚质是行动时的高优先级目标，它究竟有什么秘密？","获得醚质",{"_4054":16,"_15":4366,"_4097":37,"_4098":37,"_4128":4367,"_4130":4368,"_4132":60,"_4133":4369},"chr_0019_karin_49","chr_0019_karin_interact_blight_break_01","通往终末地目标的路上，又少了一些障碍。","消除侵蚀",{"_4054":16,"_15":4371,"_4097":37,"_4098":37,"_4128":4372,"_4130":4373,"_4132":76,"_4133":4374},"chr_0019_karin_50","chr_0019_karin_interact_rest_01","现在可以坐下来，思考行动、修缮装备、检查背包，并且享用热咖啡。","休整",{"_4054":16,"_15":4376,"_4097":37,"_4098":37,"_4128":4377,"_4130":4378,"_4132":78,"_4133":4379},"chr_0019_karin_51","chr_0019_karin_combat_suppuse_using_01","别担心，快接受治疗。","使用战术物品1",{"_4054":16,"_15":4381,"_4097":37,"_4098":37,"_4128":4382,"_4130":4383,"_4132":80,"_4133":4384},"chr_0019_karin_52","chr_0019_karin_combat_suppuse_getheal_01","治疗得很及时！","使用战术物品2",{"_4054":16,"_15":4386,"_4097":37,"_4098":37,"_4128":4387,"_4130":4388,"_4132":82,"_4133":4389},"chr_0019_karin_53","chr_0019_karin_combat_remind_danger_01","有危险，立刻躲避！","危险提醒",{"_4054":16,"_15":4391,"_4097":37,"_4098":37,"_4128":4392,"_4130":4393,"_4132":84,"_4133":4394},"chr_0019_karin_54","chr_0019_karin_combat_hurt_lowhp_01","身为组长……更不能后退……","负伤",{"_4054":16,"_15":4396,"_4097":37,"_4098":37,"_4128":4397,"_4130":4398,"_4132":86,"_4133":4399},"chr_0019_karin_55","chr_0019_karin_combat_dead_01","可以被击倒……但不能被打败。","力竭",{"_4054":16,"_15":4401,"_4097":37,"_4098":37,"_4128":4402,"_4130":4403,"_4132":384,"_4133":4404},"chr_0019_karin_56","chr_0019_karin_combat_remind_praise_01","真是教科书式的示范！","小队激励1",{"_4054":16,"_15":4406,"_4097":37,"_4098":37,"_4128":4407,"_4130":4408,"_4132":2308,"_4133":4409},"chr_0019_karin_57","chr_0019_karin_combat_remind_praise_02","漂亮！大开眼界！","小队激励2",{"_4054":16,"_15":4411,"_4097":37,"_4098":37,"_4128":4412,"_4130":4413,"