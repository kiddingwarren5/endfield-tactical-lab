69":8380,"_8385":8386,"_8389":8390,"_7887":8394,"_8399":8400,"_8403":8404,"_7894":8408,"_8413":8414,"_8419":8420,"_7918":8424,"_8429":8430,"_8434":8435,"_8439":8440,"_8444":8445,"_7925":8449,"_8453":8454,"_8458":8459,"_8463":8464,"_8467":8468,"_8473":8474,"_8478":8479,"_7955":8483,"_8488":8489,"_8493":8494,"_8496":8497,"_8500":8501,"_8505":8506,"_8509":8510,"_8515":8516,"_8519":8520,"_8524":8525,"_8529":8530,"_7972":8534,"_8538":8539,"_8541":8542,"_7992":8546,"_8550":8551,"_8555":8556,"_8560":8561,"_8565":8566,"_8569":8570,"_8574":8575,"_7792":8580,"_7831":8584,"_8589":8590,"_8594":8595,"_8599":8600,"_8018":8604,"_8609":8610,"_8612":8613,"_8616":8617,"_8620":8621,"_8625":8626,"_8630":8631,"_8634":8635,"_8639":8640,"_8058":8644,"_8648":8649,"_8653":8654,"_8658":8659,"_8663":8664,"_8667":8668,"_8671":8672,"_8676":8677,"_8681":8682,"_8685":8686,"_8691":8692,"_8695":8696,"_8699":8700,"_8704":8705,"_8708":8709,"_8712":8713,"_8716":8717,"_8722":8723,"_8727":8728,"_8732":8733,"_8737":8738,"_8742":8743,"_8747":8748,"_8752":8753,"_8757":8758,"_8762":8763,"_8767":8768,"_8772":8773,"_8777":8778,"_8782":8783,"_8787":8788},"adv.electricFence",{"_4638":8278,"_8279":4059,"_15":8276,"_8280":4059,"_19":8281,"_8282":7848},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4638":8285,"_8279":8286,"_15":8283,"_8280":4059,"_19":8287,"_8282":7901},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4638":8289,"_8279":8290,"_15":7965,"_8280":8291,"_19":8292,"_8282":8030},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4638":8295,"_8279":4059,"_15":8293,"_8280":4059,"_19":8296,"_8282":7848},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4638":8299,"_8279":8300,"_15":8297,"_8280":4059,"_19":8301,"_8282":7848},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4638":8304,"_8279":4059,"_15":8302,"_8280":4059,"_19":8305,"_8282":7848},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4638":8308,"_8279":8309,"_15":8306,"_8280":4059,"_19":8310,"_8282":7942},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4638":8313,"_8279":4059,"_15":8311,"_8280":4059,"_19":8314,"_8282":7848},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4638":8317,"_8279":8318,"_15":8315,"_8280":4059,"_19":8319,"_8282":7848},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4638":8322,"_8279":4059,"_15":8320,"_8280":4059,"_19":8323,"_8282":4059},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4638":8326,"_8279":8327,"_15":8324,"_8280":4059,"_19":8328,"_8282":7901},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4638":8330,"_8279":8331,"_15":7780,"_8280":8332,"_19":8333,"_8282":8030},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4638":8336,"_8279":4059,"_15":8334,"_8280":4059,"_19":8337,"_8282":7848},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4638":8340,"_8279":8341,"_15":8338,"_8280":4059,"_19":8342,"_8282":7848},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4638":8345,"_8279":8346,"_15":8343,"_8280":4059,"_19":8347,"_8282":7848},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4638":8350,"_8279":4059,"_15":8348,"_8280":4059,"_19":8351,"_8282":7875},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4638":8354,"_8279":8355,"_15":8352,"_8280":4059,"_19":8356,"_8282":7848},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4638":8359,"_8279":4059,"_15":8357,"_8280":4059,"_19":8360,"_8282":7875},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4638":8362,"_8279":8363,"_15":7863,"_8280":8364,"_19":8365,"_8282":7942},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4638":8368,"_8279":8363,"_15":8366,"_8280":4059,"_19":8369,"_8282":7942},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4638":8372,"_8279":8373,"_15":8370,"_8280":8374,"_19":8375,"_8282":7875},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4638":8378,"_8279":4059,"_15":8376,"_8280":4059,"_19":8379,"_8282":7875},"持续时间内，受影响的目标暂停行动。","定身",{"_4638":8381,"_8279":8382,"_15":7869,"_8280":8383,"_19":8384,"_8282":8054},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4638":8387,"_8279":8382,"_15":8385,"_8280":4059,"_19":8388,"_8282":8054},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4638":8391,"_8279":4059,"_15":8389,"_8280":8392,"_19":8393,"_8282":4059},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4638":8395,"_8279":8396,"_15":7887,"_8280":8397,"_19":8398,"_8282":8004},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4638":8401,"_8279":8396,"_15":8399,"_8280":4059,"_19":8402,"_8282":8004},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4638":8405,"_8279":8406,"_15":8403,"_8280":4059,"_19":8407,"_8282":7848},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4638":8409,"_8279":8410,"_15":7894,"_8280":8411,"_19":8412,"_8282":8030},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4638":8415,"_8279":8416,"_15":8413,"_8280":8417,"_19":8418,"_8282":7875},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4638":8421,"_8279":8422,"_15":8419,"_8280":4059,"_19":8423,"_8282":7875},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4638":8425,"_8279":8426,"_15":7918,"_8280":8427,"_19":8428,"_8282":7901},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4638":8431,"_8279":4059,"_15":8429,"_8280":8432,"_19":8433,"_8282":7901},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4638":8436,"_8279":8437,"_15":8434,"_8280":4059,"_19":8438,"_8282":7848},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4638":8441,"_8279":8442,"_15":8439,"_8280":4059,"_19":8443,"_8282":7848},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4638":8446,"_8279":8447,"_15":8444,"_8280":4059,"_19":8448,"_8282":7901},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4638":8450,"_8279":8286,"_15":7925,"_8280":8451,"_19":8452,"_8282":7901},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4638":8455,"_8279":4059,"_15":8453,"_8280":8456,"_19":8457,"_8282":7875},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4638":8460,"_8279":8461,"_15":8458,"_8280":4059,"_19":8462,"_8282":7848},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4638":8465,"_8279":4059,"_15":8463,"_8280":4059,"_19":8466,"_8282":4059},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4638":8469,"_8279":8470,"_15":8467,"_8280":8471,"_19":8472,"_8282":7875},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4638":8475,"_8279":8476,"_15":8473,"_8280":4059,"_19":8477,"_8282":7848},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4638":8480,"_8279":4059,"_15":8478,"_8280":8481,"_19":8482,"_8282":7942},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4638":8484,"_8279":8485,"_15":7955,"_8280":8486,"_19":8487,"_8282":7942},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4638":8490,"_8279":8491,"_15":8488,"_8280":4059,"_19":8492,"_8282":7848},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4638":8368,"_8279":8485,"_15":8493,"_8280":4059,"_19":8495,"_8282":7942},"干员受到灼热附着","sys.tacticalItem",{"_4638":8498,"_8279":4059,"_15":8496,"_8280":4059,"_19":8499,"_8282":7848},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4638":8502,"_8279":8503,"_15":8500,"_8280":4059,"_19":8504,"_8282":7942},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4638":8387,"_8279":8507,"_15":8505,"_8280":4059,"_19":8508,"_8282":8054},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4638":8511,"_8279":8512,"_15":8509,"_8280":8513,"_19":8514,"_8282":7875},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4638":8517,"_8279":4059,"_15":8515,"_8280":4059,"_19":8518,"_8282":7875},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4638":8521,"_8279":8522,"_15":8519,"_8280":4059,"_19":8523,"_8282":8030},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4638":8526,"_8279":8527,"_15":8524,"_8280":4059,"_19":8528,"_8282":8054},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4638":8531,"_8279":8532,"_15":8529,"_8280":4059,"_19":8533,"_8282":7875},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4638":8535,"_8279":8536,"_15":7972,"_8280":8427,"_19":8537,"_8282":7901},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4638":8285,"_8279":8536,"_15":8538,"_8280":4059,"_19":8540,"_8282":7901},"干员受到冻结","ba.naturalvul",{"_4638":8543,"_8279":8544,"_15":8541,"_8280":4059,"_19":8545,"_8282":8004},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4638":8330,"_8279":8547,"_15":7992,"_8280":8548,"_19":8549,"_8282":8030},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4638":8552,"_8279":8553,"_15":8550,"_8280":4059,"_19":8554,"_8282":7848},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4638":8557,"_8279":8558,"_15":8555,"_8280":4059,"_19":8559,"_8282":7848},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4638":8562,"_8279":8563,"_15":8560,"_8280":4059,"_19":8564,"_8282":7848},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4638":8567,"_8279":4059,"_15":8565,"_8280":4059,"_19":8568,"_8282":7848},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4638":8571,"_8279":4059,"_15":8569,"_8280":8572,"_19":8573,"_8282":4059},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4638":8576,"_8279":8577,"_15":8574,"_8280":8578,"_19":8579,"_8282":7875},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4638":8581,"_8279":4059,"_15":7792,"_8280":8582,"_19":8583,"_8282":8004},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4638":8585,"_8279":8586,"_15":7831,"_8280":8587,"_19":8588,"_8282":8030},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4638":8591,"_8279":8592,"_15":8589,"_8280":4059,"_19":8593,"_8282":7848},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4638":8596,"_8279":8597,"_15":8594,"_8280":4059,"_19":8598,"_8282":8004},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4638":8601,"_8279":8602,"_15":8599,"_8280":4059,"_19":8603,"_8282":7848},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4638":8605,"_8279":8606,"_15":8018,"_8280":8607,"_19":8608,"_8282":8004},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4638":8401,"_8279":8606,"_15":8609,"_8280":4059,"_19":8611,"_8282":8004},"干员受到自然附着","ba.originium",{"_4638":8614,"_8279":4059,"_15":8612,"_8280":4059,"_19":8615,"_8282":7875},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4638":8618,"_8279":4059,"_15":8616,"_8280":4059,"_19":8619,"_8282":8030},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4638":8622,"_8279":8623,"_15":8620,"_8280":4059,"_19":8624,"_8282":8030},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4638":8627,"_8279":4059,"_15":8625,"_8280":8628,"_19":8629,"_8282":8038},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4638":8632,"_8279":4059,"_15":8630,"_8280":4059,"_19":8633,"_8282":7848},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4638":8636,"_8279":4059,"_15":8634,"_8280":8637,"_19":8638,"_8282":8054},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4638":8641,"_8279":8642,"_15":8639,"_8280":4059,"_19":8643,"_8282":7848},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4638":8645,"_8279":8507,"_15":8058,"_8280":8646,"_19":8647,"_8282":8054},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4638":8650,"_8279":8651,"_15":8648,"_8280":4059,"_19":8652,"_8282":8054},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4638":8655,"_8279":4059,"_15":8653,"_8280":8656,"_19":8657,"_8282":7875},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4638":8660,"_8279":4059,"_15":8658,"_8280":8661,"_19":8662,"_8282":4059},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4638":8665,"_8279":4059,"_15":8663,"_8280":4059,"_19":8666,"_8282":7848},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4638":8669,"_8279":4059,"_15":8667,"_8280":4059,"_19":8670,"_8282":7875},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4638":8673,"_8279":8674,"_15":8671,"_8280":4059,"_19":8675,"_8282":7848},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4638":8678,"_8279":4059,"_15":8676,"_8280":8679,"_19":8680,"_8282":7875},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4638":8683,"_8279":4059,"_15":8681,"_8280":4059,"_19":8684,"_8282":7848},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4638":8687,"_8279":8688,"_15":8685,"_8280":8689,"_19":8690,"_8282":7875},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4638":8693,"_8279":4059,"_15":8691,"_8280":4059,"_19":8694,"_8282":7875},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4638":8697,"_8279":4059,"_15":8695,"_8280":4059,"_19":8698,"_8282":7875},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4638":8701,"_8279":8702,"_15":8699,"_8280":4059,"_19":8703,"_8282":7848},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4638":8706,"_8279":4059,"_15":8704,"_8280":4059,"_19":8707,"_8282":7875},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4638":8710,"_8279":4059,"_15":8708,"_8280":4059,"_19":8711,"_8282":7875},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4638":8714,"_8279":4059,"_15":8712,"_8280":4059,"_19":8715,"_8282":7875},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4638":8718,"_8279":8719,"_15":8716,"_8280":8720,"_19":8721,"_8282":7875},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4638":8724,"_8279":8725,"_15":8722,"_8280":4059,"_19":8726,"_8282":7848},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4638":8729,"_8279":8730,"_15":8727,"_8280":4059,"_19":8731,"_8282":7848},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4638":8734,"_8279":8735,"_15":8732,"_8280":4059,"_19":8736,"_8282":7848},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4638":8739,"_8279":8740,"_15":8737,"_8280":4059,"_19":8741,"_8282":7848},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4638":8744,"_8279":8745,"_15":8742,"_8280":4059,"_19":8746,"_8282":7848},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4638":8749,"_8279":8750,"_15":8747,"_8280":4059,"_19":8751,"_8282":7848},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4638":8754,"_8279":8755,"_15":8752,"_8280":4059,"_19":8756,"_8282":7848},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4638":8759,"_8279":8760,"_15":8757,"_8280":4059,"_19":8761,"_8282":7848},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4638":8764,"_8279":8765,"_15":8762,"_8280":4059,"_19":8766,"_8282":7848},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4638":8769,"_8279":8770,"_15":8767,"_8280":4059,"_19":8771,"_8282":7848},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4638":8774,"_8279":8775,"_15":8772,"_8280":4059,"_19":8776,"_8282":7848},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4638":8779,"_8279":8780,"_15":8777,"_8280":4059,"_19":8781,"_8282":7848},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4638":8784,"_8279":8785,"_15":8782,"_8280":4059,"_19":8786,"_8282":7848},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4638":8789,"_8279":8790,"_15":8787,"_8280":4059,"_19":8791,"_8282":7848},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7484":8794,"_6996":8803,"_7016":8805,"_6989":8807,"_7134":8809,"_5935":8811,"_7137":8813,"_7140":8815,"_7142":8817,"_7145":8818,"_5534":8820,"_7150":8822,"_7153":8823,"_7156":8824,"_7158":8826,"_7161":8827,"_6324":8828,"_7166":8829,"_7170":8831,"_7173":8832,"_6792":8833,"_7180":8834,"_7183":8835,"_7187":8836,"_7191":8837,"_7194":8838,"_7198":8839,"_7202":8841,"_7206":8842,"_7210":8844,"_7214":8846,"_7218":8848,"_7222":8849,"_7226":8851,"_7230":8853,"_7234":8854,"_7238":8856,"_7242":8858,"_7246":8860,"_7250":8862,"_7254":8865,"_7258":8868,"_7262":8871,"_7266":8874,"_7270":8875,"_7274":8877,"_7278":8878,"_7282":8879,"_7286":8881,"_7290":8883,"_7294":8884,"_7298":8886,"_7302":8888,"_7306":8890,"_7310":8892,"_7314":8894,"_7318":8896,"_7322":8898,"_7325":8900,"_7329":8902,"_7333":8904,"_7337":8905,"_7341":8907,"_7345":8908,"_7349":8909,"_7353":8910,"_7357":8911,"_7361":8912,"_7365":8913,"_7369":8914,"_7373":8915,"_7377":8916,"_7381":8917,"_7385":8918,"_7389":8919,"_7393":8920,"_7397":8921,"_7401":8922,"_7405":8923,"_7409":8924,"_7413":8925,"_7417":8926,"_7420":8927,"_7424":8928,"_7428":8929,"_7432":8930,"_7436":8931,"_7440":8932,"_7444":8934,"_7448":8935,"_7452":8936,"_8937":8938,"_8939":8940,"_8941":8942,"_8943":8944,"_8945":8946,"_8947":8948,"_8949":8950,"_8951":8952,"_8953":8954,"_8955":8956,"_8957":8958,"_8959":8960,"_8961":8962,"_8963":8964,"_8965":8966,"_8968":8969,"_8971":8972},{"_8795":37,"_8796":4059,"_8797":39,"_8798":5104,"_8799":5104,"_8800":4059,"_8801":37,"_8802":37},"