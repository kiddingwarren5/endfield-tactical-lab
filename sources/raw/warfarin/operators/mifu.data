4059,"_4627":4059,"_4628":4059,"_4629":4059,"_4630":4059,"_4631":4059,"_4632":4059,"_4633":4059,"_4634":4059,"_4635":4059,"_4636":4059,"_4637":4059,"_4638":4650,"_4640":4651,"_19":4652,"_4643":4648,"_4644":37,"_4645":4653},"普通攻击：\n对敌人进行至多4段攻击，造成<@ba.pd>物理伤害</>。作为主控干员时，<#ba.lastcombo>重击</>会造成<@ba.poise>{poise:0}</>点失衡。\n\n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成<@ba.pd>物理伤害</>。\n\n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量<@ba.pd>物理伤害</>并恢复一定技力。","icon_attack_claym","剑行拳意",[4654,4655,4656,4657,4658,4659],"chr_0031_mifu_attack1","chr_0031_mifu_attack2","chr_0031_mifu_attack3","chr_0031_mifu_attack4","chr_0031_mifu_plunging_attack_end","chr_0031_mifu_powerattack","chr_0031_mifu_NormalSkill",{"_4626":4059,"_4627":4059,"_4628":4059,"_4629":4059,"_4630":4059,"_4631":4059,"_4632":4059,"_4633":4059,"_4634":4059,"_4635":4059,"_4636":4059,"_4637":4059,"_4638":4662,"_4640":4663,"_19":4664,"_4643":4660,"_4644":39,"_4645":4665},"连续施放可最多施放3段不同招式，初始战技为<@ba.key>断云</>。\n<@ba.key>断云</>：消耗<@ba.vup>100</>技力，施放后<#ba.return>返还</><@ba.vup>50</>技力。从拳套中发射出拘束索，对目标及其附近敌人造成<@ba.pd>物理伤害</>并尝试将其拉取至自身附近。施放后战技在一段时间内替换为<@ba.key>追形</>。\n<@ba.key>追形</>：消耗<@ba.vup>50</>技力。朝前方连续挥拳造成<@ba.pd>物理伤害</>，最后一拳额外造成<#ba.crush>猛击</>。如果本次猛击<#ba.consume>消耗</>的最大<#ba.noguard>破防</>层数不少于3层，战技在一段时间内替换为<@ba.key>开天</>。\n<@ba.key>开天</>：消耗<@ba.vup>50</>技力，朝前方范围造成大量<@ba.pd>物理伤害</>。本次伤害类型不属于战技伤害，而是视为<#ba.crush>猛击</>伤害。","icon_skill_mifu_01","清波三艺",[4666,4667,4668],"chr_0031_mifu_normalskill_1","chr_0031_mifu_normalskill_2","chr_0031_mifu_normalskill_3","chr_0031_mifu_UltimateSkill",{"_4626":4059,"_4627":4059,"_4628":4059,"_4629":4059,"_4630":4059,"_4631":4059,"_4632":4059,"_4633":4059,"_4634":4059,"_4635":4059,"_4636":4059,"_4637":4059,"_4638":4671,"_4640":4672,"_19":4673,"_4643":4669,"_4644":55,"_4645":4674},"短暂蓄力后朝前方冲刺，对身前目标强制造成<#ba.airborne>击飞</>，随后将其砸向地面造成<@ba.pd>物理伤害</>。施放后战技在一段时间内替换为<@ba.key>追形</>。","icon_ultimate_skill_mifu_01","绝心",[4675],"chr_0031_mifu_ultimate_skill","skillLevelUp",[4678,4688,4693,4699,4704,4709,4716,4721,4725,