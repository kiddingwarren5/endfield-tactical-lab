"_38":3906},324,{"_36":58,"_38":37},{"_36":60,"_38":3909},1.48469387755102,{"_36":62,"_38":3911},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3931,"_101":64},{"_33":3932},[3933,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":3934},97,{"_36":41,"_38":3936},114.8074900063118,{"_36":44,"_38":3938},155.72164948453653,{"_36":47,"_38":3940},132.22680412371167,{"_36":50,"_38":3942},107.09278350515463,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},328,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2013},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3970,"_101":64},{"_33":3971},[3972,3973,3975,3977,3979,3981,3983,3985,3986,3988,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007],{"_36":37,"_38":963},{"_36":41,"_38":3974},115.85735325057858,{"_36":44,"_38":3976},157.190721649485,{"_36":47,"_38":3978},133.47422680412404,{"_36":50,"_38":3980},108.10309278350515,{"_36":39,"_38":3982},5944,{"_36":55,"_38":3984},331,{"_36":58,"_38":37},{"_36":60,"_38":3987},1.49489795918367,{"_36":62,"_38":3989},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4009,"_101":64},{"_33":4010},[4011,4013,4015,4017,4019,4021,4023,4025,4026,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046],{"_36":37,"_38":4012},99,{"_36":41,"_38":4014},116.90721649484536,{"_36":44,"_38":4016},158.65979381443344,{"_36":47,"_38":4018},134.7216494845364,{"_36":50,"_38":4020},109.11340206185565,{"_36":39,"_38":4022},6000,{"_36":55,"_38":4024},334,{"_36":58,"_38":37},{"_36":60,"_38":4027},1.5,{"_36":62,"_38":2051},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4049,4050],"tag_05","tag_02","charId","charIllustInitPos",{"_4054":4055,"_4056":4057},"x",192,"y",-312,"charPassiveUIPrefabName","","charTypeId","Pulse","cvName",{"_4064":4065,"_4066":4067,"_4068":4069,"_4070":4071,"_4051":16},"ChiCVName","钟可","EngCVName","Andrea Gatchalian","JapCVName","藤原夏海","KorCVName","金芽珑","defaultWeaponId","wpn_sword_0003","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Arclight","mainAttrType","phoneticName","profession","profileRecord",[4085,4096,4101,4106,4111,4116],{"_4051":16,"_15":4086,"_4087":4088,"_4089":4090,"_4091":39,"_4092":4093,"_4094":37,"_4095":37},"chr_0007_ikut_1","recordDesc","【代号】弧光\n【性别】女\n【身份认证】众生长地\n【生日】1月3日\n【种族】库兰塔\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：标准\n战术规划：普通\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4051":16,"_15":4097,"_4087":4098,"_4089":4099,"_4091":55,"_4092":4100,"_4094":37,"_4095":37},"chr_0007_ikut_2","弧光，众生长地游人。在奥里莎师者的引荐下加入终末地工业，任终末地外勤干员，同时为终末地工业的多项行动以及器械车辆保养与维护提供协助。\n\n对弧光而言，摩托车不仅仅是交通工具，更是一个需要陪伴“生长”的伙伴。一次次拆解与重塑，不是修补破损，而是蜕变与新生。或许，正是这份将机械与生命一同呵护的信念，才造就了她无与伦比的机械美学和机械工程的理解力。\n可能是因为她来自众生长地，只要有人需要，她就会毫不吝啬地将她知道的一切分享给需要的人。虽然她的话语往往会夹带着大量隐喻，但这正是弧光干员对这片荒野独特而深刻的洞见。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4051":16,"_15":4102,"_4087":4103,"_4089":4104,"_4091":58,"_4092":4105,"_4094":37,"_4095":37},"chr_0007_ikut_3","干员弧光，本名伊库特。每当被人问起她是否隶属于众生长地时，弧光总是回答：“我追随师者奥里莎，且一位游人只属于她自己。”\n弧光干员对摩托车似乎有着说不尽的热爱，曾经与弧光干员在关于她的摩托车这方面多次交谈的武库工程师谢苗干员这么说：\n“起初，我以为这是一辆偶然流入民间的军用特制摩托车。得知这台摩托竟然是弧光亲手组装、亲自调校的作品时，我一度难以置信。在得到她的许可后，我仔细研究了这辆车。它的源石发动机是梅什科工业十年前淘汰的旧型号。传动系统则来自特里格拉夫军工厂。减震器的标识已经磨损，但从结构推测，很可能出自北进重工支援所。而最令人惊叹的，是那副车架——显然是手工锻造，每一处焊点都细腻结实，整个车架仿佛天然一体。更难得的是，这副车架并非单纯拼接，而是以极高的技巧整合了各家设备的优点，使整车在力量、耐久与操控之间达到了近乎完美的平衡。”\n虽然弧光干员扎实的技术得到了所有人认可，但有不少干员不止一次地指出：弧光干员待人冷淡，她说的话总是难以理解。包括谢苗干员，也曾反映过她少言寡语。或许是由于她特殊的经历，弧光干员能给予他人的热情十分有限，第一次接触可能会留下不好相处的印象。但接触多了就会发现，她实际是个异常讲道理的人。如果和弧光干员经常交流的话，有时甚至能听到她的嘴里冒出一些仿佛在说笑的惊人发言。无需怀疑，她并不是在说笑，她就是这么想的。\n至于说弧光难以交流，那只是她的语言承载了众生长地特有的表达方式。她喜欢用自然的隐喻来表达判断，比如用驮兽的脾气比喻机器故障，用晨雾形容人的犹疑。对习惯直白语言的人来说，这种交流方式可能显得生疏，但只要认真倾听，就能发现她思路清晰、行动坚定。众生长地的游人有对世界的独特理解和自己的行事原则，要想听懂她的话，需要理解她讲述世界的方式。","CN_03","档案资料·一",{"_4051":16,"_15":4107,"_4087":4108,"_4089":4109,"_4091":64,"_4092":4110,"_4094":64,"_4095":3594},"chr_0007_ikut_4","我至今仍记得第一次见到伊库特的情景。当时的她奄奄一息，被巡逻的狩卫带回了营地。很难想象是什么让这个小女孩独自在荒野中流浪数月，还差点因缺乏食物和水而丧命。至于她右手的伤势，我们不得不以电路的方式重新连接她的右臂神经。当然，希望你们不用太担心她的右手是否安全，我们为她设计了一副特殊的绝缘手套，让她能够像正常人一样生活。\n我以歌谣中强壮且灵性的驮兽“伊库特”为她取名，希望她能像驮兽一样经受住风霜的考验，健康茁壮地成长。她做到了，而且比我预想的还要好。\n或许是因为她曾战胜了死亡的威胁，又或许是因为她背负着歌谣赋予她的名字，这孩子被“伊库特”这三个字赋予了太过沉重的使命。十五岁时，她踏上了游人的旅程，在荒野间流转。她总是倾尽全力去扶助每一个陷入困境的聚落，即便有时力不从心。\n我至今仍记得那场暴雨。在我们的那次救援行动中，她为了保护他人，孤身被卷入风暴深处。我们本以为她凶多吉少。就在所有希望即将破灭之际，一道闪电划破长空，她如一道弧光，穿透风暴，跃上最后一辆篷车。从此，荒野的人们便以“弧光”之名呼唤她。这个名字也被许多游人吟唱进他们的歌谣。她从歌谣中取走一个名字，又将一个全新的名字还给了歌谣。\n当她告诉我，她想去终末地寻找新的答案时，我并不感到惊讶。这让我想起了自己年轻时的那个选择。那时，我也曾远游至遥远星河的上方，感受着在漂泊之城中凝聚的希望与勇气。\n回首这一刻，恍若隔世。但我始终相信，只要星辰仍洒满天际，文明终将再次团结。而弧光，连同她在歌谣中种下的名字和誓言，也一定会找到她真正需要的答案。\n——奥里莎师者写给终末地工业的推荐信","CN_04","档案资料·二",{"_4051":16,"_15":4112,"_4087":4113,"_4089":4114,"_4091":66,"_4092":4115,"_4094":64,"_4095":3594},"chr_0007_ikut_5","一支庞大的裂地者部队将荒野上的一处定居点围住，企图发动一次规模庞大的袭击。在肉眼可见的威胁下，绝望开始在驻扎于此的终末地干员与聚落成员之间蔓延。\n就在这时，他们看到了她。一名骑着轰鸣摩托车的游人独自呼啸着冲进了聚落——此人正是来自众生长地的弧光。\n她从裂地者后方冲出，毫不犹豫地接管了局面。在她的统筹安排下，聚落成员们用篷车和废料搭建防线，将老人和孩童转移到高处。弧光动员所有尚有劳动能力的人，挖掘壕沟，布置简易的源石防御单元。她的每一个举动都冷静而简洁，穿梭的身影仿佛和荒野融为一体。\n在裂地者进攻前夕，远处传来了阵阵雷声，雨季如期而至，一夜暴雨在山谷中催生出一条湍急的新河。或许弧光记得荒野的每一个角落，奔腾的河水冲刷着弧光先前改造过的地势，将整个聚落环绕成一座“孤岛”。洪水径直冲向裂地者营地，粉碎了他们的阵形。\n不甘失败的裂地者们试图渡河强攻防线，但屡屡被弧光连同终末地干员和聚落成员击退。最终，这支劫掠的部队在雨夜中逃之夭夭。\n笼罩在荒野上的乌云散去后，弧光找到了正在向帝江号汇报的终末地干员，将介绍信在空中挥了挥，说道：“荒野上沙土的震动将我带到了这里。现在，请你们引领我前往终末地。”","CN_05","档案资料·三",{"_4051":16,"_15":4117,"_4087":4118,"_4089":4119,"_4091":68,"_4092":4120,"_4094":64,"_4095":4121},"chr_0007_ikut_6","曾几何时，芳草如浪，河水平静如丝。\n如今，大地的骨骼已然松动，\n天空低垂，风雨交加。\n断骨散落荒野，尘土飞扬。\n游人的歌声，掩盖不住悲叹与怒吼。\n我如跛足的驮畜，逃离翻滚的黑色海洋。\n何处是众生长地，众生长地？\n我的道路布满荆棘与灰烬。\n何处是众生长地，众生长地？\n漂泊的城市将希望的锚抛向大地。\n而我，追随沉寂的星辰，再次启程。\n众生长地，引领我到尽头。\n风儿不停，我亦不止。\n——弧光的“歌谣”","CN_06","档案资料·四",1500,"profileVoice",[4124,4132,4136,4140,4144,4148,4152,4157,4162,4167,4172,4177,4182,4187,4192,4197,4202,4207,4212,4217,4222,4227,4232,4237,4242,4247,4252,4257,4262,4267,4272,4277,4282,4287,4292,4297,4302,4307,4312,4317,4322,4327,4332,4337,4342,4347,4352,4357,4362,4367,4372,4377,4382,4387,4392,4397,4402,4407,4412,4417,4422,4427,4432,4437,4442,4447,4452,4457,4462,4467,4472,4477,4482,4487,4492,4497,4502,4507,4512,4517,4522],{"_4051":16,"_15":4086,"_4094":37,"_4095":37,"_4125":4126,"_4127":4128,"_4129":39,"_4130":4131},"voId","chr_0007_ikut_chrbark_squad_01","voiceDesc","荒野充满了危险，你准备好了吗？","voiceIndex","voiceTitle","行动准备1",{"_4051":16,"_15":4097,"_4094":37,"_4095":37,"_4125":4133,"_4127":4134,"_4129":55,"_4130":4135},"chr_0007_ikut_chrbark_squad_02","风不会停下，我也不会。","行动准备2",{"_4051":16,"_15":4102,"_4094":37,"_4095":37,"_4125":4137,"_4127":4138,"_4129":58,"_4130":4139},"chr_0007_ikut_chrbark_join_01","终于能出去透透气了，我都快忘了泥土的味道。","编入队伍1",{"_4051":16,"_15":4107,"_4094":37,"_4095":37,"_4125":4141,"_4127":4142,"_4129":64,"_4130":4143},"chr_0007_ikut_chrbark_join_02","你放心，无论多快的速度，我都能跟得上。","编入队伍2",{"_4051":16,"_15":4112,"_4094":37,"_4095":37,"_4125":4145,"_4127":4146,"_4129":66,"_4130":4147},"chr_0007_ikut_chrbark_weap_01","我能感受到它的呼吸，它很适合我。","更换武器",{"_4051":16,"_15":4117,"_4094":37,"_4095":37,"_4125":4149,"_4127":4150,"_4129":68,"_4130":4151},"chr_0007_ikut_chrbark_gear_01","精湛的工艺……我见过不少师者，但这样的精度，很少有人能做到。","更换装备",{"_4051":16,"_15":4153,"_4094":37,"_4095":37,"_4125":4154,"_4127":4155,"_4129":70,"_4130":4156},"chr_0007_ikut_7","chr_0007_ikut_chrup_skill_01","和师者教给我的不同，但最终殊途同归。很有启发。","激活天赋阵列",{"_4051":16,"_15":4158,"_4094":37,"_4095":37,"_4125":4159,"_4127":4160,"_4129":88,"_4130":4161},"chr_0007_ikut_8","chr_0007_ikut_chrup_level_01","荒野生活带来经验，而这些……是将经验锻造成利刃。","观看作战记录",{"_4051":16,"_15":4163,"_4094":55,"_4095":39,"_4125":4164,"_4127":4165,"_4129":90,"_4130":4166},"chr_0007_ikut_9","chr_0007_ikut_chrup_promt01_01","晋升？也就是，被认可？能得到你的认可……我很开心。","精英化晋升1",{"_4051":16,"_15":4168,"_4094":55,"_4095":55,"_4125":4169,"_4127":4170,"_4129":409,"_4130":4171},"chr_0007_ikut_10","chr_0007_ikut_chrup_promt02_01","荣誉的背后是责任。这一切都在提醒我，要尽力帮助更多人。","精英化晋升2",{"_4051":16,"_15":4173,"_4094":55,"_4095":58,"_4125":4174,"_4127":4175,"_4129":100,"_4130":4176},"chr_0007_ikut_11","chr_0007_ikut_chrup_promt03_01","自然不教人如何生存，它只是留下痕迹。过去我只是在适应，现在……我开始明白一点它的道理。","精英化晋升3",{"_4051":16,"_15":4178,"_4094":55,"_4095":64,"_4125":4179,"_4127":4180,"_4129":95,"_4130":4181},"chr_0007_ikut_12","chr_0007_ikut_chrup_promt04_01","在你身边，我学到了很多。我逐渐明白，为什么“歌谣”将我引向这里，引向你的身边。我会好好运用它们。","精英化晋升4",{"_4051":16,"_15":4183,"_4094":37,"_4095":37,"_4125":4184,"_4127":4185,"_4129":526,"_4130":4186},"chr_0007_ikut_13","chr_0007_ikut_introduce_01","我叫伊库特，代号是弧光，你好。我不会说什么漂亮话，就祝你像涨水的河流一样奔涌吧。","干员报到",{"_4051":16,"_15":4188,"_4094":37,"_4095":37,"_4125":4189,"_4127":4190,"_4129":565,"_4130":4191},"chr_0007_ikut_14","chr_0007_ikut_mono_switch_01","前面的路已经清楚了。","待命1",{"_4051":16,"_15":4193,"_4094":37,"_4095":37,"_4125":4194,"_4127":4195,"_4129":97,"_4130":4196},"chr_0007_ikut_15","chr_0007_ikut_mono_switch_02","已调整到最佳状态。","待命2",{"_4051":16,"_15":4198,"_4094":37,"_4095":37,"_4125":4199,"_4127":4200,"_4129":643,"_4130":4201},"chr_0007_ikut_16","chr_0007_ikut_sim_assign_work_01","没问题，游人从不懈怠。","进驻设施",{"_4051":16,"_15":4203,"_4094":37,"_4095":37,"_4125":4204,"_4127":4205,"_4129":683,"_4130":4206},"chr_0007_ikut_17","chr_0007_ikut_sim_hello_lower_01","管理员，今天的风向如何？","打招呼1",{"_4051":16,"_15":4208,"_4094":64,"_4095":3594,"_4125":4209,"_4127":4210,"_4129":722,"_4130":4211},"chr_0007_ikut_18","chr_0007_ikut_sim_hello_max_01","管理员，刚从外面回来吗？你身上有荒野的味道。","打招呼2",{"_4051":16,"_15":4213,"_4094":37,"_4095":37,"_4125":4214,"_4127":4215,"_4129":762,"_4130":4216},"chr_0007_ikut_19","chr_0007_ikut_sim_talk_lv01_01","修摩托车就像给瘤兽看病一样，都需要仔细倾听，然后给出回应。","帝江号闲聊1",{"_4051":16,"_15":4218,"_4094":64,"_4095":3594,"_4125":4219,"_4127":4220,"_4129":801,"_4130":4221},"chr_0007_ikut_20","chr_0007_ikut_sim_talk_lv02_01","这里的星空，与荒野不同……但同样让人想一直看下去。","帝江号闲聊2",{"_4051":16,"_15":4223,"_4094":64,"_4095":3594,"_4125":4224,"_4127":4225,"_4129":872,"_4130":4226},"chr_0007_ikut_21","chr_0007_ikut_sim_talk_lv02_02","我在看那些云团，边缘很锋利，是暴风雨的预兆。近期如果要去那一带，请务必小心。","帝江号闲聊3",{"_4051":16,"_15":4228,"_4094":64,"_4095":4121,"_4125":4229,"_4127":4230,"_4129":911,"_4130":4231},"chr_0007_ikut_22","chr_0007_ikut_sim_talk_max_01","你的头发很漂亮，像被晨雾打湿的兽皮。没见过？总之……很好看。","帝江号闲聊4",{"_4051":16,"_15":4233,"_4094":64,"_4095":4121,"_4125":4234,"_4127":4235,"_4129":951,"_4130":4236},"chr_0007_ikut_23","chr_0007_ikut_sim_talk_max_02","你见过草原上的迁徙吗？篷车驱赶着兽群，缓缓追逐着雨和云。那就是我想守护的东西。","帝江号闲聊5",{"_4051":16,"_15":4238,"_4094":64,"_4095":4121,"_4125":4239,"_4127":4240,"_4129":990,"_4130":4241},"chr_0007_ikut_24","chr_0007_ikut_sim_talk_max_03","你常常对着这颗星球出神，我想，我能理解。即使距离再远，我们的心也总会留在最牵挂的地方。","帝江号闲聊6",{"_4051":16,"_15":4243,"_4094":37,"_4095":37,"_4125":4244,"_4127":4245,"_4129":62,"_4130":4246},"chr_0007_ikut_25","chr_0007_ikut_sim_gift_give_01","我给你带了点东西，荒野的馈赠，希望你会喜欢。","赠送礼物",{"_4051":16,"_15":4248,"_4094":37,"_4095":37,"_4125":4249,"_4127":4250,"_4129":1068,"_4130":4251},"chr_0007_ikut_26","chr_0007_ikut_sim_gift_recv_01","礼物？荒野上的赠礼意义非凡……我会认真对待的。","接收礼物",{"_4051":16,"_15":4253,"_4094":37,"_4095":37,"_4125":4254,"_4127":4255,"_4129":1108,"_4130":4256},"chr_0007_ikut_27","chr_0007_ikut_mono_self_line01","管理员，我建议你学习一些基础的野外生存技能。可以从徒手制作捕捉长耳兽的陷阱开始，我教你。","信赖对话1",{"_4051":16,"_15":4258,"_4094":64,"_4095":3594,"_4125":4259,"_4127":4260,"_4129":1147,"_4130":4261},"chr_0007_ikut_28","chr_0007_ikut_mono_self_line02","荒野上的生活确实艰苦，但是，也很美。比如漫长雨季刚结束时的天空，比如月落时分破壳而出的羽兽。","信赖对话2",{"_4051":16,"_15":4263,"_4094":64,"_4095":3594,"_4125":4264,"_4127":4265,"_4129":1187,"_4130":4266},"chr_0007_ikut_29","chr_0007_ikut_mono_self_line03","废旧设备组装在一起，为什么能有更好的性能？其实没什么神秘。就像让彼此陌生的驮兽学会一起拉车，慢慢来，总能配合上。","信赖对话3",{"_4051":16,"_15":4268,"_4094":64,"_4095":4121,"_4125":4269,"_4127":4270,"_4129":56,"_4130":4271},"chr_0007_ikut_30","chr_0007_ikut_mono_self_line04","我开始游历，是为了寻找一个答案。荒野的平衡早已被打破，我该做些什么？我在湖泊的浪涛和密林的风声中寻求过答案。而现在，我想听见你的声音。","信赖对话4",{"_4051":16,"_15":4273,"_4094":64,"_4095":4121,"_4125":4274,"_4127":4275,"_4129":1265,"_4130":4276},"chr_0007_ikut_31","chr_0007_ikut_mono_self_line05","我会把这里的故事唱进“歌谣”里，记录那些我们一起走过的路。值得传唱的事实在太多，得花些时间整理。等到“歌谣”成形，你会是第一个听众。","信赖对话5",{"_4051":16,"_15":4278,"_4094":37,"_4095":37,"_4125":4279,"_4127":4280,"_4129":1304,"_4130":4281},"chr_0007_ikut_32","chr_0007_ikut_mono_chat_line01","那些想活下去的人，总会发出声音；那些四处游历的游人，总能听见它们。这就是众生长地存在的意义。","交谈1",{"_4051":16,"_15":4283,"_4094":37,"_4095":37,"_4125":4284,"_4127":4285,"_4129":117,"_4130":4286},"chr_0007_ikut_33","chr_0007_ikut_mono_chat_line02","荒野聚落的人很好相处，我们关心的东西很实际：天气、食物、威胁。这些已经足够占满我们的时间。","交谈2",{"_4051":16,"_15":4288,"_4094":37,"_4095":37,"_4125":4289,"_4127":4290,"_4129":1382,"_4130":4291},"chr_0007_ikut_34","chr_0007_ikut_mono_chat_line03","记住“歌谣”并不难，每个众生长地的游人都能做到。它贯穿我们的生活，而我们，也只是其中的一部分。","交谈3",{"_4051":16,"_15":4293,"_4094":37,"_4095":37,"_4125":4294,"_4127":4295,"_4129":1422,"_4130":4296},"chr_0007_ikut_35","chr_0007_ikut_mono_chat_line04","师者说，泰拉上的城可以移动，为了躲避天灾而迁徙。这样看来，我们不过是在用另一种方式延续祖先的生活。","交谈4",{"_4051":16,"_15":4298,"_4094":37,"_4095":37,"_4125":4299,"_4127":4300,"_4129":156,"_4130":4301},"chr_0007_ikut_36","chr_0007_ikut_mono_chat_line05","荒野上有专门交易旧货的地方，想淘到好东西，得有足够的耐心。我的通讯器就改装自一件耶尔什的旧设备。那里产的东西在极端环境下很可靠。","交谈5",{"_4051":16,"_15":4303,"_4094":37,"_4095":37,"_4125":4304,"_4127":4305,"_4129":1500,"_4130":4306},"chr_0007_ikut_37","chr_0007_ikut_mono_about_line01","塔卫二比我想象得更广阔。起初，我以为所有的城都千篇一律，钢铁、道路、灯光，不过是换了排列方式。但当我真正走进它们，才发现每座城都有自己的脉搏和气息，它们的区别之大，甚至不亚于两片截然不同的草场。","话题：城市",{"_4051":16,"_15":4308,"_4094":37,"_4095":37,"_4125":4309,"_4127":4310,"_4129":1539,"_4130":4311},"chr_0007_ikut_38","chr_0007_ikut_mono_about_line02","我去过很多地方。就连最偏远的聚落，也流传着关于你的故事。虽然那些故事早被传得走了样，但有一点出奇地一致——你的名字，总和希望连在一起。","话题：管理员",{"_4051":16,"_15":4313,"_4094":37,"_4095":37,"_4125":4314,"_4127":4315,"_4129":41,"_4130":4316},"chr_0007_ikut_39","chr_0007_ikut_mono_about_line03","“歌谣”最初只有三句，由一位难民在临死前唱出。众生长地，就从那三句歌词里生长。从第一位师者开始，游人们便循着“歌谣”游历，直到自己也成为“歌谣”的一部分。","话题：“歌谣”",{"_4051":16,"_15":4318,"_4094":37,"_4095":37,"_4125":4319,"_4127":4320,"_4129":44,"_4130":4321},"chr_0007_ikut_40","chr_0007_ikut_mono_about_line04","师者很少直接讲述道理。奥里莎师者会说，知识都在“歌谣”里。她习惯用行动教导我：只有尽力互助，我们才能在这颗星球上生存。","话题：师者",{"_4051":16,"_15":4323,"_4094":37,"_4095":37,"_4125":4324,"_4127":4325,"_4129":47,"_4130":4326},"chr_0007_ikut_41","chr_0007_ikut_mono_about_line05","我成长的那个聚落并不大，不足百人。启程游历前，它就是我生活的全部。在那里，我学会给瘤兽挤奶、骑摩托车和荒野生存所需的一切。我没有离开那里，我只是带着它一起上路了。","话题：聚落",{"_4051":16,"_15":4328,"_4094":37,"_4095":37,"_4125":4329,"_4127":4330,"_4129":50,"_4130":4331},"chr_0007_ikut_42","chr_0007_ikut_explore_point_common_01","利于生存，尽可能带上。","发现资源1",{"_4051":16,"_15":4333,"_4094":37,"_4095":37,"_4125":4334,"_4127":4335,"_4129":1764,"_4130":4336},"chr_0007_ikut_43","chr_0007_ikut_explore_point_valub_01","师者会对这些东西感兴趣的。","发现资源2",{"_4051":16,"_15":4338,"_4094":37,"_4095":37,"_4125":4339,"_4127":4340,"_4129":1803,"_4130":4341},"chr_0007_ikut_44","chr_0007_ikut_explore_find_locked_01","跟上，去看看。","发现未探索区域",{"_4051":16,"_15":4343,"_4094":37,"_4095":37,"_4125":4344,"_4127":4345,"_4129":269,"_4130":4346},"chr_0007_ikut_45","chr_0007_ikut_explore_find_danger_01","危险的气息，是个棘手的敌人。","发现强敌",{"_4051":16,"_15":4348,"_4094":37,"_4095":37,"_4125":4349,"_4127":4350,"_4129":1881,"_4130":4351},"chr_0007_ikut_46","chr_0007_ikut_interact_mine_valub_01","大地的馈赠。","采集矿物1",{"_4051":16,"_15":4353,"_4094":37,"_4095":37,"_4125":4354,"_4127":4355,"_4129":1921,"_4130":4356},"chr_0007_ikut_47","chr_0007_ikut_interact_mine_valub_echo2_01","换我来吧，体力活，我的强项。","采集矿物2",{"_4051":16,"_15":4358,"_4094":37,"_4095":37,"_4125":4359,"_4127":4360,"_4129":72,"_4130":4361},"chr_0007_ikut_48","chr_0007_ikut_interact_treasure_valub_01","这在荒野上不常见，值得好好利用。","打开储藏箱",{"_4051":16,"_15":4363,"_4094":37,"_4095":37,"_4125":4364,"_4127":4365,"_4129":60,"_4130":4366},"chr_0007_ikut_49","chr_0007_ikut_interact_etherium_01","我们会把这些光球捉进瓶子里照明。","获得醚质",{"_4051":16,"_15":4368,"_4094":37,"_4095":37,"_4125":4369,"_4127":4370,"_4129":76,"_4130":4371},"chr_0007_ikut_50","chr_0007_ikut_interact_blight_break_01","大自然应当回到正轨。","消除侵蚀",{"_4051":16,"_15":4373,"_4094":37,"_4095":37,"_4125":4374,"_4127":4375,"_4129":78,"_4130":4376},"chr_0007_ikut_51","chr_0007_ikut_interact_rest_01","这里让我想起了荒野里的篝火，而且似乎有同样的温度。","休整",{"_4051":16,"_15":4378,"_4094":37,"_4095":37,"_4125":4379,"_4127":4380,"_4129":80,"_4130":4381},"chr_0007_ikut_52","chr_0007_ikut_combat_suppuse_using_01","稳住呼吸节奏。","使用战术物品1",{"_4051":16,"_15":4383,"_4094":37,"_4095":37,"_4125":4384,"_4127":4385,"_4129":82,"_4130":4386},"chr_0007_ikut_53","chr_0007_ikut_combat_suppuse_getheal_01","体力在恢复。","使用战术物品2",{"_4051":16,"_15":4388,"_4094":37,"_4095":37,"_4125":4389,"_4127":4390,"_4129":84,"_4130":4391},"chr_0007_ikut_54","chr_0007_ikut_combat_remind_danger_01","别停，动起来。","危险提醒",{"_4051":16,"_15":4393,"_4094":37,"_4095":37,"_4125":4394,"_4127":4395,"_4129":86,"_4130":4396},"chr_0007_ikut_55","chr_0007_ikut_combat_hurt_lowhp_01","速度会慢些，但还能继续。","负伤",{"_4051":16,"_15":4398,"_4094":37,"_4095":37,"_4125":4399,"_4127":4400,"_4129":2268,"_4130":4401},"chr_0007_ikut_56","chr_0007_ikut_combat_dead_01","抱歉，没能帮到你。","力竭",{"_4051":16,"_15":4403,"_4094":37,"_4095":37,"_4125":4404,"_4127":4405,"_4129":2308,"_4130":4406},"chr_0007_ikut_57","chr_0007_ikut_combat_remind_praise_01","好快的反应！","小队激励1",{"_4051":16,"_15":4408,"_4094":37,"_4095":37,"_4125":4409,"_4127":4410,"_4129":421,"_4130":4411},"chr_0007_ikut_58","chr_0007_ikut_combat_remind_praise_02","像风和雷一样默契。","小队激励2",{"_4051":16,"_15":4413,"_4094":37,"_4095":37,"_4125":4414,"_4127":4415,"_4129":2386,"_4130":4416},"chr_0007_ikut_59","chr_0007_ikut_combat_remind_praise_echo2_01","这在我职责之内。","回应激励1",{"_4051":16,"_15":4418,"_4094":37,"_4095":37,"_4125":4419,"_4127":4420,"_4129":74,"_4130":4421},"chr_0007_ikut_60","chr_0007_ikut_combat_remind_praise_echo2_02","我只是配合大家。","回应激励2",{"_4051":16,"_15":4423,"_4094":37,"_4095":37,"_4125":4424,"_4127":4425,"_4129":460,"_4130":4426},"chr_0007_ikut_61","chr_0007_ikut_combat_intobattle_01","我已经进入状态了。","作战开始1",{"_4051":16,"_15":4428,"_4094":37,"_4095":37,"_4125":4429,"_4127":4430,"_4129":2533,"_4130":4431},"chr_0007_ikut_62","chr_0007_ikut_combat_intobattle_echo2_01","那个方向就交给你了。","作战开始2",{"_4051":16,"_15":4433,"_4094":37,"_4095":37,"_4125":4434,"_4127":4435,"_4129":2573,"_4130":4436},"chr_0007_ikut_63","chr_0007_ikut_combat_outbattle_nor_01","归于平静吧。","作战胜利1",{"_4051":16,"_15":4438,"_4094":37,"_4095":37,"_4125":4439,"_4127":4440,"_4129":498,"_4130":4441},"chr_0007_ikut_64","chr_0007_ikut_combat_outbattle_nor_02","愿大地接纳你们。","作战胜利2",{"_4051":16,"_15":4443,"_4094":37,"_4095":37,"_4125":4444,"_4127":4445,"_4129":2651,"_4130":4446},"chr_0007_ikut_65","chr_0007_ikut_combat_outbattle_nor_echo2_01","这是自然所愿。","作战胜利3",{"_4051":16,"_15":4448,"_4094":37,"_4095":37,"_4125":4449,"_4127":4450,"_4129":2690,"_4130":4451},"chr_0007_ikut_66","chr_0007_ikut_combat_outbattle_hard_01","荒野中的每一件事物，都在磨砺中成长。","作战胜利4",{"_4051":16,"_15":4453,"_4094":37,"_4095":37,"_4125":4454,"_412