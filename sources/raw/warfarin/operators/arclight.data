:8038},[7569,7569,7569],[7622,7622,7623],"qu.numup",{"_15":8039,"_7567":8041,"_7570":8042},[7569,7569,7569],[8043,8043,8043],"<color=#c7fe02>","rac.tec",{"_15":8044,"_7567":8046,"_7570":8047},[7569,7569,7569],[8048,8048,8048],"<color=#FFCC00>","scene_grade.down",{"_15":8049,"_7567":8051,"_7570":8052},[7569,7569,7569],[8053,8053,8053],"<color=#D12E42>","set.key",{"_15":8054,"_7567":8056,"_7570":8057},[7569,7569,7569],[8058,8058,8058],"<color=#A7A7A7>","tech.get",{"_15":8059,"_7567":8061,"_7570":8062},[7569,7569,7569],[8063,8063,8063],"<color=#1e1e1e>","tips.key",{"_15":8064,"_7567":8066,"_7570":8067},[7569,7569,7569],[8068,8069,8068],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":8070,"_7567":8072,"_7570":8073},[7569,7569,7569],[7857,7858,7859],"toast_focal.key",{"_15":8074,"_7567":8076,"_7570":8077},[7569,7569,7569],[8069,8069,8069],"weapon.stress",{"_15":8078,"_7567":8080,"_7570":8081},[7569,7569,7569],[8082,8082,8082],"<color=#fe5a00>","weekraid.key",{"_15":8083,"_7567":8085,"_7570":8086},[7726,7726,7726],[8087,8087,8088],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_8091":8092,"_8098":8099,"_7780":8103,"_8108":8109,"_8112":8113,"_8117":8118,"_8121":8122,"_8126":8127,"_8130":8131,"_8135":8136,"_8139":8140,"_7595":8144,"_8149":8150,"_8153":8154,"_8158":8159,"_8163":8164,"_8167":8168,"_8172":8173,"_7678":8176,"_8181":8182,"_8185":8186,"_8191":8192,"_7684":8195,"_8200":8201,"_8204":8205,"_7702":8209,"_8214":8215,"_8218":8219,"_7709":8223,"_8228":8229,"_8234":8235,"_7733":8239,"_8244":8245,"_8249":8250,"_8254":8255,"_8259":8260,"_7740":8264,"_8268":8269,"_8273":8274,"_8278":8279,"_8282":8283,"_8288":8289,"_8293":8294,"_7770":8298,"_8303":8304,"_8308":8309,"_8311":8312,"_8315":8316,"_8320":8321,"_8324":8325,"_8330":8331,"_8334":8335,"_8339":8340,"_8344":8345,"_7787":8349,"_8353":8354,"_8356":8357,"_7807":8361,"_8365":8366,"_8370":8371,"_8375":8376,"_8380":8381,"_8384":8385,"_8389":8390,"_7607":8395,"_7646":8399,"_8404":8405,"_8409":8410,"_8414":8415,"_7833":8419,"_8424":8425,"_8427":8428,"_8431":8432,"_8435":8436,"_8440":8441,"_8445":8446,"_8449":8450,"_8454":8455,"_7873":8459,"_8463":8464,"_8468":8469,"_8473":8474,"_8478":8479,"_8482":8483,"_8486":8487,"_8491":8492,"_8496":8497,"_8500":8501,"_8506":8507,"_8510":8511,"_8514":8515,"_8519":8520,"_8523":8524,"_8527":8528,"_8531":8532,"_8537":8538,"_8542":8543,"_8547":8548,"_8552":8553,"_8557":8558,"_8562":8563,"_8567":8568,"_8572":8573,"_8577":8578,"_8582":8583,"_8587":8588,"_8592":8593,"_8597":8598,"_8602":8603},"adv.electricFence",{"_4623":8093,"_8094":4059,"_15":8091,"_8095":4059,"_19":8096,"_8097":7663},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4623":8100,"_8094":8101,"_15":8098,"_8095":4059,"_19":8102,"_8097":7716},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4623":8104,"_8094":8105,"_15":7780,"_8095":8106,"_19":8107,"_8097":7845},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4623":8110,"_8094":4059,"_15":8108,"_8095":4059,"_19":8111,"_8097":7663},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4623":8114,"_8094":8115,"_15":8112,"_8095":4059,"_19":8116,"_8097":7663},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4623":8119,"_8094":4059,"_15":8117,"_8095":4059,"_19":8120,"_8097":7663},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4623":8123,"_8094":8124,"_15":8121,"_8095":4059,"_19":8125,"_8097":7757},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4623":8128,"_8094":4059,"_15":8126,"_8095":4059,"_19":8129,"_8097":7663},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4623":8132,"_8094":8133,"_15":8130,"_8095":4059,"_19":8134,"_8097":7663},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4623":8137,"_8094":4059,"_15":8135,"_8095":4059,"_19":8138,"_8097":4059},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4623":8141,"_8094":8142,"_15":8139,"_8095":4059,"_19":8143,"_8097":7716},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4623":8145,"_8094":8146,"_15":7595,"_8095":8147,"_19":8148,"_8097":7845},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4623":8151,"_8094":4059,"_15":8149,"_8095":4059,"_19":8152,"_8097":7663},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4623":8155,"_8094":8156,"_15":8153,"_8095":4059,"_19":8157,"_8097":7663},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4623":8160,"_8094":8161,"_15":8158,"_8095":4059,"_19":8162,"_8097":7663},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4623":8165,"_8094":4059,"_15":8163,"_8095":4059,"_19":8166,"_8097":7690},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4623":8169,"_8094":8170,"_15":8167,"_8095":4059,"_19":8171,"_8097":7663},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4623":8174,"_8094":4059,"_15":8172,"_8095":4059,"_19":8175,"_8097":7690},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4623":8177,"_8094":8178,"_15":7678,"_8095":8179,"_19":8180,"_8097":7757},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4623":8183,"_8094":8178,"_15":8181,"_8095":4059,"_19":8184,"_8097":7757},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4623":8187,"_8094":8188,"_15":8185,"_8095":8189,"_19":8190,"_8097":7690},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4623":8193,"_8094":4059,"_15":8191,"_8095":4059,"_19":8194,"_8097":7690},"持续时间内，受影响的目标暂停行动。","定身",{"_4623":8196,"_8094":8197,"_15":7684,"_8095":8198,"_19":8199,"_8097":7869},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4623":8202,"_8094":8197,"_15":8200,"_8095":4059,"_19":8203,"_8097":7869},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4623":8206,"_8094":4059,"_15":8204,"_8095":8207,"_19":8208,"_8097":4059},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4623":8210,"_8094":8211,"_15":7702,"_8095":8212,"_19":8213,"_8097":7819},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4623":8216,"_8094":8211,"_15":8214,"_8095":4059,"_19":8217,"_8097":7819},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4623":8220,"_8094":8221,"_15":8218,"_8095":4059,"_19":8222,"_8097":7663},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4623":8224,"_8094":8225,"_15":7709,"_8095":8226,"_19":8227,"_8097":7845},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4623":8230,"_8094":8231,"_15":8228,"_8095":8232,"_19":8233,"_8097":7690},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4623":8236,"_8094":8237,"_15":8234,"_8095":4059,"_19":8238,"_8097":7690},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4623":8240,"_8094":8241,"_15":7733,"_8095":8242,"_19":8243,"_8097":7716},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4623":8246,"_8094":4059,"_15":8244,"_8095":8247,"_19":8248,"_8097":7716},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4623":8251,"_8094":8252,"_15":8249,"_8095":4059,"_19":8253,"_8097":7663},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4623":8256,"_8094":8257,"_15":8254,"_8095":4059,"_19":8258,"_8097":7663},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4623":8261,"_8094":8262,"_15":8259,"_8095":4059,"_19":8263,"_8097":7716},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4623":8265,"_8094":8101,"_15":7740,"_8095":8266,"_19":8267,"_8097":7716},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4623":8270,"_8094":4059,"_15":8268,"_8095":8271,"_19":8272,"_8097":7690},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4623":8275,"_8094":8276,"_15":8273,"_8095":4059,"_19":8277,"_8097":7663},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4623":8280,"_8094":4059,"_15":8278,"_8095":4059,"_19":8281,"_8097":4059},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4623":8284,"_8094":8285,"_15":8282,"_8095":8286,"_19":8287,"_8097":7690},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4623":8290,"_8094":8291,"_15":8288,"_8095":4059,"_19":8292,"_8097":7663},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4623":8295,"_8094":4059,"_15":8293,"_8095":8296,"_19":8297,"_8097":7757},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4623":8299,"_8094":8300,"_15":7770,"_8095":8301,"_19":8302,"_8097":7757},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4623":8305,"_8094":8306,"_15":8303,"_8095":4059,"_19":8307,"_8097":7663},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4623":8183,"_8094":8300,"_15":8308,"_8095":4059,"_19":8310,"_8097":7757},"干员受到灼热附着","sys.tacticalItem",{"_4623":8313,"_8094":4059,"_15":8311,"_8095":4059,"_19":8314,"_8097":7663},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4623":8317,"_8094":8318,"_15":8315,"_8095":4059,"_19":8319,"_8097":7757},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4623":8202,"_8094":8322,"_15":8320,"_8095":4059,"_19":8323,"_8097":7869},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4623":8326,"_8094":8327,"_15":8324,"_8095":8328,"_19":8329,"_8097":7690},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4623":8332,"_8094":4059,"_15":8330,"_8095":4059,"_19":8333,"_8097":7690},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4623":8336,"_8094":8337,"_15":8334,"_8095":4059,"_19":8338,"_8097":7845},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4623":8341,"_8094":8342,"_15":8339,"_8095":4059,"_19":8343,"_8097":7869},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4623":8346,"_8094":8347,"_15":8344,"_8095":4059,"_19":8348,"_8097":7690},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4623":8350,"_8094":8351,"_15":7787,"_8095":8242,"_19":8352,"_8097":7716},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4623":8100,"_8094":8351,"_15":8353,"_8095":4059,"_19":8355,"_8097":7716},"干员受到冻结","ba.naturalvul",{"_4623":8358,"_8094":8359,"_15":8356,"_8095":4059,"_19":8360,"_8097":7819},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4623":8145,"_8094":8362,"_15":7807,"_8095":8363,"_19":8364,"_8097":7845},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4623":8367,"_8094":8368,"_15":8365,"_8095":4059,"_19":8369,"_8097":7663},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4623":8372,"_8094":8373,"_15":8370,"_8095":4059,"_19":8374,"_8097":7663},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4623":8377,"_8094":8378,"_15":8375,"_8095":4059,"_19":8379,"_8097":7663},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4623":8382,"_8094":4059,"_15":8380,"_8095":4059,"_19":8383,"_8097":7663},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4623":8386,"_8094":4059,"_15":8384,"_8095":8387,"_19":8388,"_8097":4059},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4623":8391,"_8094":8392,"_15":8389,"_8095":8393,"_19":8394,"_8097":7690},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4623":8396,"_8094":4059,"_15":7607,"_8095":8397,"_19":8398,"_8097":7819},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4623":8400,"_8094":8401,"_15":7646,"_8095":8402,"_19":8403,"_8097":7845},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4623":8406,"_8094":8407,"_15":8404,"_8095":4059,"_19":8408,"_8097":7663},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4623":8411,"_8094":8412,"_15":8409,"_8095":4059,"_19":8413,"_8097":7819},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4623":8416,"_8094":8417,"_15":8414,"_8095":4059,"_19":8418,"_8097":7663},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4623":8420,"_8094":8421,"_15":7833,"_8095":8422,"_19":8423,"_8097":7819},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4623":8216,"_8094":8421,"_15":8424,"_8095":4059,"_19":8426,"_8097":7819},"干员受到自然附着","ba.originium",{"_4623":8429,"_8094":4059,"_15":8427,"_8095":4059,"_19":8430,"_8097":7690},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4623":8433,"_8094":4059,"_15":8431,"_8095":4059,"_19":8434,"_8097":7845},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4623":8437,"_8094":8438,"_15":8435,"_8095":4059,"_19":8439,"_8097":7845},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4623":8442,"_8094":4059,"_15":8440,"_8095":8443,"_19":8444,"_8097":7853},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4623":8447,"_8094":4059,"_15":8445,"_8095":4059,"_19":8448,"_8097":7663},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4623":8451,"_8094":4059,"_15":8449,"_8095":8452,"_19":8453,"_8097":7869},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4623":8456,"_8094":8457,"_15":8454,"_8095":4059,"_19":8458,"_8097":7663},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4623":8460,"_8094":8322,"_15":7873,"_8095":8461,"_19":8462,"_8097":7869},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4623":8465,"_8094":8466,"_15":8463,"_8095":4059,"_19":8467,"_8097":7869},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4623":8470,"_8094":4059,"_15":8468,"_8095":8471,"_19":8472,"_8097":7690},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4623":8475,"_8094":4059,"_15":8473,"_8095":8476,"_19":8477,"_8097":4059},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4623":8480,"_8094":4059,"_15":8478,"_8095":4059,"_19":8481,"_8097":7663},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4623":8484,"_8094":4059,"_15":8482,"_8095":4059,"_19":8485,"_8097":7690},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4623":8488,"_8094":8489,"_15":8486,"_8095":4059,"_19":8490,"_8097":7663},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4623":8493,"_8094":4059,"_15":8491,"_8095":8494,"_19":8495,"_8097":7690},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4623":8498,"_8094":4059,"_15":8496,"_8095":4059,"_19":8499,"_8097":7663},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4623":8502,"_8094":8503,"_15":8500,"_8095":8504,"_19":8505,"_8097":7690},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4623":8508,"_8094":4059,"_15":8506,"_8095":4059,"_19":8509,"_8097":7690},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4623":8512,"_8094":4059,"_15":8510,"_8095":4059,"_19":8513,"_8097":7690},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4623":8516,"_8094":8517,"_15":8514,"_8095":4059,"_19":8518,"_8097":7663},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4623":8521,"_8094":4059,"_15":8519,"_8095":4059,"_19":8522,"_8097":7690},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4623":8525,"_8094":4059,"_15":8523,"_8095":4059,"_19":8526,"_8097":7690},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4623":8529,"_8094":4059,"_15":8527,"_8095":4059,"_19":8530,"_8097":7690},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4623":8533,"_8094":8534,"_15":8531,"_8095":8535,"_19":8536,"_8097":7690},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4623":8539,"_8094":8540,"_15":8537,"_8095":4059,"_19":8541,"_8097":7663},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4623":8544,"_8094":8545,"_15":8542,"_8095":4059,"_19":8546,"_8097":7663},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4623":8549,"_8094":8550,"_15":8547,"_8095":4059,"_19":8551,"_8097":7663},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4623":8554,"_8094":8555,"_15":8552,"_8095":4059,"_19":8556,"_8097":7663},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4623":8559,"_8094":8560,"_15":8557,"_8095":4059,"_19":8561,"_8097":7663},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4623":8564,"_8094":8565,"_15":8562,"_8095":4059,"_19":8566,"_8097":7663},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4623":8569,"_8094":8570,"_15":8567,"_8095":4059,"_19":8571,"_8097":7663},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4623":8574,"_8094":8575,"_15":8572,"_8095":4059,"_19":8576,"_8097":7663},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4623":8579,"_8094":8580,"_15":8577,"_8095":4059,"_19":8581,"_8097":7663},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4623":8584,"_8094":8585,"_15":8582,"_8095":4059,"_19":8586,"_8097":7663},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4623":8589,"_8094":8590,"_15":8587,"_8095":4059,"_19":8591,"_8097":7663},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4623":8594,"_8094":8595,"_15":8592,"_8095":4059,"_19":8596,"_8097":7663},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4623":8599,"_8094":8600,"_15":8597,"_8095":4059,"_19":8601,"_8097":7663},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4623":8604,"_8094":8605,"_15":8602,"_8095":4059,"_19":8606,"_8097":7663},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7298":8609,"_6853":8618,"_6819":8620,"_6951":8622,"_6953":8624,"_5409":8626,"_6848":8628,"_6623":8