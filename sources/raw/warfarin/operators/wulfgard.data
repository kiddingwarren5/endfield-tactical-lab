"_8135":8136,"_8139":8140,"_8144":8145,"_8149":8150,"_7592":8154,"_8158":8159,"_8161":8162,"_7612":8166,"_8170":8171,"_8175":8176,"_8180":8181,"_8185":8186,"_8189":8190,"_8194":8195,"_7412":8200,"_7451":8204,"_8209":8210,"_8214":8215,"_8219":8220,"_7638":8224,"_8229":8230,"_8232":8233,"_8236":8237,"_8240":8241,"_8245":8246,"_8250":8251,"_8254":8255,"_8259":8260,"_7678":8264,"_8268":8269,"_8273":8274,"_8278":8279,"_8283":8284,"_8287":8288,"_8291":8292,"_8296":8297,"_8301":8302,"_8305":8306,"_8311":8312,"_8315":8316,"_8319":8320,"_8324":8325,"_8328":8329,"_8332":8333,"_8336":8337,"_8342":8343,"_8347":8348,"_8352":8353,"_8357":8358,"_8362":8363,"_8367":8368,"_8372":8373,"_8377":8378,"_8382":8383,"_8387":8388,"_8392":8393,"_8397":8398,"_8402":8403,"_8407":8408},"adv.electricFence",{"_4611":7898,"_7899":4057,"_15":7896,"_7900":4057,"_19":7901,"_7902":7468},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4611":7905,"_7899":7906,"_15":7903,"_7900":4057,"_19":7907,"_7902":7521},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4611":7909,"_7899":7910,"_15":7585,"_7900":7911,"_19":7912,"_7902":7650},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4611":7915,"_7899":4057,"_15":7913,"_7900":4057,"_19":7916,"_7902":7468},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4611":7919,"_7899":7920,"_15":7917,"_7900":4057,"_19":7921,"_7902":7468},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4611":7924,"_7899":4057,"_15":7922,"_7900":4057,"_19":7925,"_7902":7468},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4611":7928,"_7899":7929,"_15":7926,"_7900":4057,"_19":7930,"_7902":7562},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4611":7933,"_7899":4057,"_15":7931,"_7900":4057,"_19":7934,"_7902":7468},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4611":7937,"_7899":7938,"_15":7935,"_7900":4057,"_19":7939,"_7902":7468},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4611":7942,"_7899":4057,"_15":7940,"_7900":4057,"_19":7943,"_7902":4057},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4611":7946,"_7899":7947,"_15":7944,"_7900":4057,"_19":7948,"_7902":7521},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4611":7950,"_7899":7951,"_15":7400,"_7900":7952,"_19":7953,"_7902":7650},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4611":7956,"_7899":4057,"_15":7954,"_7900":4057,"_19":7957,"_7902":7468},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4611":7960,"_7899":7961,"_15":7958,"_7900":4057,"_19":7962,"_7902":7468},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4611":7965,"_7899":7966,"_15":7963,"_7900":4057,"_19":7967,"_7902":7468},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4611":7970,"_7899":4057,"_15":7968,"_7900":4057,"_19":7971,"_7902":7495},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4611":7974,"_7899":7975,"_15":7972,"_7900":4057,"_19":7976,"_7902":7468},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4611":7979,"_7899":4057,"_15":7977,"_7900":4057,"_19":7980,"_7902":7495},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4611":7982,"_7899":7983,"_15":7483,"_7900":7984,"_19":7985,"_7902":7562},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4611":7988,"_7899":7983,"_15":7986,"_7900":4057,"_19":7989,"_7902":7562},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4611":7992,"_7899":7993,"_15":7990,"_7900":7994,"_19":7995,"_7902":7495},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4611":7998,"_7899":4057,"_15":7996,"_7900":4057,"_19":7999,"_7902":7495},"持续时间内，受影响的目标暂停行动。","定身",{"_4611":8001,"_7899":8002,"_15":7489,"_7900":8003,"_19":8004,"_7902":7674},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4611":8007,"_7899":8002,"_15":8005,"_7900":4057,"_19":8008,"_7902":7674},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4611":8011,"_7899":4057,"_15":8009,"_7900":8012,"_19":8013,"_7902":4057},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4611":8015,"_7899":8016,"_15":7507,"_7900":8017,"_19":8018,"_7902":7624},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4611":8021,"_7899":8016,"_15":8019,"_7900":4057,"_19":8022,"_7902":7624},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4611":8025,"_7899":8026,"_15":8023,"_7900":4057,"_19":8027,"_7902":7468},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4611":8029,"_7899":8030,"_15":7514,"_7900":8031,"_19":8032,"_7902":7650},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4611":8035,"_7899":8036,"_15":8033,"_7900":8037,"_19":8038,"_7902":7495},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4611":8041,"_7899":8042,"_15":8039,"_7900":4057,"_19":8043,"_7902":7495},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4611":8045,"_7899":8046,"_15":7538,"_7900":8047,"_19":8048,"_7902":7521},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4611":8051,"_7899":4057,"_15":8049,"_7900":8052,"_19":8053,"_7902":7521},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4611":8056,"_7899":8057,"_15":8054,"_7900":4057,"_19":8058,"_7902":7468},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4611":8061,"_7899":8062,"_15":8059,"_7900":4057,"_19":8063,"_7902":7468},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4611":8066,"_7899":8067,"_15":8064,"_7900":4057,"_19":8068,"_7902":7521},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4611":8070,"_7899":7906,"_15":7545,"_7900":8071,"_19":8072,"_7902":7521},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4611":8075,"_7899":4057,"_15":8073,"_7900":8076,"_19":8077,"_7902":7495},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4611":8080,"_7899":8081,"_15":8078,"_7900":4057,"_19":8082,"_7902":7468},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4611":8085,"_7899":4057,"_15":8083,"_7900":4057,"_19":8086,"_7902":4057},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4611":8089,"_7899":8090,"_15":8087,"_7900":8091,"_19":8092,"_7902":7495},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4611":8095,"_7899":8096,"_15":8093,"_7900":4057,"_19":8097,"_7902":7468},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4611":8100,"_7899":4057,"_15":8098,"_7900":8101,"_19":8102,"_7902":7562},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4611":8104,"_7899":8105,"_15":7575,"_7900":8106,"_19":8107,"_7902":7562},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4611":8110,"_7899":8111,"_15":8108,"_7900":4057,"_19":8112,"_7902":7468},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4611":7988,"_7899":8105,"_15":8113,"_7900":4057,"_19":8115,"_7902":7562},"干员受到灼热附着","sys.tacticalItem",{"_4611":8118,"_7899":4057,"_15":8116,"_7900":4057,"_19":8119,"_7902":7468},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4611":8122,"_7899":8123,"_15":8120,"_7900":4057,"_19":8124,"_7902":7562},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4611":8007,"_7899":8127,"_15":8125,"_7900":4057,"_19":8128,"_7902":7674},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4611":8131,"_7899":8132,"_15":8129,"_7900":8133,"_19":8134,"_7902":7495},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4611":8137,"_7899":4057,"_15":8135,"_7900":4057,"_19":8138,"_7902":7495},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4611":8141,"_7899":8142,"_15":8139,"_7900":4057,"_19":8143,"_7902":7650},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4611":8146,"_7899":8147,"_15":8144,"_7900":4057,"_19":8148,"_7902":7674},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4611":8151,"_7899":8152,"_15":8149,"_7900":4057,"_19":8153,"_7902":7495},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4611":8155,"_7899":8156,"_15":7592,"_7900":8047,"_19":8157,"_7902":7521},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4611":7905,"_7899":8156,"_15":8158,"_7900":4057,"_19":8160,"_7902":7521},"干员受到冻结","ba.naturalvul",{"_4611":8163,"_7899":8164,"_15":8161,"_7900":4057,"_19":8165,"_7902":7624},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4611":7950,"_7899":8167,"_15":7612,"_7900":8168,"_19":8169,"_7902":7650},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4611":8172,"_7899":8173,"_15":8170,"_7900":4057,"_19":8174,"_7902":7468},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4611":8177,"_7899":8178,"_15":8175,"_7900":4057,"_19":8179,"_7902":7468},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4611":8182,"_7899":8183,"_15":8180,"_7900":4057,"_19":8184,"_7902":7468},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4611":8187,"_7899":4057,"_15":8185,"_7900":4057,"_19":8188,"_7902":7468},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4611":8191,"_7899":4057,"_15":8189,"_7900":8192,"_19":8193,"_7902":4057},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4611":8196,"_7899":8197,"_15":8194,"_7900":8198,"_19":8199,"_7902":7495},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4611":8201,"_7899":4057,"_15":7412,"_7900":8202,"_19":8203,"_7902":7624},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4611":8205,"_7899":8206,"_15":7451,"_7900":8207,"_19":8208,"_7902":7650},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4611":8211,"_7899":8212,"_15":8209,"_7900":4057,"_19":8213,"_7902":7468},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4611":8216,"_7899":8217,"_15":8214,"_7900":4057,"_19":8218,"_7902":7624},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4611":8221,"_7899":8222,"_15":8219,"_7900":4057,"_19":8223,"_7902":7468},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4611":8225,"_7899":8226,"_15":7638,"_7900":8227,"_19":8228,"_7902":7624},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4611":8021,"_7899":8226,"_15":8229,"_7900":4057,"_19":8231,"_7902":7624},"干员受到自然附着","ba.originium",{"_4611":8234,"_7899":4057,"_15":8232,"_7900":4057,"_19":8235,"_7902":7495},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4611":8238,"_7899":4057,"_15":8236,"_7900":4057,"_19":8239,"_7902":7650},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4611":8242,"_7899":8243,"_15":8240,"_7900":4057,"_19":8244,"_7902":7650},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4611":8247,"_7899":4057,"_15":8245,"_7900":8248,"_19":8249,"_7902":7658},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4611":8252,"_7899":4057,"_15":8250,"_7900":4057,"_19":8253,"_7902":7468},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4611":8256,"_7899":4057,"_15":8254,"_7900":8257,"_19":8258,"_7902":7674},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4611":8261,"_7899":8262,"_15":8259,"_7900":4057,"_19":8263,"_7902":7468},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4611":8265,"_7899":8127,"_15":7678,"_7900":8266,"_19":8267,"_7902":7674},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4611":8270,"_7899":8271,"_15":8268,"_7900":4057,"_19":8272,"_7902":7674},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4611":8275,"_7899":4057,"_15":8273,"_7900":8276,"_19":8277,"_7902":7495},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4611":8280,"_7899":4057,"_15":8278,"_7900":8281,"_19":8282,"_7902":4057},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4611":8285,"_7899":4057,"_15":8283,"_7900":4057,"_19":8286,"_7902":7468},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4611":8289,"_7899":4057,"_15":8287,"_7900":4057,"_19":8290,"_7902":7495},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4611":8293,"_7899":8294,"_15":8291,"_7900":4057,"_19":8295,"_7902":7468},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4611":8298,"_7899":4057,"_15":8296,"_7900":8299,"_19":8300,"_7902":7495},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4611":8303,"_7899":4057,"_15":8301,"_7900":4057,"_19":8304,"_7902":7468},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4611":8307,"_7899":8308,"_15":8305,"_7900":8309,"_19":8310,"_7902":7495},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4611":8313,"_7899":4057,"_15":8311,"_7900":4057,"_19":8314,"_7902":7495},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4611":8317,"_7899":4057,"_15":8315,"_7900":4057,"_19":8318,"_7902":7495},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4611":8321,"_7899":8322,"_15":8319,"_7900":4057,"_19":8323,"_7902":7468},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4611":8326,"_7899":4057,"_15":8324,"_7900":4057,"_19":8327,"_7902":7495},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4611":8330,"_7899":4057,"_15":8328,"_7900":4057,"_19":8331,"_7902":7495},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4611":8334,"_7899":4057,"_15":8332,"_7900":4057,"_19":8335,"_7902":7495},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4611":8338,"_7899":8339,"_15":8336,"_7900":8340,"_19":8341,"_7902":7495},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4611":8344,"_7899":8345,"_15":8342,"_7900":4057,"_19":8346,"_7902":7468},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4611":8349,"_7899":8350,"_15":8347,"_7900":4057,"_19":8351,"_7902":7468},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4611":8354,"_7899":8355,"_15":8352,"_7900":4057,"_19":8356,"_7902":7468},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4611":8359,"_7899":8360,"_15":8357,"_7900":4057,"_19":8361,"_7902":7468},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4611":8364,"_7899":8365,"_15":8362,"_7900":4057,"_19":8366,"_7902":7468},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4611":8369,"_7899":8370,"_15":8367,"_7900":4057,"_19":8371,"_7902":7468},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4611":8374,"_7899":8375,"_15":8372,"_7900":4057,"_19":8376,"_7902":7468},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4611":8379,"_7899":8380,"_15":8377,"_7900":4057,"_19":8381,"_7902":7468},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4611":8384,"_7899":8385,"_15":8382,"_7900":4057,"_19":8386,"_7902":7468},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4611":8389,"_7899":8390,"_15":8387,"_7900":4057,"_19":8391,"_7902":7468},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4611":8394,"_7899":8395,"_15":8392,"_7900":4057,"_19":8396,"_7902":7468},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4611":8399,"_7899":8400,"_15":8397,"_7900":4057,"_19":8401,"_7902":7468},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4611":8404,"_7899":8405,"_15":8402,"_7900":4057,"_19":8406,"_7902":7468},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4611":8409,"_7899":8410,"_15":8407,"_7900":4057,"_19":8411,"_7902":7468},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7104":8414,"_6619":8423,"_6750":8425,"_6651":8427,"_6753":8429,"_6052":8431,"_6756":8433,"_6758":8435,"_6761":8437,"_6764":8438,"_5814":8440,"_6769":8442,"_6772":8443,"_6775":8444,"_6777":8446,"_6463":8447,"_6782":8448,"_6785":8449,"_6789":8451,"_6793":8452,"_6796":8453,"_6800":8454,"_6803":8455,"_6807":8456,"_6811":8457,"_6814":8458,"_6818":8459,"_6822":8461,"_6826":8462,"_6830":8464,"_6834":8466,"_6838":8468,"_6842":8469,"_6846":8471,"_6850":8473,"_6854":8474,"_6858":8476,"_6862":8478,"_6866":8480,"_6870":8482,"_6874":8485,"_6878":8488,"_6882":8491,"_6886":8494,"_6890":8495,"_6894":8497,"_6898":8498,"_6902":8499,"_6906":8501,"_6910":8503,"_6914":8504,"_6918":8506,"_6922":8508,"_6926":8510,"_6930":8512,"_6934":8514,"_6938":8516,"_6942":8518,"_6945":8520,"_6949":8522,"_6953":8524,"_6957":8525,"_6961":8527,"_6965":8528,"_6969":8529,"_6973":8530,"_6977":8531,"_6981":8532,"_6985":8533,"_6989":8534,"_6993":8535,"_6997":8536,"_7001":8537,"_7005":8538,"_7009":8539,"_7013":8540,"_7017":8541,"_7021":8542,"_7025":8543,"_7029":8544,"_7033":8545,"_7037":8546,"_7040":8547,"_7044":8548,"_7048":8549,"_7052":8550,"_7056":8551,"_7060":8552,"_7064":8554,"_7068":8555,"_7072":8556,"_8557":8558,"_8559":8560,"_8561":8562,"_8563":8564,"_8565":8566,"_8567":8568,"_8569":8570,"_8571":8572,"_8573":8574,"_8575":8576,"_8577":8578,"_8579":8580,"_8582":8583,"_8585":8586,"_8587":8588,"_8590":8591,"_8593":8594},{"_8415":37,"_8416":4057,"_8417":39,"_8418":5075,"_8419":5075,"_8420":4057,"_8421":37,"_8422":37},"attributeType","bigIconName","defaultValue","hasMaxValue","hasMinValue","iconName","maxValue","minValue",{"_8415":39,"_8416":4057,"_8417":39,"_8418":5075,"_8419":4075,"_8420":8424,"_8421":37,"_8422":37},"icon_attribute_maxHp",{"_8415":55,"_8416":4057,"_8417":94,"_8418":5075,"_8419":5075,"_8420":8426,"_8421":37,"_8422":37},"icon_attribute_atk",{"_8415":58,"_8