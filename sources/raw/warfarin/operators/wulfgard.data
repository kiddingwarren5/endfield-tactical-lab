12,{"_36":58,"_38":37},{"_36":60,"_38":3908},1.48469387755102,{"_36":62,"_38":3910},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3930,"_102":64},{"_33":3931},[3932,3934,3936,3938,3940,3942,3944,3946,3947,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967],{"_36":37,"_38":3933},97,{"_36":41,"_38":3935},172.97875026299232,{"_36":44,"_38":3937},102.17525773195901,{"_36":47,"_38":3939},99.44329896907216,{"_36":50,"_38":3941},119.16600042078686,{"_36":39,"_38":3943},5888,{"_36":55,"_38":3945},315,{"_36":58,"_38":37},{"_36":60,"_38":3948},1.48979591836735,{"_36":62,"_38":2012},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3969,"_102":64},{"_33":3970},[3971,3972,3974,3976,3978,3980,3982,3984,3985,3987,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006],{"_36":37,"_38":1001},{"_36":41,"_38":3973},174.58731327582632,{"_36":44,"_38":3975},103.1391752577322,{"_36":47,"_38":3977},100.38144329896907,{"_36":50,"_38":3979},120.26341258152745,{"_36":39,"_38":3981},5944,{"_36":55,"_38":3983},318,{"_36":58,"_38":37},{"_36":60,"_38":3986},1.49489795918367,{"_36":62,"_38":3988},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4008,"_102":64},{"_33":4009},[4010,4012,4014,4016,4018,4020,4022,4024,4025,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045],{"_36":37,"_38":4011},99,{"_36":41,"_38":4013},176.19587628866032,{"_36":44,"_38":4015},104.1030927835054,{"_36":47,"_38":4017},101.31958762886597,{"_36":50,"_38":4019},121.36082474226802,{"_36":39,"_38":4021},6000,{"_36":55,"_38":4023},321,{"_36":58,"_38":37},{"_36":60,"_38":4026},1.5,{"_36":62,"_38":2050},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4048,4049],"tag_04","tag_13","charId","charIllustInitPos",{"_4053":1067,"_4054":4055},"x","y",-385,"charPassiveUIPrefabName","","charTypeId","Fire","cvName",{"_4062":4063,"_4064":4065,"_4066":4067,"_4068":4069,"_4050":16},"ChiCVName","梁达伟","EngCVName","Jacopo Calatroni","JapCVName","前野智昭","KorCVName","任赫","defaultWeaponId","wpn_pistol_0001","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Wulfgard","mainAttrType","phoneticName","profession","profileRecord",[4083,4094,4099,4104,4109,4114],{"_4050":16,"_15":4084,"_4085":4086,"_4087":4088,"_4089":39,"_4090":4091,"_4092":37,"_4093":37},"chr_0006_wolfgd_1","recordDesc","【代号】狼卫\n【性别】男\n【身份认证】狼群氏族\n【生日】11月16日\n【种族】鲁珀\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：优良\n战术规划：标准\n源石技艺适应性：标准\n\n裂地者的生活方式在狼卫的身上留下了许多痕迹。疤痕象征着过往，这些积攒的痛楚现在并没有影响到狼卫，但不代表未来也会一直如此。他应该学会以更爱惜自己生命的方式参与任务，或者至少，多信任战友一些，不要总是试图单打独斗。","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4050":16,"_15":4095,"_4085":4096,"_4087":4097,"_4089":55,"_4090":4098,"_4092":37,"_4093":37},"chr_0006_wolfgd_2","干员狼卫，全名卡特洛·狼卫·卢皮诺，裂地者狼群氏族成员。作为狼群代表与终末地工业达成合作。之后经佩丽卡监督推荐，加入特种技术部门，以危机处理小组成员的身份接受派遣。\n\n狼卫拥有极强的观察能力与应变能力。据我所知，他能自如应对绝大多数目前已知的高危环境。\n他显然习惯单独行动，同时擅长隐秘工作。但在与他人的交际中，狼卫似乎并不乐于处理一些人际关系问题，因此在进行需要团队协作的任务时，建议尽量让该干员独自行动。\n值得注意的是，根据已有的测试反馈，狼卫在体能与反应速度上都表现得十分优秀，他精通铳械，熟练掌握各项肉搏技巧，也擅长将任一物件用于战斗——哪怕是一支钢笔。\n或许是得益于丰富的荒地生活经验，狼卫不仅对野外环境中的各种危险情况了如指掌，还很清楚如何与开拓区居民打交道，尤其是在与裂地者有关的事宜上……相信每个和他搭档过的干员应该都对此印象深刻。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4050":16,"_15":4100,"_4085":4101,"_4087":4102,"_4089":58,"_4090":4103,"_4092":37,"_4093":37},"chr_0006_wolfgd_3","在狼卫刚加入终末地的时候，一些干员一度因为裂地者的身份而对他心存成见，甚至认为他另有所图。但几年过去，他们发现这位来自“狼群氏族”的青年尽管多数时候一脸冷漠，言辞也总显得颇具攻击性，但却意外地不难相处。\n他总是无比准时、高效、尽责，经常什么都不说就完成了所有善后工作——几乎具备了一切常人能想象的“好队友”特征。可惜的是，他本人似乎并不喜欢和人组队，每次被迫提交的报告里总少不了“希望执行单人任务”这条。\n不过与此相对的，狼卫对于自己在武器改装上的“小小心得”却从不吝于分享，这一度让终末地的武库工程师们颇为头疼。很多干员第一次见到狼卫本人，就是在武库工程师固定会举办的新型武器测试活动上，通常都能目睹他是如何面不改色地在武库工程师面前改装完了新武器，然后指着它说“我认为这样更好用”，致使武库工程师差点当场被气晕的全过程。\n哪怕这让狼卫一度上了武库的黑名单，他也毫不在意，一如既往地对拿到手的新武器进行改装，直到他觉得好用为止。\n\n“成熟的猎手，理应挑选自己最趁手的猎具。——如果够不上最趁手，那就改装到最趁手。”","CN_03","档案资料·一",{"_4050":16,"_15":4105,"_4085":4106,"_4087":4107,"_4089":64,"_4090":4108,"_4092":64,"_4093":3748},"chr_0006_wolfgd_4","在裂地者普遍被视作“秩序破坏者”的当下，重视秩序、对文明环带持温和态度的狼群氏族可谓是异类中的异类。直到现在，他们依然固守着某些古老的传统，譬如家族文化与崇尚团结。\n而这份特殊性，也让本就与他们对立的碾骨氏族更加仇视这些行走在荒地上的孤高猎手，甚至在十几年前发动过一次截杀行动，重创了当时刚失去头狼，正处于薄弱时期的狼群。\n作为那场劫难的亲历者，狼卫虽然得以与妹妹一同幸存，却对当时发生的种种讳莫如深。\n他在完成成年礼的几年后便离开了狼群，只与妹妹和极少数的友人保持了联系。\n没人清楚他离群的原因，他也像对当年的事缄口不言那样，不曾说过自己的目的。\n再后来，他以寻求合作为由找上了终末地，并以干员的身份加入了特种技术部门。\n曾有人问过狼卫，为什么会选择终末地作为合作对象？\n他先是沉默，接着十分坦诚地给出了答案：\n“我希望为狼群寻找到另一个未来……而‘终末地’拥有让这件事成真的可能。”\n狼卫对狼群如今面临的困境表现得相当坦然，他的诚恳与务实最终让这项合作得以推进。\n与此相应的，他成为干员似乎也成了一件顺理成章的事，因为他的理由是——他有义务向合作方展示狼群的优秀之处，也有义务回报终末地的信任。\n于是，在不少或困难或艰险的任务里，都能看到狼卫隐秘却活跃的身影。\n不少曾对裂地者心存成见的干员，也因为狼卫的存在，改变了自己的看法。\n虽说这些看法在狼卫的妹妹——洛茜干员加入后又有了别样的变化，但那就是后话了。","CN_04","档案资料·二",{"_4050":16,"_15":4110,"_4085":4111,"_4087":4112,"_4089":66,"_4090":4113,"_4092":64,"_4093":3748},"chr_0006_wolfgd_5","“这次要留多久？不打算回家看看？”\n“……一天。嗯，没必要。”\n“这么快？那算了……唉，不过前两天小洛茜又来跟我念叨你，说是怀疑这次她过生日，你又要‘礼物到了人没到’……下次你就算不回家，好歹也找机会跟她见一面嘛。\n“你想啊，自从你们兄妹上回在托马索家里聚了一次，都已经过了大半年了。”\n“还有些事要尽快处理……等事情结束了——”\n“打住！你上次也这么说，结果呢？结果你隔了几天又跑开拓区去了，说什么要帮人善后……\n“唉，搞不懂你们这些年轻人，怎么整天都有做不完的事……\n“反正我要是你，就算事情再多，肯定也要多回来几趟照料妹妹的！她才那么小，氏族里和她差不多年纪的，哪个不是被家人们宠着长大的……”\n“你们也是她的家人。”\n“那当然！不对，差点被你小子带跑了……我知道你总有自己的想法，但作为过来人，我看到小洛茜总会想起我那个可怜的女儿……没能在那时多花些时间陪着她，是我最大的遗憾……\n“听点劝吧，卡特洛……少做点会让自己后悔的事。”\n“我明白你的意思，鲁斯特叔叔。\n“但洛茜……她知道我今天回来。”\n“什么？不可能！\n“她要是知道，怎么会一大早就和路易家那对双胞胎跑去猎场了？总不会是……”\n“嗯，就和你猜的一样。”\n“……你们兄妹啊，果然是同一窝的鲁珀，骨子里根本一模一样嘛！\n“算了，我也懒得管了！就算这样，你总不在她身边，不怕哪天出什么纰漏吗？\n“本来想替小洛茜保密的……现在看来，还是得给你说说——六个月前，洛茜她为了给老巴特他们出头，不小心惹来了影颅的杀手……当时我记得清清楚楚，整整十四个人，一个比一个难缠，要不是托马索提前找来了卡邦的‘獠牙’们帮忙，我们几个那天指不定连地下黑市的门都走不出去……”\n“……”\n“怎么样？现在知道后怕了吧？”\n“不，我只是在想，洛茜知道我去北方的事……是不是也是鲁斯特叔叔你说的。”\n“呃……这个……呵呵……那是……我一不小心给说漏嘴了……真的……\n“咳，对了！你的双铳我都检查好了！没什么大问题！保养得不错！就是少用点你那些个改装弹药……再好的铳口也禁不住你那么耗的……”\n“嗯，我会注意的。\n“以及……当时是十五个人。”\n“啊？”\n“那么，下回见。”\n——“恶狼扳机”店内监控的录音记录","CN_05","档案资料·三",{"_4050":16,"_15":4115,"_4085":4116,"_4087":4117,"_4089":68,"_4090":4118,"_4092":64,"_4093":4119},"chr_0006_wolfgd_6","他很清楚，既然打算长期离开狼群，就意味着这是一次无法确定归期的远行。按照自己以往的习惯，最好把能派上用场的东西全带上。\n但是，当狼卫站在“猎手号”前，环视了一遍这辆自己与妹妹生活了快十年的大车，又觉得似乎也没什么该拿的了……\n他忍不住又在脑海里过了遍那些原定的安排：再和洛茜交代一遍氏族里真正能信任的人，还有唯二能联系上自己的方式；跟托马索打个招呼，让他多看着洛茜一点；去鲁斯特叔叔的店里还掉仅剩的那笔定制费；替乔万尼再喂一次那几只完全散养的羽兽，并将它们托付给隔壁的小文森特……他确信自己并没有遗漏其中的任何一件事。\n想到这里，他放心了一些，打算最后再去看一眼床头，以防自己又忘了关洛茜送的那盏源石灯。\n只是才走进自己睡的那节车厢，他的目光就落在了柜子里一个不起眼的角落，那里放着外漆已经掉得差不多的双铳——是他拿到的第一件武器。\n尽管它们是二手货，口径适配的弹药也十分稀少，但对那时的他来说，却已经是足以让自己与妹妹活下去的珍宝。他用它得到了第一份雇佣兵工作，也靠它击杀了第一个任务目标，甚至因为其中一支铳的源石激发单元过度老化，他被迫领悟了单手换弹的技巧，还因此学会了拆卸铳械的手法。而在靠佣金养活一家人的第三年，他终于成功换掉了老旧的源石激发单元，并专门为双铳做了一组蚀刻弹药。\n但就像从他人那里继承来的梦想总是难以延续，这对从氏族老一辈那里获赠的铳械，后来还是在一次危急的护卫任务中，因长时间铳口过热而报废了。\n不久后，在环带当赏金猎人的鲁斯特叔叔回归了狼群氏族，在他家对面开了间翻新、改造旧铳械的铺子，名字叫“恶狼扳机”。从鲁斯特那里，他第一次知道了什么是“定制武器”，也终于学到了一些改装武器的窍门。\n那之后，他用的武器总能被他改造得最适合自己，当然……也可能只适合他。\n即便如此，这对最初的铳械还是没被他处理掉，而是放在了一个如果不是即将远行，自己平时也不会多看一眼的位置。\n——为了什么呢？铭记？提醒？还是纯粹地想要为那段充斥着苦痛的回忆留点纪念品？\n狼卫想了想，发现自己似乎还答不上来，好像都是，又好像都不是。\n在确认了源石灯的关闭状态后，他走向车门——正式踏上这段说不定能给他一个确切答案的旅程。","CN_06","档案资料·四",1500,"profileVoice",[4122,4130,4134,4138,4142,4146,4150,4155,4160,4165,4170,4175,4180,4185,4190,4195,4200,4205,4210,4215,4220,4225,4230,4235,4240,4245,4250,4255,4260,4265,4270,4275,4280,4285,4290,4295,4300,4305,4310,4315,4320,4325,4330,4335,4340,4345,4350,4355,4360,4365,4370,4375,4380,4385,4390,4395,4400,4405,4410,4415,4420,4425,4430,4435,4440,4445,4450,4455,4460,4465,4470,4475,4480,4485,4490,4495,4500,4505,4510],{"_4050":16,"_15":4084,"_4092":37,"_4093":37,"_4123":4124,"_4125":4126,"_4127":39,"_4128":4129},"voId","chr_0006_wolfgd_chrbark_squad_01","voiceDesc","你来指挥。","voiceIndex","voiceTitle","行动准备1",{"_4050":16,"_15":4095,"_4092":37,"_4093":37,"_4123":4131,"_4125":4132,"_4127":55,"_4128":4133},"chr_0006_wolfgd_chrbark_squad_02","现在出发？","行动准备2",{"_4050":16,"_15":4100,"_4092":37,"_4093":37,"_4123":4135,"_4125":4136,"_4127":58,"_4128":4137},"chr_0006_wolfgd_chrbark_join_01","要我配合吗？可以，只要他们跟得上。","编入队伍1",{"_4050":16,"_15":4105,"_4092":37,"_4093":37,"_4123":4139,"_4125":4140,"_4127":64,"_4128":4141},"chr_0006_wolfgd_chrbark_join_02","团队作战？明白了，我会做好该做的。","编入队伍2",{"_4050":16,"_15":4110,"_4092":37,"_4093":37,"_4123":4143,"_4125":4144,"_4127":66,"_4128":4145},"chr_0006_wolfgd_chrbark_weap_01","很趁手的武器，多谢。","更换武器",{"_4050":16,"_15":4115,"_4092":37,"_4093":37,"_4123":4147,"_4125":4148,"_4127":68,"_4128":4149},"chr_0006_wolfgd_chrbark_gear_01","武装到牙齿……聪明的决断。","更换装备",{"_4050":16,"_15":4151,"_4092":37,"_4093":37,"_4123":4152,"_4125":4153,"_4127":70,"_4128":4154},"chr_0006_wolfgd_7","chr_0006_wolfgd_chrup_skill_01","越娴熟的技巧，越该用在关键时刻。","激活天赋阵列",{"_4050":16,"_15":4156,"_4092":37,"_4093":37,"_4123":4157,"_4125":4158,"_4127":88,"_4128":4159},"chr_0006_wolfgd_8","chr_0006_wolfgd_chrup_level_01","面对敌人，狼群只会选最高效的围猎手段。","观看作战记录",{"_4050":16,"_15":4161,"_4092":55,"_4093":39,"_4123":4162,"_4125":4163,"_4127":90,"_4128":4164},"chr_0006_wolfgd_9","chr_0006_wolfgd_chrup_promt01_01","谢谢你的认可，管理员，那我能不写这次的报告吗？不能？……好吧。","精英化晋升1",{"_4050":16,"_15":4166,"_4092":55,"_4093":55,"_4123":4167,"_4125":4168,"_4127":94,"_4128":4169},"chr_0006_wolfgd_10","chr_0006_wolfgd_chrup_promt02_01","如你所见，管理员，你让我去做我擅长的工作，我就不会给出让你失望的结果。","精英化晋升2",{"_4050":16,"_15":4171,"_4092":55,"_4093":58,"_4123":4172,"_4125":4173,"_4127":101,"_4128":4174},"chr_0006_wolfgd_11","chr_0006_wolfgd_chrup_promt03_01","狼群的地位建立在鲜血之上，只需狩猎到足够的猎物即可。我是否能认为你认可了我的狩猎，管理员？","精英化晋升3",{"_4050":16,"_15":4176,"_4092":55,"_4093":64,"_4123":4177,"_4125":4178,"_4127":96,"_4128":4179},"chr_0006_wolfgd_12","chr_0006_wolfgd_chrup_promt04_01","我见过狼群遭受重创时的惨烈，所以才下定了决心，要为洛茜、为狼群的其他人寻找新的出路。管理员，很庆幸能与你同行。","精英化晋升4",{"_4050":16,"_15":4181,"_4092":37,"_4093":37,"_4123":4182,"_4125":4183,"_4127":525,"_4128":4184},"chr_0006_wolfgd_13","chr_0006_wolfgd_introduce_01","卡特洛·狼卫·卢皮诺，终末地危机处理小组成员。目前代表狼群氏族与你们合作，任何雇佣兵能干的活儿我都能做。合同期内，我将成为你的獠牙。","干员报到",{"_4050":16,"_15":4186,"_4092":37,"_4093":37,"_4123":4187,"_4125":4188,"_4127":564,"_4128":4189},"chr_0006_wolfgd_14","chr_0006_wolfgd_mono_switch_01","有新任务？","待命1",{"_4050":16,"_15":4191,"_4092":37,"_4093":37,"_4123":4192,"_4125":4193,"_4127":98,"_4128":4194},"chr_0006_wolfgd_15","chr_0006_wolfgd_mono_switch_02","我在。","待命2",{"_4050":16,"_15":4196,"_4092":37,"_4093":37,"_4123":4197,"_4125":4198,"_4127":642,"_4128":4199},"chr_0006_wolfgd_16","chr_0006_wolfgd_sim_assign_work_01","这里也缺人手？","进驻设施",{"_4050":16,"_15":4201,"_4092":37,"_4093":37,"_4123":4202,"_4125":4203,"_4127":682,"_4128":4204},"chr_0006_wolfgd_17","chr_0006_wolfgd_sim_hello_lower_01","管理员。","打招呼1",{"_4050":16,"_15":4206,"_4092":64,"_4093":3748,"_4123":4207,"_4125":4208,"_4127":721,"_4128":4209},"chr_0006_wolfgd_18","chr_0006_wolfgd_sim_hello_max_01","管理员，要我同行吗？我抽得出空。","打招呼2",{"_4050":16,"_15":4211,"_4092":37,"_4093":37,"_4123":4212,"_4125":4213,"_4127":761,"_4128":4214},"chr_0006_wolfgd_19","chr_0006_wolfgd_sim_talk_lv01_01","和其他干员合作并不算简单。狼群的手段很难让普通人立刻接受，更别提我本就习惯独来独往。但如果是管理员您的要求……我会尝试做出一些改变。","帝江号闲聊1",{"_4050":16,"_15":4216,"_4092":64,"_4093":3748,"_4123":4217,"_4125":4218,"_4127":800,"_4128":4219},"chr_0006_wolfgd_20","chr_0006_wolfgd_sim_talk_lv02_01","相比帝江号，我还是更习惯在开拓区待着。这里太安逸了，容易让人丧失该有的警惕。但洛茜很喜欢这里，能够满足她的好奇心。","帝江号闲聊2",{"_4050":16,"_15":4221,"_4092":64,"_4093":3748,"_4123":4222,"_4125":4223,"_4127":871,"_4128":4224},"chr_0006_wolfgd_21","chr_0006_wolfgd_sim_talk_lv02_02","老实说，我并没有研究裂地者其他氏族的兴趣。只是在荒地行走的日子久了，自然会牢记那些能够保命的常识。对于狼群而言，求生意志就是最好的老师，也是唯一的信仰。","帝江号闲聊3",{"_4050":16,"_15":4226,"_4092":64,"_4093":4119,"_4123":4227,"_4125":4228,"_4127":910,"_4128":4229},"chr_0006_wolfgd_22","chr_0006_wolfgd_sim_talk_max_01","终末地的干员来自塔卫二各个地方，其中有一些熟面孔……或者说，一些危险人物。我对你们的选择保持信任，但如有必要，各位应该相信我的直觉。","帝江号闲聊4",{"_4050":16,"_15":4231,"_4092":64,"_4093":4119,"_4123":4232,"_4125":4233,"_4127":950,"_4128":4234},"chr_0006_wolfgd_23","chr_0006_wolfgd_sim_talk_max_02","我在检查铳械，这是我的习惯。拿着弹尽的铳械，和赤裸裸地被丢在荒野中心没有区别。你手无寸铁，沦为猎物，一切技能和技巧都不再作数。那种感觉令人窒息……我在很小的时候体会过，所以，我会杜绝再次感受的可能。","帝江号闲聊5",{"_4050":16,"_15":4236,"_4092":64,"_4093":4119,"_4123":4237,"_4125":4238,"_4127":989,"_4128":4239},"chr_0006_wolfgd_24","chr_0006_wolfgd_sim_talk_max_03","我确实已经有一段时间没回到过氏族的据点，更有很长一段时间没有带领过氏族的行动。我更擅长为他们开辟一片新的猎场，而不是成为每一次狩猎的头狼。","帝江号闲聊6",{"_4050":16,"_15":4241,"_4092":37,"_4093":37,"_4123":4242,"_4125":4243,"_4127":62,"_4128":4244},"chr_0006_wolfgd_25","chr_0006_wolfgd_sim_gift_give_01","有空吗？上次任务我发现了一些有趣的东西……特意带给管理员的。","赠送礼物",{"_4050":16,"_15":4246,"_4092":37,"_4093":37,"_4123":4247,"_4125":4248,"_4127":1067,"_4128":4249},"chr_0006_wolfgd_26","chr_0006_wolfgd_sim_gift_recv_01","给我的？谢谢，我会物尽其用的。","接收礼物",{"_4050":16,"_15":4251,"_4092":37,"_4093":37,"_4123":4252,"_4125":4253,"_4127":1107,"_4128":4254},"chr_0006_wolfgd_27","chr_0006_wolfgd_mono_self_line01","我已经在按终末地的需要改变对待猎物的方式了。如果是以往……猎物们从一开始就会“闭上嘴巴”。","信赖对话1",{"_4050":16,"_15":4256,"_4092":64,"_4093":3748,"_4123":4257,"_4125":4258,"_4127":1146,"_4128":4259},"chr_0006_wolfgd_28","chr_0006_wolfgd_mono_self_line02","我想你应该已经意识到了……成为狼群的领袖从来不是我的目标，洛茜比我更适合那个位置。至于终末地是否能成为“卡特洛·狼卫·卢皮诺”最后的归处？我不知道，“裂地者”与你们想要实现的“理想”相差太远。但是，管理员，至少在为终末地带回成果的时候，我比我想的还要乐在其中。","信赖对话2",{"_4050":16,"_15":4261,"_4092":64,"_4093":3748,"_4123":4262,"_4125":4263,"_4127":1186,"_4128":4264},"chr_0006_wolfgd_29","chr_0006_wolfgd_mono_self_line03","我时常会看着天空？是，我确实喜欢观察天空。你好像很意外？天空是公开的情报板。你可以预测天气，确定时间与方位，甚至能提前预判敌人的行动。天空之下，猎手们身处于一个公平的猎场。你也可以适当吸取一些经验，管理员。","信赖对话3",{"_4050":16,"_15":4266,"_4092":64,"_4093":4119,"_4123":4267,"_4125":4268,"_4127":56,"_4128":4269},"chr_0006_wolfgd_30","chr_0006_wolfgd_mono_self_line04","“裂地者”的身份是我的祖先们一次失败的选择，跟随裂地者军阀叛离文明环带并没得到我们想要的秩序。我无法亲自去问问长辈们是否后悔，但我从出生就在荒野上流血、厮杀……比旁人更清楚活下来的艰辛。佩丽卡监督说，我们能通过与终末地的合作摆脱这个身份……但我已接纳了它的逻辑，我确实是裂地者。你会失望吗，管理员？","信赖对话4",{"_4050":16,"_15":4271,"_4092":64,"_4093":4119,"_4123":4272,"_4125":4273,"_4127":1264,"_4128":4274},"chr_0006_wolfgd_31","chr_0006_wolfgd_mono_self_line05","狼群氏族建立在一个简单的逻辑上：弱小的人们需要共同猎杀强敌，才能在残酷的环境中苟活。无论是氏族的秩序，还是“裂地者”的身份，都来源于此。可是，终末地呢？伟大的信念有时是一柄双刃剑。狩猎可以重新开始，你却不被允许失败。这很残酷，管理员。至少我能加入你的狩猎，分担你的一些压力。","信赖对话5",{"_4050":16,"_15":4276,"_4092":37,"_4093":37,"_4123":4277,"_4125":4278,"_4127":1303,"_4128":4279},"chr_0006_wolfgd_32","chr_0006_wolfgd_mono_chat_line01","我知道力量并不代表一切，但在塔卫二，没有力量通常不是什么好事。","交谈1",{"_4050":16,"_15":4281,"_4092":37,"_4093":37,"_4123":4282,"_4125":4283,"_4127":118,"_4128":4284},"chr_0006_wolfgd_33","chr_0006_wolfgd_mono_chat_line02","洛茜很爱收集这样精巧的东西，虽然我不明白这些小玩意儿有什么用，但她喜欢……只好多给她找找了。","交谈2",{"_4050":16,"_15":4286,"_4092":37,"_4093":37,"_4123":4287,"_4125":4288,"_4127":1381,"_4128":4289},"chr_0006_wolfgd_34","chr_0006_wolfgd_mono_chat_line03","不切实际的理想主义总是害人也害己。这个道理，我想大部分在开拓区待过的人都明白。区别在于，多数人自始至终只配当受害者。","交谈3",{"_4050":16,"_15":4291,"_4092":37,"_4093":37,"_4123":4292,"_4125":4293,"_4127":1421,"_4128":4294},"chr_0006_wolfgd_35","chr_0006_wolfgd_mono_chat_line04","我确实更习惯一个人解决问题——不是认为自己有能力承担一切，只是觉得有些事我做了，本该去做这些事的人……就能轻松一点。","交谈4",{"_4050":16,"_15":4296,"_4092":37,"_4093":37,"_4123":4297,"_4125":4298,"_4127":157,"_4128":4299},"chr_0006_wolfgd_36","chr_0006_wolfgd_mono_chat_line05","离群的狼依然不会轻易背弃狼群……这点毋庸置疑。但为了生存，或是难以放下的东西，总会有离群者踏上不归路。我做不到去同情他们，也不打算干涉他们，但至少会尊重他们。","交谈5",{"_4050":16,"_15":4301,"_4092":37,"_4093":37,"_4123":4302,"_4125":4303,"_4127":1499,"_4128":4304},"chr_0006_wolfgd_37","chr_0006_wolfgd_mono_about_line01","直到今天，我仍在寻找那个属于狼群的未来……与终末地的合作未必是最好的选择，但在我看来，这依然是尤为重要且特殊的一步。全凭外力改变狼群固有的认知纯属妄想，但有时，变化也只是缺了一个契机——如何将“它”带回去，正是我在反复考虑的事。","话题：狼群",{"_4050":16,"_15":4306,"_4092":37,"_4093":37,"_4123":4307,"_4125":4308,"_4127":1538,"_4128":4309},"chr_0006_wolfgd_38","chr_0006_wolfgd_mono_about_line02","我陪伴洛茜的时间很少，但有时候看着现在的她……我每一次都会惊讶于她的成长。她与荒野共同呼吸，她调遣着狼的血脉。使用武器，觉醒技艺，学会狩猎，一切都水到渠成。我知道，她已经不是那个在浸血的襁褓中奄奄一息的婴孩，她是卢皮诺家族的“狼珀”。我只会是狼群的爪牙，而她终会是狼群之心。","话题：洛茜",{"_4050":16,"_15":4311,"_4092":37,"_4093":37,"_4123":4312,"_4125":4313,"_4127":41,"_4128":4314},"chr_0006_wolfgd_39","chr_0006_wolfgd_mono_about_line03","裂地者氏族的构成比世人想象得更加复杂。除了碾骨与狼群，也有沙盗这样组织松散、只靠一艘私掠舰立足的异类。除此之外……灰疤氏族会在身上纹满“誓歌”，没人会想在太阳落山后和影颅氏族的刺客交手。这些能在荒地上幸存的小氏族，总是比一般人掌握更多活着的诀窍。","话题：裂地者",{"_4050":16,"_15":4316,"_4092":37,"_4093":37,"_4123":4317,"_4125":4318,"_4127":44,"_4128":4319},"chr_0006_wolfgd_40","chr_0006_wolfgd_explore_point_common_01","那里有些能带走的东西。","发现资源1",{"_4050":16,"_15":4321,"_4092":37,"_4093":37,"_4123":4322,"_4125":4323,"_4127":47,"_4128":4324},"chr_0006_wolfgd_41","chr_0006_wolfgd_explore_point_valub_01","特别的战利品，我们应该拿下它们。","发现资源2",{"_4050":16,"_15":4326,"_4092":37,"_4093":37,"_4123":4327,"_4125":4328,"_4127":50,"_4128":4329},"chr_0006_wolfgd_42","chr_0006_wolfgd_explore_find_locked_01","那附近我们还没去过，最好留意下。","发现未探索区域",{"_4050":16,"_15":4331,"_4092":37,"_4093":37,"_4123":4332,"_4125":4333,"_4127":1763,"_4128":4334},"chr_0006_wolfgd_43","chr_0006_wolfgd_explore_find_danger_01","棘手的味道，我们的对手并不简单。","发现强敌",{"_4050":16,"_15":4336,"_4092":37,"_4093":37,"_4123":4337,"_4125":4338,"_4127":1802,"_4128":4339},"chr_0006_wolfgd_44","chr_0006_wolfgd_interact_mine_valub_01","希望它们有足够的价值，配得上我们费的功夫。","采集矿物1",{"_4050":16,"_15":4341,"_4092":37,"_4093":37,"_4123":4342,"_4125":4343,"_4127":270,"_4128":4344},"chr_0006_wolfgd_45","chr_0006_wolfgd_interact_mine_valub_echo2_01","我一个人也……不，麻烦各位了。","采集矿物2",{"_4050":16,"_15":4346,"_4092":37,"_4093":37,"_4123":4347,"_4125":4348,"_4127":1880,"_4128":4349},"chr_0006_wolfgd_46","chr_0006_wolfgd_interact_treasure_valub_01","非凡的战利品，这足以宣告狩猎的丰收。","打开储藏箱",{"_4050":16,"_15":4351,"_4092":37,"_4093":37,"_4123":4352,"_4125":4353,"_4127":1920,"_4128":4354},"chr_0006_wolfgd_47","chr_0006_wolfgd_interact_etherium_01","醚质，如果终末地认为它有价值的话……","获得醚质",{"_4050":16,"_15":4356,"_4092":37,"_4093":37,"_4123":4357,"_4125":4358,"_4127":72,"_4128":4359},"chr_0006_wolfgd_48","chr_0006_wolfgd_interact_blight_break_01","侵蚀会干扰行动计划，正确的判断。","消除侵蚀",{"_4050":16,"_15":4361,"_4092":37,"_4093":37,"_4123":4362,"_4125":4363,"_4127":60,"_4128":4364},"chr_0006_wolfgd_49","chr_0006_wolfgd_interact_rest_01","弹药清点完毕，下一轮狩猎该开始了。","休整",{"_4050":16,"_15":4366,"_4092":37,"_4093":37,"_4123":4367,"_4125":4368,"_4127":76,"_4128":4369},"chr_0006_wolfgd_50","chr_0006_wolfgd_combat_suppuse_using_01","小心点，别乱来。","使用战术物品1",{"_4050":16,"_15":4371,"_4092":37,"_4093":37,"_4123":4372,"_4125":4373,"_4127":78,"_4128":4374},"chr_0006_wolfgd_51","chr_0006_wolfgd_combat_suppuse_getheal_01","……缓过来了。","使用战术物品2",{"_4050":16,"_15":4376,"_4092":37,"_4093":37,"_4123":4377,"_4125":4378,"_4127":80,"_4128":4379},"chr_0006_wolfgd_52","chr_0006_wolfgd_combat_remind_danger_01","注意闪开！","危险提醒",{"_4050":16,"_15":4381,"_4092":37,"_4093":37,"_4123":4382,"_4125":4383,"_4127":82,"_4128":4384},"chr_0006_wolfgd_53","chr_0006_wolfgd_combat_hurt_lowhp_01","不必管我。","负伤",{"_4050":16,"_15":4386,"_4092":37,"_4093":37,"_4123":4387,"_4125":4388,"_4127":84,"_4128":4389},"chr_0006_wolfgd_54","chr_0006_wolfgd_combat_dead_01","唔……暂时撤退。","力竭",{"_4050":16,"_15":4391,"_4092":37,"_4093":37,"_4123":4392,"_4125":4393,"_4127":86,"_4128":4394},"chr_0006_wolfgd_55","chr_0006_wolfgd_combat_remind_praise_01","有两下子。","小队激励1",{"_4050":16,"_15":4396,"_4092":37,"_4093":37,"_4123":4397,"_4125":4398,"_4127":2267,"_4128":4399},"chr_0006_wolfgd_56","chr_0006_wolfgd_combat_remind_praise_02","精彩的配合。","小队激励2",{"_4050":16,"_15":4401,"_4092":37,"_4093":37,"_4123":4402,"_4125":440