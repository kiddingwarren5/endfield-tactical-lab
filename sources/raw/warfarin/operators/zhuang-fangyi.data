8349,8350],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_8353":8354,"_8360":8361,"_8042":8365,"_8370":8371,"_8374":8375,"_8379":8380,"_8383":8384,"_8388":8389,"_8392":8393,"_8397":8398,"_8401":8402,"_7857":8406,"_8411":8412,"_8415":8416,"_8420":8421,"_8425":8426,"_8429":8430,"_8434":8435,"_7940":8438,"_8443":8444,"_8447":8448,"_8453":8454,"_7946":8457,"_8462":8463,"_8466":8467,"_7964":8471,"_8476":8477,"_8480":8481,"_7971":8485,"_8490":8491,"_8496":8497,"_7995":8501,"_8506":8507,"_8511":8512,"_8516":8517,"_8521":8522,"_8002":8526,"_8530":8531,"_8535":8536,"_8540":8541,"_8544":8545,"_8550":8551,"_8555":8556,"_8032":8560,"_8565":8566,"_8570":8571,"_8573":8574,"_8577":8578,"_8582":8583,"_8586":8587,"_8592":8593,"_8596":8597,"_8601":8602,"_8606":8607,"_8049":8611,"_8615":8616,"_8618":8619,"_8069":8623,"_8627":8628,"_8632":8633,"_8637":8638,"_8642":8643,"_8646":8647,"_8651":8652,"_7869":8657,"_7908":8661,"_8666":8667,"_8671":8672,"_8676":8677,"_8095":8681,"_8686":8687,"_8689":8690,"_8693":8694,"_8697":8698,"_8702":8703,"_8707":8708,"_8711":8712,"_8716":8717,"_8135":8721,"_8725":8726,"_8730":8731,"_8735":8736,"_8740":8741,"_8744":8745,"_8748":8749,"_8753":8754,"_8758":8759,"_8762":8763,"_8768":8769,"_8772":8773,"_8776":8777,"_8781":8782,"_8785":8786,"_8789":8790,"_8793":8794,"_8799":8800,"_8804":8805,"_8809":8810,"_8814":8815,"_8819":8820,"_8824":8825,"_8829":8830,"_8834":8835,"_8839":8840,"_8844":8845,"_8849":8850,"_8854":8855,"_8859":8860,"_8864":8865},"adv.electricFence",{"_4490":8355,"_8356":3948,"_15":8353,"_8357":3948,"_19":8358,"_8359":7925},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4490":8362,"_8356":8363,"_15":8360,"_8357":3948,"_19":8364,"_8359":7978},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4490":8366,"_8356":8367,"_15":8042,"_8357":8368,"_19":8369,"_8359":8107},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4490":8372,"_8356":3948,"_15":8370,"_8357":3948,"_19":8373,"_8359":7925},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4490":8376,"_8356":8377,"_15":8374,"_8357":3948,"_19":8378,"_8359":7925},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4490":8381,"_8356":3948,"_15":8379,"_8357":3948,"_19":8382,"_8359":7925},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4490":8385,"_8356":8386,"_15":8383,"_8357":3948,"_19":8387,"_8359":8019},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4490":8390,"_8356":3948,"_15":8388,"_8357":3948,"_19":8391,"_8359":7925},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4490":8394,"_8356":8395,"_15":8392,"_8357":3948,"_19":8396,"_8359":7925},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4490":8399,"_8356":3948,"_15":8397,"_8357":3948,"_19":8400,"_8359":3948},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4490":8403,"_8356":8404,"_15":8401,"_8357":3948,"_19":8405,"_8359":7978},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4490":8407,"_8356":8408,"_15":7857,"_8357":8409,"_19":8410,"_8359":8107},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4490":8413,"_8356":3948,"_15":8411,"_8357":3948,"_19":8414,"_8359":7925},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4490":8417,"_8356":8418,"_15":8415,"_8357":3948,"_19":8419,"_8359":7925},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4490":8422,"_8356":8423,"_15":8420,"_8357":3948,"_19":8424,"_8359":7925},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4490":8427,"_8356":3948,"_15":8425,"_8357":3948,"_19":8428,"_8359":7952},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4490":8431,"_8356":8432,"_15":8429,"_8357":3948,"_19":8433,"_8359":7925},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4490":8436,"_8356":3948,"_15":8434,"_8357":3948,"_19":8437,"_8359":7952},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4490":8439,"_8356":8440,"_15":7940,"_8357":8441,"_19":8442,"_8359":8019},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4490":8445,"_8356":8440,"_15":8443,"_8357":3948,"_19":8446,"_8359":8019},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4490":8449,"_8356":8450,"_15":8447,"_8357":8451,"_19":8452,"_8359":7952},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4490":8455,"_8356":3948,"_15":8453,"_8357":3948,"_19":8456,"_8359":7952},"持续时间内，受影响的目标暂停行动。","定身",{"_4490":8458,"_8356":8459,"_15":7946,"_8357":8460,"_19":8461,"_8359":8131},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4490":8464,"_8356":8459,"_15":8462,"_8357":3948,"_19":8465,"_8359":8131},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4490":8468,"_8356":3948,"_15":8466,"_8357":8469,"_19":8470,"_8359":3948},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4490":8472,"_8356":8473,"_15":7964,"_8357":8474,"_19":8475,"_8359":8081},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4490":8478,"_8356":8473,"_15":8476,"_8357":3948,"_19":8479,"_8359":8081},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4490":8482,"_8356":8483,"_15":8480,"_8357":3948,"_19":8484,"_8359":7925},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4490":8486,"_8356":8487,"_15":7971,"_8357":8488,"_19":8489,"_8359":8107},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4490":8492,"_8356":8493,"_15":8490,"_8357":8494,"_19":8495,"_8359":7952},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4490":8498,"_8356":8499,"_15":8496,"_8357":3948,"_19":8500,"_8359":7952},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4490":8502,"_8356":8503,"_15":7995,"_8357":8504,"_19":8505,"_8359":7978},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4490":8508,"_8356":3948,"_15":8506,"_8357":8509,"_19":8510,"_8359":7978},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4490":8513,"_8356":8514,"_15":8511,"_8357":3948,"_19":8515,"_8359":7925},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4490":8518,"_8356":8519,"_15":8516,"_8357":3948,"_19":8520,"_8359":7925},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4490":8523,"_8356":8524,"_15":8521,"_8357":3948,"_19":8525,"_8359":7978},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4490":8527,"_8356":8363,"_15":8002,"_8357":8528,"_19":8529,"_8359":7978},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4490":8532,"_8356":3948,"_15":8530,"_8357":8533,"_19":8534,"_8359":7952},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4490":8537,"_8356":8538,"_15":8535,"_8357":3948,"_19":8539,"_8359":7925},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4490":8542,"_8356":3948,"_15":8540,"_8357":3948,"_19":8543,"_8359":3948},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4490":8546,"_8356":8547,"_15":8544,"_8357":8548,"_19":8549,"_8359":7952},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4490":8552,"_8356":8553,"_15":8550,"_8357":3948,"_19":8554,"_8359":7925},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4490":8557,"_8356":3948,"_15":8555,"_8357":8558,"_19":8559,"_8359":8019},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4490":8561,"_8356":8562,"_15":8032,"_8357":8563,"_19":8564,"_8359":8019},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4490":8567,"_8356":8568,"_15":8565,"_8357":3948,"_19":8569,"_8359":7925},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4490":8445,"_8356":8562,"_15":8570,"_8357":3948,"_19":8572,"_8359":8019},"干员受到灼热附着","sys.tacticalItem",{"_4490":8575,"_8356":3948,"_15":8573,"_8357":3948,"_19":8576,"_8359":7925},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4490":8579,"_8356":8580,"_15":8577,"_8357":3948,"_19":8581,"_8359":8019},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4490":8464,"_8356":8584,"_15":8582,"_8357":3948,"_19":8585,"_8359":8131},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4490":8588,"_8356":8589,"_15":8586,"_8357":8590,"_19":8591,"_8359":7952},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4490":8594,"_8356":3948,"_15":8592,"_8357":3948,"_19":8595,"_8359":7952},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4490":8598,"_8356":8599,"_15":8596,"_8357":3948,"_19":8600,"_8359":8107},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4490":8603,"_8356":8604,"_15":8601,"_8357":3948,"_19":8605,"_8359":8131},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4490":8608,"_8356":8609,"_15":8606,"_8357":3948,"_19":8610,"_8359":7952},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4490":8612,"_8356":8613,"_15":8049,"_8357":8504,"_19":8614,"_8359":7978},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4490":8362,"_8356":8613,"_15":8615,"_8357":3948,"_19":8617,"_8359":7978},"干员受到冻结","ba.naturalvul",{"_4490":8620,"_8356":8621,"_15":8618,"_8357":3948,"_19":8622,"_8359":8081},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4490":8407,"_8356":8624,"_15":8069,"_8357":8625,"_19":8626,"_8359":8107},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4490":8629,"_8356":8630,"_15":8627,"_8357":3948,"_19":8631,"_8359":7925},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4490":8634,"_8356":8635,"_15":8632,"_8357":3948,"_19":8636,"_8359":7925},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4490":8639,"_8356":8640,"_15":8637,"_8357":3948,"_19":8641,"_8359":7925},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4490":8644,"_8356":3948,"_15":8642,"_8357":3948,"_19":8645,"_8359":7925},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4490":8648,"_8356":3948,"_15":8646,"_8357":8649,"_19":8650,"_8359":3948},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4490":8653,"_8356":8654,"_15":8651,"_8357":8655,"_19":8656,"_8359":7952},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4490":8658,"_8356":3948,"_15":7869,"_8357":8659,"_19":8660,"_8359":8081},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4490":8662,"_8356":8663,"_15":7908,"_8357":8664,"_19":8665,"_8359":8107},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4490":8668,"_8356":8669,"_15":8666,"_8357":3948,"_19":8670,"_8359":7925},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4490":8673,"_8356":8674,"_15":8671,"_8357":3948,"_19":8675,"_8359":8081},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4490":8678,"_8356":8679,"_15":8676,"_8357":3948,"_19":8680,"_8359":7925},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4490":8682,"_8356":8683,"_15":8095,"_8357":8684,"_19":8685,"_8359":8081},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4490":8478,"_8356":8683,"_15":8686,"_8357":3948,"_19":8688,"_8359":8081},"干员受到自然附着","ba.originium",{"_4490":8691,"_8356":3948,"_15":8689,"_8357":3948,"_19":8692,"_8359":7952},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4490":8695,"_8356":3948,"_15":8693,"_8357":3948,"_19":8696,"_8359":8107},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4490":8699,"_8356":8700,"_15":8697,"_8357":3948,"_19":8701,"_8359":8107},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4490":8704,"_8356":3948,"_15":8702,"_8357":8705,"_19":8706,"_8359":8115},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4490":8709,"_8356":3948,"_15":8707,"_8357":3948,"_19":8710,"_8359":7925},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4490":8713,"_8356":3948,"_15":8711,"_8357":8714,"_19":8715,"_8359":8131},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4490":8718,"_8356":8719,"_15":8716,"_8357":3948,"_19":8720,"_8359":7925},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4490":8722,"_8356":8584,"_15":8135,"_8357":8723,"_19":8724,"_8359":8131},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4490":8727,"_8356":8728,"_15":8725,"_8357":3948,"_19":8729,"_8359":8131},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4490":8732,"_8356":3948,"_15":8730,"_8357":8733,"_19":8734,"_8359":7952},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4490":8737,"_8356":3948,"_15":8735,"_8357":8738,"_19":8739,"_8359":3948},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4490":8742,"_8356":3948,"_15":8740,"_8357":3948,"_19":8743,"_8359":7925},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4490":8746,"_8356":3948,"_15":8744,"_8357":3948,"_19":8747,"_8359":7952},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4490":8750,"_8356":8751,"_15":8748,"_8357":3948,"_19":8752,"_8359":7925},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4490":8755,"_8356":3948,"_15":8753,"_8357":8756,"_19":8757,"_8359":7952},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4490":8760,"_8356":3948,"_15":8758,"_8357":3948,"_19":8761,"_8359":7925},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4490":8764,"_8356":8765,"_15":8762,"_8357":8766,"_19":8767,"_8359":7952},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4490":8770,"_8356":3948,"_15":8768,"_8357":3948,"_19":8771,"_8359":7952},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4490":8774,"_8356":3948,"_15":8772,"_8357":3948,"_19":8775,"_8359":7952},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4490":8778,"_8356":8779,"_15":8776,"_8357":3948,"_19":8780,"_8359":7925},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4490":8783,"_8356":3948,"_15":8781,"_8357":3948,"_19":8784,"_8359":7952},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4490":8787,"_8356":3948,"_15":8785,"_8357":3948,"_19":8788,"_8359":7952},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4490":8791,"_8356":3948,"_15":8789,"_8357":3948,"_19":8792,"_8359":7952},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4490":8795,"_8356":8796,"_15":8793,"_8357":8797,"_19":8798,"_8359":7952},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4490":8801,"_8356":8802,"_15":8799,"_8357":3948,"_19":8803,"_8359":7925},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4490":8806,"_8356":8807,"_15":8804,"_8357":3948,"_19":8808,"_8359":7925},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4490":8811,"_8356":8812,"_15":8809,"_8357":3948,"_19":8813,"_8359":7925},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4490":8816,"_8356":8817,"_15":8814,"_8357":3948,"_19":8818,"_8359":7925},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4490":8821,"_8356":8822,"_15":8819,"_8357":3948,"_19":8823,"_8359":7925},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4490":8826,"_8356":8827,"_15":8824,"_8357":3948,"_19":8828,"_8359":7925},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4490":8831,"_8356":8832,"_15":8829,"_8357":3948,"_19":8833,"_8359":7925},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4490":8836,"_8356":8837,"_15":8834,"_8357":3948,"_19":8838,"_8359":7925},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4490":8841,"_8356":8842,"_15":8839,"_8357":3948,"_19":8843,"_8359":7925},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4490":8846,"_8356":8847,"_15":8844,"_8357":3948,"_19":8848,"_8359":7925},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4490":8851,"_8356":8852,"_15":8849,"_8357":3948,"_19":8853,"_8359":7925},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4490":8856,"_8356":8857,"_15":8854,"_8357":3948,"_19":8858,"_8359":7925},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4490":8861,"_8356":8862,"_15":8859,"_8357":3948,"_19":8863,"_8359":7925},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4490":8866,"_8356":8867,"_15":8864,"_8357":3948,"_19":8868,"_8359":7925},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7561":8871,"_7116":8880,"_7214":8882,"_7216":8884,"_7218":8886,"_7220":8888,"_6550":8890,"_7223":8892,"_7225":8894,"_6553":8895,"_6282":8897,"_7231":8899,"_7234":8900,"_7237":8901,"_7239":8903,"_6544":8904,"_7244":8905,"_7247":8906,"_7250":8908,"_7253":8909,"_7256":8910,"_7259":8911,"_7262":8912,"_7266":8913,"_7270":8914,"_6970":8915,"_7276":8916,"_7280":8918,"_7284":8919,"_7288":8921,"_7292":8923,"_7296":8925,"_7300":8926,"_7304":8928,"_7308":8930,"_7312":8931,"_6556":8933,"_7319":8935,"_7323":8937,"_7327":8939,"_7331":8942,"_7335":8945,"_7339":8948,"_7343":8951,"_7347":8952,"_7351":8954,"_7355":8955,"_7359":8956,"_7363":8958,"_7367":8960,"_7371":8961,"_7375":8963,"_7379":8965,"_7383":8967,"_7387":8969,"_7391":8971,"_7395":8973,"_7399":8975,"_7402":8977,"_7406":8979,"_7410":8981,"_7414":8982,"_7418":8984,"_7422":8985,"_7426":8986,"_7430":8987,"_7434":8988,"_7438":8989,"_7442":8990,"_7446":8991,"_7450":8992,"_7454":8993,"_7458":8994,"_7462":8995,"_7466":8996,"_7470":8997,"_7474":8998,"_7478":8999,"_7482":9000,"_7486":9001,"_7490":9002,"_7494":9003,"_7497":9004,"_7501":9005,"_7505":9006,"_7509":9007,"_7513":9008,"_7517":