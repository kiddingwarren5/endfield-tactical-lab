{"_36":39,"_38":3904},5832,{"_36":55,"_38":3906},331,{"_36":58,"_38":37},{"_36":60,"_38":3909},1.48469387755102,{"_36":62,"_38":3911},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3931,"_102":64},{"_33":3932},[3933,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":3934},97,{"_36":41,"_38":3936},98.35051546391752,{"_36":44,"_38":3938},100.52766673679778,{"_36":47,"_38":3940},188.59036398064433,{"_36":50,"_38":3942},129.8782242794028,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},334,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3970,"_102":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},99.2783505154639,{"_36":44,"_38":3977},101.48032821375972,{"_36":47,"_38":3979},190.32610982537398,{"_36":50,"_38":3981},131.07519461392835,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},337,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4010,"_102":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},100.2061855670103,{"_36":44,"_38":4017},102.43298969072163,{"_36":47,"_38":4019},192.06185567010363,{"_36":50,"_38":4021},132.27216494845393,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},340,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_15","tag_21","tag_25","charId","charIllustInitPos",{"_4056":4057,"_4058":4059},"x",-14,"y",-302,"charPassiveUIPrefabName","OverlayInfoNodeLizhiyan","charTypeId","Natural","cvName",{"_4066":4067,"_4068":4069,"_4070":4071,"_4072":4073,"_4053":16},"ChiCVName","唐雅菁","EngCVName","Julia Gu","JapCVName","Lynn","KorCVName","金顺美","defaultWeaponId","wpn_funnel_0002","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Arcane","mainAttrType","phoneticName","","profession","profileRecord",[4088,4099,4104,4109,4115,4120],{"_4053":16,"_15":4089,"_4090":4091,"_4092":4093,"_4094":39,"_4095":4096,"_4097":37,"_4098":37},"chr_0032_lizhiyan_1","recordDesc","【代号】诀\n【性别】女\n【身份认证】应龙特勤队\n【生日】7月7日\n【种族】黎博利\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：优良\n战术规划：卓越\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4100,"_4090":4101,"_4092":4102,"_4094":55,"_4095":4103,"_4097":37,"_4098":37},"chr_0032_lizhiyan_2","干员诀，本名李织烟，宏山科学院应龙特勤队行动队长。在北部禁区行动中负伤，被批准长期休养。经应龙特勤队特许，与终末地工业建立合作关系。\n\n按照诀自己的说法，这是她第一次长期休假。医疗干员在她身上检查出数十处暗伤，一线高危的侵蚀环境没有摧毁她的精神，却折磨着她的肉体。在和宏科院相关人士的对接中，也得知了希望她能借此机会多做休整的意愿——“就像是一口气休掉了过去数年该休的假。”\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4105,"_4090":4106,"_4092":4107,"_4094":58,"_4095":4108,"_4097":37,"_4098":37},"chr_0032_lizhiyan_3","队长和陈千语？我知道的也不多。听说她们最初关系还不错，在应试选拔期间还搭档过。她们二人是候补里表现最突出的，每个人都以为她们会成为守卫应龙关的搭档。但之后……每次见到她们两个不是在吵架，就是准备吵架。队长的性格你也知道，总是寸步不让，后来两个人就被拆散了，最终只有队长通过了选拔……如果陈千语也进入应龙的话……我想象不出来，而且队长肯定还会是队长，她跟队长一起出任务……弄不好没几天调任令就下来了。从旁观者视角来看，竺老师和队长的判断没有错。现在的局面对她们二人而言都是最好的结果。\n——应龙特勤队队员 峰\n\n队长操作重炮的技术不是从特勤队里学来的，我之前问过她，她说是父亲留下的“遗物”。有一段时间，队长的训练陷入了瓶颈，她不停地更换武器。刀枪剑戟，斧钺钩叉，她都试过一遍，她用得很好，百般武艺都能很快掌握，但她总是不满意，认为自己始终没能更进一步。她为此成倍地锤炼自己……旁人看了都担心她能否撑得住。直到有一回，她找到了父亲寄存在外的重炮，难得请了几天假，没人知道她去了哪里，但回来之后，她就决定使用那几门重炮了。嗯，之后她就和现在没什么两样了。驻守武陵的队员里没人是她的对手。\n——应龙特勤队队员 言\n\n你别听信谣言，虽说以前的比试……她……嗯……是占了那么一点点上风，但是——现在的我可今非昔比！要是再打起来，我先让她三招！嗯……两招吧。别担心，就只是切磋而已。过去她总是眉头紧皱，像是背了块石头在身上，但现在北部禁区的夙愿已了，她和之前有些不同了。嗯！有点像我刚开始认识她时的样子了。只是无论我怎么问她，她都不肯提禁区里那段经历，我总不能一直缠着管理员吧……唔……可能也不是不行？\n——应龙特勤队候补队员（前） 陈千语\n\n李织烟？你是说应龙的那个小丫头吗？没什么特别的印象，每次见到她的时候，她都是那副正经模样，教人觉着拧巴。总喊着“代理人，代理人”，我说了好几次她才肯改口，甚是无趣。她的人生也不过短短百载，空有一身移山填海的好本领，却活得呆呆板板，不自在得很。不过……最近她似乎变了一些，神色也柔和了不少，这才让人对她有了些兴趣。我猜是那呆货做了什么吧？哼，到处乱跑，还弄得一身伤，这次可别想轻易逃过了。\n——祀","CN_03","档案资料·一",{"_4053":16,"_15":4110,"_4090":4111,"_4092":4112,"_4094":64,"_4095":4113,"_4097":64,"_4098":4114},"chr_0032_lizhiyan_4","“有时你会觉得她冷漠无情，但这是特勤队所必需的。”旁人对李织烟的评价非常简单。\n你能用“为了完成任务”来解释李织烟的一切行为。应龙特勤队的战场总位于极端环境中，冷酷坚决的执行力就是完成任务的一份保障。当“活着回去”没有出现在任务目标内，特勤队的成员都知道那意味着什么。\n特勤队有一间暗室，戒备极其森严，里面存放的并不是什么情报卷宗，而是每一位应龙队员的“遗物”。在正式成为特勤队成员的那一刻，你会分到一个匣子，放什么进去自己决定。只是，如果当你因任务无法回来时，匣子里的东西就是你存在过的唯一证明。\n李织烟的匣子空空如也。\n她告诉暗室的管理者，自己一无所有，曾经的一切都埋在禁区里，在那片漆黑冰冷的毒瘴之下。\n直到管理者告诉她这是特勤队的规矩，她才开始思考，到底什么才能代表自己。在摘掉应龙特勤队行动队长这个身份后，还有什么是能够放进匣中之物？“我”又是谁？\n但这个问题也没有困扰她多久，她找了市集上的一个老师傅，用毛笔写下自己的名字，装进了匣子里。\n这些问题，都不重要。重要的，永远都是下一个任务。\n…………\n她几乎从不来暗室，但最近，她来过好几次，在那原本空荡荡的匣子里留下了不少东西。有时是一支笔，有时是一颗纽扣，有时是一把匕首……都那么平平无奇，看不出什么意义，似乎只是她从桌上随手带回的。那些东西有的是邻居给予的礼物，有的是受人托付的信物……她都如同对待珍视的宝物一般，将其放入匣中。\n当管理者饶有兴趣地问起时，她不再像往日那样冷峻不语，而是略作思考，认真地回答道——\n“回首看去，我才发现自己错过了那么多值得珍视的东西。”","CN_04","档案资料·二",300,{"_4053":16,"_15":4116,"_4090":4117,"_4092":4118,"_4094":66,"_4095":4119,"_4097":64,"_4098":4114},"chr_0032_lizhiyan_5","我的作战风格？其实是源自于父亲教我的阵法，和应龙的战术。\n父亲说过：阵法以“变”为理。人借阵势，阵随人动。任何阵法都不是一成不变的，将自己视作“阵”的一部分，才是完成阵法的关键。\n小时候，父亲经常带着我四处玩耍，有时会乘着圆木顺流而下，有时会爬上高耸的树尖，如果玩累了，就躺在草地上看着满天繁星……父亲会叮嘱我记下星星的位置，分清星座的形状。后来我才知道，这并不是单纯地在“玩”，父亲把他对阵法、对世间万物的盈缺变换的理解，以一种润物无声的方式传授给了我。\n而应龙则传授了我何为“不变”。任凭风云流转，我自岿然不动。应龙的战法永远以“势”为主，势成可当千钧。虽然危局不同，应龙的战术也不相同，但不论剑术枪法，又或是阵型排列，应龙永远各司其职，力求以一势破万敌。\n我试着把应龙的战术和父亲传授的阵法进行结合。应龙的作战风格更讲究整体，兼顾全局，就像将三门重炮看作一体，互相补缺。而父亲的阵法则讲究灵动，千变万化。这二者很难融合，困扰了我很长一段时间……\n直到我再次回到和父亲“玩耍”的地方，看见落叶成簇穿越湍急的河流，看见羽兽停在枝头，与树梢一起迎风摆动，看见星座不断移动，却总有其形——我才参透父亲曾说过的，那所缺的关键就是“我”自己，我是它们的一部分，也是阵法中的第四枚棋子。\n我就是联系阵法变换的纽带，也是补全战术空缺的异动。明白这一点后，我把自己也融入了阵法中，以玉简调整炮的走势、火力，这才觉得几门重炮化为了手脚的延伸，运用起来才得心应手。\n我的源石技艺更注重能量的“流动”，在范围内制造“变”与“不变”的平衡区，这点和洁尔佩塔干员很像，她和我分享了施术过程中的诀窍。我还请教了弧光干员，她对电流的掌控出神入化，关于这方面的心得，她只给了两个字作为建议——“感受”。帝江号上奇人齐聚，还有很多值得我学习和吸纳的地方——别礼干员能一力降十会，骏卫干员对军阵的理解如臻化境……我希望在帝江号上的这段时间也可以用来精进自己的技艺，集百家之所长……\n我也在尝试把这些心得写成册子，给那些同样修习阵法和重炮的队员们参考练习，希望能为他们提供一些帮助。","CN_05","档案资料·三",{"_4053":16,"_15":4121,"_4090":4122,"_4092":4123,"_4094":68,"_4095":4124,"_4097":64,"_4098":4125},"chr_0032_lizhiyan_6","【收件记录】\n签收人：李织烟\n寄件人：菱月\n寄送地址：武陵城\n签收状态：已签收\n检查状态：已通过检查\n语音留言：\n织烟，是我，你刘婶！听说你去终末地养伤啦？你这闺女，说走就走，也不打声招呼。周围的叔婶都惦记着你呢！我托安思园的小姑娘帮我们给你寄了些东西，都是你喜欢的！有几盒米糕，还有甜酒酿。这甜酒酿还是前几天小娃过生日才做的，放不了太久，尽快给它喝了。\n还有，你沈姨最疼你了，非要塞几件袄，是她才缝的，她一听说你要住在飞船上，逢人就说“那得多冷啊！”，说啥都要放进来。\n唉，你这一走，也不知道啥时候再回来。你这闺女不好动，老是往那儿一坐坐一天。平时也不和一般大的闺女们玩，净帮我们这些老头老太太干活了。这可不行！我们虽然也稀罕你，但我们年纪大了，总不能陪你一辈子吧？听刘婶的，你在那个终末地多交点朋友。我老远看到过他们那个管理员和叫佩丽卡的丫头，都不赖！你要不知道怎么搭话，就带上婶儿给你寄的米糕、甜酒酿，让终末地的人尝尝婶儿的手艺！这一来二去不就熟了嘛！\n婶儿看着你长大的，你虽然嘴上话少，心可细着呢。你帮了我们多少忙，我们都记在心里。你之前还把沈姨闺女的照片带回来了对吧？沈姨哭得稀里哗啦的。她闺女走的时候和你一般大，她一直把你当亲闺女看待。我们……也都一样。你是我们武陵的孩子，无论走到哪里，这里都是你的家。\n哎哟，你看我这说的，把天都聊死了。不说了不说了，你在那边好好养伤。早点回来，等你回武陵，婶儿肯定给你准备一大桌好吃的！别忘了婶儿刚说的，最好带上朋友们回来！\n…………\n等会儿啊！沈姨也想和你聊几句，但她这会儿又哭起来了，我们先让菱月寄东西去，晚点再让沈姨发个语音，你可别嫌我们烦，哎哎，你们别急，我没想霸着，这东西咋就没电了，啊……\n\n【寄件记录】\n寄件人：李织烟\n收件人：菱月\n寄送地址：帝江号\n寄送状态：已寄出\n检查状态：已通过检查\n物品清单：\n塞梦珂披巾 5件\n耶尔什微风 5瓶\n星门锁 3件\n精选柑实冲剂 10瓶\n语音留言：\n菱月，我是……李织烟。叔婶们寄的东西都收到了，下次别让他们寄了……帝江号上什么都有，之前寄来的，我分给管理员他们后还有不少……\n上次寄回去的披巾婶们好像很喜欢？我托后勤部门又采购了一些，你让她们去分一下吧。还有一些武陵没有的果味冲剂，和给小孩们准备的玩具。\n别担心钱，我也没有其他需要花钱的地方。\n对了，给沈姨东西的时候就说是终末地发的，我怕她瞎操心。","CN_06","档案资料·四",1500,"profileVoice",[4128,4136,4140,4144,4148,4152,4156,4161,4166,4171,4176,4181,4186,4191,4196,4201,4206,4211,4216,4221,4226,4231,4236,4241,4246,4251,4256,4261,4266,4271,4276,4281,4286,4291,4296,4301,4306,4311,4316,4321,4326,4331,4336,4341,4346,4351,4356,4361,4366,4371,4376,4381,4386,4391,4396,4401,4406,4411,4416,4421,4426,4431,4437,4442,4448,4454,4459,4465,4471,4477,4482,4488,4493,4499,4504,4510,4516,4522,4528,4534,4540,4545],{"_4053":16,"_15":4089,"_4097":37,"_4098":37,"_4129":4130,"_4131":4132,"_4133":39,"_4134":4135},"voId","chr_0032_lizhiyan_chrbark_squad_01","voiceDesc","现在，你是指挥官。","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4100,"_4097":37,"_4098":37,"_4129":4137,"_4131":4138,"_4133":55,"_4134":4139},"chr_0032_lizhiyan_chrbark_squad_02","定不辱应龙之名。","行动准备2",{"_4053":16,"_15":4105,"_4097":37,"_4098":37,"_4129":4141,"_4131":4142,"_4133":58,"_4134":4143},"chr_0032_lizhiyan_chrbark_join_01","我相信你。","编入队伍1",{"_4053":16,"_15":4110,"_4097":37,"_4098":37,"_4129":4145,"_4131":4146,"_4133":64,"_4134":4147},"chr_0032_lizhiyan_chrbark_join_02","随时听从调遣。","编入队伍2",{"_4053":16,"_15":4116,"_4097":37,"_4098":37,"_4129":4149,"_4131":4150,"_4133":66,"_4134":4151},"chr_0032_lizhiyan_chrbark_weap_01","百种神兵，都不及心中一念。","更换武器",{"_4053":16,"_15":4121,"_4097":37,"_4098":37,"_4129":4153,"_4131":4154,"_4133":68,"_4134":4155},"chr_0032_lizhiyan_chrbark_gear_01","终末地的水准足够优秀。","更换装备",{"_4053":16,"_15":4157,"_4097":37,"_4098":37,"_4129":4158,"_4131":4159,"_4133":70,"_4134":4160},"chr_0032_lizhiyan_7","chr_0032_lizhiyan_chrup_skill_01","只要将自己磨炼到极致，纵使局势变化万千，也可从容破局。","激活天赋阵列",{"_4053":16,"_15":4162,"_4097":37,"_4098":37,"_4129":4163,"_4131":4164,"_4133":88,"_4134":4165},"chr_0032_lizhiyan_8","chr_0032_lizhiyan_chrup_level_01","录像啊……我也曾这样复盘作战，到了废寝忘食的地步。","观看作战记录",{"_4053":16,"_15":4167,"_4097":55,"_4098":39,"_4129":4168,"_4131":4169,"_4133":90,"_4134":4170},"chr_0032_lizhiyan_9","chr_0032_lizhiyan_chrup_promt01_01","感谢任命……成为队长后，我很少经历这样的场合，还有些……新奇。","精英化晋升1",{"_4053":16,"_15":4172,"_4097":55,"_4098":55,"_4129":4173,"_4131":4174,"_4133":94,"_4134":4175},"chr_0032_lizhiyan_10","chr_0032_lizhiyan_chrup_promt02_01","这是否代表终末地和宏科院的合作更紧密了？也许下次，我可以邀请你去宏山的应龙特勤队总部参观。","精英化晋升2",{"_4053":16,"_15":4177,"_4097":55,"_4098":58,"_4129":4178,"_4131":4179,"_4133":101,"_4134":4180},"chr_0032_lizhiyan_11","chr_0032_lizhiyan_chrup_promt03_01","比起褒奖，我想得到更多的任务。什么都行，我不想让自己习惯清闲的生活……我想帮上你的忙。","精英化晋升3",{"_4053":16,"_15":4182,"_4097":55,"_4098":64,"_4129":4183,"_4131":4184,"_4133":96,"_4134":4185},"chr_0032_lizhiyan_12","chr_0032_lizhiyan_chrup_promt04_01","嗯？只是想到了在应龙关接过队长一职的时候。武陵事了，当时的满腔愤懑和执着似乎都烟消云散了……如果当年的我知道管理员有朝一日会亲自为我授勋……算了，没什么。","精英化晋升4",{"_4053":16,"_15":4187,"_4097":37,"_4098":37,"_4129":4188,"_4131":4189,"_4133":527,"_4134":4190},"chr_0032_lizhiyan_13","chr_0032_lizhiyan_introduce_01","应龙特勤队行动队长，诀，向终末地报到……那么，命令是什么？我的指挥官。","干员报到",{"_4053":16,"_15":4192,"_4097":37,"_4098":37,"_4129":4193,"_4131":4194,"_4133":566,"_4134":4195},"chr_0032_lizhiyan_14","chr_0032_lizhiyan_mono_switch_01","心如铸铁，行如剑锋。应龙的战法重在其势。","待命1",{"_4053":16,"_15":4197,"_4097":37,"_4098":37,"_4129":4198,"_4131":4199,"_4133":98,"_4134":4200},"chr_0032_lizhiyan_15","chr_0032_lizhiyan_mono_switch_02","我是一柄利剑，随你所想，如你所愿。","待命2",{"_4053":16,"_15":4202,"_4097":37,"_4098":37,"_4129":4203,"_4131":4204,"_4133":872,"_4134":4205},"chr_0032_lizhiyan_21","chr_0032_lizhiyan_sim_assign_work_01","应龙特勤队不会挑选工作，我会完成一切交给我的任务。","进驻设施",{"_4053":16,"_15":4207,"_4097":37,"_4098":37,"_4129":4208,"_4131":4209,"_4133":911,"_4134":4210},"chr_0032_lizhiyan_22","chr_0032_lizhiyan_sim_hello_lower_01","终于有空了吗？管理员。","打招呼1",{"_4053":16,"_15":4212,"_4097":64,"_4098":4114,"_4129":4213,"_4131":4214,"_4133":951,"_4134":4215},"chr_0032_lizhiyan_23","chr_0032_lizhiyan_sim_hello_max_01","远远地就看到你了，有什么新情报吗？","打招呼2",{"_4053":16,"_15":4217,"_4097":37,"_4098":37,"_4129":4218,"_4131":4219,"_4133":989,"_4134":4220},"chr_0032_lizhiyan_24","chr_0032_lizhiyan_sim_talk_lv01_01","我过去总以为代理人不喜欢我。但自北部禁区回来后，她对我亲切了不少。我隐隐有些明白这其中的原因……过去的我，在她看来应该是个十分无趣的人吧。如果有机会在帝江号上遇到……祀小姐，我想当面向她道声谢。","帝江号闲聊1",{"_4053":16,"_15":4222,"_4097":64,"_4098":4114,"_4129":4223,"_4131":4224,"_4133":62,"_4134":4225},"chr_0032_lizhiyan_25","chr_0032_lizhiyan_sim_talk_lv02_01","荒芜的沙海，极北的雪原，站在帝江号上，我能更清晰地看到那些仍需要援助的绝境。甚大裂隙不再是我的终点……我想要解放每一寸被裂隙所困的土地。","帝江号闲聊2",{"_4053":16,"_15":4227,"_4097":64,"_4098":4114,"_4129":4228,"_4131":4229,"_4133":1067,"_4134":4230},"chr_0032_lizhiyan_26","chr_0032_lizhiyan_sim_talk_lv02_02","我见惯了武陵的山，看惯了武陵的水，吃惯了武陵各式各样的菜肴。现在的我需要适应很多新事物，面对很多以前从未设想过的麻烦。是你带我离开了那个深埋地下的小镇……对我来说，那仿佛是一次重生。","帝江号闲聊3",{"_4053":16,"_15":4232,"_4097":64,"_4098":4125,"_4129":4233,"_4131":4234,"_4133":1107,"_4134":4235},"chr_0032_lizhiyan_27","chr_0032_lizhiyan_sim_talk_max_01","我总是会做噩梦，但在帝江号的第一个夜晚，我闭上眼，那些哀嚎和训诫都不存在了。我梦见了空空荡荡的自己，然后有个声音告诉我，我是带着希望……咳，我说多了。","帝江号闲聊4",{"_4053":16,"_15":4237,"_4097":64,"_4098":4125,"_4129":4238,"_4131":4239,"_4133":1146,"_4134":4240},"chr_0032_lizhiyan_28","chr_0032_lizhiyan_sim_talk_max_02","这里能看到塔卫二上的那些极光——和北部禁区同样的极光。炫目的背后是血淋淋的伤痕……我不会再给裂隙任何伤害这片大地的机会。","帝江号闲聊5",{"_4053":16,"_15":4242,"_4097":64,"_4098":4125,"_4129":4243,"_4131":4244,"_4133":1186,"_4134":4245},"chr_0032_lizhiyan_29","chr_0032_lizhiyan_sim_talk_max_03","终末地有来自各方的干员，不乏强大的战士，但更可贵的是普通人愿意为他人奉献的决心和善意。所谓跂而望矣，不如登高之博见……能来到这里令我备受鼓舞，管理员。","帝江号闲聊6",{"_4053":16,"_15":4247,"_4097":37,"_4098":37,"_4129":4248,"_4131":4249,"_4133":56,"_4134":4250},"chr_0032_lizhiyan_30","chr_0032_lizhiyan_sim_gift_give_01","这是一些特产，也不算特意准备的，只是……嗯，不小心带得有点多了。","赠送礼物",{"_4053":16,"_15":4252,"_4097":37,"_4098":37,"_4129":4253,"_4131":4254,"_4133":1264,"_4134":4255},"chr_0032_lizhiyan_31","chr_0032_lizhiyan_sim_gift_recv_01","谢谢，我会准备好回礼的。不过，我……不是很懂怎么挑选礼物，就别太过期待了。","接收礼物",{"_4053":16,"_15":4257,"_4097":37,"_4098":37,"_4129":4258,"_4131":4259,"_4133":47,"_4134":4260},"chr_0032_lizhiyan_41","chr_0032_lizhiyan_mono_self_line01","这里什么都好，就是感觉……缺了一些机灵的小家伙……噪雷，她是在我度过日复一日的艰苦训练时，陪伴我的朋友。她从一只小小的咆兽长成了可靠的战友……虽然我和她共处的时间不算长，但有时候还是会想起她……还有武陵的蟠兽，也很讨喜……帝江号能养宠物吗？我会以军事要求培训它们的。","信赖对话1",{"_4053":16,"_15":4262,"_4097":64,"_4098":4114,"_4129":4263,"_4131":4264,"_4133":50,"_4134":4265},"chr_0032_lizhiyan_42","chr_0032_lizhiyan_mono_self_line02","峰和言，二人各有千秋。论指挥，峰更胜一筹；论战斗，言天赋异禀。他们二人可以互补长短，总有一天，他们其中一人可以接过队长一职……你问怎么突然聊起这个？嗯……就是看着陈千语那个模样，我会考虑自己是否有更广阔的道路可以走……只、只是想想而已。","信赖对话2",{"_4053":16,"_15":4267,"_4097":64,"_4098":4114,"_4129":4268,"_4131":4269,"_4133":233,"_4134":4270},"chr_0032_lizhiyan_43","chr_0032_lizhiyan_mono_self_line03","嗯？真巧啊，管理员……我喜欢一个人度过休息的时间。安静的空间能让我想到很多事情。故乡的人，谈剑堂的木人，蘸糖粉的米糕……但这些事过于美好，会让人迟钝，懈怠，沉溺其中……我不想让其他人看见这副样子。至于管理员你嘛……仔细一想，这份懈怠也算是拜你所赐，我们就共享一下偷闲的时光吧。","信赖对话3",{"_4053":16,"_15":4272,"_4097":64,"_4098":4125,"_4129":4273,"_4131":4274,"_4133":1801,"_4134":4275},"chr_0032_lizhiyan_44","chr_0032_lizhiyan_mono_self_line04","小的时候，母亲会用各式各样的发绳为我绑辫子。但我那时并不喜欢扎头发，每次回家都会弄得满身灰尘，头发也散得不像样。父亲会用树枝教我天师阵法，哪怕我根本看不懂，我俩也能玩到深夜，在月色下数梨花，直到被母亲发现……真奇怪，童年的回忆明明已经所剩无几，我记得的，却只有这些小事。","信赖对话4",{"_4053":16,"_15":4277,"_4097":64,"_4098":4125,"_4129":4278,"_4131":4279,"_4133":1841,"_4134":4280},"chr_0032_lizhiyan_45","chr_0032_lizhiyan_mono_self_line05","可以……请你替我绑一下头发吗？你知道用哪一根发绳的。我想读完这本书。在应龙关，书籍资料是为数不多的消遣方式……上次拜托人替自己绑头发是什么时候呢……已经记不清了。我考虑过剪短头发，最终还是没忍下心。嗯……谢谢，你绑得很好……有观察过我绑发绳的方式吗？嗯？你怎么这副表情？","信赖对话5",{"_4053":16,"_15":4282,"_4097":37,"_4098":37,"_4129":4283,"_4131":4284,"_4133":271,"_4134":4285},"chr_0032_lizhiyan_46","chr_0032_lizhiyan_mono_chat_line01","我不太懂其他人喜欢的……潮流？我没时间去想那些。但……庄天师也说过我应该多考虑下自己的事，例如寻找一些爱好。爱好……训练肯定不能算作爱好。也许我应该去找潘叔学一门手艺。但我可没法像陈千语那样，整天乐乐呵呵，像她这样的人太少了。培养一门爱好，这也是新的课题。","交谈1",{"_4053":16,"_15":4287,"_4097":37,"_4098":37,"_4129":4288,"_4131":4289,"_4133":1919,"_4134":4290},"chr_0032_lizhiyan_47","chr_0032_lizhiyan_mono_chat_line02","即便不在特勤队中，我还是会按应龙的标准保持一定强度的训练，以确保在遇到紧急任务时能够提供支援。特勤队还和我保持着定期联络，我相信他们，即使我不在，他们也能完成任务。","交谈2",{"_4053":16,"_15":4292,"_4097":37,"_4098":37,"_4129":4293,"_4131":4294,"_4133":72,"_4134":4295},"chr_0032_lizhiyan_48","chr_0032_lizhiyan_mono_chat_line03","陈千语又来找我切磋……过去，我和她的比试胜多负少，但她总是进步很快——快到一度让其他同僚感到沮丧。只可惜，那时我学得比她更快。只不过……出任队长之后，比起磨炼武艺，我花了更多精力在其他方面。现在不打打看，还真不知道结果……呵，我开始有些跃跃欲试了。","交谈3",{"_4053":16,"_15":4297,"_4097":37,"_4098":37,"_4129":4298,"_4131":4299,"_4133":60,"_4134":4300},"chr_0032_lizhiyan_49","chr_0032_lizhiyan_mono_chat_line04","庄天师送来了禁区的重建计划副本……她知道我对这件事很在意。但我还有特勤队的职责在身，无论身在武陵，还是终末地都是如此……能以武陵人的身份，封印裂隙，夺回家园，我已经知足了。我相信天师们能在集成工业系统的帮助下，让街道恢复往昔的模样。如果那时还有机会的话……我会回去看看的。","交谈4",{"_4053":16,"_15":4302,"_4097":37,"_4098":37,"_4129":4303,"_4131":4304,"_4133":76,"_4134":4305},"chr_0032_lizhiyan_50","chr_0032_lizhiyan_mono_chat_line05","管理员，我遇到了个小麻烦，有关那些在武陵很照顾我的叔姨。过去，我认为随时有可能牺牲的士兵不该和身边人来往过多，免得徒留遗憾，所以刻意疏远了他们，现在想来，还有点过意不去……那个，这种时候，一般要怎么补偿？拜托陈千语？我开不了这个口……管理员，你有空吗？","交谈5",{"_4053":16,"_15":4307,"_4097":37,"_4098":37,"_4129":4308,"_4131":4309,"_4133":78,"_4134":4310},"chr_0032_lizhiyan_51","chr_0032_lizhiyan_mono_about_line01","她离开后，我时不时会想到她，自那之后我再也没见过如她一般言行一致的人。她不适合特勤队，但……她会更加受人信赖。有人生存在阴影下，也需要有人站在阳光里。我从不后悔当年做出的每一个决定，即使重来一次也是一样。","话题：陈千语",{"_4053":16,"_15":4312,"_4097":37,"_4098":37,"_4129":4313,"_4131":4314,"_4133":80,"_4134":4315},"chr_0032_lizhiyan_52","chr_0032_lizhiyan_mono_about_line02","我没有试过其他样式的……队员们倒是推荐过一些。我很感谢，但我还是更喜欢自己的那条发绳。你知道它对于我来说有什么含义。不过……也许的确是该选一条新的……管理员，你觉得什么颜色，能够象征我们所见过的那些景象？","话题：发绳",{"_4053":16,"_15":4317,"_4097":37,"_4098":37,"_4129":4318,"_4131":4319,"_4133":82,"_4134":4320},"chr_0032_lizhiyan_53","chr_0032_lizhiyan_mono_about_line03","如果连超域吞噬人类的生命之后，在震耳欲聋的绝望和恐惧被记录的那个瞬间……依然能留下希望，能留下人与人的关怀，留下无私的奉献……那我们绝不会输给所谓的造物主。这便是我们存在的意义，这令我……十分感动。","话题：蚀影",{"_4053":16,"_15":4322,"_4097":37,"_4098":37,"_4129":4323,"_4131":4324,"_4133":84,"_4134":4325},"chr_0032_lizhiyan_54","chr_0032_lizhiyan_mono_about_line04","一个不可思议的敌人，带来了更多的谜团。我不会因为他的言语就质疑管理员和终末地，但不可否认，这样的存在对文明环带是个巨大的威胁。如果天使战争中那些尚未探明的敌人真的会卷土重来……请答应我，让我成为你摧毁敌人的第一把剑。","话题：阿莱克琉斯",{"_4053":16,"_15":4327,"_4097":37,"_4098":37,"_4129":4328,"_4131":4329,"_4133":86,"_4134":4330},"chr_0032_lizhiyan_55","chr_0032_lizhiyan_mono_about_line05","时间从未成为武陵人渴望重返故土的阻碍。这样的感情只会一点点地沉淀，催促着人们离家近一点，再近一点……禁区已经不再是禁区，却也不是曾经的模样了，很多事情已无法挽回。但……人总要看着明天而活，这是你教给我的，对吗？","话题：北部禁区",{"_4053":16,"_15":4332,"_4097":37,"_4098":37,"_4129":4333,"_4131":4334,"_4133":2266,"_4134":4335},"chr_0032_lizhiyan_56","chr_0032_lizhiyan_mono_about_line06","祀小姐确实是超凡脱俗的存在，这不是比喻。在很久以前，她向宏科院分享了力量，并促成了应龙特勤队的诞生。不过，她名义上并非特勤队的指挥人员……甚至不在宏科院领一官半职，仅仅是以“合作”的态度照拂着应龙特勤队。很多队员甚至直到退伍也没有见过祀小姐本尊。不过这次行动，她倒是格外积极……","话题：祀",{"_4053":16,"_15":4337,"_4097":37,"_4098":37,"_4129":4338,"_4131":4339,"_4133":578,"_4134":4340},"chr_0032_lizhiyan_71","chr_0032_lizhiyan_explore_point_common_01","计划之外的物资补充？需要先检验安全性。","发现资源1",{"_4053":16,"_15":4342,"_4097":37,"_4098":37,"_4129":4343,"_4131":4344,"_4133":2923,"_4134":4345},"chr_0032_lizhiyan_72","chr_0032_lizhiyan_explore_point_valub_01","目标方位存在战略物资，请下达指示。","发现资源2",{"_4053":16,"_15":4347,"_4097":37,"_4098":37,"_4129":4348,"_4131":4349,"_4133":2963,"_4134":4350},"chr_0032_lizhiyan_73","chr_0032_lizhiyan_explore_find_locked_01","前方是未知作战区域。","发现未探索区域",{"_4053":16,"_15":4352,"_4097":37,"_4098":37,"_4129":4353,"_4131":4354,"_4133":617,"_4134":4355},"chr_0032_lizhiyan_74","chr_0032_lizhiyan_explore_find_danger_01","发现危险敌人，保持观察，请求作战许可。","发现强敌",{"_4053":16,"_15":4357,"_4097":37,"_4098":37,"_4129":4358,"_4131":4359,"_4133":3041,"_4134":4360},"chr_0032_lizhiyan_75","chr_0032_lizhiyan_interact_mine_valub_01","回收矿产，是当前最优先任务。","采集矿物1",{"_4053":16,"_15":4362,"_4097":37,"_4098":37,"_4129":4363,"_4131":4364,"_4133":3080,"_4134":4365},"chr_0032_lizhiyan_76","chr_0032_lizhiyan_interact_mine_valub_echo2_01","这也是后勤保障的一环。","采集矿物2",{"_4053":16,"_15":4367,"_4097":37,"_4098":37,"_4129":4368,"_4131":4369,"_4133":656,"_4134":4370},"chr_0032_lizhiyan_77","chr_0032_lizhiyan_interact_treasure_valub_01",