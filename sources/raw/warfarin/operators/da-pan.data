8123,"_8126":8127,"_8131":8132,"_8135":8136,"_8141":8142,"_8145":8146,"_8150":8151,"_8155":8156,"_7598":8160,"_8164":8165,"_8167":8168,"_7618":8172,"_8176":8177,"_8181":8182,"_8186":8187,"_8191":8192,"_8195":8196,"_8200":8201,"_7418":8206,"_7457":8210,"_8215":8216,"_8220":8221,"_8225":8226,"_7644":8230,"_8235":8236,"_8238":8239,"_8242":8243,"_8246":8247,"_8251":8252,"_8256":8257,"_8260":8261,"_8265":8266,"_7684":8270,"_8274":8275,"_8279":8280,"_8284":8285,"_8289":8290,"_8293":8294,"_8297":8298,"_8302":8303,"_8307":8308,"_8311":8312,"_8317":8318,"_8321":8322,"_8325":8326,"_8330":8331,"_8334":8335,"_8338":8339,"_8342":8343,"_8348":8349,"_8353":8354,"_8358":8359,"_8363":8364,"_8368":8369,"_8373":8374,"_8378":8379,"_8383":8384,"_8388":8389,"_8393":8394,"_8398":8399,"_8403":8404,"_8408":8409,"_8413":8414},"adv.electricFence",{"_4629":7904,"_7905":4060,"_15":7902,"_7906":4060,"_19":7907,"_7908":7474},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4629":7911,"_7905":7912,"_15":7909,"_7906":4060,"_19":7913,"_7908":7527},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4629":7915,"_7905":7916,"_15":7591,"_7906":7917,"_19":7918,"_7908":7656},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4629":7921,"_7905":4060,"_15":7919,"_7906":4060,"_19":7922,"_7908":7474},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4629":7925,"_7905":7926,"_15":7923,"_7906":4060,"_19":7927,"_7908":7474},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4629":7930,"_7905":4060,"_15":7928,"_7906":4060,"_19":7931,"_7908":7474},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4629":7934,"_7905":7935,"_15":7932,"_7906":4060,"_19":7936,"_7908":7568},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4629":7939,"_7905":4060,"_15":7937,"_7906":4060,"_19":7940,"_7908":7474},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4629":7943,"_7905":7944,"_15":7941,"_7906":4060,"_19":7945,"_7908":7474},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4629":7948,"_7905":4060,"_15":7946,"_7906":4060,"_19":7949,"_7908":4060},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4629":7952,"_7905":7953,"_15":7950,"_7906":4060,"_19":7954,"_7908":7527},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4629":7956,"_7905":7957,"_15":7406,"_7906":7958,"_19":7959,"_7908":7656},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4629":7962,"_7905":4060,"_15":7960,"_7906":4060,"_19":7963,"_7908":7474},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4629":7966,"_7905":7967,"_15":7964,"_7906":4060,"_19":7968,"_7908":7474},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4629":7971,"_7905":7972,"_15":7969,"_7906":4060,"_19":7973,"_7908":7474},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4629":7976,"_7905":4060,"_15":7974,"_7906":4060,"_19":7977,"_7908":7501},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4629":7980,"_7905":7981,"_15":7978,"_7906":4060,"_19":7982,"_7908":7474},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4629":7985,"_7905":4060,"_15":7983,"_7906":4060,"_19":7986,"_7908":7501},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4629":7988,"_7905":7989,"_15":7489,"_7906":7990,"_19":7991,"_7908":7568},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4629":7994,"_7905":7989,"_15":7992,"_7906":4060,"_19":7995,"_7908":7568},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4629":7998,"_7905":7999,"_15":7996,"_7906":8000,"_19":8001,"_7908":7501},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4629":8004,"_7905":4060,"_15":8002,"_7906":4060,"_19":8005,"_7908":7501},"持续时间内，受影响的目标暂停行动。","定身",{"_4629":8007,"_7905":8008,"_15":7495,"_7906":8009,"_19":8010,"_7908":7680},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4629":8013,"_7905":8008,"_15":8011,"_7906":4060,"_19":8014,"_7908":7680},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4629":8017,"_7905":4060,"_15":8015,"_7906":8018,"_19":8019,"_7908":4060},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4629":8021,"_7905":8022,"_15":7513,"_7906":8023,"_19":8024,"_7908":7630},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4629":8027,"_7905":8022,"_15":8025,"_7906":4060,"_19":8028,"_7908":7630},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4629":8031,"_7905":8032,"_15":8029,"_7906":4060,"_19":8033,"_7908":7474},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4629":8035,"_7905":8036,"_15":7520,"_7906":8037,"_19":8038,"_7908":7656},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4629":8041,"_7905":8042,"_15":8039,"_7906":8043,"_19":8044,"_7908":7501},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4629":8047,"_7905":8048,"_15":8045,"_7906":4060,"_19":8049,"_7908":7501},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4629":8051,"_7905":8052,"_15":7544,"_7906":8053,"_19":8054,"_7908":7527},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4629":8057,"_7905":4060,"_15":8055,"_7906":8058,"_19":8059,"_7908":7527},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4629":8062,"_7905":8063,"_15":8060,"_7906":4060,"_19":8064,"_7908":7474},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4629":8067,"_7905":8068,"_15":8065,"_7906":4060,"_19":8069,"_7908":7474},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4629":8072,"_7905":8073,"_15":8070,"_7906":4060,"_19":8074,"_7908":7527},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4629":8076,"_7905":7912,"_15":7551,"_7906":8077,"_19":8078,"_7908":7527},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4629":8081,"_7905":4060,"_15":8079,"_7906":8082,"_19":8083,"_7908":7501},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4629":8086,"_7905":8087,"_15":8084,"_7906":4060,"_19":8088,"_7908":7474},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4629":8091,"_7905":4060,"_15":8089,"_7906":4060,"_19":8092,"_7908":4060},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4629":8095,"_7905":8096,"_15":8093,"_7906":8097,"_19":8098,"_7908":7501},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4629":8101,"_7905":8102,"_15":8099,"_7906":4060,"_19":8103,"_7908":7474},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4629":8106,"_7905":4060,"_15":8104,"_7906":8107,"_19":8108,"_7908":7568},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4629":8110,"_7905":8111,"_15":7581,"_7906":8112,"_19":8113,"_7908":7568},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4629":8116,"_7905":8117,"_15":8114,"_7906":4060,"_19":8118,"_7908":7474},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4629":7994,"_7905":8111,"_15":8119,"_7906":4060,"_19":8121,"_7908":7568},"干员受到灼热附着","sys.tacticalItem",{"_4629":8124,"_7905":4060,"_15":8122,"_7906":4060,"_19":8125,"_7908":7474},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4629":8128,"_7905":8129,"_15":8126,"_7906":4060,"_19":8130,"_7908":7568},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4629":8013,"_7905":8133,"_15":8131,"_7906":4060,"_19":8134,"_7908":7680},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4629":8137,"_7905":8138,"_15":8135,"_7906":8139,"_19":8140,"_7908":7501},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4629":8143,"_7905":4060,"_15":8141,"_7906":4060,"_19":8144,"_7908":7501},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4629":8147,"_7905":8148,"_15":8145,"_7906":4060,"_19":8149,"_7908":7656},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4629":8152,"_7905":8153,"_15":8150,"_7906":4060,"_19":8154,"_7908":7680},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4629":8157,"_7905":8158,"_15":8155,"_7906":4060,"_19":8159,"_7908":7501},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4629":8161,"_7905":8162,"_15":7598,"_7906":8053,"_19":8163,"_7908":7527},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4629":7911,"_7905":8162,"_15":8164,"_7906":4060,"_19":8166,"_7908":7527},"干员受到冻结","ba.naturalvul",{"_4629":8169,"_7905":8170,"_15":8167,"_7906":4060,"_19":8171,"_7908":7630},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4629":7956,"_7905":8173,"_15":7618,"_7906":8174,"_19":8175,"_7908":7656},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4629":8178,"_7905":8179,"_15":8176,"_7906":4060,"_19":8180,"_7908":7474},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4629":8183,"_7905":8184,"_15":8181,"_7906":4060,"_19":8185,"_7908":7474},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4629":8188,"_7905":8189,"_15":8186,"_7906":4060,"_19":8190,"_7908":7474},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4629":8193,"_7905":4060,"_15":8191,"_7906":4060,"_19":8194,"_7908":7474},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4629":8197,"_7905":4060,"_15":8195,"_7906":8198,"_19":8199,"_7908":4060},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4629":8202,"_7905":8203,"_15":8200,"_7906":8204,"_19":8205,"_7908":7501},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4629":8207,"_7905":4060,"_15":7418,"_7906":8208,"_19":8209,"_7908":7630},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4629":8211,"_7905":8212,"_15":7457,"_7906":8213,"_19":8214,"_7908":7656},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4629":8217,"_7905":8218,"_15":8215,"_7906":4060,"_19":8219,"_7908":7474},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4629":8222,"_7905":8223,"_15":8220,"_7906":4060,"_19":8224,"_7908":7630},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4629":8227,"_7905":8228,"_15":8225,"_7906":4060,"_19":8229,"_7908":7474},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4629":8231,"_7905":8232,"_15":7644,"_7906":8233,"_19":8234,"_7908":7630},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4629":8027,"_7905":8232,"_15":8235,"_7906":4060,"_19":8237,"_7908":7630},"干员受到自然附着","ba.originium",{"_4629":8240,"_7905":4060,"_15":8238,"_7906":4060,"_19":8241,"_7908":7501},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4629":8244,"_7905":4060,"_15":8242,"_7906":4060,"_19":8245,"_7908":7656},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4629":8248,"_7905":8249,"_15":8246,"_7906":4060,"_19":8250,"_7908":7656},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4629":8253,"_7905":4060,"_15":8251,"_7906":8254,"_19":8255,"_7908":7664},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4629":8258,"_7905":4060,"_15":8256,"_7906":4060,"_19":8259,"_7908":7474},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4629":8262,"_7905":4060,"_15":8260,"_7906":8263,"_19":8264,"_7908":7680},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4629":8267,"_7905":8268,"_15":8265,"_7906":4060,"_19":8269,"_7908":7474},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4629":8271,"_7905":8133,"_15":7684,"_7906":8272,"_19":8273,"_7908":7680},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4629":8276,"_7905":8277,"_15":8274,"_7906":4060,"_19":8278,"_7908":7680},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4629":8281,"_7905":4060,"_15":8279,"_7906":8282,"_19":8283,"_7908":7501},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4629":8286,"_7905":4060,"_15":8284,"_7906":8287,"_19":8288,"_7908":4060},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4629":8291,"_7905":4060,"_15":8289,"_7906":4060,"_19":8292,"_7908":7474},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4629":8295,"_7905":4060,"_15":8293,"_7906":4060,"_19":8296,"_7908":7501},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4629":8299,"_7905":8300,"_15":8297,"_7906":4060,"_19":8301,"_7908":7474},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4629":8304,"_7905":4060,"_15":8302,"_7906":8305,"_19":8306,"_7908":7501},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4629":8309,"_7905":4060,"_15":8307,"_7906":4060,"_19":8310,"_7908":7474},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4629":8313,"_7905":8314,"_15":8311,"_7906":8315,"_19":8316,"_7908":7501},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4629":8319,"_7905":4060,"_15":8317,"_7906":4060,"_19":8320,"_7908":7501},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4629":8323,"_7905":4060,"_15":8321,"_7906":4060,"_19":8324,"_7908":7501},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4629":8327,"_7905":8328,"_15":8325,"_7906":4060,"_19":8329,"_7908":7474},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4629":8332,"_7905":4060,"_15":8330,"_7906":4060,"_19":8333,"_7908":7501},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4629":8336,"_7905":4060,"_15":8334,"_7906":4060,"_19":8337,"_7908":7501},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4629":8340,"_7905":4060,"_15":8338,"_7906":4060,"_19":8341,"_7908":7501},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4629":8344,"_7905":8345,"_15":8342,"_7906":8346,"_19":8347,"_7908":7501},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4629":8350,"_7905":8351,"_15":8348,"_7906":4060,"_19":8352,"_7908":7474},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4629":8355,"_7905":8356,"_15":8353,"_7906":4060,"_19":8357,"_7908":7474},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4629":8360,"_7905":8361,"_15":8358,"_7906":4060,"_19":8362,"_7908":7474},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4629":8365,"_7905":8366,"_15":8363,"_7906":4060,"_19":8367,"_7908":7474},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4629":8370,"_7905":8371,"_15":8368,"_7906":4060,"_19":8372,"_7908":7474},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4629":8375,"_7905":8376,"_15":8373,"_7906":4060,"_19":8377,"_7908":7474},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4629":8380,"_7905":8381,"_15":8378,"_7906":4060,"_19":8382,"_7908":7474},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4629":8385,"_7905":8386,"_15":8383,"_7906":4060,"_19":8387,"_7908":7474},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4629":8390,"_7905":8391,"_15":8388,"_7906":4060,"_19":8392,"_7908":7474},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4629":8395,"_7905":8396,"_15":8393,"_7906":4060,"_19":8397,"_7908":7474},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4629":8400,"_7905":8401,"_15":8398,"_7906":4060,"_19":8402,"_7908":7474},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4629":8405,"_7905":8406,"_15":8403,"_7906":4060,"_19":8407,"_7908":7474},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4629":8410,"_7905":8411,"_15":8408,"_7906":4060,"_19":8412,"_7908":7474},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4629":8415,"_7905":8416,"_15":8413,"_7906":4060,"_19":8417,"_7908":7474},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7110":8420,"_6630":8429,"_6754":8431,"_6756":8433,"_6758":8435,"_6760":8437,"_6762":8439,"_6764":8441,"_6767":8443,"_6770":8444,"_5976":8446,"_6775":8448,"_6778":8449,"_6781":8450,"_6783":8452,"_5970":8453,"_6788":8454,"_6791":8455,"_6795":8457,"_6798":8458,"_6802":8459,"_6806":8460,"_6809":8461,"_6813":8462,"_6817":8463,"_6820":8464,"_6824":8465,"_6828":8467,"_6832":8468,"_6836":8470,"_6840":8472,"_6844":8474,"_6848":8475,"_6852":8477,"_6856":8479,"_6860":8480,"_6864":8482,"_6868":8484,"_6872":8486,"_6876":8488,"_6880":8491,"_6884":8494,"_6888":8497,"_6892":8500,"_6896":8501,"_6900":8503,"_6904":8504,"_6908":8505,"_6912":8507,"_6916":8509,"_6920":8510,"_6924":8512,"_6928":8514,"_6932":8516,"_6936":8518,"_6940":8520,"_6944":8522,"_6948":8524,"_6951":8526,"_6955":8528,"_6959":8530,"_6963":8531,"_6967":8533,"_6971":8534,"_6975":8535,"_6979":8536,"_6983":8537,"_6987":8538,"_6991":8539,"_6995":8540,"_6999":8541,"_7003":8542,"_7007":8543,"_7011":8544,"_7015":8545,"_7019":8546,"_7023":8547,"_7027":8548,"_7031":8549,"_7035":8550,"_7039":8551,"_7043":8552,"_7046":8553,"_7050":8554,"_7054":8555,"_7058":8556,"_7062":8557,"_7066":8558,"_7070":8560,"_7074":8561,"_7078":8562,"_8563":8564,"_8565":8566,"_8568":8569,"_8570":8571,"_8572":8573,"_8574":8575,"_8576":8577,"_8578":8579,"_8580":8581,"_8582":8583,"_8584":8585,"_8586":8587,"_8589":8590,"_8592":8593,"_8594":8595,"_8597":8598,"_8600":8601},{"_8421":37,"_8422":4060,"_8423":39,"_8424":5091,"_8425":5091,"_8426":4060,"_8427":37,"_8428":37},"attributeType","bigIconName","defaultValue","hasMaxValue","hasMinValue","iconName","maxValue","minValue",{"_8421":39,"_8422":4060,"_8423":39,"_8424":5091,"_8425":4078,"_8426":8430,"_8427":37,"_8428":37},"icon_attribute_maxHp",{"_8421":55,"_8422":4060,"_8423":409,"_8424":5091,"_8425":5091,"_8426":8432,"_8427":37,"_8