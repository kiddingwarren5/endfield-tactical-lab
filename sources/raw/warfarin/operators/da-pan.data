36":55,"_38":3907},321,{"_36":58,"_38":37},{"_36":60,"_38":3910},1.48469387755102,{"_36":62,"_38":3912},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3932,"_101":64},{"_33":3933},[3934,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":963},{"_36":41,"_38":3936},187.00168314748632,{"_36":44,"_38":3938},103.8144329896907,{"_36":47,"_38":3940},101.63938565116767,{"_36":50,"_38":3942},109.38994319377261,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},324,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2013},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3970,"_101":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},188.6967178624032,{"_36":44,"_38":3977},104.79381443298968,{"_36":47,"_38":3979},102.5928887018725,{"_36":50,"_38":3981},110.42074479276272,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},327,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4010,"_101":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},190.39175257732012,{"_36":44,"_38":4017},105.77319587628864,{"_36":47,"_38":4019},103.5463917525773,{"_36":50,"_38":4021},111.45154639175284,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},330,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2051},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_07","tag_03","tag_01","charId","charIllustInitPos",{"_4056":117,"_4057":4058},"x","y",-130,"charPassiveUIPrefabName","","charTypeId","Physical","cvName",{"_4065":4066,"_4067":4068,"_4069":4070,"_4071":4072,"_4053":16},"ChiCVName","苏翼","EngCVName","许棕哲","JapCVName","小山力也","KorCVName","黄椙暎","defaultWeaponId","wpn_claym_0010","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Da Pan","mainAttrType","phoneticName","profession","profileRecord",[4086,4097,4102,4107,4112,4117],{"_4053":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0018_dapan_1","recordDesc","【代号】大潘\n【性别】男\n【身份认证】宏山科学院\n【生日】5月19日\n【种族】乌萨斯\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：标准\n战术规划：普通\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0018_dapan_2","干员大潘，本名潘远，出身宏山科学院，自称游历四方的厨师兼游商。经干员陈千语介绍，宏山科学院送函认证，与终末地工业合作，以个人身份加入特种技术部门。尊重干员个人意愿，额外向他开放食堂的部分权限。\n\n大潘提供的过往履历非常杂乱。已确认真实可靠的经历有“辣么大”火锅店店长、宏山科学院天师、电工、木工、钳工，在《合意拳·再临》中客串过两次背景板等。\n暂时无法考据的部分主要有两条。首先是他自述在塞梦珂当过一段时间的出租车司机，而我们并未查询到大潘在该城市的相关营运许可证。在我指出这点后，他的嘴角咧开超过七十度，并大力拍打起我的机械面板。另一条则是为帮朋友“撑场子”，他在菈梵朵玛兼职做了三天观赏驮兽替身。在我意识到自己被他牵着问了太多黑车司机与观赏驮兽的事情，反倒忽略了最应当详细了解的天师经历时，我们已经攀谈了将近四小时。\n核实那段宏山科学院的经历时，大潘的神情展现出明显的惆怅和不悦，但很快，他恢复了笑容，用一个轻松的玩笑转移了话题——向我展示他与观赏驮兽们亲密无间的合影。我能看出他回避去谈与那几位天师间的龃龉，但这并不是减分项，他至今仍为科考站的事故耿耿于怀，恰恰能证明他的内心最深处依旧是那名秉承理念和操守的宏科院天师。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0018_dapan_3","《多变的潘叔》\n武夌（陵）城有一个多变的潘叔，他是我见过最热心肠的人。他长得黑白分明，眼睛像是葡萄，耳朵则是像两个大大的金元宝，带（戴）着墨镜特别帅。\n潘叔会变身，总是穿着各种各样的衣服，有时候是白色的大围裙，有时候是作业服，有时候会带（戴）着黄色的塑料帽子。潘叔有一间火锅店，说我们想家了就可以随时去吃，如果我们火锅吃腻了，他也会变着法子给我们做好吃的馒头、火暴（爆）腰花、松尾林（鳞）。最好吃的是醋留（溜）白菜跟回锅肉，希望能成为招牌菜。\n但潘叔也有不好心肠的时候，他会往我的饭盒里放辣交（椒）酱，跟我说是“魔法酱料”，我分给其他小朋友，大家的嘴巴都肿了。\n除了照顾小朋友外，潘叔也会特别热心帮助其他人。他总是帮城里的人修电表、接水管、砍竹子。因为潘叔特别好，总是帮助大家，大家也愿意帮他，但因为潘叔太厉害了，大家没什么能帮忙的，只能送水果跟点心……还有偷偷减兔（免）火锅店的租金。听说潘叔的家也在暴（爆）炸里没有了，所以他不得不花钱住在别人家里。\n——常客留下的泛黄作文\n\n有一次我问潘叔，为什么他工作这么多年却完全没存下钱来，他说都被吃掉了，我还笑话他嘴馋。后来才知道，原来是招待了那么多孩子……\n——陈千语\n\n人们经常会被他的热情与亲切感染，在初次见面的几分钟内就竹筒倒豆子，把自己的事讲给他听。但反过来，干员大潘并不太主动去聊自己的故事，直到现在依旧有许多人对他的印象只是“很热情、会做饭的宏科院天师”。沉痛的过往是一种信息负担，交深言浅是他特有的体贴，但把自己的事情憋在心中并非好事。\n我更担心的是他来到帝江号上后，很多人，尤其是管理员的体重在明显增长……\n——佩丽卡","CN_03","档案资料·一",{"_4053":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":3634},"chr_0018_dapan_4","《“先进科研工作者”奖项候选人推荐表》\n填写人：罗时乔\n\n综合“创新、影响、适应性”三个维度，我推荐将今年的“先进科研工作者”颁发给潘远天师。在过往工作中，他累计取得了十二项学术成果，并达成六项宏山科学院的可持续发展目标。纵观近十年的获奖人员名单，只有极少数能做出与他当前阶段相同的贡献，而且他还不到三十岁。\n虽然我是他的老师，但可以保证以上评价绝无任何偏颇之处。当潘远敲开我办公室的门，说想跟着我做项目时，我第一反应是拒绝。毕竟我对这位年轻人的印象并不算好。他会用正在燃烧的爆炸物打乒乓球，会在“冒辣果创意料理同好会”的电子海报上让几位德高望重的老天师跳踢踏舞，会用废材料做了台迷你高速战舰攻打地下冷库，搞得大楼一整个月都充斥着腐坏的鳞肉味……是，都不算什么，年轻人总是调皮的，宏科院鼓励所有探索行为，我年轻时也把自己送进过急诊室。\n有些孩子做恶作剧是为了引起其他人注意，另一些孩子这么做是因为他们对世界有着庞大的好奇心。潘远这孩子的情况又有些不同，他——太聪明了。我能看出他做这些事情时眼里的意兴阑珊。成为他的老师后，我更清晰意识到他做的这一切只是因为他能做，或者说他想证明即使是恶作剧，他也能轻轻松松地比其他人做得更好，整个宏科院里没有他的对手。\n遭到挫折，得到乐趣；没有挫折，就没有乐趣——没有乐趣能在学术道路上走多远？一名石匠不眠不休地雕琢一生，也只能留下寥寥作品。潘远是一块极其难啃的顽石，需要打磨才可以绽放光彩，但能让他跌倒，以此雕琢他的，只有比他硬度更高的石头。\n我说：“相比我而言，有几位在裂隙研究领域的天师更有学术建树，更适合做你的老师……”\n潘远说：“但我现在有一座必须要去攀爬的山，只有您的院管项目与其方向相符。”\n那瞬间，他眼神中除了迷茫与痛苦，还隐藏着一些小心翼翼的期盼。或许我对他的判断并不全对，也或许有什么改变了他。只要他怀着执念，我相信他会做出好的改变。\n\n若一定要问我有什么不把奖项颁给他的理由……除了有点冲动的脾气外，大概就是他在实验室炒菜怕别人偷吃，给放着炒米的罐子贴上“还原剂”的标签，害我的初号原型机报废了吧！","CN_04","档案资料·二",{"_4053":16,"_15":4113,"_4088":4114,"_4090":4115,"_4092":66,"_4093":4116,"_4095":64,"_4096":3634},"chr_0018_dapan_5","【一段葬礼上的致辞】\n那是个很普通的清晨，跟宏科院每日都要迎来的清晨一样。只是阳光照进办公室时，我的丈夫已经在睡梦中溘然长逝。\n他将一生都献给了宏山科学院——所以有段时间我非常憎恶它。每当我提着饭盒走入长廊，听着周遭那些脑中装着数不清典籍的天师不停争吵，我心里只有厌烦。无论他们究竟是想端上铁饭碗，创造些对改善环带境况没实际作用的废纸，去争夺一把名次更高的椅子，还是真的打算让所有人都吃饱，这些事对我来说都不重要。\n我无法理解为什么，为什么他们一定要让更多人活下去，却又可以对自己的生命满不在乎？就好像“活着”只是一条院规、一个抽象概念——就好像他们的思想、事业，乃至存在都只是这执念的一部分？\n…………\n许多年前，我在这处公墓亲手埋下了女儿的一件衣服，她是武陵科考站那初始的一百一十三人之一。\n……我跟丈夫有许多年没有说过话了。在我得知女儿生命体征停止的消息时，他正在与老天师们进行连续表决，三天以后才给我打了一个电话。我哭着问他为什么不能带回孩子们的遗体，他只说，没有办法。那时我恨不得能绑上一捆爆炸物，去跟我丈夫、跟老天师们同归于尽——直到……当时有两位非常年轻的天师提出了反对意见，我记得有庄管代，还有一名乌萨斯——他在宏科院大闹了一场，在那之后就递交辞函，离开了宏山。\n我以为在闹成那个样子后，这孩子并不会来参加葬礼，但在诸位来到这里之前我看见了他。他长大了，成熟了很多，并没有跟任何人说话，悄悄地来，又悄悄地走……只放下一瓶辣椒老妈。\n现在，我又亲手埋下了我的丈夫。我依旧憎恶这间吞噬了我全部家人的宏山科学院，但我知道，他……还有那个孩子，以及现在站在这里的，由我丈夫培养的小天师们，你们爱着它。\n至少在他离去的时候，有鲜花，还有他喜欢的拌饭酱。\n\n【修复的语音记录】\n“已经几十个小时了。很遗憾，甚大裂隙周遭已经没有任何生命反应。既然大家都没有意见，我们决定停止一切搜救行动——”\n“我有意见！我现在不想掰扯是谁提出的方案，为什么会实行成这样！可至少……至少无论生死，都要把人带回来吧？！我们怎么向遗属交代？！庄方宜，你别现在拉偏架——”\n“冷静点，让我说一句。黄老师……这次潘天师说的是对的。轻易放弃不符合宏科院的精神，无论是从集体还是个人角度，我都建议继续搜救。”\n“小庄，你跟潘天师意见一致居然是在这种场合……听着，我们是‘做不到’。你们作为天师，心里必须有杆秤，衡量活着的跟死了的哪边更重要。现在，坐下！”\n“那就想办法去做到啊！”\n“……潘远，不是每个人都是你。”\n“去你*炎国粗口*的。”","CN_05","档案资料·三",{"_4053":16,"_15":4118,"_4088":4119,"_4090":4120,"_4092":68,"_4093":4121,"_4095":64,"_4096":4122},"chr_0018_dapan_6","《息壤机械自动化控制系统在集成工业系统中的协作应用与效率优化研究》\n摘要：聚焦息壤机械自动化，讨论其在集成工业系统中协作应用的可能性与思路。本文剖析了跨专业、跨领域联合治理侵蚀的具体应用情形，并总结提升安全保障与协作效率的方法论，旨在……\n关键词：机械工程；终末地工业；裂隙；侵蚀；烹饪；食品安全；效率优化；\n…………\n参考文献：\n[1]终末地工业.关于集成工业系统的十年规划与远景建议\n[2]终末地工业.集成工业自动化思路的开源技术分享\n[3]终末地工业.源石回路应用技术综述\n[3]黄明征,罗时乔.息壤原型在侵蚀创伤修复中的实际应用\n…………\n致谢：一推开宿舍门，就能跟你年轻时引用文献的作者对话可是个不多见的事儿。虽然我是为人家解决了一些麻烦，但总体来说，人家给我的帮助多多了……\n\n“管理员，这篇论文……嗐，您别夸我，臊得慌。这些东西依旧是从您当年那些基础理论上生长出来的，谈不上什么突破，还差得远呢。”\n“……”\n“您说可笑不可笑，都四十来岁的人了，还惦记去爬最高的山，多幼稚……我要是跟宏科院的其他人说这事儿，说我潘远会自惭形秽，他们一准笑话死我！”\n“……”\n“山会越长越高，所以一辈子都爬不过？哎哟，我就欣赏您身上这种自信！可您越是这么说，我可就越想挑战了。对了，我最近看着集成工业系统，还真琢磨出来一个新的技术，连管理员您都没有写过的……”\n“……”\n“那肯定不是把您当对手啊，咱们这叫‘攀比着共同进步’！非要说的话，还是因为……集成工业系统真是好东西，我打心眼儿里佩服这技术。要是我们能再早点……要是我二十岁的时候就……”\n“……”\n“您说得对。不晚……！”","CN_06","档案资料·四",1500,"profileVoice",[4125,4133,4137,4141,4145,4149,4153,4158,4163,4168,4173,4178,4183,4188,4193,4198,4203,4208,4213,4218,4223,4228,4233,4238,4243,4248,4253,4258,4263,4268,4273,4278,4283,4288,4293,4298,4303,4308,4313,4318,4323,4328,4333,4338,4343,4348,4353,4358,4363,4368,4373,4378,4383,4388,4393,4398,4403,4408,4413,4418,4423,4428,4433,4438,4443,4448,4453,4458,4463,4468,4473,4478,4483,4488,4493,4498,4503,4508,4513,4518,4523,4528],{"_4053":16,"_15":4087,"_4095":37,"_4096":37,"_4126":4127,"_4128":4129,"_4130":39,"_4131":4132},"voId","chr_0018_dapan_chrbark_squad_01","voiceDesc","哟，管理员，家伙什儿都备齐了？","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4098,"_4095":37,"_4096":37,"_4126":4134,"_4128":4135,"_4130":55,"_4131":4136},"chr_0018_dapan_chrbark_squad_02","可不能糟践粮食——嘿，您怎么来了？","行动准备2",{"_4053":16,"_15":4103,"_4095":37,"_4096":37,"_4126":4138,"_4128":4139,"_4130":58,"_4131":4140},"chr_0018_dapan_chrbark_join_01","还是这儿舒坦。要我露一手？","编入队伍1",{"_4053":16,"_15":4108,"_4095":37,"_4096":37,"_4126":4142,"_4128":4143,"_4130":64,"_4131":4144},"chr_0018_dapan_chrbark_join_02","您办事，我放心。","编入队伍2",{"_4053":16,"_15":4113,"_4095":37,"_4096":37,"_4126":4146,"_4128":4147,"_4130":66,"_4131":4148},"chr_0018_dapan_chrbark_weap_01","嗬，这家伙好使，您张罗这费心了！","更换武器",{"_4053":16,"_15":4118,"_4095":37,"_4096":37,"_4126":4150,"_4128":4151,"_4130":68,"_4131":4152},"chr_0018_dapan_chrbark_gear_01","很久不试装备了。嚯，紧了点，不过瞅着还不赖。您觉着呢？","更换装备",{"_4053":16,"_15":4154,"_4095":37,"_4096":37,"_4126":4155,"_4128":4156,"_4130":70,"_4131":4157},"chr_0018_dapan_7","chr_0018_dapan_chrup_skill_01","不会的菜式就得多练！这可不是为了出风头，我掌勺就图个做得敞亮，吃得爽心！","激活天赋阵列",{"_4053":16,"_15":4159,"_4095":37,"_4096":37,"_4126":4160,"_4128":4161,"_4130":88,"_4131":4162},"chr_0018_dapan_8","chr_0018_dapan_chrup_level_01","活到老，学到老，关键腿脚还得保养好！","观看作战记录",{"_4053":16,"_15":4164,"_4095":55,"_4096":39,"_4126":4165,"_4128":4166,"_4130":90,"_4131":4167},"chr_0018_dapan_9","chr_0018_dapan_chrup_promt01_01","鄙人——能力有限，水平一般，感谢赏识。以茶代酒，先干为敬！","精英化晋升1",{"_4053":16,"_15":4169,"_4095":55,"_4096":55,"_4126":4170,"_4128":4171,"_4130":409,"_4131":4172},"chr_0018_dapan_10","chr_0018_dapan_chrup_promt02_01","我自认不算什么大拿，但好在办事从不怯勺，这晋升的名头就先受着了。有事您吩咐，我绝不撂挑子拿您开涮！","精英化晋升2",{"_4053":16,"_15":4174,"_4095":55,"_4096":58,"_4126":4175,"_4128":4176,"_4130":100,"_4131":4177},"chr_0018_dapan_11","chr_0018_dapan_chrup_promt03_01","劳您担待了。不过眼瞅着我武陵的铺子又得多关些日子——等您得闲了，咱们回去摆上一大桌，让您尝尝鲜，也顺便拜托乡亲们继续帮我照看铺子。","精英化晋升3",{"_4053":16,"_15":4179,"_4095":55,"_4096":64,"_4126":4180,"_4128":4181,"_4130":95,"_4131":4182},"chr_0018_dapan_12","chr_0018_dapan_chrup_promt04_01","前阵子回宏山，老师又变着方儿地撺掇我回她的院管项目，最后还得搬出终末地的名头她才消停——甭管您怎么看，但能在帝江号上混着这个差事，我与有荣焉——您咋还脸红上了呢？","精英化晋升4",{"_4053":16,"_15":4184,"_4095":37,"_4096":37,"_4126":4185,"_4128":4186,"_4130":526,"_4131":4187},"chr_0018_dapan_13","chr_0018_dapan_introduce_01","欸，又见面了，管理员。工程上有用得上我的地方尽管言语，保管帮您解决麻烦！要是您愿意招呼我上伙房露一手，那我就更开心了！","干员报到",{"_4053":16,"_15":4189,"_4095":37,"_4096":37,"_4126":4190,"_4128":4191,"_4130":565,"_4131":4192},"chr_0018_dapan_14","chr_0018_dapan_mono_switch_01","您这是要上哪儿？","待命1",{"_4053":16,"_15":4194,"_4095":37,"_4096":37,"_4126":4195,"_4128":4196,"_4130":97,"_4131":4197},"chr_0018_dapan_15","chr_0018_dapan_mono_switch_02","有活儿？我替您支着。","待命2",{"_4053":16,"_15":4199,"_4095":37,"_4096":37,"_4126":4200,"_4128":4201,"_4130":643,"_4131":4202},"chr_0018_dapan_16","chr_0018_dapan_sim_assign_work_01","您先歇着，我换套作业服就过去。","进驻设施",{"_4053":16,"_15":4204,"_4095":37,"_4096":37,"_4126":4205,"_4128":4206,"_4130":683,"_4131":4207},"chr_0018_dapan_17","chr_0018_dapan_sim_hello_lower_01","有空陪您撮顿好的！","打招呼1",{"_4053":16,"_15":4209,"_4095":64,"_4096":3634,"_4126":4210,"_4128":4211,"_4130":722,"_4131":4212},"chr_0018_dapan_18","chr_0018_dapan_sim_hello_max_01","要是帝江号的伙食吃腻味了，您随时招呼我！","打招呼2",{"_4053":16,"_15":4214,"_4095":37,"_4096":37,"_4126":4215,"_4128":4216,"_4130":762,"_4131":4217},"chr_0018_dapan_19","chr_0018_dapan_sim_talk_lv01_01","您可看着又瘦了。这节骨眼儿上您更该对自己多上上心，要不给您开点小灶？","帝江号闲聊1",{"_4053":16,"_15":4219,"_4095":64,"_4096":3634,"_4126":4220,"_4128":4221,"_4130":801,"_4131":4222},"chr_0018_dapan_20","chr_0018_dapan_sim_talk_lv02_01","哎呀，帝江号之前的伙食总是不得劲儿。您先甭反驳我，今天我掌勺，弄了点新鲜的，您先尝尝！","帝江号闲聊2",{"_4053":16,"_15":4224,"_4095":64,"_4096":3634,"_4126":4225,"_4128":4226,"_4130":872,"_4131":4227},"chr_0018_dapan_21","chr_0018_dapan_sim_talk_lv02_02","听说您刚批评了那些对我说话刺了点的晚辈？其实不碍事，天师也好，厨子也罢，我听着都开心。帝江号上也难得有愿意找我聊天的同事了。","帝江号闲聊3",{"_4053":16,"_15":4229,"_4095":64,"_4096":4122,"_4126":4230,"_4128":4231,"_4130":911,"_4131":4232},"chr_0018_dapan_22","chr_0018_dapan_sim_talk_max_01","我在帝江号上看到不少宏山科学院的技术，院里轨道技术专家们的心血都真切摆在我眼前——您保管想象不出那个场面，几位老师为了一个小自检模块该搁哪儿都能吵个天昏地暗。","帝江号闲聊4",{"_4053":16,"_15":4234,"_4095":64,"_4096":4122,"_4126":4235,"_4128":4236,"_4130":951,"_4131":4237},"chr_0018_dapan_23","chr_0018_dapan_sim_talk_max_02","不是驳您面子，终末地的宿舍不够大呀！早上我伸个懒腰，胳膊和膝盖就都磕青了。您给想想法子！","帝江号闲聊5",{"_4053":16,"_15":4239,"_4095":64,"_4096":4122,"_4126":4240,"_4128":4241,"_4130":990,"_4131":4242},"chr_0018_dapan_24","chr_0018_dapan_sim_talk_max_03","您要见到安德烈，就替我招呼一句——我还等着听他的新思路呢！他怎么还躲着我啊？","帝江号闲聊6",{"_4053":16,"_15":4244,"_4095":37,"_4096":37,"_4126":4245,"_4128":4246,"_4130":62,"_4131":4247},"chr_0018_dapan_25","chr_0018_dapan_sim_gift_give_01","总算逮着您了，管理员！专门弄来的特产，接好咯！","赠送礼物",{"_4053":16,"_15":4249,"_4095":37,"_4096":37,"_4126":4250,"_4128":4251,"_4130":1068,"_4131":4252},"chr_0018_dapan_26","chr_0018_dapan_sim_gift_recv_01","承蒙关照！","接收礼物",{"_4053":16,"_15":4254,"_4095":37,"_4096":37,"_4126":4255,"_4128":4256,"_4130":1108,"_4131":4257},"chr_0018_dapan_27","chr_0018_dapan_mono_self_line01","您有麻烦尽管找我，咱什么活没干过！厨子、电工、木工、司机，甚至练摊儿都称得上职业。毕竟实验室里要忙活的事儿很多。“先进科研工作者”？嘿嘿，只是我顺手拿来泡茶的杯子而已。","信赖对话1",{"_4053":16,"_15":4259,"_4095":64,"_4096":3634,"_4126":4260,"_4128":4261,"_4130":1147,"_4131":4262},"chr_0018_dapan_28","chr_0018_dapan_mono_self_line02","管理员，有机会您得去宏山科学院本部遛遛。哪怕不为图新鲜，只是去听听学生们的辩论。许多前沿课题会引用您过去的研究，虽然您都忘了——说起来，我的论文是不是也引用了您的文章来着？","信赖对话2",{"_4053":16,"_15":4264,"_4095":64,"_4096":3634,"_4126":4265,"_4128":4266,"_4130":1187,"_4131":4267},"chr_0018_dapan_29","chr_0018_dapan_mono_self_line03","我这口大黑锅，防雨防火，还防蚀刻弹，必要时候往身上一背，能挡不少事儿！管理员，咱们有时候多吃点儿苦，就能少吃点儿亏，这买卖我觉得值，太值了。","信赖对话3",{"_4053":16,"_15":4269,"_4095":64,"_4096":4122,"_4126":4270,"_4128":4271,"_4130":56,"_4131":4272},"chr_0018_dapan_30","chr_0018_dapan_mono_self_line04","您别看我现在老说得过且过，当年我潘远在宏科院可不惯着别人！谁敢在研究上跟我抬杠，那我们就得当场说道清楚——哎，但要太认咱那死理，可能不经意间就误了旁人大半辈子的努力。哪怕找补回来，自己心里那道坎儿都抹不掉了。不过都是些老黄历了，您就听一乐呵。","信赖对话4",{"_4053":16,"_15":4274,"_4095":64,"_4096":4122,"_4126":4275,"_4128":4276,"_4130":1265,"_4131":4277},"chr_0018_dapan_31","chr_0018_dapan_mono_self_line05","等帮您把眼下的麻烦都兜住了，劳您赏脸去宏山遛遛。放心，不拖您探店，宏山啥菜我自个儿在家不能给您做啊！就陪我回趟院里，帮我瞅瞅当年落下的研究。您别说，和您见识了那些新鲜事儿后，心里直痒痒！有您在，这次我非得把那硬茬给啃喽！","信赖对话5",{"_4053":16,"_15":4279,"_4095":37,"_4096":37,"_4126":4280,"_4128":4281,"_4130":1304,"_4131":4282},"chr_0018_dapan_32","chr_0018_dapan_mono_chat_line01","想做好菜就甭找捷径。一道菜搞砸了再多次，也都得自己全咽咯，否则怎么咂吧出那个最合适的味儿呢？您说是吧！","交谈1",{"_4053":16,"_15":4284,"_4095":37,"_4096":37,"_4126":4285,"_4128":4286,"_4130":117,"_4131":4287},"chr_0018_dapan_33","chr_0018_dapan_mono_chat_line02","您是明白人！技术讨论这事儿，就得敞开了聊。就事论事，咱们有分歧谈分歧，谈完了大家还是和和气气。唉，这事就怕有意见还非得心里憋着。不提了，难受！","交谈2",{"_4053":16,"_15":4289,"_4095":37,"_4096":37,"_4126":4290,"_4128":4291,"_4130":1382,"_4131":4292},"chr_0018_dapan_34","chr_0018_dapan_mono_chat_line03","每每跟您唠起武陵城，老是绕不开水秀山清，绕不开我那小店，绕不开侵蚀潮跟前搓麻将。虽说都是车轱辘话，但惦记也是真惦记！难说我这性子不是退休后被武陵城给养出来的。您别光偷着笑，话都说到这份上了，搓一轮？","交谈3",{"_4053":16,"_15":4294,"_4095":37,"_4096":37,"_4126":4295,"_4128":4296,"_4130":1422,"_4131":4297},"chr_0018_dapan_35","chr_0018_dapan_mono_chat_line04","我游历过环带不少城市，也和很多同行切磋过。各家那点门道，都愿意敞开了放菜里。不过能学到几成，那就看各家造化了。","交谈4",{"_4053":16,"_15":4299,"_4095":37,"_4096":37,"_4126":4300,"_4128":4301,"_4130":156,"_4131":4302},"chr_0018_dapan_36","chr_0018_dapan_mono_chat_line05","本以为退休了就能老实闲下来，烧烧饭，品品茶，日子照样过……唉，可惜遇见了您，之后就再没消停过咯。您要问这滋味咋样？哈，也不错！","交谈5",{"_4053":16,"_15":4304,"_4095":37,"_4096":37,"_4126":4305,"_4128":4306,"_4130":1500,"_4131":4307},"chr_0018_dapan_37","chr_0018_dapan_mono_about_line01","“感染者”，这个称呼好像早没了绝望的意味。真遇上了，大多数人也无非一句点儿背就带过去了……但要是您也多去环带外的聚落遛遛，保不准会有不同的看法。","话题：感染者",{"_4053":16,"_15":4309,"_4095":37,"_4096":37,"_4126":4310,"_4128":4311,"_4130":1539,"_4131":4312},"chr_0018_dapan_38","chr_0018_dapan_mono_about_line02","武陵城底下的特大裂隙我们研究了这么些年，您要是想知道它的尺寸，我就着这口锅都能给您比划得清清楚楚。可真要想出个一劳永逸的解决办法，唉，难哟……","话题：裂隙",{"_4053":16,"_15":4314,"_4095":37,"_4096":37,"_4126":4315,"_4128":4316,"_4130":41,"_4131":4317},"chr_0018_dapan_39","chr_0018_dapan_mono_about_line03","哦，您见着庄管代了吧！她还是那副老样子，心里明明软着呢，但做事说话还非得逼着自己上狠手段。苦了自己不说，还落不着个好名声——算了，不提这茬。","话题：庄方宜",{"_4053":16,"_15":4319,"_4095":37,"_4096":37,"_4126":4320,"_4128":4321,"_4130":44,"_4131":4322},"chr_0018_dapan_40","chr_0018_dapan_mono_about_line04","谁跟您胡说宏科院都是炎国人？院里讲究广纳贤才，只要能和其他俩阵营协调好，愿意耐得住性子搞研究，干嘛把人拒之门外？","话题：宏山科学院",{"_4053":16,"_15":4324,"_4095":37,"_4096":37,"_4126":4325,"_4128":4326,"_4130":47,"_4131":4327},"chr_0018_dapan_41","chr_0018_dapan_mono_about_line05","黎风那小子每天把身杆儿绷得那样儿，我瞅着就累，所以变着方儿地想让他放松放松。他呀，也乐意陪着我胡闹。那孩子的心思，门儿清！也不知道算好事儿还是坏事儿……","话题：黎风",{"_4053":16,"_15":4329,"_4095":37,"_4096":37,"_4126":4330,"_4128":4331,"_4130":50,"_4131":4332},"chr_0018_dapan_42","chr_0018_dapan_mono_about_line06","集成工业系统的确可以很大程度改善难民们的生活，但毕竟大家想法不同，一件大好事儿也难免磕磕碰碰，您多担待！但四号谷地的事儿咱可不敢邀功，力所能及罢了！","话题：四号谷地",{"_4053":16,"_15":4334,"_4095":37,"_4096":37,"_4126":4335,"_4128":4336,"_4130":1764,"_4131":4337},"chr_0018_dapan_43","chr_0018_dapan_explore_point_common_01","来一趟不容易，能带多少带多少。","发现资源1",{"_4053":16,"_15":4339,"_4095":37,"_4096":37,"_4126":4340,"_4128":4341,"_