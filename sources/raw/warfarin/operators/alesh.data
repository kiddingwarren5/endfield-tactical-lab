_7627":8116,"_7630":8117},[7629,7629,7629],[8118,8118,8118],"<color=#A7A7A7>","tech.get",{"_15":8119,"_7627":8121,"_7630":8122},[7629,7629,7629],[8123,8123,8123],"<color=#1e1e1e>","tips.key",{"_15":8124,"_7627":8126,"_7630":8127},[7629,7629,7629],[8128,8129,8128],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":8130,"_7627":8132,"_7630":8133},[7629,7629,7629],[7917,7918,7919],"toast_focal.key",{"_15":8134,"_7627":8136,"_7630":8137},[7629,7629,7629],[8129,8129,8129],"weapon.stress",{"_15":8138,"_7627":8140,"_7630":8141},[7629,7629,7629],[8142,8142,8142],"<color=#fe5a00>","weekraid.key",{"_15":8143,"_7627":8145,"_7630":8146},[7786,7786,7786],[8147,8147,8148],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_8151":8152,"_8158":8159,"_7840":8163,"_8168":8169,"_8172":8173,"_8177":8178,"_8181":8182,"_8186":8187,"_8190":8191,"_8195":8196,"_8199":8200,"_7655":8204,"_8209":8210,"_8213":8214,"_8218":8219,"_8223":8224,"_8227":8228,"_8232":8233,"_7738":8236,"_8241":8242,"_8245":8246,"_8251":8252,"_7744":8255,"_8260":8261,"_8264":8265,"_7762":8269,"_8274":8275,"_8278":8279,"_7769":8283,"_8288":8289,"_8294":8295,"_7793":8299,"_8304":8305,"_8309":8310,"_8314":8315,"_8319":8320,"_7800":8324,"_8328":8329,"_8333":8334,"_8338":8339,"_8342":8343,"_8348":8349,"_8353":8354,"_7830":8358,"_8363":8364,"_8368":8369,"_8371":8372,"_8375":8376,"_8380":8381,"_8384":8385,"_8390":8391,"_8394":8395,"_8399":8400,"_8404":8405,"_7847":8409,"_8413":8414,"_8416":8417,"_7867":8421,"_8425":8426,"_8430":8431,"_8435":8436,"_8440":8441,"_8444":8445,"_8449":8450,"_7667":8455,"_7706":8459,"_8464":8465,"_8469":8470,"_8474":8475,"_7893":8479,"_8484":8485,"_8487":8488,"_8491":8492,"_8495":8496,"_8500":8501,"_8505":8506,"_8509":8510,"_8514":8515,"_7933":8519,"_8523":8524,"_8528":8529,"_8533":8534,"_8538":8539,"_8542":8543,"_8546":8547,"_8551":8552,"_8556":8557,"_8560":8561,"_8566":8567,"_8570":8571,"_8574":8575,"_8579":8580,"_8583":8584,"_8587":8588,"_8591":8592,"_8597":8598,"_8602":8603,"_8607":8608,"_8612":8613,"_8617":8618,"_8622":8623,"_8627":8628,"_8632":8633,"_8637":8638,"_8642":8643,"_8647":8648,"_8652":8653,"_8657":8658,"_8662":8663},"adv.electricFence",{"_4620":8153,"_8154":4060,"_15":8151,"_8155":4060,"_19":8156,"_8157":7723},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4620":8160,"_8154":8161,"_15":8158,"_8155":4060,"_19":8162,"_8157":7776},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4620":8164,"_8154":8165,"_15":7840,"_8155":8166,"_19":8167,"_8157":7905},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4620":8170,"_8154":4060,"_15":8168,"_8155":4060,"_19":8171,"_8157":7723},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4620":8174,"_8154":8175,"_15":8172,"_8155":4060,"_19":8176,"_8157":7723},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4620":8179,"_8154":4060,"_15":8177,"_8155":4060,"_19":8180,"_8157":7723},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4620":8183,"_8154":8184,"_15":8181,"_8155":4060,"_19":8185,"_8157":7817},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4620":8188,"_8154":4060,"_15":8186,"_8155":4060,"_19":8189,"_8157":7723},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4620":8192,"_8154":8193,"_15":8190,"_8155":4060,"_19":8194,"_8157":7723},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4620":8197,"_8154":4060,"_15":8195,"_8155":4060,"_19":8198,"_8157":4060},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4620":8201,"_8154":8202,"_15":8199,"_8155":4060,"_19":8203,"_8157":7776},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4620":8205,"_8154":8206,"_15":7655,"_8155":8207,"_19":8208,"_8157":7905},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4620":8211,"_8154":4060,"_15":8209,"_8155":4060,"_19":8212,"_8157":7723},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4620":8215,"_8154":8216,"_15":8213,"_8155":4060,"_19":8217,"_8157":7723},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4620":8220,"_8154":8221,"_15":8218,"_8155":4060,"_19":8222,"_8157":7723},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4620":8225,"_8154":4060,"_15":8223,"_8155":4060,"_19":8226,"_8157":7750},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4620":8229,"_8154":8230,"_15":8227,"_8155":4060,"_19":8231,"_8157":7723},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4620":8234,"_8154":4060,"_15":8232,"_8155":4060,"_19":8235,"_8157":7750},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4620":8237,"_8154":8238,"_15":7738,"_8155":8239,"_19":8240,"_8157":7817},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4620":8243,"_8154":8238,"_15":8241,"_8155":4060,"_19":8244,"_8157":7817},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4620":8247,"_8154":8248,"_15":8245,"_8155":8249,"_19":8250,"_8157":7750},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4620":8253,"_8154":4060,"_15":8251,"_8155":4060,"_19":8254,"_8157":7750},"持续时间内，受影响的目标暂停行动。","定身",{"_4620":8256,"_8154":8257,"_15":7744,"_8155":8258,"_19":8259,"_8157":7929},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4620":8262,"_8154":8257,"_15":8260,"_8155":4060,"_19":8263,"_8157":7929},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4620":8266,"_8154":4060,"_15":8264,"_8155":8267,"_19":8268,"_8157":4060},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4620":8270,"_8154":8271,"_15":7762,"_8155":8272,"_19":8273,"_8157":7879},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4620":8276,"_8154":8271,"_15":8274,"_8155":4060,"_19":8277,"_8157":7879},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4620":8280,"_8154":8281,"_15":8278,"_8155":4060,"_19":8282,"_8157":7723},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4620":8284,"_8154":8285,"_15":7769,"_8155":8286,"_19":8287,"_8157":7905},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4620":8290,"_8154":8291,"_15":8288,"_8155":8292,"_19":8293,"_8157":7750},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4620":8296,"_8154":8297,"_15":8294,"_8155":4060,"_19":8298,"_8157":7750},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4620":8300,"_8154":8301,"_15":7793,"_8155":8302,"_19":8303,"_8157":7776},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4620":8306,"_8154":4060,"_15":8304,"_8155":8307,"_19":8308,"_8157":7776},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4620":8311,"_8154":8312,"_15":8309,"_8155":4060,"_19":8313,"_8157":7723},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4620":8316,"_8154":8317,"_15":8314,"_8155":4060,"_19":8318,"_8157":7723},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4620":8321,"_8154":8322,"_15":8319,"_8155":4060,"_19":8323,"_8157":7776},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4620":8325,"_8154":8161,"_15":7800,"_8155":8326,"_19":8327,"_8157":7776},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4620":8330,"_8154":4060,"_15":8328,"_8155":8331,"_19":8332,"_8157":7750},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4620":8335,"_8154":8336,"_15":8333,"_8155":4060,"_19":8337,"_8157":7723},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4620":8340,"_8154":4060,"_15":8338,"_8155":4060,"_19":8341,"_8157":4060},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4620":8344,"_8154":8345,"_15":8342,"_8155":8346,"_19":8347,"_8157":7750},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4620":8350,"_8154":8351,"_15":8348,"_8155":4060,"_19":8352,"_8157":7723},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4620":8355,"_8154":4060,"_15":8353,"_8155":8356,"_19":8357,"_8157":7817},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4620":8359,"_8154":8360,"_15":7830,"_8155":8361,"_19":8362,"_8157":7817},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4620":8365,"_8154":8366,"_15":8363,"_8155":4060,"_19":8367,"_8157":7723},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4620":8243,"_8154":8360,"_15":8368,"_8155":4060,"_19":8370,"_8157":7817},"干员受到灼热附着","sys.tacticalItem",{"_4620":8373,"_8154":4060,"_15":8371,"_8155":4060,"_19":8374,"_8157":7723},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4620":8377,"_8154":8378,"_15":8375,"_8155":4060,"_19":8379,"_8157":7817},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4620":8262,"_8154":8382,"_15":8380,"_8155":4060,"_19":8383,"_8157":7929},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4620":8386,"_8154":8387,"_15":8384,"_8155":8388,"_19":8389,"_8157":7750},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4620":8392,"_8154":4060,"_15":8390,"_8155":4060,"_19":8393,"_8157":7750},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4620":8396,"_8154":8397,"_15":8394,"_8155":4060,"_19":8398,"_8157":7905},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4620":8401,"_8154":8402,"_15":8399,"_8155":4060,"_19":8403,"_8157":7929},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4620":8406,"_8154":8407,"_15":8404,"_8155":4060,"_19":8408,"_8157":7750},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4620":8410,"_8154":8411,"_15":7847,"_8155":8302,"_19":8412,"_8157":7776},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4620":8160,"_8154":8411,"_15":8413,"_8155":4060,"_19":8415,"_8157":7776},"干员受到冻结","ba.naturalvul",{"_4620":8418,"_8154":8419,"_15":8416,"_8155":4060,"_19":8420,"_8157":7879},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4620":8205,"_8154":8422,"_15":7867,"_8155":8423,"_19":8424,"_8157":7905},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4620":8427,"_8154":8428,"_15":8425,"_8155":4060,"_19":8429,"_8157":7723},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4620":8432,"_8154":8433,"_15":8430,"_8155":4060,"_19":8434,"_8157":7723},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4620":8437,"_8154":8438,"_15":8435,"_8155":4060,"_19":8439,"_8157":7723},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4620":8442,"_8154":4060,"_15":8440,"_8155":4060,"_19":8443,"_8157":7723},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4620":8446,"_8154":4060,"_15":8444,"_8155":8447,"_19":8448,"_8157":4060},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4620":8451,"_8154":8452,"_15":8449,"_8155":8453,"_19":8454,"_8157":7750},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4620":8456,"_8154":4060,"_15":7667,"_8155":8457,"_19":8458,"_8157":7879},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4620":8460,"_8154":8461,"_15":7706,"_8155":8462,"_19":8463,"_8157":7905},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4620":8466,"_8154":8467,"_15":8464,"_8155":4060,"_19":8468,"_8157":7723},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4620":8471,"_8154":8472,"_15":8469,"_8155":4060,"_19":8473,"_8157":7879},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4620":8476,"_8154":8477,"_15":8474,"_8155":4060,"_19":8478,"_8157":7723},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4620":8480,"_8154":8481,"_15":7893,"_8155":8482,"_19":8483,"_8157":7879},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4620":8276,"_8154":8481,"_15":8484,"_8155":4060,"_19":8486,"_8157":7879},"干员受到自然附着","ba.originium",{"_4620":8489,"_8154":4060,"_15":8487,"_8155":4060,"_19":8490,"_8157":7750},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4620":8493,"_8154":4060,"_15":8491,"_8155":4060,"_19":8494,"_8157":7905},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4620":8497,"_8154":8498,"_15":8495,"_8155":4060,"_19":8499,"_8157":7905},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4620":8502,"_8154":4060,"_15":8500,"_8155":8503,"_19":8504,"_8157":7913},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4620":8507,"_8154":4060,"_15":8505,"_8155":4060,"_19":8508,"_8157":7723},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4620":8511,"_8154":4060,"_15":8509,"_8155":8512,"_19":8513,"_8157":7929},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4620":8516,"_8154":8517,"_15":8514,"_8155":4060,"_19":8518,"_8157":7723},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4620":8520,"_8154":8382,"_15":7933,"_8155":8521,"_19":8522,"_8157":7929},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4620":8525,"_8154":8526,"_15":8523,"_8155":4060,"_19":8527,"_8157":7929},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4620":8530,"_8154":4060,"_15":8528,"_8155":8531,"_19":8532,"_8157":7750},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4620":8535,"_8154":4060,"_15":8533,"_8155":8536,"_19":8537,"_8157":4060},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4620":8540,"_8154":4060,"_15":8538,"_8155":4060,"_19":8541,"_8157":7723},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4620":8544,"_8154":4060,"_15":8542,"_8155":4060,"_19":8545,"_8157":7750},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4620":8548,"_8154":8549,"_15":8546,"_8155":4060,"_19":8550,"_8157":7723},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4620":8553,"_8154":4060,"_15":8551,"_8155":8554,"_19":8555,"_8157":7750},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4620":8558,"_8154":4060,"_15":8556,"_8155":4060,"_19":8559,"_8157":7723},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4620":8562,"_8154":8563,"_15":8560,"_8155":8564,"_19":8565,"_8157":7750},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4620":8568,"_8154":4060,"_15":8566,"_8155":4060,"_19":8569,"_8157":7750},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4620":8572,"_8154":4060,"_15":8570,"_8155":4060,"_19":8573,"_8157":7750},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4620":8576,"_8154":8577,"_15":8574,"_8155":4060,"_19":8578,"_8157":7723},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4620":8581,"_8154":4060,"_15":8579,"_8155":4060,"_19":8582,"_8157":7750},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4620":8585,"_8154":4060,"_15":8583,"_8155":4060,"_19":8586,"_8157":7750},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4620":8589,"_8154":4060,"_15":8587,"_8155":4060,"_19":8590,"_8157":7750},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4620":8593,"_8154":8594,"_15":8591,"_8155":8595,"_19":8596,"_8157":7750},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4620":8599,"_8154":8600,"_15":8597,"_8155":4060,"_19":8601,"_8157":7723},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4620":8604,"_8154":8605,"_15":8602,"_8155":4060,"_19":8606,"_8157":7723},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4620":8609,"_8154":8610,"_15":8607,"_8155":4060,"_19":8611,"_8157":7723},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4620":8614,"_8154":8615,"_15":8612,"_8155":4060,"_19":8616,"_8157":7723},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4620":8619,"_8154":8620,"_15":8617,"_8155":4060,"_19":8621,"_8157":7723},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4620":8624,"_8154":8625,"_15":8622,"_8155":4060,"_19":8626,"_8157":7723},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4620":8629,"_8154":8630,"_15":8627,"_8155":4060,"_19":8631,"_8157":7723},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4620":8634,"_8154":8635,"_15":8632,"_8155":4060,"_19":8636,"_8157":7723},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4620":8639,"_8154":8640,"_15":8637,"_8155":4060,"_19":8641,"_8157":7723},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4620":8644,"_8154":8645,"_15":8642,"_8155":4060,"_19":8646,"_8157":7723},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4620":8649,"_8154":8650,"_15":8647,"_8155":4060,"_19":8651,"_8157":7723},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4620":8654,"_8154":8655,"_15":8652,"_8155":4060,"_19":8656,"_8157":7723},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4620":8659,"_8154":8660,"_15":8657,"_8155":4060,"_19":8661,"_8157":7723},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4620":8664,"_8154":8665,"_15":8662,"_8155":4060,"_19":8666,"_8157":7723},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7359":8669,"_6910":8678,"_6928":8680,"_7014":8682,"_7016":8684,"_7018":8686,"_7020":8688,"_7022":8690,"_7025":8692,"_7028":8693,"_5431":8695,"_7033":8697,"_6132":8698,"_6236":8699,"_7039":8700,"_5594":8701,"_7044":8702,"_7047":8703,"_7050":8705,"_7053":8706,"_5434":8707,"_7060":8708,"_7063":8709,"_7067":8710,"_7071":8711,"_5596":8712,"_7077":8713,"_7081":8715,"_7085":8716,"_7089":8718,"_5437":8720,"_7096":8722,"_7100":8723,"_7104":8725,"_7108":8727,"_5598":8728,"_7115":8