,5832,{"_36":55,"_38":3906},315,{"_36":58,"_38":37},{"_36":60,"_38":3909},1.48469387755102,{"_36":62,"_38":3911},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3931,"_102":64},{"_33":3932},[3933,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":3934},97,{"_36":41,"_38":3936},138.29497159688648,{"_36":44,"_38":3938},92.90132547864506,{"_36":47,"_38":3940},177.00568062276508,{"_36":50,"_38":3942},88.54491899852724,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},318,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3970,"_102":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},139.57016621081453,{"_36":44,"_38":3977},93.77025036818851,{"_36":47,"_38":3979},178.6884073216921,{"_36":50,"_38":3981},89.36524300441826,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},321,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4010,"_102":64},{"_33":4011},[4012,4013,4015,4017,4019,4021,4023,4025,4026,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046],{"_36":37,"_38":1000},{"_36":41,"_38":4014},140.84536082474258,{"_36":44,"_38":4016},94.63917525773195,{"_36":47,"_38":4018},180.37113402061908,{"_36":50,"_38":4020},90.18556701030927,{"_36":39,"_38":4022},6000,{"_36":55,"_38":4024},324,{"_36":58,"_38":37},{"_36":60,"_38":4027},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4049,4050],"tag_20","tag_09","charId","charIllustInitPos",{"_4054":1157,"_4055":4056},"x","y",-536,"charPassiveUIPrefabName","","charTypeId","Pulse","cvName",{"_4063":4064,"_4065":4066,"_4067":4068,"_4069":4070,"_4051":16},"ChiCVName","刘雨轩","EngCVName","Jacob Craner","JapCVName","武内骏辅","KorCVName","李奎昌","defaultWeaponId","wpn_funnel_0002","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Antal","mainAttrType","phoneticName","profession","profileRecord",[4084,4095,4100,4105,4110,4115],{"_4051":16,"_15":4085,"_4086":4087,"_4088":4089,"_4090":39,"_4091":4092,"_4093":37,"_4094":37},"chr_0023_antal_1","recordDesc","【代号】安塔尔\n【性别】男\n【身份认证】终末地工业\n【生日】4月10日\n【种族】萨弗拉\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：普通\n作战技巧：标准\n战术规划：普通\n源石技艺适应性：卓越","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4051":16,"_15":4096,"_4086":4097,"_4088":4098,"_4090":55,"_4091":4099,"_4093":37,"_4094":37},"chr_0023_antal_2","干员安塔尔，Z7行动组成员。曾参与终末地工业源石自动化器械研发项目，经干员秋栗特别推荐，转入特种技术部门。\n\n安塔尔从来不会掩饰自己的想法，当我问到他的学业情况时，他便完整向我讲述了自己每学期的学习和研究成果，虽然我只是依照惯例询问了一下……至少证明他确实热爱自己的专业，对待问题也足够认真。\n在终于要结束被他拖延到长达三小时的谈话时，他突然好奇我有没有幽默系统，对我说，不介意的话他可以帮忙测试一下。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4051":16,"_15":4101,"_4086":4102,"_4088":4103,"_4090":58,"_4091":4104,"_4093":37,"_4094":37},"chr_0023_antal_3","安塔尔并非像他看上去那么冷漠，难以相处，相信每一位和他有过接触的人都有这样的认知。这位热衷于研究源石技术、看起来过分板正的家伙，居然很喜欢给人讲冷笑话！一个技术人才，会绞尽脑汁想出需要用逻辑推理才能勉强理解笑点的冷笑话，他这么做的原因，只是想提升自己的幽默感吗？尤其当他顶着面无表情的脸试图引你发笑，你很难判断让你发笑的点到底是他的冷笑话，还是他身上表现出的反差。\n他的队长秋栗对此倒是保持着非常乐观的态度：“至少他待人真诚，虽然有时说话不看场合。比如与敌人对峙时也会突然展示他的幽默感，可惜对方就不这么认为了。”\n对安塔尔来说，“成为有趣的人”似乎是他人生的必修课，而所有人都是来考核他成绩的老师，从Z7小队的队友到不过一面之交的同事——只要是能给予有价值建议的对象，他都不吝于请教。\n但是最近，安塔尔不再去打扰别人了，因为终于有人自愿长期给他反馈……等等，大概是自愿的吧？毕竟很少有人还没听完安塔尔的笑话就笑了起来。是的，我们的管理员，在以最大的耐心和安塔尔相处，会听完他所有的奇思妙想——包括他灵机一动的发明创意，以及抓住一个机会就展开的长达几小时的科普演讲。尤其某次，他竟然试图说服管理员脱下面具，理由是想对它做一些改装，比如加一双电光眼……最后当然是被路过的秋栗狠狠教训一通，当晚写了六千字检讨，并在第二天当着管理员的面大声朗读出来。\n当然，这种惩罚对安塔尔来说完全没用，没过去几天，他灵活的大脑大概又要冒出一些奇妙的点子了。","CN_03","档案资料·一",{"_4051":16,"_15":4106,"_4086":4107,"_4088":4108,"_4090":64,"_4091":4109,"_4093":64,"_4094":3711},"chr_0023_antal_4","【干员培训纪录】\n如果只看安塔尔目前的训练表现，我有理由认为他并不具备足够的正面作战能力。\n他擅长用自己改造的法杖和浮游炮为队友提供辅助，但很少使用他本人的源石技艺。\n或许有待进一步实战观察。\n——训练教官批注\n\n【权限记录】\n根据Z7小队成员的报告，安塔尔的源石技艺堪称精湛，水准远远超过其他同期干员。在执行某一次任务时，他们曾亲眼见识过，安塔尔是如何在紧要关头挡在人质面前，利用自己的源石技艺将裂地者挥舞而来的大剑瞬间分解，救下包括他自己在内的两条生命。\n当时所有人都格外紧张，如果安塔尔没能及时分解那把武器，他立刻会丢掉性命，可他本人却表现得十分冷静。自那以后，队友们对安塔尔有了更深的认知——这家伙其实非常迟钝，不论是感知危险情况，还是察觉别人的情绪波动，但他又愿意冒着生命危险去救人，也说明他是十分善良和勇敢的人。\n事后面对队友的询问，安塔尔表现得格外谦虚——他说自己的源石技艺掌握得并不是很好，完全无法做到像他的奶奶那样将一个大件金属器械分解并重构，分解裂地者的武器是他能做到的极限。他还提到，小时候奶奶还特地做了一根小法杖送给他，用来弥补这方面的不足。\n“你的天赋在别的地方——奶奶曾这么对我说过，而我一直对这件事深信不疑。”","CN_04","档案资料·二",{"_4051":16,"_15":4111,"_4086":4112,"_4088":4113,"_4090":66,"_4091":4114,"_4093":64,"_4094":3711},"chr_0023_antal_5","安塔尔出身于新蓝卡坞自由市的一个普通家庭，从小在奶奶经营的一家家用源石设备维修店里长大。\n虽然生活的地方娱乐业发达，但安塔尔却对电影艺术之类的毫无兴趣，反而喜欢每天趴在桌子上看奶奶工作——比如维修一台运转异常的冰箱，为它更换源石启动器配件，再将屏幕碎裂、主板受损严重的电视机修复到完好如初……虽然身为维修师每天都有工作要做，但她从未忽视过孙子的成长。不忙的时候，她还会亲自给安塔尔设计制作一些小玩具：自动小跑车、电动魔方等等。所以安塔尔的童年从不缺少爱和陪伴。耳濡目染下，安塔尔也展现出他出众的组装、拆卸源石装置的天赋，最后得到全额奖学金去学院读书时，他也选了源石自动化应用相关的专业。\n安塔尔就读学院的教育方式以保守著称，但他并不循规蹈矩，在发现自己的一些新奇发明并未得到老师的青睐后，他选择私下研究。毕业典礼那天，安塔尔作为优秀毕业生上台演讲。他将自己的最新发明——以源石驱动的自动化机械臂——安装在身后，用它冲着曾对此不屑一顾的老师们热情招手。突然，机械臂的四指垂下，只留一根中指竖立在空中静默不动。\n尽管这次事件给校方的相关负责人留下了不小的心理阴影，安塔尔后来还是顺利毕业了。只不过，学校这边再没有一位老师愿意为他写就业推荐信。再后来，恰逢终末地工业前往新蓝卡坞附近的城市招募人才，其先进的技术和开拓精神深深吸引了安塔尔。事后，他主动向终末地投递了简历。完成面试后，安塔尔被正在组建队伍的干员秋栗选中，不久后正式成为了Z7行动组的一员。\n\n啊……特训结束了我才意识到，难道这家伙勉强能算是个天才？\n——Maze\n\n勉强？\n——同期受训的术师干员","CN_05","档案资料·三",{"_4051":16,"_15":4116,"_4086":4117,"_4088":4118,"_4090":68,"_4091":4119,"_4093":64,"_4094":4120},"chr_0023_antal_6","奶奶：\n我收到您寄来的包裹了，这个新型施术单元正好能为我改造浮游炮提供帮助，别的一些附带的家乡特产我都分给了别人。其实您不用特地寄这些东西给我，我现在有固定的工资，即便每月购置一些工程改装用的零件也还有盈余。\n我知道您寄电影角色玩偶、经典角色衣服，还有各种限定电影海报这些特产过来，是想让我用它们和其他人拉近关系，以前读书时您就是这么做的——虽然那些同学拿到东西后随手将它们塞进了闲置柜，再也没有拿出来过。那时您还写信说让我不要伤心，我真的没有，奶奶，正如我一直告诉您的那样，别人的反应无法影响我对他们的态度。\n而且终末地的同事和学院的同学不一样，他们从来没有拒绝过我，也没否定过我的想法。我在这里的生活还不错，也更自由。顺便有件事我还想告诉您，我的沟通能力大有进步，多亏Z7队友们的教导，还有管理员一直陪我练习。\n您之前还担心，以我的性格会不会和这位领导有什么冲突，现在证明是您多虑了。我们相处得很愉快，不管我分享什么，那个人都乐意接受，这也是我跟您写信频率降低的原因。您不用再担心我交不到朋友。不是索取与施舍，而是真诚相待，去探讨彼此的所有……我想我应该已经明白所谓“友情”的意义了。\n以及，您托我转告的话，我已经告诉管理员了，对方很乐意，还说自己很早就期待能和您见上一面。\n\n安塔尔","CN_06","档案资料·四",1500,"profileVoice",[4123,4131,4135,4139,4143,4147,4151,4156,4161,4166,4171,4176,4181,4186,4191,4196,4201,4206,4211,4216,4221,4226,4231,4236,4241,4246,4251,4256,4261,4266,4271,4276,4281,4286,4291,4296,4301,4306,4311,4316,4321,4326,4331,4336,4341,4346,4351,4356,4361,4366,4371,4376,4381,4386,4391,4396,4401,4406,4411,4416,4421,4426,4431,4436,4441,4446,4451,4456,4461,4466,4471,4476,4481,4486,4491,4496,4501,4506,4511,4516],{"_4051":16,"_15":4085,"_4093":37,"_4094":37,"_4124":4125,"_4126":4127,"_4128":39,"_4129":4130},"voId","chr_0023_antal_chrbark_squad_01","voiceDesc","嗯，准备开始工作吧。","voiceIndex","voiceTitle","行动准备1",{"_4051":16,"_15":4096,"_4093":37,"_4094":37,"_4124":4132,"_4126":4133,"_4128":55,"_4129":4134},"chr_0023_antal_chrbark_squad_02","这次的测试对象是谁？","行动准备2",{"_4051":16,"_15":4101,"_4093":37,"_4094":37,"_4124":4136,"_4126":4137,"_4128":58,"_4129":4138},"chr_0023_antal_chrbark_join_01","轮到我出任务了么？正好，我也想找机会测试浮游炮的改造成效。","编入队伍1",{"_4051":16,"_15":4106,"_4093":37,"_4094":37,"_4124":4140,"_4126":4141,"_4128":64,"_4129":4142},"chr_0023_antal_chrbark_join_02","想好作战方案的话，告诉我要做什么就行，我相信您的判断。","编入队伍2",{"_4051":16,"_15":4111,"_4093":37,"_4094":37,"_4124":4144,"_4126":4145,"_4128":66,"_4129":4146},"chr_0023_antal_chrbark_weap_01","未经调试的新武器，我需要对它进行一次效能评估。","更换武器",{"_4051":16,"_15":4116,"_4093":37,"_4094":37,"_4124":4148,"_4126":4149,"_4128":68,"_4129":4150},"chr_0023_antal_chrbark_gear_01","性能有显著提升，虽然它会卡住我的鳞片。","更换装备",{"_4051":16,"_15":4152,"_4093":37,"_4094":37,"_4124":4153,"_4126":4154,"_4128":70,"_4129":4155},"chr_0023_antal_7","chr_0023_antal_chrup_skill_01","嗯……感谢指导，我突然有了一个新思路。","激活天赋阵列",{"_4051":16,"_15":4157,"_4093":37,"_4094":37,"_4124":4158,"_4126":4159,"_4128":88,"_4129":4160},"chr_0023_antal_8","chr_0023_antal_chrup_level_01","出色的作战规划，管理员，我很乐意配合您行动。","观看作战记录",{"_4051":16,"_15":4162,"_4093":55,"_4094":39,"_4124":4163,"_4126":4164,"_4128":90,"_4129":4165},"chr_0023_antal_9","chr_0023_antal_chrup_promt01_01","要给我涨薪吗？谢谢，那我每月就可以购入更多源石装置和施术单元用来研究和收藏。","精英化晋升1",{"_4051":16,"_15":4167,"_4093":55,"_4094":55,"_4124":4168,"_4126":4169,"_4128":94,"_4129":4170},"chr_0023_antal_10","chr_0023_antal_chrup_promt02_01","晋升？意味着以后工作会更加繁忙？了解，所以新的任务是什么？","精英化晋升2",{"_4051":16,"_15":4172,"_4093":55,"_4094":58,"_4124":4173,"_4126":4174,"_4128":101,"_4129":4175},"chr_0023_antal_11","chr_0023_antal_chrup_promt03_01","这是对我求知欲望的鼓励吗？我正好写了一份关于协议核心的研究报告，您可以帮我检查一下是否存在漏洞。","精英化晋升3",{"_4051":16,"_15":4177,"_4093":55,"_4094":64,"_4124":4178,"_4126":4179,"_4128":96,"_4129":4180},"chr_0023_antal_12","chr_0023_antal_chrup_promt04_01","老实说，这里的生活和读书时很不一样。在学院，我只要拿出研究成果就能得到高绩点，现在这些反而不再重要。信任队友，通过团队配合取得成果，是我要重新学习和适应的事。","精英化晋升4",{"_4051":16,"_15":4182,"_4093":37,"_4094":37,"_4124":4183,"_4126":4184,"_4128":525,"_4129":4185},"chr_0023_antal_13","chr_0023_antal_introduce_01","Z7行动组安塔尔，向您报到。我对源石自动化器械有些研究，平时会帮忙改造和维修源石设备，如有需要可以来找我。顺便，我有个问题，您的面具是什么材质做的？碳纤维吗？","干员报到",{"_4051":16,"_15":4187,"_4093":37,"_4094":37,"_4124":4188,"_4126":4189,"_4128":564,"_4129":4190},"chr_0023_antal_14","chr_0023_antal_mono_switch_01","有什么问题要和我讨论吗？","待命1",{"_4051":16,"_15":4192,"_4093":37,"_4094":37,"_4124":4193,"_4126":4194,"_4128":98,"_4129":4195},"chr_0023_antal_15","chr_0023_antal_mono_switch_02","我在想要跟您讲什么冷笑话。","待命2",{"_4051":16,"_15":4197,"_4093":37,"_4094":37,"_4124":4198,"_4126":4199,"_4128":642,"_4129":4200},"chr_0023_antal_16","chr_0023_antal_sim_assign_work_01","新的工作安排吗？我明白了。","进驻设施",{"_4051":16,"_15":4202,"_4093":37,"_4094":37,"_4124":4203,"_4126":4204,"_4128":682,"_4129":4205},"chr_0023_antal_17","chr_0023_antal_sim_hello_lower_01","源石器械上的事都可以来找我，别的事也行。","打招呼1",{"_4051":16,"_15":4207,"_4093":64,"_4094":3711,"_4124":4208,"_4126":4209,"_4128":721,"_4129":4210},"chr_0023_antal_18","chr_0023_antal_sim_hello_max_01","很奇怪，一见到您，我的分享欲就格外强烈。","打招呼2",{"_4051":16,"_15":4212,"_4093":37,"_4094":37,"_4124":4213,"_4126":4214,"_4128":761,"_4129":4215},"chr_0023_antal_19","chr_0023_antal_sim_talk_lv01_01","我能检查一下您的武器吗，管理员？嗯，除了零件有些许磨损，别的没有太大问题，只需替换一个新的精密源石元件就行。没什么麻烦的，在Z7小队，我一直都这么做。","帝江号闲聊1",{"_4051":16,"_15":4217,"_4093":64,"_4094":3711,"_4124":4218,"_4126":4219,"_4128":800,"_4129":4220},"chr_0023_antal_20","chr_0023_antal_sim_talk_lv02_01","我在观察帝江号，它无疑是工程设计的巅峰，每一部分都极有学习和研究价值，中枢控制系统、协议网络节点与生命维持系统等等，我甚至已经构思好了下篇论文的选题。","帝江号闲聊2",{"_4051":16,"_15":4222,"_4093":64,"_4094":3711,"_4124":4223,"_4126":4224,"_4128":871,"_4129":4225},"chr_0023_antal_21","chr_0023_antal_sim_talk_lv02_02","我根据萤石的经历想到一个冷笑话：收到敌人的威胁信息该怎么办？答案是退订。您笑了，证明它有效果，那为什么其他人没有这样的反馈？","帝江号闲聊3",{"_4051":16,"_15":4227,"_4093":64,"_4094":4120,"_4124":4228,"_4126":4229,"_4128":909,"_4129":4230},"chr_0023_antal_22","chr_0023_antal_sim_talk_max_01","情绪持续低迷的话，可以跟我一起去室外享受自然日光浴，阳光会刺激大脑释放血清素，能有效驱散一定的负面情绪。以前，学院附近有一个喷泉公园，安静、日光充足，只要感到疲惫我就会去那儿休息。","帝江号闲聊4",{"_4051":16,"_15":4232,"_4093":64,"_4094":4120,"_4124":4233,"_4126":4234,"_4128":949,"_4129":4235},"chr_0023_antal_23","chr_0023_antal_sim_talk_max_02","我昨天收到了奶奶的回信，她对我信中频繁提到的一个人很感兴趣，也就是您。她有句话让我代为传达：“您也看到了，这孩子有些较真，但本质不坏，还麻烦您多多担待，有机会真想找您喝杯茶，再聊聊他小时候的事。”","帝江号闲聊5",{"_4051":16,"_15":4237,"_4093":64,"_4094":4120,"_4124":4238,"_4126":4239,"_4128":988,"_4129":4240},"chr_0023_antal_24","chr_0023_antal_sim_talk_max_03","很多人会站在帝江号上眺望塔卫二，我也尝试过这么做，但发现除了提供给我不同的观察角度，似乎没能像他们一样去怀念家乡，也许是因为奶奶的关系吧。她总是告诉我：“不必沉浸于过去，你该去追寻更广阔的未来。”","帝江号闲聊6",{"_4051":16,"_15":4242,"_4093":37,"_4094":37,"_4124":4243,"_4126":4244,"_4128":62,"_4129":4245},"chr_0023_antal_25","chr_0023_antal_sim_gift_give_01","在社会交往中，人们选择通过赠予对方物件来传达心意和感受。所以我准备了一份礼物，想送给您。","赠送礼物",{"_4051":16,"_15":4247,"_4093":37,"_4094":37,"_4124":4248,"_4126":4249,"_4128":1066,"_4129":4250},"chr_0023_antal_26","chr_0023_antal_sim_gift_recv_01","谢谢，我明白送礼这一行为的意义，我会珍惜。","接收礼物",{"_4051":16,"_15":4252,"_4093":37,"_4094":37,"_4124":4253,"_4126":4254,"_4128":1106,"_4129":4255},"chr_0023_antal_27","chr_0023_antal_mono_self_line01","选择加入终末地的原因很简单，这里有连学院也无法讲授的全新技术。学院对技术进步的观念有些过于保守，我还是更欣赏终末地敢于探索实践的创新精神。","信赖对话1",{"_4051":16,"_15":4257,"_4093":64,"_4094":3711,"_4124":4258,"_4126":4259,"_4128":1145,"_4129":4260},"chr_0023_antal_28","chr_0023_antal_mono_self_line02","对我手上这本书很好奇？是《高难数独题精选》。闲暇之余，我会做一些数学谜题来调节情绪。我曾向Z7的队友们分享过这个方法，但他们全都拒绝了。管理员，或许您可以尝试一下。","信赖对话2",{"_4051":16,"_15":4262,"_4093":64,"_4094":3711,"_4124":4263,"_4126":4264,"_4128":1185,"_4129":4265},"chr_0023_antal_29","chr_0023_antal_mono_self_line03","您也要给我讲个冷笑话吗？“有位萨弗拉总喜欢在白天讲冷笑话，这是为什么？因为白天很温暖，别人就不会被冷到。”……哈哈哈，我没有嘲笑您的意思，我真的在笑。","信赖对话3",{"_4051":16,"_15":4267,"_4093":64,"_4094":4120,"_4124":4268,"_4126":4269,"_4128":56,"_4129":4270},"chr_0023_antal_30","chr_0023_antal_mono_self_line04","虽然改造过很多源石设备，但我最怀念的还是小时候奶奶送给我的那根法杖，“现在它可以陪着你去改造世界”，这句话我一直记到今天。","信赖对话4",{"_4051":16,"_15":4272,"_4093":64,"_4094":4120,"_4124":4273,"_4126":4274,"_4128":1263,"_4129":4275},"chr_0023_antal_31","chr_0023_antal_mono_self_line05","奶奶曾经告诉过我，研究者穷极一生去向世界寻求答案固然浪漫，但在道路上无人陪伴岂不太过孤独？我以前一直不明白她的意思，但当我有了新思路想把这份喜悦分享给您，而您却不在我身边时，我终于理解她说的孤独是什么意思。","信赖对话5",{"_4051":16,"_15":4277,"_4093":37,"_4094":37,"_4124":4278,"_4126":4279,"_4128":1302,"_4129":4280},"chr_0023_antal_32","chr_0023_antal_mono_chat_line01","萤石教过我一个无聊时用来消遣的纸牌游戏，还提出输家要答应赢家一个要求。我们玩了五次，现在她要为我单独开设五节课，一对一辅导，课程内容是“如何让人迅速变成聊天高手”。","交谈1",{"_4051":16,"_15":4282,"_4093":37,"_4094":37,"_4124":4283,"_4126":4284,"_4128":118,"_4129":4285},"chr_0023_antal_33","chr_0023_antal_mono_chat_line02","您要去吃晚餐了吗？不，我不能去。由于我私自捕获了一只天使没向队长报备，她罚我今天晚上不准去餐厅进食。","交谈2",{"_4051":16,"_15":4287,"_4093":37,"_4094":37,"_4124":4288,"_4126":4289,"_4128":1380,"_4129":4290},"chr_0023_antal_34","chr_0023_antal_mono_chat_line03","为什么加入Z7行动组而没参加科研项目？事实上，我最初的就职意向的确是去研发中心。不过那时面试我的是秋栗队长，她认为比起待在研究室，通过实战去测试改造的源石设备，更易于发现一些性能问题。我同意她的看法，所以加入了她的队伍。","交谈3",{"_4051":16,"_15":4292,"_4093":37,"_4094":37,"_4124":4293,"_4126":4294,"_4128":1420,"_4129":4295},"chr_0023_antal_35","chr_0023_antal_mono_chat_line04","为什么执着于讲各种冷笑话？因为读书时有人指出我缺乏幽默感，我认为对方说得没错，这是一种缺陷，必须得到修正。","交谈4",{"_4051":16,"_15":4297,"_4093":37,"_4094":37,"_4124":4298,"_4126":4299,"_4128":157,"_4129":4300},"chr_0023_antal_36","chr_0023_antal_mono_chat_line05","加入终末地离开家的时候，奶奶说她很高兴，她觉得这是一次机会：可以让我稍微将注意力从书籍和源石装置转移到别的地方——去和队友好好相处，再交个朋友。","交谈5",{"_4051":16,"_15":4302,"_4093":37,"_4094":37,"_4124":4303,"_4126":4304,"_4128":1498,"_4129":4305},"chr_0023_antal_37","chr_0023_antal_mono_about_line01","秋栗队长吗？招我进来的人，好说话，我什么都听她的。虽然她平时总说没问题我们可以的，但她又经常失眠，半夜一个人在外面散步，问她原因也不说，您知道为什么吗？","话题：秋栗",{"_4051":16,"_15":4307,"_4093":37,"_4094":37,"_4124":4308,"_4126":4309,"_4128":1537,"_4129":4310},"chr_0023_antal_38","chr_0023_antal_mono_about_line02","外出执行任务时，小队饮食都是卡契尔在负责，厨具在他手上比我的浮游炮还听话。只不过下雨的时候他就不怎么理人，但又不赶人走，很奇怪。","话题：卡契尔",{"_4051":16,"_15":4312,"_4093":37,"_4094":37,"_4124":4313,"_4126":4314,"_4128":41,"_4129":4315},"chr_0023_antal_39","chr_0023_antal_mono_about_line03","某种程度来说，萤石也算是我的鳞片伙伴。我喜欢她的尾巴，结实有力，但她不让我进一步接触。除此以外，她说话还很艺术，我应该向她学习。","话题：萤石",{"_4051":16,"_15":4317,"_4093":37,"_4094":37,"_4124":4318,"_4126":4319,"_412