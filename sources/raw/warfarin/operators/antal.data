],"</color></mark>",[7681,7682,7681],"<mark=#444444><color=#44444400>","<mark=#E6E6E6><color=#E6E6E600>","qu.largenumdown",{"_15":7683,"_7242":7685,"_7245":7687},[7686,7686,7686],"</color></size>",[7688,7688,7688],"<size=54><color=#e74414>","nar.quote",{"_15":7689,"_7242":7691,"_7245":7693},[7692,7692,7692],"</i>",[7694,7694,7694],"<i>","nar.right",{"_15":7695,"_7242":7697,"_7245":7698},[7581,7581,7581],[7699,7699,7699],"<align=\"right\">","opt.key",{"_15":7700,"_7242":7702,"_7245":7703},[7244,7244,7244],[7704,7704,7704],"<color=#5ECDFF>","qu.numdown",{"_15":7705,"_7242":7707,"_7245":7708},[7244,7244,7244],[7709,7709,7709],"<color=#e74414>","toast_craft.key",{"_15":7710,"_7242":7712,"_7245":7713},[7244,7244,7244],[7297,7297,7298],"qu.numup",{"_15":7714,"_7242":7716,"_7245":7717},[7244,7244,7244],[7718,7718,7718],"<color=#c7fe02>","rac.tec",{"_15":7719,"_7242":7721,"_7245":7722},[7244,7244,7244],[7723,7723,7723],"<color=#FFCC00>","scene_grade.down",{"_15":7724,"_7242":7726,"_7245":7727},[7244,7244,7244],[7728,7728,7728],"<color=#D12E42>","set.key",{"_15":7729,"_7242":7731,"_7245":7732},[7244,7244,7244],[7733,7733,7733],"<color=#A7A7A7>","tech.get",{"_15":7734,"_7242":7736,"_7245":7737},[7244,7244,7244],[7738,7738,7738],"<color=#1e1e1e>","tips.key",{"_15":7739,"_7242":7741,"_7245":7742},[7244,7244,7244],[7743,7744,7743],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":7745,"_7242":7747,"_7245":7748},[7244,7244,7244],[7532,7533,7534],"toast_focal.key",{"_15":7749,"_7242":7751,"_7245":7752},[7244,7244,7244],[7744,7744,7744],"weapon.stress",{"_15":7753,"_7242":7755,"_7245":7756},[7244,7244,7244],[7757,7757,7757],"<color=#fe5a00>","weekraid.key",{"_15":7758,"_7242":7760,"_7245":7761},[7401,7401,7401],[7762,7762,7763],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_7766":7767,"_7773":7774,"_7455":7778,"_7783":7784,"_7787":7788,"_7792":7793,"_7796":7797,"_7801":7802,"_7805":7806,"_7810":7811,"_7814":7815,"_7270":7819,"_7824":7825,"_7828":7829,"_7833":7834,"_7838":7839,"_7842":7843,"_7847":7848,"_7353":7851,"_7856":7857,"_7860":7861,"_7866":7867,"_7359":7870,"_7875":7876,"_7879":7880,"_7377":7884,"_7889":7890,"_7893":7894,"_7384":7898,"_7903":7904,"_7909":7910,"_7408":7914,"_7919":7920,"_7924":7925,"_7929":7930,"_7934":7935,"_7415":7939,"_7943":7944,"_7948":7949,"_7953":7954,"_7957":7958,"_7963":7964,"_7968":7969,"_7445":7973,"_7978":7979,"_7983":7984,"_7986":7987,"_7990":7991,"_7995":7996,"_7999":8000,"_8005":8006,"_8009":8010,"_8014":8015,"_8019":8020,"_7462":8024,"_8028":8029,"_8031":8032,"_7482":8036,"_8040":8041,"_8045":8046,"_8050":8051,"_8055":8056,"_8059":8060,"_8064":8065,"_7282":8070,"_7321":8074,"_8079":8080,"_8084":8085,"_8089":8090,"_7508":8094,"_8099":8100,"_8102":8103,"_8106":8107,"_8110":8111,"_8115":8116,"_8120":8121,"_8124":8125,"_8129":8130,"_7548":8134,"_8138":8139,"_8143":8144,"_8148":8149,"_8153":8154,"_8157":8158,"_8161":8162,"_8166":8167,"_8171":8172,"_8175":8176,"_8181":8182,"_8185":8186,"_8189":8190,"_8194":8195,"_8198":8199,"_8202":8203,"_8206":8207,"_8212":8213,"_8217":8218,"_8222":8223,"_8227":8228,"_8232":8233,"_8237":8238,"_8242":8243,"_8247":8248,"_8252":8253,"_8257":8258,"_8262":8263,"_8267":8268,"_8272":8273,"_8277":8278},"adv.electricFence",{"_4617":7768,"_7769":4058,"_15":7766,"_7770":4058,"_19":7771,"_7772":7338},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4617":7775,"_7769":7776,"_15":7773,"_7770":4058,"_19":7777,"_7772":7391},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4617":7779,"_7769":7780,"_15":7455,"_7770":7781,"_19":7782,"_7772":7520},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4617":7785,"_7769":4058,"_15":7783,"_7770":4058,"_19":7786,"_7772":7338},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4617":7789,"_7769":7790,"_15":7787,"_7770":4058,"_19":7791,"_7772":7338},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4617":7794,"_7769":4058,"_15":7792,"_7770":4058,"_19":7795,"_7772":7338},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4617":7798,"_7769":7799,"_15":7796,"_7770":4058,"_19":7800,"_7772":7432},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4617":7803,"_7769":4058,"_15":7801,"_7770":4058,"_19":7804,"_7772":7338},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4617":7807,"_7769":7808,"_15":7805,"_7770":4058,"_19":7809,"_7772":7338},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4617":7812,"_7769":4058,"_15":7810,"_7770":4058,"_19":7813,"_7772":4058},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4617":7816,"_7769":7817,"_15":7814,"_7770":4058,"_19":7818,"_7772":7391},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4617":7820,"_7769":7821,"_15":7270,"_7770":7822,"_19":7823,"_7772":7520},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4617":7826,"_7769":4058,"_15":7824,"_7770":4058,"_19":7827,"_7772":7338},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4617":7830,"_7769":7831,"_15":7828,"_7770":4058,"_19":7832,"_7772":7338},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4617":7835,"_7769":7836,"_15":7833,"_7770":4058,"_19":7837,"_7772":7338},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4617":7840,"_7769":4058,"_15":7838,"_7770":4058,"_19":7841,"_7772":7365},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4617":7844,"_7769":7845,"_15":7842,"_7770":4058,"_19":7846,"_7772":7338},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4617":7849,"_7769":4058,"_15":7847,"_7770":4058,"_19":7850,"_7772":7365},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4617":7852,"_7769":7853,"_15":7353,"_7770":7854,"_19":7855,"_7772":7432},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4617":7858,"_7769":7853,"_15":7856,"_7770":4058,"_19":7859,"_7772":7432},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4617":7862,"_7769":7863,"_15":7860,"_7770":7864,"_19":7865,"_7772":7365},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4617":7868,"_7769":4058,"_15":7866,"_7770":4058,"_19":7869,"_7772":7365},"持续时间内，受影响的目标暂停行动。","定身",{"_4617":7871,"_7769":7872,"_15":7359,"_7770":7873,"_19":7874,"_7772":7544},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4617":7877,"_7769":7872,"_15":7875,"_7770":4058,"_19":7878,"_7772":7544},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4617":7881,"_7769":4058,"_15":7879,"_7770":7882,"_19":7883,"_7772":4058},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4617":7885,"_7769":7886,"_15":7377,"_7770":7887,"_19":7888,"_7772":7494},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4617":7891,"_7769":7886,"_15":7889,"_7770":4058,"_19":7892,"_7772":7494},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4617":7895,"_7769":7896,"_15":7893,"_7770":4058,"_19":7897,"_7772":7338},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4617":7899,"_7769":7900,"_15":7384,"_7770":7901,"_19":7902,"_7772":7520},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4617":7905,"_7769":7906,"_15":7903,"_7770":7907,"_19":7908,"_7772":7365},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4617":7911,"_7769":7912,"_15":7909,"_7770":4058,"_19":7913,"_7772":7365},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4617":7915,"_7769":7916,"_15":7408,"_7770":7917,"_19":7918,"_7772":7391},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4617":7921,"_7769":4058,"_15":7919,"_7770":7922,"_19":7923,"_7772":7391},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4617":7926,"_7769":7927,"_15":7924,"_7770":4058,"_19":7928,"_7772":7338},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4617":7931,"_7769":7932,"_15":7929,"_7770":4058,"_19":7933,"_7772":7338},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4617":7936,"_7769":7937,"_15":7934,"_7770":4058,"_19":7938,"_7772":7391},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4617":7940,"_7769":7776,"_15":7415,"_7770":7941,"_19":7942,"_7772":7391},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4617":7945,"_7769":4058,"_15":7943,"_7770":7946,"_19":7947,"_7772":7365},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4617":7950,"_7769":7951,"_15":7948,"_7770":4058,"_19":7952,"_7772":7338},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4617":7955,"_7769":4058,"_15":7953,"_7770":4058,"_19":7956,"_7772":4058},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4617":7959,"_7769":7960,"_15":7957,"_7770":7961,"_19":7962,"_7772":7365},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4617":7965,"_7769":7966,"_15":7963,"_7770":4058,"_19":7967,"_7772":7338},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4617":7970,"_7769":4058,"_15":7968,"_7770":7971,"_19":7972,"_7772":7432},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4617":7974,"_7769":7975,"_15":7445,"_7770":7976,"_19":7977,"_7772":7432},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4617":7980,"_7769":7981,"_15":7978,"_7770":4058,"_19":7982,"_7772":7338},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4617":7858,"_7769":7975,"_15":7983,"_7770":4058,"_19":7985,"_7772":7432},"干员受到灼热附着","sys.tacticalItem",{"_4617":7988,"_7769":4058,"_15":7986,"_7770":4058,"_19":7989,"_7772":7338},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4617":7992,"_7769":7993,"_15":7990,"_7770":4058,"_19":7994,"_7772":7432},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4617":7877,"_7769":7997,"_15":7995,"_7770":4058,"_19":7998,"_7772":7544},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4617":8001,"_7769":8002,"_15":7999,"_7770":8003,"_19":8004,"_7772":7365},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4617":8007,"_7769":4058,"_15":8005,"_7770":4058,"_19":8008,"_7772":7365},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4617":8011,"_7769":8012,"_15":8009,"_7770":4058,"_19":8013,"_7772":7520},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4617":8016,"_7769":8017,"_15":8014,"_7770":4058,"_19":8018,"_7772":7544},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4617":8021,"_7769":8022,"_15":8019,"_7770":4058,"_19":8023,"_7772":7365},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4617":8025,"_7769":8026,"_15":7462,"_7770":7917,"_19":8027,"_7772":7391},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4617":7775,"_7769":8026,"_15":8028,"_7770":4058,"_19":8030,"_7772":7391},"干员受到冻结","ba.naturalvul",{"_4617":8033,"_7769":8034,"_15":8031,"_7770":4058,"_19":8035,"_7772":7494},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4617":7820,"_7769":8037,"_15":7482,"_7770":8038,"_19":8039,"_7772":7520},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4617":8042,"_7769":8043,"_15":8040,"_7770":4058,"_19":8044,"_7772":7338},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4617":8047,"_7769":8048,"_15":8045,"_7770":4058,"_19":8049,"_7772":7338},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4617":8052,"_7769":8053,"_15":8050,"_7770":4058,"_19":8054,"_7772":7338},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4617":8057,"_7769":4058,"_15":8055,"_7770":4058,"_19":8058,"_7772":7338},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4617":8061,"_7769":4058,"_15":8059,"_7770":8062,"_19":8063,"_7772":4058},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4617":8066,"_7769":8067,"_15":8064,"_7770":8068,"_19":8069,"_7772":7365},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4617":8071,"_7769":4058,"_15":7282,"_7770":8072,"_19":8073,"_7772":7494},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4617":8075,"_7769":8076,"_15":7321,"_7770":8077,"_19":8078,"_7772":7520},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4617":8081,"_7769":8082,"_15":8079,"_7770":4058,"_19":8083,"_7772":7338},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4617":8086,"_7769":8087,"_15":8084,"_7770":4058,"_19":8088,"_7772":7494},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4617":8091,"_7769":8092,"_15":8089,"_7770":4058,"_19":8093,"_7772":7338},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4617":8095,"_7769":8096,"_15":7508,"_7770":8097,"_19":8098,"_7772":7494},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4617":7891,"_7769":8096,"_15":8099,"_7770":4058,"_19":8101,"_7772":7494},"干员受到自然附着","ba.originium",{"_4617":8104,"_7769":4058,"_15":8102,"_7770":4058,"_19":8105,"_7772":7365},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4617":8108,"_7769":4058,"_15":8106,"_7770":4058,"_19":8109,"_7772":7520},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4617":8112,"_7769":8113,"_15":8110,"_7770":4058,"_19":8114,"_7772":7520},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4617":8117,"_7769":4058,"_15":8115,"_7770":8118,"_19":8119,"_7772":7528},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4617":8122,"_7769":4058,"_15":8120,"_7770":4058,"_19":8123,"_7772":7338},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4617":8126,"_7769":4058,"_15":8124,"_7770":8127,"_19":8128,"_7772":7544},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4617":8131,"_7769":8132,"_15":8129,"_7770":4058,"_19":8133,"_7772":7338},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4617":8135,"_7769":7997,"_15":7548,"_7770":8136,"_19":8137,"_7772":7544},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4617":8140,"_7769":8141,"_15":8138,"_7770":4058,"_19":8142,"_7772":7544},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4617":8145,"_7769":4058,"_15":8143,"_7770":8146,"_19":8147,"_7772":7365},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4617":8150,"_7769":4058,"_15":8148,"_7770":8151,"_19":8152,"_7772":4058},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4617":8155,"_7769":4058,"_15":8153,"_7770":4058,"_19":8156,"_7772":7338},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4617":8159,"_7769":4058,"_15":8157,"_7770":4058,"_19":8160,"_7772":7365},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4617":8163,"_7769":8164,"_15":8161,"_7770":4058,"_19":8165,"_7772":7338},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4617":8168,"_7769":4058,"_15":8166,"_7770":8169,"_19":8170,"_7772":7365},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4617":8173,"_7769":4058,"_15":8171,"_7770":4058,"_19":8174,"_7772":7338},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4617":8177,"_7769":8178,"_15":8175,"_7770":8179,"_19":8180,"_7772":7365},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4617":8183,"_7769":4058,"_15":8181,"_7770":4058,"_19":8184,"_7772":7365},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4617":8187,"_7769":4058,"_15":8185,"_7770":4058,"_19":8188,"_7772":7365},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4617":8191,"_7769":8192,"_15":8189,"_7770":4058,"_19":8193,"_7772":7338},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4617":8196,"_7769":4058,"_15":8194,"_7770":4058,"_19":8197,"_7772":7365},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4617":8200,"_7769":4058,"_15":8198,"_7770":4058,"_19":8201,"_7772":7365},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4617":8204,"_7769":4058,"_15":8202,"_7770":4058,"_19":8205,"_7772":7365},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4617":8208,"_7769":8209,"_15":8206,"_7770":8210,"_19":8211,"_7772":7365},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4617":8214,"_7769":8215,"_15":8212,"_7770":4058,"_19":8216,"_7772":7338},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4617":8219,"_7769":8220,"_15":8217,"_7770":4058,"_19":8221,"_7772":7338},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4617":8224,"_7769":8225,"_15":8222,"_7770":4058,"_19":8226,"_7772":7338},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4617":8229,"_7769":8230,"_15":8227,"_7770":4058,"_19":8231,"_7772":7338},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4617":8234,"_7769":8235,"_15":8232,"_7770":4058,"_19":8236,"_7772":7338},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4617":8239,"_7769":8240,"_15":8237,"_7770":4058,"_19":8241,"_7772":7338},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4617":8244,"_7769":8245,"_15":8242,"_7770":4058,"_19":8246,"_7772":7338},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4617":8249,"_7769":8250,"_15":8247,"_7770":4058,"_19":8251,"_7772":7338},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4617":8254,"_7769":8255,"_15":8252,"_7770":4058,"_19":8256,"_7772":7338},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4617":8259,"_7769":8260,"_15":8257,"_7770":4058,"_19":8261,"_7772":7338},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4617":8264,"_7769":8265,"_15":8262,"_7770":4058,"_19":8266,"_7772":7338},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4617":8269,"_7769":8270,"_15":8267,"_7770":4058,"_19":8271,"_7772":7338},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4617":8274,"_7769":8275,"_15":8272,"_7770":4058,"_19":8276,"_7772":7338},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4617":8279,"_7769":8280,"_15":8277,"_7770":4058,"_19":8281,"_7772":7338},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_6974":8284,"_6615":8293,"_6495":8295,"_6620":8297,"_6622":8299,"_6624":8301,"_6626":8303,"_6629":8305,"_6632":8307,"_6635":8308,"_5479":8310,"_6640":8312,"_6345":8313,"_6645":8314,"_6647":8316,"_6650":8317,"_6653":8318,"_6656":8319,"_6660":8321,"_6663":8322,"_6667":8323,"_6671":8324,"_6674":8325,"_6678":8326,"_6682":8327,"_6685":8328,"_6689":8329,"_6693":8331,"_6697":8332,"_6701":8334,"_6705":8336,"_6709":8338,"_6713":8339,"_6717":8341,"_6721":8343,"_6725":8344,"_6729":8346,"_6733":8348,"_6737":8350,"_6741":8352,"_6745":8355,"_6749":8358,"_6753":8361,"_6757":8364,"_6761":8365,"_6765":8367,"_6769":8368,"_6773":8369,"_6777":8371,"_6781":8373,"_6785":8374,"_6789":8376,"_6793":8378,"_6797":8380,"_6801":8382,"_6805":8384,"_6809":8386,"_6813":8388,"_6816":8390,"_6820":8392,"_6106":8394,"_6827":8395,"_6831":8397,"_6835":8398,"_6839":8399,"_6843":8400,"_6847":8401,"_6851":8402,"_6855":8403,"_6859":8404,"_6863":8405,"_6867":8406,"_6871":8407,"_6875":8408,"_6879":8409,"_6883":8410,"_6887":8411,"_6891":8412,"_6895":8413,"_6899":8414,"_6903":8415,"_6907":8416,"_6910":8417,"_6914":8418,"_6918":8419,"_6922":8420,"_6926":8421,"_6930":8422,"_6934":8424,"_6938":8425,"_6942":8426,"_8427":8428,"_8429":8430,"_8432":8433,"_8434":8435,"_8436":8437,"_8438":8439,"_8440":8441,"_8442":8443,"_8444":8445,"_8446":8447,"_8448":8449,"_8451":8452,"_8453":8454,"_8456":8457,"_8459":8460,"_8461":8462,"_8464":84