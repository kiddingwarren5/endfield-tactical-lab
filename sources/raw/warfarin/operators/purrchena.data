00652247,{"_36":39,"_38":3905},5832,{"_36":55,"_38":3907},328,{"_36":58,"_38":37},{"_36":60,"_38":3910},1.48469387755102,{"_36":62,"_38":3912},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3932,"_101":64},{"_33":3933},[3934,3936,3938,3940,3942,3944,3946,3948,3949,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969],{"_36":37,"_38":3935},97,{"_36":41,"_38":3937},180.3787081843052,{"_36":44,"_38":3939},100.51083526193982,{"_36":47,"_38":3941},96.16915632232273,{"_36":50,"_38":3943},121.43370502840338,{"_36":39,"_38":3945},5888,{"_36":55,"_38":3947},331,{"_36":58,"_38":37},{"_36":60,"_38":3950},1.48979591836735,{"_36":62,"_38":2012},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3971,"_101":64},{"_33":3972},[3973,3975,3977,3979,3981,3983,3985,3987,3988,3990,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009],{"_36":37,"_38":3974},98,{"_36":41,"_38":3976},182.04502419524567,{"_36":44,"_38":3978},101.47191247633073,{"_36":47,"_38":3980},97.07426888281084,{"_36":50,"_38":3982},122.56633705028432,{"_36":39,"_38":3984},5944,{"_36":55,"_38":3986},334,{"_36":58,"_38":37},{"_36":60,"_38":3989},1.49489795918367,{"_36":62,"_38":3991},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4011,"_101":64},{"_33":4012},[4013,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":963},{"_36":41,"_38":4015},183.71134020618612,{"_36":44,"_38":4017},102.43298969072164,{"_36":47,"_38":4019},97.97938144329896,{"_36":50,"_38":4021},123.69896907216523,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},337,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2050},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_19","tag_15","tag_06","charId","charIllustInitPos",{"_4056":763,"_4057":4058},"x","y",-119,"charPassiveUIPrefabName","","charTypeId","Physical","cvName",{"_4065":4066,"_4067":4068,"_4069":4070,"_4071":4072,"_4053":16},"ChiCVName","韩娇娇","EngCVName","Christine Marie Cabanos","JapCVName","井泽诗织","KorCVName","朴怡偦","defaultWeaponId","wpn_sword_0003","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Purrchena","mainAttrType","phoneticName","profession","profileRecord",[4086,4097,4102,4107,4113,4118],{"_4053":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0038_purrche_1","recordDesc","【代号】噗切娜\n【性别】女\n【身份认证】环塔商会\n【生日】11月26日\n【种族】菲林\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：普通\n作战技巧：优良\n战术规划：标准\n源石技艺适应性：标准","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0038_purrche_2","噗切娜，环塔商会超域环境影响综合征救助基金会形象代言人，现作为终末地工业与环塔商会在超域综合征救助领域的联络员，常驻终末地工业。\n\n我第一次见到噗切娜时，她的阳光开朗，以及与镜头前完全一致的个性给我留下了很深的印象。在交谈中，噗切娜总是会把在场其他干员逗得大笑。\n另一个让我印象深刻的地方，是她的超域综合征。尽管基金会已经提前告知了我们她的特殊病症，但真当她在和我交谈的过程中，突然陷入了沉睡时，我感到了一丝敬佩——即便自己饱受病痛的折磨，也依旧选择要帮助其他的患者，这种利他精神十分可贵。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0038_purrche_3","致终末地工业的佩丽卡监督，商务办公室及人力资源事务部：\n近来是否顺利？\n为进一步推动双方在超域环境影响综合征救助领域的沟通与合作，我特此写信向贵方推荐罗莎琳女士加入终末地工业下属商务办公室。\n首先，我需要向贵方说明罗莎琳女士的病情——属于已确认无法被治愈的超域综合征。超域综合征攻击并损害了她的中枢神经系统，使她会频繁地突然陷入昏睡。但请贵方放心，六年来，我方对其自行防护装置进行的升级迭代，以及长期为她提供的医疗服务，确保了她的日常工作不会受到影响。\n我相信，罗莎琳女士在五年前参与的那场救援行动，贵方一定有所耳闻。根据行动后的总结报告所描述的，当风暴突然折返，救援队与超域综合征患者们只能躲进一处山洞。由于一开始的救援计划是转移患者，这次行动的药物储备十分有限，但幸好罗莎琳女士在与父母一同四处奔波时，便已经在缺乏药物的情况下救助过超域综合征患者，对此有着一定的经验。在她的帮助下，患者们的病情没有进一步恶化。据其他队员汇报时所述，当风暴来到山洞的正上方时，一辆堵在洞口的大篷车滑出了山洞，她立马背着一块木板，堵上了空缺。风暴过后，经我方媒体的报道，“噗切娜”这一名字开始在文明环带中流传。不得不承认，基金会制定的“由救助对象的代表推动救助工作”这一策略，确实达到了不错的效果，为我方提供了大量值得研究的特殊病例的同时，也让多个药企的药物需求及医疗设备需求猛增。\n回想起我第一次见到她的时候，长期不规律的昏睡让她双眼失神、面容憔悴。要不是罗莎琳女士的养父突然联系到了我，根据她当时的状况，即便她的超域综合征不会进一步恶化，她的身体也很难支撑她到成年。出于人道主义原则，也是出于对未来的投资，我们为她提供了完善的医疗服务及教育支持，也因此，我方对其专业能力有充分了解。我相信，通过罗莎琳女士搭建的这座“桥梁”，你我双方将在超域综合征患者的救助这方面，发挥良好的协同效应。\n如贵方希望进一步推进超域环境影响综合征救助领域的合作事宜，我方愿随时为双方的沟通提供支持。感谢贵方抽空阅读此信，期待能在未来达成更多实质性的合作。\n此致\n——海伯格药品有限公司超域综合征事业部负责人，环塔商会超域环境影响综合征救助基金会名誉主席，H","CN_03","档案资料·一",{"_4053":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":4112},"chr_0038_purrche_4","“这里是《探访第一线》访谈节目。我们的记者已经抵达了位于菈梵朵玛北部的超域综合征医疗中心，并联系到了超域环境影响综合征救助基金会的形象代言人，现在让我们连线现场。噗切娜女士，我是缇娜，你那儿能听见吗？”\n“嗯嗯，你好，缇娜！大家好，我是噗切娜，超域环境影响综合征救助基金会的形象代言人哦！”\n“你好，噗切娜女士。目前我们都很关注这次的紧急封锁事件，你能说说那里的情况如何吗？听说事发时你正好在那里慰问超域综合征患者。”\n“欸？可以是可以啦，只是确定要现在讲吗？我记得你们节目有很多小朋友在看欸。”\n“哈哈，请你放心，我们是专业的。要是你讲的内容尺度过大，我们会提醒你的。”\n“嗯嗯，好。因为住在这里的患者们，病情都十分严重。我印象最深刻的一个患者，他背上布满了像是被刀划过的伤痕，我看见有医生用源石碰了一下，伤口就变得扭曲了起来。”\n“这很奇特……也很可怕，能麻烦你详细讲讲超域环境影响综合征吗？目前关于这种病症我们的了解确实不是很多。”\n“嗯……其实和教科书上讲的大差不差啦，要是再细究的话，连我们自己都要看完好几本很厚很厚的书才能勉强理解。不过，用基金会的一个科研人员的话说——比起传统意义上的病症，更像是超域环境影响人体时表现出的独特现象。”\n“好的，我明白了。那这次突然的封锁，真的和官方通报的一样，是因为一位超域综合征患者吗？”\n“是的。”\n“那具体是发生了什么事情呢？有传闻说是发生了和矿石病感染者崩解现象类似的事件？”\n“不一样！崩解现象是在患者死亡后发生的，但超域综合征不是！一开始我还和他说着话，只是一瞬间就……幸好当时只有我在隔离病房里。唉，虽然医疗中心的病情监测系统十分完善，但对这种情况也是一点办法都没有！”\n“嗯……听起来像是，超域综合征的病情发展，很难被预测？”\n“这也是我们救助患者时最困难的地方……而且不可预测的情况还各有不同，有的是病情突然恶化，有的是病征突然发生改变。”\n“病征会突然发生改变？”\n“嗯嗯，就拿我举例子。噗切娜现在的病征是随时都可能会睡着，但要是噗切娜在没有正确穿戴防护装置的时候，跑进了高深度环境，噗切娜就可能会变成……像移动终端损坏时画面里的人那样，闪烁不停；或者是出现了另一个看得见、摸不着的噗切娜，在那里和大家招手打招呼，但真正的噗切娜却像是睡着了一样，怎么叫都叫不醒了。当然，不只是患者，普通人进入高深度环境也有这个风险！”\n“确实是一个变幻莫测的病症。所以大家在进入高深度环境之前，一定要正确穿戴好防护装置。”\n“是的，没错！如果因为各种原因必须要进入高深度环境，一定要正确穿戴防护装置。当然！高深度环境！非必要！不接触！”\n“感谢噗切娜女士的提醒。采访的最后，你还有什么话想对观众朋友们说的吗？”\n“有呀有呀，虽然我们现在并不能治好超域综合征，但是也请大家不要过度慌张，只要不接触高深度环境就不会有患病的风险！也请大家不要把身边的患者当成怪物，超域综合征并不会……并不会……传染……”\n“噗切娜女士？噗切娜女士？”\n“——嘟……”\n“呃……遇到了点技术性故障，接下来让我们连线……”","CN_04","档案资料·二",300,{"_4053":16,"_15":4114,"_4088":4115,"_4090":4116,"_4092":66,"_4093":4117,"_4095":64,"_4096":4112},"chr_0038_purrche_5","…………\n菈梵朵玛，我想我不必复述汐斯塔集团将这座自由市管理得多么井井有条，也不必细讲环塔商会为这座自由市赋予了多么蓬勃的活力。但在讲菈梵朵玛自由市之前，我想先讲讲我在本次旅途中认识到的一个朋友，她为菈梵朵玛篇的撰写给予了很大的帮助。\n我像刚到其他城市时一样，为了思考接下来去哪儿而随便找了一座商场——一如在菈梵朵玛任何一个称得上是商业中心的建筑群。楼宇内挤满了来自环带各地的企业，楼房的中间还有一个全是客人与移动商贩的露天市场，我在这里选了个视野不错的饮品店，刚坐下，就见到了那位很难不让人注意到的“白色菲林玩偶”。一开始我还以为是哪个店家的吉祥物，但仔细观察发现，她并没有招揽客人，反而一直盯着甜品店的橱窗，行人都会热情地和她打招呼，好像这里的每个人都认得她。\n为了了解这座城市的文化，我主动上前打了个招呼。反复确认我不是为了获得什么诸如超域环境影响综合征救助基金会与其他药企是否签订过秘密协议之类的消息而来的小报记者后，她才告诉了我她的身份——请原谅我确实不了解环塔商会的各个企业、基金会或者行政部门的各种代表及他们的代号，我在这次见面结束后才知道“噗切娜”具体是哪几个字。得知我此行是为了记录菈梵朵玛的日常生活，撰写一本旅游指南，她蹦蹦跳跳地带着我离开了这座商场，当起了我的导游——后文的美食推荐指南，便是在这位噗切娜女士的推荐下编写的。或许是她声情并茂的解说——特别是在她突然昏睡又醒来，挠着头道歉后再接着讲解——竟也让环塔商会总部这类建筑变得有趣了起来。\n…………\n当我向她提问，怎么看待菈梵朵玛及其他的自由市时，她却只是笑着说给我介绍一个好玩的地方，便带我离开了四通八达的街道，来到了海滩上。人群很快便将我们分开，但没过多久，我顺着慢慢围成一圈的人们找到了她——她正坐在沙滩上，跟着音乐的节拍摇晃着脑袋，时不时切换脸上电子屏幕的表情吓唬趴在她身上与她玩闹的孩子们。虽然我与他们还有一段距离，但笑声依旧透过音乐传入了我的耳中。周围的其他人要么拿出相机拍照，要么加入到孩子们的狂欢里，随着音乐的旋律舞动了起来，她的周围充满了欢声笑语。等到人群散去，孩子们在家长的带领下依依不舍地同她告别，我才得以走近她，注意到她又陷入了沉睡，但依旧晃动着脑袋。我在她身边坐下，听着她轻轻的呼吸声——一定是做了一场美梦。\n——《我们脚下的塔卫二》菈梵朵玛篇序言，附有一张噗切娜与孩童们一起玩耍的照片","CN_05","档案资料·三",{"_4053":16,"_15":4119,"_4088":4120,"_4090":4121,"_4092":68,"_4093":4122,"_4095":64,"_4096":4123},"chr_0038_purrche_6","145年11月2日，天气晴。今天妈妈把大篷车开到了一个停了很多大篷车的地方，这里的叔叔阿姨们帮妈妈给大篷车升了个级，现在大篷车变得好大好大，就算直接睡在地板上也很舒服，再也不怕突然倒下后受伤啦！叔叔阿姨还给我吃了一个很好吃很好吃的点心，好像叫怪味鳞干。哼哼，等以后长大了，我要买好多好多怪味鳞干，给大篷车塞得满满的！\n…………\n146年5月7日，天气雪转晴。妈妈和一些叔叔阿姨开着一队大篷车，到了一座雪山上的城市，还好大篷车里很温暖！我和妈妈一点都不觉得冷，嘿嘿，就让爸爸自己一个人去外面找宝藏吧。爸爸这次找到了一个机器骨头，爸爸说，等把这个机器骨头修好后，我就可以出去和其他小朋友们一起玩啦！\n…………\n146年6月23日，天气阴转雨。机器骨头好像不喜欢下雨，站在雨里不动了。还好一起来的小朋友们都带了伞，在雨里陪我等爸爸妈妈。但后面的事情我就不记得了，我好像做了个梦，梦见我骑在会飞的驮兽身上，去了好多好多地方。等我醒了后，妈妈不知道为什么抱着我哭，爸爸好像在怪机器骨头。我想安慰妈妈，但妈妈哭得更厉害了……我讨厌睡着……\n…………\n146年7月16日，天气晴。又到这个拍电影的地方来了，这里有好多好看的衣服，我最喜欢的地方就是这里！我刚帮叔叔阿姨们把大篷车上的箱子搬下车，爸爸就带了一个穿得很干净的叔叔回来了。叔叔没有我灵活，明明能把整个塔卫二都装进来的大篷车，他都要小心翼翼地在车里绕来绕去。妈妈今天也很高兴，拿了很多平时只在我们生日时才拿出来的好吃的出来。\n…………\n146年8月20日，天气阴。这辆大篷车和妈妈的不一样，上面很干净，有好多铁箱子，很挤，也冷冰冰的……还有好多穿白衣服的叔叔阿姨，明明都是笑着看我，但为什么我感觉不到开心？爸爸认识的那个叔叔给了我一个很奇怪的小盒子，明明能听见爸爸妈妈的声音，但把小盒子拆开后却没有找到他们。\n…………\n146年12月18日，天气晴。今天是我第一次参加救援任务，队友们都是熟人，大篷车上虽然很挤，但大家都有说有笑的，我很喜欢这个氛围。就是基金会的几个负责人觉得我去那种地方太危险了，以后不允许我参加这种级别的救援行动，气死我了！明明任务完成得那么完美，风暴突然跑回来又不是我的错。不过，行动完成后，我见到了爸爸妈妈，我还和妈妈一起把病人们送去了最近的城市接受治疗，欸，上一次见面是什么时候来着？\n…………\n151年11月7日，天气晴。明天就到目的地了，日子过得好快呀，总感觉收到终末地工业的回函还是昨天的事。管理员究竟长什么样呢？真的和教科书上写的一样吗？唉，好无聊，这辆大篷车上空荡荡的，什么东西都没有。对了，今天我遇到了爸妈，他们正把菈梵朵玛的物资送往四号谷地。我们还拍了一张合照，这样爸妈就能在照片上看见我，就不用太想我啦。不过，妈妈的大篷车虽然装饰得和小时候一模一样，但为什么总觉得有什么地方变得不一样了？","CN_06","档案资料·四",1500,"profileVoice",[4126,4134,4138,4142,4146,4150,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4435,4441,4447,4452,4458,4464,4469,4475,4480,4486,4492,4498,4504,4510,4515,4521,4526,4531,4537],{"_4053":16,"_15":4087,"_4095":37,"_4096":37,"_4127":4128,"_4129":4130,"_4131":39,"_4132":4133},"voId","chr_0038_purrche_chrbark_squad_01","voiceDesc","又到我……“你好。”……呃，怎么又睡着了！","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4098,"_4095":37,"_4096":37,"_4127":4135,"_4129":4136,"_4131":55,"_4132":4137},"chr_0038_purrche_chrbark_squad_02","嗯……欸！是有什么任务吗？","行动准备2",{"_4053":16,"_15":4103,"_4095":37,"_4096":37,"_4127":4139,"_4129":4140,"_4131":58,"_4132":4141},"chr_0038_purrche_chrbark_join_01","我现在一点也不困哦。","编入队伍1",{"_4053":16,"_15":4108,"_4095":37,"_4096":37,"_4127":4143,"_4129":4144,"_4131":64,"_4132":4145},"chr_0038_purrche_chrbark_join_02","棉花糖、怪味鳞干……嗯，可以出发了！","编入队伍2",{"_4053":16,"_15":4114,"_4095":37,"_4096":37,"_4127":4147,"_4129":4148,"_4131":66,"_4132":4149},"chr_0038_purrche_chrbark_weap_01","喔，很顺手哎！要是把点心插在上面，是不是就不会弄脏外壳上的毛毛了。","更换武器",{"_4053":16,"_15":4119,"_4095":37,"_4096":37,"_4127":4151,"_4129":4152,"_4131":68,"_4132":4153},"chr_0038_purrche_chrbark_gear_01","这装备，居然能套在我的外壳上……“怪味鳞干，好吃！”……欸，我还没睡着啊？！","更换装备",{"_4053":16,"_15":4155,"_4095":37,"_4096":37,"_4127":4156,"_4129":4157,"_4131":70,"_4132":4158},"chr_0038_purrche_7","chr_0038_purrche_chrup_skill_01","嗯……嗯！病理学的实验课题我好像有头绪了！不对，哪儿来的头绪？","激活天赋阵列",{"_4053":16,"_15":4160,"_4095":37,"_4096":37,"_4127":4161,"_4129":4162,"_4131":88,"_4132":4163},"chr_0038_purrche_8","chr_0038_purrche_chrup_level_01","之前在环塔商会确实没学到过这些……原来还能这样。","观看作战记录",{"_4053":16,"_15":4165,"_4095":55,"_4096":39,"_4127":4166,"_4129":4167,"_4131":90,"_4132":4168},"chr_0038_purrche_9","chr_0038_purrche_chrup_promt01_01","晋升？我以前参加过基金会的晋升庆祝会，桌上摆满了好多点心……欸，我们没有庆祝晋升的点心吗？","精英化晋升1",{"_4053":16,"_15":4170,"_4095":55,"_4096":55,"_4127":4171,"_4129":4172,"_4131":410,"_4132":4173},"chr_0038_purrche_10","chr_0038_purrche_chrup_promt02_01","我吗？真的吗？太好了，我要告诉爸妈，还有在城里的朋友们，他们一定……一定……会很开心……“再见！”","精英化晋升2",{"_4053":16,"_15":4175,"_4095":55,"_4096":58,"_4127":4176,"_4129":4177,"_4131":100,"_4132":4178},"chr_0038_purrche_11","chr_0038_purrche_chrup_promt03_01","这么快的晋升，我没有在做梦吧！既然如此，保护大家的工作，就放心地交给我吧！","精英化晋升3",{"_4053":16,"_15":4180,"_4095":55,"_4096":64,"_4127":4181,"_4129":4182,"_4131":95,"_4132":4183},"chr_0038_purrche_12","chr_0038_purrche_chrup_promt04_01","我一直在想，要是我当初没有答应跟基金会去菈梵朵玛，我会在什么地方……哼哼，不管在哪儿，我也一定是像现在这样在帮助别人吧！","精英化晋升4",{"_4053":16,"_15":4185,"_4095":37,"_4096":37,"_4127":4186,"_4129":4187,"_4131":527,"_4132":4188},"chr_0038_purrche_13","chr_0038_purrche_introduce_01","管理员你好，我是超域环境影响综合征救助基金会形象代言人——噗切娜，我的梦想是成为像你……一样的……“我是超域环境影响综合征救助基金会形象代言人——噗切娜！”……欸？糟了糟了，我又睡着了！","干员报到",{"_4053":16,"_15":4190,"_4095":37,"_4096":37,"_4127":4191,"_4129":4192,"_4131":566,"_4132":4193},"chr_0038_purrche_14","chr_0038_purrche_mono_switch_01","嗨，管理员，我没有睡着哦！","待命1",{"_4053":16,"_15":4195,"_4095":37,"_4096":37,"_4127":4196,"_4129":4197,"_4131":97,"_4132":4198},"chr_0038_purrche_15","chr_0038_purrche_mono_switch_02","我这里有很多点心，管理员，你要尝尝吗？","待命2",{"_4053":16,"_15":4200,"_4095":37,"_4096":37,"_4127":4201,"_4129":4202,"_4131":872,"_4132":4203},"chr_0038_purrche_21","chr_0038_purrche_sim_assign_work_01","不用担心我会突然睡着，我睡着了外壳也会接着工作的。","进驻设施",{"_4053":16,"_15":4205,"_4095":37,"_4096":37,"_4127":4206,"_4129":4207,"_4131":911,"_4132":4208},"chr_0038_purrche_22","chr_0038_purrche_sim_hello_lower_01","嗨，管理员，你要吃怪味鳞干吗？","打招呼1",{"_4053":16,"_15":4210,"_4095":64,"_4096":4112,"_4127":4211,"_4129":4212,"_4131":951,"_4132":4213},"chr_0038_purrche_23","chr_0038_purrche_sim_hello_max_01","“再见！”……嗯？管理员，你好！","打招呼2",{"_4053":16,"_15":4215,"_4095":37,"_4096":37,"_4127":4216,"_4129":4217,"_4131":990,"_4132":4218},"chr_0038_purrche_24","chr_0038_purrche_sim_talk_lv01_01","帝江号和我住过的地方完全不一样！这里能看见塔卫二的全景，还有很多我不认识，以前只在书上见到过的设备，好厉害！","帝江号闲聊1",{"_4053":16,"_15":4220,"_4095":64,"_4096":4112,"_4127":4221,"_4129":4222,"_4131":62,"_4132":4223},"chr_0038_purrche_25","chr_0038_purrche_sim_talk_lv02_01","嗨，管理员！啊？食堂的后勤干员说我有点放不开？我吗？哪有，我只是怕点心拿得太多了。咦？可以随便拿？太好了！我、我要去多拿点！","帝江号闲聊2",{"_4053":16,"_15":4225,"_4095":64,"_4096":4112,"_4127":4226,"_4129":4227,"_4131":1068,"_4132":4228},"chr_0038_purrche_26","chr_0038_purrche_sim_talk_lv02_02","管理员，我刚完成救助患者的任务回来。我和那里的小朋友们讲了终末地的故事，他们都很喜欢！什么故事？当然是……是……“怪味鳞干，好吃！”“最喜欢怪味鳞干了。”","帝江号闲聊3",{"_4053":16,"_15":4230,"_4095":64,"_4096":4123,"_4127":4231,"_4129":4232,"_4131":1108,"_4132":4233},"chr_0038_purrche_27","chr_0038_purrche_sim_talk_max_01","管理员！这是我烤的棉花糖！焦了一半？嘿嘿，烤的时候不小心睡着了……","帝江号闲聊4",{"_4053":16,"_15":4235,"_4095":64,"_4096":4123,"_4127":4236,"_4129":4237,"_4131":1147,"_4132":4238},"chr_0038_purrche_28","chr_0038_purrche_sim_talk_max_02","嗯——好累……那个叔叔家的驮兽也太不听话了……嗯？为什么不等待其他干员支援？因为帮助超域综合征患者就是我的工作，嘿嘿！","帝江号闲聊5",{"_4053":16,"_15":4240,"_4095":64,"_4096":4123,"_4127":4241,"_4129":4242,"_4131":1187,"_4132":4243},"chr_0038_purrche_29","chr_0038_purrche_sim_talk_max_03","为什么这么喜欢吃点心？因为我每次吃完点心，感觉自己就会放松下来，好像飞到了云朵上面一样……“你好，我是噗切娜！”","帝江号闲聊6",{"_4053":16,"_15":4245,"_4095":37,"_4096":37,"_4127":4246,"_4129":4247,"_4131":56,"_4132":4248},"chr_0038_purrche_30","chr_0038_purrche_sim_gift_give_01","锵锵，管理员，这可是我精心挑选的礼物，一定很合你的胃口！没人比我更懂点心啦，我可是很懂里面的门道的哦！","赠送礼物",{"_4053":16,"_15":4250,"_4095":37,"_4096":37,"_4127":4251,"_4129":4252,"_4131":1265,"_4132":4253},"chr_0038_purrche_31","chr_0038_purrche_sim_gift_recv_01","欸，谢谢管理员……呃，差点又睡着了！呼，好险好险，还好没掉地上。","接收礼物",{"_4053":16,"_15":4255,"_4095":37,"_4096":37,"_4127":4256,"_4129":4257,"_4131":47,"_4132":4258},"chr_0038_purrche_41","chr_0038_purrche_mono_self_line01","我在菈梵朵玛上学的时候，从教科书里看到了终末地工业的事迹，那时我才知道，终末地在推动超域疾病防治事业的发展上付出过很多努力……在塔卫二，超域环境会引发罕见的综合征，我想要帮助患者们，所以我就在基金会叔叔阿姨的推荐下，自告奋勇来终末地报到啦。","信赖对话1",{"_4053":16,"_15":4260,"_4095":64,"_4096":4112,"_4127":4261,"_4129":4262,"_4131":50,"_4132":4263},"chr_0038_purrche_42","chr_0038_purrche_mono_self_line02","嗨，管理员！“超域环境影响综合征救助基金会形象代言人”？对呀，报道的就是我，不过没那么夸张……我哪有抱着患者翻山越岭，只是和妈妈一起开大篷车，把他送到了医院而已。父母为什么都不是菲林？因为爸妈的爸妈也不是菲林呀。","信赖对话2",{"_4053":16,"_15":4265,"_4095":64,"_4096":4112,"_4127":4266,"_4129":4267,"_4131":232,"_4132":4268},"chr_0038_purrche_43","chr_0038_purrche_mono_self_line03","我的玩偶外壳？小时候爸爸给我做过一个。他把回收的机械骨骼修好了，又在机械骨骼外面套了件玩偶服，这样我才不会因为突然睡着受伤。那件玩偶服是不太好看啦，但我还是把它保存在了我菈梵朵玛的公寓里！身上这个？哼哼，基金会的技术人员经常帮我升级，这里面可有很多高科技呢！","信赖对话3",{"_4053":16,"_15":4270,"_4095":64,"_4096":4123,"_4127":4271,"_4129":4272,"_4131":1802,"_4132":4273},"chr_0038_purrche_44","chr_0038_purrche_mono_self_line04","有一次，我在一场跨校考试上睡了很久。当我醒来的时候，发现监考老师还有几名学生正满头大汗地朝窗外呼救，原来他们只知道我患有罕见的综合征，却不知道具体的症状，以为我昏过去了，但又打不开我的外壳，老师还摔倒在地上受了点伤……考试成绩？当时我急着把老师送去医务室，提前交了卷，不然我就能拿全科第一了。","信赖对话4",{"_4053":16,"_15":4275,"_4095":64,"_4096":4123,"_4127":4276,"_4129":4277,"_4131":1842,"_4132":4278},"chr_0038_purrche_45","chr_0038_purrche_mono_self_line05","妈妈开大篷车送物资的时候，在荒野上捡到了我……小时候，他们经常陪我在大篷车上一起数星星，玩游戏。后来，基金会发现我患有特殊的病症，认为我可以一边接受治疗，一边当基金会的形象代言人，就把我带到了菈梵朵玛。直到加入了基金会我才知道，不只是我，还有好多人都被超域综合征折磨。嘿嘿，我能帮到他们，真是太好了！","信赖对话5",{"_4053":16,"_15":4280,"_4095":37,"_4096":37,"_4127":4281,"_4129":4282,"_4131":270,"_4132":4283},"chr_0038_purrche_46","chr_0038_purrche_mono_chat_line01","我最喜欢吃的当然是怪味鳞干，新都筑的鳞兽烧也很不错。嘿嘿，之前去新都筑拜访超域综合征患者时，大家都说那里的鳞兽烧是最正宗的。吃过正宗的鳞兽烧后，就总觉得其他地方的鳞兽烧不好吃。什么时候才能再去新都筑哇……嗯，还好有怪味鳞干！","交谈1",{"_4053":16,"_15":4285,"_4095":37,"_4096":37,"_4127":4286,"_4129":4287,"_4131":1920,"_4132":4288},"chr_0038_purrche_47","chr_0038_purrche_mono_chat_line02","有人说我是玩偶机器人？才不是！塔卫二哪有这样的机器人啊！就算有也不会和噗切娜一样呀！管理员不会是当真了吧？电子音？才不是合成的！那是我怕大家不知道我睡着了，提前录进去的呀，我播给你听……“你好！”“再见！”“怪味鳞干，好吃！”“管理员的面具里，会不会藏了好吃的？”不对不对，这句话怎么也录进去了啊！","交谈2",{"_4053":16,"_15":4290,"_4095":37,"_4096":37,"_4127":4291,"_4129":4292,"_4131":72,"_4132":4293},"chr_0038_purrche_48","chr_0038_purrche_mono_chat_line03","我平时怎么注射药物？爸爸在外壳里面装了定时注射器，商会的叔叔阿姨还帮我升级了下。怎么吃东西？怎么清洁？唔……基金会的技术人员给我安装了清洁系统，不小心掉落的食物碎屑都会被清洁干净的！吃东西嘛，就像这样，啊——嗯……嗯！烫烫烫烫烫……呼，得救了，还好有水，差点以为要被烫死了……就这样，管理员，嘿嘿……","交谈3",{"_4053":16,"_15":4295,"_4095":37,"_4096":37,"_4127":4296,"_4129":4297,"_4131":60,"_4132":4298},"chr_0038_purrche_49","chr_0038_purrche_mono_chat_line04","我的样子？噗切娜当然就长噗切娜这样，毛绒绒的……里面？欸，原来管理员也对我的长相感兴趣呀。哼哼，噗切娜，就像是棉花糖一样！嘿嘿，开玩笑的啦，其实我……我……我有点……困……“怪味鳞干，尝尝！”","交谈4",{"_4053":16,"_15":4300,"_4095":37,"_4096":37,"_4127":4301,"_4129":4302,"_4131":76,"_4132":4303},"chr_0038_purrche_50","chr_0038_purrche_mono_chat_line05","当然当然，大家都挺喜欢我的造型！不管是基金会里一直照顾我的朋友，被我帮助后认识的朋友，还是终末地帮助过我的朋友，大家总会冲过来抱着我。特别是在天气冷的时候，他们都会说，软乎乎的，还暖乎乎的，要是太阳能抱着，肯定也是这种感觉。","交谈5",{"_4053":16,"_15":4305,"_4095":37,"_4096":37,"_4127":4306,"_4129":4307,"_4131":78,"_4132":4308},"chr_0038_purrche_51","chr_0038_purrche_mono_about_line01","我以前经常会跑到很多地方去看望病患们。有的，是和我一样受超域综合征困扰的患者，还有一些……基金会的医生告诉我，目前的医疗技术无能为力。有一次，我和基金会的大家去了一家专为超域综合征患者们搭起来的医疗中心，我在那里……唉，幸好噗切娜有这套外壳，不用一直躺在病床上……希望我真的帮到了他们。","话题：超域综合征",{"_4053":16,"_15":4310,"_4095":37,"_4096":37,"_4127":4311,"_4129":4312,"_4131":80,"_4132":4313},"chr_0038_purrche_52","chr_0038_purrche_mono_about_line02","菈梵朵玛的人们都很热情！菈梵朵玛和其他地方也都不一样。菈梵朵玛没有荒漠，没有拦路的裂地者，全是很大很大的园区，还有大海，还有热闹的音乐节！当然，我最喜欢的还是菈梵朵玛的点心。在城里的时候我都分不清感染者和普通人……唉，要是超域综合征也能像矿石病一样很容易被控制住就好了。","话题：菈梵朵玛",{"_4053":16,"_15":4315,"_4095":37,"_4096":37,"_4127":4316,"_4129":4317,"_4131":82,"_4132":4318},"chr_0038_purrche_53","chr_0038_purrche_mono_about_line03","我记得小时候的大篷车很大很大，妈妈经常开着它，带着我和爸爸到处跑，雪山、沙漠、森林、大湖边，我都去过。别看那时候我年纪很小，已经能帮搬货的工人们把货物搬上车又搬下车，他们都可喜欢我了，给我塞了很多点心。小时候总觉得，全塔卫二的点心都塞不满妈妈的大篷车，但是现在感觉，它好像没那么大了。","话题：大篷车",{"_4053":16,"_15":4320,"_4095":37,"_4096":37,"_4127":4321,"_4129":4322,"_4131":84,"_4132":4323},"chr_0038_purrche_54","chr_0038_purrche_mono_about_line04","管理员，我很不理解，为什么那些裂地者会主动去接触超域能量……他们的癫狂……正是超域综合征的一种典型症状……为什么要把自己变成那种样子？为什么要故意染上我们拼命对抗的怪病？嗯？不像是我说的话？不、不是啦，我只是很生气，真的很生气！","话题：碾骨氏族",{"_4053":16,"_15":4325,"_4095":37,"_4096":37,"_4127":4326,"_4129":4327,"_4131":86,"_4132":4328},"chr_0038_purrche_55","chr_0038_purrche_mono_about_line05","怪味鳞干，好吃……甜甜的……辣辣的……酸酸的……管、管理员？我、我睡着了哦……呼……“怪味鳞干，好吃！”","话题：怪味鳞干！",{"_4053":16,"_15":4330,"_4095":37,"_4096":37,"_4127":4331,"_4129":4332,"_4131":578,"_4132":4333},"chr_0038_purrche_71","chr_0038_purrche_explore_point_common_01","噢！那里好像有好东西！会是好吃的吗？！","发现资源1",{"_4053":16,"_15":4335,"_4095":37,"_4096":37,"_4127":4336,"_4129":4337,"_4131":2924,"_4132":4338},"chr_0038_purrche_72","chr_0038_purrche_explore_point_valub_01","看看我发现了什么！嘿嘿，里面会有些什么宝贝呢？","发现资源2",{"_4053":16,"_15":4340,"_4095":37,"_4096":37,"_4127":4341,"_4129":4342,"_4131":2964,"_4132":4343},"chr_0038_purrche_73","chr_0038_purrche_explore_find_locked_01","嗯？那里是不是在发着光？","发现未探索区域",{"_4053":16,"_15":4345,"_4095":37,"_4096":37,"_4127":4346,"_4129":4347,"_4131":617,"_4132":4348},"chr_0038_purrche_74","chr_0038_purrche_explore_find_danger_01","欸，那边的敌人好像很厉害……但我肯定能保护大家！","发现强敌",{"_4053":16,"_15":4350,"_4095":37,"_4096":37,"_4127":4351,"_4129":4352,"_4131":3042,"_4132":4353},"chr_0038_purrche_75","chr_0038_purrche_interact_mine_valub_01","我的玩偶外壳可不只是看着可爱！","采集矿物1",{"_4053":16,"_15":4355,"_4095":37,"_4096":37,"_4127":4356,"_4129":4357,"_4131":3081,"_4132":4358},"chr_0038_purrche_76","chr_0038_purrche_interact_mine_valub_echo2_01","我来帮忙啦！我的外壳可是有用不完的……用不完的力气……“再见！”","采集矿物2",{"_4053":16,"_15":4360,"_4095":37,"_4096":37,"_4127":4361,"_4129":4362,"_4131":656,"_4132":4363},"chr_0038_purrche_77","chr_0038_purrche_interact_treasure_valub_01","哇，好多宝贝……找找有没有好吃的。","打开储藏箱",{"_4053":16,"_15":4365,"_4095":37,"_4096":37,"_4127":4366,"_4129":4367,"_4131":3159,"_4132":4368},"chr_0038_purrche_78","chr_0038_purrche_interact_etherium_01","《塔卫二环境学》里有关于醚质的描述……嗯……真好看！和书上画的一样，嘿嘿。","获得醚质",{"_4053":16,"_15":4370,"_4095":37,"_4096":37,"_4127":4371,"_4129":4372,"_4131":3199,"_4132":4373},"chr_0038_purrche_79","chr_0038_purrche_interact_blight_break_01","这下，周围的人们还有驮兽就安全啦。","消除侵蚀",{"_4053":16,"_15":4375,"_4095":37,"_4096":37,"_4127":4376,"_4129":4377,"_4131":696,"_4132":4378},"chr_0038_purrche_80","chr_0038_purrche_interact_rest_01","我还不累，还有好多力气……","休整",{"_4053":16,"_15":4380,"_4095":37,"_4096":37,"_4127":4381,"_4129":4382,"_4131":3700,"_4132":4383},"chr_0038_purrche_91","chr_0038_purrche_combat_suppuse_using_01","给你！保持清醒！","使用战术物品1",{"_4053":16,"_15":4385,"_4095":37,"_4096":37,"_4127":4386,"_4129":4387,"_4131":3739,"_4132":4388},"chr_0038_purrche_92","chr_0038_purrche_combat_suppuse_getheal_01","我又充满精力了！","使用战术物品2",{"_4053":16,"_15":4390,"_4095":37,"_4096":37,"_4127":4391,"_4129":4392,"_4131":884,"_4132":4393},"chr_0038_purrche_93","chr_0038_purrche_combat_remind_danger_01","危险，躲到我身后！","危险提醒",{"_4053":16,"_15":4395,"_4095":37,"_4096":37,"_4127":4396,"_4129":4397,"_4131":3817,"_4132":4398},"chr_0038_purrche_94","chr_0038_purrche_combat_hurt_lowhp_01","呼，感觉要睡着了……","负伤",{"_4053":16,"_15":4400,"_4095":37,"_4096":37,"_4127":4401,"_4129":4402,"_4131":3857,"_4132":4403},"chr_0038_purrche_95","chr_0038_purrche_combat_dead_01","对不起，眼睛……睁不开了……","力竭",{"_4053":16,"_15":4405,"_4095":37,"_4096":37,"_4127":4406,"_4129":4407,"_4131":923,"_4132":4408},"chr_0038_purrche_96","chr_0038_purrche_combat_remind_praise_01","好帅，还好看到了！","小队激励1",{"_4053":16,"_15":4410,"_4095":37,"_4096":37,"_4127":4411,"_4129":4412,"_4131":3935,"_4132":4413},"chr_0038_purrche_97","chr_0038_purrche_combat_remind_praise_02","我们真是太厉害了！","小队激励2",{"_4053":16,"_15":4415,"_4095":37,"_4096":37,"_4127":4416,"_4129":4417,"_4131":3974,"_4132":4418},"chr_0038_purrche_98","chr_0038_purrche_combat_remind_praise_echo2_01","嘿嘿，没那么好啦。","回应激励1",{"_4053":16,"_15":4420,"_4095":37,"_4096":37,"_4127":4421,"_4129":4422,"_4131":963,"_4132":4423},"chr_0038_purrche_99","chr_0038_purrche_combat_remind_praise_echo2_02","请你们吃怪味鳞干！","回应激励2",{"_4053":16,"_15":4425,"_4095":37,"_4096":37,"_4127":4426,"_4129":4427,"_4131":1120,"_4132":4428},"chr_0038_purrche_111","chr_0038_purrche_combat_intobattle_01","大家站在我身后！","作战开始1",{"_4053":16,"_15":4430,"_4095":37,"_4096":37,"_4127":4431,"_4129":4432,"_4131":4433,"_4132":4434},"chr_0038_purrche_112","chr_0038_purrche_combat_intobattle_echo2_01","我不会让你们受伤的！",112,"作战开始2",{"_4053":16,"_15":4436,"_4095":37,"_4096":37,"_4127":4437,"_4129":4438,"_4131":4439,"_4132":4440},"chr_0038_purrche_113","chr_0038_purrche_combat_outbattle_nor_01","大家都没受伤吧。",113,"作战胜利1",{"_4053":16,"_15":4442,"_4095":37,"_4096":37,"_4127":4443,"_4129":4444,"_4131":4445,"_4132":4446},"chr_0038_purrche_114","chr_0038_purrche_combat_outbattle_nor_02","形象代言人也不是好惹的……“好吃！”",114,"作战胜利2",{"_4053":16,"_15":4448,"_4095":37,"_4096":37,"_4127":4449,"_4129":4450,"_4131":1159,"_4132":4451},"chr_0038_purrche_115","chr_0038_purrche_combat_outbattle_nor_echo2_01","呼……大家辛苦啦，来吃好吃的！","作战胜利3",{"_4053":16,"_15":4453,"_4095":37,"_4096":37,"_4127":4454,"_4129":4455,"_4131":4456,"_4132":4457},"chr_003