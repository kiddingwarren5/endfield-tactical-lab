"_8023":8497,"_8026":8498},[8025,8025,8025],[8499,8499,8499],"<color=#c7fe02>","rac.tec",{"_15":8500,"_8023":8502,"_8026":8503},[8025,8025,8025],[8504,8504,8504],"<color=#FFCC00>","scene_grade.down",{"_15":8505,"_8023":8507,"_8026":8508},[8025,8025,8025],[8509,8509,8509],"<color=#D12E42>","set.key",{"_15":8510,"_8023":8512,"_8026":8513},[8025,8025,8025],[8514,8514,8514],"<color=#A7A7A7>","tech.get",{"_15":8515,"_8023":8517,"_8026":8518},[8025,8025,8025],[8519,8519,8519],"<color=#1e1e1e>","tips.key",{"_15":8520,"_8023":8522,"_8026":8523},[8025,8025,8025],[8524,8525,8524],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":8526,"_8023":8528,"_8026":8529},[8025,8025,8025],[8313,8314,8315],"toast_focal.key",{"_15":8530,"_8023":8532,"_8026":8533},[8025,8025,8025],[8525,8525,8525],"weapon.stress",{"_15":8534,"_8023":8536,"_8026":8537},[8025,8025,8025],[8538,8538,8538],"<color=#fe5a00>","weekraid.key",{"_15":8539,"_8023":8541,"_8026":8542},[8182,8182,8182],[8543,8543,8544],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_8547":8548,"_8554":8555,"_8236":8559,"_8564":8565,"_8568":8569,"_8573":8574,"_8577":8578,"_8582":8583,"_8586":8587,"_8591":8592,"_8595":8596,"_8051":8600,"_8605":8606,"_8609":8610,"_8614":8615,"_8619":8620,"_8623":8624,"_8628":8629,"_8134":8632,"_8637":8638,"_8641":8642,"_8647":8648,"_8140":8651,"_8656":8657,"_8660":8661,"_8158":8665,"_8670":8671,"_8674":8675,"_8165":8679,"_8684":8685,"_8690":8691,"_8189":8695,"_8700":8701,"_8705":8706,"_8710":8711,"_8715":8716,"_8196":8720,"_8724":8725,"_8729":8730,"_8734":8735,"_8738":8739,"_8744":8745,"_8749":8750,"_8226":8754,"_8759":8760,"_8764":8765,"_8767":8768,"_8771":8772,"_8776":8777,"_8780":8781,"_8786":8787,"_8790":8791,"_8795":8796,"_8800":8801,"_8243":8805,"_8809":8810,"_8812":8813,"_8263":8817,"_8821":8822,"_8826":8827,"_8831":8832,"_8836":8837,"_8840":8841,"_8845":8846,"_8063":8851,"_8102":8855,"_8860":8861,"_8865":8866,"_8870":8871,"_8289":8875,"_8880":8881,"_8883":8884,"_8887":8888,"_8891":8892,"_8896":8897,"_8901":8902,"_8905":8906,"_8910":8911,"_8329":8915,"_8919":8920,"_8924":8925,"_8929":8930,"_8934":8935,"_8938":8939,"_8942":8943,"_8947":8948,"_8952":8953,"_8956":8957,"_8962":8963,"_8966":8967,"_8970":8971,"_8975":8976,"_8979":8980,"_8983":8984,"_8987":8988,"_8993":8994,"_8998":8999,"_9003":9004,"_9008":9009,"_9013":9014,"_9018":9019,"_9023":9024,"_9028":9029,"_9033":9034,"_9038":9039,"_9043":9044,"_9048":9049,"_9053":9054,"_9058":9059},"adv.electricFence",{"_4626":8549,"_8550":4083,"_15":8547,"_8551":4083,"_19":8552,"_8553":8119},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4626":8556,"_8550":8557,"_15":8554,"_8551":4083,"_19":8558,"_8553":8172},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4626":8560,"_8550":8561,"_15":8236,"_8551":8562,"_19":8563,"_8553":8301},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4626":8566,"_8550":4083,"_15":8564,"_8551":4083,"_19":8567,"_8553":8119},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4626":8570,"_8550":8571,"_15":8568,"_8551":4083,"_19":8572,"_8553":8119},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4626":8575,"_8550":4083,"_15":8573,"_8551":4083,"_19":8576,"_8553":8119},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4626":8579,"_8550":8580,"_15":8577,"_8551":4083,"_19":8581,"_8553":8213},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4626":8584,"_8550":4083,"_15":8582,"_8551":4083,"_19":8585,"_8553":8119},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4626":8588,"_8550":8589,"_15":8586,"_8551":4083,"_19":8590,"_8553":8119},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4626":8593,"_8550":4083,"_15":8591,"_8551":4083,"_19":8594,"_8553":4083},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4626":8597,"_8550":8598,"_15":8595,"_8551":4083,"_19":8599,"_8553":8172},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4626":8601,"_8550":8602,"_15":8051,"_8551":8603,"_19":8604,"_8553":8301},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4626":8607,"_8550":4083,"_15":8605,"_8551":4083,"_19":8608,"_8553":8119},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4626":8611,"_8550":8612,"_15":8609,"_8551":4083,"_19":8613,"_8553":8119},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4626":8616,"_8550":8617,"_15":8614,"_8551":4083,"_19":8618,"_8553":8119},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4626":8621,"_8550":4083,"_15":8619,"_8551":4083,"_19":8622,"_8553":8146},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4626":8625,"_8550":8626,"_15":8623,"_8551":4083,"_19":8627,"_8553":8119},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4626":8630,"_8550":4083,"_15":8628,"_8551":4083,"_19":8631,"_8553":8146},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4626":8633,"_8550":8634,"_15":8134,"_8551":8635,"_19":8636,"_8553":8213},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4626":8639,"_8550":8634,"_15":8637,"_8551":4083,"_19":8640,"_8553":8213},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4626":8643,"_8550":8644,"_15":8641,"_8551":8645,"_19":8646,"_8553":8146},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4626":8649,"_8550":4083,"_15":8647,"_8551":4083,"_19":8650,"_8553":8146},"持续时间内，受影响的目标暂停行动。","定身",{"_4626":8652,"_8550":8653,"_15":8140,"_8551":8654,"_19":8655,"_8553":8325},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4626":8658,"_8550":8653,"_15":8656,"_8551":4083,"_19":8659,"_8553":8325},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4626":8662,"_8550":4083,"_15":8660,"_8551":8663,"_19":8664,"_8553":4083},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4626":8666,"_8550":8667,"_15":8158,"_8551":8668,"_19":8669,"_8553":8275},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4626":8672,"_8550":8667,"_15":8670,"_8551":4083,"_19":8673,"_8553":8275},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4626":8676,"_8550":8677,"_15":8674,"_8551":4083,"_19":8678,"_8553":8119},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4626":8680,"_8550":8681,"_15":8165,"_8551":8682,"_19":8683,"_8553":8301},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4626":8686,"_8550":8687,"_15":8684,"_8551":8688,"_19":8689,"_8553":8146},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4626":8692,"_8550":8693,"_15":8690,"_8551":4083,"_19":8694,"_8553":8146},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4626":8696,"_8550":8697,"_15":8189,"_8551":8698,"_19":8699,"_8553":8172},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4626":8702,"_8550":4083,"_15":8700,"_8551":8703,"_19":8704,"_8553":8172},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4626":8707,"_8550":8708,"_15":8705,"_8551":4083,"_19":8709,"_8553":8119},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4626":8712,"_8550":8713,"_15":8710,"_8551":4083,"_19":8714,"_8553":8119},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4626":8717,"_8550":8718,"_15":8715,"_8551":4083,"_19":8719,"_8553":8172},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4626":8721,"_8550":8557,"_15":8196,"_8551":8722,"_19":8723,"_8553":8172},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4626":8726,"_8550":4083,"_15":8724,"_8551":8727,"_19":8728,"_8553":8146},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4626":8731,"_8550":8732,"_15":8729,"_8551":4083,"_19":8733,"_8553":8119},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4626":8736,"_8550":4083,"_15":8734,"_8551":4083,"_19":8737,"_8553":4083},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4626":8740,"_8550":8741,"_15":8738,"_8551":8742,"_19":8743,"_8553":8146},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4626":8746,"_8550":8747,"_15":8744,"_8551":4083,"_19":8748,"_8553":8119},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4626":8751,"_8550":4083,"_15":8749,"_8551":8752,"_19":8753,"_8553":8213},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4626":8755,"_8550":8756,"_15":8226,"_8551":8757,"_19":8758,"_8553":8213},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4626":8761,"_8550":8762,"_15":8759,"_8551":4083,"_19":8763,"_8553":8119},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4626":8639,"_8550":8756,"_15":8764,"_8551":4083,"_19":8766,"_8553":8213},"干员受到灼热附着","sys.tacticalItem",{"_4626":8769,"_8550":4083,"_15":8767,"_8551":4083,"_19":8770,"_8553":8119},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4626":8773,"_8550":8774,"_15":8771,"_8551":4083,"_19":8775,"_8553":8213},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4626":8658,"_8550":8778,"_15":8776,"_8551":4083,"_19":8779,"_8553":8325},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4626":8782,"_8550":8783,"_15":8780,"_8551":8784,"_19":8785,"_8553":8146},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4626":8788,"_8550":4083,"_15":8786,"_8551":4083,"_19":8789,"_8553":8146},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4626":8792,"_8550":8793,"_15":8790,"_8551":4083,"_19":8794,"_8553":8301},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4626":8797,"_8550":8798,"_15":8795,"_8551":4083,"_19":8799,"_8553":8325},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4626":8802,"_8550":8803,"_15":8800,"_8551":4083,"_19":8804,"_8553":8146},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4626":8806,"_8550":8807,"_15":8243,"_8551":8698,"_19":8808,"_8553":8172},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4626":8556,"_8550":8807,"_15":8809,"_8551":4083,"_19":8811,"_8553":8172},"干员受到冻结","ba.naturalvul",{"_4626":8814,"_8550":8815,"_15":8812,"_8551":4083,"_19":8816,"_8553":8275},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4626":8601,"_8550":8818,"_15":8263,"_8551":8819,"_19":8820,"_8553":8301},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4626":8823,"_8550":8824,"_15":8821,"_8551":4083,"_19":8825,"_8553":8119},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4626":8828,"_8550":8829,"_15":8826,"_8551":4083,"_19":8830,"_8553":8119},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4626":8833,"_8550":8834,"_15":8831,"_8551":4083,"_19":8835,"_8553":8119},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4626":8838,"_8550":4083,"_15":8836,"_8551":4083,"_19":8839,"_8553":8119},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4626":8842,"_8550":4083,"_15":8840,"_8551":8843,"_19":8844,"_8553":4083},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4626":8847,"_8550":8848,"_15":8845,"_8551":8849,"_19":8850,"_8553":8146},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4626":8852,"_8550":4083,"_15":8063,"_8551":8853,"_19":8854,"_8553":8275},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4626":8856,"_8550":8857,"_15":8102,"_8551":8858,"_19":8859,"_8553":8301},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4626":8862,"_8550":8863,"_15":8860,"_8551":4083,"_19":8864,"_8553":8119},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4626":8867,"_8550":8868,"_15":8865,"_8551":4083,"_19":8869,"_8553":8275},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4626":8872,"_8550":8873,"_15":8870,"_8551":4083,"_19":8874,"_8553":8119},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4626":8876,"_8550":8877,"_15":8289,"_8551":8878,"_19":8879,"_8553":8275},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4626":8672,"_8550":8877,"_15":8880,"_8551":4083,"_19":8882,"_8553":8275},"干员受到自然附着","ba.originium",{"_4626":8885,"_8550":4083,"_15":8883,"_8551":4083,"_19":8886,"_8553":8146},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4626":8889,"_8550":4083,"_15":8887,"_8551":4083,"_19":8890,"_8553":8301},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4626":8893,"_8550":8894,"_15":8891,"_8551":4083,"_19":8895,"_8553":8301},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4626":8898,"_8550":4083,"_15":8896,"_8551":8899,"_19":8900,"_8553":8309},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4626":8903,"_8550":4083,"_15":8901,"_8551":4083,"_19":8904,"_8553":8119},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4626":8907,"_8550":4083,"_15":8905,"_8551":8908,"_19":8909,"_8553":8325},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4626":8912,"_8550":8913,"_15":8910,"_8551":4083,"_19":8914,"_8553":8119},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4626":8916,"_8550":8778,"_15":8329,"_8551":8917,"_19":8918,"_8553":8325},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4626":8921,"_8550":8922,"_15":8919,"_8551":4083,"_19":8923,"_8553":8325},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4626":8926,"_8550":4083,"_15":8924,"_8551":8927,"_19":8928,"_8553":8146},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4626":8931,"_8550":4083,"_15":8929,"_8551":8932,"_19":8933,"_8553":4083},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4626":8936,"_8550":4083,"_15":8934,"_8551":4083,"_19":8937,"_8553":8119},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4626":8940,"_8550":4083,"_15":8938,"_8551":4083,"_19":8941,"_8553":8146},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4626":8944,"_8550":8945,"_15":8942,"_8551":4083,"_19":8946,"_8553":8119},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4626":8949,"_8550":4083,"_15":8947,"_8551":8950,"_19":8951,"_8553":8146},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4626":8954,"_8550":4083,"_15":8952,"_8551":4083,"_19":8955,"_8553":8119},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4626":8958,"_8550":8959,"_15":8956,"_8551":8960,"_19":8961,"_8553":8146},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4626":8964,"_8550":4083,"_15":8962,"_8551":4083,"_19":8965,"_8553":8146},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4626":8968,"_8550":4083,"_15":8966,"_8551":4083,"_19":8969,"_8553":8146},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4626":8972,"_8550":8973,"_15":8970,"_8551":4083,"_19":8974,"_8553":8119},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4626":8977,"_8550":4083,"_15":8975,"_8551":4083,"_19":8978,"_8553":8146},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4626":8981,"_8550":4083,"_15":8979,"_8551":4083,"_19":8982,"_8553":8146},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4626":8985,"_8550":4083,"_15":8983,"_8551":4083,"_19":8986,"_8553":8146},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4626":8989,"_8550":8990,"_15":8987,"_8551":8991,"_19":8992,"_8553":8146},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4626":8995,"_8550":8996,"_15":8993,"_8551":4083,"_19":8997,"_8553":8119},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4626":9000,"_8550":9001,"_15":8998,"_8551":4083,"_19":9002,"_8553":8119},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4626":9005,"_8550":9006,"_15":9003,"_8551":4083,"_19":9007,"_8553":8119},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4626":9010,"_8550":9011,"_15":9008,"_8551":4083,"_19":9012,"_8553":8119},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4626":9015,"_8550":9016,"_15":9013,"_8551":4083,"_19":9017,"_8553":8119},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4626":9020,"_8550":9021,"_15":9018,"_8551":4083,"_19":9022,"_8553":8119},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4626":9025,"_8550":9026,"_15":9023,"_8551":4083,"_19":9027,"_8553":8119},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4626":9030,"_8550":9031,"_15":9028,"_8551":4083,"_19":9032,"_8553":8119},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4626":9035,"_8550":9036,"_15":9033,"_8551":4083,"_19":9037,"_8553":8119},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4626":9040,"_8550":9041,"_15":9038,"_8551":4083,"_19":9042,"_8553":8119},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4626":9045,"_8550":9046,"_15":9043,"_8551":4083,"_19":9047,"_8553":8119},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4626":9050,"_8550":9051,"_15":9048,"_8551":4083,"_19":9052,"_8553":8119},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4626":9055,"_8550":9056,"_15":9053,"_8551":4083,"_19":9057,"_8553":8119},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4626":9060,"_8550":9061,"_15":9058,"_8551":4083,"_19":9062,"_8553":8119},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7756":9065,"_7401":9074,"_7306":9076,"_6860":9078,"_5734":9080,"_7408":9082,"_7410":9084,"_7413":9086,"_7415":9088,"_7418":9089,"_6010":9091,"_7423":9093,"_7426":