3905},5832,{"_36":55,"_38":3907},337,{"_36":58,"_38":37},{"_36":60,"_38":3910},1.48469387755102,{"_36":62,"_38":3912},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3932,"_101":64},{"_33":3933},[3934,3936,3938,3940,3942,3944,3946,3948,3949,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969],{"_36":37,"_38":3935},97,{"_36":41,"_38":3937},129.85045234588713,{"_36":44,"_38":3939},107.08226383336839,{"_36":47,"_38":3941},190.23269513991218,{"_36":50,"_38":3943},96.16494845360825,{"_36":39,"_38":3945},5888,{"_36":55,"_38":3947},340,{"_36":58,"_38":37},{"_36":60,"_38":3950},1.48979591836735,{"_36":62,"_38":2014},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3971,"_101":64},{"_33":3972},[3973,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":925},{"_36":41,"_38":3975},131.06130864717053,{"_36":44,"_38":3977},108.09783294761202,{"_36":47,"_38":3979},191.98232695139967,{"_36":50,"_38":3981},97.0721649484536,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},343,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4010,"_101":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},132.27216494845393,{"_36":44,"_38":4017},109.11340206185565,{"_36":47,"_38":4019},193.73195876288716,{"_36":50,"_38":4021},97.97938144329896,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},347,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2052},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4050,4051],"tag_07","tag_13","charId","charIllustInitPos",{"_4055":1777,"_4056":4057},"x","y",-305,"charPassiveUIPrefabName","OverlayInfoNodeLaevat","charTypeId","Fire","cvName",{"_4064":4065,"_4066":4067,"_4068":4069,"_4070":4071,"_4052":16},"ChiCVName","阎么么","EngCVName","Kira Buckland","JapCVName","堀江由衣","KorCVName","金愈琳","defaultWeaponId","wpn_sword_0003","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Laevatain","mainAttrType","phoneticName","","profession","profileRecord",[4086,4097,4102,4107,4113,4118],{"_4052":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0016_laevat_1","recordDesc","【代号】莱万汀\n【性别】女\n【身份认证】罗德岛\n【生日】和管理员的一样\n【种族】萨卡兹\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：标准\n战术规划：标准\n源石技艺适应性：优良\n\n注：她随身携带的环，需由武库工程师定期检查维护。——终末地安全专家 卡拉德","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4052":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0016_laevat_2","再旅者干员莱万汀，由管理员直接引荐加入。结合其本人意愿，在得到人事部门同意及罗德岛授权后，以管理员直属干员的身份入职终末地工业。\n\n莱万汀比预约时间提前了整整四十五分钟来到接待区，没多说话，只是把入职通知放在桌上，说：“我到了，可以开始了。”\n开场流程她配合得很到位——签字、虹膜扫描、协议权限绑定，从头到尾一句多余的话都没说。我尝试用“欢迎来到终末地”来调节气氛，她点了点头，说：“我已经来了。”\n在职业倾向测试环节，我照例询问她有没有考虑过在更多非战斗岗位发挥作用，比如计划制定、训练教学等等，她露出了明显不耐烦的表情。\n最后，莱万汀干员只留下一句话：“让我去尽量多的地方，那些可以留下尽量多回忆的地方。”\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4052":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0016_laevat_3","终末地工业的管理员、佩丽卡监督：\n很高兴得知莱万汀已经在管理员的帮助下回归。她的旅程远未结束，但这至少说明，她已找到了新的目标和愿意同行的人。\n莱万汀是被强烈的“愿望”驱使而踏上塔卫二的。第一次察觉到她的存在时，那炽烈的光芒令人目眩。后来我意识到，那是她的内核——解答“我是谁”这个问题的执念——在闪耀着。\n在执念的牵引下，碎片苏醒为完整的人格，崭新的“她”走出源石森林，以“莱万汀”之名来到罗德岛。我原以为她会马上成为我们强大的支援，但被她拒绝了。如同特立独行的史尔特尔一样，她无法被引导，也不能被强留；在从失忆的迷瘴中找到答案之前，她不会属于任何一方。因此，我们决定打开大门，送她远行。\n我担心过，莱万汀的选择会使其他再旅者动摇，但我也觉得，正因为他们每个人都尚未忘怀曾经的目标，才会成为“再旅者”，并与你们在同一条路上重逢。现在，这块悬着的石头终于落了地。\n既然她已经正式加入终末地，与你们并肩作战，那根据我对“她”的了解，给你们一些“相处建议”吧。\n第一，坦然面对她的直率。她说话经常毫不修饰，那不是敌意，也不是厌恶，更不是无礼，这往往代表她最真诚的态度——“我愿意直接告诉你我的想法”。\n第二，如果她真的表现出明显的愤怒和不耐烦，不要试图说服她“冷静”。相信我，用点别的手段会更快见效。比如冰淇淋或者其他能快速“降温”的东西。她并非不能沟通的人，只是不喜欢“被教导”。\n顺带一提，在离开罗德岛前，她拿走了我实验室冷藏柜里所有的猩红莓果冰淇淋——而且还理直气壮地在我面前吃完了。“你不是说记忆会骗人的么？”她舔着勺子说，“那我就多吃点，这样留下的记忆才会更牢固。”这既是她的告别，也是对记忆最真诚的保存。她其实比大家想象的，还要在意眼前的人。\n第三，其实她和史尔特尔还挺像的，不过以她的个性……请千万、千万不要在她面前说她像史尔特尔，也别说她不像史尔特尔，总之除非她主动提及，不要将二人相互比较。切记！\n愿你们在塔卫二同行顺利。\n\n罗德岛","CN_03","档案资料·一",{"_4052":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":4112},"chr_0016_laevat_4","《终末地工业医疗部门服务手记》\n记录人：心理医师杜拉·格蕾\n\n【记录一】\n安斯沃思医生被紧急派往地面，所以这将是我入职终末地以来，第一次单独提供心理支援服务，内容是为一名新加入干员进行心理测评。希望这对我和她都是一个好的开始。\n…………\n等待了六个小时，那位干员没有出现。\n\n【记录二】\n我再次核对了资料，那位干员是一名被“多重记忆混乱”所困扰的再旅者，以后还是由我来专门负责。\n和莱万汀干员的第二次（实际上可以说是初次）会面很顺利，我们补上了未能进行的心理测评，她解释了上一次失约的理由——那时她正被噩梦造成的烦躁情绪困扰，因此径直前往地面“散了散心”。在我的疏导下，她同意复述那些梦境。\n\n她梦见自己站在一间教室中，同学们依次上台介绍自己。轮到她上台时，张口，却发不出声音；再试，喉咙发痛，最终只吐出模糊喑哑的音节。\n老师转身，面容是一团腾跃的火焰：“你说不出来，因为你从来都不曾拥有自己的生活。”\n她尝试离开教室，却进入到另一间熟悉又陌生的屋子中，周围的一切都在燃烧，火焰吞噬墙壁、书页、镜子。房间中还站着她的同学、朋友、师长、亲人，甚至在罗德岛和帝江号上结识的同僚，但那些人的面目也都被烈火扭曲，不堪辨认。\n她跑向门口，发现门后是同一间屋子——燃烧着的、她刚刚离开的那一间。再跑，再开门，仍然是同样的景象。\n每一次，房间都变得更小，火焰离她更近。\n最后，她推开门，来到无火无烟、只余一片灰烬的房间。房间正中坐着另一个自己，对她微笑：\n“你终于把一切烧光了。”\n\n以上反复出现的梦境，源自某些在她脑中盘桓已久的“记忆”，其真假已无从辨明。原来，她一直在与这样的东西“同行”。\n\n【记录三】\n尝试为莱万汀干员拟定了若干治疗建议，但效果欠佳。在请示过安斯沃思医生之后，我询问莱万汀干员：如果困扰她的记忆和噩梦始终不可能停歇，是否考虑以医疗方法抹去这些记忆？\n她沉思片刻，给出了否定的答案。\n数日后，她向我讲述了另一个梦境。\n\n她在一个白色的世界中醒来，天空纯净无瑕，地面一望无际。\n她走了很久，没有风，没有人，没有声音，也没有影子。\n走到尽头，那里矗立着一扇门，门上写着——如果你不想是任何人，请进去。\n她停下脚步。没有选择推开门。\n\n这次会面结束时，莱万汀干员赠予我一束火红色的花，作为“日后继续分担这些记忆”的感谢。","CN_04","档案资料·二",300,{"_4052":16,"_15":4114,"_4088":4115,"_4090":4116,"_4092":66,"_4093":4117,"_4095":64,"_4096":4112},"chr_0016_laevat_5","《战斗适应性测试记录》（文件编号：L-067）\n【测试者】莱万汀（再旅者）\n【监控员】卡拉德（终末地安全专家）\n【测试系统】S7战斗模拟系统\n【测试内容】群体压制、精准打击模拟\n【测试时长】3分42秒\n【测试结果】通过（有条件）\n\n【记录摘要】\n第一阶段测试开始后第7秒，干员莱万汀即单手唤出火焰巨剑（无装备识别编号，推测为其个人源石技艺衍生物），未作口令确认，直接冲入模拟敌群核心。\n热能读数在31秒时突破测试场阈值，系统自动启动高温应对程序。安全专家卡拉德要求中止测试，被干员莱万汀拒绝。\n1分24秒，干员莱万汀全毁敌方单位，并在战场中央以站立姿态调整呼吸，调节高强度爆发后的状态。\n38秒后恢复战斗，进入第二阶段测试，开始执行“定点压制”环节。其表现较第一阶段更加激进，于1分40秒后完成测试。\n\n【行为总结】\n作战风格呈现显著进攻性，优先以力破局。\n以主动战斗代替战术协同，团队配合意识不稳定。\n情绪接近临界时会大幅激化武器效能，表现为外焰扩散、局部灼痕、信号干扰等现象。\n\n【测试简评】\n她很强，但尚未具备相应的心理建设。她并非享受毁灭，而是用战斗宣泄情绪，确认自己的存在。她必须从这种不稳定的状态中学会自我约束——控制火，而不是成为火。否则，一旦与医疗人员和掩护人员脱节，谁都救不了她。\n——安全专家卡拉德评语\n\n你们让我来测试不是为了确认“我还能不能打”，而是想知道“我会不会失控”？放心吧……我分得清。\n——干员莱万汀自述\n\n【附注】战斗测试区域需重新铺设耐高温层，如有下一次测试，需准备“冷却剂饮品”三份。\n\n《行动简报补录》（文件编号：SU-58R-TR）\n在本次战斗行动中，作战成员莱万汀于战斗初期选择独自突进，未响应队内战术信号。此举一度导致通信中断，指挥链混乱，并引发队员间短暂的恐慌，所幸未造成减员。\n行动结束后，根据残留能量痕迹与战术记录仪分析可确认，莱万汀干员采取主动暴露位置、持续释放高热火焰干扰敌方布防的方式，成功引诱敌方火力向其转移。她以自身为诱饵制造突破口，掩护主攻干员渗透，成功达成战术目标。\n行动结束后，莱万汀干员独自坐于熔岩残渣旁，周围焦痕表明其所处区域曾承受高密度打击。检视战场期间她未发一言，仅在确认其他干员无恙后，低声说了一句：“那就好。”","CN_05","档案资料·三",{"_4052":16,"_15":4119,"_4088":4120,"_4090":4121,"_4092":68,"_4093":4122,"_4095":64,"_4096":4123},"chr_0016_laevat_6","【直属干员定期工作汇报】\n汇报人：莱万汀\n\n我护送信使来到了这个火山盆地。滚烫的岩浆被封在脚底下，加热雨水与溪流，让地面不停地轻轻冒泡，监测站就坐落在这口“活着的汤锅”上。\n源石在这里很稀缺，驻守的研究员靠地热来烹饪食物：口粮罐头埋在地里不到一小时就能熟。还有“口袋炖菜”，他们把汤和佐料一股脑倒进食用口袋里——片刻之后，用力咬开，热流直冲脑门，烫得我仿佛在喷火。\n吃第一顿饭时，研究员教我用他们的“仪式”吟唱：“愿你的汤不洒，愿你的火不灭。”\n我跟他唱了。这是我在塔卫二第一次被陌生人祝福。\n——发自34号监测站\n\n作为离事发地点最近、有能力响应紧急呼救的干员，我被要求以最快的速度抵达这座未标示在地图上的工团基地。\n问题并不复杂。高炉发生故障后熄火，失去了动力。我稍微花费了点力气，帮他们重新点燃了核心。温度回升，系统复位，暂时渡过了危机。\n给我留下难忘印象的，是他们的“名字”。这是一座秘密基地，位于严寒的█████，平时只能以特殊信标代码称呼它。在这里的每一个人，都被禁止透露自己的真实姓名，也不允许随意起代号，而只能使用被“分配”的名字。\n我在这里的临时名字是“奥列加·朗道”。据说在此之前，这个名字已经经历了三个主人，而在我之后，它会被赋予递补派来的下一任计算员。\n奇妙的体验。对“奥列加·朗道”这个名字而言，我只是它片刻的使用者。就像脑海中那些支离破碎的记忆，它们或许不属于我，在当下，却又暂时地构成了我。\n——发自联盟工团信标DAU.14\n\n解决了盘踞在货运中继站的天使之后，我重新打开了这条隧道紧闭已久的大门。\n隧道里维持着失重环境，那些被困了几个月的避难者们纷纷飘到出口，然后颤颤巍巍地离开——他们得重新学习在沉重的引力下走路。\n不过有一个女孩，她浮在隧道中间，自顾自跳了一段舞蹈后才出去。她告诉我，这是在被困的时间里保持心态平静的方式。\n我记下了她的舞步，兼具舒缓与有力的韵律。如果你愿意，我回去后，可以带你试试。动作不难，重点是呼吸和节奏。\n——发自MC-20货运枢纽\n\n这段时间里，我有了很多新的记忆。我还记得，你也正在追寻自己的记忆。我发现了一些地方，和曾经那个“你”有关。感兴趣的话，可以直接来找我。\n——加急信息，发自084A联络点","CN_06","档案资料·四",1500,"profileVoice",[4126,4134,4138,4142,4146,4150,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4434,4439,4444,4449,4454,4459,4464,4469,4474,4479,4484,4489,4494,4499,4504,4509,4514,4519,4524],{"_4052":16,"_15":4087,"_4095":37,"_4096":37,"_4127":4128,"_4129":4130,"_4131":39,"_4132":4133},"voId","chr_0016_laevat_chrbark_squad_01","voiceDesc","我讨厌麻烦，但更讨厌无聊。","voiceIndex","voiceTitle","行动准备1",{"_4052":16,"_15":4098,"_4095":37,"_4096":37,"_4127":4135,"_4129":4136,"_4131":55,"_4132":4137},"chr_0016_laevat_chrbark_squad_02","接下来的事，最好值得我记住。","行动准备2",{"_4052":16,"_15":4103,"_4095":37,"_4096":37,"_4127":4139,"_4129":4140,"_4131":58,"_4132":4141},"chr_0016_laevat_chrbark_join_01","有我一个人就够了。","编入队伍1",{"_4052":16,"_15":4108,"_4095":37,"_4096":37,"_4127":4143,"_4129":4144,"_4131":64,"_4132":4145},"chr_0016_laevat_chrbark_join_02","我是剑，我是火焰。","编入队伍2",{"_4052":16,"_15":4114,"_4095":37,"_4096":37,"_4127":4147,"_4129":4148,"_4131":66,"_4132":4149},"chr_0016_laevat_chrbark_weap_01","这把剑不错，希望能承受住火焰的温度。","更换武器",{"_4052":16,"_15":4119,"_4095":37,"_4096":37,"_4127":4151,"_4129":4152,"_4131":68,"_4132":4153},"chr_0016_laevat_chrbark_gear_01","这点重量不妨碍我挥剑。防火层？多事。","更换装备",{"_4052":16,"_15":4155,"_4095":37,"_4096":37,"_4127":4156,"_4129":4157,"_4131":70,"_4132":4158},"chr_0016_laevat_7","chr_0016_laevat_chrup_skill_01","现在，了解我的实力了？","激活天赋阵列",{"_4052":16,"_15":4160,"_4095":37,"_4096":37,"_4127":4161,"_4129":4162,"_4131":88,"_4132":4163},"chr_0016_laevat_8","chr_0016_laevat_chrup_level_01","值得参考。嗯，就这样。","观看作战记录",{"_4052":16,"_15":4165,"_4095":55,"_4096":39,"_4127":4166,"_4129":4167,"_4131":90,"_4132":4168},"chr_0016_laevat_9","chr_0016_laevat_chrup_promt01_01","这算什么？鼓励？肯定？不需要。只不过是碰见了一些碍眼的家伙，顺便把它们都烧成了灰而已。","精英化晋升1",{"_4052":16,"_15":4170,"_4095":55,"_4096":55,"_4127":4171,"_4129":4172,"_4131":411,"_4132":4173},"chr_0016_laevat_10","chr_0016_laevat_chrup_promt02_01","所以按我晋升后的权限，可以要求马上举行一对一年度谈话了，对吧？走，现在陪我去吹吹风。","精英化晋升2",{"_4052":16,"_15":4175,"_4095":55,"_4096":58,"_4127":4176,"_4129":4177,"_4131":100,"_4132":4178},"chr_0016_laevat_11","chr_0016_laevat_chrup_promt03_01","还来？我不需要信物作为嘉奖或回报。这样吧，如果是代表了共同的记忆，那我可以留下它，作为一种证明。","精英化晋升3",{"_4052":16,"_15":4180,"_4095":55,"_4096":64,"_4127":4181,"_4129":4182,"_4131":95,"_4132":4183},"chr_0016_laevat_12","chr_0016_laevat_chrup_promt04_01","看来你们对我的依赖越来越深了。那这份荣誉，我就接受吧。从此以后，可以叫我终末地干员莱万汀……喂，别露出这种表情！","精英化晋升4",{"_4052":16,"_15":4185,"_4095":37,"_4096":37,"_4127":4186,"_4129":4187,"_4131":528,"_4132":4188},"chr_0016_laevat_13","chr_0016_laevat_introduce_01","我们不是见过了吗？比起自我介绍，还是用剑与火焰来记住我吧。","干员报到",{"_4052":16,"_15":4190,"_4095":37,"_4096":37,"_4127":4191,"_4129":4192,"_4131":567,"_4132":4193},"chr_0016_laevat_14","chr_0016_laevat_mono_switch_01","我讨厌乱指指点点的家伙，还好你不是。","待命1",{"_4052":16,"_15":4195,"_4095":37,"_4096":37,"_4127":4196,"_4129":4197,"_4131":97,"_4132":4198},"chr_0016_laevat_15","chr_0016_laevat_mono_switch_02","你找我？想起了什么吗？","待命2",{"_4052":16,"_15":4200,"_4095":37,"_4096":37,"_4127":4201,"_4129":4202,"_4131":645,"_4132":4203},"chr_0016_laevat_16","chr_0016_laevat_sim_assign_work_01","偶尔在这里浪费时间也不错……","进驻设施",{"_4052":16,"_15":4205,"_4095":37,"_4096":37,"_4127":4206,"_4129":4207,"_4131":685,"_4132":4208},"chr_0016_laevat_17","chr_0016_laevat_sim_hello_lower_01","啊，你在这里。","打招呼1",{"_4052":16,"_15":4210,"_4095":64,"_4096":4112,"_4127":4211,"_4129":4212,"_4131":724,"_4132":4213},"chr_0016_laevat_18","chr_0016_laevat_sim_hello_max_01","是你……别误会，我没在特意等你。","打招呼2",{"_4052":16,"_15":4215,"_4095":37,"_4096":37,"_4127":4216,"_4129":4217,"_4131":764,"_4132":4218},"chr_0016_laevat_19","chr_0016_laevat_sim_talk_lv01_01","为什么在这里无所事事？出发，去舰桥，把你过去的足迹和未来的目的地都指给我看。","帝江号闲聊1",{"_4052":16,"_15":4220,"_4095":64,"_4096":4112,"_4127":4221,"_4129":4222,"_4131":803,"_4132":4223},"chr_0016_laevat_20","chr_0016_laevat_sim_talk_lv02_01","嗯……我为食堂有无限量供应的冰淇淋，向后勤部门表达崇高的敬意。要帮你拿一份吗？","帝江号闲聊2",{"_4052":16,"_15":4225,"_4095":64,"_4096":4112,"_4127":4226,"_4129":4227,"_4131":874,"_4132":4228},"chr_0016_laevat_21","chr_0016_laevat_sim_talk_lv02_02","待会儿有任务要去处理，一起？不，不用协议传送，我更喜欢用降落舱，带着火焰和呼啸直接砸到他们头上。","帝江号闲聊3",{"_4052":16,"_15":4230,"_4095":64,"_4096":4123,"_4127":4231,"_4129":4232,"_4131":913,"_4132":4233},"chr_0016_laevat_22","chr_0016_laevat_sim_talk_max_01","感觉有点冷？是我要求把温控度数调低的，谁让这艘船连露天吹风的地方都没有。要是受不了的话，就站得离我近点儿。","帝江号闲聊4",{"_4052":16,"_15":4235,"_4095":64,"_4096":4123,"_4127":4236,"_4129":4237,"_4131":953,"_4132":4238},"chr_0016_laevat_23","chr_0016_laevat_sim_talk_max_02","空闲的时候，我能边吃冰淇淋边盯着外面看一整天。脑海里有成百上千段记忆，却没有哪一段是从这个角度看着大地与星空的。","帝江号闲聊5",{"_4052":16,"_15":4240,"_4095":64,"_4096":4123,"_4127":4241,"_4129":4242,"_4131":992,"_4132":4243},"chr_0016_laevat_24","chr_0016_laevat_sim_talk_max_03","还被困在回忆里？哼，想不起来就别想了。记住接下来发生的事情。","帝江号闲聊6",{"_4052":16,"_15":4245,"_4095":37,"_4096":37,"_4127":4246,"_4129":4247,"_4131":62,"_4132":4248},"chr_0016_laevat_25","chr_0016_laevat_sim_gift_give_01","给你的，作为你一直记住我的回报。嗯？不会忘记在意的人本身就是回报？嘁……","赠送礼物",{"_4052":16,"_15":4250,"_4095":37,"_4096":37,"_4127":4251,"_4129":4252,"_4131":1070,"_4132":4253},"chr_0016_laevat_26","chr_0016_laevat_sim_gift_recv_01","哦？我不是很喜欢接受礼物，因为最后总是会忘记。不过既然是你的……那就另当别论。","接收礼物",{"_4052":16,"_15":4255,"_4095":37,"_4096":37,"_4127":4256,"_4129":4257,"_4131":1110,"_4132":4258},"chr_0016_laevat_27","chr_0016_laevat_mono_self_line01","“莱万汀”，没错，我亲自选的，来自那把剑。有人说不算真名？它被我驯服之后，这名字当然也就属于我了。就像那些记忆——要做它们的支配者，而不是被支配。","信赖对话1",{"_4052":16,"_15":4260,"_4095":64,"_4096":4112,"_4127":4261,"_4129":4262,"_4131":1149,"_4132":4263},"chr_0016_laevat_28","chr_0016_laevat_mono_self_line02","我的脑海里依然充斥着各种各样的记忆碎片，它们没有消失，只是我暂时不去看而已。如果哪一天收拾完了眼前的杂事，或许我会照着这些“记忆”，开始新的旅行。","信赖对话2",{"_4052":16,"_15":4265,"_4095":64,"_4096":4112,"_4127":4266,"_4129":4267,"_4131":1189,"_4132":4268},"chr_0016_laevat_29","chr_0016_laevat_mono_self_line03","史尔特尔……她的怒火，她的失落，她的茫然……都还留在我脑海里。那么真实，那么挥之不去。不过，一想到她自己最终做出的选择，我也就释然了。","信赖对话3",{"_4052":16,"_15":4270,"_4095":64,"_4096":4123,"_4127":4271,"_4129":4272,"_4131":56,"_4132":4273},"chr_0016_laevat_30","chr_0016_laevat_mono_self_line04","再旅者的使命？我不在乎。那不过是又一个被硬塞给我的“记忆”罢了。真让我同意与你们并肩作战的，是在这里遇到的人、走过的路、寄宿过的甲板、收拾过的恶棍……这些真正属于我的记忆。","信赖对话4",{"_4052":16,"_15":4275,"_4095":64,"_4096":4123,"_4127":4276,"_4129":4277,"_4131":1267,"_4132":4278},"chr_0016_laevat_31","chr_0016_laevat_mono_self_line05","之前不理解，为什么你不能和我一样放下过去。到了终末地，才看清楚——你是被层层期待包围的“管理员”，是每个人心目中“救世主”的投射。但一个人真正的模样，不该只由他人的愿望所塑造，所以你还是要通过记忆找回自我。在这条路上，无论去哪儿，都可以叫我同行。","信赖对话5",{"_4052":16,"_15":4280,"_4095":37,"_4096":37,"_4127":4281,"_4129":4282,"_4131":1306,"_4132":4283},"chr_0016_laevat_32","chr_0016_laevat_mono_chat_line01","这道残缺的“环”？就当是我的宠物兼“施术单元”吧。终末地的武库工程师研究过它的具体原理，试图修复它……但被它自己阻止了。","交谈1",{"_4052":16,"_15":4285,"_4095":37,"_4096":37,"_4127":4286,"_4129":4287,"_4131":117,"_4132":4288},"chr_0016_laevat_33","chr_0016_laevat_mono_chat_line02","来了？帮我看看这个：华法琳寄来的一幅拼图，说上面是泰拉的风景、人群、历史……大得出奇，耗了我很长时间，到现在都还没拼完。别盯着残损的地方看，那些烧焦的部分和我无关，收到的时候就是如此。","交谈2",{"_4052":16,"_15":4290,"_4095":37,"_4096":37,"_4127":4291,"_4129":4292,"_4131":1384,"_4132":4293},"chr_0016_laevat_34","chr_0016_laevat_mono_chat_line03","在塔卫二执行任务的夜晚，我会梦见帝江号，还有终末地的人与事。我等待着，把脑海里那些不属于我的记忆一点一点遗忘，再用我亲身经历的记忆重新填满。","交谈3",{"_4052":16,"_15":4295,"_4095":37,"_4096":37,"_4127":4296,"_4129":4297,"_4131":1424,"_4132":4298},"chr_0016_laevat_35","chr_0016_laevat_mono_chat_line04","为什么而挥剑战斗？为了有朝一日站在山巅，目睹世界被火海吞噬……你这是什么表情，我只是讲述了一个困扰我很久的梦魇而已。放心，无论什么时候，什么地方，我都不会让它成真的。","交谈4",{"_4052":16,"_15":4300,"_4095":37,"_4096":37,"_4127":4301,"_4129":4302,"_4131":156,"_4132":4303},"chr_0016_laevat_36","chr_0016_laevat_mono_chat_line05","有时候是在荒野中徘徊的难民，有时候却成了摧毁城市的刽子手；前一刻还在庭院里修剪花朵，下一刻就在实验室里忍受刺鼻的药剂味；和看不清面目的人决斗，但不知道为何拔剑……别打瞌睡，我才刚开了头呢。","交谈5",{"_4052":16,"_15":4305,"_4095":37,"_4096":37,"_4127":4306,"_4129":4307,"_4131":1502,"_4132":4308},"chr_0016_laevat_37","chr_0016_laevat_mono_about_line01","家乡？我到过一个叫“塞什卡”的地方，那里的建筑、语言、节日、巫术……的确有点“家”的熟悉感。不过我不想轻易再去了——他们有点过于热情，还有人管我叫“炎魔”……我实在不耐烦，在那里闹出了点乱子……","话题：塞什卡",{"_4052":16,"_15":4310,"_4095":37,"_4096":37,"_4127":4311,"_4129":4312,"_4131":1541,"_4132":4313},"chr_0016_laevat_38","chr_0016_laevat_mono_about_line02","那个粉红头发的瓦伊凡经常来找我测试她的“速冻仔”，可惜没有一次能熄灭我的火焰。但她制作的冰淇淋看起来挺潮，尝起来也不错。","话题：伊冯",{"_4052":16,"_15":4315,"_4095":37,"_4096":37,"_4127":4316,"_4129":4317,"_4131":41,"_4132":4318},"chr_0016_laevat_39","chr_0016_laevat_mono_about_line03","“火在风手里招致灾难，火在人手里成为伙伴。”有个众生长地的游人这么跟我说。她不仅不畏惧火焰，反而教我在荒野上烧出一条“防火线”，把蔓延的山火阻挡在了另一边。脱险的村民把我们当成英雄，但我只挂念从火里救出的那只云兽。可惜，留给她了。","话题：众生长地",{"_4052":16,"_15":4320,"_4095":37,"_4096":37,"_4127":4321,"_4129":4322,"_4131":44,"_4132":4323},"chr_0016_laevat_40","chr_0016_laevat_mono_about_line04","有件事，人事部门让我自己找你处理。喏，就是这张通缉令。没什么大不了的，只是刚离开罗德岛的时候，在一个叫“艾什柏环岛”的地方放了几把火而已。既然是不干不净的生意，就该想到会有“引火烧身”的一天。","话题：环塔商会",{"_4052":16,"_15":4325,"_4095":37,"_4096":37,"_4127":4326,"_4129":4327,"_4131":47,"_4132":4328},"chr_0016_laevat_41","chr_0016_laevat_mono_about_line05","再说一遍，我并没有真正去过泰拉，所以不要跟我聊那里的风土人情……萨米除外。听说那些人的“家乡”直接驮着他们来到塔卫二了？什么时候有任务去那里的话，叫上我。","话题：萨米",{"_4052":16,"_15":4330,"_4095":37,"_4096":37,"_4127":4331,"_4129":4332,"_4131":50,"_4132":4333},"chr_0016_laevat_42","chr_0016_laevat_explore_point_common_01","那边有些东西，没用的话，就拿来试剑吧。","发现资源1",{"_4052":16,"_15":4335,"_4095":37,"_4096":37,"_4127":4336,"_4129":4337,"_4131":232,"_4132":4338},"chr_0016_laevat_43","chr_0016_laevat_explore_point_valub_01","那边有你不该遗忘的东西。","发现资源2",{"_4052":16,"_15":4340,"_4095":37,"_4096":37,"_4127":4341,"_4129":4342,"_4131":1804,"_4132":4343},"chr_0016_laevat_44","chr_0016_laevat_explore_find_locked_01","放心去看看吧，跟在我身后就行了。","发现未探索区域",{"_4052":16,"_15":4345,"_4095":37,"_4096":37,"_4127":4346,"_4129":4347,"_4131":1844,"_4132":4348},"chr_0016_laevat_45","chr_0016_laevat_explore_find_danger_01","看见那个家伙了？要我出手吗？","发现强敌",{"_4052":16,"_15":4350,"_4095":37,"_4096":37,"_4127":4351,"_4129":4352,"_4131":270,"_4132":4353},"chr_0016_laevat_46","chr_0016_laevat_interact_mine_valub_01","真正有价值的东西经得住火炼。","采集矿物1",{"_4052":16,"_15":4355,"_4095":37,"_4096":37,"_4127":4356,"_4129":4357,"_4131":1922,"_4132":4358},"chr_0016_laevat_47","chr_0016_laevat_interact_mine_valub_echo2_01","太慢了，我不喜欢干等着。","采集矿物2",{"_4052":16,"_15":4360,"_4095":37,"_4096":37,"_4127":4361,"_4129":4362,"_4131":72,"_4132":4363},"chr_0016_laevat_48","chr_0016_laevat_interact_treasure_valub_01","我记得你喜欢这些。","打开储藏箱",{"_4052":16,"_15":4365,"_4095":37,"_4096":37,"_4127":4366,"_4129":4367,"_4131":60,"_4132":4368},"chr_0016_laevat_49","chr_0016_laevat_interact_etherium_01","醚质……和记忆一样飘忽不定。","获得醚质",{"_4052":16,"_15":4370,"_4095":37,"_4096":37,"_4127":4371,"_4129":4372,"_4131":76,"_4132":4373},"chr_0016_laevat_50","chr_0016_laevat_interact_blight_break_01","警惕比火焰更危险的存在。","消除侵蚀",{"_4052":16,"_15":4375,"_4095":37,"_4096":37,"_4127":4376,"_4129":4377,"_4131":78,"_4132":4378},"chr_0016_laevat_51","chr_0016_laevat_interact_rest_01","如果还觉得冷，可以往我这边靠。","休整",{"_4052":16,"_15":4380,"_4095":37,"_4096":37,"_4127":4381,"_4129":4382,"_4131":80,"_4132":4383},"chr_0016_laevat_52","chr_0016_laevat_combat_suppuse_using_01","我没兴趣看你硬撑。","使用战术物品1",{"_4052":16,"_15":4385,"_4095":37,"_4096":37,"_4127":4386,"_4129":4387,"_4131":82,"_4132":4388},"chr_0016_laevat_53","chr_0016_laevat_combat_suppuse_getheal_01","哼，不碍事了。","使用战术物品2",{"_4052":16,"_15":4390,"_4095":37,"_4096":37,"_4127":4391,"_4129":4392,"_4131":84,"_4132":4393},"chr_0016_laevat_54","chr_0016_laevat_combat_remind_danger_01","你想发愣到什么时候？","危险提醒",{"_4052":16,"_15":4395,"_4095":37,"_4096":37,"_4127":4396,"_4129":4397,"_4131":86,"_4132":4398},"chr_0016_laevat_55","chr_0016_laevat_combat_hurt_lowhp_01","啧……死不了。","负伤",{"_4052":16,"_15":4400,"_4095":37,"_4096":37,"_4127":4401,"_4129":4402,"_4131":384,"_4132":4403},"chr_0016_laevat_56","chr_0016_laevat_combat_dead_01","可恶……这失败的记忆……","力竭",{"_4052":16,"_15":4405,"_4095":37,"_4096":37,"_4127":4406,"_4129":4407,"_4131":2308,"_4132":4408},"chr_0016_laevat_57","chr_0016_laevat_combat_remind_praise_01","噢，我会记住。","小队激励1",{"_4052":16,"_15":4410,"_4095":37,"_4096":37,"_4127":4411,"_4129":4412,"_4131":2347,"_4132":4413},"chr_0016_laevat_58","chr_0016_laevat_combat_remind_praise_02","嗯，不错，下次我来。","小队激励2",{"_4052":16,"_15":4415,"_4095":37,"_4096":37,"_4127":4416,"_4129":4417,"_4131":423,"_4132":4418},"chr_0016_laevat_59","chr_0016_laevat_combat_remind_praise_echo2_01","我知道。","回应激励1",{"_4052":16,"_15":4420,"_4095":37,"_4096":37,"_4127":4421,"_4129":4422,"_4131":74,"_4132":4423},"chr_0016_laevat_60","chr_0016_laevat_combat_remind_praise_echo2_02","分内之事。","回应激励2",{"_4052":16,"_15":4425,"_4095":37,"_4096":37,"_4127":4426,"_4129":4427,"_4131":2495,"_4132":4428},"chr_0016_laevat_61","chr_0016_laevat_combat_intobattle_01","我已经等很久了。","作战开始1",{"_4052":16,"_15":4430,"_4095":37,"_4096":37,"_4127":4431,"_4129":4432,"_4131":462,"_4132":4433},"chr_0016_laevat_62","chr_0016_laevat_combat_intobattle_echo2_01","早该动手了。","作战开始2",{"_4052":16,"_15":4435,"_4095":37,"_4096":37,"_4127":4436,"_4129":4437,"_4131":2573,"_4132":4438},"chr_0016_laevat_63","chr_0016_laevat_combat_outbattle_nor_01","连热身都算不上。","作战胜利1",{"_4052":16,"_15":4440,"_4095":37,"_4096":37,"_4127":4441,"_4129":4442,"_4131":2612,"_4132":4443},"chr_0016_laevat_64","chr_0016_laevat_combat_outbattle_nor_02","胜利是理所