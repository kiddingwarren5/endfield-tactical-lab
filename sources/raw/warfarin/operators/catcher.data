:60,"_38":3906},1.48469387755102,{"_36":62,"_38":3908},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3928,"_101":64},{"_33":3929},[3930,3931,3933,3935,3937,3939,3941,3943,3944,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964],{"_36":37,"_38":962},{"_36":41,"_38":3932},188.58405217757257,{"_36":44,"_38":3934},103.8144329896907,{"_36":47,"_38":3936},92.88659793814432,{"_36":50,"_38":3938},114.2097622554179,{"_36":39,"_38":3940},5888,{"_36":55,"_38":3942},321,{"_36":58,"_38":37},{"_36":60,"_38":3945},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3966,"_101":64},{"_33":3967},[3968,3970,3972,3974,3976,3978,3980,3982,3983,3985,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004],{"_36":37,"_38":3969},98,{"_36":41,"_38":3971},190.3229539238381,{"_36":44,"_38":3973},104.79381443298968,{"_36":47,"_38":3975},93.76288659793813,{"_36":50,"_38":3977},115.28013885966784,{"_36":39,"_38":3979},5944,{"_36":55,"_38":3981},324,{"_36":58,"_38":37},{"_36":60,"_38":3984},1.49489795918367,{"_36":62,"_38":3986},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4006,"_101":64},{"_33":4007},[4008,4010,4012,4014,4016,4018,4020,4022,4023,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043],{"_36":37,"_38":4009},99,{"_36":41,"_38":4011},192.06185567010363,{"_36":44,"_38":4013},105.77319587628864,{"_36":47,"_38":4015},94.63917525773195,{"_36":50,"_38":4017},116.35051546391779,{"_36":39,"_38":4019},6000,{"_36":55,"_38":4021},327,{"_36":58,"_38":37},{"_36":60,"_38":4024},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4046,4047,4048],"tag_19","tag_22","tag_24","charId","charIllustInitPos",{"_4052":1919,"_4053":4054},"x","y",-442,"charPassiveUIPrefabName","","charTypeId","Physical","cvName",{"_4061":4062,"_4063":4064,"_4065":4066,"_4067":4068,"_4049":16},"ChiCVName","于凯隆","EngCVName","Kevin Andrew Rivera","JapCVName","木岛隆一","KorCVName","金慧星","defaultWeaponId","wpn_claym_0010","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Catcher","mainAttrType","phoneticName","profession","profileRecord",[4082,4093,4098,4103,4108,4113],{"_4049":16,"_15":4083,"_4084":4085,"_4086":4087,"_4088":39,"_4089":4090,"_4091":37,"_4092":37},"chr_0020_meurs_1","recordDesc","【代号】卡契尔\n【性别】男\n【身份认证】终末地工业\n【生日】8月16日\n【种族】佩洛\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：标准\n战术规划：标准\n源石技艺适应性：标准\n\n卡契尔干员的过往病历让我们对他现如今的测试结果感到惊讶，难以想象他是如何做到在那样的身体状况下，将自身生理强度提升到目前这个水平。基于诸多考虑，医疗部门将密切关注卡契尔干员后续的例行检查情况。","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4049":16,"_15":4094,"_4084":4095,"_4086":4096,"_4088":55,"_4089":4097,"_4091":37,"_4092":37},"chr_0020_meurs_2","干员卡契尔，本名鲁伊·范·卡契尔，出生于文明环带的军人家庭。经干员秋栗申请，纳入Z7行动组管理。\n\n基于已有的任务反馈，卡契尔先生应是Z7行动组中最令人放心的一位干员。他从不缺勤，总是按时提交报告，无任何不良嗜好，具备极好的合作性。\n但与此同时，我们也注意到，受幼年经历影响，卡契尔先生对自身的要求存在过于严苛的倾向。简而言之，他会逼迫自己承担一些他本不需要承担的责任与任务目标。因此建议在为卡契尔先生安排工作时，尽量参考Z7行动组组长秋栗的建议。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4049":16,"_15":4099,"_4084":4100,"_4086":4101,"_4088":58,"_4089":4102,"_4091":37,"_4092":37},"chr_0020_meurs_3","卡契尔无疑是Z7行动组中备受队友信赖的一位。尽管他平日里似乎更习惯沉默地站在队友们的身后，仿佛对其他人的闲聊毫无兴趣，但实际上，但凡有任何提及他的话题出现，他总会第一时间应声并给予妥善回复，教人有理由相信他从头到尾都没漏听掉一句。\n\n是的，没错，我们的“万能管家”先生就是这么一个很难让人挑出错的家伙。有时候我真的很怀疑，他是不是每次行动结束都要回去写一份反省报告，然后还定期回看？不然你觉得一般人至于连“上上上次行动漏带了一支手电筒”这种事都记得清清楚楚吗？反正我可做不到。\n——萤石\n\n卡契尔这个人，简单得有些不可思议了……他的表情管理和安塔尔一样厉害，好像很少有什么特别的变化……嗯，除了那次，我把放了一周忘记扔的奶油蛋糕不小心甩到了他的大剑上……他居然第一次对我皱眉了，真是太不容易了。\n——埃特拉\n\n他很擅长解决一些麻烦的问题，也很懂得聆听的重要性，就是不太爱说话，让人忧心他平日的社交。好在他会做烤羽兽，味道甚至可以和我奶奶一拼，所以也就用不着忧心了——没什么能难倒一个会做烤羽兽的人。\n——安塔尔\n\n虽然每次说到“Z7最让我省心的人”，大家都会一致认为是卡契尔，但我并不这么认为。因为不管是在任务中还是生活中，他都习惯性地把其他人的想法和诉求看得比自己重要……而作为队长，这绝不是我想要看到的。所以每次发现卡契尔又在自行承担额外工作时，我也会主动调整他后续的任务安排，让他不至于太辛苦。\n——秋栗","CN_03","档案资料·一",{"_4049":16,"_15":4104,"_4084":4105,"_4086":4106,"_4088":64,"_4089":4107,"_4091":64,"_4092":3668},"chr_0020_meurs_4","七年前，在我离开蓝松子安保后的那个秋天，为了方便照料我父亲并为他筹集更多的治疗费用，我在家附近的青少年训练营找了一份教官的兼职。我的主要工作就是把部队里一些最基本的常识一点点讲给这些估计连环带边缘都没去过的孩子们。而在我任教的三年间，有一位年仅15岁，名叫鲁伊的学员最令我印象深刻。他是那一届学员里唯一一个临时入营的，据说他父母本不愿意他来受训，但在他的强烈要求下最终妥协。后来我经常会想，或许我在刚得知这件事之后就应对鲁伊提高一些警惕的，至少该明白这个瘦削得让人怀疑是不是营养不良的孩子，并不像看起来的那么听话。\n整个学期我一共教过他十一节课，其中八节都曾被他“找过茬儿”。从与教科书稍有区别的演示姿势到一两个无伤大雅的记忆差错，只要我的课堂中存在任何称得上失误的地方，都免不了被他一一指出。以至于后来我几乎每堂课前都要先自己预习一遍，以免再被他纠错。\n后来在他快结业的某天，我终于第一次放下作为教官的矜持，向他问出了那个困扰我多时的问题：“到底是因为什么，让你一直这么执着地给我这个教官挑错？总不会是我哪里得罪了你吧？”而他当时的表情，直到现在我也记忆犹新——他先是摇了摇头，然后拿出了他那本边角都因为翻阅次数太多而卷起来、环塔商会统一发行的《如何成为一名合格的军人？（青少年版）》，指着它看向我，目光无比认真。\n“不，卢卡老师，你讲的课很有趣，举的例子也比书上写的生动多了，我其实很喜欢听你的课……但是，你可能不知道，这本书里讲述的一切，曾经是激励我来到这里的支柱……”\n“我……会那么在乎里面的每一条常识，只是因为我希望有一天能真正地在战场上应用它们……就像我9岁时梦想的那样……”\n在得到他的回答后，我总算从熟识的另一名教官那里知道了鲁伊的童年往事——他曾因为家人的一时疏忽患上了矿石病，虽然治疗得非常及时，却还是让他差点儿就一辈子只能待在病床上。\n我不知道他为了像普通学员那样正常受训，到底经历过什么，付出过什么……但至少作为教官，我很肯定，他确实是我值得骄傲的学生，哪怕我确实曾对他的种种行为深感头疼。\n而现在想想，如果没有鲁伊那时近乎不依不饶的指正，我恐怕不会那么努力地对照教材进行备课，也不可能改正自己在部队时囫囵学习、不求甚解的习惯，更不会在后来加入高级武装安保人员训练计划，成为一名真正的雇佣兵教官了。\n…………\n再后来，我的父亲去世，我也离开了合金萝卜城，与训练营的同事也断了联系……不清楚鲁伊后来的去向。\n只是从一位意外遇到的学员那里得知，鲁伊似乎是入职了一家颇有名望的公司，从事类似安保的工作……老实说，我有些意外，我本以为他会成为一名军人或是教官……\n但无论如何，我依然衷心希望他能有机会善用那些学到的知识，真正实现他那个童年的梦想。\n——节选自传奇教官卢卡·伦蒂的回忆录《那些不被记住的》","CN_04","档案资料·二",{"_4049":16,"_15":4109,"_4084":4110,"_4086":4111,"_4088":66,"_4089":4112,"_4091":64,"_4092":3668},"chr_0020_meurs_5","“卡契尔先生！你总算来了！那个包裹的收件人一栏虽然写了你的名字，但我们一致认为，还是由你亲自确认一下比较好……它现在就放在卸货区——对，最大的那个！就在安德烈先生采购的装置模型旁边。”\n“可以给我看看寄件人的地址和名字吗？”\n“噢，没问题，我找找……地址是‘塞什卡’，寄件人是……‘卡珊卓’？好耳熟的名字……”\n“……我知道了。确实是寄给我的。”\n“真、真的吗？但例行检测的时候，我们发现这个包裹上有专门施放防止追踪的源石技艺……”\n“别担心，真的是寄给我的……寄件人是我姐姐，她因为职业关系，习惯做一些这样的保护措施。”\n“你姐姐？等等，我想起来了……你姐姐不会就是给塞什卡商人当保镖当出名头的那个‘雾中的卡珊卓’吧？！”\n“嗯。”\n“好吧……我完全理解。确实是必要的‘保护措施’。”\n…………\n“呼，那么相关的流程就走完了，卡契尔先生，现在你可以把这个包裹带走了。”\n“我能直接在这里拆开它吗？”\n“当然可以！如果需要搬运，可以直接找我们帮忙。”\n…………\n“这、这是什么？！不会是……外骨骼吧？！”\n“……等一下，卡契尔先生，你手上拿的装置是？不然还是找个空旷的地方再按——”\n（录音开始播放）\n“亲爱的小弟，礼物收到了吗？”\n“原谅姐姐最近实在忙得抽不开身，没法去你那边和你一起过生日了。”\n“唉，原本那天听大哥说他临时接到命令要去北方一趟的时候，我就打算提前请几天假的，谁知道老板他们突然又接到一笔大单子，选的路还特别偏，只能我亲自出马了……”\n“作为补偿，我给你买了这架商会最新推出的民用U-47重型外骨骼作为今年的礼物，哼哼，是不是比大哥上次送你那把还得自己拼的合金大剑帅多了？”\n“而且因为听说你要经常出任务，我还托人给它办了五年的维修保养服务，这样你每次穿着它出门，爸妈也能放心点……”\n“你也知道的，他们俩一辈子什么都不怕，就怕你什么时候不小心受了伤，又变得和那时一样……”\n“所以务必保重身体，别忘了你当初离家时答应我和你哥的事，别忘了爸妈的嘱咐。”\n“最后，生日快乐，我最最放心不下的弟弟。”\n“——老姐不管去到哪里都会记挂着你的。”\n（录音播放结束）\n\n“果然是今年的生日礼物……唉……算了，总比去年的八国草药大礼包好一点。”","CN_05","档案资料·三",{"_4049":16,"_15":4114,"_4084":4115,"_4086":4116,"_4088":68,"_4089":4117,"_4091":64,"_4092":4118},"chr_0020_meurs_6","【一份泛黄的病历】\n患者姓名：鲁伊·范·卡契尔\n患者年龄：4岁\n就诊时间：8月15日\n就诊医院：合金萝卜自由市布朗宁医院\n主治医师：拉曼·哈伦特\n\n现病史：患者三小时前因不慎卷入一场源石装置失控事故，导致后颈脊椎受到轻微创伤。就诊一小时后，出现眩晕、盗汗、下肢力量不足、呕吐等症状。发病以来，患者精神较差，检测表明其肌群力量持续下降，建议立即入院并进行手术治疗。\n\n诊断结果：确诊为急性矿石病，并伴有相关并发症，待后续观察。\n\n【一段十年前的医疗记录存档】\n“卡契尔小先生，作为你的主治医师，我想我有义务提醒你，虽然以当前医疗观察的结论来说，你身上的矿石病已得到了控制，但相比普通人，你的身体素质已远低于平均水平。除了需要长期卧床，最好也尽量不要下床行动，任何对身体造成负担的行为都可能会危及你的生命……我希望你和你的家人都时刻注意。”\n\n【一段六年前的医疗记录存档】\n“我需要再次强调，卡契尔小——好吧，看起来你更希望我用‘先生’称呼你，总之，你的病情虽然并未因此恶化，但这种运动量还是已经远远超出我给你提供的参考值了。我非常建议你在接下来几个月里，至少来医院进行三次全身体检，并接受我本人的问询。还有……如果你继续坚持这样超标的康复训练，那么务必保证十米内有家人或是专业护工的看护。我会根据你目前的情况再开一份药品清单，但请记住，在你这样的身体状况下，即使是最高效的药物，能发挥的作用依旧是有限的……”\n\n【一段两年前的医疗记录存档】\n“好吧，我想我必须承认，这个世界上确实存在只靠医学常识难以解释的……一些意外状况。卡契尔先生，你能将自己的身体锻炼到现今的水平，我想除了所谓的‘奇迹’，或许更多是因为你本人的意志与毅力……我不认为有生之年我还能见证第二个像你这样打破了常理的患者。当然，基于医生的职责，我仍希望你能每半年进行一次例行检查，以免意外发生。”","CN_06","档案资料·四",1500,"profileVoice",[4121,4129,4133,4137,4141,4145,4149,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4434,4439,4444,4449,4454,4459,4464,4469,4474,4479,4484,4489,4494,4499,4504,4509,4514],{"_4049":16,"_15":4083,"_4091":37,"_4092":37,"_4122":4123,"_4124":4125,"_4126":39,"_4127":4128},"voId","chr_0020_meurs_chrbark_squad_01","voiceDesc","嗯？有新任务？","voiceIndex","voiceTitle","行动准备1",{"_4049":16,"_15":4094,"_4091":37,"_4092":37,"_4122":4130,"_4124":4131,"_4126":55,"_4127":4132},"chr_0020_meurs_chrbark_squad_02","我已准备就绪。","行动准备2",{"_4049":16,"_15":4099,"_4091":37,"_4092":37,"_4122":4134,"_4124":4135,"_4126":58,"_4127":4136},"chr_0020_meurs_chrbark_join_01","任何与掩护、后勤有关的任务，都可以交给我。","编入队伍1",{"_4049":16,"_15":4104,"_4091":37,"_4092":37,"_4122":4138,"_4124":4139,"_4126":64,"_4127":4140},"chr_0020_meurs_chrbark_join_02","希望这次任务的过程也能少一点风险，多一点稳妥。","编入队伍2",{"_4049":16,"_15":4109,"_4091":37,"_4092":37,"_4122":4142,"_4124":4143,"_4126":66,"_4127":4144},"chr_0020_meurs_chrbark_weap_01","泛用性和实用性都不错，能应对不少场合的突袭。","更换武器",{"_4049":16,"_15":4114,"_4091":37,"_4092":37,"_4122":4146,"_4124":4147,"_4126":68,"_4127":4148},"chr_0020_meurs_chrbark_gear_01","这种制式的装备我只在训练营的教材里见过……嗯，实物比想象中更精良。","更换装备",{"_4049":16,"_15":4150,"_4091":37,"_4092":37,"_4122":4151,"_4124":4152,"_4126":70,"_4127":4153},"chr_0020_meurs_7","chr_0020_meurs_chrup_skill_01","通常情况下，我会准备额外的应急预案……多数时候都用得上。","激活天赋阵列",{"_4049":16,"_15":4155,"_4091":37,"_4092":37,"_4122":4156,"_4124":4157,"_4126":88,"_4127":4158},"chr_0020_meurs_8","chr_0020_meurs_chrup_level_01","嗯，需要注意的点我都记下了……之后我会给队长再发一份总结报告的。","观看作战记录",{"_4049":16,"_15":4160,"_4091":55,"_4092":39,"_4122":4161,"_4124":4162,"_4126":90,"_4127":4163},"chr_0020_meurs_9","chr_0020_meurs_chrup_promt01_01","谢谢，今后的任务我也将尽力而为。","精英化晋升1",{"_4049":16,"_15":4165,"_4091":55,"_4092":55,"_4122":4166,"_4124":4167,"_4126":409,"_4127":4168},"chr_0020_meurs_10","chr_0020_meurs_chrup_promt02_01","下次请将更棘手的任务交给我吧，现在的我想必可以胜任。","精英化晋升2",{"_4049":16,"_15":4170,"_4091":55,"_4092":58,"_4122":4171,"_4124":4172,"_4126":100,"_4127":4173},"chr_0020_meurs_11","chr_0020_meurs_chrup_promt03_01","管理员，为了感谢您的认可，我已经做完了未来三个月的任务准备，随时可以验收。","精英化晋升3",{"_4049":16,"_15":4175,"_4091":55,"_4092":64,"_4122":4176,"_4124":4177,"_4126":95,"_4127":4178},"chr_0020_meurs_12","chr_0020_meurs_chrup_promt04_01","有时候我也会想，如果当初没有违背家人的意愿，恐怕会过上比现在平淡不少也安逸不少的生活……只是那个早上，当我下定决心拿起这把剑走出家门，我便不打算回头了。","精英化晋升4",{"_4049":16,"_15":4180,"_4091":37,"_4092":37,"_4122":4181,"_4124":4182,"_4126":525,"_4127":4183},"chr_0020_meurs_13","chr_0020_meurs_introduce_01","Z7行动组卡契尔，主要负责掩护与后勤，比较擅长防卫战，剑术尚可……但愿能帮上各位的忙。","干员报到",{"_4049":16,"_15":4185,"_4091":37,"_4092":37,"_4122":4186,"_4124":4187,"_4126":564,"_4127":4188},"chr_0020_meurs_14","chr_0020_meurs_mono_switch_01","需要掩护吗？我会全力以赴的。","待命1",{"_4049":16,"_15":4190,"_4091":37,"_4092":37,"_4122":4191,"_4124":4192,"_4126":97,"_4127":4193},"chr_0020_meurs_15","chr_0020_meurs_mono_switch_02","我认为最好再多做些准备。","待命2",{"_4049":16,"_15":4195,"_4091":37,"_4092":37,"_4122":4196,"_4124":4197,"_4126":642,"_4127":4198},"chr_0020_meurs_16","chr_0020_meurs_sim_assign_work_01","命令已收到。我会将它视作目前最优先的任务完成的。","进驻设施",{"_4049":16,"_15":4200,"_4091":37,"_4092":37,"_4122":4201,"_4124":4202,"_4126":682,"_4127":4203},"chr_0020_meurs_17","chr_0020_meurs_sim_hello_lower_01","管理员，您好，又有新任务了吗？","打招呼1",{"_4049":16,"_15":4205,"_4091":64,"_4092":3668,"_4122":4206,"_4124":4207,"_4126":721,"_4127":4208},"chr_0020_meurs_18","chr_0020_meurs_sim_hello_max_01","管理员，我又整理了十卷Z7的作战总结，要看看吗？","打招呼2",{"_4049":16,"_15":4210,"_4091":37,"_4092":37,"_4122":4211,"_4124":4212,"_4126":761,"_4127":4213},"chr_0020_meurs_19","chr_0020_meurs_sim_talk_lv01_01","管理员？有事找我？嗯，我今天不算忙，就是半小时后需要连上五堂剑术训练课……剩下的时间都挺空的。","帝江号闲聊1",{"_4049":16,"_15":4215,"_4091":64,"_4092":3668,"_4122":4216,"_4124":4217,"_4126":800,"_4127":4218},"chr_0020_meurs_20","chr_0020_meurs_sim_talk_lv02_01","根据大家的建议，最近我又改良了一版野炊浓汤……管理员，有空你可以来尝尝。","帝江号闲聊2",{"_4049":16,"_15":4220,"_4091":64,"_4092":3668,"_4122":4221,"_4124":4222,"_4126":871,"_4127":4223},"chr_0020_meurs_21","chr_0020_meurs_sim_talk_lv02_02","每次回到帝江号，我都觉得有种莫名的安心感……安塔尔坚称这和宿舍床铺的舒适程度脱不开关系，当然，这点我不打算反驳。","帝江号闲聊3",{"_4049":16,"_15":4225,"_4091":64,"_4092":4118,"_4122":4226,"_4124":4227,"_4126":910,"_4127":4228},"chr_0020_meurs_22","chr_0020_meurs_sim_talk_max_01","在任务中，我会无条件信任Z7的每个队友。但要我相信他们会听队长的话回来乖乖休息？那还是算了。估计不是在图书室废寝忘食，就是在娱乐室捉弄新人……必须要我亲自“送”他们回宿舍才行。","帝江号闲聊4",{"_4049":16,"_15":4230,"_4091":64,"_4092":4118,"_4122":4231,"_4124":4232,"_4126":950,"_4127":4233},"chr_0020_meurs_23","chr_0020_meurs_sim_talk_max_02","前两天我回了趟老家，虽然家里人依然不太能接受我现在的工作，但我还是跟他们讲了不少在Z7的经历。他们没多说什么，只是临走前多给我塞了好几袋特产，大概是够Z7全员吃半年的量……管理员，回头我也分你半袋吧。","帝江号闲聊5",{"_4049":16,"_15":4235,"_4091":64,"_4092":4118,"_4122":4236,"_4124":4237,"_4126":989,"_4127":4238},"chr_0020_meurs_24","chr_0020_meurs_sim_talk_max_03","每天都很充实，每天都感觉自己被很多人需要着……这些应该是来到终末地后我最大的感受。即使时不时会累到睡不着，我也不认为是什么坏事，因为对我而言，这也算一种“认可”。","帝江号闲聊6",{"_4049":16,"_15":4240,"_4091":37,"_4092":37,"_4122":4241,"_4124":4242,"_4126":62,"_4127":4243},"chr_0020_meurs_25","chr_0020_meurs_sim_gift_give_01","管理员，一点微不足道的慰问品……希望你能收下。","赠送礼物",{"_4049":16,"_15":4245,"_4091":37,"_4092":37,"_4122":4246,"_4124":4247,"_4126":1066,"_4127":4248},"chr_0020_meurs_26","chr_0020_meurs_sim_gift_recv_01","是送给我的？谢谢，我会把它放在保险箱里妥善保管的。","接收礼物",{"_4049":16,"_15":4250,"_4091":37,"_4092":37,"_4122":4251,"_4124":4252,"_4126":1106,"_4127":4253},"chr_0020_meurs_27","chr_0020_meurs_mono_self_line01","……抱歉，管理员，我只是在思考下次任务的准备工作。对了，您觉得手持焊枪、浮力调整器和源石粉尘防护面罩哪个更实用？……嗯，还是全都带上吧。","信赖对话1",{"_4049":16,"_15":4255,"_4091":64,"_4092":3668,"_4122":4256,"_4124":4257,"_4126":1145,"_4127":4258},"chr_0020_meurs_28","chr_0020_meurs_mono_self_line02","我出生在一个很平凡的五口之家，父母都是军人，大哥是商会部队里的教官，二姐则是受雇于塞什卡的保镖。他们一直在保护我，一直不愿意我走上与他们相似的路，希望我能过上平稳的生活……然而在塔卫二，谁又能一生都活在家人的保护伞里呢？","信赖对话2",{"_4049":16,"_15":4260,"_4091":64,"_4092":3668,"_4122":4261,"_4124":4262,"_4126":1185,"_4127":4263},"chr_0020_meurs_29","chr_0020_meurs_mono_self_line03","我不太会怀念九岁之前的时光，就像我至今也对消毒水的味道心存偏见……那时的我连稍微重一点的水壶都拿不动，甚至不止一次被医生禁止户外活动，连晒太阳都是难得的奢侈体验……直到现在我都记得，痊愈后我第一次单独走到阳光下，那种仿佛整个人重新活过来的感觉。","信赖对话3",{"_4049":16,"_15":4265,"_4091":64,"_4092":4118,"_4122":4266,"_4124":4267,"_4126":56,"_4127":4268},"chr_0020_meurs_30","chr_0020_meurs_mono_self_line04","也许在一些人眼里，Z7并不是个多么优秀的行动组。我并非不能理解这点，毕竟队长她太过年轻，萤石又老会得罪人，埃特拉和安塔尔更是一个比一个不着调。但我依然愿意待在Z7……嗯，待一辈子也不是不行。","信赖对话4",{"_4049":16,"_15":4270,"_4091":64,"_4092":4118,"_4122":4271,"_4124":4272,"_4126":1263,"_4127":4273},"chr_0020_meurs_31","chr_0020_meurs_mono_self_line05","刚来终末地的时候，我一度很怀疑自己是否真的具备足以被他人信任的能力……但无论是Z7的各位，还是你，管理员，你们总会让我更清晰地意识到——我能回应的期待，远比我以为的多得多。","信赖对话5",{"_4049":16,"_15":4275,"_4091":37,"_4092":37,"_4122":4276,"_4124":4277,"_4126":1302,"_4127":4278},"chr_0020_meurs_32","chr_0020_meurs_mono_chat_line01","训练营教的东西其实都大同小异，一些作战常识再加一点户外求生技巧，差不多就是全部了。不过很少会有人指望在里面学到多少实战用得上的知识吧……我可能是个例外，所以会在演练课上为教官姿势和理论标准的差异跟他辩论了一堂课。后来？后来他被我说服了，在第三堂课开讲前。","交谈1",{"_4049":16,"_15":4280,"_4091":37,"_4092":37,"_4122":4281,"_4124":4282,"_4126":117,"_4127":4283},"chr_0020_meurs_33","chr_0020_meurs_mono_chat_line02","在我们家，我其实是最没有作战天赋的那个，无论是体能还是作战技巧都远远逊于我的家人们……但即便如此，我也从没想过放弃，而是选择付出更多的努力——每天比大哥早起两小时，将训练量提到二姐的三倍……就这样，一步步坚持到了今天。","交谈2",{"_4049":16,"_15":4285,"_4091":37,"_4092":37,"_4122":4286,"_4124":4287,"_4126":1380,"_4127":4288},"chr_0020_meurs_34","chr_0020_meurs_mono_chat_line03","我学习厨艺的契机？唔，其实没有什么特别的理由，就是刚加入Z7的时候，我有幸品尝过其他队员做的菜，然后第二天就去请教了小道奇教官，接受了数周的野战生存保障训练。","交谈3",{"_4049":16,"_15":4290,"_4091":37,"_4092":37,"_4122":4291,"_4124":4292,"_4126":1420,"_4127":4293},"chr_0020_meurs_35","chr_0020_meurs_mono_chat_line04","在来终末地之前，我也试过在一些雇佣兵公司实习，但每家或多或少都希望我更“专业”一点……直白点说就是，“只拿钱办事，少问为什么”。我承认这不是什么不可理喻的要求，只是我可能这辈子都做不到吧。","交谈4",{"_4049":16,"_15":4295,"_4091":37,"_4092":37,"_4122":4296,"_4124":4297,"_4126":156,"_4127":4298},"chr_0020_meurs_36","chr_0020_meurs_mono_chat_line05","希望下个任务别再出现让安塔尔他们蹦出新点子的家伙，我们这个月给武库工程师添的麻烦已经够多了……对，您猜得没错，队长没来得及写的那些意见反馈报告现在还堆在我房间里。不过请放心，我会挑个第二天没任务的晚上通宵写完的。","交谈5",{"_4049":16,"_15":4300,"_4091":37,"_4092":37,"_4122":4301,"_4124":4302,"_4126":1498,"_4127":4303},"chr_0020_meurs_37","chr_0020_meurs_mono_about_line01","队长是个非常有责任感的人，总是努力照顾我们Z7每个人的感受……只是很多时候，我还是希望她能更在乎自己一点，至少不必在聚餐时勉强配合其他人的口味，这样我就不用每次都找理由做她喜欢的东国点心了。","话题：秋栗",{"_4049":16,"_15":4305,"_4091":37,"_4092":37,"_4122":4306,"_4124":4307,"_4126":1537,"_4127":4308},"chr_0020_meurs_38","chr_0020_meurs_mono_about_line02","我确实在环带见过像她这样的雇佣兵，狡诈、刻薄，也不合群，笑起来比不笑的时候更让人忌惮……但考虑到她最近都开始和安塔尔大聊源石虫的投掷技巧了，嗯，或许……应该再观察一段时间再下判断？","话题：萤石",{"_4049":16,"_15":4310,"_4091":37,"_4092":37,"_4122":4311,"_4124":4312,"_4126":41,"_4127":4313},"chr_0020_meurs_39","chr_0020_meurs_mono_about_line03","也不知道是出于什么原因，埃特拉每次看我写的报告都会显得……很震惊。我只是把任务中发生的每件事都记了下来，顺带写了一些不成熟的感想而已……应该没什么值得惊讶的。毕竟相比她偏好的那些“艺术创作”，我的报告实属平平无奇。","话题：埃特拉",{"_4049":16,"_15":4315,"_4091":37,"_4092":37,"_4122":4316,"_4124":4317,"_4126":44,"_4127":4318},"chr_0020_meurs_40","chr_0020_meurs_mono_about_line04","安塔尔不仅博学，还总乐于为人解惑。但问题是，他太喜欢为人解惑了。上回埃特拉随口问了句“长耳兽的耳朵为什么那么长？”，于是安塔尔一整天都在跟我们讲解相关的生物生态知识，直到返回帝江号才终于讲完——而这还是他省略了七成内容的精简版。","话题：安塔尔",{"_4049":16,"_15":4320,"_4091":37,"_4092":37,"_4122":4321,"_4124":4322,"_4126":47,"_4127":4323},"chr_0020_meurs_41","chr_0020_meurs_explore_point_common_01","根据经验，那边应该有可以收集的东西。","发现资源1",{"_4049":16,"_15":4325,"_4091":37,"_4092":37,"_4122":4326,"_4124":4327,"_4126":50,"_4127":4328},"chr_0020_meurs_42","chr_0020_meurs_explore_point_valub_01","嗯，那边的东西……就算需要绕路，也是值得的。","发现资源2",{"_4049":16,"_15":4330,"_4091":37,"_4092":37,"_4122":4331,"_4124":4332,"_4126":1762,"_4127":4333},"chr_0020_meurs_43","chr_0020_meurs_explore_find_locked_01","危险程度未知，建议慎重行动。","发现未探索区域",{"_4049":16,"_15":4335,"_4091":37,"_4092":37,"_4122":4336,"_4124":4337,"_4126":1801,"_4127":4338},"chr_0020_meurs_44","chr_0020_meurs_explore_find_danger_01","如果有作战需求，我会提前规划好撤退方案。","发现强敌",{"_4049":16,"_15":4340,"_4091":37,"_4092":37,"_4122":4341,"_4124":4342,"_4126":269,"_4127":4343},"chr_0020_meurs_45","chr_0020_meurs_interact_mine_valub_01","这也是一种珍贵的物资，尽快收集比较好。","采集矿物1",{"_4049":16,"_15":4345,"_4091":37,"_4092":37,"_4122":4346,"_4124":4347,"_4126":1879,"_4127":4348},"chr_0020_meurs_46","chr_0020_meurs_interact_mine_valub_echo2_01","团队合作总是更高效点……一起挖吧。","采集矿物2",{"_4049":16,"_15":4350,"_4091":37,"_4092":37,"_4122":4351,"_4124":4352,"_4126":1919,"_4127":4353},"chr_0020_meurs_47","chr_0020_meurs_interact_treasure_valub_01","收集到了不少实用性较强的物资，是好事。","打开储藏箱",{"_4049":16,"_15":4355,"_4091":37,"_4092":37,"_4122":4356,"_4124":4357,"_4126":72,"_4127":4358},"chr_0020_meurs_48","chr_0020_meurs_interact_etherium_01","这就是手册上说过的“醚质”吧……","获得醚质",{"_4049":16,"_15":4360,"_4091":37,"_4092":37,"_4122":4361,"_4124":4362,"_4126":60,"_4127":4363},"chr_0020_meurs_49","chr_0020_meurs_interact_blight_break_01","侵蚀的危害比常人以为的更可怕，必须慎重对待。","消除侵蚀",{"_4049":16,"_15":4365,"_4091":37,"_4092":37,"_4122":4366,"_4124":4367,"_4126":76,"_4127":4368},"chr_0020_meurs_50","chr_0020_meurs_interact_rest_01","工作手册上写过，适当休息有助于更好地完成任务。","休整",{"_4049":16,"_15":4370,"_4091":37,"_4092":37,"_4122":4371,"_4124":4372,"_4126":78,"_4127":4373},"chr_0020_meurs_51","chr_0020_meurs_combat_suppuse_using_01","支援品储备还够用，给。","使用战术物品1",{"_4049":16,"_15":4375,"_4091":37,"_4092":37,"_4122":4376,"_4124":4377,"_4126":80,"_4127":4378},"chr_0020_meurs_52","chr_0020_meurs_combat_suppuse_getheal_01","……是我的失误。","使用战术物品2",{"_4049":16,"_15":4380,"_4091":37,"_4092":37,"_4122":4381,"_4124":4382,"_4126":82,"_4127":4383},"chr_0020_meurs_53","chr_0020_meurs_combat_remind_danger_01",