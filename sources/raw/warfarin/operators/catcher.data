:8075,"_7573":8076},[7572,7572,7572],[7860,7861,7862],"toast_focal.key",{"_15":8077,"_7570":8079,"_7573":8080},[7572,7572,7572],[8072,8072,8072],"weapon.stress",{"_15":8081,"_7570":8083,"_7573":8084},[7572,7572,7572],[8085,8085,8085],"<color=#fe5a00>","weekraid.key",{"_15":8086,"_7570":8088,"_7573":8089},[7729,7729,7729],[8090,8090,8091],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_8094":8095,"_8101":8102,"_7783":8106,"_8111":8112,"_8115":8116,"_8120":8121,"_8124":8125,"_8129":8130,"_8133":8134,"_8138":8139,"_8142":8143,"_7598":8147,"_8152":8153,"_8156":8157,"_8161":8162,"_8166":8167,"_8170":8171,"_8175":8176,"_7681":8179,"_8184":8185,"_8188":8189,"_8194":8195,"_7687":8198,"_8203":8204,"_8207":8208,"_7705":8212,"_8217":8218,"_8221":8222,"_7712":8226,"_8231":8232,"_8237":8238,"_7736":8242,"_8247":8248,"_8252":8253,"_8257":8258,"_8262":8263,"_7743":8267,"_8271":8272,"_8276":8277,"_8281":8282,"_8285":8286,"_8291":8292,"_8296":8297,"_7773":8301,"_8306":8307,"_8311":8312,"_8314":8315,"_8318":8319,"_8323":8324,"_8327":8328,"_8333":8334,"_8337":8338,"_8342":8343,"_8347":8348,"_7790":8352,"_8356":8357,"_8359":8360,"_7810":8364,"_8368":8369,"_8373":8374,"_8378":8379,"_8383":8384,"_8387":8388,"_8392":8393,"_7610":8398,"_7649":8402,"_8407":8408,"_8412":8413,"_8417":8418,"_7836":8422,"_8427":8428,"_8430":8431,"_8434":8435,"_8438":8439,"_8443":8444,"_8448":8449,"_8452":8453,"_8457":8458,"_7876":8462,"_8466":8467,"_8471":8472,"_8476":8477,"_8480":8481,"_8484":8485,"_8488":8489,"_8493":8494,"_8498":8499,"_8502":8503,"_8508":8509,"_8512":8513,"_8516":8517,"_8521":8522,"_8525":8526,"_8529":8530,"_8533":8534,"_8539":8540,"_8544":8545,"_8549":8550,"_8554":8555,"_8559":8560,"_8564":8565,"_8569":8570,"_8574":8575,"_8579":8580,"_8584":8585,"_8589":8590,"_8594":8595,"_8599":8600,"_8604":8605},"adv.electricFence",{"_4615":8096,"_8097":4056,"_15":8094,"_8098":4056,"_19":8099,"_8100":7666},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4615":8103,"_8097":8104,"_15":8101,"_8098":4056,"_19":8105,"_8100":7719},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4615":8107,"_8097":8108,"_15":7783,"_8098":8109,"_19":8110,"_8100":7848},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4615":8113,"_8097":4056,"_15":8111,"_8098":4056,"_19":8114,"_8100":7666},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4615":8117,"_8097":8118,"_15":8115,"_8098":4056,"_19":8119,"_8100":7666},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4615":8122,"_8097":4056,"_15":8120,"_8098":4056,"_19":8123,"_8100":7666},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4615":8126,"_8097":8127,"_15":8124,"_8098":4056,"_19":8128,"_8100":7760},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4615":8131,"_8097":4056,"_15":8129,"_8098":4056,"_19":8132,"_8100":7666},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4615":8135,"_8097":8136,"_15":8133,"_8098":4056,"_19":8137,"_8100":7666},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4615":8140,"_8097":4056,"_15":8138,"_8098":4056,"_19":8141,"_8100":4056},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4615":8144,"_8097":8145,"_15":8142,"_8098":4056,"_19":8146,"_8100":7719},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4615":8148,"_8097":8149,"_15":7598,"_8098":8150,"_19":8151,"_8100":7848},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4615":8154,"_8097":4056,"_15":8152,"_8098":4056,"_19":8155,"_8100":7666},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4615":8158,"_8097":8159,"_15":8156,"_8098":4056,"_19":8160,"_8100":7666},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4615":8163,"_8097":8164,"_15":8161,"_8098":4056,"_19":8165,"_8100":7666},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4615":8168,"_8097":4056,"_15":8166,"_8098":4056,"_19":8169,"_8100":7693},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4615":8172,"_8097":8173,"_15":8170,"_8098":4056,"_19":8174,"_8100":7666},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4615":8177,"_8097":4056,"_15":8175,"_8098":4056,"_19":8178,"_8100":7693},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4615":8180,"_8097":8181,"_15":7681,"_8098":8182,"_19":8183,"_8100":7760},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4615":8186,"_8097":8181,"_15":8184,"_8098":4056,"_19":8187,"_8100":7760},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4615":8190,"_8097":8191,"_15":8188,"_8098":8192,"_19":8193,"_8100":7693},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4615":8196,"_8097":4056,"_15":8194,"_8098":4056,"_19":8197,"_8100":7693},"持续时间内，受影响的目标暂停行动。","定身",{"_4615":8199,"_8097":8200,"_15":7687,"_8098":8201,"_19":8202,"_8100":7872},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4615":8205,"_8097":8200,"_15":8203,"_8098":4056,"_19":8206,"_8100":7872},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4615":8209,"_8097":4056,"_15":8207,"_8098":8210,"_19":8211,"_8100":4056},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4615":8213,"_8097":8214,"_15":7705,"_8098":8215,"_19":8216,"_8100":7822},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4615":8219,"_8097":8214,"_15":8217,"_8098":4056,"_19":8220,"_8100":7822},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4615":8223,"_8097":8224,"_15":8221,"_8098":4056,"_19":8225,"_8100":7666},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4615":8227,"_8097":8228,"_15":7712,"_8098":8229,"_19":8230,"_8100":7848},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4615":8233,"_8097":8234,"_15":8231,"_8098":8235,"_19":8236,"_8100":7693},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4615":8239,"_8097":8240,"_15":8237,"_8098":4056,"_19":8241,"_8100":7693},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4615":8243,"_8097":8244,"_15":7736,"_8098":8245,"_19":8246,"_8100":7719},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4615":8249,"_8097":4056,"_15":8247,"_8098":8250,"_19":8251,"_8100":7719},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4615":8254,"_8097":8255,"_15":8252,"_8098":4056,"_19":8256,"_8100":7666},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4615":8259,"_8097":8260,"_15":8257,"_8098":4056,"_19":8261,"_8100":7666},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4615":8264,"_8097":8265,"_15":8262,"_8098":4056,"_19":8266,"_8100":7719},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4615":8268,"_8097":8104,"_15":7743,"_8098":8269,"_19":8270,"_8100":7719},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4615":8273,"_8097":4056,"_15":8271,"_8098":8274,"_19":8275,"_8100":7693},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4615":8278,"_8097":8279,"_15":8276,"_8098":4056,"_19":8280,"_8100":7666},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4615":8283,"_8097":4056,"_15":8281,"_8098":4056,"_19":8284,"_8100":4056},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4615":8287,"_8097":8288,"_15":8285,"_8098":8289,"_19":8290,"_8100":7693},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4615":8293,"_8097":8294,"_15":8291,"_8098":4056,"_19":8295,"_8100":7666},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4615":8298,"_8097":4056,"_15":8296,"_8098":8299,"_19":8300,"_8100":7760},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4615":8302,"_8097":8303,"_15":7773,"_8098":8304,"_19":8305,"_8100":7760},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4615":8308,"_8097":8309,"_15":8306,"_8098":4056,"_19":8310,"_8100":7666},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4615":8186,"_8097":8303,"_15":8311,"_8098":4056,"_19":8313,"_8100":7760},"干员受到灼热附着","sys.tacticalItem",{"_4615":8316,"_8097":4056,"_15":8314,"_8098":4056,"_19":8317,"_8100":7666},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4615":8320,"_8097":8321,"_15":8318,"_8098":4056,"_19":8322,"_8100":7760},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4615":8205,"_8097":8325,"_15":8323,"_8098":4056,"_19":8326,"_8100":7872},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4615":8329,"_8097":8330,"_15":8327,"_8098":8331,"_19":8332,"_8100":7693},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4615":8335,"_8097":4056,"_15":8333,"_8098":4056,"_19":8336,"_8100":7693},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4615":8339,"_8097":8340,"_15":8337,"_8098":4056,"_19":8341,"_8100":7848},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4615":8344,"_8097":8345,"_15":8342,"_8098":4056,"_19":8346,"_8100":7872},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4615":8349,"_8097":8350,"_15":8347,"_8098":4056,"_19":8351,"_8100":7693},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4615":8353,"_8097":8354,"_15":7790,"_8098":8245,"_19":8355,"_8100":7719},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4615":8103,"_8097":8354,"_15":8356,"_8098":4056,"_19":8358,"_8100":7719},"干员受到冻结","ba.naturalvul",{"_4615":8361,"_8097":8362,"_15":8359,"_8098":4056,"_19":8363,"_8100":7822},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4615":8148,"_8097":8365,"_15":7810,"_8098":8366,"_19":8367,"_8100":7848},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4615":8370,"_8097":8371,"_15":8368,"_8098":4056,"_19":8372,"_8100":7666},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4615":8375,"_8097":8376,"_15":8373,"_8098":4056,"_19":8377,"_8100":7666},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4615":8380,"_8097":8381,"_15":8378,"_8098":4056,"_19":8382,"_8100":7666},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4615":8385,"_8097":4056,"_15":8383,"_8098":4056,"_19":8386,"_8100":7666},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4615":8389,"_8097":4056,"_15":8387,"_8098":8390,"_19":8391,"_8100":4056},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4615":8394,"_8097":8395,"_15":8392,"_8098":8396,"_19":8397,"_8100":7693},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4615":8399,"_8097":4056,"_15":7610,"_8098":8400,"_19":8401,"_8100":7822},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4615":8403,"_8097":8404,"_15":7649,"_8098":8405,"_19":8406,"_8100":7848},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4615":8409,"_8097":8410,"_15":8407,"_8098":4056,"_19":8411,"_8100":7666},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4615":8414,"_8097":8415,"_15":8412,"_8098":4056,"_19":8416,"_8100":7822},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4615":8419,"_8097":8420,"_15":8417,"_8098":4056,"_19":8421,"_8100":7666},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4615":8423,"_8097":8424,"_15":7836,"_8098":8425,"_19":8426,"_8100":7822},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4615":8219,"_8097":8424,"_15":8427,"_8098":4056,"_19":8429,"_8100":7822},"干员受到自然附着","ba.originium",{"_4615":8432,"_8097":4056,"_15":8430,"_8098":4056,"_19":8433,"_8100":7693},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4615":8436,"_8097":4056,"_15":8434,"_8098":4056,"_19":8437,"_8100":7848},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4615":8440,"_8097":8441,"_15":8438,"_8098":4056,"_19":8442,"_8100":7848},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4615":8445,"_8097":4056,"_15":8443,"_8098":8446,"_19":8447,"_8100":7856},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4615":8450,"_8097":4056,"_15":8448,"_8098":4056,"_19":8451,"_8100":7666},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4615":8454,"_8097":4056,"_15":8452,"_8098":8455,"_19":8456,"_8100":7872},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4615":8459,"_8097":8460,"_15":8457,"_8098":4056,"_19":8461,"_8100":7666},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4615":8463,"_8097":8325,"_15":7876,"_8098":8464,"_19":8465,"_8100":7872},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4615":8468,"_8097":8469,"_15":8466,"_8098":4056,"_19":8470,"_8100":7872},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4615":8473,"_8097":4056,"_15":8471,"_8098":8474,"_19":8475,"_8100":7693},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4615":8478,"_8097":4056,"_15":8476,"_8098":8479,"_19":6199,"_8100":4056},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","sys.manualCraftTonic",{"_4615":8482,"_8097":4056,"_15":8480,"_8098":4056,"_19":8483,"_8100":7666},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4615":8486,"_8097":4056,"_15":8484,"_8098":4056,"_19":8487,"_8100":7693},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4615":8490,"_8097":8491,"_15":8488,"_8098":4056,"_19":8492,"_8100":7666},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4615":8495,"_8097":4056,"_15":8493,"_8098":8496,"_19":8497,"_8100":7693},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4615":8500,"_8097":4056,"_15":8498,"_8098":4056,"_19":8501,"_8100":7666},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4615":8504,"_8097":8505,"_15":8502,"_8098":8506,"_19":8507,"_8100":7693},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4615":8510,"_8097":4056,"_15":8508,"_8098":4056,"_19":8511,"_8100":7693},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4615":8514,"_8097":4056,"_15":8512,"_8098":4056,"_19":8515,"_8100":7693},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4615":8518,"_8097":8519,"_15":8516,"_8098":4056,"_19":8520,"_8100":7666},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4615":8523,"_8097":4056,"_15":8521,"_8098":4056,"_19":8524,"_8100":7693},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4615":8527,"_8097":4056,"_15":8525,"_8098":4056,"_19":8528,"_8100":7693},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4615":8531,"_8097":4056,"_15":8529,"_8098":4056,"_19":8532,"_8100":7693},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4615":8535,"_8097":8536,"_15":8533,"_8098":8537,"_19":8538,"_8100":7693},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4615":8541,"_8097":8542,"_15":8539,"_8098":4056,"_19":8543,"_8100":7666},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4615":8546,"_8097":8547,"_15":8544,"_8098":4056,"_19":8548,"_8100":7666},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4615":8551,"_8097":8552,"_15":8549,"_8098":4056,"_19":8553,"_8100":7666},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4615":8556,"_8097":8557,"_15":8554,"_8098":4056,"_19":8558,"_8100":7666},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4615":8561,"_8097":8562,"_15":8559,"_8098":4056,"_19":8563,"_8100":7666},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4615":8566,"_8097":8567,"_15":8564,"_8098":4056,"_19":8568,"_8100":7666},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4615":8571,"_8097":8572,"_15":8569,"_8098":4056,"_19":8573,"_8100":7666},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4615":8576,"_8097":8577,"_15":8574,"_8098":4056,"_19":8578,"_8100":7666},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4615":8581,"_8097":8582,"_15":8579,"_8098":4056,"_19":8583,"_8100":7666},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4615":8586,"_8097":8587,"_15":8584,"_8098":4056,"_19":8588,"_8100":7666},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4615":8591,"_8097":8592,"_15":8589,"_8098":4056,"_19":8593,"_8100":7666},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4615":8596,"_8097":8597,"_15":8594,"_8098":4056,"_19":8598,"_8100":7666},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4615":8601,"_8097":8602,"_15":8599,"_8098":4056,"_19":8603,"_8100":7666},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4615":8606,"_8097":8607,"_15":8604,"_8098":4056,"_19":8608,"_8100":7666},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7302":8611,"_6945":8620,"_6949":8622,"_6951":8624,"_6953":8626,"_6534":8628,"_6956":8630,"_6959":8632,"_6547":8634,"_6963":8635,"_5767":8637,"_6968":8639,"_6971":8640,"_6974":8641,"_6976":8644,"_6979":8645,"_6982":8646,"_6985":8647,"_6988":8649,"_6992":8650,"_6193":8651,"_6999":8652,"_7002":8653,"_7006":8654,"_7010":8655,"_7013":8656,"_7017":8657,"_7021":8659,"_7025":8660,"_7029":8662,"_6198":8664,"_7036":8666,"_7040":8667,"_7044":8669,"_7048":8671,"_7052":8672,"_7056":8674,"_7060":8676,"_7064":8678,"_7068":8680,"_7072":8683,"_7076":8686,"_7080":8689,"_7084":8692,"_7088":8693,"_7092":8695,"_7096":8696,"_7100":8697,"_7104":8699,"_7108":8701,"_7112":8702,"_7116":8704,"_7120":8706,"_7124":8708,"_7128":8710,"_7132":8712,"_7136":8714,"_7140":8716,"_7143":8718,"_7147":8720,"_7151":8722,"_7155":8723,"_7159":872