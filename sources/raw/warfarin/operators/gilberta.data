55,"_38":3907},350,{"_36":58,"_38":37},{"_36":60,"_38":3910},1.48469387755102,{"_36":62,"_38":3912},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3932,"_102":64},{"_33":3933},[3934,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":885},{"_36":41,"_38":3936},96.16494845360825,{"_36":44,"_38":3938},99.44329896907216,{"_36":47,"_38":3940},135.90010519671816,{"_36":50,"_38":3942},183.65074689669737,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},353,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2013},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3970,"_102":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},97.0721649484536,{"_36":44,"_38":3977},100.38144329896907,{"_36":47,"_38":3979},137.14799074268913,{"_36":50,"_38":3981},185.35114664422525,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},356,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4010,"_102":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},97.97938144329896,{"_36":44,"_38":4017},101.31958762886597,{"_36":47,"_38":4019},138.3958762886601,{"_36":50,"_38":4021},187.05154639175313,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},360,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2051},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_20","tag_15","tag_03","charId","charIllustInitPos",{"_4056":4057,"_4058":4059},"x",136,"y",-177,"charPassiveUIPrefabName","","charTypeId","Natural","cvName",{"_4066":4067,"_4068":4069,"_4070":4071,"_4072":4073,"_4053":16},"ChiCVName","王晓彤","EngCVName","Anna Devlin","JapCVName","大桥彩香","KorCVName","房翅于","defaultWeaponId","wpn_funnel_0002","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Gilberta","mainAttrType","phoneticName","profession","profileRecord",[4087,4098,4103,4108,4114,4119],{"_4053":16,"_15":4088,"_4089":4090,"_4091":4092,"_4093":39,"_4094":4095,"_4096":37,"_4097":37},"chr_0013_aglina_1","recordDesc","【代号】洁尔佩塔\n【性别】女\n【身份认证】罗德岛\n【生日】11月28日\n【种族】沃尔珀\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：普通\n战术规划：普通\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4099,"_4089":4100,"_4091":4101,"_4093":55,"_4094":4102,"_4096":37,"_4097":37},"chr_0013_aglina_2","洁尔佩塔，经罗德岛引荐，加入终末地工业，隶属于特种技术部门。\n\n在来终末地报到前，洁尔佩塔干员已经在塔卫二游历了两年，作为一名信使，为塔卫二上的许多人提供了帮助。按她的话来说：“是那段旅程造就了现在的我。”哦！谁又不是呢？\n我很欣赏洁尔佩塔干员的分享意愿，帝江号上几乎每个人都得到过她捎带的礼物。至于我的那份……我得到了一张电子乐唱片，很适合在填写人事简述时播放。\n我从未见过一个身上大部分衣物都是红色的人，能绽放出如此多的色彩。她的身上好像有无限的可能，却又好像只有一种——不好意思，一个机器人是不应该写诗的。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4104,"_4089":4105,"_4091":4106,"_4093":58,"_4094":4107,"_4096":37,"_4097":37},"chr_0013_aglina_3","洁尔佩塔盯着伞边的雨珠，看着它们汇作一团，然后重重地摔向地面。在水珠破碎之前，洁尔佩塔用法术把它停在半空，落在了自己指尖。\n这是洁尔佩塔第一次离开罗德岛，外面的天总是下雨，洁尔佩塔走走停停，但她并不着急。\n她看着遥远的天边，又看了看手中的信件——这是华法琳交给自己的，作为塔卫二信使的第一份工作。\n不过一路上似乎耽搁了太久，看着优哉游哉的驮兽发呆，和小巧的羽兽并排飞翔，连伞沿的雨水都能够吸引走洁尔佩塔的目光。\n华法琳并没有要求一个具体的时间，她只是告诉洁尔佩塔：“出去看看吧。”\n洁尔佩塔理解华法琳的意图，她总是希望干员们更加熟悉塔卫二，将自己和这颗星球连接在一起，再去面对即将到来的使命。而洁尔佩塔也乐得于此。\n接下来要去哪里呢？洁尔佩塔四处眺望着，远处的山脚下似乎闪烁着点点奇异的光，原野上的塔楼旁出现了成群的野兽，雨后的风吹起了驿站门口的帘子。洁尔佩塔每个地方都想去。\n不要着急，时间还算充裕。洁尔佩塔看了看手中，那封印有一家工业企业图章的信件。\n“稍微再等我一会儿哦。”\n洁尔佩塔催动指尖的雨珠，让其融进了眼前的小溪。雨停了，信使收起了伞，继续上路。","CN_03","档案资料·一",{"_4053":16,"_15":4109,"_4089":4110,"_4091":4111,"_4093":64,"_4094":4112,"_4096":64,"_4097":4113},"chr_0013_aglina_4","红色的身影翩然落下，她带来了甜丝丝的糖果、叠成动物形状的彩纸，还有许多颜色的彩笔。\n孩子们围到了神秘的信使小姐身边。她时不时就会来这里一次，带来点心、礼物，还有新的故事。\n她带着孩子们，用各色的笔画出了她讲过的五颜六色的羽兽，教他们用糖纸拼出自己的样子。\n傍晚的钟声响起，信使小姐和孩子们一一作别，目送着他们一个个跑回家里。\n一个女孩拉了拉信使小姐的裙子，她没有能够回去的地方。\n信使摸了摸她的脑袋，女孩感觉自己的双脚渐渐离开了地面，她惊异地叫出了声。\n她们一起看着月亮挂上夜空，星星拼成了不同的形状。\n“姐姐……不回家去吗？”\n女孩轻声问道，她垂下脑袋，她知道信使小姐很快就会离开自己。\n“我的家啊……在很远很远的地方。又或者说，它躲在天的另一边，藏在星星的后面。”\n“星星的后面？”\n“你想要去看看吗？”\n女孩点了点头，又摇了摇头，她很想去，却又怕给自己最喜欢的信使小姐添麻烦。\n“不用想那么多的，我和同事们说起过，有个很聪明很有潜力的小女孩。他们也都想见见你。”\n“真的……可以吗？”\n“我不会骗你的，啊，等等，时间到了。”\n“时间……？”\n“来闭上眼睛，别偷看哦，等我数一……二……三！好了！”\n信使小姐的手中，出现了两个纸杯蛋糕。\n“啊……”\n“嘿嘿，今天是你的生日对吧，我可没有忘记哦。来，这份是你的。”\n女孩怔怔地看着眼前的信使——她蘸起了一些奶油，放进了嘴里，露出了甜美的笑容。\n“我……我想去姐姐的家看看……”\n女孩捧起了手里的蛋糕，这是对她而言最为珍贵的一份礼物。\n现在，女孩已经在帝江号上，为了成为一名工程中心的正式技术员而努力学习。\n每当遇到困难时，她都会拿起一份纸杯蛋糕，在舰桥边远远地眺望塔卫二。每当那抹带着甜甜香味的红色身影走过她身旁时，都会带给她勇气。","CN_04","档案资料·二",300,{"_4053":16,"_15":4115,"_4089":4116,"_4091":4117,"_4093":66,"_4094":4118,"_4096":64,"_4097":4113},"chr_0013_aglina_5","【训练记录一】\n环境设置：设置C\n重力单元：设置2\n测试人：洁尔佩塔\n记录员：小道奇\n洁尔佩塔的训练表现令人难以置信。针对她的法术特征，我们调整了训练室的重力源，设置了数个牵引力释放点。我们预期她需要数分钟适应训练环境，但……我们显然低估了她的实战经验。从训练开始到完成目标只花费了预估时间的三分之一。最令人惊讶的是，她似乎在有意地控制对训练器械的损坏（你知道的……这些器械在训练过程中属于“易损品”）。她的法术和潜力给人带来无穷的遐想空间，一个能够操纵重力的战术家？一个人形的“战舰杀手”？只要联想到重力，我相信每个战场指挥官都会无比兴奋。\n我想我们接下来的任务是尽可能地协助洁尔佩塔发掘她的潜力，提升战术规划能力。她的能力能够在任何环境条件下提供帮助，这太棒了。\n\n【训练记录六】\n环境设置：设置S\n重力单元：设置26\n测试人：洁尔佩塔\n记录员：小道奇\n最近几次训练中，我们都在摸索洁尔佩塔对法术控制的边界。当我们把不定向的重力源增设到8个时，她对周边重力的控制出现了明显的减弱。绝大多数情况下她都可以维持自身体表附近的重力，但当环境设置抵达临界点时，她就无法保障几米外空间的重力环境了。换句话说：那种情况下，她无法保障一同行动的同伴的安全。\n相关的参数设置和环境分析已经上传到数据库，当然了，塔卫二很难找出符合这种环境条件的特殊地点——多个重力源，无规律地切换着方向和大小。但……干员们所面临的险境并不局限于塔卫二——在一定的深度下，怎样的作战环境都有可能出现。\n洁尔佩塔对自己的表现有些不满意，但她已经做得足够好了。这是针对她的能力设置的专项训练，在此结果上制定新的训练计划，这就是我们的工作。","CN_05","档案资料·三",{"_4053":16,"_15":4120,"_4089":4121,"_4091":4122,"_4093":68,"_4094":4123,"_4096":64,"_4097":4124},"chr_0013_aglina_6","洁尔佩塔第一次遇到那个人时，自己正顶着一张白色的床单，和医院的孩子们玩捉迷藏。\n她的耳朵捕捉到房门被推开的声音，她轻轻飘起，控制好力度不撞倒孩子，闪身到了门口，扑向了那个人。\n“嘿嘿，抓到你了吧！”\n她抓到了目标，开心地掀起了床单，却发现自己抓住的并不是调皮的孩子，而是一个陌生的人。那个人戴着一个特制的面罩，诧异地歪了歪脑袋。\n“啊……”\n洁尔佩塔慌乱地缩回了手，有些尴尬地笑了笑。本想说点什么打个圆场，却突然意识到了那个人的身份。\n“这身装束，这个面罩，不会吧，该不会……”\n洁尔佩塔想象过许多次与那个人会面的场景，却从没想到会是这样。\n“你就是洁尔佩塔吧？我是……嗯，我想你应该猜到我是谁了。”\n那个人的声音并没有多么地威厉和强势，而有着一种让人刻入脑海的奇妙特质。\n洁尔佩塔涨红了脸，想到刚才失礼的样子。不知为何后退了两步，不小心被病床绊了一跤，跌坐在了床边。\n“您居然会来这里……”\n“嗯，我听说这里救回了一批遇险的孩子们，所以想来看望一下。你这是在……？”\n“这是捉迷藏啦，孩子们在病房里待得无聊，我就想着和他们一起玩玩游戏。”\n“捉迷藏啊……”\n那个人拾起了洁尔佩塔落在地上的白色床单。\n“那，我被洁尔佩塔抓到了，是不是该换我来当鬼了？”\n“欸？但您可是……”\n“啊……他们说帮我安排了个讲座。但我觉得，你和孩子们的相处方式更有意思一些。”\n“……”\n“怎么了？”\n那个人看洁尔佩塔默不作声，有些困惑地摸了摸脸颊。\n“您和传闻中可完全不是一个样子呢。”\n洁尔佩塔突然释然地笑了起来。\n“是吗……”\n那个人更加疑惑了，毕竟才刚刚被允许自由行动，还没有从失忆的影响中走出来。\n“那我讲一下规则哦……”\n洁尔佩塔笑得更开心了。\n嗯，这就是那个人。那个朦胧的影子，那个冥冥之中的声音。\n洁尔佩塔很庆幸自己走出了那片源石森林，也庆幸自己来到了这里。","CN_06","档案资料·四",1500,"profileVoice",[4127,4135,4139,4143,4147,4151,4155,4160,4165,4170,4175,4180,4185,4190,4195,4200,4205,4210,4215,4220,4225,4230,4235,4240,4245,4250,4255,4260,4265,4270,4275,4280,4285,4290,4295,4300,4305,4310,4315,4320,4325,4330,4335,4340,4345,4350,4355,4360,4365,4370,4375,4380,4385,4390,4395,4400,4405,4410,4415,4420,4425,4430,4435,4440,4445,4450,4455,4460,4465,4470,4475,4480,4485,4490,4495,4500,4505,4510,4515,4520,4525],{"_4053":16,"_15":4088,"_4096":37,"_4097":37,"_4128":4129,"_4130":4131,"_4132":39,"_4133":4134},"voId","chr_0013_aglina_chrbark_squad_01","voiceDesc","嗨，管理员，外面的天气很不错哦。","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4099,"_4096":37,"_4097":37,"_4128":4136,"_4130":4137,"_4132":55,"_4133":4138},"chr_0013_aglina_chrbark_squad_02","准备好出远门了吗？","行动准备2",{"_4053":16,"_15":4104,"_4096":37,"_4097":37,"_4128":4140,"_4130":4141,"_4132":58,"_4133":4142},"chr_0013_aglina_chrbark_join_01","今天的塔罗斯，会闪烁着什么样的光彩呢？","编入队伍1",{"_4053":16,"_15":4109,"_4096":37,"_4097":37,"_4128":4144,"_4130":4145,"_4132":64,"_4133":4146},"chr_0013_aglina_chrbark_join_02","要前往下一个目的地了吗？","编入队伍2",{"_4053":16,"_15":4115,"_4096":37,"_4097":37,"_4128":4148,"_4130":4149,"_4132":66,"_4133":4150},"chr_0013_aglina_chrbark_weap_01","无论是什么样的新武器，只要施加一点法术……看，飘起来了！","更换武器",{"_4053":16,"_15":4120,"_4096":37,"_4097":37,"_4128":4152,"_4130":4153,"_4132":68,"_4133":4154},"chr_0013_aglina_chrbark_gear_01","嗯！看上去很合适！我很期待带着它们一起远行。要怎么穿搭才会更好看呢？","更换装备",{"_4053":16,"_15":4156,"_4096":37,"_4097":37,"_4128":4157,"_4130":4158,"_4132":70,"_4133":4159},"chr_0013_aglina_7","chr_0013_aglina_chrup_skill_01","开阔眼界，提升经验……再加上一些想象力，这样才能看清前方的道路！","激活天赋阵列",{"_4053":16,"_15":4161,"_4096":37,"_4097":37,"_4128":4162,"_4130":4163,"_4132":88,"_4133":4164},"chr_0013_aglina_8","chr_0013_aglina_chrup_level_01","回想一下当时的感觉……嗯，这个程度正好，慢慢地……浮起来！","观看作战记录",{"_4053":16,"_15":4166,"_4096":55,"_4097":39,"_4128":4167,"_4130":4168,"_4132":90,"_4133":4169},"chr_0013_aglina_9","chr_0013_aglina_chrup_promt01_01","晋升的含义是……我可以前往更遥远的地方了吗？嘿嘿，我已经打包好行李了，什么时候出发？","精英化晋升1",{"_4053":16,"_15":4171,"_4096":55,"_4097":55,"_4128":4172,"_4130":4173,"_4132":94,"_4133":4174},"chr_0013_aglina_10","chr_0013_aglina_chrup_promt02_01","我想要在管理员……在大家的心中变得更加可靠。有时候我会有些担忧，我真的有好好迈出这一步吗？","精英化晋升2",{"_4053":16,"_15":4176,"_4096":55,"_4097":58,"_4128":4177,"_4130":4178,"_4132":101,"_4133":4179},"chr_0013_aglina_11","chr_0013_aglina_chrup_promt03_01","下一次晋升会有些更特别的奖励吗？我想要的礼物？嗯……和管理员出去玩一整天怎么样？","精英化晋升3",{"_4053":16,"_15":4181,"_4096":55,"_4097":64,"_4128":4182,"_4130":4183,"_4132":96,"_4133":4184},"chr_0013_aglina_12","chr_0013_aglina_chrup_promt04_01","每当我走完了一段漫长的新旅程，驻足回望，那些点点滴滴的情绪都会一同涌上心头。这，就是我最热爱这份工作的瞬间。","精英化晋升4",{"_4053":16,"_15":4186,"_4096":37,"_4097":37,"_4128":4187,"_4130":4188,"_4132":527,"_4133":4189},"chr_0013_aglina_13","chr_0013_aglina_introduce_01","你好呀！你身上有一股令人怀念的气味……好像一封没有写完的信，我很好奇它会去往哪里。","干员报到",{"_4053":16,"_15":4191,"_4096":37,"_4097":37,"_4128":4192,"_4130":4193,"_4132":566,"_4133":4194},"chr_0013_aglina_14","chr_0013_aglina_mono_switch_01","看这里！瞧，信使小姐带着你的信飞来咯！","待命1",{"_4053":16,"_15":4196,"_4096":37,"_4097":37,"_4128":4197,"_4130":4198,"_4132":98,"_4133":4199},"chr_0013_aglina_15","chr_0013_aglina_mono_switch_02","嗨！要一起出去走走吗？天空的颜色很好看哦！","待命2",{"_4053":16,"_15":4201,"_4096":37,"_4097":37,"_4128":4202,"_4130":4203,"_4132":644,"_4133":4204},"chr_0013_aglina_16","chr_0013_aglina_sim_assign_work_01","放心交给我吧！","进驻设施",{"_4053":16,"_15":4206,"_4096":37,"_4097":37,"_4128":4207,"_4130":4208,"_4132":684,"_4133":4209},"chr_0013_aglina_17","chr_0013_aglina_sim_hello_lower_01","好巧呀，管理员！一起去舰桥散散步吧！","打招呼1",{"_4053":16,"_15":4211,"_4096":64,"_4097":4113,"_4128":4212,"_4130":4213,"_4132":723,"_4133":4214},"chr_0013_aglina_18","chr_0013_aglina_sim_hello_max_01","还在忙吗？管理员，要注意休息哦。","打招呼2",{"_4053":16,"_15":4216,"_4096":37,"_4097":37,"_4128":4217,"_4130":4218,"_4132":763,"_4133":4219},"chr_0013_aglina_19","chr_0013_aglina_sim_talk_lv01_01","我好喜欢收集五颜六色、不同香味的唇彩，这样说出来的话语，是不是也会变得五彩斑斓呢？","帝江号闲聊1",{"_4053":16,"_15":4221,"_4096":64,"_4097":4113,"_4128":4222,"_4130":4223,"_4132":802,"_4133":4224},"chr_0013_aglina_20","chr_0013_aglina_sim_talk_lv02_01","塔罗斯赋予了塔卫二天空绚丽的颜色，看着那些不期而遇的光华一闪而过……管理员，你不觉得这是一件很浪漫的事情吗？","帝江号闲聊2",{"_4053":16,"_15":4226,"_4096":64,"_4097":4113,"_4128":4227,"_4130":4228,"_4132":873,"_4133":4229},"chr_0013_aglina_21","chr_0013_aglina_sim_talk_lv02_02","管理员，看我带回来了什么？好多好看的小彩灯！还有巫术时刻的特制小香薰。我们可以一起布置一下管理员的房间，等到晚上，周围就会变得像夜空一样璀璨！一起去试试吧！","帝江号闲聊3",{"_4053":16,"_15":4231,"_4096":64,"_4097":4124,"_4128":4232,"_4130":4233,"_4132":912,"_4133":4234},"chr_0013_aglina_22","chr_0013_aglina_sim_talk_max_01","嗯……我在想，为什么小说里的角色总是会把心事藏起来？发不出的邀请、送不出的信、说不出的话语……明明那么简单，却迟迟不敢传达……我就可以轻松地邀请管理员出门，送出好玩的礼物……究竟是哪里不一样呢……","帝江号闲聊4",{"_4053":16,"_15":4236,"_4096":64,"_4097":4124,"_4128":4237,"_4130":4238,"_4132":952,"_4133":4239},"chr_0013_aglina_23","chr_0013_aglina_sim_talk_max_02","秋栗小姐送给了我一枚很特别的护身符，说是只要一直带在身边，总有一天愿望就会实现。我的愿望嘛……我希望每一个交给我信件的人，都能实现自己所写下的愿望！嘿嘿，这样是不是有一点贪心了？","帝江号闲聊5",{"_4053":16,"_15":4241,"_4096":64,"_4097":4124,"_4128":4242,"_4130":4243,"_4132":991,"_4133":4244},"chr_0013_aglina_24","chr_0013_aglina_sim_talk_max_03","我总是会梦见曾经见到过的景色，在那些梦幻而又模糊的影子背后，总是有着一个人的身影，静静地站在远处，像是在等一个人，或是在等一封信。最近，我觉得那个身影似乎变得越来越清晰，像是身边某个熟悉的人……","帝江号闲聊6",{"_4053":16,"_15":4246,"_4096":37,"_4097":37,"_4128":4247,"_4130":4248,"_4132":62,"_4133":4249},"chr_0013_aglina_25","chr_0013_aglina_sim_gift_give_01","管理员，猜猜看我给你准备了什么惊喜？是我专门为你挑选的哦！猜错了也没关系的，试一下嘛。","赠送礼物",{"_4053":16,"_15":4251,"_4096":37,"_4097":37,"_4128":4252,"_4130":4253,"_4132":1069,"_4133":4254},"chr_0013_aglina_26","chr_0013_aglina_sim_gift_recv_01","这是给我的吗？谢谢！我会把它摆在房间里最显眼的位置！","接收礼物",{"_4053":16,"_15":4256,"_4096":37,"_4097":37,"_4128":4257,"_4130":4258,"_4132":1109,"_4133":4259},"chr_0013_aglina_27","chr_0013_aglina_mono_self_line01","我送出的第一封信，是华法琳医生为我写的介绍信。当我第一次来到帝江号时内心还有些忐忑，我总会去想：华法琳医生让我等待的“管理员”会是一个什么样的人？直到得知管理员你意外苏醒，在帝江号上亲眼见到你时，我才放下心来……不过……现在还是有点小小的忐忑……","信赖对话1",{"_4053":16,"_15":4261,"_4096":64,"_4097":4113,"_4128":4262,"_4130":4263,"_4132":1148,"_4133":4264},"chr_0013_aglina_28","chr_0013_aglina_mono_self_line02","我喜欢独自在夜晚的天空中飞行，融进夜色里，看着那些亮闪闪的点点星星，我会想象那里会不会也有着数不清的故事。会不会在此时此刻，有人和我想着一样的事情，分享着同一片夜空……","信赖对话2",{"_4053":16,"_15":4266,"_4096":64,"_4097":4113,"_4128":4267,"_4130":4268,"_4132":1188,"_4133":4269},"chr_0013_aglina_29","chr_0013_aglina_mono_self_line03","孤独是信使的伴侣，但我永远也习惯不了孤独。每当孤身一人行至远方，我都会拿起罗盘，看向罗德岛的方向。那里有着华法琳医生，有着真实且不会褪色的记忆。而我要前进的方向，则有着素未谋面的新朋友和新的邂逅。想到这些，我就会安心下来，期待起接下来的旅行。嗯，洁尔佩塔想要做一个不孤独的信使。","信赖对话3",{"_4053":16,"_15":4271,"_4096":64,"_4097":4124,"_4128":4272,"_4130":4273,"_4132":56,"_4133":4274},"chr_0013_aglina_30","chr_0013_aglina_mono_self_line04","每当看见孤零零的星星时，我都会感到莫名的失落和遗憾……星星啊星星，是否天空那一边的你……也没有等来属于自己的伴星……","信赖对话4",{"_4053":16,"_15":4276,"_4096":64,"_4097":4124,"_4128":4277,"_4130":4278,"_4132":1266,"_4133":4279},"chr_0013_aglina_31","chr_0013_aglina_mono_self_line05","在我刚刚走出那片“森林”时，我发现了身边的那张空白信纸。它仿佛具现了那时我有些迷茫的内心……它为何只出现在我的身边？究竟要在上面写些什么？写好的信件又要交给什么人？我走了一路，依然没找到答案。但……我想这一定是让我把所有的心情、所有的幻想，写进那张空白的信纸里，然后，将它交给某个最重视的人。","信赖对话5",{"_4053":16,"_15":4281,"_4096":37,"_4097":37,"_4128":4282,"_4130":4283,"_4132":1305,"_4133":4284},"chr_0013_aglina_32","chr_0013_aglina_mono_chat_line01","印象深刻的旅行？嗯……管理员听说过合金萝卜城吗？那里的卡特斯们能一天三顿都吃萝卜！他们会把萝卜做成各式各样的料理！我去过那里两次，都是去给萝卜种植园的商会提供药品。再有机会造访的话，真想去看看下层的“大钻孔”……啊，记得一定要去那家叫作“卷心菜”的旅馆住宿，否则你的菜单上就只剩下萝卜料理了……","交谈1",{"_4053":16,"_15":4286,"_4096":37,"_4097":37,"_4128":4287,"_4130":4288,"_4132":118,"_4133":4289},"chr_0013_aglina_33","chr_0013_aglina_mono_chat_line02","失重的感觉，对我来说是如影随形的。我经常觉得自己像一只气球，轻飘飘地系在沉重的地面上，但我又想要竭尽全力，带着它一起飞起来。这会是异想天开吗？地上的影子延长成一根长长的线，我知道，那就是我和世界的联系。就像信，连接着你和我一样。","交谈2",{"_4053":16,"_15":4291,"_4096":37,"_4097":37,"_4128":4292,"_4130":4293,"_4132":1383,"_4133":4294},"chr_0013_aglina_34","chr_0013_aglina_mono_chat_line03","你是问这本书？这是一本记录着许许多多信使故事的选集。他们中有人跨过了天灾，拯救了人民，却被当成唤来灾难的使者；有人向往着安稳平淡的旅途，却阴差阳错颠覆了国家；还有笨拙的孩子，在成为信使的第一天弄丢了信……嘿嘿，我喜欢里面的每一个故事。","交谈3",{"_4053":16,"_15":4296,"_4096":37,"_4097":37,"_4128":4297,"_4130":4298,"_4132":1423,"_4133":4299},"chr_0013_aglina_35","chr_0013_aglina_mono_chat_line04","我在新蓝卡坞无数次听人讲述“泰拉”的故事。有人歌颂她的温暖，有人斥责她的无情；有人憎恶她的破败，有人怀念她的瑰丽……艺术家为了那一段段历史呕心沥血，哲学家则认为我们早该拥抱新的思潮……对我来说，“泰拉”更像是一个熟悉又陌生的名字……至少在我眼里，那里有着同样美好的风景和熟悉的面孔……管理员，你呢？","交谈4",{"_4053":16,"_15":4301,"_4096":37,"_4097":37,"_4128":4302,"_4130":4303,"_4132":1462,"_4133":4304},"chr_0013_aglina_36","chr_0013_aglina_mono_chat_line05","没有信使能够猜测到信封内藏着什么，但看着那些精心装饰着的贴纸，我就会想到一些温馨的故事或许即将发生。看到信件被雨水打湿成皱皱巴巴的模样，我就会感叹会不会又是一段苦难的旅途或是别离……信件的主人们很少会向信使分享他们的心情，他们也不会知道，有个陌生人曾为他们开心，曾为他们难过。","交谈5",{"_4053":16,"_15":4306,"_4096":37,"_4097":37,"_4128":4307,"_4130":4308,"_4132":157,"_4133":4309},"chr_0013_aglina_37","chr_0013_aglina_mono_about_line01","华法琳医生？她还是和以前一样，看起来精神不错。不过她有一次记错了我的生日，很是自责地向我道了歉……明明没关系的。慌乱中她还叫错了我的名字……她那一刻的表情我从未见过，怎么形容呢……看上去有些错愕，有些茫然。在我走后，她一个人在餐桌旁坐了很久很久……","话题：华法琳",{"_4053":16,"_15":4311,"_4096":37,"_4097":37,"_4128":4312,"_4130":4313,"_4132":1540,"_4133":4314},"chr_0013_aglina_38","chr_0013_aglina_mono_about_line02","很久以前，我曾经在罗德岛见过一位神秘的女性。她拿着一把与众不同的剑，独自立于平静的湖面。剑光闪过，湖水只泛起了一点涟漪，天空却缺了半边的云……她把这封信交给了我，希望把信寄给管理员，等到陈千语干员有所成长的时候再转交给她……","话题：神秘剑客",{"_4053":16,"_15":4316,"_4096":37,"_4097":37,"_4128":4317,"_4130":4318,"_4132":41,"_4133":4319},"chr_0013_aglina_39","chr_0013_aglina_mono_about_line03","艾维文娜总是会前往一些凶险的地方送信……虽然她每天都在笑着，但她的眼睛里像是藏着一些无法说出口的，有些沉重的秘密……我在许多信使眼中看到过……我知道那是为什么……","话题：艾维文娜",{"_4053":16,"_15":4321,"_4096":37,"_4097":37,"_4128":4322,"_4130":4323,"_4132":44,"_4133":4324},"chr_0013_aglina_40","chr_0013_aglina_mono_about_line04","塔卫二充满了各种各样未知的危险……我看过艾尔黛拉提供的报告，和遥远的泰拉相比，塔卫二上的威胁更加难以预测。信使时常要涉足那些侵蚀灾害频发的区域，所以会配备用于自救和逃脱的装备。因为我会飞嘛，所以我通常会多准备一些，把它们留在荒野上的落脚点，尽可能地帮助到那些遇到危险的人。","话题：荒野上的危险",{"_4053":16,"_15":4326,"_4096":37,"_4097":37,"_4128":4327,"_4130":4328,"_4132":47,"_4133":4329},"chr_0013_aglina_41","chr_0013_aglina_mono_about_line05","我本以为华法琳医生会给我在罗德岛分配一些任务，可她却说罗德岛现在的立场不适合活跃在大众视野中，身为信使的我应该在更明媚的天空下畅游。所以，我先在塔卫二上生活了两年，逐渐认识了这个广袤的新世界，然后来到了这里。","话题：自己",{"_4053":16,"_15":4331,"_4096":37,"_4097":37,"_4128":4332,"_4130":4333,"_4132":50,"_4133":4334},"chr_0013_aglina_42","chr_0013_aglina_explore_point_common_01","那边有值得注意的东西。","发现资源1",{"_4053":16,"_15":4336,"_4096":37,"_4097":37,"_4128":4337,"_4130":4338,"_4132":233,"_4133":4339},"chr_0013_aglina_43","chr_0013_aglina_explore_point_valub_01","看看那边，说不定会有惊喜！","发现资源2",{"_4053":16,"_15":4341,"_4096":37,"_4097":37,"_4128":4342,"_4130":4343,"_4132":1803,"_4133":4344},"chr_0013_aglina_44","chr_0013_aglina_explore_find_locked_01","信使准则：未知区域需要谨慎前行！","发现未探索区域",{"_4053":16,"_15":4346,"_4096":37,"_4097":37,"_4128":4347,"_4130":4348,"_4132":1843,"_4133":4349},"chr_0013_aglina_45","chr_0013_aglina_explore_find_danger_01","那里的敌人好像很危险，要小心哦。","发现强敌",{"_4053":16,"_15":4351,"_4096":37,"_4097":37,"_4128":4352,"_4130":4353,"_4132":1882,"_4133":4354},"chr_0013_aglina_46","chr_0013_aglina_interact_mine_valub_01","让我们把这些矿物放进背包里！","采集矿物1",{"_4053":16,"_15":4356,"_4096":37,"_4097":37,"_4128":4357,"_4130":4358,"_4132":271,"_4133":4359},"chr_0013_aglina_47","chr_0013_aglina_interact_mine_valub_echo2_01","我来帮忙咯，嘻嘻。","采集矿物2",{"_4053":16,"_15":4361,"_4096":37,"_4097":37,"_4128":4362,"_4130":4363,"_4132":72,"_4133":4364},"chr_0013_aglina_48","chr_0013_aglina_interact_treasure_valub_01","哇！都是我们需要的东西！","打开储藏箱",{"_4053":16,"_15":4366,"_4096":37,"_4097":37,"_4128":4367,"_4130":4368,"_4132":60,"_4133":4369},"chr_0013_aglina_49","chr_0013_aglina_interact_etherium_01","嘿嘿，还好没有飞远。","获得醚质",{"_4053":16,"_15":4371,"_4096":37,"_4097":37,"_4128":4372,"_4130":4373,"_4132":76,"_4133":4374},"chr_0013_aglina_50","chr_0013_aglina_interact_blight_break_01","这下送信的道路将会畅通无阻！","消除侵蚀",{"_4053":16,"_15":4376,"_4096":37,"_4097":37,"_4128":4377,"_4130":4378,"_4132":78,"_4133":4379},"chr_0013_aglina_51","chr_0013_aglina_interact_rest_01","休整是为了更好地出发。","休整",{"_4053":16,"_15":4381,"_4096":37,"_4097":37,"_4128":4382,"_4130":4383,"_4132":80,"_4133":4384},"chr_0013_aglina_52","chr_0013_aglina_combat_suppuse_using_01","试试这个，能帮到你！","使用战术物品1",{"_4053":16,"_15":4386,"_4096":37,"_4097":37,"_4128":4387,"_4130":4388,"_4132":82,"_4133":4389},"chr_0013_aglina_53","chr_0013_aglina_combat_suppuse_getheal_01","呼……我感觉好一些了。","使用战术物品2",{"_4053":16,"_15":4391,"_4096":37,"_4097":37,"_4128":4392,"_4130":4393,"_4132":84,"_4133":4394},"chr_0013_aglina_54","chr_0013_aglina_combat_remind_danger_01","小心受伤，快闪开！","危险提醒",{"_4053":16,"_15":4396,"_4096":37,"_4097":37,"_4128":4397,"_4130":4398,"_4132":86,"_