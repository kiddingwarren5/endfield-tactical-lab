6":8117,"_8120":8121,"_8125":8126,"_7631":8129,"_8134":8135,"_8138":8139,"_8144":8145,"_7637":8148,"_8153":8154,"_8157":8158,"_7655":8162,"_8167":8168,"_8171":8172,"_7662":8176,"_8181":8182,"_8187":8188,"_7686":8192,"_8197":8198,"_8202":8203,"_8207":8208,"_8212":8213,"_7693":8217,"_8221":8222,"_8226":8227,"_8231":8232,"_8235":8236,"_8241":8242,"_8246":8247,"_7723":8251,"_8256":8257,"_8261":8262,"_8264":8265,"_8268":8269,"_8273":8274,"_8277":8278,"_8283":8284,"_8287":8288,"_8292":8293,"_8297":8298,"_7740":8302,"_8306":8307,"_8309":8310,"_7760":8314,"_8318":8319,"_8323":8324,"_8328":8329,"_8333":8334,"_8337":8338,"_8342":8343,"_7560":8348,"_7599":8352,"_8357":8358,"_8362":8363,"_8367":8368,"_7786":8372,"_8377":8378,"_8380":8381,"_8384":8385,"_8388":8389,"_8393":8394,"_8398":8399,"_8402":8403,"_8407":8408,"_7826":8412,"_8416":8417,"_8421":8422,"_8426":8427,"_8431":8432,"_8435":8436,"_8439":8440,"_8444":8445,"_8449":8450,"_8453":8454,"_8459":8460,"_8463":8464,"_8467":8468,"_8472":8473,"_8476":8477,"_8480":8481,"_8484":8485,"_8490":8491,"_8495":8496,"_8500":8501,"_8505":8506,"_8510":8511,"_8515":8516,"_8520":8521,"_8525":8526,"_8530":8531,"_8535":8536,"_8540":8541,"_8545":8546,"_8550":8551,"_8555":8556},"adv.electricFence",{"_4612":8046,"_8047":4058,"_15":8044,"_8048":4058,"_19":8049,"_8050":7616},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4612":8053,"_8047":8054,"_15":8051,"_8048":4058,"_19":8055,"_8050":7669},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4612":8057,"_8047":8058,"_15":7733,"_8048":8059,"_19":8060,"_8050":7798},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4612":8063,"_8047":4058,"_15":8061,"_8048":4058,"_19":8064,"_8050":7616},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4612":8067,"_8047":8068,"_15":8065,"_8048":4058,"_19":8069,"_8050":7616},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4612":8072,"_8047":4058,"_15":8070,"_8048":4058,"_19":8073,"_8050":7616},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4612":8076,"_8047":8077,"_15":8074,"_8048":4058,"_19":8078,"_8050":7710},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4612":8081,"_8047":4058,"_15":8079,"_8048":4058,"_19":8082,"_8050":7616},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4612":8085,"_8047":8086,"_15":8083,"_8048":4058,"_19":8087,"_8050":7616},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4612":8090,"_8047":4058,"_15":8088,"_8048":4058,"_19":8091,"_8050":4058},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4612":8094,"_8047":8095,"_15":8092,"_8048":4058,"_19":8096,"_8050":7669},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4612":8098,"_8047":8099,"_15":7548,"_8048":8100,"_19":8101,"_8050":7798},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4612":8104,"_8047":4058,"_15":8102,"_8048":4058,"_19":8105,"_8050":7616},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4612":8108,"_8047":8109,"_15":8106,"_8048":4058,"_19":8110,"_8050":7616},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4612":8113,"_8047":8114,"_15":8111,"_8048":4058,"_19":8115,"_8050":7616},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4612":8118,"_8047":4058,"_15":8116,"_8048":4058,"_19":8119,"_8050":7643},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4612":8122,"_8047":8123,"_15":8120,"_8048":4058,"_19":8124,"_8050":7616},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4612":8127,"_8047":4058,"_15":8125,"_8048":4058,"_19":8128,"_8050":7643},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4612":8130,"_8047":8131,"_15":7631,"_8048":8132,"_19":8133,"_8050":7710},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4612":8136,"_8047":8131,"_15":8134,"_8048":4058,"_19":8137,"_8050":7710},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4612":8140,"_8047":8141,"_15":8138,"_8048":8142,"_19":8143,"_8050":7643},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4612":8146,"_8047":4058,"_15":8144,"_8048":4058,"_19":8147,"_8050":7643},"持续时间内，受影响的目标暂停行动。","定身",{"_4612":8149,"_8047":8150,"_15":7637,"_8048":8151,"_19":8152,"_8050":7822},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4612":8155,"_8047":8150,"_15":8153,"_8048":4058,"_19":8156,"_8050":7822},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4612":8159,"_8047":4058,"_15":8157,"_8048":8160,"_19":8161,"_8050":4058},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4612":8163,"_8047":8164,"_15":7655,"_8048":8165,"_19":8166,"_8050":7772},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4612":8169,"_8047":8164,"_15":8167,"_8048":4058,"_19":8170,"_8050":7772},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4612":8173,"_8047":8174,"_15":8171,"_8048":4058,"_19":8175,"_8050":7616},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4612":8177,"_8047":8178,"_15":7662,"_8048":8179,"_19":8180,"_8050":7798},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4612":8183,"_8047":8184,"_15":8181,"_8048":8185,"_19":8186,"_8050":7643},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4612":8189,"_8047":8190,"_15":8187,"_8048":4058,"_19":8191,"_8050":7643},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4612":8193,"_8047":8194,"_15":7686,"_8048":8195,"_19":8196,"_8050":7669},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4612":8199,"_8047":4058,"_15":8197,"_8048":8200,"_19":8201,"_8050":7669},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4612":8204,"_8047":8205,"_15":8202,"_8048":4058,"_19":8206,"_8050":7616},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4612":8209,"_8047":8210,"_15":8207,"_8048":4058,"_19":8211,"_8050":7616},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4612":8214,"_8047":8215,"_15":8212,"_8048":4058,"_19":8216,"_8050":7669},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4612":8218,"_8047":8054,"_15":7693,"_8048":8219,"_19":8220,"_8050":7669},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4612":8223,"_8047":4058,"_15":8221,"_8048":8224,"_19":8225,"_8050":7643},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4612":8228,"_8047":8229,"_15":8226,"_8048":4058,"_19":8230,"_8050":7616},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4612":8233,"_8047":4058,"_15":8231,"_8048":4058,"_19":8234,"_8050":4058},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4612":8237,"_8047":8238,"_15":8235,"_8048":8239,"_19":8240,"_8050":7643},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4612":8243,"_8047":8244,"_15":8241,"_8048":4058,"_19":8245,"_8050":7616},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4612":8248,"_8047":4058,"_15":8246,"_8048":8249,"_19":8250,"_8050":7710},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4612":8252,"_8047":8253,"_15":7723,"_8048":8254,"_19":8255,"_8050":7710},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4612":8258,"_8047":8259,"_15":8256,"_8048":4058,"_19":8260,"_8050":7616},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4612":8136,"_8047":8253,"_15":8261,"_8048":4058,"_19":8263,"_8050":7710},"干员受到灼热附着","sys.tacticalItem",{"_4612":8266,"_8047":4058,"_15":8264,"_8048":4058,"_19":8267,"_8050":7616},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4612":8270,"_8047":8271,"_15":8268,"_8048":4058,"_19":8272,"_8050":7710},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4612":8155,"_8047":8275,"_15":8273,"_8048":4058,"_19":8276,"_8050":7822},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4612":8279,"_8047":8280,"_15":8277,"_8048":8281,"_19":8282,"_8050":7643},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4612":8285,"_8047":4058,"_15":8283,"_8048":4058,"_19":8286,"_8050":7643},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4612":8289,"_8047":8290,"_15":8287,"_8048":4058,"_19":8291,"_8050":7798},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4612":8294,"_8047":8295,"_15":8292,"_8048":4058,"_19":8296,"_8050":7822},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4612":8299,"_8047":8300,"_15":8297,"_8048":4058,"_19":8301,"_8050":7643},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4612":8303,"_8047":8304,"_15":7740,"_8048":8195,"_19":8305,"_8050":7669},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4612":8053,"_8047":8304,"_15":8306,"_8048":4058,"_19":8308,"_8050":7669},"干员受到冻结","ba.naturalvul",{"_4612":8311,"_8047":8312,"_15":8309,"_8048":4058,"_19":8313,"_8050":7772},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4612":8098,"_8047":8315,"_15":7760,"_8048":8316,"_19":8317,"_8050":7798},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4612":8320,"_8047":8321,"_15":8318,"_8048":4058,"_19":8322,"_8050":7616},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4612":8325,"_8047":8326,"_15":8323,"_8048":4058,"_19":8327,"_8050":7616},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4612":8330,"_8047":8331,"_15":8328,"_8048":4058,"_19":8332,"_8050":7616},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4612":8335,"_8047":4058,"_15":8333,"_8048":4058,"_19":8336,"_8050":7616},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4612":8339,"_8047":4058,"_15":8337,"_8048":8340,"_19":8341,"_8050":4058},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4612":8344,"_8047":8345,"_15":8342,"_8048":8346,"_19":8347,"_8050":7643},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4612":8349,"_8047":4058,"_15":7560,"_8048":8350,"_19":8351,"_8050":7772},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4612":8353,"_8047":8354,"_15":7599,"_8048":8355,"_19":8356,"_8050":7798},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4612":8359,"_8047":8360,"_15":8357,"_8048":4058,"_19":8361,"_8050":7616},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4612":8364,"_8047":8365,"_15":8362,"_8048":4058,"_19":8366,"_8050":7772},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4612":8369,"_8047":8370,"_15":8367,"_8048":4058,"_19":8371,"_8050":7616},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4612":8373,"_8047":8374,"_15":7786,"_8048":8375,"_19":8376,"_8050":7772},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4612":8169,"_8047":8374,"_15":8377,"_8048":4058,"_19":8379,"_8050":7772},"干员受到自然附着","ba.originium",{"_4612":8382,"_8047":4058,"_15":8380,"_8048":4058,"_19":8383,"_8050":7643},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4612":8386,"_8047":4058,"_15":8384,"_8048":4058,"_19":8387,"_8050":7798},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4612":8390,"_8047":8391,"_15":8388,"_8048":4058,"_19":8392,"_8050":7798},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4612":8395,"_8047":4058,"_15":8393,"_8048":8396,"_19":8397,"_8050":7806},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4612":8400,"_8047":4058,"_15":8398,"_8048":4058,"_19":8401,"_8050":7616},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4612":8404,"_8047":4058,"_15":8402,"_8048":8405,"_19":8406,"_8050":7822},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4612":8409,"_8047":8410,"_15":8407,"_8048":4058,"_19":8411,"_8050":7616},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4612":8413,"_8047":8275,"_15":7826,"_8048":8414,"_19":8415,"_8050":7822},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4612":8418,"_8047":8419,"_15":8416,"_8048":4058,"_19":8420,"_8050":7822},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4612":8423,"_8047":4058,"_15":8421,"_8048":8424,"_19":8425,"_8050":7643},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4612":8428,"_8047":4058,"_15":8426,"_8048":8429,"_19":8430,"_8050":4058},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4612":8433,"_8047":4058,"_15":8431,"_8048":4058,"_19":8434,"_8050":7616},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4612":8437,"_8047":4058,"_15":8435,"_8048":4058,"_19":8438,"_8050":7643},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4612":8441,"_8047":8442,"_15":8439,"_8048":4058,"_19":8443,"_8050":7616},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4612":8446,"_8047":4058,"_15":8444,"_8048":8447,"_19":8448,"_8050":7643},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4612":8451,"_8047":4058,"_15":8449,"_8048":4058,"_19":8452,"_8050":7616},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4612":8455,"_8047":8456,"_15":8453,"_8048":8457,"_19":8458,"_8050":7643},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4612":8461,"_8047":4058,"_15":8459,"_8048":4058,"_19":8462,"_8050":7643},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4612":8465,"_8047":4058,"_15":8463,"_8048":4058,"_19":8466,"_8050":7643},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4612":8469,"_8047":8470,"_15":8467,"_8048":4058,"_19":8471,"_8050":7616},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4612":8474,"_8047":4058,"_15":8472,"_8048":4058,"_19":8475,"_8050":7643},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4612":8478,"_8047":4058,"_15":8476,"_8048":4058,"_19":8479,"_8050":7643},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4612":8482,"_8047":4058,"_15":8480,"_8048":4058,"_19":8483,"_8050":7643},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4612":8486,"_8047":8487,"_15":8484,"_8048":8488,"_19":8489,"_8050":7643},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4612":8492,"_8047":8493,"_15":8490,"_8048":4058,"_19":8494,"_8050":7616},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4612":8497,"_8047":8498,"_15":8495,"_8048":4058,"_19":8499,"_8050":7616},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4612":8502,"_8047":8503,"_15":8500,"_8048":4058,"_19":8504,"_8050":7616},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4612":8507,"_8047":8508,"_15":8505,"_8048":4058,"_19":8509,"_8050":7616},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4612":8512,"_8047":8513,"_15":8510,"_8048":4058,"_19":8514,"_8050":7616},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4612":8517,"_8047":8518,"_15":8515,"_8048":4058,"_19":8519,"_8050":7616},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4612":8522,"_8047":8523,"_15":8520,"_8048":4058,"_19":8524,"_8050":7616},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4612":8527,"_8047":8528,"_15":8525,"_8048":4058,"_19":8529,"_8050":7616},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4612":8532,"_8047":8533,"_15":8530,"_8048":4058,"_19":8534,"_8050":7616},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4612":8537,"_8047":8538,"_15":8535,"_8048":4058,"_19":8539,"_8050":7616},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4612":8542,"_8047":8543,"_15":8540,"_8048":4058,"_19":8544,"_8050":7616},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4612":8547,"_8047":8548,"_15":8545,"_8048":4058,"_19":8549,"_8050":7616},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4612":8552,"_8047":8553,"_15":8550,"_8048":4058,"_19":8554,"_8050":7616},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4612":8557,"_8047":8558,"_15":8555,"_8048":4058,"_19":8559,"_8050":7616},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7252":8562,"_6770":8571,"_6817":8573,"_6903":8575,"_6905":8577,"_6799":8579,"_6908":8581,"_6911":8583,"_6913":8585,"_6916":8586,"_5911":8588,"_6921":8590,"_6569":8591,"_6926":8592,"_6928":8593,"_6931":8594,"_6934":8595,"_6937":8596,"_6940":8598,"_6943":8599,"_6177":8600,"_6949":8601,"_6952":8602,"_6956":8603,"_6960":8604,"_6183":8605,"_6966":8606,"_6970":8608,"_6974":8609,"_6978":8611,"_6982":8613,"_6986":8615,"_6990":8616,"_6994":8618,"_6998":8620,"_7002":8621,"_7006":8623,"_7010":8625,"_7014":8627,"_7018":8629,"_7022":8632,"_7026":8635,"_7030":8638,"_7034":8641,"_7038":8642,"_7042":8644,"_7046":8645,"_7050":8646,"_7054":8648,"_7058":8650,"_7062":8651,"_7066":8653,"_7070":8655,"_7074":8657,"_7078":8659,"_7082":8661,"_7086":8663,"_7090":8665,"_7093":8667,"_7097":8669,"_7101":8671,"_7105":8672,"_7109":8674,"_7113":8675,"_7117":8676,"_7121":8677,"_7125":8678,"_7129":8679,"_7133":8680,"_7137":8681,"_7141":8682,"_7145":8683,"_7149":8684,"_7153":8685,"_7157":8686,"_7161":8687,"_7165":8688,"_7169":8689,"_7173":8690,"_7177":8691,"_7181":8692,"_7185":8693,"_7188":8694,"_7192":8695,"_7196":8696,"_7200":8697,"_7204":8698,"_7208":8699,"_7212":8701,"_7216":8702,"_7220":8703,"_8704":8705,"_8706":8707,"_8709":8710,"_8711":8712,"_8713":8714,"_8715":8716,"_8717":8718,"_8719":8720,"_8721":8722,"_8723":8724,"_8725":8726,"_8728":8729,"_8731":8732,"_8733":8734,"_8736":8737,"_8739":8740,"_8741":8742},{"_8563":