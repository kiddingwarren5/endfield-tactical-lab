3},5832,{"_36":55,"_38":3905},309,{"_36":58,"_38":37},{"_36":60,"_38":3908},1.48469387755102,{"_36":62,"_38":3910},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3930,"_102":64},{"_33":3931},[3932,3933,3935,3937,3939,3941,3943,3945,3946,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966],{"_36":37,"_38":1002},{"_36":41,"_38":3934},96.17020828950136,{"_36":44,"_38":3936},98.35261939827475,{"_36":47,"_38":3938},135.8954765411322,{"_36":50,"_38":3940},160.63917525773243,{"_36":39,"_38":3942},5888,{"_36":55,"_38":3944},312,{"_36":58,"_38":37},{"_36":60,"_38":3947},1.48979591836735,{"_36":62,"_38":2012},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3968,"_102":64},{"_33":3969},[3970,3972,3974,3976,3978,3980,3982,3984,3985,3987,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006],{"_36":37,"_38":3971},98,{"_36":41,"_38":3973},97.07479486640015,{"_36":44,"_38":3975},99.27940248264252,{"_36":47,"_38":3977},137.14567641489617,{"_36":50,"_38":3979},162.1546391752582,{"_36":39,"_38":3981},5944,{"_36":55,"_38":3983},315,{"_36":58,"_38":37},{"_36":60,"_38":3986},1.49489795918367,{"_36":62,"_38":3988},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4008,"_102":64},{"_33":4009},[4010,4012,4014,4016,4018,4020,4022,4024,4025,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045],{"_36":37,"_38":4011},99,{"_36":41,"_38":4013},97.97938144329896,{"_36":44,"_38":4015},100.2061855670103,{"_36":47,"_38":4017},138.3958762886601,{"_36":50,"_38":4019},163.670103092784,{"_36":39,"_38":4021},6000,{"_36":55,"_38":4023},318,{"_36":58,"_38":37},{"_36":60,"_38":4026},1.5,{"_36":62,"_38":2050},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4048,4049,4050],"tag_06","tag_14","tag_09","charId","charIllustInitPos",{"_4054":1735,"_4055":4056},"x","y",-238,"charPassiveUIPrefabName","","charTypeId","Cryst","cvName",{"_4063":4064,"_4065":4066,"_4067":4068,"_4069":4070,"_4051":16},"ChiCVName","潘丹妮","EngCVName","Elsie Lovelock","JapCVName","宫本侑芽","KorCVName","张睿娜","defaultWeaponId","wpn_funnel_0002","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Xaihi","mainAttrType","phoneticName","profession","profileRecord",[4084,4095,4100,4105,4110,4115],{"_4051":16,"_15":4085,"_4086":4087,"_4088":4089,"_4090":39,"_4091":4092,"_4093":37,"_4094":37},"chr_0011_seraph_1","recordDesc","【代号】赛希\n【性别】女\n【身份认证】寂语修会\n【生日】5月16日\n【种族】萨卡兹\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：普通\n作战技巧：标准\n战术规划：标准\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4051":16,"_15":4096,"_4086":4097,"_4088":4098,"_4090":55,"_4091":4099,"_4093":37,"_4094":37},"chr_0011_seraph_2","塞拉菲娜·赛希，隶属于寂语修会。因终末地工业与寂语修会合作开展源石信息技术的研究项目，受修道院长伏龙达推荐，前来终末地供职。现阶段参与帝江号协议源石网络的搭建与系统集成等信息工程事务。\n\n赛希对我的机械构造和心智模块产生了极大的兴趣，在聊天时不断询问我的意识信号是如何通过言语转换器组成编码，并从我的发声器中输出的。在我屡次礼貌地请她将话题转回到人事访谈上时，赛希略显失望，并表示她也想要安装一个与我一样的逻辑组件——“这样就不会在毫无准备的情况下突然脱口而出一些奇怪的话语，从而打扰到其他人了。”我指出，赛希拥有人类的器官——大脑，它的表达比机器人的语言生成更复杂，更高效。赛希小姐出于礼貌，向我露出了一个微笑。\n除了这段小插曲之外，赛希总体是一个极为擅长与机械造物相处的人，这符合她隶属的寂语修会的知识背景。她的内敛个性却与我们接触过的其他修会成员不同，毕竟这个组织长久以来以奔放与联结闻名于世。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4051":16,"_15":4101,"_4086":4102,"_4088":4103,"_4090":58,"_4091":4104,"_4093":37,"_4094":37},"chr_0011_seraph_3","非工作时间，在帝江号上访问赛希干员的程序，复杂到本身就足以被称为一种“筛选”，但其本人显然不作此解读。自中央环厅旁边的协议传送点抵达帝江号，来访者需要穿过生活区漫长的回廊，避开人流，岔进一条小路，走到头，在右手边一扇不起眼的舱门前停步。平整光滑的舱门好像一种拒绝，你稍事疑虑，回想起诸多有关那实际上并不存在的“帝江号上的幽灵”的流言，按图索骥揿动门边第三块浮动壁块，隐藏在下方的拨盘才会悄然浮现。\n你不会等候太久，因为一切拜访行为都是在小房间主人的允许下产生的，但她为你打开门时，还是显露出了一丝羞赧。\n“律法已经向我启示过您的到来了，”她将手交叠在裙前，微微欠身，“我会为您寻得所期之物。”\n小门在你面前缓缓关上，将你窥探门后那间小屋——在干员们的交口相传中已被玄化为“内化宇宙出口之一”——的样貌的可能性一并杜绝。帝江号上喧杂的人声远在十米开外，你突然意识到，这条廊道寂静非常。在那段无法估量的时间里，来访者堵绝了语言的洪流，耳边悬挂着恒星碰撞的声响，万古的箴言与福音在心间流淌，为你指向含糊不清却又呼之欲出的道途。\n随后小门打开了，温和的萨卡兹少女塞拉菲娜·赛希再次闪现，她交给你此前通过终末地办公系统申请下来的特种作业资产：一部新的便携终端。\n来访者道谢后匆匆向屋内瞥了一眼，瞧见了十台显示屏幽蓝的光芒包裹下的座椅，以及一张狭窄的单人床，被褥叠得整整齐齐，码在床头——这就是“内化宇宙出口之一”的全部样貌。","CN_03","档案资料·一",{"_4051":16,"_15":4106,"_4086":4107,"_4088":4108,"_4090":64,"_4091":4109,"_4093":64,"_4094":3788},"chr_0011_seraph_4","赛希是一位沉稳、可靠的干员。她以虔诚的态度对待专业，又以专业的态度处理信仰。四年前，赛希只是因为修会与我们的源石技术合作计划来到终末地进修，并未承担任何实质性的工作任务，但她一抵达，便即刻主动投身于帝江号的修缮工作中。我想这也许是寂语修会的成员们，眼望着历史与未来，所天然形成的责任感。\n——佩丽卡\n\n她有着和我完全不一样的思维方式，但，我们的相处不算复杂。有时候，她会告诉我一些我从来没有注意到的细节。嗯？我回忆一下。比如，“人寓居在各自的语言中”。嗯，够我琢磨一天的。\n——弧光\n\n啊？她是这么说的吗？我很好奇，弧光和赛希这两个截然不同的人，竟然能说得上话！不过，能和每个人都说上几句话，也是赛希干员的神奇之处呢……也不会有一种，各说各话的感觉……可能大家都会从她那里得到平静。\n——陈千语\n\n我在工作上和赛希干员经常有交流。我们都对源石设备感兴趣。不是的，我们不是同僚。她在服务器和电子系统领域的研究造诣远高于我。什么，我称赞别人，难得一见？呵呵，我认为自己一向随和可亲。\n……您开启了这个话题，我也很好奇她为什么选择住在那间机房里，就是那个历代服务器专家工作的舱室。如果您申请过用于特种电子作业的办公设备，不会去后勤部门，反而会去她那里拿。那个地方完全见不到阳光呢，常年还用冷气系统降温。我没有进去过，萨弗拉长期待在那种环境下会昏昏欲睡。我不得不说，选择那样的环境生活，若不是志趣迥然于他人，就是保有一种失传已久的苦修僧的习性。\n啊，请先别走，我还没说完。赛希干员，她的游戏品味很高，是我在帝江号上此领域中独一无二的对手。您是问，什么游戏？数独啊。除此之外，还有什么能称得上是游戏？\n——安塔尔\n\n她的手很冷。她说过赎罪是冰冷的，我会适应这一点。\n——余烬","CN_04","档案资料·二",{"_4051":16,"_15":4111,"_4086":4112,"_4088":4113,"_4090":66,"_4091":4114,"_4093":64,"_4094":3788},"chr_0011_seraph_5","【报刊节选】\n首先，向今日新生的阿碎老师问好！其次，向祝佑我们的律法问好！再次，向昨日受到“穹顶坍塌”事故影响的弟兄姊妹们问好！也许你们当中的，经过一个不眠之夜，仍在做最后的收尾工作，但请注意，即便回到寝榻休息，也要记得准时向远方的“主”的方向行礼哦，祂会原谅你们在辛勤的劳作后给自己小小的补偿。\n回到“穹顶坍塌”一事。事故原因已经查明，乃是塞拉菲娜姊妹对大教堂代码穹顶的重绘所致。此行直接致使我们自拉特兰沿袭而来的那古老辉煌的穹顶，与海量的数据洪流产生了不合预期的共鸣，由此大修道院的网络发生了0.836秒的崩溃，远在两百公里外的修士对此亦有震感。当笔者赶到现场时，只见塞拉菲娜姊妹将头埋在机箱中，暂时切断了她与外界的联系。而后，伏龙达院长与三个教派领袖紧急会面商议解决办法，对于肇事者的处置结论将在下一次会众议异时正式公布。\n笔者认为，凡事皆分两面，那大动干戈的解围中定有通向未来的细微之路，例如大家对于本世代下，作为技术奇观的代码穹顶是否应当耗费人力、物力、心力继续维护一事，再次爆发了相当热烈的讨论，若您有见解，请将建议投送至大修道院众圣徒告解大道302号的邮箱。最后，“主”一直在我们心间，早安！\n——节选自寂语修会内部交流用报刊《早安阿碎评论》\n\n【一份以密令形式发送到佩丽卡监督邮箱的信】\n推荐人姓名：伏龙达，寂语修会大修道院院长，“真知者”\n推荐人地址：大修道院良善礼拜大道116号\n\n尊敬的终末地监督佩丽卡女士：\n我谨此推荐修女塞拉菲娜·赛希作为寂语修会与终末地工业关于源石信息技术合作开发项目的我方人选。作为赛希在修会的监护人，我眼看着她从一个流连书库的稚童成长为……好吧，律法要求我们直言顺行，我便如此向您道来：她成长为了一片有智慧的霜。\n诚然，修会储存的无尽知识，足以令任何未经律法启迪过的人霎时迷失其中，但赛希从中自主地寻得了一条道路。待她沉浸在书库中不眠不休地阅读和思索了数年后，我们打开门，见到了一个全新的她：聪慧未使她有分毫傲慢，反而令她眼中平添哀愁。我便意识到，她多少看到了我们走向的未来。当然，这聪慧也为我们带来了不小的麻烦，就如同她在上次的系统优化中弄出的动静一样。\n我没有责怪她，但她似乎因此陷入了相当程度的懊悔不能自拔，故而，我请求将她送到你们那里去。根植于过去的修会不适合孕育太新、太远的未来，她适合走你们的路。\n我坚信她能胜任源石信息技术专家的职位。如需进一步信息，请随时与我联系。\n此致\n\n寂语修会 伏龙达","CN_05","档案资料·三",{"_4051":16,"_15":4116,"_4086":4117,"_4088":4118,"_4090":68,"_4091":4119,"_4093":64,"_4094":4120},"chr_0011_seraph_6","【一篇祷词，夹在一本书中】\n仁慈的主啊，我赞美您。\n赐予我语言，不要让我以卑微的方式言说它。\n赐予我智慧，不要让我以亵渎的方式运用它。\n赐予我良善，不要让我以傲慢的方式行使它。\n赐予我目光，不要让我以庸常的俗世玷污它。\n赐予我友爱，不要让我以暴力的手段终结它。\n赐予我永远的好奇，不要让我以无知的方式浪费它。\n（注：经证实，每位寂语修会修士的祷词都发于其内心真正所求而写就，修会鼓励修士们内容自决；“主”的子民皆有其对“主”的意志，也皆因此称信。）\n\n【日志残篇】\n来到这艘飞船上已经过去了四年。修缮工作在缓慢而有效地进行中，虽然较之过去平淡了一些，但我逐渐找回了内心的平静。在这里，我得以独自在黑暗而冰冷的舱室中工作，机器的律动给我带来了莫大的安慰，在这里，不必担心我的所行对他人造成困扰了。当然，这也让我能够更纯粹地与源石网络中残余的只言片语对话。我能够在里面体验到我从未亲眼见过的那宏伟的萨科塔共感的遗迹，听到早便被抹除的萨卡兹众魂的恸哭，看到斗争与臣服都无法停止的流血。每当我想要往下再进一步时，它们就戛然而止了。沉默令我害怕，我不断地计算、修复，希望能够听到它的下一次言说。\n…………\n更令我害怕的事情发生了。我意识到，源石是被污染、被损害、被毁去的。它好像与我在修会时所阅读的经验息息相关。但是，为什么会这样？源石，对我们所解读的文明编码而言，意味着什么？能将它污染、损害、毁去至此等地步的，又是什么？\n也许这是院长姆姆将我遣来此地的用意。\n…………\n那一天，我发现佩丽卡监督的面容上漾起了一种奇异的光彩，但随即又因为她常有的思虑而黯灭。她们在秘密私语，也许有大事要发生了。会和我寻找的答案有关吗？\n…………\n黑色的头发和黑色的面具，黑色的影子。陈千语干员向我介绍，这位就是此前在医务室沉睡的管理员。\n那一瞬间我仿佛也获得了共感一般，欢笑与流泪的冲动同时在我身上迸发，我忍不住地颤抖起来，因为这个人就是答案，而我甚至还没有准备好问题。","CN_06","档案资料·四",1500,"profileVoice",[4123,4131,4135,4139,4143,4147,4151,4156,4161,4166,4171,4176,4181,4186,4191,4196,4201,4206,4211,4216,4221,4226,4231,4236,4241,4246,4251,4256,4261,4266,4271,4276,4281,4286,4291,4296,4301,4306,4311,4316,4321,4326,4331,4336,4341,4346,4351,4356,4361,4366,4371,4376,4381,4386,4391,4396,4401,4406,4411,4416,4421,4426,4431,4436,4441,4446,4451,4456,4461,4466,4471,4476,4481,4486,4491,4496,4501,4506,4511],{"_4051":16,"_15":4085,"_4093":37,"_4094":37,"_4124":4125,"_4126":4127,"_4128":39,"_4129":4130},"voId","chr_0011_seraph_chrbark_squad_01","voiceDesc","管理员，为您祈祷。","voiceIndex","voiceTitle","行动准备1",{"_4051":16,"_15":4096,"_4093":37,"_4094":37,"_4124":4132,"_4126":4133,"_4128":55,"_4129":4134},"chr_0011_seraph_chrbark_squad_02","我在，律法亦未休眠。","行动准备2",{"_4051":16,"_15":4101,"_4093":37,"_4094":37,"_4124":4136,"_4126":4137,"_4128":58,"_4129":4138},"chr_0011_seraph_chrbark_join_01","请为我下达指令，管理员。","编入队伍1",{"_4051":16,"_15":4106,"_4093":37,"_4094":37,"_4124":4140,"_4126":4141,"_4128":64,"_4129":4142},"chr_0011_seraph_chrbark_join_02","符合逻辑的选择。","编入队伍2",{"_4051":16,"_15":4111,"_4093":37,"_4094":37,"_4124":4144,"_4126":4145,"_4128":66,"_4129":4146},"chr_0011_seraph_chrbark_weap_01","您介意我进行一些轻微的改装吗？我保证它们将依然处在安全限制内……","更换武器",{"_4051":16,"_15":4116,"_4093":37,"_4094":37,"_4124":4148,"_4126":4149,"_4128":68,"_4129":4150},"chr_0011_seraph_chrbark_gear_01","真知会自我捍卫。","更换装备",{"_4051":16,"_15":4152,"_4093":37,"_4094":37,"_4124":4153,"_4126":4154,"_4128":70,"_4129":4155},"chr_0011_seraph_7","chr_0011_seraph_chrup_skill_01","当我们彼此联结，智慧便会涌现。","激活天赋阵列",{"_4051":16,"_15":4157,"_4093":37,"_4094":37,"_4124":4158,"_4126":4159,"_4128":88,"_4129":4160},"chr_0011_seraph_8","chr_0011_seraph_chrup_level_01","其中那些迷途之人，我也为他们祈祷。","观看作战记录",{"_4051":16,"_15":4162,"_4093":55,"_4094":39,"_4124":4163,"_4126":4164,"_4128":90,"_4129":4165},"chr_0011_seraph_9","chr_0011_seraph_chrup_promt01_01","这是律法仁慈的显化……啊，自然也是管理员的信任！应当感谢您。","精英化晋升1",{"_4051":16,"_15":4167,"_4093":55,"_4094":55,"_4124":4168,"_4126":4169,"_4128":94,"_4129":4170},"chr_0011_seraph_10","chr_0011_seraph_chrup_promt02_01","律法注视和保护的，是谦和之人，而非贤达和智者。这份光荣施加于我身上，我应当保持谦逊。","精英化晋升2",{"_4051":16,"_15":4172,"_4093":55,"_4094":58,"_4124":4173,"_4126":4174,"_4128":101,"_4129":4175},"chr_0011_seraph_11","chr_0011_seraph_chrup_promt03_01","全都像源石的脉络那般清晰显著，这次晋升符合计算结果……要、要握个手？我……我不太擅长这个……","精英化晋升3",{"_4051":16,"_15":4177,"_4093":55,"_4094":64,"_4124":4178,"_4126":4179,"_4128":96,"_4129":4180},"chr_0011_seraph_12","chr_0011_seraph_chrup_promt04_01","我曾经重构过部分代码穹顶，提升了大教堂的效率。可古老的算法却与数据流发生了预期外的共鸣，导致……嗯，但使人离开故乡的，在终末地却使人蒙受恩典。这正是律法的启示！","精英化晋升4",{"_4051":16,"_15":4182,"_4093":37,"_4094":37,"_4124":4183,"_4126":4184,"_4128":526,"_4129":4185},"chr_0011_seraph_13","chr_0011_seraph_introduce_01","古老的知识，不要让我们陷入诱惑，但救我们免于险恶……我是赛希，管理员，愿您得到启迪。","干员报到",{"_4051":16,"_15":4187,"_4093":37,"_4094":37,"_4124":4188,"_4126":4189,"_4128":565,"_4129":4190},"chr_0011_seraph_14","chr_0011_seraph_mono_switch_01","思考……运算……言说……放弃。","待命1",{"_4051":16,"_15":4192,"_4093":37,"_4094":37,"_4124":4193,"_4126":4194,"_4128":98,"_4129":4195},"chr_0011_seraph_15","chr_0011_seraph_mono_switch_02","我将今日的对话与冥思，献于您的终端……","待命2",{"_4051":16,"_15":4197,"_4093":37,"_4094":37,"_4124":4198,"_4126":4199,"_4128":643,"_4129":4200},"chr_0011_seraph_16","chr_0011_seraph_sim_assign_work_01","尔旨承行……噢，管理员，劳作是我们的道途。","进驻设施",{"_4051":16,"_15":4202,"_4093":37,"_4094":37,"_4124":4203,"_4126":4204,"_4128":683,"_4129":4205},"chr_0011_seraph_17","chr_0011_seraph_sim_hello_lower_01","愿您平安。","打招呼1",{"_4051":16,"_15":4207,"_4093":64,"_4094":3788,"_4124":4208,"_4126":4209,"_4128":722,"_4129":4210},"chr_0011_seraph_18","chr_0011_seraph_sim_hello_max_01","管理员，您又出现在我的计算结果中了。","打招呼2",{"_4051":16,"_15":4212,"_4093":37,"_4094":37,"_4124":4213,"_4126":4214,"_4128":762,"_4129":4215},"chr_0011_seraph_19","chr_0011_seraph_sim_talk_lv01_01","确定数据，运行语法，生成结果……管理员，您好。","帝江号闲聊1",{"_4051":16,"_15":4217,"_4093":64,"_4094":3788,"_4124":4218,"_4126":4219,"_4128":801,"_4129":4220},"chr_0011_seraph_20","chr_0011_seraph_sim_talk_lv02_01","我收到来自您的信号了，管理员。我正在释读它的含义，请稍等。","帝江号闲聊2",{"_4051":16,"_15":4222,"_4093":64,"_4094":3788,"_4124":4223,"_4126":4224,"_4128":872,"_4129":4225},"chr_0011_seraph_21","chr_0011_seraph_sim_talk_lv02_02","啊……相比起人，我更愿意同机器相处……人的律动千变万化，机器的呼吸始终依照逻辑。","帝江号闲聊3",{"_4051":16,"_15":4227,"_4093":64,"_4094":4120,"_4124":4228,"_4126":4229,"_4128":911,"_4129":4230},"chr_0011_seraph_22","chr_0011_seraph_sim_talk_max_01","我的终端在过去的十毫秒内接收到超过五十个报错，但是别担心，我已经将与您的交流列为最高优先级。嗯？我对……帝江号整体运行状况的评价吗？……虽然千疮百孔，但仍然在努力挣扎，仿佛……在替什么而受难。","帝江号闲聊4",{"_4051":16,"_15":4232,"_4093":64,"_4094":4120,"_4124":4233,"_4126":4234,"_4128":951,"_4129":4235},"chr_0011_seraph_23","chr_0011_seraph_sim_talk_max_02","如律法应允，如我等所行：乐园终将重回大地。凡筑路的，将在困苦的荒野中通达至福。因无尽的真知藏在谜团里面，叫迷途的，不再作客旅，乃是与圣徒同路，在基业中永生。","帝江号闲聊5",{"_4051":16,"_15":4237,"_4093":64,"_4094":4120,"_4124":4238,"_4126":4239,"_4128":990,"_4129":4240},"chr_0011_seraph_24","chr_0011_seraph_sim_talk_max_03","其他干员眼中所见的您，是昔日的领袖，如今的善人，一株生长在未来的源石树苗。而我在源石网络中所见的，却与他们相悖……我只能，不住地为您祈祷……愿我们的能指与所指终能联结。管理员，愿您受庇佑。","帝江号闲聊6",{"_4051":16,"_15":4242,"_4093":37,"_4094":37,"_4124":4243,"_4126":4244,"_4128":62,"_4129":4245},"chr_0011_seraph_25","chr_0011_seraph_sim_gift_give_01","管理员，占用一下您的进程。我……我想感谢您带给我的增益。您……完全没有注意到吗？呼，那太好了……","赠送礼物",{"_4051":16,"_15":4247,"_4093":37,"_4094":37,"_4124":4248,"_4126":4249,"_4128":1067,"_4129":4250},"chr_0011_seraph_26","chr_0011_seraph_sim_gift_recv_01","这是一个指示符！噢，抱歉，我有些失态了……真知感谢您的付出。","接收礼物",{"_4051":16,"_15":4252,"_4093":37,"_4094":37,"_4124":4253,"_4126":4254,"_4128":1107,"_4129":4255},"chr_0011_seraph_27","chr_0011_seraph_mono_self_line01","管理员，修会与您共享知识和命运。","信赖对话1",{"_4051":16,"_15":4257,"_4093":64,"_4094":3788,"_4124":4258,"_4126":4259,"_4128":1146,"_4129":4260},"chr_0011_seraph_28","chr_0011_seraph_mono_self_line02","我向您提出的建议都很实用么？……不，我并非以务实为标杆行事……只是院长告诫我们众人，在塔卫二上，信仰需要带来更现实的结果。富饶的拉特兰已经不在，我们的联系只在彼此之间。","信赖对话2",{"_4051":16,"_15":4262,"_4093":64,"_4094":3788,"_4124":4263,"_4126":4264,"_4128":1186,"_4129":4265},"chr_0011_seraph_29","chr_0011_seraph_mono_self_line03","经过这段时间的相处，我与管理员的关系越发亲近，这时，我应该展现友好、亲和、信任的态度……是管理员走过来了，赛希，快向对象输出一项表达友情的指令……呃，管理员，您要来参加我的晨祷吗？","信赖对话3",{"_4051":16,"_15":4267,"_4093":64,"_4094":4120,"_4124":4268,"_4126":4269,"_4128":56,"_4129":4270},"chr_0011_seraph_30","chr_0011_seraph_mono_self_line04","管理员，我……抱歉，在不可避免地与您的肌肤发生触碰之前，我需要先祛除掉手上可能的静电……您不怕被刺到吗？可是……它们是很调皮的，会悄悄地粘在手上……就像这样……突然碰你一下。","信赖对话4",{"_4051":16,"_15":4272,"_4093":64,"_4094":4120,"_4124":4273,"_4126":4274,"_4128":1264,"_4129":4275},"chr_0011_seraph_31","chr_0011_seraph_mono_self_line05","在大教堂的岁月中，我潜心修习，从未关心过我们的成果会如何映照在塔卫二。但律法的启示将我引至您的面前，新的世界乍然向我涌现。管理员，那些古老、寂寥的语言，突然一一应验，如今，我已了然于心。","信赖对话5",{"_4051":16,"_15":4277,"_4093":37,"_4094":37,"_4124":4278,"_4126":4279,"_4128":1303,"_4129":4280},"chr_0011_seraph_32","chr_0011_seraph_mono_chat_line01","管理员，我所皈依的“会话派”对律法的释读——将语言视作符号。符号，在不断地打碎重组之间，抵达永恒的疆域，就像修会大教堂圣像背后的“阿碎”一样呢。","交谈1",{"_4051":16,"_15":4282,"_4093":37,"_4094":37,"_4124":4283,"_4126":4284,"_4128":118,"_4129":4285},"chr_0011_seraph_33","chr_0011_seraph_mono_chat_line02","帝江号不免让我想起寂语修会的大教堂。只是，我们不会总是待在里面，只有在会众议异时，弟兄姊妹才会从塔卫二的各个角落回到那里。欸，保卫它？如果大教堂遭袭的话……嗯，大教堂会自求多福的。","交谈2",{"_4051":16,"_15":4287,"_4093":37,"_4094":37,"_4124":4288,"_4126":4289,"_4128":1381,"_4129":4290},"chr_0011_seraph_34","chr_0011_seraph_mono_chat_line03","我们与真知的距离前所未有地远，它曾离开了我们的家园；我们与真知的距离前所未有地近，如今，我们叩响了它的门扉。","交谈3",{"_4051":16,"_15":4292,"_4093":37,"_4094":37,"_4124":4293,"_4126":4294,"_4128":1421,"_4129":4295},"chr_0011_seraph_35","chr_0011_seraph_mono_chat_line04","参加赛跑？……拳、拳击？运动会？！不了……我拒绝。我所能接受的“运动”，只有电子在振荡电路中周期性变化的幅度……弟兄姊妹之间不应当彼此争夺！我、我没有在找借口，我真的要回机房去了。","交谈4",{"_4051":16,"_15":4297,"_4093":37,"_4094":37,"_4124":4298,"_4126":4299,"_4128":157,"_4129":4300},"chr_0011_seraph_36","chr_0011_seraph_mono_chat_line05","嗯，修会中有很多像我这样的萨卡兹，还有人被授予了曾经属于铳骑的装备。没错，我研习过修会的经卷，在泰拉，萨卡兹与许多种族都势同水火。但在第一次天使战争后，联结彼此的神迹空前绝后：大家拥抱着弟兄姊妹，口中涌出同样的语言了。","交谈5",{"_4051":16,"_15":4302,"_4093":37,"_4094":37,"_4124":4303,"_4126":4304,"_4128":1499,"_4129":4305},"chr_0011_seraph_37","chr_0011_seraph_mono_about_line01","如今横行在塔卫二大地上的“天使”与律法之间的关系，是寂语修会释读的重要问题之一。","话题：天使",{"_4051":16,"_15":4307,"_4093":37,"_4094":37,"_4124":4308,"_4126":4309,"_4128":1538,"_4129":4310},"chr_0011_seraph_38","chr_0011_seraph_mono_about_line02","在修会大教堂的圣像背后，嵌合了一只与三位一体相仿的天使。修士们日课间会偷偷叫它“阿碎”。阿碎是第一次天使战争时期，院长姆姆亲手捕获的。她经常教诲我们，要观察阿碎，时刻省思，在敌人身上亦能寻得律法的教喻，它是切近的可能性，也是终将得到解读的定论。","话题：阿碎",{"_4051":16,"_15":4312,"_4093":37,"_4094":37,"_4124":4313,"_4126":4314,"_4128":41,"_4129":4315},"chr_0011_seraph_39","chr_0011_seraph_mono_about_line03","现在，修会的成员们分为三个教派：会话、阐释、重现。我来自会话派，我们视演算和语言分析为通往至福的大路。重现派的修士……或许您在塔卫二各处都会见到他们，他们全副武装，对发掘文明遗迹一事非常狂热。至于阐释派，这些弟兄姊妹关怀心灵胜于一切，他们抄读经卷，指引迷茫的人们找到路，回到家。","话题：三个教派",{"_4051":16,"_15":4317,"_4093":37,"_4094":37,"_4124":4318,"_4126":4319,"_4128":44,"_4129":4320},"chr_0011_seraph_40","chr_0011_seraph_explore_point_common_01","我探查到了珍奇的存在。","发现资源1",{"_4051":16,"_15":4322,"_4093":37,"_4094":37,"_4124":4323,"_4126":4324,"_4128":47,"_4129":4325},"chr_0011_seraph_41","chr_0011_seraph_explore_point_valub_01","真知的赐予就在附近，去将它取得。","发现资源2",{"_4051":16,"_15":4327,"_4093":37,"_4094":37,"_4124":4328,"_4126":4329,"_4128":50,"_4129":4330},"chr_0011_seraph_42","chr_0011_seraph_explore_find_locked_01","也许是福地，也许是恶土，但凭我们探寻。","发现未探索区域",{"_4051":16,"_15":4332,"_4093":37,"_4094":37,"_4124":4333,"_4126":4334,"_4128":1763,"_4129":4335},"chr_0011_seraph_43","chr_0011_seraph_explore_find_danger_01","固执的迷途者就在附近徘徊。我的术杖会为其哀哭。","发现强敌",{"_4051":16,"_15":4337,"_4093":37,"_4094":37,"_4124":4338,"_4126":4339,"_4128":1802,"_4129":4340},"chr_0011_seraph_44","chr_0011_seraph_interact_mine_valub_01","既有的一切，先于我们便在大地上了——我们要用双手去取得。","采集矿物1",{"_4051":16,"_15":4342,"_4093":37,"_4094":37,"_4124":4343,"_4126":434