,5832,{"_36":55,"_38":3907},340,{"_36":58,"_38":37},{"_36":60,"_38":3910},1.48469387755102,{"_36":62,"_38":3912},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3932,"_102":64},{"_33":3933},[3934,3936,3938,3940,3942,3944,3946,3948,3949,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969],{"_36":37,"_38":3935},97,{"_36":41,"_38":3937},88.51546391752576,{"_36":44,"_38":3939},137.07208079107963,{"_36":47,"_38":3941},188.64401430675414,{"_36":50,"_38":3943},112.55670103092783,{"_36":39,"_38":3945},5888,{"_36":55,"_38":3947},343,{"_36":58,"_38":37},{"_36":60,"_38":3950},1.48979591836735,{"_36":62,"_38":2014},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3971,"_102":64},{"_33":3972},[3973,3975,3977,3979,3981,3983,3985,3987,3988,3990,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009],{"_36":37,"_38":3974},98,{"_36":41,"_38":3976},89.35051546391752,{"_36":44,"_38":3978},138.3463496738905,{"_36":47,"_38":3980},190.35293498842887,{"_36":50,"_38":3982},113.61855670103093,{"_36":39,"_38":3984},5944,{"_36":55,"_38":3986},347,{"_36":58,"_38":37},{"_36":60,"_38":3989},1.49489795918367,{"_36":62,"_38":3991},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4011,"_102":64},{"_33":4012},[4013,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":925},{"_36":41,"_38":4015},90.18556701030927,{"_36":44,"_38":4017},139.62061855670134,{"_36":47,"_38":4019},192.06185567010363,{"_36":50,"_38":4021},114.68041237113401,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},350,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2052},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_07","tag_10","tag_23","charId","charIllustInitPos",{"_4056":1070,"_4057":4058},"x","y",-103,"charPassiveUIPrefabName","","charTypeId","Cryst","cvName",{"_4065":4066,"_4067":4068,"_4069":4070,"_4071":4072,"_4053":16},"ChiCVName","侯小菲","EngCVName","Clare Louise Connolly","JapCVName","雨宫天","KorCVName","吕允美","defaultWeaponId","wpn_pistol_0001","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Yvonne","mainAttrType","phoneticName","profession","profileRecord",[4086,4097,4102,4107,4113,4118],{"_4053":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0017_yvonne_1","recordDesc","【代号】伊冯\n【性别】女\n【身份认证】终末地工业\n【生日】5月9日\n【种族】瓦伊凡\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：普通\n战术规划：标准\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0017_yvonne_2","干员伊冯，经联盟工团的克劳推荐给安德烈，以“特殊人才引进”的渠道被招募进终末地工业的特种技术部门，现负责对超域、侵蚀及其相关装置“全频超域抑稳自动机”的研究。因其出色的科研能力，额外划拨资源帮助其独立研究。\n\n在进行背景调研时，很多人都表示伊冯是一位相当“叛逆”的工程师，但我并不完全认同这一评价。不，与她给我贴的镭射贴纸无关。\n在我看来，最核心的原因是大部分人无法跟上她的思考速度，显得她在协作方面有些问题。其次，她对长年研究中形成的个人风格相当自信……并非蓄意违抗规范，而是本能地抗拒对她思考方式与表达路径的干涉。\n这份难以被环境塑形的特质很容易被认为是叛逆。但实际上，光鲜的穿着、肆意的涂鸦、那些极繁却又非常实用的机械外形设计，都是她贯彻自我的表现——周围充满条条框框时，任何坚持自我的人都会显得格格不入。幸运的是，终末地并没有僵化的教条，我们的目标本就是改造这个世界，而非循规蹈矩地维持它。\n更何况，所有人说她“叛逆”的时候，脸上都带着笑。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0017_yvonne_3","【失物招领清单】\n一个镭射果冻手提袋——外部印着灿烂笑脸涂鸦，内袋放着熏香的珠子。\n一个指甲油瓶子——内部装着会根据超域能量浓度改变颜色的环境感知涂料。\n一件儿童玩具——用螺母、齿轮、轴承等五金工件组装而成，外形为有些眼熟的六边形结构，涂装非常艳丽。\n一组纪念镭射卡——似乎是为首届塔卫二“堡垒守御”获奖者专门定制的奖励，背面刻着一位瓦伊凡的头像。\n迷你超域读数检测设备——外表像是一根项链。因输入了尚未发表的公式，灵敏度比市面上的同类产品更高。\n半盒荞花风味热辣口感颗粒泡芙——目前最流行的甜点，味道十分微妙。（早上看到佩丽卡监督的桌子上还有半盒。）\n“好工程师”螺丝刀套组——樱花粉定制款。被使用者保养得很好，没有任何生锈痕迹。\n《MARTHE月刊》——今天发售的最新一期，介绍了塔卫二当下最潮流的穿搭。（两周前似乎看到伊冯穿着封面上的这套时装……她好像总是先于潮流，难道她真的是那个传闻中的影子设计师？）\n留言：伊冯，我知道原型机的实验很重要，但请快点来拿遗失物品！","CN_03","档案资料·一",{"_4053":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":4112},"chr_0017_yvonne_4","【一宗火灾意外事故的调查报告】\n案件概述：昨日夜里，位于近郊与中心区交界处边缘一栋宅邸二层的图书室起火，大量家具与复古裙装烧毁，火势控制在该房间内部，未造成任何人员伤亡，书籍完好无损。\n\n1. 现场勘查\n图书室窗户从内反锁，门锁无破坏痕迹，共提取指纹两组。靠近花园一侧仅有负责定期修剪花园的园林工人脚印。起火点为雕花衣柜。\n\n2. 监控检查\n夜间八点左右，屋主的女儿与屋主在会客厅进行了详谈。九点两人走出会客厅，前往图书室。\n\n3. 证人证言\n屋主：“抱歉，麻烦你们特地来一趟……不过没关系。每隔几个世纪，人们就得烧一次图书馆。”\n屋主的妻子：“我丈夫在女儿出生前就布置好了那个房间，希望她能延续古老的文化，继承那些文学与艺术，在这片新的土地上扎根。我还想着她能去创立一个文化复兴研究团体……发生这样的事故真是太可惜了。”\n屋主的女儿：“呃……其实控制得很精准，没什么损失嘛！这也要查？”\n女儿的家庭教师：“其实我已经没有在教导小姐了。她对芭蕾舞、礼仪都不太感兴趣，只愿意学钢琴。她要是不想做什么事儿，一百头驮兽都拉不动……您问现在？她在教我怎么谱‘新塔风’的音乐，挺有意思的。哦，还有怎么维修电子设备。她有做工程师的天赋。”\n\n4. 处理方法\n多方验证后，确认系个人销毁行为，对屋主进行批评教育与罚款。不移交至社区管理部门处理。\n\n5. 屋主的证言补充\n“‘好吧，’我说，‘既然你已经决定好了自己的道路，我们就把那些东西烧掉吧。’她花了很长时间来确认我的表情，直到我们彼此都明白我是认真的。她立刻开始欢呼，说要放个大烟花，把她做的那个什么机……无人机，就是会喷火、会喷冰块的玩意儿拿了出来。\n“我跟她一起看着图书室燃烧，门缝里传来明亮的橙色火光。我听到火舌舔舐着木头书架，在烟中劈啪作响。\n“其实我还是有些心疼。虽然屋里那些书并不是什么珍藏品，但搜罗过来也花了不少金票……没办法，这是长年一腔情愿逼迫她后要付出的代价，我总得拿出个态度。\n“嗡的一声——那两个小玩意儿提着书飞了过来。她嘻嘻一笑，说只是我们‘品鉴’的口味不一样，为什么一定要全都毁了？她说，她喜欢那些‘新塔卫二浪潮’的文学，但可没说过要否定那些更遥远的故事。何况那些东西，她早就都背下来了。\n“我说了什么来着……抱歉，光记着那股东西被烧焦的味道了。哦，我说……\n“把这里翻修成工作间吧。有空也给我做台无人机，能点雪茄的那种。”","CN_04","档案资料·二",300,{"_4053":16,"_15":4114,"_4088":4115,"_4090":4116,"_4092":66,"_4093":4117,"_4095":64,"_4096":4112},"chr_0017_yvonne_5","“小工程师访问的第四个行星上住着一群商人。他们给星星编号，然后把编号锁在保险柜里……\n“小工程师访问的第六个行星上住着好多学究……小工程师看到他们厚厚的眼镜，就立刻跑掉了。\n“小工程师跟庞大的工业巨兽告别。他对着山谷喊道——‘和我交个朋友吧，我很孤单！’但是呢，大山给他的只有一遍又一遍的回声……\n“故事的最后，小工程师倒在沙地上……呃，嗯！他嗖的一下从沙子上站起来，向着自己的朋友挥手，长出一双亮晶晶的翅膀，就这样飞向群星！”\n\n“这个故事好像是高……我老家那边的作者写的。只要不是历史书，泰拉传承下来的故事倒是都很有趣！好了，小滑头们，今天就讲到这里，下次再——”\n“伊冯姐姐……”\n“哎哟，脸怎么皱起来啦？”\n“小工程师好可怜……哪里都不是他的家，也没有交到朋友，好寂寞……”\n“而且他最后飞起来，是不是……是不是因为他被天使吃掉了呀？！大人总是说这种谎……”\n伊冯眨眨眼，自口袋中掏出那只用五金工件组装的玩具。在日光照耀下，这外形有些像“塔塔”的小东西闪烁着近似钻石碎屑的光泽。\n“小工程师只是没有找到合适的伙伴，但不代表会寂寞呀！你们看，这就是他给自己做的第一个伙伴。他还给自己做了很多有趣的伙伴，有可以做冰淇淋的、有可以放烟花的……每一个都是好朋友！而且，后来——”\n\n她循着那道光芒抬起头，天边熨着一层碧蓝，云层在缓慢流动。她能想象出在那之上的轨道，帝江号无拘无束漫游的模样。她又低下头，四号谷地的孩子们围着她，脸上露出对故事的期待。舰船的影子、小工程师闪闪发光的翅膀、五亿盏铃铛中的星光，斑斓而平和的世界自她视网膜上流过。\n伊冯感到自在，她讲述故事的语调越来越轻快。\n“后来也不是你们想的那样黑暗啦！小工程师选择离开，是因为交到了新的朋友，受到最闪耀的星星邀请，换了个地方住！把眼泪擦一擦，今天再多讲一个管理员的故事吧！嗯……你们想听管理员击碎了太阳那件事，还是用一颗源石变出了一百万个士兵那个？”\n“太阳……还有一百万个士兵？！管理员太厉害了吧，这些都是真的吗——？”\n“嗯哼，是不是真的呢……一会儿我替你们问问本人！”","CN_05","档案资料·三",{"_4053":16,"_15":4119,"_4088":4120,"_4090":4121,"_4092":68,"_4093":4122,"_4095":64,"_4096":4123},"chr_0017_yvonne_6","【伊冯的工作日志】\n这是我盯着那段超域裂隙数据的第三天。那里面什么都看不到，监测模块全线失效，红外、电磁、振荡响应——统统归零，对面连一声“哔”都懒得还我。\n我甚至试过用手语识别器去“读”那片区域的变化！结果只有一堆报错和一句“数据无法解译”。\n这已经不是监控失败了，这是被超域狠狠羞辱。我们是彻彻底底的瞎子。唯一能确认的事实是，它存在，而且不友好。\n我讨厌看不见的东西！\n…………\n换个思路。如果我主动往里面发信息呢？不再死守输入端口，而是用主动交互取代被动等待。\n今天我尝试了三种不同频段的信号包：一组是标准问候协议，一组是我自己写的脉冲打招呼格式，还有一组是静电噪音（宇宙起源乐章的第一个音符，也许超域会喜欢）。\n结果毫不意外……没反应。好吧，乐观一点，也许有回应，谁知道无线电波传播过去，再返回要多久？如果振动一次要至少1000万年，那就只能让速冻仔去听了。\n明天我试试颜色编码的光波信号。如果那东西能看见，也许它会跟我一样，喜欢闪闪发光的东西！\n光还比声音快呢！\n…………\n第几次失败？我记不清了。信号调试、模型构建、反馈监听，全都失败。连噪声听起来都像是超域的嘲笑——要真是嘲笑就好了，我非要用速冻仔给它的喉咙降降温不可！\n我原本以为只要坚持不懈，总能找到一丝缝隙。但现在我开始怀疑，这是不是一场注定没有出口的探索。\n我们连“观察”的权力都没有，更别提“破解”。\n我推导的模型、设计的装置，跟侵蚀一比就像是小孩子过家家……\n…………\n现在我能做的事情只有坐在转椅上，一圈又一圈地摇晃，等待或许1000万年后才会出现的奇迹。\n干脆换个研究方向如何？造一支无敌舰队，在天空中托起无数座那些古老歌谣中回响的……城市？不可行，但会比破解超域更不可行吗？\n我看向那段超域裂隙的图像，久久地、深深地凝望着它。声音与光都被它吞噬，连我也跌入其中——它碾碎我，用永恒的黑暗包裹着我，让我无处可逃。\n我是为了什么才做这些事来着？保护塔卫二……证明自己……跟父母赌气……不。好像只是在某一天，我觉得书上的超域裂隙很漂亮，于是偷偷跑到防护带后，轻佻地去观察它。它泛着明亮的光晕，那感觉就像直视太阳，在刺痛中迎接无法言喻的恐惧，然后——融化。\n我怕得在深夜中大哭，缩在被子里发抖，第二天早上起来看到自己的眼睛肿得像是桃子，那很丑。我不想再因为它露出那样的丑态，所以我要破解它，就只是这么简单。\n而在终末地，我就能做到。\n我再次拍下发送按钮，迟疑不决、动心怵目，啪的一声全都不见了。黑暗消失，将我还回白昼。","CN_06","档案资料·四",1500,"profileVoice",[4126,4134,4138,4142,4146,4150,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4434,4439,4444,4449,4454,4459,4464,4469,4474,4479,4484,4489,4494,4499,4504,4509,4514,4519,4524],{"_4053":16,"_15":4087,"_4095":37,"_4096":37,"_4127":4128,"_4129":4130,"_4131":39,"_4132":4133},"voId","chr_0017_yvonne_chrbark_squad_01","voiceDesc","管理员，今天咱们去哪里玩？","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4098,"_4095":37,"_4096":37,"_4127":4135,"_4129":4136,"_4131":55,"_4132":4137},"chr_0017_yvonne_chrbark_squad_02","数据同步完毕，我随时可以出发！","行动准备2",{"_4053":16,"_15":4103,"_4095":37,"_4096":37,"_4127":4139,"_4129":4140,"_4131":58,"_4132":4141},"chr_0017_yvonne_chrbark_join_01","终于想起来叫我了？嗯哼，一定发生了什么大事吧。","编入队伍1",{"_4053":16,"_15":4108,"_4095":37,"_4096":37,"_4127":4143,"_4129":4144,"_4131":64,"_4132":4145},"chr_0017_yvonne_chrbark_join_02","来了来了，设备上的问题就全都交给我吧。","编入队伍2",{"_4053":16,"_15":4114,"_4095":37,"_4096":37,"_4127":4147,"_4129":4148,"_4131":66,"_4132":4149},"chr_0017_yvonne_chrbark_weap_01","这把铳手感不错！嗯……设计上还有拓展空间，我会把它改成我的专属款！","更换武器",{"_4053":16,"_15":4119,"_4095":37,"_4096":37,"_4127":4151,"_4129":4152,"_4131":68,"_4132":4153},"chr_0017_yvonne_chrbark_gear_01","我能给装备改涂装吗？我觉得它的颜色跟我的头发不搭。","更换装备",{"_4053":16,"_15":4155,"_4095":37,"_4096":37,"_4127":4156,"_4129":4157,"_4131":70,"_4132":4158},"chr_0017_yvonne_7","chr_0017_yvonne_chrup_skill_01","这也太简单了吧，给我点更难的挑战！","激活天赋阵列",{"_4053":16,"_15":4160,"_4095":37,"_4096":37,"_4127":4161,"_4129":4162,"_4131":88,"_4132":4163},"chr_0017_yvonne_8","chr_0017_yvonne_chrup_level_01","我是快进着看的，但效果应该没差。","观看作战记录",{"_4053":16,"_15":4165,"_4095":55,"_4096":39,"_4127":4166,"_4129":4167,"_4131":90,"_4132":4168},"chr_0017_yvonne_9","chr_0017_yvonne_chrup_promt01_01","给我升职？眼光不错嘛，管理员！","精英化晋升1",{"_4053":16,"_15":4170,"_4095":55,"_4096":55,"_4127":4171,"_4129":4172,"_4131":94,"_4132":4173},"chr_0017_yvonne_10","chr_0017_yvonne_chrup_promt02_01","这次晋升过后，我是不是可以换个更大点的实验室了？","精英化晋升2",{"_4053":16,"_15":4175,"_4095":55,"_4096":58,"_4127":4176,"_4129":4177,"_4131":101,"_4132":4178},"chr_0017_yvonne_11","chr_0017_yvonne_chrup_promt03_01","亲临战场和光看资料完全是两回事……在开拓区逛一圈能平安回来，对我来说已经是个巨大的进步了，不是吗？","精英化晋升3",{"_4053":16,"_15":4180,"_4095":55,"_4096":64,"_4127":4181,"_4129":4182,"_4131":96,"_4132":4183},"chr_0017_yvonne_12","chr_0017_yvonne_chrup_promt04_01","助理？不需要不需要！我的“小嘀嗒”完全能搞定！整理数据、收拾实验室，对它来说都是小菜一碟！而且……它还不会抱怨我的作息。","精英化晋升4",{"_4053":16,"_15":4185,"_4095":37,"_4096":37,"_4127":4186,"_4129":4187,"_4131":528,"_4132":4188},"chr_0017_yvonne_13","chr_0017_yvonne_introduce_01","嗨，又见面了，还是叫我伊冯就好。这可是我最近第一次出门，管理员，希望我们能合作愉快——","干员报到",{"_4053":16,"_15":4190,"_4095":37,"_4096":37,"_4127":4191,"_4129":4192,"_4131":567,"_4132":4193},"chr_0017_yvonne_14","chr_0017_yvonne_mono_switch_01","速冻仔，别调皮！管理员要带我们出去呢！","待命1",{"_4053":16,"_15":4195,"_4095":37,"_4096":37,"_4127":4196,"_4129":4197,"_4131":98,"_4132":4198},"chr_0017_yvonne_15","chr_0017_yvonne_mono_switch_02","管理员，在这儿呢！我要带的东西有点多……","待命2",{"_4053":16,"_15":4200,"_4095":37,"_4096":37,"_4127":4201,"_4129":4202,"_4131":645,"_4132":4203},"chr_0017_yvonne_16","chr_0017_yvonne_sim_assign_work_01","好啦好啦，这里我熟得很，放心吧！","进驻设施",{"_4053":16,"_15":4205,"_4095":37,"_4096":37,"_4127":4206,"_4129":4207,"_4131":685,"_4132":4208},"chr_0017_yvonne_17","chr_0017_yvonne_sim_hello_lower_01","管理员，装备测试间今天我先预定了哦！","打招呼1",{"_4053":16,"_15":4210,"_4095":64,"_4096":4112,"_4127":4211,"_4129":4212,"_4131":724,"_4132":4213},"chr_0017_yvonne_18","chr_0017_yvonne_sim_hello_max_01","最新一期的《MARTHE月刊》到了，要一起看吗？","打招呼2",{"_4053":16,"_15":4215,"_4095":37,"_4096":37,"_4127":4216,"_4129":4217,"_4131":764,"_4132":4218},"chr_0017_yvonne_19","chr_0017_yvonne_sim_talk_lv01_01","啊啊……无论看几次都觉得，集成工业系统实——在是太完美了！在协议核心的指挥下，生产不再只是冰冷的重复，而像……一套生命系统！可以循环和呼吸！真是天才设计！管理员，能让我玩一下吗？","帝江号闲聊1",{"_4053":16,"_15":4220,"_4095":64,"_4096":4112,"_4127":4221,"_4129":4222,"_4131":803,"_4132":4223},"chr_0017_yvonne_20","chr_0017_yvonne_sim_talk_lv02_01","管理员，虽然我很喜欢你的造型，但总穿这一身，我都要看腻了！有没有想过换一身更亮眼的衣服？我带你去买！保证搭配得更有型！","帝江号闲聊2",{"_4053":16,"_15":4225,"_4095":64,"_4096":4112,"_4127":4226,"_4129":4227,"_4131":874,"_4132":4228},"chr_0017_yvonne_21","chr_0017_yvonne_sim_talk_lv02_02","佩丽卡不让我带小暴鸰上舰，说太危险。但我又离不开它们，只能妥协喽，上舰前我把爆破模块都拆掉啦！","帝江号闲聊3",{"_4053":16,"_15":4230,"_4095":64,"_4096":4123,"_4127":4231,"_4129":4232,"_4131":913,"_4132":4233},"chr_0017_yvonne_22","chr_0017_yvonne_sim_talk_max_01","我打算过阵子去菈梵朵玛度个假，久违的沙滩和海风……管理员，要不要一起？还可以顺便去考察一下那里的海岸工程，听说采用了新研发的防侵蚀涂层。","帝江号闲聊4",{"_4053":16,"_15":4235,"_4095":64,"_4096":4123,"_4127":4236,"_4129":4237,"_4131":953,"_4132":4238},"chr_0017_yvonne_23","chr_0017_yvonne_sim_talk_max_02","管理员，我还没有跟你合过影呢！一起来张自拍吧？我会把它放在“伊冯的年度时刻”集锦里。不要质疑我的拍照技术！如果拍得不好看……那就怪帝江号的灯光咯！","帝江号闲聊5",{"_4053":16,"_15":4240,"_4095":64,"_4096":4123,"_4127":4241,"_4129":4242,"_4131":992,"_4132":4243},"chr_0017_yvonne_24","chr_0017_yvonne_sim_talk_max_03","管理员，咱们喜欢的音乐还挺像的嘛！下次新唱片到了，可以来我的实验室，我们一起听。好音乐就是要和懂的人一起分享！","帝江号闲聊6",{"_4053":16,"_15":4245,"_4095":37,"_4096":37,"_4127":4246,"_4129":4247,"_4131":62,"_4132":4248},"chr_0017_yvonne_25","chr_0017_yvonne_sim_gift_give_01","给你准备了点小东西，记得回去后再打开。嘿嘿，我咨询过“专业人士”的意见，你肯定会喜欢！","赠送礼物",{"_4053":16,"_15":4250,"_4095":37,"_4096":37,"_4127":4251,"_4129":4252,"_4131":1070,"_4132":4253},"chr_0017_yvonne_26","chr_0017_yvonne_sim_gift_recv_01","谢谢啦！放心，你送的东西，就算是有点丑我也会当宝贝收着！","接收礼物",{"_4053":16,"_15":4255,"_4095":37,"_4096":37,"_4127":4256,"_4129":4257,"_4131":1110,"_4132":4258},"chr_0017_yvonne_27","chr_0017_yvonne_mono_self_line01","我的设计，从来不只是为了让机器的性能更强，而是为了让人在用它的时候不用太紧张，不费脑子，最好还能笑一笑。毕竟工具是拿来用的，不是让人和它较劲的。","信赖对话1",{"_4053":16,"_15":4260,"_4095":64,"_4096":4112,"_4127":4261,"_4129":4262,"_4131":1149,"_4132":4263},"chr_0017_yvonne_28","chr_0017_yvonne_mono_self_line02","管理员，你的源石技艺能借给我吗？如果能精准控制源石回路，设计上就有了超高的灵活性。比如……我一直想给速冻仔再加一个加热单元，这样它就完美了！嗯？这样就不算是“速冻仔”了？","信赖对话2",{"_4053":16,"_15":4265,"_4095":64,"_4096":4112,"_4127":4266,"_4129":4267,"_4131":1189,"_4132":4268},"chr_0017_yvonne_29","chr_0017_yvonne_mono_self_line03","我第一次知道管理员的时候，才三岁，是从一本科普读物上看来的。书上说你是个大人物，要操心好多事。但真的见到了本人，没想到……管理员其实还挺可爱。不过，你是真不知道有些盗版书把过去的你画成了什么样……不，你还是别知道了。","信赖对话3",{"_4053":16,"_15":4270,"_4095":64,"_4096":4123,"_4127":4271,"_4129":4272,"_4131":56,"_4132":4273},"chr_0017_yvonne_30","chr_0017_yvonne_mono_self_line04","我刚接手宝贝小车项目的时候，设备原型大得离谱，整个装配车间都塞不下了！工团一开始就想做成那种重型器械，用来大范围清除侵蚀。但如果不试试轻型化，普通人面对突发的侵蚀灾害怎么办？等移动平台轰隆隆开过来？为了这事，我在实验园区连轴转了好几个月……结果你看，后来发生的事，证明我当时的决定——超级明智！","信赖对话4",{"_4053":16,"_15":4275,"_4095":64,"_4096":4123,"_4127":4276,"_4129":4277,"_4131":1267,"_4132":4278},"chr_0017_yvonne_31","chr_0017_yvonne_mono_self_line05","我其实一直都知道，我喜欢的那些东西——美妙的音乐、精彩的演出、漂亮的衣服，还有塔卫二的日出日落……全都很脆弱。正因为这样，我才加入了终末地。我想做点什么，让这些脆弱但美好的东西，能存续下去。我还没有享受够呢，所以这个世界可不许完蛋！","信赖对话5",{"_4053":16,"_15":4280,"_4095":37,"_4096":37,"_4127":4281,"_4129":4282,"_4131":1306,"_4132":4283},"chr_0017_yvonne_32","chr_0017_yvonne_mono_chat_line01","如果是生活，我当然首选环塔商会的城市；但工作嘛，那里实在不适合我。你能想象吗？他们一天要打六次卡！","交谈1",{"_4053":16,"_15":4285,"_4095":37,"_4096":37,"_4127":4286,"_4129":4287,"_4131":118,"_4132":4288},"chr_0017_yvonne_33","chr_0017_yvonne_mono_chat_line02","这件衣服是巫术时刻出品的，我超喜欢他们的设计风格。他们会从一切地方找点子，甚至会模仿天使外壳的纹理。危险的东西反而更有魅力，不是吗，管理员？","交谈2",{"_4053":16,"_15":4290,"_4095":37,"_4096":37,"_4127":4291,"_4129":4292,"_4131":1384,"_4132":4293},"chr_0017_yvonne_34","chr_0017_yvonne_mono_chat_line03","“伊冯”是个高卢名字。我爸说，我们家的血统大有来头，大家都觉得那是很值得骄傲的事。可对我来说嘛，没啥特别的感觉。泰拉离我们都已经够遥远了，更别提那上面一个早就消失的帝国了。真不懂血统这种概念，到底哪里重要了，那个什么科什么一世的，有那么了不起吗？","交谈3",{"_4053":16,"_15":4295,"_4095":37,"_4096":37,"_4127":4296,"_4129":4297,"_4131":1424,"_4132":4298},"chr_0017_yvonne_35","chr_0017_yvonne_mono_chat_line04","我只是顺手给实验室的热能炉改了个接口，然后这个接口恰好可以煮泡面。这不是偷懒，这是技术验证！行吧，我分给你一份……你不会告诉佩丽卡的，对吧？","交谈4",{"_4053":16,"_15":4300,"_4095":37,"_4096":37,"_4127":4301,"_4129":4302,"_4131":1463,"_4132":4303},"chr_0017_yvonne_36","chr_0017_yvonne_mono_chat_line05","其实我在商会、宏科院和工团都实习过，但当时终末地的人事部给我开了无法拒绝的条件：获得所有超域相关资料的阅读权限。其中还着重标注了一句：权限等级和管理员相同。","交谈5",{"_4053":16,"_15":4305,"_4095":37,"_4096":37,"_4127":4306,"_4129":4307,"_4131":157,"_4132":4308},"chr_0017_yvonne_37","chr_0017_yvonne_mono_about_line01","我们对超域的了解，其实少得可怜。里面可能一片漆黑，也可能是……彻底的混乱。我们现在能看到的，就只有那些侵蚀现象。它们的颜色很诡异，像是颠覆了光谱的原理。但说真的，看久了，我甚至觉得它们……有点迷人？","话题：超域",{"_4053":16,"_15":4310,"_4095":37,"_4096":37,"_4127":4311,"_4129":4312,"_4131":1541,"_4132":4313},"chr_0017_yvonne_38","chr_0017_yvonne_mono_about_line02","我每年都会去环塔商会的城市好几趟，去合金萝卜城采购材料和设备，或是去新蓝卡坞的电影节把电影看个够。但我最喜欢的城市是耶尔什，想不到吧？我喜欢那里的雪，那里的天空，那里的万籁俱寂。","话题：环塔商会的城市",{"_4053":16,"_15":4315,"_4095":37,"_4096":37,"_4127":4316,"_4129":4317,"_4131":41,"_4132":4318},"chr_0017_yvonne_39","chr_0017_yvonne_mono_about_line03","“泰拉复古音乐”已经是我爷爷奶奶还年轻的时候听的啦。环塔商会现在的流行乐是“新塔风”。最近那首《立体声》，我就超级喜欢！我们生在塔卫二，长在塔卫二，当然要搞点属于塔卫二的新东西。","话题：流行文化",{"_4053":16,"_15":4320,"_4095":37,"_4096":37,"_4127":4321,"_4129":4322,"_4131":44,"_4132":4323},"chr_0017_yvonne_40","chr_0017_yvonne_mono_about_line04","我爸妈都挺忙的，小时候基本没人陪我。他们送了我一只羽兽，当作我的玩伴。它特别吵，脾气非常暴躁，把我的房间搞得乱糟糟的……但我真的很喜欢它。也许你已经猜到了，它就是“小暴鸰”的原型。小暴鸰虽然安静多了，但还是继承了它的坏脾气。","话题：童年",{"_4053":16,"_15":4325,"_4095":37,"_4096":37,"_4127":4326,"_4129":4327,"_4131":47,"_4132":4328},"chr_0017_yvonne_41","chr_0017_yvonne_mono_about_line05","三年前刚来四号谷地的时候，我压根没打算久留。但克劳老师一把超域试验场的裂隙数据甩出来，我就上钩了！后来，我们俩整天因为研究路线吵架，他吵不过我，干脆把我塞给了安德烈。结果你猜怎么着？有了终末地的技术支持，我的研究简直一发不可收拾！这三年，我的论文大爆发——四号谷地，还真是我的福地。","话题：四号谷地",{"_4053":16,"_15":4330,"_4095":37,"_4096":37,"_4127":4331,"_4129":4332,"_4131":50,"_4132":4333},"chr_0017_yvonne_42","chr_0017_yvonne_explore_point_common_01","那个那个！带回去研究研究。","发现资源1",{"_4053":16,"_15":4335,"_4095":37,"_4096":37,"_4127":4336,"_4129":4337,"_4131":233,"_4132":4338},"chr_0017_yvonne_43","chr_0017_yvonne_explore_point_valub_01","偷偷告诉你，那儿都是好东西！","发现资源2",{"_4053":16,"_15":4340,"_4095":37,"_4096":37,"_4127":4341,"_4129":4342,"_4131":1804,"_4132":4343},"chr_0017_yvonne_44","chr_0017_yvonne_explore_find_locked_01","那附近我也没去过。走，咱们去瞧瞧！","发现未探索区域",{"_4053":16,"_15":4345,"_4095":37,"_4096":37,"_4127":4346,"_4129":4347,"_4131":1844,"_4132":4348},"chr_0017_yvonne_45","chr_0017_yvonne_explore_find_danger_01","我的小暴鸰有点紧张，那家伙应该很厉害！","发现强敌",{"_4053":16,"_15":4350,"_4095":37,"_4096":37,"_4127":4351,"_4129":4352,"_4131":271,"_4132":4353},"chr_0017_yvonne_46","chr_0017_yvonne_interact_mine_valub_01","应该给武器加装一个采矿专用模块的。","采集矿物1",{"_4053":16,"_15":4355,"_4095":37,"_4096":37,"_4127":4356,"_4129":4357,"_4131":1922,"_4132":4358},"chr_0017_yvonne_47","chr_0017_yvonne_interact_mine_valub_echo2_01","来帮忙啦！爆破什么的我很擅长哦！","采集矿物2",{"_4053":16,"_15":4360,"_4095":37,"_4096":37,"_4127":4361,"_4129":4362,"_4131":72,"_4132":4363},"chr_0017_yvonne_48","chr_0017_yvonne_interact_treasure_valub_01","哇，里面的东西好好看啊。","打开储藏箱",{"_4053":16,"_15":4365,"_4095":37,"_4096":37,"_4127":4366,"_4129":4367,"_4131":60,"_4132":4368},"chr_0017_yvonne_49","chr_0017_yvonne_interact_etherium_01","我一直想要一款像这样流光变幻的指甲油。","获得醚质",{"_4053":16,"_15":4370,"_4095":37,"_4096":37,"_4127":4371,"_4129":4372,"_4131":76,"_4132":4373},"chr_0017_yvonne_50","chr_0017_yvonne_interact_blight_break_01","怎么样？消除得干干净净！","消除侵蚀",{"_4053":16,"_15":4375,"_4095":37,"_4096":37,"_4127":4376,"_4129":4377,"_4131":78,"_4132":4378},"chr_0017_yvonne_51","chr_0017_yvonne_interact_rest_01","终于能歇一歇了，发型都乱了，得赶紧整理下。","休整",{"_4053":16,"_15":4380,"_4095":37,"_4096":37,"_4127":4381,"_4129":4382,"_4131":80,"_4132":4383},"chr_0017_yvonne_52","chr_0017_yvonne_combat_suppuse_using_01","别紧张，试试这个。","使用战术物品1",{"_4053":16,"_15":4385,"_4095":37,"_4096":37,"_4127":4386,"_4129":4387,"_4131":82,"_4132":4388},"chr_0017_yvonne_53","chr_0017_yvonne_combat_suppuse_getheal_01","啊，现在舒服多了！","使用战术物品2",{"_4053":16,"_15":4390,"_4095":37,"_4096":37,"_4127":4391,"_4129":4392,"_4131":84,"_4132":4393},"chr_0017_yvonne_54","chr_0017_yvonne_combat_remind_danger_01","我掩护你，快闪开！","危险提醒",{"_4053":16,"_15":4395,"_4095":37,"_4096":37,"_4127":4396,"_4129":4397,"_4131":86,"_4132":4398},"chr_0017_yvonne_55","chr_0017_yvonne_combat_hurt_lowhp_01","呜，好疼！好像受伤了……","负伤",{"_4053":16,"_15":4400,"_4095":37,"_4096":37,"_4127":4401,"_4129":4402,"_4131":385,"_4132":4403},"chr_0017_yvonne_56","chr_0017_yvonne_combat_dead_01","讨厌！弹药耗尽了……","力竭",{"_4053":16,"_15":4405,"_4095":37,"_4096":37,"_4127":4406,"_4129":4407,"_4131":2308,"_4132":4408},"chr_0017_yvonne_57","chr_0017_yvonne_combat_remind_praise_01","刚才那招好帅！","小队激励1",{"_4053":16,"_15":4410,"_4095":37,"_4096":37,"_4127":4411,"_4129":4412,"_4131":2347,"_4132":4413},"chr_0017_yvonne_58","chr_0017_yvonne_combat_remind_praise_02","大家都好厉害！","小队激励2",{"_4053":16,"_15":4415,"_4095":37,"_4096":37,"_4127":4416,"_4129":4417,"_4131":423,"_4132":4418},"chr_0017_yvonne_59","chr_0017_yvonne_combat_remind_praise_echo2_01","那当然，也不看看我是谁！","回应激励1",{"_4053":16,"_15":4420,"_4095":37,"_4096":37,"_4127":4421,"_4129":4422,"_4131":74,"_4132":4423},"chr_0017_yvonne_60","chr_0017_yvonne_combat_remind_praise_echo2_02","咱们配合得不错。","回应激励2",{"_4053":16,"_15":4425,"_4095":37,"_4096":37,"_4127":4426,"_4129":4427,"_4131":2495,"_4132":4428},"chr_0017_yvonne_61","chr_0017_yvonne_combat_intobattle_01","所有装备充能完毕。","作战开始1",{"_4053":16,"_15":4430,"_4095":37,"_4096":37,"_4127":4431,"_4129":4432,"_4131":2534,"_4132":4433},"chr_0017_yvonne_62","chr_0017_yvonne_combat_intobattle_echo2_01","火力支援就交给我吧！","作战开始2",{"_4053":16,"_15":4435,"_4095":37,"_4096":37,"_4127":4436,"_4129":4437,"_4131":462,"_4132":4438},"chr_0017_yvonne_63","chr_0017_yvonne_combat_outbattle_nor_01","赢啦！我要拍张照纪念一下。","作战胜利1",{"_4053":16,"_15":4440,"_