:9034,"_9037":9038,"_9041":9042,"_9046":9047,"_9051":9052,"_9055":9056,"_9061":9062,"_9065":9066,"_9069":9070,"_9074":9075,"_9078":9079,"_9082":9083,"_9086":9087,"_9092":9093,"_9097":9098,"_9102":9103,"_9107":9108,"_9112":9113,"_9117":9118,"_9122":9123,"_9127":9128,"_9132":9133,"_9137":9138,"_9142":9143,"_9147":9148,"_9152":9153,"_9157":9158},"adv.electricFence",{"_4625":8648,"_8649":4060,"_15":8646,"_8650":4060,"_19":8651,"_8652":8218},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4625":8655,"_8649":8656,"_15":8653,"_8650":4060,"_19":8657,"_8652":8271},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4625":8659,"_8649":8660,"_15":8335,"_8650":8661,"_19":8662,"_8652":8400},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4625":8665,"_8649":4060,"_15":8663,"_8650":4060,"_19":8666,"_8652":8218},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4625":8669,"_8649":8670,"_15":8667,"_8650":4060,"_19":8671,"_8652":8218},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4625":8674,"_8649":4060,"_15":8672,"_8650":4060,"_19":8675,"_8652":8218},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4625":8678,"_8649":8679,"_15":8676,"_8650":4060,"_19":8680,"_8652":8312},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4625":8683,"_8649":4060,"_15":8681,"_8650":4060,"_19":8684,"_8652":8218},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4625":8687,"_8649":8688,"_15":8685,"_8650":4060,"_19":8689,"_8652":8218},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4625":8692,"_8649":4060,"_15":8690,"_8650":4060,"_19":8693,"_8652":4060},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4625":8696,"_8649":8697,"_15":8694,"_8650":4060,"_19":8698,"_8652":8271},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4625":8700,"_8649":8701,"_15":8150,"_8650":8702,"_19":8703,"_8652":8400},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4625":8706,"_8649":4060,"_15":8704,"_8650":4060,"_19":8707,"_8652":8218},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4625":8710,"_8649":8711,"_15":8708,"_8650":4060,"_19":8712,"_8652":8218},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4625":8715,"_8649":8716,"_15":8713,"_8650":4060,"_19":8717,"_8652":8218},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4625":8720,"_8649":4060,"_15":8718,"_8650":4060,"_19":8721,"_8652":8245},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4625":8724,"_8649":8725,"_15":8722,"_8650":4060,"_19":8726,"_8652":8218},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4625":8729,"_8649":4060,"_15":8727,"_8650":4060,"_19":8730,"_8652":8245},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4625":8732,"_8649":8733,"_15":8233,"_8650":8734,"_19":8735,"_8652":8312},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4625":8738,"_8649":8733,"_15":8736,"_8650":4060,"_19":8739,"_8652":8312},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4625":8742,"_8649":8743,"_15":8740,"_8650":8744,"_19":8745,"_8652":8245},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4625":8748,"_8649":4060,"_15":8746,"_8650":4060,"_19":8749,"_8652":8245},"持续时间内，受影响的目标暂停行动。","定身",{"_4625":8751,"_8649":8752,"_15":8239,"_8650":8753,"_19":8754,"_8652":8424},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4625":8757,"_8649":8752,"_15":8755,"_8650":4060,"_19":8758,"_8652":8424},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4625":8761,"_8649":4060,"_15":8759,"_8650":8762,"_19":8763,"_8652":4060},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4625":8765,"_8649":8766,"_15":8257,"_8650":8767,"_19":8768,"_8652":8374},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4625":8771,"_8649":8766,"_15":8769,"_8650":4060,"_19":8772,"_8652":8374},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4625":8775,"_8649":8776,"_15":8773,"_8650":4060,"_19":8777,"_8652":8218},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4625":8779,"_8649":8780,"_15":8264,"_8650":8781,"_19":8782,"_8652":8400},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4625":8785,"_8649":8786,"_15":8783,"_8650":8787,"_19":8788,"_8652":8245},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4625":8791,"_8649":8792,"_15":8789,"_8650":4060,"_19":8793,"_8652":8245},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4625":8795,"_8649":8796,"_15":8288,"_8650":8797,"_19":8798,"_8652":8271},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4625":8801,"_8649":4060,"_15":8799,"_8650":8802,"_19":8803,"_8652":8271},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4625":8806,"_8649":8807,"_15":8804,"_8650":4060,"_19":8808,"_8652":8218},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4625":8811,"_8649":8812,"_15":8809,"_8650":4060,"_19":8813,"_8652":8218},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4625":8816,"_8649":8817,"_15":8814,"_8650":4060,"_19":8818,"_8652":8271},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4625":8820,"_8649":8656,"_15":8295,"_8650":8821,"_19":8822,"_8652":8271},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4625":8825,"_8649":4060,"_15":8823,"_8650":8826,"_19":8827,"_8652":8245},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4625":8830,"_8649":8831,"_15":8828,"_8650":4060,"_19":8832,"_8652":8218},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4625":8835,"_8649":4060,"_15":8833,"_8650":4060,"_19":8836,"_8652":4060},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4625":8839,"_8649":8840,"_15":8837,"_8650":8841,"_19":8842,"_8652":8245},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4625":8845,"_8649":8846,"_15":8843,"_8650":4060,"_19":8847,"_8652":8218},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4625":8850,"_8649":4060,"_15":8848,"_8650":8851,"_19":8852,"_8652":8312},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4625":8854,"_8649":8855,"_15":8325,"_8650":8856,"_19":8857,"_8652":8312},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4625":8860,"_8649":8861,"_15":8858,"_8650":4060,"_19":8862,"_8652":8218},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4625":8738,"_8649":8855,"_15":8863,"_8650":4060,"_19":8865,"_8652":8312},"干员受到灼热附着","sys.tacticalItem",{"_4625":8868,"_8649":4060,"_15":8866,"_8650":4060,"_19":8869,"_8652":8218},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4625":8872,"_8649":8873,"_15":8870,"_8650":4060,"_19":8874,"_8652":8312},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4625":8757,"_8649":8877,"_15":8875,"_8650":4060,"_19":8878,"_8652":8424},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4625":8881,"_8649":8882,"_15":8879,"_8650":8883,"_19":8884,"_8652":8245},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4625":8887,"_8649":4060,"_15":8885,"_8650":4060,"_19":8888,"_8652":8245},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4625":8891,"_8649":8892,"_15":8889,"_8650":4060,"_19":8893,"_8652":8400},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4625":8896,"_8649":8897,"_15":8894,"_8650":4060,"_19":8898,"_8652":8424},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4625":8901,"_8649":8902,"_15":8899,"_8650":4060,"_19":8903,"_8652":8245},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4625":8905,"_8649":8906,"_15":8342,"_8650":8797,"_19":8907,"_8652":8271},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4625":8655,"_8649":8906,"_15":8908,"_8650":4060,"_19":8910,"_8652":8271},"干员受到冻结","ba.naturalvul",{"_4625":8913,"_8649":8914,"_15":8911,"_8650":4060,"_19":8915,"_8652":8374},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4625":8700,"_8649":8917,"_15":8362,"_8650":8918,"_19":8919,"_8652":8400},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4625":8922,"_8649":8923,"_15":8920,"_8650":4060,"_19":8924,"_8652":8218},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4625":8927,"_8649":8928,"_15":8925,"_8650":4060,"_19":8929,"_8652":8218},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4625":8932,"_8649":8933,"_15":8930,"_8650":4060,"_19":8934,"_8652":8218},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4625":8937,"_8649":4060,"_15":8935,"_8650":4060,"_19":8938,"_8652":8218},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4625":8941,"_8649":4060,"_15":8939,"_8650":8942,"_19":8943,"_8652":4060},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4625":8946,"_8649":8947,"_15":8944,"_8650":8948,"_19":8949,"_8652":8245},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4625":8951,"_8649":4060,"_15":8162,"_8650":8952,"_19":8953,"_8652":8374},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4625":8955,"_8649":8956,"_15":8201,"_8650":8957,"_19":8958,"_8652":8400},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4625":8961,"_8649":8962,"_15":8959,"_8650":4060,"_19":8963,"_8652":8218},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4625":8966,"_8649":8967,"_15":8964,"_8650":4060,"_19":8968,"_8652":8374},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4625":8971,"_8649":8972,"_15":8969,"_8650":4060,"_19":8973,"_8652":8218},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4625":8975,"_8649":8976,"_15":8388,"_8650":8977,"_19":8978,"_8652":8374},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4625":8771,"_8649":8976,"_15":8979,"_8650":4060,"_19":8981,"_8652":8374},"干员受到自然附着","ba.originium",{"_4625":8984,"_8649":4060,"_15":8982,"_8650":4060,"_19":8985,"_8652":8245},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4625":8988,"_8649":4060,"_15":8986,"_8650":4060,"_19":8989,"_8652":8400},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4625":8992,"_8649":8993,"_15":8990,"_8650":4060,"_19":8994,"_8652":8400},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4625":8997,"_8649":4060,"_15":8995,"_8650":8998,"_19":8999,"_8652":8408},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4625":9002,"_8649":4060,"_15":9000,"_8650":4060,"_19":9003,"_8652":8218},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4625":9006,"_8649":4060,"_15":9004,"_8650":9007,"_19":9008,"_8652":8424},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4625":9011,"_8649":9012,"_15":9009,"_8650":4060,"_19":9013,"_8652":8218},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4625":9015,"_8649":8877,"_15":8428,"_8650":9016,"_19":9017,"_8652":8424},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4625":9020,"_8649":9021,"_15":9018,"_8650":4060,"_19":9022,"_8652":8424},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4625":9025,"_8649":4060,"_15":9023,"_8650":9026,"_19":9027,"_8652":8245},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4625":9030,"_8649":4060,"_15":9028,"_8650":9031,"_19":9032,"_8652":4060},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4625":9035,"_8649":4060,"_15":9033,"_8650":4060,"_19":9036,"_8652":8218},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4625":9039,"_8649":4060,"_15":9037,"_8650":4060,"_19":9040,"_8652":8245},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4625":9043,"_8649":9044,"_15":9041,"_8650":4060,"_19":9045,"_8652":8218},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4625":9048,"_8649":4060,"_15":9046,"_8650":9049,"_19":9050,"_8652":8245},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4625":9053,"_8649":4060,"_15":9051,"_8650":4060,"_19":9054,"_8652":8218},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4625":9057,"_8649":9058,"_15":9055,"_8650":9059,"_19":9060,"_8652":8245},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4625":9063,"_8649":4060,"_15":9061,"_8650":4060,"_19":9064,"_8652":8245},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4625":9067,"_8649":4060,"_15":9065,"_8650":4060,"_19":9068,"_8652":8245},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4625":9071,"_8649":9072,"_15":9069,"_8650":4060,"_19":9073,"_8652":8218},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4625":9076,"_8649":4060,"_15":9074,"_8650":4060,"_19":9077,"_8652":8245},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4625":9080,"_8649":4060,"_15":9078,"_8650":4060,"_19":9081,"_8652":8245},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4625":9084,"_8649":4060,"_15":9082,"_8650":4060,"_19":9085,"_8652":8245},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4625":9088,"_8649":9089,"_15":9086,"_8650":9090,"_19":9091,"_8652":8245},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4625":9094,"_8649":9095,"_15":9092,"_8650":4060,"_19":9096,"_8652":8218},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4625":9099,"_8649":9100,"_15":9097,"_8650":4060,"_19":9101,"_8652":8218},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4625":9104,"_8649":9105,"_15":9102,"_8650":4060,"_19":9106,"_8652":8218},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4625":9109,"_8649":9110,"_15":9107,"_8650":4060,"_19":9111,"_8652":8218},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4625":9114,"_8649":9115,"_15":9112,"_8650":4060,"_19":9116,"_8652":8218},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4625":9119,"_8649":9120,"_15":9117,"_8650":4060,"_19":9121,"_8652":8218},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4625":9124,"_8649":9125,"_15":9122,"_8650":4060,"_19":9126,"_8652":8218},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4625":9129,"_8649":9130,"_15":9127,"_8650":4060,"_19":9131,"_8652":8218},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4625":9134,"_8649":9135,"_15":9132,"_8650":4060,"_19":9136,"_8652":8218},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4625":9139,"_8649":9140,"_15":9137,"_8650":4060,"_19":9141,"_8652":8218},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4625":9144,"_8649":9145,"_15":9142,"_8650":4060,"_19":9146,"_8652":8218},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4625":9149,"_8649":9150,"_15":9147,"_8650":4060,"_19":9151,"_8652":8218},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4625":9154,"_8649":9155,"_15":9152,"_8650":4060,"_19":9156,"_8652":8218},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4625":9159,"_8649":9160,"_15":9157,"_8650":4060,"_19":9161,"_8652":8218},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7855":9164,"_7381":9173,"_7504":9175,"_6139":9177,"_6142":9179,"_7508":9181,"_7510":9183,"_7155":9185,"_7514":9187,"_7517":9188,"_6150":9190,"_7522":9192,"_7525":9193,"_7528":9194,"_7530":9196,"_6620":9197,"_7535":9198,"_7538":9199,"_7542":9201,"_7545":9202,"_7165":9203,"_7552":9204,"