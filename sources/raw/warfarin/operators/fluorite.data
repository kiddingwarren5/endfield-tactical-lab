0,7490,7491],"qu.numup",{"_15":7907,"_7435":7909,"_7438":7910},[7437,7437,7437],[7911,7911,7911],"<color=#c7fe02>","rac.tec",{"_15":7912,"_7435":7914,"_7438":7915},[7437,7437,7437],[7916,7916,7916],"<color=#FFCC00>","scene_grade.down",{"_15":7917,"_7435":7919,"_7438":7920},[7437,7437,7437],[7921,7921,7921],"<color=#D12E42>","set.key",{"_15":7922,"_7435":7924,"_7438":7925},[7437,7437,7437],[7926,7926,7926],"<color=#A7A7A7>","tech.get",{"_15":7927,"_7435":7929,"_7438":7930},[7437,7437,7437],[7931,7931,7931],"<color=#1e1e1e>","tips.key",{"_15":7932,"_7435":7934,"_7438":7935},[7437,7437,7437],[7936,7937,7936],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":7938,"_7435":7940,"_7438":7941},[7437,7437,7437],[7725,7726,7727],"toast_focal.key",{"_15":7942,"_7435":7944,"_7438":7945},[7437,7437,7437],[7937,7937,7937],"weapon.stress",{"_15":7946,"_7435":7948,"_7438":7949},[7437,7437,7437],[7950,7950,7950],"<color=#fe5a00>","weekraid.key",{"_15":7951,"_7435":7953,"_7438":7954},[7594,7594,7594],[7955,7955,7956],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_7959":7960,"_7966":7967,"_7648":7971,"_7976":7977,"_7980":7981,"_7985":7986,"_7989":7990,"_7994":7995,"_7998":7999,"_8003":8004,"_8007":8008,"_7463":8012,"_8017":8018,"_8021":8022,"_8026":8027,"_8031":8032,"_8035":8036,"_8040":8041,"_7546":8044,"_8049":8050,"_8053":8054,"_8059":8060,"_7552":8063,"_8068":8069,"_8072":8073,"_7570":8077,"_8082":8083,"_8086":8087,"_7577":8091,"_8096":8097,"_8102":8103,"_7601":8107,"_8112":8113,"_8117":8118,"_8122":8123,"_8127":8128,"_7608":8132,"_8136":8137,"_8141":8142,"_8146":8147,"_8150":8151,"_8156":8157,"_8161":8162,"_7638":8166,"_8171":8172,"_8176":8177,"_8179":8180,"_8183":8184,"_8188":8189,"_8192":8193,"_8198":8199,"_8202":8203,"_8207":8208,"_8212":8213,"_7655":8217,"_8221":8222,"_8224":8225,"_7675":8229,"_8233":8234,"_8238":8239,"_8243":8244,"_8248":8249,"_8252":8253,"_8257":8258,"_7475":8263,"_7514":8267,"_8272":8273,"_8277":8278,"_8282":8283,"_7701":8287,"_8292":8293,"_8295":8296,"_8299":8300,"_8303":8304,"_8308":8309,"_8313":8314,"_8317":8318,"_8322":8323,"_7741":8327,"_8331":8332,"_8336":8337,"_8341":8342,"_8346":8347,"_8350":8351,"_8354":8355,"_8359":8360,"_8364":8365,"_8368":8369,"_8374":8375,"_8378":8379,"_8382":8383,"_8387":8388,"_8391":8392,"_8395":8396,"_8399":8400,"_8405":8406,"_8410":8411,"_8415":8416,"_8420":8421,"_8425":8426,"_8430":8431,"_8435":8436,"_8440":8441,"_8445":8446,"_8450":8451,"_8455":8456,"_8460":8461,"_8465":8466,"_8470":8471},"adv.electricFence",{"_4618":7961,"_7962":4059,"_15":7959,"_7963":4059,"_19":7964,"_7965":7531},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4618":7968,"_7962":7969,"_15":7966,"_7963":4059,"_19":7970,"_7965":7584},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4618":7972,"_7962":7973,"_15":7648,"_7963":7974,"_19":7975,"_7965":7713},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4618":7978,"_7962":4059,"_15":7976,"_7963":4059,"_19":7979,"_7965":7531},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4618":7982,"_7962":7983,"_15":7980,"_7963":4059,"_19":7984,"_7965":7531},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4618":7987,"_7962":4059,"_15":7985,"_7963":4059,"_19":7988,"_7965":7531},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4618":7991,"_7962":7992,"_15":7989,"_7963":4059,"_19":7993,"_7965":7625},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4618":7996,"_7962":4059,"_15":7994,"_7963":4059,"_19":7997,"_7965":7531},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4618":8000,"_7962":8001,"_15":7998,"_7963":4059,"_19":8002,"_7965":7531},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4618":8005,"_7962":4059,"_15":8003,"_7963":4059,"_19":8006,"_7965":4059},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4618":8009,"_7962":8010,"_15":8007,"_7963":4059,"_19":8011,"_7965":7584},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4618":8013,"_7962":8014,"_15":7463,"_7963":8015,"_19":8016,"_7965":7713},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4618":8019,"_7962":4059,"_15":8017,"_7963":4059,"_19":8020,"_7965":7531},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4618":8023,"_7962":8024,"_15":8021,"_7963":4059,"_19":8025,"_7965":7531},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4618":8028,"_7962":8029,"_15":8026,"_7963":4059,"_19":8030,"_7965":7531},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4618":8033,"_7962":4059,"_15":8031,"_7963":4059,"_19":8034,"_7965":7558},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4618":8037,"_7962":8038,"_15":8035,"_7963":4059,"_19":8039,"_7965":7531},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4618":8042,"_7962":4059,"_15":8040,"_7963":4059,"_19":8043,"_7965":7558},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4618":8045,"_7962":8046,"_15":7546,"_7963":8047,"_19":8048,"_7965":7625},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4618":8051,"_7962":8046,"_15":8049,"_7963":4059,"_19":8052,"_7965":7625},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4618":8055,"_7962":8056,"_15":8053,"_7963":8057,"_19":8058,"_7965":7558},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4618":8061,"_7962":4059,"_15":8059,"_7963":4059,"_19":8062,"_7965":7558},"持续时间内，受影响的目标暂停行动。","定身",{"_4618":8064,"_7962":8065,"_15":7552,"_7963":8066,"_19":8067,"_7965":7737},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4618":8070,"_7962":8065,"_15":8068,"_7963":4059,"_19":8071,"_7965":7737},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4618":8074,"_7962":4059,"_15":8072,"_7963":8075,"_19":8076,"_7965":4059},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4618":8078,"_7962":8079,"_15":7570,"_7963":8080,"_19":8081,"_7965":7687},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4618":8084,"_7962":8079,"_15":8082,"_7963":4059,"_19":8085,"_7965":7687},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4618":8088,"_7962":8089,"_15":8086,"_7963":4059,"_19":8090,"_7965":7531},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4618":8092,"_7962":8093,"_15":7577,"_7963":8094,"_19":8095,"_7965":7713},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4618":8098,"_7962":8099,"_15":8096,"_7963":8100,"_19":8101,"_7965":7558},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4618":8104,"_7962":8105,"_15":8102,"_7963":4059,"_19":8106,"_7965":7558},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4618":8108,"_7962":8109,"_15":7601,"_7963":8110,"_19":8111,"_7965":7584},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4618":8114,"_7962":4059,"_15":8112,"_7963":8115,"_19":8116,"_7965":7584},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4618":8119,"_7962":8120,"_15":8117,"_7963":4059,"_19":8121,"_7965":7531},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4618":8124,"_7962":8125,"_15":8122,"_7963":4059,"_19":8126,"_7965":7531},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4618":8129,"_7962":8130,"_15":8127,"_7963":4059,"_19":8131,"_7965":7584},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4618":8133,"_7962":7969,"_15":7608,"_7963":8134,"_19":8135,"_7965":7584},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4618":8138,"_7962":4059,"_15":8136,"_7963":8139,"_19":8140,"_7965":7558},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4618":8143,"_7962":8144,"_15":8141,"_7963":4059,"_19":8145,"_7965":7531},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4618":8148,"_7962":4059,"_15":8146,"_7963":4059,"_19":8149,"_7965":4059},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4618":8152,"_7962":8153,"_15":8150,"_7963":8154,"_19":8155,"_7965":7558},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4618":8158,"_7962":8159,"_15":8156,"_7963":4059,"_19":8160,"_7965":7531},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4618":8163,"_7962":4059,"_15":8161,"_7963":8164,"_19":8165,"_7965":7625},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4618":8167,"_7962":8168,"_15":7638,"_7963":8169,"_19":8170,"_7965":7625},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4618":8173,"_7962":8174,"_15":8171,"_7963":4059,"_19":8175,"_7965":7531},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4618":8051,"_7962":8168,"_15":8176,"_7963":4059,"_19":8178,"_7965":7625},"干员受到灼热附着","sys.tacticalItem",{"_4618":8181,"_7962":4059,"_15":8179,"_7963":4059,"_19":8182,"_7965":7531},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4618":8185,"_7962":8186,"_15":8183,"_7963":4059,"_19":8187,"_7965":7625},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4618":8070,"_7962":8190,"_15":8188,"_7963":4059,"_19":8191,"_7965":7737},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4618":8194,"_7962":8195,"_15":8192,"_7963":8196,"_19":8197,"_7965":7558},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4618":8200,"_7962":4059,"_15":8198,"_7963":4059,"_19":8201,"_7965":7558},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4618":8204,"_7962":8205,"_15":8202,"_7963":4059,"_19":8206,"_7965":7713},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4618":8209,"_7962":8210,"_15":8207,"_7963":4059,"_19":8211,"_7965":7737},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4618":8214,"_7962":8215,"_15":8212,"_7963":4059,"_19":8216,"_7965":7558},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4618":8218,"_7962":8219,"_15":7655,"_7963":8110,"_19":8220,"_7965":7584},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4618":7968,"_7962":8219,"_15":8221,"_7963":4059,"_19":8223,"_7965":7584},"干员受到冻结","ba.naturalvul",{"_4618":8226,"_7962":8227,"_15":8224,"_7963":4059,"_19":8228,"_7965":7687},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4618":8013,"_7962":8230,"_15":7675,"_7963":8231,"_19":8232,"_7965":7713},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4618":8235,"_7962":8236,"_15":8233,"_7963":4059,"_19":8237,"_7965":7531},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4618":8240,"_7962":8241,"_15":8238,"_7963":4059,"_19":8242,"_7965":7531},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4618":8245,"_7962":8246,"_15":8243,"_7963":4059,"_19":8247,"_7965":7531},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4618":8250,"_7962":4059,"_15":8248,"_7963":4059,"_19":8251,"_7965":7531},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4618":8254,"_7962":4059,"_15":8252,"_7963":8255,"_19":8256,"_7965":4059},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4618":8259,"_7962":8260,"_15":8257,"_7963":8261,"_19":8262,"_7965":7558},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4618":8264,"_7962":4059,"_15":7475,"_7963":8265,"_19":8266,"_7965":7687},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4618":8268,"_7962":8269,"_15":7514,"_7963":8270,"_19":8271,"_7965":7713},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4618":8274,"_7962":8275,"_15":8272,"_7963":4059,"_19":8276,"_7965":7531},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4618":8279,"_7962":8280,"_15":8277,"_7963":4059,"_19":8281,"_7965":7687},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4618":8284,"_7962":8285,"_15":8282,"_7963":4059,"_19":8286,"_7965":7531},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4618":8288,"_7962":8289,"_15":7701,"_7963":8290,"_19":8291,"_7965":7687},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4618":8084,"_7962":8289,"_15":8292,"_7963":4059,"_19":8294,"_7965":7687},"干员受到自然附着","ba.originium",{"_4618":8297,"_7962":4059,"_15":8295,"_7963":4059,"_19":8298,"_7965":7558},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4618":8301,"_7962":4059,"_15":8299,"_7963":4059,"_19":8302,"_7965":7713},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4618":8305,"_7962":8306,"_15":8303,"_7963":4059,"_19":8307,"_7965":7713},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4618":8310,"_7962":4059,"_15":8308,"_7963":8311,"_19":8312,"_7965":7721},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4618":8315,"_7962":4059,"_15":8313,"_7963":4059,"_19":8316,"_7965":7531},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4618":8319,"_7962":4059,"_15":8317,"_7963":8320,"_19":8321,"_7965":7737},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4618":8324,"_7962":8325,"_15":8322,"_7963":4059,"_19":8326,"_7965":7531},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4618":8328,"_7962":8190,"_15":7741,"_7963":8329,"_19":8330,"_7965":7737},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4618":8333,"_7962":8334,"_15":8331,"_7963":4059,"_19":8335,"_7965":7737},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4618":8338,"_7962":4059,"_15":8336,"_7963":8339,"_19":8340,"_7965":7558},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4618":8343,"_7962":4059,"_15":8341,"_7963":8344,"_19":8345,"_7965":4059},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4618":8348,"_7962":4059,"_15":8346,"_7963":4059,"_19":8349,"_7965":7531},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4618":8352,"_7962":4059,"_15":8350,"_7963":4059,"_19":8353,"_7965":7558},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4618":8356,"_7962":8357,"_15":8354,"_7963":4059,"_19":8358,"_7965":7531},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4618":8361,"_7962":4059,"_15":8359,"_7963":8362,"_19":8363,"_7965":7558},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4618":8366,"_7962":4059,"_15":8364,"_7963":4059,"_19":8367,"_7965":7531},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4618":8370,"_7962":8371,"_15":8368,"_7963":8372,"_19":8373,"_7965":7558},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4618":8376,"_7962":4059,"_15":8374,"_7963":4059,"_19":8377,"_7965":7558},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4618":8380,"_7962":4059,"_15":8378,"_7963":4059,"_19":8381,"_7965":7558},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4618":8384,"_7962":8385,"_15":8382,"_7963":4059,"_19":8386,"_7965":7531},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4618":8389,"_7962":4059,"_15":8387,"_7963":4059,"_19":8390,"_7965":7558},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4618":8393,"_7962":4059,"_15":8391,"_7963":4059,"_19":8394,"_7965":7558},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4618":8397,"_7962":4059,"_15":8395,"_7963":4059,"_19":8398,"_7965":7558},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4618":8401,"_7962":8402,"_15":8399,"_7963":8403,"_19":8404,"_7965":7558},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4618":8407,"_7962":8408,"_15":8405,"_7963":4059,"_19":8409,"_7965":7531},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4618":8412,"_7962":8413,"_15":8410,"_7963":4059,"_19":8414,"_7965":7531},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4618":8417,"_7962":8418,"_15":8415,"_7963":4059,"_19":8419,"_7965":7531},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4618":8422,"_7962":8423,"_15":8420,"_7963":4059,"_19":8424,"_7965":7531},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4618":8427,"_7962":8428,"_15":8425,"_7963":4059,"_19":8429,"_7965":7531},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4618":8432,"_7962":8433,"_15":8430,"_7963":4059,"_19":8434,"_7965":7531},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4618":8437,"_7962":8438,"_15":8435,"_7963":4059,"_19":8439,"_7965":7531},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4618":8442,"_7962":8443,"_15":8440,"_7963":4059,"_19":8444,"_7965":7531},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4618":8447,"_7962":8448,"_15":8445,"_7963":4059,"_19":8449,"_7965":7531},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4618":8452,"_7962":8453,"_15":8450,"_7963":4059,"_19":8454,"_7965":7531},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4618":8457,"_7962":8458,"_15":8455,"_7963":4059,"_19":8459,"_7965":7531},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4618":8462,"_7962":8463,"_15":8460,"_7963":4059,"_19":8464,"_7965":7531},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4618":8467,"_7962":8468,"_15":8465,"_7963":4059,"_19":8469,"_7965":7531},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4618":8472,"_7962":8473,"_15":8470,"_7963":4059,"_19":8474,"_7965":7531},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7168":8477,"_6809":8486,"_6813":8488,"_6687":8490,"_6816":8492,"_6818":8494,"_6820":8496,"_6822":8498,"_6825":8500,"_6828":850