9,"_4617":4059,"_4618":4630,"_4620":4631,"_19":4632,"_4623":4628,"_4624":37,"_4625":4633},"普通攻击：\n对敌人进行至多4段攻击，造成<@ba.natur>自然伤害</>。作为主控干员时，<#ba.lastcombo>重击</>会造成<@ba.poise>{attack_poise:0}</>点失衡。\n\n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成<@ba.natur>自然伤害</>。\n\n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量<@ba.natur>自然伤害</>并恢复一定技力。","icon_attack_pistol","独门射击法",[4634,4635,4636,4637,4638,4639,4640],"chr_0022_bounda_attack1","chr_0022_bounda_attack2","chr_0022_bounda_attack3","chr_0022_bounda_attack4","chr_0022_bounda_attack4_1","chr_0022_bounda_power_attack","chr_0022_bounda_plunging_attack_end","chr_0022_bounda_NormalSkill",{"_4606":4059,"_4607":4059,"_4608":4059,"_4609":4059,"_4610":4059,"_4611":4059,"_4612":4059,"_4613":4059,"_4614":4059,"_4615":4059,"_4616":4059,"_4617":4059,"_4618":4643,"_4620":4644,"_19":4645,"_4623":4641,"_4624":39,"_4625":4646},"踢出<@ba.key>自制炸弹</>将其黏附在目标身上，并施加<#ba.slow>缓速</>，短暂延迟后爆炸对范围内的敌人造成<@ba.natur>自然伤害</>并施加<#ba.naturalinflict>自然附着</>。若黏附目标被击败则<@ba.key>自制炸弹</>提前爆炸。\n<@ba.info>场上同时只能存在一个自制炸弹。</>","icon_skill_bounda_01","小惊喜",[4647],"chr_0022_bounda_normal_skill","chr_0022_bounda_UltimateSkill",{"_4606":4059,"_4607":4059,"_4608":4059,"_4609":4059,"_4610":4059,"_4611":4059,"_4612":4059,"_4613":4059,"_4614":4059,"_4615":4059,"_4616":4059,"_4617":4059,"_4618":4650,"_4620":4651,"_19":4652,"_4623":4648,"_4624":55,"_4625":4653},"萤石以弧形轨迹高速运动并向弧内目标快速射击，造成4段<@ba.natur>自然伤害</>，若命中目标身上粘有<@ba.key>自制炸弹</>，则立刻将其引爆并提升爆炸伤害及范围。\n若最后一段伤害命中处于2层及以上<#ba.crystinflict>寒冷附着</>或<#ba.naturalinflict>自然附着</>的目标，则再次施加该<#ba.spellinflict>法术附着</>。","icon_ultimate_skill_bounda_01","巅峰闹剧",[4654],"chr_0022_bounda_ultimate_skill","skillLevelUp",[4657,4667,4672,4678,4683,4688,4695,4700,4704,4714,4721,4728,4732,4736,4740,4744,4748,4752,4756,4760,4766,4772,4778,4782,4786,4790,4794,4798,4802,4806,4810,4817,4823,4829,4833,4837,4841,4845,4849,4853,4857,4861,4867,4873],{"_4658":4659,"_4660":4661,"_4666":55,"_4623":4641},"goldCost",1000,"itemBundle",[4662,4664],{"_4544":68,"_15":4663},"item_char_sk