"_36":39,"_38":3905},5832,{"_36":55,"_38":3907},321,{"_36":58,"_38":37},{"_36":60,"_38":3910},1.48469387755102,{"_36":62,"_38":3912},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3932,"_102":64},{"_33":3933},[3934,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":963},{"_36":41,"_38":3936},96.26593730275614,{"_36":44,"_38":3938},180.26193982747793,{"_36":47,"_38":3940},122.62882390069458,{"_36":50,"_38":3942},98.3673469387755,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},324,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2013},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3970,"_102":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},97.12265937302755,{"_36":44,"_38":3977},181.986640016832,{"_36":47,"_38":3979},123.77626762045053,{"_36":50,"_38":3981},99.2867662528929,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},327,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4010,"_102":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},97.97938144329896,{"_36":44,"_38":4017},183.71134020618612,{"_36":47,"_38":4019},124.92371134020647,{"_36":50,"_38":4021},100.2061855670103,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},330,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2051},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4050,4051],"tag_15","tag_14","charId","charIllustInitPos",{"_4055":94,"_4056":4057},"x","y",-517,"charPassiveUIPrefabName","","charTypeId","Natural","cvName",{"_4064":4065,"_4066":4067,"_4068":4069,"_4070":4071,"_4052":16},"ChiCVName","曹雅雯","EngCVName","Katiana Sarkissian","JapCVName","大地叶","KorCVName","张美","defaultWeaponId","wpn_pistol_0001","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Fluorite","mainAttrType","phoneticName","profession","profileRecord",[4085,4096,4101,4106,4111,4116],{"_4052":16,"_15":4086,"_4087":4088,"_4089":4090,"_4091":39,"_4092":4093,"_4094":37,"_4095":37},"chr_0022_bounda_1","recordDesc","【代号】萤石\n【性别】女\n【身份认证】终末地工业\n【生日】6月21日\n【种族】斐迪亚\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：优良\n战术规划：标准\n源石技艺适应性：普通\n\n请萤石小姐务必认真参与例行体检测试。如果她再找借口不好好做检查，我们就要把情况告诉秋栗小姐了。","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4052":16,"_15":4097,"_4087":4098,"_4089":4099,"_4091":55,"_4092":4100,"_4094":37,"_4095":37},"chr_0022_bounda_2","干员萤石，在鼓动地方民众使用暴力手段反抗当地不法势力，并帮助终末地外勤队伍摆脱威胁后，经干员秋栗申请，纳入Z7行动组管理，此后无新增犯罪记录。\n\n务必留意社交场合的萤石，她的所谓“私人恩怨”并不算什么，但与她交流本身就足够制造意外。好在大多数时候萤石并不反感当一个安静的听众，而我们更重视干员的战斗能力，这不是一个难以处理的情况。\n但是，她抢答了我要问的每一个问题，甚至在我完成风趣回应之前笑了出来。算法推演中不曾出现此类结果，已纳入待分析特征库。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4052":16,"_15":4102,"_4087":4103,"_4089":4104,"_4091":58,"_4092":4105,"_4094":37,"_4095":37},"chr_0022_bounda_3","根据本人自述，萤石的源石技艺只是制造一些性状多变、具有黏着性的液体。如果情况属实（我得说，可信度并不高），那么她糟糕的社交表现就只能用“阅历丰富”来解释了——只有专家才知道怎样准确揣测别人的痛点，至于她为什么会毫不犹豫地戳下去则是另一码事。即便测试结果已经公开，依然有人固执地认为她一定还有其他诸如“读心术”之类的秘密能力。\n“试想一下，你今天的体能测试差点儿不合格，刚刚挨了教官一顿臭骂。回宿舍的路上看到她，她突然冒出来一句‘没办法，半夜的三明治的确很香’……这还不够烦人吗？行，我知道偷吃宵夜是我不对，但她干嘛说出来呀！”\n有人曾经这样向Z7行动组的成员们抱怨，却没有得到太多安慰，只收获了无数“我懂你”的眼神。平心而论，萤石并不喜欢惹是生非，性格方面甚至称得上沉默寡言。然而，她自由散漫的行动方式和太过犀利的沟通习惯结合在一起，大部分情况下都会让人不适。对于这些控诉，萤石的自我辩护简单而真诚：\n“要我去道歉吗？”","CN_03","档案资料·一",{"_4052":16,"_15":4107,"_4087":4108,"_4089":4109,"_4091":64,"_4092":4110,"_4094":64,"_4095":3634},"chr_0022_bounda_4","维若娜，外号“双利手”“长舌妇”“子弹长眼”“无根草”，女，斐迪亚，绿发。\n前任醉鬼帮打手、瘸帮打手、饿狼帮短铳队队员、疤痕佣兵队挂名（不用防备报复）、“歪脖子”罗根的头牌射手，据说金盆洗手后在白道的安保公司任职。\n擅长使用短铳，也会用飞刀、手弩。行动敏捷，出手极快，十分狡猾，会使用各种陷阱。留意她手上的任何东西，不要听她说的哪怕一个字，以及不要在野外找她麻烦，非常危险。\n事迹：以下犯上、偷窃帮派物资、背叛组织；煽动“异铁螺钉”小镇居民，搞垮“歪脖子”罗根的产业，致残帮派全部成员；另外，我们确信在公共场合猛踢某位发言人下体后逃走的就是她。\n交易人：“不归路”酒吧找光头布朗。旧币不连号，见人见钱。手脚拿三成，舌头拿五成。\n悬赏额：300000金票\n更新：450000金票\n更新：800000金票（金主要求，活捉再加二十万！）\n更新：1200000金票\n\n（潦草的手写体）“某位”发言人是鲍威尔，活该。\n\nS.O.W.批注：经过劝说，萤石干员主动上交了这份悬赏令。目前暂时可以确认没有更多留有她书写痕迹的副本。关于公共场合袭击发言人一事，人力资源事务部已经与萤石干员进行过沟通，如需调阅相关记录，可直接向该部门咨询。\n发言人鲍威尔并未受到严重身体伤害，但显然其公众形象严重受损。这不仅是因为他在剧烈疼痛下不太严肃的夸张表现，也因为他在发现萤石干员后展现的恶劣态度与其平日塑造的形象不符。经调查，发言人鲍威尔的初期政治活动主要集中在临近开拓区的数个自由市，并且他与许多小型犯罪组织头目有交往记录。例如，盘踞在“异铁螺钉”小镇的“歪脖子”罗根涉嫌非法作物交易和高危环境强迫劳动，曾数次向发言人鲍威尔献金以寻求庇佑。\n考虑到萤石干员加入终末地前在“异铁螺钉”小镇最后的行为，不难理解她为何对暗中保护地方黑恶势力的发言人鲍威尔怀有仇恨。调取监控记录后，可以确认萤石当时已经蒙面，发言人鲍威尔的犯罪记录也已经送交环塔商会，暂时没有引发进一步公共关系问题的风险。","CN_04","档案资料·二",{"_4052":16,"_15":4112,"_4087":4113,"_4089":4114,"_4091":66,"_4092":4115,"_4094":64,"_4095":3634},"chr_0022_bounda_5","“——关键在于，那些聚落已经全部荒废了。如果按萤石的自述绘制行动轨迹，你会发现她就像食腐动物一样追着衰颓的镇子迁移，等待尸体出现，然后再次‘起飞’……\n“这里没有质疑她的意思——并非这些流浪者导致了聚落的衰败，而是他们往往只能找到处境不佳的落脚处。能触及边缘地带的援助实在有限，如果某个中转城市遭遇危机，供给断裂可能会引发连锁反应，把一整条物流链上的聚落全都毁掉。\n“从最偏僻、最脆弱的地方开始，逃难者们乘着崩溃的波浪一路逃离，直到他们抵达一个足够稳定的新居所，或者和某个聚落一起消失……人们甚至给这种现象起了一个名字。\n“只要那些城市间的联系依然脆弱，‘搁浅’还会发生无数次。危机会滋生特权，特权会滋生罪恶。到了某个临界点，文明就不再是家园，而是垄断者们套在奴隶脖子上的锁链。\n“我们必须掌握阻止这一切继续发生的力量。”","CN_05","档案资料·三",{"_4052":16,"_15":4117,"_4087":4118,"_4089":4119,"_4091":68,"_4092":4120,"_4094":64,"_4095":4121},"chr_0022_bounda_6","妈妈，我打听到叔叔婶婶们现在的情况了：\n戈登，合金萝卜自由市，卡车司机。\n艾尔莎，团结号，似乎在一家杂货铺当售货员。\n安达露西亚，新都筑自由市，记者。\n大威廉，“异铁螺钉”小镇（已废弃），已故，轨道事故。\n卡拉库尔特，只打听到她已经启程去玛尔斯波利斯，最后一次露面在五号谷地附近。\n艾比，还没找到。\n卡维尔，还没找到。\n“长腿”，在监狱服刑，宏山人对犯人还不错。\n阿尔丹，和我决斗，逃跑了，不打算去找。人渣。\n…………\n维若娜，现在也可以叫我“萤石”。我已经在天上了。这里很有趣，先不走了。\n如果你捡到了这封信，而且是个好人，把它交给终末地工业，或者送去开拓区烧掉。谢谢。\n——一张被叠成小块、皱巴巴的纸。从后勤干员手上拿回它时，萤石的眼神很少见地变得有些温柔。","CN_06","档案资料·四",1500,"profileVoice",[4124,4132,4136,4140,4144,4148,4152,4157,4162,4167,4172,4177,4182,4187,4192,4197,4202,4207,4212,4217,4222,4227,4232,4237,4242,4247,4252,4257,4262,4267,4272,4277,4282,4287,4292,4297,4302,4307,4312,4317,4322,4327,4332,4337,4342,4347,4352,4357,4362,4367,4372,4377,4382,4387,4392,4397,4402,4407,4412,4417,4422,4427,4432,4437,4442,4447,4452,4457,4462,4467,4472,4477,4482,4487,4492,4497,4502,4507,4512,4517],{"_4052":16,"_15":4086,"_4094":37,"_4095":37,"_4125":4126,"_4127":4128,"_4129":39,"_4130":4131},"voId","chr_0022_bounda_chrbark_squad_01","voiceDesc","呀，来活了？","voiceIndex","voiceTitle","行动准备1",{"_4052":16,"_15":4097,"_4094":37,"_4095":37,"_4125":4133,"_4127":4134,"_4129":55,"_4130":4135},"chr_0022_bounda_chrbark_squad_02","要是有人没准备好呢？","行动准备2",{"_4052":16,"_15":4102,"_4094":37,"_4095":37,"_4125":4137,"_4127":4138,"_4129":58,"_4130":4139},"chr_0022_bounda_chrbark_join_01","让我们好好相处吧，女士们、先生们？","编入队伍1",{"_4052":16,"_15":4107,"_4094":37,"_4095":37,"_4125":4141,"_4127":4142,"_4129":64,"_4130":4143},"chr_0022_bounda_chrbark_join_02","哼哼，我还挺被看重呢。","编入队伍2",{"_4052":16,"_15":4112,"_4094":37,"_4095":37,"_4125":4145,"_4127":4146,"_4129":66,"_4130":4147},"chr_0022_bounda_chrbark_weap_01","还算趁手……介意我做点小改装吗？","更换武器",{"_4052":16,"_15":4117,"_4094":37,"_4095":37,"_4125":4149,"_4127":4150,"_4129":68,"_4130":4151},"chr_0022_bounda_chrbark_gear_01","东西越好，事越麻烦，对吧？","更换装备",{"_4052":16,"_15":4153,"_4094":37,"_4095":37,"_4125":4154,"_4127":4155,"_4129":70,"_4130":4156},"chr_0022_bounda_7","chr_0022_bounda_chrup_skill_01","没人陪我练习一下吗？真可惜。","激活天赋阵列",{"_4052":16,"_15":4158,"_4094":37,"_4095":37,"_4125":4159,"_4127":4160,"_4129":88,"_4130":4161},"chr_0022_bounda_8","chr_0022_bounda_chrup_level_01","这么多作战记录，不愧是终末地“工业”啊。","观看作战记录",{"_4052":16,"_15":4163,"_4094":55,"_4095":39,"_4125":4164,"_4127":4165,"_4129":90,"_4130":4166},"chr_0022_bounda_9","chr_0022_bounda_chrup_promt01_01","看来后头的工作不轻松呢。","精英化晋升1",{"_4052":16,"_15":4168,"_4094":55,"_4095":55,"_4125":4169,"_4127":4170,"_4129":94,"_4130":4171},"chr_0022_bounda_10","chr_0022_bounda_chrup_promt02_01","荣幸之至——出勤时间又要变长了，对吧？","精英化晋升2",{"_4052":16,"_15":4173,"_4094":55,"_4095":58,"_4125":4174,"_4127":4175,"_4129":101,"_4130":4176},"chr_0022_bounda_11","chr_0022_bounda_chrup_promt03_01","下回发个勋章吧，我还从来没拿过呢。","精英化晋升3",{"_4052":16,"_15":4178,"_4094":55,"_4095":64,"_4125":4179,"_4127":4180,"_4129":96,"_4130":4181},"chr_0022_bounda_12","chr_0022_bounda_chrup_promt04_01","如果文明环带边缘也在终末地想创造的“美好世界”里，那我们还有很多工作要做，不是吗？","精英化晋升4",{"_4052":16,"_15":4183,"_4094":37,"_4095":37,"_4125":4184,"_4127":4185,"_4129":526,"_4130":4186},"chr_0022_bounda_13","chr_0022_bounda_introduce_01","Z7行动组游击手，萤石。不说点什么吗？嗯……要不，散会？","干员报到",{"_4052":16,"_15":4188,"_4094":37,"_4095":37,"_4125":4189,"_4127":4190,"_4129":565,"_4130":4191},"chr_0022_bounda_14","chr_0022_bounda_mono_switch_01","这回轮到谁倒霉了？","待命1",{"_4052":16,"_15":4193,"_4094":37,"_4095":37,"_4125":4194,"_4127":4195,"_4129":98,"_4130":4196},"chr_0022_bounda_15","chr_0022_bounda_mono_switch_02","扰乱？牵制？还是……一步到位？","待命2",{"_4052":16,"_15":4198,"_4094":37,"_4095":37,"_4125":4199,"_4127":4200,"_4129":643,"_4130":4201},"chr_0022_bounda_16","chr_0022_bounda_sim_assign_work_01","放心，我会好好干的。","进驻设施",{"_4052":16,"_15":4203,"_4094":37,"_4095":37,"_4125":4204,"_4127":4205,"_4129":683,"_4130":4206},"chr_0022_bounda_17","chr_0022_bounda_sim_hello_lower_01","真忙呀，大英雄。","打招呼1",{"_4052":16,"_15":4208,"_4094":64,"_4095":3634,"_4125":4209,"_4127":4210,"_4129":722,"_4130":4211},"chr_0022_bounda_18","chr_0022_bounda_sim_hello_max_01","又有多久没休息了？","打招呼2",{"_4052":16,"_15":4213,"_4094":37,"_4095":37,"_4125":4214,"_4127":4215,"_4129":762,"_4130":4216},"chr_0022_bounda_19","chr_0022_bounda_sim_talk_lv01_01","嗯……真难得，不像是找我出任务呢。","帝江号闲聊1",{"_4052":16,"_15":4218,"_4094":64,"_4095":3634,"_4125":4219,"_4127":4220,"_4129":801,"_4130":4221},"chr_0022_bounda_20","chr_0022_bounda_sim_talk_lv02_01","秋栗她笑着进训练室了？还拿着剑？好，那我再躲一会儿……","帝江号闲聊2",{"_4052":16,"_15":4223,"_4094":64,"_4095":3634,"_4125":4224,"_4127":4225,"_4129":872,"_4130":4226},"chr_0022_bounda_21","chr_0022_bounda_sim_talk_lv02_02","第一次摸到铳的时候，我连怎么打开它的弹巢都不知道，但对面已经冲上来好几人了……和开拓区比起来，这里的训练很温柔呢。","帝江号闲聊3",{"_4052":16,"_15":4228,"_4094":64,"_4095":4121,"_4125":4229,"_4127":4230,"_4129":911,"_4130":4231},"chr_0022_bounda_22","chr_0022_bounda_sim_talk_max_01","我们小队这几位要不是刚好凑在一起，能惹的麻烦大概要多好几倍。放心，我当然会帮你看着他们啦。","帝江号闲聊4",{"_4052":16,"_15":4233,"_4094":64,"_4095":4121,"_4125":4234,"_4127":4235,"_4129":951,"_4130":4236},"chr_0022_bounda_23","chr_0022_bounda_sim_talk_max_02","小时候，我们几个小鬼会在驮兽车上晒着太阳睡一整天，这样肚子才不容易饿……我没在抱怨员工福利，只是飞得这么高，不多晒晒太阳就可惜了。","帝江号闲聊5",{"_4052":16,"_15":4238,"_4094":64,"_4095":4121,"_4125":4239,"_4127":4240,"_4129":990,"_4130":4241},"chr_0022_bounda_24","chr_0022_bounda_sim_talk_max_03","你和佩丽卡监督一样，让人讨厌不起来呢。开拓区的“大人物”们只会揪着排场和面子不放，可就算没有那些东西，大家也愿意跟着真正的领袖，对吧？","帝江号闲聊6",{"_4052":16,"_15":4243,"_4094":37,"_4095":37,"_4125":4244,"_4127":4245,"_4129":62,"_4130":4246},"chr_0022_bounda_25","chr_0022_bounda_sim_gift_give_01","再送你个小东西。放心，这次的不吓人。","赠送礼物",{"_4052":16,"_15":4248,"_4094":37,"_4095":37,"_4125":4249,"_4127":4250,"_4129":1068,"_4130":4251},"chr_0022_bounda_26","chr_0022_bounda_sim_gift_recv_01","以前，我有位“同事”收了一件礼物，然后就被抓去顶罪了——你拼命摇头做什么？","接收礼物",{"_4052":16,"_15":4253,"_4094":37,"_4095":37,"_4125":4254,"_4127":4255,"_4129":1108,"_4130":4256},"chr_0022_bounda_27","chr_0022_bounda_mono_self_line01","交涉经验？最好别把那些地痞混混太当回事。他们只是眼线和爪牙，主子稍微动动饭盆，就得乖乖跟着跑。蠢材到处都是，最多不过掀点小风小浪，真正能把一片地方毒死的，还是那些霸着资源和权力不松手，垄断了一切的家伙。","信赖对话1",{"_4052":16,"_15":4258,"_4094":64,"_4095":3634,"_4125":4259,"_4127":4260,"_4129":1147,"_4130":4261},"chr_0022_bounda_28","chr_0022_bounda_mono_self_line02","入伙前我犯了点事，是秋栗为我写的保证书。那时候，她的小队在拼命保护镇子，赶走了那些裂地者，但居民们却盯上了终末地的物资……换成是你，你会怎么做？","信赖对话2",{"_4052":16,"_15":4263,"_4094":64,"_4095":3634,"_4125":4264,"_4127":4265,"_4129":1187,"_4130":4266},"chr_0022_bounda_29","chr_0022_bounda_mono_self_line03","有一阵子，我有六个叔叔，八个婶婶，二十二个兄弟姐妹……倒像是一家子卡特斯了。他们是我和妈妈逃难路上的伙伴，我们彼此照顾。有人中途加入，也有人离开。即便这支队伍很快就散了，那也是我少数有“家庭”的时候。","信赖对话3",{"_4052":16,"_15":4268,"_4094":64,"_4095":4121,"_4125":4269,"_4127":4270,"_4129":56,"_4130":4271},"chr_0022_bounda_30","chr_0022_bounda_mono_self_line04","我们有四肢，却只用两条腿走路。如果自己不记得如何直起身子，就和那些野兽没区别了。开拓区到处都是这样的人。低头一辈子，就要当一辈子家畜，只有抬起头来，才能有机会做个人。","信赖对话4",{"_4052":16,"_15":4273,"_4094":64,"_4095":4121,"_4125":4274,"_4127":4275,"_4129":1265,"_4130":4276},"chr_0022_bounda_31","chr_0022_bounda_mono_self_line05","这封信，拿着。如果我回不来了，把它带去荒野烧掉吧。想打开看也可以，只是一些琐事罢了。收信人已经去世，他们想打听的消息只能让我去找了。你会帮我的吧，塔卫二的大英雄？","信赖对话5",{"_4052":16,"_15":4278,"_4094":37,"_4095":37,"_4125":4279,"_4127":4280,"_4129":1304,"_4130":4281},"chr_0022_bounda_32","chr_0022_bounda_mono_chat_line01","这是我常用的小炸弹。只要调整附着面的黏性，就能让它在最合适的地方炸开。担心威力？没关系，它能拖延目标行动，这比直接破坏有用多了。","交谈1",{"_4052":16,"_15":4283,"_4094":37,"_4095":37,"_4125":4284,"_4127":4285,"_4129":118,"_4130":4286},"chr_0022_bounda_33","chr_0022_bounda_mono_chat_line02","看过履历之后，佩丽卡监督给了我“萤石”这个代号——自然状态有毒，但也能制作很多工业用品。翻过书之后，我大概懂她的意思了。不过，有点坏心眼呢。","交谈2",{"_4052":16,"_15":4288,"_4094":37,"_4095":37,"_4125":4289,"_4127":4290,"_4129":1382,"_4130":4291},"chr_0022_bounda_34","chr_0022_bounda_mono_chat_line03","小时候，我跟着妈妈到处逃难。后来，我自己一个人在开拓区过活。有的聚居地会拿种子粮救济难民，有的自由市会巧立名目征收各种杂税，哪儿都是我的家乡，哪儿也都不是。开拓区的聚落都“活”不长久，“家乡”的分量太轻了。","交谈3",{"_4052":16,"_15":4293,"_4094":37,"_4095":37,"_4125":4294,"_4127":4295,"_4129":1422,"_4130":4296},"chr_0022_bounda_35","chr_0022_bounda_mono_chat_line04","其实，那片荒野一直都很美。侵蚀赶跑的动物不会一走了之，每年都会出现新的迁徙路线。灾害边缘总是长满野草，哪怕只消退一点，黄色和绿色都会马上填满空缺。它们自己循环得很好，只是没法再承受更多了……你说，“人”会不会才是那里最多余的东西？","交谈4",{"_4052":16,"_15":4298,"_4094":37,"_4095":37,"_4125":4299,"_4127":4300,"_4129":157,"_4130":4301},"chr_0022_bounda_36","chr_0022_bounda_mono_chat_line05","我待过的那几个偏僻地方，压榨别人最狠的往往都是秩序的维护者。他们知道有些地方一点动荡都受不起，就把居民当人质，维持了一个妙得恶心的平衡。改变现状吧，只要你的手还离他们那么远，这样的事就会永远存在。","交谈5",{"_4052":16,"_15":4303,"_4094":37,"_4095":37,"_4125":4304,"_4127":4305,"_4129":1500,"_4130":4306},"chr_0022_bounda_37","chr_0022_bounda_mono_about_line01","猜猜看，我展示的那串耳朵，是谁帮忙收进证物袋里的？就算是我们善良纯真的好队长，也知道塔卫二没有更好的选择。当然，她忍着不哭鼻子的表情，我还是挺喜欢的喔。","话题：秋栗",{"_4052":16,"_15":4308,"_4094":37,"_4095":37,"_4125":4309,"_4127":4310,"_4129":1539,"_4130":4311},"chr_0022_bounda_38","chr_0022_bounda_mono_about_line02","虽然那家伙好像乐在其中，但还是悠着点使唤他吧。有些人越是准备万全，越是害怕出纰漏。你知道，人不可能永远不犯错……从我先做起？不要，那多麻烦。而且，不管有多害怕，他都会挺过来的。","话题：卡契尔",{"_4052":16,"_15":4313,"_4094":37,"_4095":37,"_4125":4314,"_4127":4315,"_4129":41,"_4130":4316},"chr_0022_bounda_39","chr_0022_bounda_mono_about_line03","别随便试埃特拉听的音乐，也别真放她去找刺激。她是因为游刃有余才会冒出那些想法？我不觉得，做好善后准备吧，指挥大师。","话题：埃特拉",{"_4052":16,"_15":4318,"_4094":37,"_4095":37,"_4125":4319,"_4127":4320,"_4129":44,"_4130":4321},"chr_0022_bounda_40","chr_0022_bounda_mono_about_line04","大蜥蜴就算战斗时也一直不慌不忙的，他大概根本没意识到危险在哪儿吧？队长其实没必要总因为这个生气，反正每个人有各自的活法。嗯……我对他没什么意见，只要别老盯着别人的尾巴不放就好。","话题：安塔尔",{"_4052":16,"_15":4323,"_4094":37,"_4095":37,"_4125":4324,"_4127":4325,"_4129":47,"_4130":4326},"chr_0022_bounda_41","chr_0022_bounda_explore_point_common_01","找到一点好东西，我能全拿走吗？","发现资源1",{"_4052":16,"_15":4328,"_4094":37,"_4095":37,"_4125":4329,"_4127":4330,"_4129":50,"_4130":4331},"chr_0022_bounda_42","chr_0022_bounda_explore_point_valub_01","难道你没看见那边的……啊，我什么都没说。","发现资源2",{"_4052":16,"_15":4