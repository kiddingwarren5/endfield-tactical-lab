:8234,"_8238":8239,"_7744":8242,"_8247":8248,"_8251":8252,"_8257":8258,"_7750":8261,"_8266":8267,"_8270":8271,"_7768":8275,"_8280":8281,"_8284":8285,"_7775":8289,"_8294":8295,"_8300":8301,"_7799":8305,"_8310":8311,"_8315":8316,"_8320":8321,"_8325":8326,"_7806":8330,"_8334":8335,"_8339":8340,"_8344":8345,"_8348":8349,"_8354":8355,"_8359":8360,"_7836":8364,"_8369":8370,"_8374":8375,"_8377":8378,"_8381":8382,"_8386":8387,"_8390":8391,"_8396":8397,"_8400":8401,"_8405":8406,"_8410":8411,"_7853":8415,"_8419":8420,"_8422":8423,"_7873":8427,"_8431":8432,"_8436":8437,"_8441":8442,"_8446":8447,"_8450":8451,"_8455":8456,"_7673":8461,"_7712":8465,"_8470":8471,"_8475":8476,"_8480":8481,"_7899":8485,"_8490":8491,"_8493":8494,"_8497":8498,"_8501":8502,"_8506":8507,"_8511":8512,"_8515":8516,"_8520":8521,"_7939":8525,"_8529":8530,"_8534":8535,"_8539":8540,"_8544":8545,"_8548":8549,"_8552":8553,"_8557":8558,"_8562":8563,"_8566":8567,"_8572":8573,"_8576":8577,"_8580":8581,"_8585":8586,"_8589":8590,"_8593":8594,"_8597":8598,"_8603":8604,"_8608":8609,"_8613":8614,"_8618":8619,"_8623":8624,"_8628":8629,"_8633":8634,"_8638":8639,"_8643":8644,"_8648":8649,"_8653":8654,"_8658":8659,"_8663":8664,"_8668":8669},"adv.electricFence",{"_4634":8159,"_8160":4059,"_15":8157,"_8161":4059,"_19":8162,"_8163":7729},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4634":8166,"_8160":8167,"_15":8164,"_8161":4059,"_19":8168,"_8163":7782},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4634":8170,"_8160":8171,"_15":7846,"_8161":8172,"_19":8173,"_8163":7911},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4634":8176,"_8160":4059,"_15":8174,"_8161":4059,"_19":8177,"_8163":7729},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4634":8180,"_8160":8181,"_15":8178,"_8161":4059,"_19":8182,"_8163":7729},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4634":8185,"_8160":4059,"_15":8183,"_8161":4059,"_19":8186,"_8163":7729},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4634":8189,"_8160":8190,"_15":8187,"_8161":4059,"_19":8191,"_8163":7823},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4634":8194,"_8160":4059,"_15":8192,"_8161":4059,"_19":8195,"_8163":7729},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4634":8198,"_8160":8199,"_15":8196,"_8161":4059,"_19":8200,"_8163":7729},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4634":8203,"_8160":4059,"_15":8201,"_8161":4059,"_19":8204,"_8163":4059},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4634":8207,"_8160":8208,"_15":8205,"_8161":4059,"_19":8209,"_8163":7782},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4634":8211,"_8160":8212,"_15":7661,"_8161":8213,"_19":8214,"_8163":7911},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4634":8217,"_8160":4059,"_15":8215,"_8161":4059,"_19":8218,"_8163":7729},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4634":8221,"_8160":8222,"_15":8219,"_8161":4059,"_19":8223,"_8163":7729},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4634":8226,"_8160":8227,"_15":8224,"_8161":4059,"_19":8228,"_8163":7729},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4634":8231,"_8160":4059,"_15":8229,"_8161":4059,"_19":8232,"_8163":7756},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4634":8235,"_8160":8236,"_15":8233,"_8161":4059,"_19":8237,"_8163":7729},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4634":8240,"_8160":4059,"_15":8238,"_8161":4059,"_19":8241,"_8163":7756},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4634":8243,"_8160":8244,"_15":7744,"_8161":8245,"_19":8246,"_8163":7823},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4634":8249,"_8160":8244,"_15":8247,"_8161":4059,"_19":8250,"_8163":7823},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4634":8253,"_8160":8254,"_15":8251,"_8161":8255,"_19":8256,"_8163":7756},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4634":8259,"_8160":4059,"_15":8257,"_8161":4059,"_19":8260,"_8163":7756},"持续时间内，受影响的目标暂停行动。","定身",{"_4634":8262,"_8160":8263,"_15":7750,"_8161":8264,"_19":8265,"_8163":7935},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4634":8268,"_8160":8263,"_15":8266,"_8161":4059,"_19":8269,"_8163":7935},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4634":8272,"_8160":4059,"_15":8270,"_8161":8273,"_19":8274,"_8163":4059},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4634":8276,"_8160":8277,"_15":7768,"_8161":8278,"_19":8279,"_8163":7885},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4634":8282,"_8160":8277,"_15":8280,"_8161":4059,"_19":8283,"_8163":7885},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4634":8286,"_8160":8287,"_15":8284,"_8161":4059,"_19":8288,"_8163":7729},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4634":8290,"_8160":8291,"_15":7775,"_8161":8292,"_19":8293,"_8163":7911},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4634":8296,"_8160":8297,"_15":8294,"_8161":8298,"_19":8299,"_8163":7756},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4634":8302,"_8160":8303,"_15":8300,"_8161":4059,"_19":8304,"_8163":7756},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4634":8306,"_8160":8307,"_15":7799,"_8161":8308,"_19":8309,"_8163":7782},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4634":8312,"_8160":4059,"_15":8310,"_8161":8313,"_19":8314,"_8163":7782},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4634":8317,"_8160":8318,"_15":8315,"_8161":4059,"_19":8319,"_8163":7729},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4634":8322,"_8160":8323,"_15":8320,"_8161":4059,"_19":8324,"_8163":7729},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4634":8327,"_8160":8328,"_15":8325,"_8161":4059,"_19":8329,"_8163":7782},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4634":8331,"_8160":8167,"_15":7806,"_8161":8332,"_19":8333,"_8163":7782},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4634":8336,"_8160":4059,"_15":8334,"_8161":8337,"_19":8338,"_8163":7756},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4634":8341,"_8160":8342,"_15":8339,"_8161":4059,"_19":8343,"_8163":7729},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4634":8346,"_8160":4059,"_15":8344,"_8161":4059,"_19":8347,"_8163":4059},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4634":8350,"_8160":8351,"_15":8348,"_8161":8352,"_19":8353,"_8163":7756},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4634":8356,"_8160":8357,"_15":8354,"_8161":4059,"_19":8358,"_8163":7729},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4634":8361,"_8160":4059,"_15":8359,"_8161":8362,"_19":8363,"_8163":7823},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4634":8365,"_8160":8366,"_15":7836,"_8161":8367,"_19":8368,"_8163":7823},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4634":8371,"_8160":8372,"_15":8369,"_8161":4059,"_19":8373,"_8163":7729},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4634":8249,"_8160":8366,"_15":8374,"_8161":4059,"_19":8376,"_8163":7823},"干员受到灼热附着","sys.tacticalItem",{"_4634":8379,"_8160":4059,"_15":8377,"_8161":4059,"_19":8380,"_8163":7729},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4634":8383,"_8160":8384,"_15":8381,"_8161":4059,"_19":8385,"_8163":7823},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4634":8268,"_8160":8388,"_15":8386,"_8161":4059,"_19":8389,"_8163":7935},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4634":8392,"_8160":8393,"_15":8390,"_8161":8394,"_19":8395,"_8163":7756},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4634":8398,"_8160":4059,"_15":8396,"_8161":4059,"_19":8399,"_8163":7756},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4634":8402,"_8160":8403,"_15":8400,"_8161":4059,"_19":8404,"_8163":7911},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4634":8407,"_8160":8408,"_15":8405,"_8161":4059,"_19":8409,"_8163":7935},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4634":8412,"_8160":8413,"_15":8410,"_8161":4059,"_19":8414,"_8163":7756},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4634":8416,"_8160":8417,"_15":7853,"_8161":8308,"_19":8418,"_8163":7782},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4634":8166,"_8160":8417,"_15":8419,"_8161":4059,"_19":8421,"_8163":7782},"干员受到冻结","ba.naturalvul",{"_4634":8424,"_8160":8425,"_15":8422,"_8161":4059,"_19":8426,"_8163":7885},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4634":8211,"_8160":8428,"_15":7873,"_8161":8429,"_19":8430,"_8163":7911},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4634":8433,"_8160":8434,"_15":8431,"_8161":4059,"_19":8435,"_8163":7729},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4634":8438,"_8160":8439,"_15":8436,"_8161":4059,"_19":8440,"_8163":7729},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4634":8443,"_8160":8444,"_15":8441,"_8161":4059,"_19":8445,"_8163":7729},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4634":8448,"_8160":4059,"_15":8446,"_8161":4059,"_19":8449,"_8163":7729},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4634":8452,"_8160":4059,"_15":8450,"_8161":8453,"_19":8454,"_8163":4059},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4634":8457,"_8160":8458,"_15":8455,"_8161":8459,"_19":8460,"_8163":7756},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4634":8462,"_8160":4059,"_15":7673,"_8161":8463,"_19":8464,"_8163":7885},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4634":8466,"_8160":8467,"_15":7712,"_8161":8468,"_19":8469,"_8163":7911},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4634":8472,"_8160":8473,"_15":8470,"_8161":4059,"_19":8474,"_8163":7729},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4634":8477,"_8160":8478,"_15":8475,"_8161":4059,"_19":8479,"_8163":7885},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4634":8482,"_8160":8483,"_15":8480,"_8161":4059,"_19":8484,"_8163":7729},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4634":8486,"_8160":8487,"_15":7899,"_8161":8488,"_19":8489,"_8163":7885},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4634":8282,"_8160":8487,"_15":8490,"_8161":4059,"_19":8492,"_8163":7885},"干员受到自然附着","ba.originium",{"_4634":8495,"_8160":4059,"_15":8493,"_8161":4059,"_19":8496,"_8163":7756},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4634":8499,"_8160":4059,"_15":8497,"_8161":4059,"_19":8500,"_8163":7911},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4634":8503,"_8160":8504,"_15":8501,"_8161":4059,"_19":8505,"_8163":7911},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4634":8508,"_8160":4059,"_15":8506,"_8161":8509,"_19":8510,"_8163":7919},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4634":8513,"_8160":4059,"_15":8511,"_8161":4059,"_19":8514,"_8163":7729},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4634":8517,"_8160":4059,"_15":8515,"_8161":8518,"_19":8519,"_8163":7935},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4634":8522,"_8160":8523,"_15":8520,"_8161":4059,"_19":8524,"_8163":7729},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4634":8526,"_8160":8388,"_15":7939,"_8161":8527,"_19":8528,"_8163":7935},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4634":8531,"_8160":8532,"_15":8529,"_8161":4059,"_19":8533,"_8163":7935},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4634":8536,"_8160":4059,"_15":8534,"_8161":8537,"_19":8538,"_8163":7756},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4634":8541,"_8160":4059,"_15":8539,"_8161":8542,"_19":8543,"_8163":4059},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4634":8546,"_8160":4059,"_15":8544,"_8161":4059,"_19":8547,"_8163":7729},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4634":8550,"_8160":4059,"_15":8548,"_8161":4059,"_19":8551,"_8163":7756},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4634":8554,"_8160":8555,"_15":8552,"_8161":4059,"_19":8556,"_8163":7729},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4634":8559,"_8160":4059,"_15":8557,"_8161":8560,"_19":8561,"_8163":7756},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4634":8564,"_8160":4059,"_15":8562,"_8161":4059,"_19":8565,"_8163":7729},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4634":8568,"_8160":8569,"_15":8566,"_8161":8570,"_19":8571,"_8163":7756},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4634":8574,"_8160":4059,"_15":8572,"_8161":4059,"_19":8575,"_8163":7756},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4634":8578,"_8160":4059,"_15":8576,"_8161":4059,"_19":8579,"_8163":7756},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4634":8582,"_8160":8583,"_15":8580,"_8161":4059,"_19":8584,"_8163":7729},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4634":8587,"_8160":4059,"_15":8585,"_8161":4059,"_19":8588,"_8163":7756},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4634":8591,"_8160":4059,"_15":8589,"_8161":4059,"_19":8592,"_8163":7756},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4634":8595,"_8160":4059,"_15":8593,"_8161":4059,"_19":8596,"_8163":7756},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4634":8599,"_8160":8600,"_15":8597,"_8161":8601,"_19":8602,"_8163":7756},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4634":8605,"_8160":8606,"_15":8603,"_8161":4059,"_19":8607,"_8163":7729},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4634":8610,"_8160":8611,"_15":8608,"_8161":4059,"_19":8612,"_8163":7729},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4634":8615,"_8160":8616,"_15":8613,"_8161":4059,"_19":8617,"_8163":7729},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4634":8620,"_8160":8621,"_15":8618,"_8161":4059,"_19":8622,"_8163":7729},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4634":8625,"_8160":8626,"_15":8623,"_8161":4059,"_19":8627,"_8163":7729},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4634":8630,"_8160":8631,"_15":8628,"_8161":4059,"_19":8632,"_8163":7729},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4634":8635,"_8160":8636,"_15":8633,"_8161":4059,"_19":8637,"_8163":7729},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4634":8640,"_8160":8641,"_15":8638,"_8161":4059,"_19":8642,"_8163":7729},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4634":8645,"_8160":8646,"_15":8643,"_8161":4059,"_19":8647,"_8163":7729},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4634":8650,"_8160":8651,"_15":8648,"_8161":4059,"_19":8652,"_8163":7729},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4634":8655,"_8160":8656,"_15":8653,"_8161":4059,"_19":8657,"_8163":7729},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4634":8660,"_8160":8661,"_15":8658,"_8161":4059,"_19":8662,"_8163":7729},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4634":8665,"_8160":8666,"_15":8663,"_8161":4059,"_19":8667,"_8163":7729},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4634":8670,"_8160":8671,"_15":8668,"_8161":4059,"_19":8672,"_8163":7729},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7366":8675,"_6912":8684,"_6927":8686,"_6907":8688,"_7015":8690,"_6639":8692,"_7018":8694,"_7021":8696,"_7024":8698,"_7026":8699,"_5394":8701,"_7031":8703,"_5400":8704,"_7036":8705,"_7038":8707,"_7041":8708,"_7044":8709,"_7047":8710,"_7051":8712,"_7055":8713,"_6170":8714,"_7062":8715,"_7065":8716,"_7069":8717,"_7073":8718,"_7076":8719,"_7080":8720,"_7084":8722,"_7088":8723,"_7092":8725,"_7096":8727,"_7100":8729,"_7104":8730,"_7108":8732,"_7112":8734,"_7116":8735,"_7120":8737,"_7124":8739,"_7128":8741,"_7132":8743,"_7136":8746,"_7140":8749,"_7144":8752,"_7148":8755,"_7152":8756,"_7156":8758,"_7160":8759,"_7164":8760,"_7168":8762,"_7172":8764,"_7176":8765,"_7180":8767,"_7184":8769,"_7188":8771,"_7192":8773,"_7196":8775,"_7200":8777,"_7204":8779,"_7207":8781,"_7211":8783,"_7215":8785,"_7219":8786,"_7223":8788,"_7227":8789,"_7231":8790,"_7235":8791,"_7239":8792,"_7243":8793,"_7247":8794,"_7251":8795,"_7255":8796,"_7259":8797,"_7263":8798,"_7267":8799,"_7271":8800,"_7275":8801,"_7279":8802,"_7283":8803,"_7287":8804,"_7291":8805,"_7295":8806,"_7299":8807,"_7302":8808,"_7306":8809,"_7310":8810,"_7314":8811,"_7318":8812,"_7322":8813,"_7326":8815,"_7330":8816,"_7334":8817,"_8818":8819,"_8820":8821,"_8822":8823,"_8824":8825,"_8826":8827,"_8828":8829,"_8830":8831,"_8832":8833,"_8834":8835,"_8836":8837,"_8838":8839,"_8841":8842,"_8844":8845,"_8846":8847,"_8849":8850,"_8852":8853,"_8854":8855},{"_8676":37,"_8677":4059