":39,"_38":3904},5832,{"_36":55,"_38":3906},331,{"_36":58,"_38":37},{"_36":60,"_38":3909},1.48469387755102,{"_36":62,"_38":3911},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3931,"_101":64},{"_33":3932},[3933,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":3934},97,{"_36":41,"_38":3936},132.2730906795711,{"_36":44,"_38":3938},141.1079318325272,{"_36":47,"_38":3940},123.52030296654743,{"_36":50,"_38":3942},125.69114243635599,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},334,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3970,"_101":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},133.49737008205378,{"_36":44,"_38":3977},142.36839890595454,{"_36":47,"_38":3979},124.66736797811907,{"_36":50,"_38":3981},126.86618977487902,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},337,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4010,"_101":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},134.7216494845364,{"_36":44,"_38":4017},143.62886597938183,{"_36":47,"_38":4019},125.81443298969072,{"_36":50,"_38":4021},128.04123711340205,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},340,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_08","tag_17","tag_18","charId","charIllustInitPos",{"_4056":37,"_4057":37},"x","y","charPassiveUIPrefabName","","charTypeId","Physical","cvName",{"_4064":4065,"_4066":4067,"_4068":4069,"_4070":4071,"_4053":16},"ChiCVName","郭鸿博","EngCVName","Yung-I Chang","JapCVName","石桥阳彩","KorCVName","金润气","defaultWeaponId","wpn_lance_0009","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Lifeng","mainAttrType","phoneticName","profession","profileRecord",[4085,4096,4101,4106,4112,4117],{"_4053":16,"_15":4086,"_4087":4088,"_4089":4090,"_4091":39,"_4092":4093,"_4094":37,"_4095":37},"chr_0015_lifeng_1","recordDesc","【代号】黎风\n【性别】男\n【身份认证】宏山科学院\n【生日】7月16日\n【种族】阿纳萨\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：优良\n战术规划：普通\n源石技艺适应性：标准","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4097,"_4087":4098,"_4089":4099,"_4091":55,"_4092":4100,"_4094":37,"_4095":37},"chr_0015_lifeng_2","黎风，武陵城生人，择业期间志愿加入终末地工业，现于特种技术部门学习实践。\n\n这位青少年向我们展现出了一种超乎想象的淳朴和真诚——我很少能够在一张入职信息表上如此详尽地了解到一个人迄今为止的人生；甚至，出于维护隐私权的考量，我反而需要请他抹去一些私人信息。\n他笑容可掬，善解人意，作为实习生愿做的太多，能做的也很多。这无疑是每一个人事助理都乐见其成的场面。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4102,"_4087":4103,"_4089":4104,"_4091":58,"_4092":4105,"_4094":37,"_4095":37},"chr_0015_lifeng_3","在帝江号上忙碌的日常事务中，很少有人注意到一位新干员的加入，并且，黎风自己也毫无意向要达成某种轰动的效果。但他在登舰第三天就引起了一些关注——传言称，有个人在培养舱里晨练。大家赶赴现场，瞧见一个阿纳萨盘腿端坐于舱室地板上，闭合双眼，运气呼吸，不知道是眼花还是舱内培养皿的灯光所致，在场者竟然看到他周身浮现出一种微茫的柔和亮光——\n“因为他是萨卡兹的缘故，所以怎么都不奇怪，我称之为‘灵’！”\n“可能他用的是一种大炎的秘法？！我觉得是‘气’……”\n“不管怎么样，他往那儿一坐，就给人感觉……周围都安静了下来……像有种魔力，让人想脱口而出叫他一声‘小师父’……”\n“小师父？我觉得是陈千语昨天给我们看的那种，武侠片里的少侠！”\n“嘘，他好像回头看过来了！快、快躲起来……”\n随后便是一阵丁零当啷的动静，长枪在光照单元上错乱地划拉了好几下，劈开了控制组件的三个进出液口，在滚滚喷出的气体中，大家看见少年慌忙收拢姿态，拍散周围的白烟，立正站好：“对不起！我以为这里没有人使用！”\n原来还是个稚气未脱的小孩子。大家恍然大悟，但随后又疑惑起来：“你怎么做到看起来又年轻又老的？！”\n黎风露出了困惑的表情：“因为阿纳萨是一个古老又有智慧的种族，但我年纪还小……？”\n大家再次恍然大悟——好像有点道理，但又好像完全没有解释！\n\n小师父或者小少侠黎风身上这一种大家很少见过的，又老又新、又板正又柔软的奇妙反差，在众人与他逐渐亲近的相处过程中得到了进一步的验证。\n最先注意到黎风的能力的，是代理作战教官小道奇。在一番交手后，小道奇对黎风干员的枪法赞不绝口。在他提交的报告中，一向严厉的教官在黎风干员的多维测评中使用了极少见到的表述，“出枪速度迅于常人”“力量非常到位”“是不可多得的武才”，——“真想得知他的师承！”\n对此，黎风干员受宠若惊，表示自己在师父大潘面前只是班门弄斧。\n而大潘在大家百般追问和贿赂后才勉强透露，他自己天生不会带孩子，却被庄方宜委以教导黎风的重任。漫长的暑假里，面对这个精力充沛、死缠烂打、万事刨根问底的小子，索性随手甩了他六百多盘从宏山城的古董店淘来的社戏录像带，扔在自己店里，让他对着电视机坐一整天。没想到那小子还真看得入了迷，学进了心里去。一日，他在阳台上拿着晾衣杆子耍弄时，愣是给大潘瞧出了一个未来的好苗子。\n“低调、低调，”大潘摆摆肉手，“这小子现在也只学到武生皮毛。打起来是漂亮，可真正的战斗不靠花招儿。”\n“那靠啥呀？”\n“靠个‘会’字。跟人打，不是跟枪打。耍枪学的是枪谱，战斗要读的是对手。”\n“好玄奥啊，大潘老师。这个要怎么学？”\n“嗐，这事儿还真吃个性。您瞧着吧，黎风这孩子是耐得住的。他心细。”","CN_03","档案资料·一",{"_4053":16,"_15":4107,"_4087":4108,"_4089":4109,"_4091":64,"_4092":4110,"_4094":64,"_4095":4111},"chr_0015_lifeng_4","【终末地工业内部论坛发帖记录（一）】\n匿名用户981902#8090 23:15\n主题：有人知道新的牙刷去哪儿领吗？\n\n回复：匿名用户891107#3319 23:16\n宿舍浴室里都配好了，你抽屉里找找呗\n\n回复：匿名用户981902#8090 23:19\n抱歉，我自己用是够的，我是想给培养舱的刺绒球卉刷毛，它们好像很喜欢这个感觉。\n\n【终末地工业内部论坛发帖记录（二）】\n匿名用户981902#8090 00:19\n主题：睡不着咋办？明天一大早还要练武。\n正文：大家每天都要在塔卫二上到处跑，是怎么倒时差的？好厉害啊，也许我比较认床，陌生的枕头睡不着……\n\n回复：匿名用户18003#65137 00:25\n你怎么这么有精神……早上在我后面嘴里一直念念有词的人就是你吧……\n\n回复：匿名用户981902#8090 00:26\n极有可能！糟糕！我没吵到您吧？\n\n回复：匿名用户18003#65137 00:33\n铁索横江……怀中抱月……坐地问天什么的……听起来就很累……辛苦了……\n\n回复：匿名用户55698#2466 01:45\n刚收队回来才刷到这条！打架的时候当然要把招式喊出来呀！\n\n【终末地工业内部论坛发帖记录（三）】\n匿名用户41572#8828 12:38\n主题：我有个朋友在事故中失去了身体的一部分\n正文：我一直不知道怎么安慰她比较好，有人知道怎么办吗？虽然她安慰我说没事，但是大家还是很担心她。肯定有事啊，怎么会没事。不过，要怎么说才不会伤她的心？\n\n回复：匿名用户981902#8090 12:50\n以我的亲身经历来说，如果旁人当作无事发生一样对待我，我会知道他们在刻意压抑自己的看法，这会让我很难过。但如果旁人把这当作重要的事，并且特地照顾我，也会让我因为在意自己失去的那部分能力而难过。所以，这其实是一个很难处理的问题。最重要的其实是你和朋友关心彼此的心情，真诚地说出来就好。\n\n【终末地工业内部论坛发帖记录（四）】\n匿名用户601330#5207 10:01\n主题：市面上流通的三版《武典》中有些记述竟然相斥，究竟哪版才接近原版啊\n正文：最重要的是，其中没有一版是宏科院官方盖章的啊，出入也太大了吧。\n\n回复：匿名用户981902#8090 10:26\n正巧，我对长枪的使用和实战有些心得体会。先说我的看法，环塔商会印刷的三个版本都是假的，因为其中许多谬误简直匪夷所思。虽然每一版《武典》都有记载各类炎国枪法神技，比如“回天枪”“武陵梨花枪”，其中一版更是传出了古代天师能枪挑日月的夸张说法，却从来不见详实可信的描述和点评，配图只是一堆不知真假的大侠飞来飞去（详考泰拉蓝卡坞兴盛时期的电影业，说不定有不少是以讹传讹、化用假典）。反观终末地资料库中的《武典》，较之朴实无华，却有对枪法传人身份、师承的详细记录，甚至还有传承人自己批注的心得和意见。而且不仅民间武学，对炎国禁军、卡西米尔的银枪天马、维多利亚的破城矛持有者、卡兹戴尔的雇佣兵都有详细描摹。光是记录者包罗万象，却又能平视天下群雄的气度，就足够令人心生钦佩！作注的记述文字更是夯实遒劲，寥寥几笔就能栩栩如生。故此，我认为只有终末地资料库里的《武典》是泰拉时期的正本，大家平时能买到的无非都是些噱头仿品，真是可惜！\n\n回复：匿名用户601330#5207 10:28\n遇到真大侠了，改天线下请教请教？\n\n回复：匿名用户981902#8090 10:31\n那多不好意思！我也只是普通爱好者，一时脑热打下了这些发言，若有得罪，还请见谅！","CN_04","档案资料·二",300,{"_4053":16,"_15":4113,"_4087":4114,"_4089":4115,"_4091":66,"_4092":4116,"_4094":64,"_4095":4111},"chr_0015_lifeng_5","武陵的街坊邻居对于黎风前往终末地实习的选择反响不一。\n有的人真诚地为他高兴，比如眼看着他从毛头小子长大的老一辈们，都说年轻人到岁数了，是该出去闯一闯，长长见识。\n“要论德行，咱们武陵的孩子都是个顶个的优秀，特别是黎风，心里装着所有人的事儿，连白奶奶忘记什么时候吃哪种药，都会先打电话问一问黎风。”\n“大清早的，出来练武，他便会沿途把各家各户放在门口的垃圾袋一并收去垃圾站里。这就叫眼里有活儿！”\n也有的人为此难过，例如从小玩到大的同伴们。对于他们而言，黎风就是大院里的孩子王，没了他拿主意，大家心里总觉得少了一根主心骨。\n黎风安慰他们说，他即将要去实习的地方——终末地工业——和武陵有着密切的合作。想回来的时候，向管理员申请休假就行。\n即便如此，离别的焦虑还是搞得人心惶惶。\n那天日常安全预警演习，弭弗队长来了大院里，听到角落里孩子们的议论，硬邦邦地打断了他们：“想什么呢。肯定会回来的。心就在这儿，人能跑多远？”\n“真的吗？”\n“之前黎风从来没跟我们说过他要离开武陵呢，他明明那么喜欢这里。”\n“是啊，弭队长，他之前不是一直跟你说要加入巡卫队的吗？黎风去终末地那边也只是学习经验吧，肯定还会回来的！”\n“可是，在这里就很好啊，他为什么要走呢？”\n弭弗把嘴里的粑粑签子拿掉。一般这个时候，大家就知道她要认真起来了。\n“黎风是会给自己找麻烦的人。他闲不住。”\n“什么叫找麻烦？”\n“离开就是一件很麻烦的事。”\n“弭队长……没懂。”\n“呃，怎么说啊，”弭弗挠了挠头发，“就像穿鞋子。旧的鞋子穿着舒服，换新的鞋子，要适应，磨脚，还会流血。”\n“对啊，弭队长，那为什么要换新鞋子啊？”\n“我知道！是因为脚变大了。”\n“可是人不是长到一个岁数以后，脚就不会变大了吗？”\n“笨啊！为了走更远的路啊！”\n“呜哇，弭队长突然好大声，好可怕……”\n“……记住，离开是为了更好地回来。你们应该为他高兴。”\n\n对于黎风而言，前去一个从未亲眼见过的地方的决定，是突然诞生的。侵蚀潮涌来，他发现自己引以为傲的枪在它面前脆如白纸。\n他亲眼见过巨大的协议核心刺破云层，从天而降，落在他面前；又在一眨眼间，将所有的东西呈于眼前。在它面前，他发现自己很渺小，渺小得守护不了这一切；又发现自己太大，先前竟以为一直这样下去就可以保护大家。他就像被人从池子里抓起来扔进了大海。随后他想起，自己也不知道大海真正是什么样子，武陵是没有海的。\n所以，他要去看看海，看看天上，到世界里去。在那里他会变成更有力量的人，然后他会回来扛起他深爱的武陵，继续往前走。","CN_05","档案资料·三",{"_4053":16,"_15":4118,"_4087":4119,"_4089":4120,"_4091":68,"_4092":4121,"_4094":64,"_4095":4122},"chr_0015_lifeng_6","【一个陈旧的本子】\n（扉页上字迹歪歪扭扭，落款距今已有一段时间）\n潘叔说：枪是百兵之王，会了枪，别的便也能通。“月棍、年刀、一辈子的枪”，做人需得如枪般扎实，灵、巧、柔，急、快、利。\n切记，切记！（这几个字底下划了两条杠）\n…………\n持枪之势要敬。枪，要托离胸前，示其能，不怒而威。\n枪尖勿向己，只对敌。\n勿犯我近圈者，只拦，不刺。刺我者，便截。\n…………\n“青龙献爪”枪势\n招招能防，势势无逾，吃枪还枪，要自己稳了才能杀住对方。\n…………\n诈败（这两个字底下划了两条杠）得再练练！身后一倒，伪为败势，待敌扎刺，回身腾起，拿开敌枪。\n以退为进，这个好难啊。（这条是批注）\n…………\n基本功也得记得练，戳枪、扎枪每天各一百次，梅花桩、六合拳等科目须得日日做。三天不练己明，一周不练敌知，切记，切记！\n…………\n\n【宿舍墙上的数张粘贴物】\n第五届终末地工业办公室猜拳大赛，1/4决赛入围选手\n第二十四期终末地工业优秀员工评选，实习组“最佳合作员工”\n“出拳！宏山人”武术比赛终末地工业分赛场，第二名（参赛者共2人）\n武陵巡卫队第二期预备成员夏季训练营，“优秀营员”（往年获此殊荣者仅3人）\n\n【便签本中零散的记录】\n不知道手臂能不能放冰箱里降温，用多了有点热，下次问问那位后勤部门的老师\n从来没见过世界各地的这么多人，神奇神奇，不知道他们会不会觉得我的口音有点重啊\n有潘叔在的时候，食堂的菜好吃！！\n哦对了，安塔尔路过的时候告诉我，他把我上次从老家带来的特产甜膏当鞋油用了……没事儿，都哥们儿\n艾维文娜干员也是用长枪的好手，要向她讨教一番！以前没见过那样的长枪，哇（不要惹她）\n他们说管理员明天会来和我聊聊天，让我不要紧张。老天，好紧张，赶紧回想一下最近的表现！\n希望能留下希望能留下希望能留下希望能留下\n好好好终于通过了考核！！！明天拍正式照片的时候要冷静，不要傻笑，手记得插兜，想想摆个什么枪势，总之，黎风，你已经是正式干员了，别拖后腿！","CN_06","档案资料·四",1500,"profileVoice",[4125,4133,4137,4141,4145,4149,4153,4158,4163,4168,4173,4178,4183,4188,4193,4198,4203,4208,4213,4218,4223,4228,4233,4238,4243,4248,4253,4258,4263,4268,4273,4278,4283,4288,4293,4298,4303,4308,4313,4318,4323,4328,4333,4338,4343,4348,4353,4358,4363,4368,4373,4378,4383,4388,4393,4398,4403,4408,4413,4418,4423,4428,4433,4438,4443,4448,4453,4458,4463,4468,4473,4478,4483,4488,4493,4498,4503,4508,4513,4518,4523,4528,4533],{"_4053":16,"_15":4086,"_4094":37,"_4095":37,"_4126":4127,"_4128":4129,"_4130":39,"_4131":4132},"voId","chr_0015_lifeng_chrbark_squad_01","voiceDesc","管理员！这回我能派上用场了吗？","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4097,"_4094":37,"_4095":37,"_4126":4134,"_4128":4135,"_4130":55,"_4131":4136},"chr_0015_lifeng_chrbark_squad_02","哎，鞋带开了……管理员来了！不管了，立正！","行动准备2",{"_4053":16,"_15":4102,"_4094":37,"_4095":37,"_4126":4138,"_4128":4139,"_4130":58,"_4131":4140},"chr_0015_lifeng_chrbark_join_01","打击对象，在哪个方位？！——别紧张管理员，我就是预先演习一下。","编入队伍1",{"_4053":16,"_15":4107,"_4094":37,"_4095":37,"_4126":4142,"_4128":4143,"_4130":64,"_4131":4144},"chr_0015_lifeng_chrbark_join_02","正如潘叔老说的，闻鼓则进，断不能怯！","编入队伍2",{"_4053":16,"_15":4113,"_4094":37,"_4095":37,"_4126":4146,"_4128":4147,"_4130":66,"_4131":4148},"chr_0015_lifeng_chrbark_weap_01","练家子挑长枪，切勿盲追材质。趁手的，白蜡杆也能耍出花头！","更换武器",{"_4053":16,"_15":4118,"_4094":37,"_4095":37,"_4126":4150,"_4128":4151,"_4130":68,"_4131":4152},"chr_0015_lifeng_chrbark_gear_01","管理员，这些战术装备真的是给我的吗？这是不是说明，我也正式加入队伍了？！","更换装备",{"_4053":16,"_15":4154,"_4094":37,"_4095":37,"_4126":4155,"_4128":4156,"_4130":70,"_4131":4157},"chr_0015_lifeng_7","chr_0015_lifeng_chrup_skill_01","我来终末地就是为了学东西的！只是……这里的东西多得有点儿学不完啊……要加把劲！","激活天赋阵列",{"_4053":16,"_15":4159,"_4094":37,"_4095":37,"_4126":4160,"_4128":4161,"_4130":88,"_4131":4162},"chr_0015_lifeng_8","chr_0015_lifeng_chrup_level_01","潘叔也老叫我把练习的动作录下来回去揣摩。说真的，不看不知道，原来到处都是破绽！","观看作战记录",{"_4053":16,"_15":4164,"_4094":55,"_4095":39,"_4126":4165,"_4128":4166,"_4130":90,"_4131":4167},"chr_0015_lifeng_9","chr_0015_lifeng_chrup_promt01_01","呼，原、原来是晋升啊！我还以为叫我过来，是因为我犯了什么事儿……","精英化晋升1",{"_4053":16,"_15":4169,"_4094":55,"_4095":55,"_4126":4170,"_4128":4171,"_4130":410,"_4131":4172},"chr_0015_lifeng_10","chr_0015_lifeng_chrup_promt02_01","一回生二回熟，这回我完全知道了！管理员，我最近的表现是不是有望冲击本月“办公室座椅竞速比赛”的头名？！","精英化晋升2",{"_4053":16,"_15":4174,"_4094":55,"_4095":58,"_4126":4175,"_4128":4176,"_4130":100,"_4131":4177},"chr_0015_lifeng_11","chr_0015_lifeng_chrup_promt03_01","管理员，能不能透露一下，往上还有多少级啊？……我只是要更新日记本的内容，比如说——“本月目标”！","精英化晋升3",{"_4053":16,"_15":4179,"_4094":55,"_4095":64,"_4126":4180,"_4128":4181,"_4130":95,"_4131":4182},"chr_0015_lifeng_12","chr_0015_lifeng_chrup_promt04_01","“鉴于你近期优秀的表现”“在行动中展现了良好的适应性和合作能力”……这些话我都能背下来了！管理员，我已经做好了充分的准备，我会成为你最信任的伙伴。","精英化晋升4",{"_4053":16,"_15":4184,"_4094":37,"_4095":37,"_4126":4185,"_4128":4186,"_4130":527,"_4131":4187},"chr_0015_lifeng_13","chr_0015_lifeng_introduce_01","管理员，是我是我，我叫黎风！我还是个新手，您见笑了！我一直被教导，艰难困苦，玉汝于成！可我还在琢磨，到底怎么样才能算是“成”呢……变得像您这样吗？那么，能请您多指教吗？","干员报到",{"_4053":16,"_15":4189,"_4094":37,"_4095":37,"_4126":4190,"_4128":4191,"_4130":566,"_4131":4192},"chr_0015_lifeng_14","chr_0015_lifeng_mono_switch_01","手到擒来！","待命1",{"_4053":16,"_15":4194,"_4094":37,"_4095":37,"_4126":4195,"_4128":4196,"_4130":97,"_4131":4197},"chr_0015_lifeng_15","chr_0015_lifeng_mono_switch_02","交给我吧！","待命2",{"_4053":16,"_15":4199,"_4094":37,"_4095":37,"_4126":4200,"_4128":4201,"_4130":644,"_4131":4202},"chr_0015_lifeng_16","chr_0015_lifeng_sim_assign_work_01","收到，管理员！我刚刚还在琢磨你怎么这会儿才来找我呢！","进驻设施",{"_4053":16,"_15":4204,"_4094":37,"_4095":37,"_4126":4205,"_4128":4206,"_4130":684,"_4131":4207},"chr_0015_lifeng_17","chr_0015_lifeng_sim_hello_lower_01","管理员，你好忙啊！好难得见你一回！","打招呼1",{"_4053":16,"_15":4209,"_4094":64,"_4095":4111,"_4126":4210,"_4128":4211,"_4130":723,"_4131":4212},"chr_0015_lifeng_18","chr_0015_lifeng_sim_hello_max_01","管理员有空吗？我学了个新招，给你看看！","打招呼2",{"_4053":16,"_15":4214,"_4094":37,"_4095":37,"_4126":4215,"_4128":4216,"_4130":763,"_4131":4217},"chr_0015_lifeng_19","chr_0015_lifeng_sim_talk_lv01_01","咳……这种时候应该怎么说话呢……管理员，终末地正式干员黎风向您问好。","帝江号闲聊1",{"_4053":16,"_15":4219,"_4094":64,"_4095":4111,"_4126":4220,"_4128":4221,"_4130":802,"_4131":4222},"chr_0015_lifeng_20","chr_0015_lifeng_sim_talk_lv02_01","啊，你刚才就瞧见我了？……我没有在这里等任务啊，没有，嘿嘿……","帝江号闲聊2",{"_4053":16,"_15":4224,"_4094":64,"_4095":4111,"_4126":4225,"_4128":4226,"_4130":872,"_4131":4227},"chr_0015_lifeng_21","chr_0015_lifeng_sim_talk_lv02_02","管理员，你还认识别的阿纳萨吗？我们这一支好久以前就生活在城市里了，但我听说还有一些族人留在荒野里……下次你见到和我不一样的阿纳萨，叫我去看看！","帝江号闲聊3",{"_4053":16,"_15":4229,"_4094":64,"_4095":4122,"_4126":4230,"_4128":4231,"_4130":911,"_4131":4232},"chr_0015_lifeng_22","chr_0015_lifeng_sim_talk_max_01","其实我……会晕车，连武陵那种动力五轮车我都吃不消。但是在帝江号上站着，还真没感觉到自己在动呢。","帝江号闲聊4",{"_4053":16,"_15":4234,"_4094":64,"_4095":4122,"_4126":4235,"_4128":4236,"_4130":951,"_4131":4237},"chr_0015_lifeng_23","chr_0015_lifeng_sim_talk_max_02","用帝江号上的望远镜真的能看到息壤堰啊！就是很小，好像两根手指头就能夹起来……没想到那么大的东西，换个角度看就变得这么渺小。唔，我得去琢磨琢磨。","帝江号闲聊5",{"_4053":16,"_15":4239,"_4094":64,"_4095":4122,"_4126":4240,"_4128":4241,"_4130":989,"_4131":4242},"chr_0015_lifeng_24","chr_0015_lifeng_sim_talk_max_03","管理员，培养舱里的植物，一直都是有人专门照顾的吧？……有意思，它们竟然能在离地面这么远的地方生长。不过，我也没想到我会在这儿就是了。","帝江号闲聊6",{"_4053":16,"_15":4244,"_4094":37,"_4095":37,"_4126":4245,"_4128":4246,"_4130":62,"_4131":4247},"chr_0015_lifeng_25","chr_0015_lifeng_sim_gift_give_01","管理员，上次打游戏输给你的时候说好给你送的小礼物，嘿嘿，你快拿着！","赠送礼物",{"_4053":16,"_15":4249,"_4094":37,"_4095":37,"_4126":4250,"_4128":4251,"_4130":1067,"_4131":4252},"chr_0015_lifeng_26","chr_0015_lifeng_sim_gift_recv_01","这是大家都有的奖励？……专门给我的吗？！谢谢您，管理员！","接收礼物",{"_4053":16,"_15":4254,"_4094":37,"_4095":37,"_4126":4255,"_4128":4256,"_4130":1107,"_4131":4257},"chr_0015_lifeng_27","chr_0015_lifeng_mono_self_line01","管理员，您刚刚是在跟我说话吗？我……还没有走过汇报工作的流程。噢，只是聊聊天啊，好的，您想知道什么，我全都告诉您！","信赖对话1",{"_4053":16,"_15":4259,"_4094":64,"_4095":4111,"_4126":4260,"_4128":4261,"_4130":1146,"_4131":4262},"chr_0015_lifeng_28","chr_0015_lifeng_mono_self_line02","管理员，我从小就跟着潘叔习武，有一次大院着火了，我右肩扛起两个小孩，左肩上还架着一个，这么就往外冲！您看到上周的测试数据了吗？医疗部的老师说我就是胳膊腿儿细了点，出拳的力道不输别人！有敌人要打，千万记得叫上我！","信赖对话2",{"_4053":16,"_15":4264,"_4094":64,"_4095":4111,"_4126":4265,"_4128":4266,"_4130":1186,"_4131":4267},"chr_0015_lifeng_29","chr_0015_lifeng_mono_self_line03","管理员，我申请来终末地时，您读过弭长官、庄天师、潘叔给我写的证明信了吧？我当时求了好久，他们不太愿意让我出这么远的门。但是我心意已决，一定要出来历练一番。所以，不能浪费这个宝贵的机会，您就对我委以重任吧！……好，我这就去打扫动力舱！","信赖对话3",{"_4053":16,"_15":4269,"_4094":64,"_4095":4122,"_4126":4270,"_4128":4271,"_4130":56,"_4131":4272},"chr_0015_lifeng_30","chr_0015_lifeng_mono_self_line04","管理员亲自来邀请我？！咳，我将尽全力为行动小组分忧解难。我对战术布置已经有了些想法，这是我昨晚听你们提到后做出的五种预案。去哪里签字？……一般这种情况不需要签字吗？好的，就来。","信赖对话4",{"_4053":16,"_15":4274,"_4094":64,"_4095":4122,"_4126":4275,"_4128":4276,"_4130":1264,"_4131":4277},"chr_0015_lifeng_31","chr_0015_lifeng_mono_self_line05","接下来的旅程，我会成为您的左膀右臂！……扑哧，看您的表情，是不是觉得我在开自己的玩笑？哈哈，没关系的，我一定是一只能堪大任的“手臂”，有朝一日，我会扛起一切的。管理员，等我。","信赖对话5",{"_4053":16,"_15":4279,"_4094":37,"_4095":37,"_4126":4280,"_4128":4281,"_4130":1303,"_4131":4282},"chr_0015_lifeng_32","chr_0015_lifeng_mono_chat_line01","要不要跟我掰手腕？我可以玩这个玩一整天！","交谈1",{"_4053":16,"_15":4284,"_4094":37,"_4095":37,"_4126":4285,"_4128":4286,"_4130":117,"_4131":4287},"chr_0015_lifeng_33","chr_0015_lifeng_mono_chat_line02","管理员，给人送花这件事有一个诀窍，我教你。从一捧花里抽出来一朵，留在自己手里，这样等自己手里那朵花凋谢了，就知道送给对方的花也该换新的了。嘿嘿，这其实也是我自己悟出来的办法，不然爸爸妈妈墓前的花谢了，我总是没法及时换新的。","交谈2",{"_4053":16,"_15":4289,"_4094":37,"_4095":37,"_4126":4290,"_4128":4291,"_4130":1381,"_4131":4292},"chr_0015_lifeng_34","chr_0015_lifeng_mono_chat_line03","终末地的大家伙儿，好像都有点害羞。比如说，我发现有几位干员很好奇我每天早上在房门口打的那套宏山拳法，他们会偷偷跟在我后面，学我沉肩运劲……但我一回头他们就跑掉了。后来，队伍越来越长，我至今都没问过他们的名字……","交谈3",{"_4053":16,"_15":4294,"_4094":37,"_4095":37,"_4126":4295,"_4128":4296,"_4130":1421,"_4131":4297},"chr_0015_lifeng_35","chr_0015_lifeng_mono_chat_line04","这只手没了的时候我还很小，那时候也不知道痛不痛的事儿，就记得……进医院的那一刻是春天，走出来的时候，又是春天了，但是……好像有些东西再也长不出来了。","交谈4",{"_4053":16,"_15":4299,"_4094":37,"_4095":37,"_4126":4300,"_4128":4301,"_4130":156,"_4131":4302},"chr_0015_lifeng_36","chr_0015_lifeng_mono_chat_line05","管理员，我这回出来这么远，不知道老家那群朋友们怎么样了。街坊邻里的大小事我都记得很清楚：白奶奶什么时候要去按摩腰；刘巡卫的腿下雨天要换药；李阿姨要做红烧肉，每周三都得买酱油；小然去采样总是忘记带手套；阿仔做小本生意，月初总是要找我借点儿“本金”……下次联系他们的时候，我得把每个人都问候一圈！","交谈5",{"_4053":16,"_15":4304,"_4094":37,"_4095":37,"_4126":4305,"_4128":4306,"_4130":1499,"_4131":4307},"chr_0015_lifeng_37","chr_0015_lifeng_mono_about_line01","我这只义肢，在庄天师没空的时候，都是潘叔帮我养护的。他在机械啊，工程啊那些事情上，可是一把好手！只是不知道他为什么要解甲归田……管理员，偷偷告诉你，我看过老照片，潘叔早年风光得很——蹬着五轮车！机车服、大墨镜、爆炸头！据说在宏山科学院的时候，他操着一把菜刀就能从环带砍到开拓区……想不到吧？","话题：大潘",{"_4053":16,"_15":4309,"_4094":37,"_4095":37,"_4126":4310,"_4128":4311,"_4130":1538,"_4131":4312},"chr_0015_lifeng_38","chr_0015_lifeng_mono_about_line02","我小时候经常去庄天师的实验室写作业。她有空的时候，就帮我调整手臂的参数，只是每次调着调着就睡着了……她的屋子其实都是我帮着收拾的。她真的太忙了，没时间做这些琐事……她把整个武陵都扛在肩上呢。","话题：庄方宜",{"_4053":16,"_15":4314,"_4094":37,"_4095":37,"_4126":4315,"_4128":4316,"_4130":41,"_4131":4317},"chr_0015_lifeng_39","chr_0015_lifeng_mono_about_line03","虽然弭长官不让我们这么说，但是她其实很善良。她见到我，总是丢给我几块钱，让我去田老姨的摊上替她买一串糖油粑粑。她会把粑粑全部捋下来给我吃——光是叼着那根小竹签，她就一副很满足的样子。","话题：弭弗",{"_4053":16,"_15":4319,"_4094":37,"_4095":37,"_4126":4320,"_4128":4321,"_4130":44,"_4131":4322},"chr_0015_lifeng_40","chr_0015_lifeng_mono_about_line04","我们武陵人要活下去，从小就得跟这东西斗智斗勇。以前在天师桩阵列没完工的时候，我们都不敢靠近未知的水源。大人们吓唬我们说，沾上天使，它们就会从家里的管道、地砖缝里爬出来……嗐，我们都习惯了。不过，我也是来了终末地，才知道原来世界上还有其他模样的天使……","话题：天使",{"_4053":16,"_15":4324,"_4094":37,"_4095":37,"_4126":4325,"_4128":4326,"_4130":47,"_4131":4327},"chr_0015_lifeng_41","chr_0015_lifeng_mono_about_line05","爸爸妈妈说，我们的祖上在跨越星门前，不是像在塔卫二这样生活在城市里的。他们在炎国移动城市边缘的荒漠和草原游荡，以天为被，以地为席，与世界一道生与灭。现在想来，他们反复对我提起这些传说，是为了告诉我，哪怕有一天他们的“实在”离开了，也会以另一种样子，回到我的身边。所以，我早就……不想念他们了。","话题：阿纳萨",{"_4053":16,"_15":4329,"_4094":37,"_4095":37,"_4126":4330,"_4128":4331,"_4130":50,"_4131":4332},"chr_0015_lifeng_42","chr_0015_lifeng_mono_about_line06","你们现在看到的武陵，历史也不算长呢——就和我这只手差不多岁数！在这么短的时间里，它就变成了塔卫二上数一数二好的地方，是不是特别神奇？但是，就算它变得再快，我都能记住每一块砖的位置。我现在闭上眼睛，都能回想起下雨的阴天，街上那股湿漉漉的味道。","话题：武陵科学发展区",{"_4053":16,"_15":4334,"_4094":37,"_4095":37,"_4126":4335,"_4128":4336,"_4130":232,"_4131":4337},"chr_0015_lifeng_43","chr_0015_lifeng_mono_about_line07","说到这个，我还没去过宏科院本部呢！爸爸妈妈当年是从那边过来的，和庄天师、潘叔他们一块儿。我……也没太想过去宏山这事儿，那边没有一个我认识的人……听说那里全是聪明脑袋打架，我有点担心他们看不上我……","话题：宏山",{"_4053":16,"_15":4339,"_4094":37,"_4095":37,"_4126":4340,"_4128":4341,"_4130":1801,"_4131":4342},"chr_0015_lifeng_44","chr_0015_lifeng_explore_point_common_01","走路留心脚边的好东西！","发现资源1",{"_4053":16,"_15":4344,"_4094":37,"_4095":37,"_4126":4345,"_4128":4346,"_4130":1841,"_4131":4347},"chr_0015_lifeng_45","chr_0015_lifeng_explore_point_valub_01","那东西好稀罕！我们上那边看看去？","发现资源2",{"_4053":16,"_15":4349,"_4094":37,"_4095":37,"_4126":4350,"_4128":4351,"_4130":270,"_4131":4352},"chr_0015_lifeng_46","chr_0015_lifeng_explore_find_locked_01","这条路你认识吗？我们好像还没走过。","发现未探索区域",{"_4053":16,"_15":4354,"_4094":37,"_4095":37,"_4126":4355,"_4128":4356,"_4130":1919,"_4131":4357},"chr_0015_lifeng_47","chr_0015_lifeng_explore_find_danger_01","敌人！让我来，让我去！","发现强敌",{"_4053":16,"_15":4359,"_4094":37,"_4095":37,"_4126":4360,"_4128":4361,"_4130":72,"_4131":4362},"chr_0015_lifeng_48","chr_0015_lifeng_interact_mine_valub_01","课本上讲过这些东西！是不是很值钱啊？","采集矿物1",{"_4053":16,"_15":4364,"_4094":37,"_4095":37,"_4126":4365,"_4128":4366,"_4130":60,"_4131":4367},"chr_0015_lifeng_49","chr_0015_lifeng_interact_mine_valub_echo2_01","举手之劳！","采集矿物2",{"_4053":16,"_15":4369,"_4094":37,"_4095":37,"_4126":4370,"_4128":4371,"_4130":76,"_4131":4372},"chr_0015_lifeng_50","chr_0015_lifeng_interact_treasure_valub_01","捡到这么好的东西，是不是要上交给巡卫啊……","打开储藏箱",{"_4053":16,"_15":4374,"_4094":37,"_4095":37,"_4126":4375,"_4128":4376,"_4130":78,"_4131":4377},"chr_0015_lifeng_51","chr_0015_lifeng_interact_etherium_01","老师说，野外飘浮的醚质其实很安全，只是不要追得太深。","获得醚质",{"_4053":16,"_15":4379,"_4094":37,"_4095":37,"_4126":4380,"_4128":4381,"_4130":80,"_4131":4382},"chr_0015_lifeng_52","chr_0015_lifeng_interact_blight_break_01","武陵的孩子从小就跟侵蚀打交道，小事儿，交给我！","消除侵蚀",{"_4053":16,"_15":4384,"_4094":37,"_4095":37,"_4126":4385,"_4128":4386,"_4130":82,"_4131":4387},"chr_0015_lifeng_53","chr_0015_lifeng_interact_rest_01","好像全身涌过一股暖流……我得起来热热身，活动活动！","休整",{"_4053":16,"_15":4389,"_4094":37,"_4095":37,"_4126":4390,"_4128":4391,"_4130":84,"_4131":4392},"chr_0015_lifeng_54","chr_0015_lifeng_combat_suppuse_using_01","全都给你，快好起来啊！","使用战术物品1",{"_4053":16,"_15":4394,"_4094":37,"_4095":37,"_4126":4395,"_4128":4396,"_4130":86,"_4131":4397},"chr_0015_lifeng_55","chr_0015_lifeng_combat_suppuse_getheal_01","我喘口气儿，马上就好！","使用战术物品2",{"_4053":16,"_15":4399,"_4094":37,"_4095":37,"_4126":4400,"_4128":4401,"_4130":2266,"_4131":4402},"chr_0015_lifeng_56","chr_0015_lifeng_combat_remind_danger_01","哇啊啊，快闪开！","危险提醒",{"_4053":16,"_15":4404,"_4094":37,"_4095":37,"_4126":4405,"_4128":4406,"_4130":2306,"_4131":4407},"chr_0015_lifeng_57","chr_0015_lifeng_combat_hurt_lowhp_01","还能坚持，还能坚持……","负伤",{"_4053":16,"_15":4409,"_4094":37,"_4095":37,"_4126":4410,"_4128":4411,"_4130":422,"_4131":4412},"chr_0015_lifeng_58","chr_0015_lifeng_combat_dead_01","要是我足够强大……","力竭",{"_4053":16,"_15":4414,"_4094":37,"_4095":37,"_4126":4415,"_4128":4416,"_4130":2384,"_4131":4417},"chr_0015_lifeng_59","chr_0015_lifeng_combat_remind_praise_01","怎么做到的？教教我！","小队激励1",{"_4053":16,"_15":4419,"_4094":37,"_4095":37,"_4126":4420,"_4128":4421,"_4130":74,"_4131":4422},"chr_0015_lifeng_60","chr_0015_lifeng_combat_remind_praise_02","大开眼界了！我也不能落后！","小队激励2",{"_4053":16,"_15":4424,"_4094":37,"_4095":37,"_4126":4425,"_4128":4426,"_4130":2493,"_4131":4427},"chr_0015_lifeng_61","chr_0015_lifeng_combat_remind_praise_echo2_01","嘿嘿，别夸我了吧……","回应激励1",{"_4053":16,"_15":4429,"_4094":37,"_4095":37,"_4126":4430,"_4128":4431,"_4130":461,"_4131":4432},"chr_0015_lifeng_62","chr_0015_lifeng_combat_remind_praise_echo2_02","三人行必有我师，我们有四个人！","回应激励2",{"_4053":16,"_15":4434,"_4094":37,"_4095":37,"_4126":4435,"_4128":4436,"_4130":2571,"_4131":4437},"chr_0015_lifeng_63","chr_0015_lifeng_combat_intobattle_01","晚辈武陵城黎风，失礼了！","作战开始1",{"_4053":16,"_15":4439,"_4094":37,"_4095":37,"_4126":4440,"_4128":4441,"_4130":2610,"_4131":4442},"chr_0015_lifeng_64","chr_0015_lifeng_combat_intobattle_echo2_01","谅他们接不住我这枪！","作战开始2",{"_4053":16,"_15":4444,"_4094":37,"_4095":37,"_4126":4445,"_4128":4446,"_4130":499,"_4131":4447},"chr_0015_lifeng_65","chr_0015_lifeng_combat_outbattle_nor_01","这一架打得痛快极了！","作战胜利1",{"_4053":16,"_15":4449,"_4094":37,"_4095":37,"_4126":4450,"_4128":4451,"_4130":2688,"_4131":4452},"chr_0015_lifeng_66","chr_0015_lifeng_combat_outbattle_nor_02","呀，这就结束了？我还有几招没使……","作战胜利2",{"_4053":16,"_15":4454,"_4094":37,"_4095":37,"_4126":4455,"_4128":4456,"_4130":2728,"_4131":4457},"chr_0015_lifeng_67","chr_0015_lifeng_combat_outbattle_nor_echo2_01","叫他们好好瞧瞧！","作战胜利3",{"_4053":16,"_15":4459,"_4094":37,"_4095"