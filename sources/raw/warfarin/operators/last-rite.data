38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4011,"_101":64},{"_33":4012},[4013,4015,4017,4019,4021,4023,4025,4027,4028,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048],{"_36":37,"_38":4014},99,{"_36":41,"_38":4016},168.6804123711345,{"_36":44,"_38":4018},113.90103092783502,{"_36":47,"_38":4020},102.43298969072164,{"_36":50,"_38":4022},118.8000000000003,{"_36":39,"_38":4024},6000,{"_36":55,"_38":4026},363,{"_36":58,"_38":37},{"_36":60,"_38":4029},1.5,{"_36":62,"_38":2052},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":66},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4051,4052],"tag_07","tag_14","charId","charIllustInitPos",{"_4056":95,"_4057":4058},"x","y",-192,"charPassiveUIPrefabName","","charTypeId","Cryst","cvName",{"_4065":4066,"_4067":4068,"_4069":4070,"_4071":4072,"_4053":16},"ChiCVName","闲踏梧桐","EngCVName","Amber Hood","JapCVName","白石晴香","KorCVName","李耳掳","defaultWeaponId","wpn_claym_0010","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Last Rite","mainAttrType","phoneticName","profession","profileRecord",[4086,4097,4102,4107,4113,4118],{"_4053":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0026_lastrite_1","recordDesc","【代号】别礼\n【性别】女\n【身份认证】塞什卡\n【生日】11月12日\n【种族】萨卡兹\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：标准\n战术规划：普通\n源石技艺适应性：■■\n\n【后勤干员记录】\n别礼小姐在测试过程中意外造成了一些训练设备的损坏。对于后勤部门而言，这是合理的损耗范畴，不如说，其他干员例行检查时损坏的会更多。所以，请替我们转告别礼小姐，她没有必要再往后勤部门递手写道歉信，也请她不要再躲着后勤干员们了。\n\n【权限记录】\n阿德尔海德本人的源石技艺水平只能算作优秀。但是，当这位食腐者害羞地摆弄死亡时，在场很多人都在那道帷幕后看见了另一道阴影。很冷，很古老，很浩荡，也很……平静。我感到很不安，虽然Maze老师让我放心……塞什卡到底隐瞒了什么？","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0026_lastrite_2","干员别礼，本名阿德尔海德，塞什卡特派品牌形象代言人。经巫术时刻高级商业顾问“筑桥者”弗莱明引荐，现划归特种技术部门管理。\n\n如果是第一次与别礼接触，请考虑使用轻松、友善的发言方式，并对其暂时的沉默或回避行为予以理解和容忍。别礼很不擅长与陌生人社交，不过，准备一些甜点或小零食能有效推进信任的构建进程。\n请尽量避免在她慌乱时过于靠近，这很危险。同时，你因此受到的任何意外伤害都只会让她更加慌乱。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0026_lastrite_3","“实习任务很成功，她比我们想象中还要投入。另外，麻烦商务办公室争取和塞什卡方面再沟通一下，对着野兽和天使念广告词没有任何意义，但这孩子真的让做什么就做什么。”\n\n“我们很高兴别礼干员能帮忙处理堆积许久的杂项工作，不过还是请各位想想办法说服她，食堂伙食按需供应，不用担心加餐要额外收费。”\n\n“定制款应急融冰喷雾已经上架，数量充足，随意取用。话说回来，既然别礼一紧张就爱冒冷气，你们倒是少逗她几次。”\n\n“别礼干员和康复中心的许多外来病人相处得还不错，她似乎也觉得参与志愿服务能缓解自己的压力（你们应该反省一下为什么她会有压力）。另外，请不要在患者面前随意提及她的守墓人身份，这没有必要，而且会让解释工作变得很麻烦。”\n\n…………\n\n人力资源事务部的干员合上留言板，对着无比紧张，似乎想整个躲进脚边垃圾桶的少女露出笑容：“大家都觉得您相当好相处，不用这么焦虑啦。”","CN_03","档案资料·一",{"_4053":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":4112},"chr_0026_lastrite_4","最初，“勇者之家”的孩子们经常取笑阿德尔海德：大家不太认识这个住得很远的姑娘，她腼腆内向，衣服土里土气，反应慢几拍，聊什么都接不上茬儿。“大个子”汤姆曾经带头说了她不少坏话，想要把她赶出孩子们的秘密基地，而汤姆收手的原因有两个：大人们好像很尊重收养阿德尔海德的那对卡普里尼夫妇，以及，就算委屈得泪眼汪汪，她竟然还没忘记往嘴里塞芜菁叶帮子和苹果皮。\n\n变故发生在一个难熬的夏天。那个六月暴雨倾盆，洪水泛滥，匪帮好不容易才被赶走，留下了五个痛失至亲的家庭。懵懂的孩子们跟着队伍来到郊外，在小山上看到了让他们倍感陌生的阿德尔海德。他们看着少女和家人一起清理场地，擦洗墓碑，为死者送上最后一首挽歌。直到棺椁真正封入土地，孩子们才意识到汤姆已经永远不会再来“勇者之家”了。\n比起悲伤，恐慌和无所适从更快地蔓延开来。他们不能接受命运仓促的安排，不能理解要如何才能填补空出的位置。就在这时，阿德尔海德拿出了一个粗糙的木雕玩偶，将它放在汤姆坟前。玩偶很简陋，被切得歪歪扭扭、表面坑洼，连木屑都没来得及擦去。\n他一直想要一个竞技骑士玩偶，少女说，这是汤姆最后的愿望。\n大人们忍不住再次哭泣，哀叹一条无辜生命的早早逝去。\n孩子们只能憋笑，因为那个木雕根本就不像竞技骑士。\n总归还是笑了。\n他们各自拿出收藏的骑士卡，研究怎样才能把造型刻得更像一些。少女依然不太跟得上话题，动手的任务也被更心灵手巧的同伴接过，但他们每年都会把更新、更好的玩偶交给她，在她的带领下进入墓园，完成慰问仪式。\n汤姆就在这里，少女每次都这样保证。\n没有人知道她为什么如此笃定，没有人知道她当初为什么了解汤姆的愿望，没有人在乎那些道理。\n\n后来，阿德尔海德还是没有变得外向，她依旧不太擅长表达自己，肚子咕咕叫时，也还是会羞得想要钻到地里去。但是，如果新来的孩子们开始议论墓园那位偶尔在荒草丛间哼唱的古怪姑娘，就会有人搭上他们的肩膀，请他们听几个小故事。","CN_04","档案资料·二",300,{"_4053":16,"_15":4114,"_4088":4115,"_4090":4116,"_4092":66,"_4093":4117,"_4095":64,"_4096":4112},"chr_0026_lastrite_5","阿德尔海德第一次感受到了文化冲击。\n塞什卡，“歇脚地”，巫术之都，萨卡兹的纽带，浪客的聚集地……她已经听过无数个有关它的名字，但直到走下热气球，亲自踏上那片地面，她才发现，“能够飞行”只是这片奇迹之地最最微不足道的一点儿小特色。\n这里简直就是一场永远都在进行的狂欢节。骚动几乎镌刻在了每一丝空气里，广场中央造型奔放的装饰熔炉喷涌着热浪，将吵闹和欢笑一同高高抛起。各种古怪商铺的门面在几条街争夺每一寸空间，人群接踵摩肩，往嘴里塞着叫不出名字的食物，流向远方一片连绵的招摇巨影——据说那里除了角斗场，还有塞什卡在开放时间为游客精心准备的萨卡兹风情观光区，但如果整个空间本身已经足够像个游乐园，专门划出一片区域的意义似乎非常微小。\n阿德尔海德的肚子又开始叫了。\n也许答应那位行商的邀请并不是个好主意。她当然听说过“巫术时刻”，但从来都买不起这家企业的任何一件商品。在老家，驱赶野兽只需要一把笤帚就足够了，武器和她的距离就像小镇到这里的路途一样遥远。仅仅只是帮忙把被天使掀翻的货车翻过来，值得对方介绍这里的工作机会吗？归根结底，她又能在这里做什么？\n行商正在远处办理登记手续，和专员说着一条又一条听不懂的东西。她突然意识到，除了自己的确是一个萨卡兹，她几乎对萨卡兹一无所知。那位高大健壮的佣兵是歌利亚吗？那位先生尖耳朵上的挂饰代表着什么？她不知道。她很饿，行商解释过，这也是种族特征之一，但明白知识没能解决任何问题。不如说，按照萨卡兹的标准，一直坚持不去“进食”的她也许才是最没有资格来这座城市的离经叛道者。\n肚子叫得更厉害了。每当感到害怕无助，冲动总是趁虚而入，让她更难压抑自己。比平时更糟糕的是，如果这时有人来问话，她该怎么回答？“对不起，我只是不想好好当个食腐者”？\n现在还有逃走的机会，那位行商应该还会经过小镇，之后再好好和他道歉吧。或者，至少先找个地方躲起来，让周围若有若无的注视再少一些……\n“你怎么啦？”\n一个声音把她从愈加黏腻的焦虑感中拽了回来。男孩侧着头，眼神比起疑惑更像是好奇：“那边有免费面包，和看门的叔叔说一声就可以拿。还有招工小册子，也不要钱。”\n“不……对不起，我没事。”她控制呼吸，尽量平复自己声音中的颤抖，“我在等人。”\n“哦，好吧。”男孩吸了吸鼻子，“总之别担心，这里机会多，会有办法的。我也花了两个礼拜呢。”\n这个小大人好像不太相信自己的说辞。阿德尔海德想了想，却没有开口辩解。对方的神情似乎有种奇特的魔力，让自己心中的担忧变轻了一些。\n男孩拍了拍她的肩膀，随后便重新汇入身旁一处人群。那里似乎不是游客的聚集点，工人围着脚手架挥汗如雨，商人皱着眉头写写画画，几位西装革履的体面人和佣兵勾搭在一起，似乎刚从酒桌上下来。大家看起来十分忙碌，却同样洋溢着和那个男孩一样让人放松的气氛：机会够多，总会有办法的。\n她看到男孩跑向那群佣兵，骂骂咧咧地替他们收拢武器，像牧童一样推着一群半醉的傻大个从金主身边挪往旅店。男孩的尾巴又短又尖，和她养父母的很像。\n少女突然想起了行商在热气球上说的一句话：“因为到处都是有困难的萨卡兹，我们让它飞了起来。可是，当它飞起来之后，你会看到，有困难的一定不止萨卡兹。”\n在成为一座飞空游乐园之前，“塞什卡”是一座开拓据点。不管被多少传奇围绕，被附加多少定义，一个面对未知、建立新家园的开拓据点不会阻止生命寻找自己的道路。它不需要是所有人的家，它只需要是一个“歇脚地”，这就足够了。\n于是，在十多分钟的心惊胆战之后，阿德尔海德终于开始有精力把目光放到街头那些堆积如山、闪耀着油光的烤牧兽肉排上。\n很咸，咸得心脏怦怦跳。","CN_05","档案资料·三",{"_4053":16,"_15":4119,"_4088":4120,"_4090":4121,"_4092":68,"_4093":4122,"_4095":64,"_4096":4123},"chr_0026_lastrite_6","“为什么？”\n大名鼎鼎的塞什卡高级商业顾问，“巫术时刻”品牌主理人之一，可怜的萨卡兹商人，“筑桥者”弗莱明，被这个无比简单的问题而吓了一跳。尽管感到莫名其妙，但他很快调整好了状态，理了理领带，数着窗外的星星进入对话。\n面对眼前的菲林，他总是和多年前的那个大雪纷飞的夜晚同样，感到一种奇妙的紧张。\n“咳，首先……感谢终末地接纳了阿德尔海德，塞什卡向各位表达谢意。”\n“那你付一下额外的伙食费吧。”\n“相信我，派遣她来终末地对我们来说已经是亏本生意了。”\n“哦？别礼小姐不是那个什么……‘战争王庭的公主’吗？这噱头可不算小，有得赚吧？”\n弗莱明笑了起来。放在平时，这种笑声是与对手周旋的一种手段，而现在，更像是给自己喘口气的机会。\nM3没有理会弗莱明，只是看着办公室外坐立不安的阿德尔海德——也就是别礼本人。弗莱明察觉到了这份好奇，他不能放过重新把握话题的机会。\n“您对别礼小姐怎么看？”\n“饥饿。”M3的眼没有离开别礼，在弗莱明的记忆里，这个据说和卡兹戴尔渊源不浅的菲林，其实很少这样打量他介绍来的人才，“你怎么能让这么可爱的姑娘饿肚子？”\n“我发誓……”\n“你还是得多付终末地一笔伙食费，不如就定……”\n“我发誓这是最好的办法！”\n弗莱明立刻察觉到了自己的失态。对方只是在插科打诨……不对，只是在友善地开着玩笑，自己怎么能急眼呢？\n“那是为什么？”\n“唉……您知道，一位食腐者，待在墓园，还有强烈的‘进食羞耻’……不愿意触碰他人的死亡，会时时刻刻感到饥饿，是理所当然的事情。”\n“不对……不对……”\nM3依然是那副优哉游哉的语气，但真正让弗莱明倍感压力的是，从抵达帝江号开始，他就没见过她的笑容。\n“您是了解萨卡兹的。再多烤肉排也填补不了一个空虚的灵魂。”\n“你是相信灵魂的那种人？”\n“咳咳……曾受众魂庇护的萨卡兹当然会相信灵魂。”\n“那众魂知道一定会很高兴的。”M3终于把目光从别礼身上挪开，她难得地犹豫了，但对于弗莱明而言依然不是个好信号，“时间对不上。”\n“我知道……那是一百多年前的事儿了。阿德尔海德是货真价实的十七八岁的小姑娘。”\n“所以，是为什么？”\n弗莱明在内心苦笑了起来。但他决定坦诚回答这个问题。\n“我不知道。但就像您说的……她依然很饿。”\n“即使有‘那个玩意儿’跟着她？闻所未闻。”\n弗莱明有些惊讶，真正的惊讶：“还会有您闻所未闻的事情？”\n话出口，弗莱明就有些后悔。好在M3并没有什么闲情逸致去把他的失言理解为一种挑衅。\n“已经有一片浩大的土地死在了她的影子里，几十个世纪的寒冬都在听从她的差遣，她却仍然感到饥饿。”\n“血统。我们寻找过其他食腐者，这颗星球每天会诞生那么多死亡，我们可不敢由着第二个战争王庭凭空出现。但是……这孩子明显是个特例。她从未‘进食’过，因为她觉得那些死在开拓区的工人、信使、战士，都是值得尊敬的人。她不忍心，也不愿意。”\n“那她的力量又是怎么……”\n“您认识的那位温迪戈是这么评价的：‘她没有吞吃任何的死亡来壮大自己，即使死亡会心甘情愿地协助她。’”\n“……孽茨雷要是在这儿一定会很感动吧。”\n“可是，这也意味着那孩子注定要承担许多不该由她背负的东西。”\n“这才是你把她引荐给了终末地的原因。”\n“如果阿德尔海德本人希望走她自己认定的路，我想终末地工业会是她最好的老师。”\nM3明显愣了一下。然后弗莱明也愣了一下。他明白，M3没有想到他会给出这么……温柔的答案。但弗莱明也没想到M3对他的评价如此之低，令身为商人和顾问的他略感沮丧。\n“嗯……也许你比我想的更热心肠，弗莱明。”\n弗莱明又有了点信心。\n“这是认识这么多年，您对我最好的评价，M3女士。”\nM3叹了口气，她似乎终于放松了一些：“那么，你希望终末地怎么对待她？”\n“就和现在一样。”弗莱明也笑了，这一次是发自真心的，“让她去做她愿意做的事，像一个普通的孩子那样，努力生活，遇到一些挫折，得到一些成长，赚几个子儿养活自己。最好还能收获几位知己，找到自己的人生目标……”\n“你把她当女儿了？”\n“哈，那我可配不上。”弗莱明也把目光放向窗外，阿德尔海德正因为干员们的搭话而开始晕头转向。\n“但在塔卫二把人类逼上绝境前，在死亡为她砌好那座血肉模糊的王座前，在塔卫二被迫出现下一位食腐者之王前……她也只是个怕生的萨卡兹小姑娘而已。”","CN_06","档案资料·四",1500,"profileVoice",[4126,4134,4138,4142,4146,4150,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4434,4439,4444,4449,4454,4459,4464,4469,4474,4479,4484,4489,4494,4499,4504,4509,4514,4519,4524,4529],{"_4053":16,"_15":4087,"_4095":37,"_4096":37,"_4127":4128,"_4129":4130,"_4131":39,"_4132":4133},"voId","chr_0026_lastrite_chrbark_squad_01","voiceDesc","要出发了？再、再等我一下……","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4098,"_4095":37,"_4096":37,"_4127":4135,"_4129":4136,"_4131":55,"_4132":4137},"chr_0026_lastrite_chrbark_squad_02","行动手册里写的是——马、马上就好！","行动准备2",{"_4053":16,"_15":4103,"_4095":37,"_4096":37,"_4127":4139,"_4129":4140,"_4131":58,"_4132":4141},"chr_0026_lastrite_chrbark_join_01","到、到我出场了吗？","编入队伍1",{"_4053":16,"_15":4108,"_4095":37,"_4096":37,"_4127":4143,"_4129":4144,"_4131":64,"_4132":4145},"chr_0026_lastrite_chrbark_join_02","别礼，准备出击！……是要出击了对吧？","编入队伍2",{"_4053":16,"_15":4114,"_4095":37,"_4096":37,"_4127":4147,"_4129":4148,"_4131":66,"_4132":4149},"chr_0026_lastrite_chrbark_weap_01","没问题，只要够沉就行！","更换武器",{"_4053":16,"_15":4119,"_4095":37,"_4096":37,"_4127":4151,"_4129":4152,"_4131":68,"_4132":4153},"chr_0026_lastrite_chrbark_gear_01","欸？这个型号没见过啊……我、我再翻一下说明书……","更换装备",{"_4053":16,"_15":4155,"_4095":37,"_4096":37,"_4127":4156,"_4129":4157,"_4131":70,"_4132":4158},"chr_0026_lastrite_7","chr_0026_lastrite_chrup_skill_01","我一定会用自己的方式战斗下去！","激活天赋阵列",{"_4053":16,"_15":4160,"_4095":37,"_4096":37,"_4127":4161,"_4129":4162,"_4131":88,"_4132":4163},"chr_0026_lastrite_8","chr_0026_lastrite_chrup_level_01","呜哇！对不起，刚、刚才被画面吓到了……","观看作战记录",{"_4053":16,"_15":4165,"_4095":55,"_4096":39,"_4127":4166,"_4129":4167,"_4131":90,"_4132":4168},"chr_0026_lastrite_9","chr_0026_lastrite_chrup_promt01_01","晋升？！真、真的可以吗？！","精英化晋升1",{"_4053":16,"_15":4170,"_4095":55,"_4096":55,"_4127":4171,"_4129":4172,"_4131":411,"_4132":4173},"chr_0026_lastrite_10","chr_0026_lastrite_chrup_promt02_01","爸爸，妈妈，我做到了……","精英化晋升2",{"_4053":16,"_15":4175,"_4095":55,"_4096":58,"_4127":4176,"_4129":4177,"_4131":100,"_4132":4178},"chr_0026_lastrite_11","chr_0026_lastrite_chrup_promt03_01","承命，在下一定赴汤蹈火、肝脑涂地——嗯？您的表情好怪啊？","精英化晋升3",{"_4053":16,"_15":4180,"_4095":55,"_4096":64,"_4127":4181,"_4129":4182,"_4131":95,"_4132":4183},"chr_0026_lastrite_12","chr_0026_lastrite_chrup_promt04_01","我发现，留在这里可以帮助许多人过得更好。如果塞什卡的合约到期了，您也可以继续找我……啊，这个不可以讲的，要、要对其他人保密哦！","精英化晋升4",{"_4053":16,"_15":4185,"_4095":37,"_4096":37,"_4127":4186,"_4129":4187,"_4131":528,"_4132":4188},"chr_0026_lastrite_13","chr_0026_lastrite_introduce_01","塞什卡特派干员，向、向您报到……啊啊啊忘记说名字了！我的代号是“别礼”，您叫我这个就好……","干员报到",{"_4053":16,"_15":4190,"_4095":37,"_4096":37,"_4127":4191,"_4129":4192,"_4131":567,"_4132":4193},"chr_0026_lastrite_14","chr_0026_lastrite_mono_switch_01","还得继续练习控制力量……","待命1",{"_4053":16,"_15":4195,"_4095":37,"_4096":37,"_4127":4196,"_4129":4197,"_4131":97,"_4132":4198},"chr_0026_lastrite_15","chr_0026_lastrite_mono_switch_02","希望这些战斗能带来安宁。","待命2",{"_4053":16,"_15":4200,"_4095":37,"_4096":37,"_4127":4201,"_4129":4202,"_4131":645,"_4132":4203},"chr_0026_lastrite_16","chr_0026_lastrite_sim_assign_work_01","明白！我会十倍……不，一百二十倍加油的！","进驻设施",{"_4053":16,"_15":4205,"_4095":37,"_4096":37,"_4127":4206,"_4129":4207,"_4131":685,"_4132":4208},"chr_0026_lastrite_17","chr_0026_lastrite_sim_hello_lower_01","管理员？！您、您好呀……","打招呼1",{"_4053":16,"_15":4210,"_4095":64,"_4096":4112,"_4127":4211,"_4129":4212,"_4131":724,"_4132":4213},"chr_0026_lastrite_18","chr_0026_lastrite_sim_hello_max_01","有需要帮忙的吗，管理员？","打招呼2",{"_4053":16,"_15":4215,"_4095":37,"_4096":37,"_4127":4216,"_4129":4217,"_4131":764,"_4132":4218},"chr_0026_lastrite_19","chr_0026_lastrite_sim_talk_lv01_01","自信大方……自信大方……嘿！管理员！……今、今天的餐后甜点很棒呢！","帝江号闲聊1",{"_4053":16,"_15":4220,"_4095":64,"_4096":4112,"_4127":4221,"_4129":4222,"_4131":803,"_4132":4223},"chr_0026_lastrite_20","chr_0026_lastrite_sim_talk_lv02_01","好多人啊，要是他们搭话……果、果然还是储物箱比较适合我吧？","帝江号闲聊2",{"_4053":16,"_15":4225,"_4095":64,"_4096":4112,"_4127":4226,"_4129":4227,"_4131":874,"_4132":4228},"chr_0026_lastrite_21","chr_0026_lastrite_sim_talk_lv02_02","您、您知道哪里可以申请报损吗？我又把训练室砸坏了……","帝江号闲聊3",{"_4053":16,"_15":4230,"_4095":64,"_4096":4123,"_4127":4231,"_4129":4232,"_4131":913,"_4132":4233},"chr_0026_lastrite_22","chr_0026_lastrite_sim_talk_max_01","呜……能扶我一下吗，我想去拿点压缩饼干……没事，我就是……有点……肚子饿……","帝江号闲聊4",{"_4053":16,"_15":4235,"_4095":64,"_4096":4123,"_4127":4236,"_4129":4237,"_4131":953,"_4132":4238},"chr_0026_lastrite_23","chr_0026_lastrite_sim_talk_max_02","随身听、万用工具箱、简易施术单元……啊，这是购物清单啦。有些东西在我老家挺难买的，后勤办事处有几位前辈肯帮我顺路捎一些，他们人实在太好了！","帝江号闲聊5",{"_4053":16,"_15":4240,"_4095":64,"_4096":4123,"_4127":4241,"_4129":4242,"_4131":992,"_4132":4243},"chr_0026_lastrite_24","chr_0026_lastrite_sim_talk_max_03","管理员，我能在帝江号上发小广告吗？塞什卡给我塞了好多推广任务，再不完成的话，又要被抓去特训了……","帝江号闲聊6",{"_4053":16,"_15":4245,"_4095":37,"_4096":37,"_4127":4246,"_4129":4247,"_4131":62,"_4132":4248},"chr_0026_lastrite_25","chr_0026_lastrite_sim_gift_give_01","管、管理员！小小礼物不成敬意，请请请请笑纳！对不起，我、我不知道怎么说比较好……","赠送礼物",{"_4053":16,"_15":4250,"_4095":37,"_4096":37,"_4127":4251,"_4129":4252,"_4131":1070,"_4132":4253},"chr_0026_lastrite_26","chr_0026_lastrite_sim_gift_recv_01","送我的？管理员？没骗人？！这……居然——我、我腿有点软……","接收礼物",{"_4053":16,"_15":4255,"_4095":37,"_4096":37,"_4127":4256,"_4129":4257,"_4131":1110,"_4132":4258},"chr_0026_lastrite_27","chr_0026_lastrite_mono_self_line01","嘿、嘿嘿……管理员，新蓝卡坞真的有全用糖果做的屋子吗？能不能批准我请假去住几天呀？放心，我肯定能吃回本的，一点都不浪费！什么？竟然只是旅游广告吗……","信赖对话1",{"_4053":16,"_15":4260,"_4095":64,"_4096":4112,"_4127":4261,"_4129":4262,"_4131":1149,"_4132":4263},"chr_0026_lastrite_28","chr_0026_lastrite_mono_self_line02","黑眼圈？哦，我最近在学习急救护理的知识，还去参加了作物病害防治的基础培训，睡得有点少……不过，很值得呀！如果只会拿剑砍东西，这里有很多忙我都帮不上，肯定是不行的！但、但是医疗法术的课实在太难学了……","信赖对话2",{"_4053":16,"_15":4265,"_4095":64,"_4096":4112,"_4127":4266,"_4129":4267,"_4131":1189,"_4132":4268},"chr_0026_lastrite_29","chr_0026_lastrite_mono_self_line03","“别礼”这个代号是巫术时刻替我决定的。我之前一直在家里当守墓人，又是食腐者，他们觉得要“强调商品特色”……可我又不是商品，衣服才是呀！而且，送别是件很严肃的事情，不应该用来开玩笑！管理员，要、要不，您再帮我给他们写封信抗议一下？","信赖对话3",{"_4053":16,"_15":4270,"_4095":64,"_4096":4123,"_4127":4271,"_4129":4272,"_4131":56,"_4132":4273},"chr_0026_lastrite_30","chr_0026_lastrite_mono_self_line04","其实，我现在大概知道他们为什么会笑话我一直要让自己“饿肚子”了。但是，使用食腐者本身的力量，还是会打扰到死者吧？就算几率再小，也是不可以的……而且那些巫术知识好复杂，我还没搞懂啦。所以，不用就是最安全的！","信赖对话4",{"_4053":16,"_15":4275,"_4095":64,"_4096":4123,"_4127":4276,"_4129":4277,"_4131":1267,"_4132":4278},"chr_0026_lastrite_31","chr_0026_lastrite_mono_self_line05","管理员，有件事，不管怎样我都想和您说。那、那就是……塞什卡把我包装过度了！“战争王庭公主”什么的，根本只是他们乱套的名头。我不想骗您，所以还是让我辞——您、您一直都知道？！真的没关系吗？","信赖对话5",{"_4053":16,"_15":4280,"_4095":37,"_4096":37,"_4127":4281,"_4129":4282,"_4131":1306,"_4132":4283},"chr_0026_lastrite_32","chr_0026_lastrite_mono_chat_line01","我也好想像其他干员那样用剑啊。他们的动作都好有章法，但我跟着他们学发力，就很容易把剑甩出去，只能凭感觉乱挥……这样也很好看吗？我、我不太清楚欸，谢谢？","交谈1",{"_4053":16,"_15":4285,"_4095":37,"_4096":37,"_4127":4286,"_4129":4287,"_4131":117,"_4132":4288},"chr_0026_lastrite_33","chr_0026_lastrite_mono_chat_line02","很多种族都有“死后有灵”的说法呢。爸爸妈妈教了我很多种祈祷的方法，在老家墓园的时候，我每天都会全部做一遍。嗯，我知道萨卡兹以前有一种“死魂灵”，听说它们会钻进各种东西里，让空壳动起来……您是打算讲恐怖故事吧！不要！我不听！","交谈2",{"_4053":16,"_15":4290,"_4095":37,"_4096":37,"_4127":4291,"_4129":4292,"_4131":1384,"_4132":4293},"chr_0026_lastrite_34","chr_0026_lastrite_mono_chat_line03","为什么大家都这么喜欢捉弄我呢？老家的孩子天天喊我“贪吃鬼”“迷糊大王”，这里的前辈们也老是给我起外号。怎样才能让我更有气势一点呢……对了，您觉得我用这个样子说话怎么样？和管理员一样戴上面具！造型太吓人了？好吧……","交谈3",{"_4053":16,"_15":4295,"_4095":37,"_4096":37,"_4127":4296,"_4129":4297,"_4131":1424,"_4132":4298},"chr_0026_lastrite_35","chr_0026_lastrite_mono_chat_line04","我也参加了干员的标准测试哦。体能测试我可擅长了！但是技能测试那一块……总、总之，最后是佩丽卡监督同意让我通过的，我已经在好好补课啦！她说悬空城上给我合同的那位先生是想保护我，虽然不是很懂，但她说的肯定没错！","交谈4",{"_4053":16,"_15":4300,"_4095":37,"_4096":37,"_4127":4301,"_4129":4302,"_4131":1463,"_4132":4303},"chr_0026_lastrite_36","chr_0026_lastrite_mono_chat_line05","塞什卡一直在保存萨卡兹的知识和巫术道具，但塔卫二上的食腐者非常少，许多族内传承的战争技术都没法考证了。听学者们说，泰拉战场上的食腐者会吸收死去同伴的力量，让战争不断延续……我们应该不用这么做了，对吧？虽然我身上的寒气很难控制，一不小心就会乱冒，但我觉得……果然还是它更适合我一点。","交谈5",{"_4053":16,"_15":4305,"_4095":37,"_4096":37,"_4127":4306,"_4129":4307,"_4131":156,"_4132":4308},"chr_0026_lastrite_37","chr_0026_lastrite_mono_about_line01","塞什卡的教官说，正常的食腐者需要使用巫术才能操纵冰霜，而不是像我这样一个劲儿冒寒气。我好像也更能忍耐吸收死亡的冲动，就是肚子更容易饿……没问题的，我消耗大，最近天天吃夜宵，体重还掉了一点——咦？管、管理员，刚才大家是不是都在瞪我？","话题：天赋力量",{"_4053":16,"_15":4310,"_4095":37,"_4096":37,"_4127":4311,"_4129":4312,"_4131":1541,"_4132":4313},"chr_0026_lastrite_38","chr_0026_lastrite_mono_about_line02","衣服的样子很少见？这是巫术时刻的测试款啦。他们好像很希望我穿着它战斗，好收集一些……嗯，实验数据？我明明不那么擅长战斗的，不知道哪里合他们心意了……总之，这套衣服很厉害的！又轻又牢固，洗完澡还会自动帮忙吹头发哦！就是战斗模式的使用说明好厚，好难背……","话题：作战装备",{"_4053":16,"_15":4315,"_4095":37,"_4096":37,"_4127":4316,"_4129":4317,"_4131":41,"_4132":4318},"chr_0026_lastrite_39","chr_0026_lastrite_mono_about_line03","在我家墓园下葬的每一个人我都记得。寿终的老先生、夭折的宝宝、外地来的佣兵大姐、得了“石头病”的陌生人……每个人都有遗愿，送行的人会告诉我们，我……也能感受到。他们其实没指望谁能帮忙实现愿望，只是想把它说出来。我能做的，就是记住这些遗愿。妈妈说，留恋也是一个人活过的证明。","话题：亡者",{"_4053":16,"_15":4320,"_4095":37,"_4096":37,"_4127":4321,"_4129":4322,"_4131":44,"_4132":4323},"chr_0026_lastrite_40","chr_0026_lastrite_mono_about_line04","巫术时刻经常要给作战服做调整，所以我经常去那座悬空城喔！它不靠近城市的时候，游览设施都会被收起来，其实还挺安静的。介绍我过来的行商先生说，塞什卡带着佣兵和巫术工匠们在文明环带巡游，是想联系和帮助各地的萨卡兹同胞。可我总觉得他们也没少在里面找机会赚钱啊……","话题：塞什卡",{"_4053":16,"_15":4325,"_4095":37,"_4096":37,"_4127":4326,"_4129":4327,"_4131":47,"_4132":4328},"chr_0026_lastrite_41","chr_0026_lastrite_mono_about_line05","爸爸说过，很久以前，环塔商会带人来老家打了好几口井。刚刚有个前辈告诉我，原来那是终末地帮忙牵头做的！有了井之后，老家新搬来了好几户人家，行商也开始往那儿去了。我就是听了他们的话，才知道可以去塞什卡碰碰运气，然后才认识了终末地的各位。嘿嘿，这算不算一种缘分呀？","话题：缘分",{"_4053":16,"_15":4330,"_4095":37,"_4096":37,"_4127":4331,"_4129":4332,"_4131":50,"_4132":4333},"chr_0026_lastrite_42","chr_0026_lastrite_mono_about_line06","从很小很小的时候开始，我偶尔能听到有个声音和我说话。她好像很累，也很困，大部分时间都在睡觉。墓园里没有她的孩子们，那些人好像在更北边……每当我肚子饿的时候，她就会抱着我，让我好受一点。不过最近几年，她越来越累，睡着的时间也越来越长，如果能做些什么帮帮她就好了……","话题：“朋友”",{"_4053":16,"_15":4335,"_4095":37,"_4096":37,"_4127":4336,"_4129":4337,"_4131":1766,"_4132":4338},"chr_0026_lastrite_43","chr_0026_lastrite_explore_point_common_01","那些物资，要去收集一下吗？","发现资源1",{"_4053":16,"_15":4340,"_4095":37,"_4096":37,"_4127":4341,"_4129":4342,"_4131":232,"_4132":4343},"chr_0026_lastrite_44","chr_0026_lastrite_explore_point_valub_01","那、那边有好东西……对吧？我没看错吧？","发现资源2",{"_4053":16,"_15":4345,"_4095":37,"_4096":37,"_4127":4346,"_4129":4347,"_4131":1844,"_4132":4348},"chr_0026_lastrite_45","chr_0026_lastrite_explore_find_locked_01","作战服有反应欸，那边有什么异常状况吗？","发现未探索区域",{"_4053":16,"_15":4350,"_4095":37,"_4096":37,"_4127":4351,"_4129":4352,"_4131":1883,"_4132":4353},"chr_0026_lastrite_46","chr_0026_lastrite_explore_find_danger_01","小心！那个敌人看起来好厉害！","发现强敌",{"_4053":16,"_15":4355,"_4095":37,"_4096":37,"_4127":4356,"_4129":4357,"_4131":270,"_4132":4358},"chr_0026_lastrite_47","chr_0026_lastrite_interact_mine_valub_01","武、武库那边，不会有意见吧？","采集矿物1",{"_4053":16,"_15":4360,"_4095":37,"_4096":37,"_4127":4361,"_4129":4362,"_4131":72,"_4132":4363},"chr_0026_lastrite_48","chr_0026_lastrite_interact_mine_valub_echo2_01","我力气大，让我来吧。","采集矿物2",{"_4053":16,"_15":4365,"_4095":37,"_4096":37,"_4127":4366,"_4129":4367,"_4131":60,"_4132":4368},"chr_0026_lastrite_49","chr_0026_lastrite_interact_treasure_valub_01","哇……从、从来没见过这么多好东西……","打开储藏箱",{"_4053":16,"_15":4370,"_4095":37,"_4096":37,"_4127":4371,"_4129":4372,"_4131":76,"_4132":4373},"chr_0026_lastrite_50","chr_0026_lastrite_interact_etherium_01","好漂亮……啊，没什么！收集工作完成了！","获得醚质",{"_4053":16,"_15":4375,"_4095":37,"_4096":37,"_4127":4376,"_4129":4377,"_4131":78,"_4132":4378},"chr_0026_lastrite_51","chr_0026_lastrite_interact_blight_break_01","我没把脏东西溅出去吧？","消除侵蚀",{"_4053":16,"_15":4380,"_4095":37,"_4096":37,"_4127":4381,"_4129":4382,"_4131":80,"_4132":4383},"chr_0026_lastrite_52","chr_0026_lastrite_interact_rest_01","需、需要冷饮吗？我可以帮忙冰镇一点……","休整",{"_4053":16,"_15":4385,"_4095":37,"_4096":37,"_4127":4386,"_4129":4387,"_4131":82,"_4132":4388},"chr_0026_lastrite_53","chr_0026_lastrite_combat_suppuse_using_01","我来帮忙了！","使用战术物品1",{"_4053":16,"_15":4390,"_4095":37,"_4096":37,"_4127":4391,"_4129":4392,"_4131":84,"_4132":4393},"chr_0026_lastrite_54","chr_0026_lastrite_combat_suppuse_getheal_01","活、活过来了……","使用战术物品2",{"_4053":16,"_15":4395,"_4095":37,"_4096":37,"_4127":4396,"_4129":4397,"_4131":86,"_4132":4398},"chr_0026_lastrite_55","chr_0026_lastrite_combat_remind_danger_01","快、快躲开！有危险！","危险提醒",{"_4053":16,"_15":4400,"_4095":37,"_4096":37,"_4127":4401,"_4129":4402,"_4131":2269,"_4132":4403},"chr_002