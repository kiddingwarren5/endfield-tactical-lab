>","nar.left",{"_15":7978,"_7549":7980,"_7552":7981},[7888,7888,7888],[7982,7982,7982],"<align=\"left\">","nar.mark",{"_15":7983,"_7549":7985,"_7552":7987},[7986,7986,7986],"</color></mark>",[7988,7989,7988],"<mark=#444444><color=#44444400>","<mark=#E6E6E6><color=#E6E6E600>","qu.largenumdown",{"_15":7990,"_7549":7992,"_7552":7994},[7993,7993,7993],"</color></size>",[7995,7995,7995],"<size=54><color=#e74414>","nar.quote",{"_15":7996,"_7549":7998,"_7552":8000},[7999,7999,7999],"</i>",[8001,8001,8001],"<i>","nar.right",{"_15":8002,"_7549":8004,"_7552":8005},[7888,7888,7888],[8006,8006,8006],"<align=\"right\">","opt.key",{"_15":8007,"_7549":8009,"_7552":8010},[7551,7551,7551],[8011,8011,8011],"<color=#5ECDFF>","qu.numdown",{"_15":8012,"_7549":8014,"_7552":8015},[7551,7551,7551],[8016,8016,8016],"<color=#e74414>","toast_craft.key",{"_15":8017,"_7549":8019,"_7552":8020},[7551,7551,7551],[7604,7604,7605],"qu.numup",{"_15":8021,"_7549":8023,"_7552":8024},[7551,7551,7551],[8025,8025,8025],"<color=#c7fe02>","rac.tec",{"_15":8026,"_7549":8028,"_7552":8029},[7551,7551,7551],[8030,8030,8030],"<color=#FFCC00>","scene_grade.down",{"_15":8031,"_7549":8033,"_7552":8034},[7551,7551,7551],[8035,8035,8035],"<color=#D12E42>","set.key",{"_15":8036,"_7549":8038,"_7552":8039},[7551,7551,7551],[8040,8040,8040],"<color=#A7A7A7>","tech.get",{"_15":8041,"_7549":8043,"_7552":8044},[7551,7551,7551],[8045,8045,8045],"<color=#1e1e1e>","tips.key",{"_15":8046,"_7549":8048,"_7552":8049},[7551,7551,7551],[8050,8051,8050],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":8052,"_7549":8054,"_7552":8055},[7551,7551,7551],[7839,7840,7841],"toast_focal.key",{"_15":8056,"_7549":8058,"_7552":8059},[7551,7551,7551],[8051,8051,8051],"weapon.stress",{"_15":8060,"_7549":8062,"_7552":8063},[7551,7551,7551],[8064,8064,8064],"<color=#fe5a00>","weekraid.key",{"_15":8065,"_7549":8067,"_7552":8068},[7708,7708,7708],[8069,8069,8070],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_8073":8074,"_8080":8081,"_7762":8085,"_8090":8091,"_8094":8095,"_8099":8100,"_8103":8104,"_8108":8109,"_8112":8113,"_8117":8118,"_8121":8122,"_7577":8126,"_8131":8132,"_8135":8136,"_8140":8141,"_8145":8146,"_8149":8150,"_8154":8155,"_7660":8158,"_8163":8164,"_8167":8168,"_8173":8174,"_7666":8177,"_8182":8183,"_8186":8187,"_7684":8191,"_8196":8197,"_8200":8201,"_7691":8205,"_8210":8211,"_8216":8217,"_7715":8221,"_8226":8227,"_8231":8232,"_8236":8237,"_8241":8242,"_7722":8246,"_8250":8251,"_8255":8256,"_8260":8261,"_8264":8265,"_8270":8271,"_8275":8276,"_7752":8280,"_8285":8286,"_8290":8291,"_8293":8294,"_8297":8298,"_8302":8303,"_8306":8307,"_8312":8313,"_8316":8317,"_8321":8322,"_8326":8327,"_7769":8331,"_8335":8336,"_8338":8339,"_7789":8343,"_8347":8348,"_8352":8353,"_8357":8358,"_8362":8363,"_8366":8367,"_8371":8372,"_7589":8377,"_7628":8381,"_8386":8387,"_8391":8392,"_8396":8397,"_7815":8401,"_8406":8407,"_8409":8410,"_8413":8414,"_8417":8418,"_8422":8423,"_8427":8428,"_8431":8432,"_8436":8437,"_7855":8441,"_8445":8446,"_8450":8451,"_8455":8456,"_8459":8460,"_8463":8464,"_8467":8468,"_8472":8473,"_8477":8478,"_8481":8482,"_8487":8488,"_8491":8492,"_8495":8496,"_8500":8501,"_8504":8505,"_8508":8509,"_8512":8513,"_8518":8519,"_8523":8524,"_8528":8529,"_8533":8534,"_8538":8539,"_8543":8544,"_8548":8549,"_8553":8554,"_8558":8559,"_8563":8564,"_8568":8569,"_8573":8574,"_8578":8579,"_8583":8584},"adv.electricFence",{"_4630":8075,"_8076":4060,"_15":8073,"_8077":4060,"_19":8078,"_8079":7645},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4630":8082,"_8076":8083,"_15":8080,"_8077":4060,"_19":8084,"_8079":7698},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4630":8086,"_8076":8087,"_15":7762,"_8077":8088,"_19":8089,"_8079":7827},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4630":8092,"_8076":4060,"_15":8090,"_8077":4060,"_19":8093,"_8079":7645},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4630":8096,"_8076":8097,"_15":8094,"_8077":4060,"_19":8098,"_8079":7645},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4630":8101,"_8076":4060,"_15":8099,"_8077":4060,"_19":8102,"_8079":7645},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4630":8105,"_8076":8106,"_15":8103,"_8077":4060,"_19":8107,"_8079":7739},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4630":8110,"_8076":4060,"_15":8108,"_8077":4060,"_19":8111,"_8079":7645},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4630":8114,"_8076":8115,"_15":8112,"_8077":4060,"_19":8116,"_8079":7645},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4630":8119,"_8076":4060,"_15":8117,"_8077":4060,"_19":8120,"_8079":4060},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4630":8123,"_8076":8124,"_15":8121,"_8077":4060,"_19":8125,"_8079":7698},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4630":8127,"_8076":8128,"_15":7577,"_8077":8129,"_19":8130,"_8079":7827},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4630":8133,"_8076":4060,"_15":8131,"_8077":4060,"_19":8134,"_8079":7645},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4630":8137,"_8076":8138,"_15":8135,"_8077":4060,"_19":8139,"_8079":7645},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4630":8142,"_8076":8143,"_15":8140,"_8077":4060,"_19":8144,"_8079":7645},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4630":8147,"_8076":4060,"_15":8145,"_8077":4060,"_19":8148,"_8079":7672},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4630":8151,"_8076":8152,"_15":8149,"_8077":4060,"_19":8153,"_8079":7645},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4630":8156,"_8076":4060,"_15":8154,"_8077":4060,"_19":8157,"_8079":7672},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4630":8159,"_8076":8160,"_15":7660,"_8077":8161,"_19":8162,"_8079":7739},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4630":8165,"_8076":8160,"_15":8163,"_8077":4060,"_19":8166,"_8079":7739},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4630":8169,"_8076":8170,"_15":8167,"_8077":8171,"_19":8172,"_8079":7672},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4630":8175,"_8076":4060,"_15":8173,"_8077":4060,"_19":8176,"_8079":7672},"持续时间内，受影响的目标暂停行动。","定身",{"_4630":8178,"_8076":8179,"_15":7666,"_8077":8180,"_19":8181,"_8079":7851},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4630":8184,"_8076":8179,"_15":8182,"_8077":4060,"_19":8185,"_8079":7851},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4630":8188,"_8076":4060,"_15":8186,"_8077":8189,"_19":8190,"_8079":4060},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4630":8192,"_8076":8193,"_15":7684,"_8077":8194,"_19":8195,"_8079":7801},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4630":8198,"_8076":8193,"_15":8196,"_8077":4060,"_19":8199,"_8079":7801},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4630":8202,"_8076":8203,"_15":8200,"_8077":4060,"_19":8204,"_8079":7645},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4630":8206,"_8076":8207,"_15":7691,"_8077":8208,"_19":8209,"_8079":7827},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4630":8212,"_8076":8213,"_15":8210,"_8077":8214,"_19":8215,"_8079":7672},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4630":8218,"_8076":8219,"_15":8216,"_8077":4060,"_19":8220,"_8079":7672},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4630":8222,"_8076":8223,"_15":7715,"_8077":8224,"_19":8225,"_8079":7698},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4630":8228,"_8076":4060,"_15":8226,"_8077":8229,"_19":8230,"_8079":7698},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4630":8233,"_8076":8234,"_15":8231,"_8077":4060,"_19":8235,"_8079":7645},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4630":8238,"_8076":8239,"_15":8236,"_8077":4060,"_19":8240,"_8079":7645},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4630":8243,"_8076":8244,"_15":8241,"_8077":4060,"_19":8245,"_8079":7698},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4630":8247,"_8076":8083,"_15":7722,"_8077":8248,"_19":8249,"_8079":7698},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4630":8252,"_8076":4060,"_15":8250,"_8077":8253,"_19":8254,"_8079":7672},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4630":8257,"_8076":8258,"_15":8255,"_8077":4060,"_19":8259,"_8079":7645},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4630":8262,"_8076":4060,"_15":8260,"_8077":4060,"_19":8263,"_8079":4060},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4630":8266,"_8076":8267,"_15":8264,"_8077":8268,"_19":8269,"_8079":7672},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4630":8272,"_8076":8273,"_15":8270,"_8077":4060,"_19":8274,"_8079":7645},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4630":8277,"_8076":4060,"_15":8275,"_8077":8278,"_19":8279,"_8079":7739},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4630":8281,"_8076":8282,"_15":7752,"_8077":8283,"_19":8284,"_8079":7739},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4630":8287,"_8076":8288,"_15":8285,"_8077":4060,"_19":8289,"_8079":7645},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4630":8165,"_8076":8282,"_15":8290,"_8077":4060,"_19":8292,"_8079":7739},"干员受到灼热附着","sys.tacticalItem",{"_4630":8295,"_8076":4060,"_15":8293,"_8077":4060,"_19":8296,"_8079":7645},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4630":8299,"_8076":8300,"_15":8297,"_8077":4060,"_19":8301,"_8079":7739},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4630":8184,"_8076":8304,"_15":8302,"_8077":4060,"_19":8305,"_8079":7851},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4630":8308,"_8076":8309,"_15":8306,"_8077":8310,"_19":8311,"_8079":7672},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4630":8314,"_8076":4060,"_15":8312,"_8077":4060,"_19":8315,"_8079":7672},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4630":8318,"_8076":8319,"_15":8316,"_8077":4060,"_19":8320,"_8079":7827},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4630":8323,"_8076":8324,"_15":8321,"_8077":4060,"_19":8325,"_8079":7851},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4630":8328,"_8076":8329,"_15":8326,"_8077":4060,"_19":8330,"_8079":7672},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4630":8332,"_8076":8333,"_15":7769,"_8077":8224,"_19":8334,"_8079":7698},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4630":8082,"_8076":8333,"_15":8335,"_8077":4060,"_19":8337,"_8079":7698},"干员受到冻结","ba.naturalvul",{"_4630":8340,"_8076":8341,"_15":8338,"_8077":4060,"_19":8342,"_8079":7801},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4630":8127,"_8076":8344,"_15":7789,"_8077":8345,"_19":8346,"_8079":7827},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4630":8349,"_8076":8350,"_15":8347,"_8077":4060,"_19":8351,"_8079":7645},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4630":8354,"_8076":8355,"_15":8352,"_8077":4060,"_19":8356,"_8079":7645},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4630":8359,"_8076":8360,"_15":8357,"_8077":4060,"_19":8361,"_8079":7645},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4630":8364,"_8076":4060,"_15":8362,"_8077":4060,"_19":8365,"_8079":7645},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4630":8368,"_8076":4060,"_15":8366,"_8077":8369,"_19":8370,"_8079":4060},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4630":8373,"_8076":8374,"_15":8371,"_8077":8375,"_19":8376,"_8079":7672},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4630":8378,"_8076":4060,"_15":7589,"_8077":8379,"_19":8380,"_8079":7801},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4630":8382,"_8076":8383,"_15":7628,"_8077":8384,"_19":8385,"_8079":7827},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4630":8388,"_8076":8389,"_15":8386,"_8077":4060,"_19":8390,"_8079":7645},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4630":8393,"_8076":8394,"_15":8391,"_8077":4060,"_19":8395,"_8079":7801},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4630":8398,"_8076":8399,"_15":8396,"_8077":4060,"_19":8400,"_8079":7645},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4630":8402,"_8076":8403,"_15":7815,"_8077":8404,"_19":8405,"_8079":7801},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4630":8198,"_8076":8403,"_15":8406,"_8077":4060,"_19":8408,"_8079":7801},"干员受到自然附着","ba.originium",{"_4630":8411,"_8076":4060,"_15":8409,"_8077":4060,"_19":8412,"_8079":7672},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4630":8415,"_8076":4060,"_15":8413,"_8077":4060,"_19":8416,"_8079":7827},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4630":8419,"_8076":8420,"_15":8417,"_8077":4060,"_19":8421,"_8079":7827},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4630":8424,"_8076":4060,"_15":8422,"_8077":8425,"_19":8426,"_8079":7835},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4630":8429,"_8076":4060,"_15":8427,"_8077":4060,"_19":8430,"_8079":7645},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4630":8433,"_8076":4060,"_15":8431,"_8077":8434,"_19":8435,"_8079":7851},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4630":8438,"_8076":8439,"_15":8436,"_8077":4060,"_19":8440,"_8079":7645},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4630":8442,"_8076":8304,"_15":7855,"_8077":8443,"_19":8444,"_8079":7851},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4630":8447,"_8076":8448,"_15":8445,"_8077":4060,"_19":8449,"_8079":7851},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4630":8452,"_8076":4060,"_15":8450,"_8077":8453,"_19":8454,"_8079":7672},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4630":8457,"_8076":4060,"_15":8455,"_8077":8458,"_19":5972,"_8079":4060},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","sys.manualCraftTonic",{"_4630":8461,"_8076":4060,"_15":8459,"_8077":4060,"_19":8462,"_8079":7645},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4630":8465,"_8076":4060,"_15":8463,"_8077":4060,"_19":8466,"_8079":7672},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4630":8469,"_8076":8470,"_15":8467,"_8077":4060,"_19":8471,"_8079":7645},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4630":8474,"_8076":4060,"_15":8472,"_8077":8475,"_19":8476,"_8079":7672},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4630":8479,"_8076":4060,"_15":8477,"_8077":4060,"_19":8480,"_8079":7645},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4630":8483,"_8076":8484,"_15":8481,"_8077":8485,"_19":8486,"_8079":7672},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4630":8489,"_8076":4060,"_15":8487,"_8077":4060,"_19":8490,"_8079":7672},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4630":8493,"_8076":4060,"_15":8491,"_8077":4060,"_19":8494,"_8079":7672},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4630":8497,"_8076":8498,"_15":8495,"_8077":4060,"_19":8499,"_8079":7645},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4630":8502,"_8076":4060,"_15":8500,"_8077":4060,"_19":8503,"_8079":7672},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4630":8506,"_8076":4060,"_15":8504,"_8077":4060,"_19":8507,"_8079":7672},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4630":8510,"_8076":4060,"_15":8508,"_8077":4060,"_19":8511,"_8079":7672},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4630":8514,"_8076":8515,"_15":8512,"_8077":8516,"_19":8517,"_8079":7672},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4630":8520,"_8076":8521,"_15":8518,"_8077":4060,"_19":8522,"_8079":7645},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4630":8525,"_8076":8526,"_15":8523,"_8077":4060,"_19":8527,"_8079":7645},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4630":8530,"_8076":8531,"_15":8528,"_8077":4060,"_19":8532,"_8079":7645},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4630":8535,"_8076":8536,"_15":8533,"_8077":4060,"_19":8537,"_8079":7645},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4630":8540,"_8076":8541,"_15":8538,"_8077":4060,"_19":8542,"_8079":7645},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4630":8545,"_8076":8546,"_15":8543,"_8077":4060,"_19":8547,"_8079":7645},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4630":8550,"_8076":8551,"_15":8548,"_8077":4060,"_19":8552,"_8079":7645},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4630":8555,"_8076":8556,"_15":8553,"_8077":4060,"_19":8557,"_8079":7645},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4630":8560,"_8076":8561,"_15":8558,"_8077":4060,"_19":8562,"_8079":7645},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4630":8565,"_8076":8566,"_15":8563,"_8077":4060,"_19":8567,"_8079":7645},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4630":8570,"_8076":8571,"_15":8568,"_8077":4060,"_19":8572,"_8079":7645},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4630":8575,"_8076":8576,"_15":8573,"_8077":4060,"_19":8577,"_8079":7645},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4630":8580,"_8076":8581,"_15":8578,"_8077":4060,"_19":8582,"_8079":7645},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4630":8585,"_8076":8586,"_15":8583,"_8077":4060,"_19":8587,"_8079":7645},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7282":8590,"_6832":8599,"_6798":8601,"_6932":8603,"_6934":8605,"_6138":8607,"_6937":8609,"_6827":8611,"_6941":8613,"_6944":8614,"_6148":8616,"_6949":8618,"_6952":8619,"_6955":8620,"_6957":8622,"_5442":8623,"_5976":8624,"_6964":8625,"_6968":8627,"_6972":8628,"_6976":8629,"_6980":8630,"_6983":8631,"_6987":8632,"_6991":8633,"_6994":8634,"_6998":8635,"_7002":8637,"_7006":8638,"_7010":8640,"_5971":8642,"_7017":8644,"_7021":8645,"_7025":8647,"_7029":8649,"_7033":8650,"_7037":8652,"_7041":8654,"_7045":8656,"_7049":8658,"_5448":8661,"_7056":8664,"_7060":8667,"_7064":8670,"_7068":8671,"_7072":8673,"_7076":8674,"_7080":8675,"_7084":8677,"_7088":8679,"_7092":8680,"_7096":8682,"_7100":8684,"_7104":8686,"_7108":8688,"_7112":8690,"_7116":8692,"_7120":8694,"_7123":8696,"_7127":8698,"_7131":8700,"_7135":8701,"_7139":8703,"_7143":8704,"_7147":8705,"_7151":8706,"_7155":8707,"_7159":8708,"_7163":8709,"_7167":8710,"_7171":8711,"_7175":8712,"_7179":8713,"_7183":8714,"_7187":8715,"_7191":8716,"_7195":8717,"_7199":8718,"_7203":8719,"_7207":8720,"_7211":8721,"_7215":8722,"_7218":8723,"_7222":8724,"_7226":8725,"_7230":8726,"_7234":8727,"_7238":8728,"_7242":8730,"_7246":8731,"_7250":8732,"_8733":8734,"_8735":8736,"_8738":8739,"_8740":8741,"_