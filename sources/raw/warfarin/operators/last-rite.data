060,"_4623":4060,"_4624":4060,"_4625":4060,"_4626":4060,"_4627":4060,"_4628":4060,"_4629":4060,"_4630":4642,"_4632":4643,"_19":4644,"_4635":4640,"_4636":37,"_4637":4645},"普通攻击：\n对敌人进行至多4段攻击，造成<@ba.cryst>寒冷伤害</>。作为主控干员时，<#ba.lastcombo>重击</>会造成<@ba.poise>{poise:0}</>点失衡。\n\n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成<@ba.cryst>寒冷伤害</>。\n\n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量<@ba.cryst>寒冷伤害</>并恢复一定技力。","icon_attack_claym","严霜之舞",[4646,4647,4648,4649,4650,4651],"chr_0026_lastrite_attack1","chr_0026_lastrite_attack2","chr_0026_lastrite_attack3","chr_0026_lastrite_attack4","chr_0026_lastrite_power_attack","chr_0026_lastrite_plunging_attack_end","chr_0026_lastrite_NormalSkill",{"_4618":4060,"_4619":4060,"_4620":4060,"_4621":4060,"_4622":4060,"_4623":4060,"_4624":4060,"_4625":4060,"_4626":4060,"_4627":4060,"_4628":4060,"_4629":4060,"_4630":4654,"_4632":4655,"_19":4656,"_4635":4652,"_4636":39,"_4637":4657},"对主控干员的武器进行<@ba.key>低温灌注</>，并<#ba.return>返还</>一定技力。\n一段时间内，当前主控干员接下来的1次<#ba.lastcombo>重击</>会生成别礼的幻影，对目标进行追击，造成<@ba.cryst>寒冷伤害</>，施加<#ba.crystinflict>寒冷附着</>。\n主控干员为别礼时，施放该战技不会中断普通攻击。","icon_skill_lastrite_01","塞什卡的秘传",[4658],"chr_0026_lastrite_normal_skill","chr_0026_lastrite_UltimateSkill",{"_4618":4060,"_4619":4060,"_4620":4060,"_4621":4060,"_4622":4060,"_4623":4060,"_4624":4060,"_4625":4060,"_4626":4060,"_4627":4060,"_4628":4060,"_4629":4060,"_4630":4661,"_4632":4662,"_19":4663,"_4635":4659,"_4636":55,"_4637":4664},"披着霜铠，凝结冰镰，对前方进行三次斩击，该状态下免疫所有伤害。\n每次斩击造成大量<@ba.cryst>寒冷伤害</>。\n<@ba.info>别礼只能从自身的战技、连携技中获得终结技能量。</>","icon_ultimate_skill_lastrite_01","临终别礼",[4665],"chr_0026_lastrite_ultimate_skill","skillLevelUp",[4668,4678,4683,4689,4694,4699,4706,4711,4715,4725,4732,4739,4743,4747,4751,4755,4759,4763,4767,4771,4777,4783,4789,4793,4797,4801,4805,4809,4813,4817,4821,4828,4834,4840,4844,4848,4852,4856,4860,4864,4868,4872,4878,4884],{"_4669":4670,"_4671":4672,"_4677":55,"_4635":4652},"goldCost",1000,"itemBundle",[4673,4675],{"_4556":68,"_15":4674},"item_char_skill_level_1_6",{"_4556":