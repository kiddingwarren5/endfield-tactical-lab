29,3830,3831,3832,3833,3834],{"_36":37,"_38":901},{"_36":41,"_38":3802},123.99474016410717,{"_36":44,"_38":3804},106.08247422680411,{"_36":47,"_38":3806},190.177782453188,{"_36":50,"_38":3804},{"_36":39,"_38":3809},5832,{"_36":54,"_38":3811},328,{"_36":57,"_38":37},{"_36":59,"_38":3814},1.48469387755102,{"_36":61,"_38":3816},1.24234693877551,{"_36":63,"_38":39},{"_36":65,"_38":39},{"_36":67,"_38":39},{"_36":69,"_38":39},{"_36":71,"_38":39},{"_36":73,"_38":39},{"_36":75,"_38":37},{"_36":77,"_38":37},{"_36":79,"_38":37},{"_36":81,"_38":37},{"_36":83,"_38":37},{"_36":85,"_38":37},{"_36":87,"_38":39},{"_36":89,"_38":90},{"_36":92,"_38":93},{"_36":95,"_38":93},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3836,"_101":63},{"_33":3837},[3838,3840,3842,3844,3846,3847,3849,3851,3852,3854,3855,3856,3857,3858,3859,3860,3861,3862,3863,3864,3865,3866,3867,3868,3869,3870,3871,3872],{"_36":37,"_38":3839},97,{"_36":41,"_38":3841},125.12089206816778,{"_36":44,"_38":3843},107.09278350515463,{"_36":47,"_38":3845},191.91920892068222,{"_36":50,"_38":3843},{"_36":39,"_38":3848},5888,{"_36":54,"_38":3850},331,{"_36":57,"_38":37},{"_36":59,"_38":3853},1.48979591836735,{"_36":61,"_38":1963},{"_36":63,"_38":39},{"_36":65,"_38":39},{"_36":67,"_38":39},{"_36":69,"_38":39},{"_36":71,"_38":39},{"_36":73,"_38":39},{"_36":75,"_38":37},{"_36":77,"_38":37},{"_36":79,"_38":37},{"_36":81,"_38":37},{"_36":83,"_38":37},{"_36":85,"_38":37},{"_36":87,"_38":39},{"_36":89,"_38":90},{"_36":92,"_38":93},{"_36":95,"_38":93},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3874,"_101":63},{"_33":3875},[3876,3877,3879,3881,3883,3884,3886,3888,3889,3891,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910],{"_36":37,"_38":3499},{"_36":41,"_38":3878},126.24704397222837,{"_36":44,"_38":3880},108.10309278350515,{"_36":47,"_38":3882},193.66063538817644,{"_36":50,"_38":3880},{"_36":39,"_38":3885},5944,{"_36":54,"_38":3887},334,{"_36":57,"_38":37},{"_36":59,"_38":3890},1.49489795918367,{"_36":61,"_38":3892},1.24744897959184,{"_36":63,"_38":39},{"_36":65,"_38":39},{"_36":67,"_38":39},{"_36":69,"_38":39},{"_36":71,"_38":39},{"_36":73,"_38":39},{"_36":75,"_38":37},{"_36":77,"_38":37},{"_36":79,"_38":37},{"_36":81,"_38":37},{"_36":83,"_38":37},{"_36":85,"_38":37},{"_36":87,"_38":39},{"_36":89,"_38":90},{"_36":92,"_38":93},{"_36":95,"_38":93},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3912,"_101":63},{"_33":3913},[3914,3915,3917,3919,3921,3922,3924,3926,3927,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947],{"_36":37,"_38":940},{"_36":41,"_38":3916},127.37319587628896,{"_36":44,"_38":3918},109.11340206185565,{"_36":47,"_38":3920},195.40206185567067,{"_36":50,"_38":3918},{"_36":39,"_38":3923},6000,{"_36":54,"_38":3925},337,{"_36":57,"_38":37},{"_36":59,"_38":3928},1.5,{"_36":61,"_38":2000},{"_36":63,"_38":39},{"_36":65,"_38":39},{"_36":67,"_38":39},{"_36":69,"_38":39},{"_36":71,"_38":39},{"_36":73,"_38":39},{"_36":75,"_38":37},{"_36":77,"_38":37},{"_36":79,"_38":37},{"_36":81,"_38":37},{"_36":83,"_38":37},{"_36":85,"_38":37},{"_36":87,"_38":39},{"_36":89,"_38":90},{"_36":92,"_38":93},{"_36":95,"_38":93},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[3950,3951,3952],"tag_09","tag_07","tag_14","charId","charIllustInitPos",{"_3956":3957,"_3958":3959},"x",160,"y",-240,"charPassiveUIPrefabName","OverlayInfoNodeSi","charTypeId","Cryst","cvName",{"_3966":3967,"_3968":3969,"_3970":3971,"_3972":3973,"_3953":16},"ChiCVName","幽舞越山","EngCVName","兽兽王","JapCVName","种崎敦美","KorCVName","尹垠舒","defaultWeaponId","wpn_claym_0010","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Si","mainAttrType","phoneticName","","profession","profileRecord",[3988,3999,4004,4009,4015,4020],{"_3953":16,"_15":3989,"_3990":3991,"_3992":3993,"_3994":39,"_3995":3996,"_3997":37,"_3998":37},"chr_0036_jsspsi_1","recordDesc","【代号】祀\n【性别】女\n【身份认证】宏山科学院\n【生日】9月15日\n【种族】未公开\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：■■\n作战技巧：优良\n战术规划：标准\n源石技艺适应性：缺陷","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_3953":16,"_15":4000,"_3990":4001,"_3992":4002,"_3994":54,"_3995":4003,"_3997":37,"_3998":37},"chr_0036_jsspsi_2","祀，巨兽代理人，无业，与宏山科学院长期保有联系，由管理员亲自推荐加入终末地工业，现阶段为终末地提供巨兽相关的理论与应用技术支持。\n\n祀极少参与终末地的人事活动，仅有的一次还被记录在了我的自检日志中：祀如约来到帝江号与我对话，按部就班地回答完所有问题并签字确认的瞬间，她凭空消失了。我的运算模块在第一时间将这种现象解读为突发事故，并发出警报。随后祀再次走进办公室，擦掉了我居中的面板上的一滴墨水，嘟囔着“有意思，但还不够有意思”。据祀解释，刚刚坐在我面前的，只是她画下的自己，她想以此试试我的反应。这么看，我的表现并未完全达到她的预期。\n这是个无伤大雅的玩笑，某种程度上也透露出祀的特别之处：拥有科学难以解释的能力，偶尔却又显露出不那么符合代理人的心性。不过，能在塔卫二见到巨兽代理人的机会并不多，我仍旧建议其他人事部同僚尝试与其积极接触，以找到她心情变化的规律。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_3953":16,"_15":4005,"_3990":4006,"_3992":4007,"_3994":57,"_3995":4008,"_3997":37,"_3998":37},"chr_0036_jsspsi_3","祀加入终末地后很长一段时间，几乎没有干员见过她。她的人事档案留有大量空白，除了“神秘”，我们对这位巨兽代理人几乎没有其他印象。人事部也尝试通过祀的推荐人让她配合一些工作，但显然，管理员说话也不怎么奏效……直到我们的一位后勤干员在武陵城的火锅店偶遇了祀。\n在完全不认识彼此的情况下，她们两人参加了同一场新品促销活动，一起品尝了“青柠苦瓜”“胡椒鳞肚源石虫”“水炖竹林虫”等听起来匪夷所思的新锅底。得知祀在帮自己客栈的厨师偷师后，后勤干员还盛赞了她小小年纪就有如此商业头脑和非凡品味，祀高兴得连她的单一起买了。直到这位干员后来在人事部看到祀的照片，才知道当时和自己拼桌的人是谁……此后，越来越多的干员在各种奇奇怪怪的场合与祀偶遇，包括但不限于武陵城的龙泡泡发售现场，菈梵朵玛的机器人体验馆……甚至还有两个家伙因此争执得面红耳赤，按他们的表述，他们在同一时间，分别在塞什卡的巫术法杖拍卖会和萨米的祭祀仪式看见了祀，前者坚称祀是在拍卖会上截胡了最终藏品的恶作剧买家，后者则咬定祀是当天坐在雪祀中间喝醉了的神秘客人——这两个地方相隔千里，甚至一个天上一个地下，我们只在某些早已不可考的炎国传奇故事里听说过类似的桥段。总之，按照干员们的说法，祀不像是避世隐居的代理人，更像是一个精力旺盛在家待不住的孩子。\n那之后，帝江号在举办一些诸如先锋观影会的活动时，有干员壮着胆子再次通过管理员向祀发去了邀请……这一次，祀如约而至。我们渐渐接受了这位代理人其实是这样的性格：古灵精怪，讨厌古板的、不知变通的人，贪图新鲜，对许多事物都保持着孩童般的好奇。或许……从巨兽的时间维度上看，她确实还太年轻。\n\n来自干员明河的建议：删掉诸如“孩子”“年轻”之类的字眼，祀小姐本人对年龄问题非常敏感，按她的说法，她“几乎与塔卫二的文明同岁，你们都是些小辈”。\n\n来自干员诀的补充建议：在关键事务上，请如我等一样充分相信代理人的能力。无论平时表现如何，她的能力也当得起这份信任，以及，她同样不喜欢被人质疑。\n\n来自未知访客的神秘建议：她要是闹脾气了，就快去请管理员。","CN_03","档案资料·一",{"_3953":16,"_15":4010,"_3990":4011,"_3992":4012,"_3994":63,"_3995":4013,"_3997":63,"_3998":4014},"chr_0036_jsspsi_4","【应龙特勤队训练日志之三】\n地点：宏科院辖区，无名荒野\n内容：代理人与新一批入选的特勤队员见面\n备注：代理人无故缺席，改为常规训练。带队的前辈安慰了新队员，代理人虽然参与了应龙特勤队的组建与规划，但她本人并未在宏科院担任任何正式职务，双方目前仅是合作关系，多数队员直到退役也不一定有机会见到她。\n\n【应龙特勤队训练日志之八】\n地点：宏科院本部，谈剑堂\n内容：代理人讲解巨兽权能的应用\n备注：代理人无故缺席，并临时委托禁军靖天都尉夜明河与终末地工业管理员到场，训练内容改为枪术与源石应用的技术交流。\n\n【应龙特勤队训练日志之二十一】\n地点：代理人临时画的画卷\n内容：代理人讲解巨兽权能的应用\n备注：代理人兴致高涨，训练耗时比预期中长了三小时。她主动向队员们展示了十多种权能，这些所谓的“小把戏”每一个都神鬼莫测，包括但不限于：任意搬动石头和木头，便搭建起了一片无人能走出的园林；随手冶铸出坚盾与巨剑，像是从虚空中取用神兵；种下一颗在极短时间内从生长到枯萎再重新发芽的种子，迷惑人对于时间与因果的感知；泼墨成真，虚实无际；改方为圆，口含天宪……当然，我们必须借助特殊的装置，才能使用这些能力之万一，没办法像代理人那样随心所欲，但毫无疑问，这些能力在战场上的应用不可估量，它们能帮助应龙特勤队完成无数复杂的作战任务。\n补充：但这些神奇的能力也会出现一些“时灵时不灵”的情况，比如巨盾中间存在明显的气孔，画出的太阳竟然是个挂在天边滴答滴答淌着墨滴的墨团……次数并不多，但确实存在。虽然每次代理人都掩饰得很好，比如大声咳嗽，突然画出一条河要考验我们的水战能力，或者直接宣布原地解散……\n\n这并不难理解。会不等于精，一种战技、一门手艺，往往需要一生的时间去融会贯通。代理人或许不是我说的这种情况，但她继承巨兽“岁”及其十二位代理人的所有权能，时间确实还太短。但总之，得益于她的付出，应龙特勤队得以存在，得以保卫我们的家园。\n——应龙特勤队行动队长 诀","CN_04","档案资料·二",300,{"_3953":16,"_15":4016,"_3990":4017,"_3992":4018,"_3994":65,"_3995":4019,"_3997":63,"_3998":4014},"chr_0036_jsspsi_5","在宏山科学院的一应专门组织中，司岁台成立得相对较晚，且与泰拉本境的同名组织在职能上存在诸多不同。司岁台原本是炎国在名为“大狩猎”的战争后，为应对陷入沉睡的巨兽“岁”所设立。其下辖的“秉烛人”队伍，负责长期监管“岁”分化出的十二位代理人的行动，以及处理其他次生灾害。司岁台与其所司之对象，近千年里关系都极为紧张。\n而宏山科学院的司岁台，性质更接近一个情报策略与技术支持机构，它致力于巨兽力量应用技术的开发，在军事、民生的诸多领域为宏山科学院提供援助。而且，无论是司岁台本体，还是随后成立、受其辖制的“应龙特勤队”，都有巨兽代理人祀的直接参与，且她本人似乎乐在其中。对司岁台而言，祀更像是一个脾气有些古怪的顾问。\n\n【特别记录】\n“……塔卫二之于吾妹，只恐天地尤小。但她毕竟年幼，当积跬步，故打发来宏山历练，盼谈天师顾看。若有便宜之需，随时前去拜谢。”\n“我哥信里就写了这点东西？”\n“他说的还不够多？你是新的代理人，没人知道你真正长成时会有怎样通天彻地的能力，如果像岁一样狂悖，或许整个塔卫二都拿你没办法，趁现在来和我们多打打交道，对你自己，对宏科院都不是坏事。还有……他威胁我说，要是你受了委屈，他不管在哪儿，都会随时上门来找我的麻烦。他就差直接寄把刀过来了！”\n“我、我哥他可没这个意思……您可是宏科院资历最老的天师，起码、起码我是很尊敬您的！”\n“哎哟，你确实比你的哥哥姐姐更招人喜欢！所以，特勤队的事情，考虑得怎么样了？你来宏山也有一阵子了。”\n“你们不是还找了管理员来当说客？我现在都坐在这儿了，多余问。”\n“好，那这便是塔卫二司祀台的第一项工作。”\n“‘司祀台’？！”\n“嗯？岁的一切已经在泰拉了结，你的哥哥姐姐如今也自在悠游，此时此地，‘司岁台’这个名字其实已经不太准确……”\n“还是司岁台吧！‘司祀台’也太难听了，像是专门管着我似的。”\n“行，行，听你的。”\n“那……特勤队的名字叫什么呢？”\n“那群小崽子还在纠结一些无趣的考量，要我说，本来就是依了你才能组建的新生力量，所以干脆就叫……‘应龙特勤队’，怎么样？”\n“谈老有品！威风！”","CN_05","档案资料·三",{"_3953":16,"_15":4021,"_3990":4022,"_3992":4023,"_3994":67,"_3995":4024,"_3997":63,"_3998":4025},"chr_0036_jsspsi_6","尘埃落定之后，岁兽再没有从梦中醒来。\n祂的身躯被夺走，意志在昏乱中沉寂。无论以前构成祂的是什么——傲慢、愤怒、憎恨、不甘，如今都随着载体的离去而消散。没了身躯，祂反而成了需要回答那个问题的孩童。\n“我是谁？”\n虚无之中并不存在答案。祂意识到，自己或许并没有回答这个问题的资格。\n祂放弃了。在漫长的征伐和与自己的博弈之中，祂第一次开始感到难以思考的疲惫，并在这种疲惫中得到了过去难寻的解脱。\n…………\n但岁毕竟存在了太久，太过强大，分出了太多的个体，祂没有那么容易彻底消亡。哪怕在祂的意识选择自我放逐之后，也总有些什么会像朝露一样自然浮现，然后自青翠间滴落……\n啪嗒一声。\n这引起了某位尚未离开的岁兽代理人的注意。\n出于……怜悯？或者是警惕？他立刻捕获了那团无瑕的意识。那团意识还不会言语，也不具备任何力量，甚至很难说和岁兽本体有什么关联。那团意识很脆弱，很弱小，飘摇不定。对了，就像是烛光……很明亮，也很清澈。\n代理人们第一次感到有些无所适从，他们讨论究竟该如何应对。\n毫无疑问，它是岁兽最后的残余，每位代理人在见到它的瞬间就心知肚明，若是为了根绝岁兽的隐患，他们大可以当场将之抹消。\n但它只是安静地躺在手心里。\n它真的是人们所熟悉的那个岁吗？即使是为了生存，傲慢的岁兽也不会将自己袒露于代理人面前，但若是一条新生命在寻求出路——代理人们隐约回想起了“出生”前朦胧的感受。\n它在探索，它在努力寻找“何以为我”的答案。当“自我”的残余不再能提供寻找这个答案的途径时，它便在无意识间寻上了自己的“血亲”。\n曾经在睡梦中为了行走人间诞下的婴儿，如今却成为了指引其生命方向的长辈，这对于十二位岁兽代理人而言，确实是件讽刺至极的事。商讨本来没有结果，直到某一天，代理人们清晰地听见一个声音自意识中破壳而出。\n那个声音同样虚弱，同样弱小，却出乎意料地懵懂无知。\n那个声音问：“我是谁？”\n然后再问：“我在哪里？”\n最后又问：“你们是谁？”\n…………\n最终，代理人们决定让这团意识渡过星门，前往那片未知的天地。他们知道，即使是岁陵中巨兽的残余，也承载了太多的因果，可既然它……既然她一无所知，那她就不是祂。\n或许对她而言，答案并不在这片岁兽曾经失败过的大地上。当一个全新的灵魂遇上全新的世界，它就有机会寻得自己为人的位置，得出那个答案的结论。\n于是，一团小小的意识，带着很多……呃，杂七杂八的物件——真的很杂，他们什么都往我，不是，往它手里塞——来到了塔卫二。\n在那之后，就是另一个故事了。","CN_06","档案资料·四",1500,"profileVoice",[4028,4036,4040,4044,4048,4052,4056,4061,4066,4071,4076,4081,4086,4091,4096,4101,4106,4111,4116,4121,4126,4131,4136,4141,4146,4151,4156,4161,4166,4171,4176,4181,4186,4191,4196,4201,4206,4211,4216,4221,4226,4231,4236,4241,4246,4251,4256,4261,4266,4271,4276,4281,4286,4291,4296,4301,4306,4311,4316,4321,4326,4331,4336,4342,4348,4354,4359,4365,4371,4376,4382,4387,4393,4399,4405,4411,4417,4422,4428,4433,4438,4444],{"_3953":16,"_15":3989,"_3997":37,"_3998":37,"_4029":4030,"_4031":4032,"_4033":39,"_4034":4035},"voId","chr_0036_jsspsi_chrbark_squad_01","voiceDesc","哼，惹了麻烦，才想起来找我？","voiceIndex","voiceTitle","行动准备1",{"_3953":16,"_15":4000,"_3997":37,"_3998":37,"_4029":4037,"_4031":4038,"_4033":54,"_4034":4039},"chr_0036_jsspsi_chrbark_squad_02","再帮你一把，回客栈了记得找我清账。","行动准备2",{"_3953":16,"_15":4005,"_3997":37,"_3998":37,"_4029":4041,"_4031":4042,"_4033":57,"_4034":4043},"chr_0036_jsspsi_chrbark_join_01","接下来不许跟我说话，不然我没法专心了。","编入队伍1",{"_3953":16,"_15":4010,"_3997":37,"_3998":37,"_4029":4045,"_4031":4046,"_4033":63,"_4034":4047},"chr_0036_jsspsi_chrbark_join_02","你别不说话，太安静了我反而容易分神！","编入队伍2",{"_3953":16,"_15":4016,"_3997":37,"_3998":37,"_4029":4049,"_4031":4050,"_4033":65,"_4034":4051},"chr_0036_jsspsi_chrbark_weap_01","这是你挑的？唔……待我添上两笔。现在它是我的了，你可别想再要回去。","更换武器",{"_3953":16,"_15":4021,"_3997":37,"_3998":37,"_4029":4053,"_4031":4054,"_4033":67,"_4034":4055},"chr_0036_jsspsi_chrbark_gear_01","居然连翅膀怎么放都考虑到了……咳，这是你该用的心，我、我可不会夸你。","更换装备",{"_3953":16,"_15":4057,"_3997":37,"_3998":37,"_4029":4058,"_4031":4059,"_4033":69,"_4034":4060},"chr_0036_jsspsi_7","chr_0036_jsspsi_chrup_skill_01","有灵感了，快点，别杵在那儿，给我找张纸来！","激活天赋阵列",{"_3953":16,"_15":4062,"_3997":37,"_3998":37,"_4029":4063,"_4031":4064,"_4033":87,"_4034":4065},"chr_0036_jsspsi_8","chr_0036_jsspsi_chrup_level_01","多看几遍，才不会忘记……笑什么？我在说你呢！","观看作战记录",{"_3953":16,"_15":4067,"_3997":54,"_3998":39,"_4029":4068,"_4031":4069,"_4033":89,"_4034":4070},"chr_0036_jsspsi_9","chr_0036_jsspsi_chrup_promt01_01","先说好，我只是在这儿挂个名，别指望我什么忙都会帮。你得保证，终末地和你说的一样有趣。","精英化晋升1",{"_3953":16,"_15":4072,"_3997":54,"_3998":54,"_4029":4073,"_4031":4074,"_4033":93,"_4034":4075},"chr_0036_jsspsi_10","chr_0036_jsspsi_chrup_promt02_01","把手伸出来，我用尾巴盖个戳，这样就算签字确认了……对了，在我给你盖新的之前，可不许擦掉。","精英化晋升2",{"_3953":16,"_15":4077,"_3997":54,"_3998":57,"_4029":4078,"_4031":4079,"_4033":100,"_4034":4080},"chr_0036_jsspsi_11","chr_0036_jsspsi_chrup_promt03_01","墨魉，记好管理员刚刚说的，一个字都不许漏。宏科院让我去见见应龙的年轻人，正好派得上用场。","精英化晋升3",{"_3953":16,"_15":4082,"_3997":54,"_3998":63,"_4029":4083,"_4031":4084,"_4033":95,"_4034":4085},"chr_0036_jsspsi_12","chr_0036_jsspsi_chrup_promt04_01","虽然一直在给我晋升，但要是哪天你答应的事没做到，我就回客栈了。终末地是终末地，你是你。我们的事，是要另算的。","精英化晋升4",{"_3953":16,"_15":4087,"_3997":37,"_3998":37,"_4029":4088,"_4031":4089,"_4033":515,"_4034":4090},"chr_0036_jsspsi_13","chr_0036_jsspsi_introduce_01","你这小东西，叼好别乱动，墨水还没干呢……这幅画送你。别管画了什么，重点是落款！不许再忘记我的名字了！","干员报到",{"_3953":16,"_15":4092,"_3997":37,"_3998":37,"_4029":4093,"_4031":4094,"_4033":553,"_4034":4095},"chr_0036_jsspsi_14","chr_0036_jsspsi_mono_switch_01","先收着吧……咳，草稿打好了，还急什么？","待命1",{"_3953":16,"_15":4097,"_3997":37,"_3998":37,"_4029":4098,"_4031":4099,"_4033":97,"_4034":4100},"chr_0036_jsspsi_15","chr_0036_jsspsi_mono_switch_02","跟了我这么久，你们连帮我签个名都不会？","待命2",{"_3953":16,"_15":4102,"_3997":37,"_3998":37,"_4029":4103,"_4031":4104,"_4033":852,"_4034":4105},"chr_0036_jsspsi_21","chr_0036_jsspsi_sim_assign_work_01","诓我过来，自己好当甩手掌柜？不许走，你得陪着我一起。","进驻设施",{"_3953":16,"_15":4107,"_3997":37,"_3998":37,"_4029":4108,"_4031":4109,"_4033":890,"_4034":4110},"chr_0036_jsspsi_22","chr_0036_jsspsi_sim_hello_lower_01","差点走过了，你一开始竟然没看见我吗？","打招呼1",{"_3953":16,"_15":4112,"_3997":63,"_3998":4014,"_4029":4113,"_4031":4114,"_4033":929,"_4034":4115},"chr_0036_jsspsi_23","chr_0036_jsspsi_sim_hello_max_01","……十年前答应的事情，你打算什么时候补上？","打招呼2",{"_3953":16,"_15":4117,"_3997":37,"_3998":37,"_4029":4118,"_4031":4119,"_4033":967,"_4034":4120},"chr_0036_jsspsi_24","chr_0036_jsspsi_sim_talk_lv01_01","什么叫呆站着？看见那面舷窗没，我刚刚在上面画了一整幅《塔卫二行旅图》……谁让你迟到的，全部都抹掉了。","帝江号闲聊1",{"_3953":16,"_15":4122,"_3997":63,"_3998":4014,"_4029":4123,"_4031":4124,"_4033":61,"_4034":4125},"chr_0036_jsspsi_25","chr_0036_jsspsi_sim_talk_lv02_01","怎么我每次来帝江号，你都会特意找过来？你说你刚刚在拐角看见了墨魉……对、对啊，是你特意出现在了我的必经之路上！","帝江号闲聊2",{"_3953":16,"_15":4127,"_3997":63,"_3998":4014,"_4029":4128,"_4031":4129,"_4033":1043,"_4034":4130},"chr_0036_jsspsi_26","chr_0036_jsspsi_sim_talk_lv02_02","我要画一幅你的画像带回去，这样以后没人带路，你进画里也不会被器伥骚扰了……嗯？十年前我是画过了，但当时你脸上也没戴这个东西啊。","帝江号闲聊3",{"_3953":16,"_15":4132,"_3997":63,"_3998":4025,"_4029":4133,"_4031":4134,"_4033":1082,"_4034":4135},"chr_0036_jsspsi_27","chr_0036_jsspsi_sim_talk_max_01","地图、枕头、点心、炉子、醒神茶……我在盘点下次去萨米时该带些什么。不出去转转，灵感从哪儿来？你看看还有什么要补充的……跟你说这么多，当然是找你一起啊！有墨魉在，到时候轮不到你背行李，呆货。","帝江号闲聊4",{"_3953":16,"_15":4137,"_3997":63,"_3998":4025,"_4029":4138,"_4031":4139,"_4033":1120,"_4034":4140},"chr_0036_jsspsi_28","chr_0036_jsspsi_sim_talk_max_02","刚刚看见了佩丽卡，你的小监督和你简直一个样，都快要站着睡着了，还在那儿硬撑着……我是说，你们俩现在一个样！快去打个盹！你这个人，要么一睡睡十年，要么连眼睛都舍不得闭一下！","帝江号闲聊5",{"_3953":16,"_15":4142,"_3997":63,"_3998":4025,"_4029":4143,"_4031":4144,"_4033":1159,"_4034":4145},"chr_0036_jsspsi_29","chr_0036_jsspsi_sim_talk_max_03","这里居然能看见几乎半个塔卫二，也不知道他们俩如今晃悠到了哪里……谁说我想哥哥姐姐了？欸，你别这么一直盯着我——好吧，一点，就一点而已！","帝江号闲聊6",{"_3953":16,"_15":4147,"_3997":37,"_3998":37,"_4029":4148,"_4031":4149,"_4033":55,"_4034":4150},"chr_0036_jsspsi_30","chr_0036_jsspsi_sim_gift_give_01","喏，送你的礼物。随手画的，没必要太激动——呀，拿错了，这幅简笔自画像只是我随手画的，你还回来！","赠送礼物",{"_3953":16,"_15":4152,"_3997":37,"_3998":37,"_4029":4153,"_4031":4154,"_4033":1235,"_4034":4155},"chr_0036_jsspsi_31","chr_0036_jsspsi_sim_gift_recv_01","你、你怎么也喜欢这套繁文缛节了——欸，谁让你收回去的！","接收礼物",{"_3953":16,"_15":4157,"_3997":37,"_3998":37,"_4029":4158,"_4031":4159,"_4033":47,"_4034":4160},"chr_0036_jsspsi_41","chr_0036_jsspsi_mono_self_line01","记得抽空回趟客栈，为了给你补办接风宴，伙计们正忙着把后厨的天材地宝统统往外翻呢……你说你要好好感谢谁？好嘛，既然是伙计们瞎张罗，那我这个没好心的掌柜当然不能允许他们铺张浪费了，哼！","信赖对话1",{"_3953":16,"_15":4162,"_3997":63,"_3998":4014,"_4029":4163,"_4031":4164,"_4033":50,"_4034":4165},"chr_0036_jsspsi_42","chr_0036_jsspsi_mono_self_line02","闻闻这茶香。看见对面的悬崖没有，茶树就长在那上面。茶是好茶，但要打发身手最好的墨魉爬上去，才能采摘到。我攒了十年，就得到这么一小罐，今天算便宜你了……喂，你的嘴里怎么都是墨水？你说我、我的也……喝你的，一滴也不许剩，还有，不许你抬头看我！","信赖对话2",{"_3953":16,"_15":4167,"_3997":63,"_3998":4014,"_4029":4168,"_4031":4169,"_4033":228,"_4034":4170},"chr_0036_jsspsi_43","chr_0036_jsspsi_mono_self_line03","不下了不下了！你棋下得挺好，但我哥哥才是塔卫二上最厉害的棋手，你比起他还是差远了……这是我这个月第三次说起哥哥姐姐了？我、我可没想他们能一直陪着我。看看这座山，这间客栈，现在我身边还有……咳！现在不是很热闹吗？","信赖对话3",{"_3953":16,"_15":4172,"_3997":63,"_3998":4025,"_4029":4173,"_4031":4174,"_4033":1759,"_4034":4175},"chr_0036_jsspsi_44","chr_0036_jsspsi_mono_self_line04","伤没好彻底，就急着出远门，难不成你以为自己的身体是息壤，怎么折腾都不会坏？哼，你这个不把自己当回事的毛病，怎么没跟着记忆一起丢了？倔货！告诉我任务的细节，我替你跑一趟！记住，你又给我添了一次麻烦！","信赖对话4",{"_3953":16,"_15":4177,"_3997":63,"_3998":4025,"_4029":4178,"_4031":4179,"_4033":1798,"_4034":4180},"chr_0036_jsspsi_45","chr_0036_jsspsi_mono_self_line05","坐吧。想看夕阳的话，自己拿笔画几下。以前我一个人的时候，你也是这样不请自来，什么歪理到你嘴里都能变成安慰人的话……行了，我知道你暂时想不起来。但今后的事情，你要是敢再忘记，往后十年，不，一百五十年，我都不会和你说话了！","信赖对话5",{"_3953":16,"_15":4182,"_3997":37,"_3998":37,"_4029":4183,"_4031":4184,"_4033":265,"_4034":4185},"chr_0036_jsspsi_46","chr_0036_jsspsi_mono_chat_line01","这阵子，想进画里逛逛的人越来越多了，客栈没接待过那么多客人，伙计们建议在大堂里支一个留言板……主意是不错，但那岂不是会有很多人留意见？我、我主要是没工夫看，这样吧，以后你先帮我筛选一遍，然后我再看。","交谈1",{"_3953":16,"_15":4187,"_3997":37,"_3998":37,"_4029":4188,"_4031":4189,"_4033":1874,"_4034":4190},"chr_0036_jsspsi_47","chr_0036_jsspsi_mono_chat_line02","锻造的极致，是把所有的工序都压缩在一息之间，心里想什么，手里就能打造出什么。就好比我手里这面盾……那是个气孔吗……咳，临时拿来示范的东西，有瑕疵很、很正常吧？和我的权能精不精通可没有关系！","交谈2",{"_3953":16,"_15":4192,"_3997":37,"_3998":37,"_4029":4193,"_4031":4194,"_4033":71,"_4034":4195},"chr_0036_jsspsi_48","chr_0036_jsspsi_mono_chat_line03","你知道胖天鼓布偶吗？我很喜欢这类小玩意，客栈里收藏了不少。但胖天鼓布偶是武陵“你画我猜”比赛的专属奖品，我只有一个人，所以到现在都没拿到……听好了，下一轮比赛快到了，我好好教，你好好学……当然是你画，我猜！我们俩还犯得着作弊吗？","交谈3",{"_3953":16,"_15":4197,"_3997":37,"_3998":37,"_4029":4198,"_4031":4199,"_4033":59,"_4034":4200},"chr_0036_jsspsi_49","chr_0036_jsspsi_mono_chat_line04","“手不停”老是偷懒，“跑得快”胖得走不动道，“大嗓门”招待客人的声音比蚊子还小，几十年了，我看他们身上的臭毛病是改不掉了。嗯？当初那三个家伙无家可归，是我带他们进了画里，如今自然也能把他们扫地出门，但……乱七八糟的客栈，总比冷冷清清的客栈要好一点吧？","交谈4",{"_3953":16,"_15":4202,"_3997":37,"_3998":37,"_4029":4203,"_4031":4204,"_4033":75,"_4034":4205},"chr_0036_jsspsi_50","chr_0036_jsspsi_mono_chat_line05","小时候跟在哥哥姐姐身边，下午练围棋、听事理，晚上读书、写字、画画，剩下的时间，三个人就一起到处熟悉塔卫二……不过没多久哥哥姐姐就让我来宏山了。塔卫二对他们俩来说也是个新鲜地方，老跟在他们身边，我不一定能真的喜欢上这里。他们这么想，我当然能理解，但也不能这么长时间都不来看我吧……","交谈5",{"_3953":16,"_15":4207,"_3997":37,"_3998":37,"_4029":4208,"_4031":4209,"_4033":77,"_4034":4210},"chr_0036_jsspsi_51","chr_0036_jsspsi_mono_about_line01","宏科院组建应龙特勤队的时候，我确实在。不过除了教他们一些小把戏，别的我什么都没管。为什么不多花些心思？应龙里好多李织烟那样死脑筋的家伙，和他们待久了，连空气都会变得硬邦邦的。不过她和你待过一阵后，好像开窍了不少……这样，不如你代替我，去他们那儿挂个职？","话题：应龙特勤队",{"_3953":16,"_15":4212,"_3997":37,"_3998":37,"_4029":4213,"_4031":4214,"_4033":79,"_4034":4215},"chr_0036_jsspsi_52","chr_0036_jsspsi_mono_about_line02","终末地的人事档案系统有问题，“能力”那一栏，我填了武学、诗文、绘画、冶铸、律法、园林……才十二项，就开始报错。管我为什么有那么多本事？还是偶尔失误就不算专业了？给我好好解释清楚！","话题：权能",{"_3953":16,"_15":4217,"_3997":37,"_3998":37,"_4029":4218,"_4031":4219,"_4033":81,"_4034":4220},"chr_0036_jsspsi_53","chr_0036_jsspsi_mono_about_line03","我的翅膀好看吧？小时候我梦见自己生出了这对翅膀，醒了就把它画在了背上，为这事，姐姐没少数落我……明明我只是把它当成了一种装饰，姐姐非说我是为了打架的时候，张开翅膀显得更有气势。谁会这么幼稚，这不是冤枉人嘛！","话题：翅膀",{"_3953":16,"_15":4222,"_3997":37,"_3998":37,"_4029":4223,"_4031":4224,"_4033":83,"_4034":4225},"chr_0036_jsspsi_54","chr_0036_jsspsi_mono_about_line04","那个金毛小子？我们认识的时间不算短，他一直很难缠，有时候好像只关心他那匹黑黢黢的驰兽，有时候又满嘴“禁军职责所在”……就因为都是发自真心，所以才说他难缠啊！这点倒是跟你很像，不对，就是你点拨的他！下次他再乱闯我的画，我就不给你面子了。","话题：夜明河",{"_3953":16,"_15":4227,"_3997":37,"_3998":37,"_4029":4228,"_4031":4229,"_4033":85,"_4034":4230},"chr_0036_jsspsi_55","chr_0036_jsspsi_mono_about_line05","我不知道哥哥姐姐晃悠到了哪里，经历了那么多事情后，他们如今有的是时间，说不定要把塔卫二转个遍，也说不定随时都会……喂，“手不停”，我说没说过打扫要仔细，尤其是字画和棋盘？要是他们突然回来，看到这乱糟糟的样子，挨骂的可是我！","话题：家人",{"_3953":16,"_15":4232,"_3997":37,"_3998":37,"_4029":4233,"_4031":4234,"_4033":2212,"_4034":4235},"chr_0036_jsspsi_56","chr_0036_jsspsi_mono_about_line06","没有比岁更爱折腾的巨兽了，睡着了也不安生，还想着化身十二找炎国的麻烦。结果呢，代理人们各有各的想法，麻烦又回到了自己身上。至于我和祂嘛……祂最后的一点魂识没被带来塔卫二，就没有我，但祂是祂，我是我，我和祂半点联系也无，这倒是一笔再清楚明白不过的账。","话题：岁",{"_3953":16,"_15":4237,"_3997":37,"_3998":37,"_4029":4238,"_4031":4239,"_4033":564,"_4034":4240},"chr_0036_jsspsi_71","chr_0036_jsspsi_explore_point_common_01","不要漏看了这里。","发现资源1",{"_3953":16,"_15":4242,"_3997":37,"_3998":37,"_4029":4243,"_4031":4244,"_4033":2853,"_4034":4245},"chr_0036_jsspsi_72","chr_0036_jsspsi_explore_point_valub_01","快看，这边藏了好东西。","发现资源2",{"_3953":16,"_15":4247,"_3997":37,"_3998":37,"_4029":4248,"_4031":4249,"_4033":2892,"_4034":4250},"chr_0036_jsspsi_73","chr_0036_jsspsi_explore_find_locked_01","不仔细看，还真难发现这里别有洞天。","发现未探索区域",{"_3953":16,"_15":4252,"_3997":37,"_3998":37,"_4029":4253,"_4031":4254,"_4033":602,"_4034":4255},"chr_0036_jsspsi_74","chr_0036_jsspsi_explore_find_danger_01","小心点，不是三两笔就能解决的麻烦！","发现强敌",{"_3953":16,"_15":4257,"_3997":37,"_3998":37,"_4029":4258,"_4031":4259,"_4033":2968,"_4034":4260},"chr_0036_jsspsi_75","chr_0036_jsspsi_interact_mine_valub_01","天有洪炉，地生五金，塔卫二上的稀罕玩意倒是多。","采集矿物1",{"_3953":16,"_15":4262,"_3997":37,"_3998":37,"_4029":4263,"_4031":4264,"_4033":3006,"_4034":4265},"chr_0036_jsspsi_76","chr_0036_jsspsi_interact_mine_valub_echo2_01","我来吧，顺手的事。","采集矿物2",{"_3953":16,"_15":4267,"_3997":37,"_3998":37,"_4029":4268,"_4031":4269,"_4033":640,"_4034":4270},"chr_0036_jsspsi_77","chr_0036_jsspsi_interact_treasure_valub_01","灵感是等不来的，要靠自己找。","打开储藏箱",{"_3953":16,"_15":4272,"_3997":37,"_3998":37,"_4029":4273,"_4031":4274,"_4033":3082,"_4034":4275},"chr_0036_jsspsi_78","chr_0036_jsspsi_interact_etherium_01","唔，把醚质调进墨里，会画出来什么呢？","获得醚质",{"_3953":16,"_15":4277,"_3997":37,"_3998":37,"_4029":4278,"_4031":4279,"_4033":3121,"_4034":4280},"chr_0036_jsspsi_79","chr_0036_jsspsi_interact_blight_break_01","这些活，说不定墨魉也能做。","消除侵蚀",{"_3953":16,"_15":4282,"_3997":37,"_3998":37,"_4029":4283,"_4031":4284,"_4033":679,"_4034":4285},"chr_0036_jsspsi_80","chr_0036_jsspsi_interact_rest_01","该歇就歇嘛，一笔又画不出个塔卫二。","休整",{"_3953":16,"_15":4287,"_3997":37,"_3998":37,"_4029":4288,"_4031":4289,"_4033":3610,"_4034":4290},"chr_0036_jsspsi_91","chr_0036_jsspsi_combat_suppuse_using_01","岐黄之术，我刚好也懂。","使用战术物品1",{"_3953":16,"_15":4292,"_3997":37,"_3998":37,"_4029":4293,"_4031":4294,"_4033":3648,"_4034":4295},"chr_0036_jsspsi_92","chr_0036_jsspsi_combat_suppuse_getheal_01","……还真的轻松了不少！","使用战术物品2",{"_3953":16,"_15":4297,"_3997":37,"_3998":37,"_4029":4298,"_4031":4299,"_4033":863,"_4034":4300},"chr_0036_jsspsi_93","chr_0036_jsspsi_combat_remind_danger_01","留心了！","危险提醒",{"_3953":16,"_15":4302,"_3997":37,"_3998":37,"_4029":4303,"_4031":4304,"_4033":3724,"_4034":4305},"chr_0036_jsspsi_94","chr_0036_jsspsi_combat_hurt_lowhp_01","我的翅膀脏了吗？","负伤",{"_3953":16,"_15":4307,"_3997":37,"_3998":37,"_4029":4308,"_4031":4309,"_4033":3763,"_4034":4310},"chr_0036_jsspsi_95","chr_0036_jsspsi_combat_dead_01","真是的，一点兴致都没了。","力竭",{"_3953":16,"_15":4312,"_3997":37,"_3998":37,"_4029":4313,"_4031":4314,"_4033":901,"_4034":4315},"chr_0036_jsspsi_96","chr_0036_jsspsi_combat_remind_praise_01","呵，后生可畏啊。","小队激励1",{"_3953":16,"_15":4317,"_3997":37,"_3998":37,"_4029":4318,"_4031":4319,"_4033":3839,"_4034":4320},"chr_0036_jsspsi_97","chr_0036_jsspsi_combat_remind_praise_02","小鬼们，精气神很足嘛。","小队激励2",{"_3953":16,"_15":4322,"_3997":37,"_3998":37,"_4029":4323,"_4031":4324,"_4033":3499,"_4034":4325},"chr_0036_jsspsi_98","chr_0036_jsspsi_combat_remind_praise_echo2_01","这别是“人情世故”吧？","回应激励1",{"_3953":16,"_15":4327,"_3997":37,"_3998":37,"_4029":4328,"_4031":4329,"_4033":940,"_4034":4330},"chr_0036_jsspsi_99","chr_0036_jsspsi_combat_remind_praise_echo2_02","咳，好了好了，你们别分心了。","回应激励2",{"_3953":16,"_15":4332,"_3997":37,"_3998":37,"_4029":4333,"_4031":4334,"_4033":1093,"_4034":4335},"chr_0036_jsspsi_111","chr_0036_jsspsi_combat_intobattle_01","再磨蹭，天就要黑了。","作战开始1",{"_3953":16,"_15":4337,"_3997":37,"_3998":37,"_4029":4338,"_4031":4339,"_4033":4340,"_4034":4341},"chr_0036_jsspsi_112","chr_0036_jsspsi_combat_intobattle_echo2_01","让我看看年轻人的能耐。",112,"作战开始2",{"_3953":16,"_15":4343,"_3997":37,"_3998":37,"_4029":4344,"_4031":4345,"_4033":4346,"_4034":4347},"chr_0036_jsspsi_113","chr_0036_jsspsi_combat_outbattle_nor_01","确实比待在画里有意思多了。",113,"作战胜利1",{"_3953":16,"_15":4349,"_3997":37,"_3998":37,"_4029":4350,"_4031":4351,"_4033":4352,"_4034":4353},"chr_0036_jsspsi_114","chr_0036_jsspsi_combat_outbattle_nor_02","又有了不少灵感，今天这趟门倒是出对了。",114,"作战胜利2",{"_3953":16,"_15":4355,"_3997":37,"_3998":37,"_4029":4356,"_4031":4357,"_4033":1131,"_4034":4358},"chr_0036_jsspsi_115","chr_0036_jsspsi_combat_outbattle_nor_echo2_01","没尽兴，你们还有力气研墨吗？","作战胜利3",{"_3953":16,"_15":4360,"_3997":37,"_3998":37,"_4029":4361,"_4031":4362,"_4033":4363,"_4034":4364},"chr_0036_jsspsi_116","chr_0036_jsspsi_combat_outbattle_hard_01","再难也是赢了，赢了就别蔫头耷脑的了。",116,"作战胜利4",{"_3953":16,"_15":4366,"_3997":37,"_3998":37,"_4029":4367,"_4031":4368,"_4033":4369,"_4034":4370},"chr_0036_jsspsi_117","chr_0036_jsspsi_combat_battle_defeat_01","当然要想着赢，但输了也无所谓。我还在，有什么好怕的？",117,"作战失败",{"_3953":16,"_15":4372,"_3997":37,"_3998":37,"_4029":4373,"_4031":4374,"_4033":1207,"_4034":4375},"chr_0036_jsspsi_121","chr_0036_jsspsi_mono_attack_last_01","还不倒？","重击1",{"_3953":16,"_15":4377,"_3997":37,"_3998":37,"_4029":4378,"_4031":4379,"_4033":4380,"_4034":4381},"chr_0036_jsspsi_122","c