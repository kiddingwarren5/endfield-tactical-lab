,[4517],{"_4472":4477,"_15":4478},"equipBreakT4",{"_101":57,"_3953":16,"_4463":4520,"_4465":65,"_19":4521,"_4467":4518,"_4468":54,"_4469":4522},"激活后，允许干员穿戴金色品质装备","装备适配·三",[4523],{"_4472":4499,"_15":4478},"equipBreakT3",{"_101":54,"_3953":16,"_4463":4526,"_4465":63,"_19":4527,"_4467":4524,"_4468":54,"_4469":4528},"激活后，允许干员穿戴紫色品质装备","装备适配·二",[4529],{"_4472":4488,"_15":4478},"skillGroupMap",{"_4532":4533,"_4556":4557,"_4569":4570,"_4577":4578},"chr_0036_jsspsi_ComboSkill",{"_4534":3984,"_4535":3984,"_4536":3984,"_4537":3984,"_4538":3984,"_4539":3984,"_4540":3984,"_4541":3984,"_4542":3984,"_4543":3984,"_4544":3984,"_4545":3984,"_4546":4547,"_4548":4549,"_19":4550,"_4551":4532,"_4552":57,"_4553":4554},"conditionDesc1","conditionDesc2","conditionDescInactive1","conditionDescInactive2","conditionIcon1","conditionIcon2","conditionId1","conditionId2","conditionName1","conditionName2","conditionPostDesc1","conditionPostDesc2","desc","当有敌人的<#ba.crystinflict>寒冷附着</>或<#ba.fireinflict>灼热附着</>被<#ba.consume>消耗</>或<#ba.absorb>吸收</>后可以发动。\n召唤<@ba.key>墨龙</>，造成<@ba.cryst>寒冷伤害</>，伤害根据<#ba.consume>消耗</>或<#ba.absorb>吸收</>附着的最高层数获得提升。","icon","icon_combo_skill_jsspsi_01","成竹在胸","skillGroupId","skillGroupType","skillIdList",[4555],"chr_0036_jsspsi_combo_skill","chr_0036_jsspsi_NormalAttack",{"_4534":3984,"_4535":3984,"_4536":3984,"_4537":3984,"_4538":3984,"_4539":3984,"_4540":3984,"_4541":3984,"_4542":3984,"_4543":3984,"_4544":3984,"_4545":3984,"_4546":4558,"_4548":4559,"_19":4560,"_4551":4556,"_4552":37,"_4553":4561},"普通攻击：\n对敌人进行至多5段攻击，造成<@ba.cryst>寒冷伤害</>。作为主控干员时，<#ba.lastcombo>重击</>会造成<@ba.poise>{poise:0}</>点失衡。\n\n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成<@ba.cryst>寒冷伤害</>。\n\n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量<@ba.cryst>寒冷伤害</>并恢复一定技力。","icon_attack_claym","乘兴起笔",[4562,4563,4564,4565,4566,4567,4568],"chr_0036_jsspsi_attack1","chr_0036_jsspsi_attack2","chr_0036_jsspsi_attack3","chr_0036_jsspsi_attack4","chr_0036_jsspsi_attack5","chr_0036_jsspsi_plunging_attack_end","chr_0036_jsspsi_power_attack","chr_0036_jsspsi_NormalSkill",{"_4534":3984,"_4535":3984,"_4536":3984,"_4537":3984,"_4538":3984,"_4539":3984,"_4540":3984,"_4541":3984,"_4542":3984,"_4543":3984,"_4544":3984,"_4545":3984,"_4546":4571,"_4548":4572,"_19":4573,"_4551":4569,"_4552":39,"_4553":4574},"对目标施加<@ba.key>笔意</>和<#ba.static>定身</>并造成<@ba.cryst>寒冷伤害</>。同时对目标施加<#ba.crystinflict>寒冷附着</>，若小队内<@ba.key>01号位</>是<@ba.fire>灼热</>属性的干员则变为施加<#ba.fireinflict>灼热附着</>。被施加<@ba.key>笔意</>的目标受到伤害后，记录一部分伤害值。<@ba.key>笔意</>持续时间结束将会爆发，对范围内敌人造成所记录伤害值的<#ba.fixeddamage>固定伤害</>。施放后战技在一段时间内替换为<@ba.key>起墨</>。\n<@ba.key>起墨</>：消耗<@ba.vup>15</>技力，从被施加<@ba.key>笔意</>的目标体内拉出<@ba.key>墨魂</>，<@ba.key>墨魂</>受到的所有伤害和效果将传递给本体，<@ba.key>墨魂</>持续时间等同于<@ba.key>笔意</>剩余时间。施放后战技在一段时间内替换为<@ba.key>收笔</>。\n<@ba.key>收笔</>：不消耗技力，使<@ba.key>墨魂</>提前消失。<@ba.key>墨魂</>消失时朝原目标移动并触发和<@ba.key>笔意</>效果相同的爆发。\n<@ba.info>对墨魂和处于笔意状态的目标同时造成伤害或效果时，只会视作造成一次伤害或效果。墨魂存在期间若原目标被击败则连接另一名战斗中的敌人，并对其施加笔意，持续时间不会重新计算。未拉出墨魂且处于笔意状态的目标被击败时，会在其位置生成墨魂。</>","icon_skill_jsspsi_01","河山共影",[4575,4576],"chr_0036_jsspsi_normal_skill","chr_0036_jsspsi_normal_skill_1","chr_0036_jsspsi_UltimateSkill",{"_4534":3984,"_4535":3984,"_4536":3984,"_4537":3984,"_4538":3984,"_4539":3984,"_4540":3984,"_4541":3984,"_4542":3984,"_4543":3984,"_4544":3984,"_4545":3984,"_4546":4579,"_4548":4580,"_19":4581,"_4551":4577,"_4552":54,"_4553":4582},"从画卷唤出<@ba.key>巨型墨龙</>造成<@ba.cryst>寒冷伤害</>，同时对全队施加一段时间的<#ba.crystenhance>寒冷增幅</>和<#ba.fireenhance>灼热增幅</>。","icon_ultimate_skill_jsspsi_01","谁都不许扫兴",[4583],"chr_0036_jsspsi_ultimate_skill","skillLevelUp",[4586,4596,4601,4607,4612,4617,4624,4629,4633,4643,4650,4657,4661,4665,4669,4673,4677,4681,4685,4689,4695,4701,4707,4711,4715,4719,4723,4727,4731,4735,4739,4746,4752,4758,4762,4766,4770,4774,4778,4782,4786,4790,4796,4802],{"_4587":4588,"_4589":4590,"_4595":54,"_4551":4569},"goldCost",1000,"itemBundle",[4591,4593],{"_4472":67,"_15":4592},"item_char_skill_level_1_6",{"_4472":39,"_15":4594},"item_plant_crylplant_1_1","level",{"_4587":4597,"_4589":4598,"_4595":57,"_4