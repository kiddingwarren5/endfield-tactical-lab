021,4023,4025,4027,4029,4030,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050],{"_36":37,"_38":926},{"_36":41,"_38":4018},106.8865979,{"_36":44,"_38":4020},192.0618557,{"_36":47,"_38":4022},128.5979381,{"_36":50,"_38":4024},97.97938144,{"_36":39,"_38":4026},6000,{"_36":55,"_38":4028},353,{"_36":58,"_38":37},{"_36":60,"_38":4031},1.5,{"_36":62,"_38":2053},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":97},{"_36":99,"_38":100},{"_36":102,"_38":39},"charBattleTagIds",[4053,4054,4055],"tag_03","tag_23","tag_07","charId","charIllustInitPos",{"_4059":4060,"_4061":4062},"x",-36,"y",-163,"charPassiveUIPrefabName","","charTypeId","Physical","cvName",{"_4069":4070,"_4071":4072,"_4073":4074,"_4075":4076,"_4056":16},"ChiCVName","吴哲茹","EngCVName","Giada Sabellico","JapCVName","日高里菜","KorCVName","李主恩","defaultWeaponId","wpn_sword_0003","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Rossi","mainAttrType","phoneticName","profession","profileRecord",[4090,4101,4106,4111,4116,4121],{"_4056":16,"_15":4091,"_4092":4093,"_4094":4095,"_4096":39,"_4097":4098,"_4099":37,"_4100":37},"chr_0028_wulfa_1","recordDesc","【代号】洛茜\n【性别】女\n【身份认证】狼群氏族\n【生日】3月10日\n【种族】鲁珀\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：标准\n战术规划：优良\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4056":16,"_15":4102,"_4092":4103,"_4094":4104,"_4096":55,"_4097":4105,"_4099":37,"_4100":37},"chr_0028_wulfa_2","干员洛茜，全名洛茜娜·狼珀·卢皮诺，裂地者狼群氏族成员，作为狼群代表之一与终末地工业达成合作关系。隶属于特种技术部门。\n\n由于干员狼卫的身份特殊性，终末地与狼群氏族的合作事务实际上都围绕着洛茜干员开展。\n洛茜并不常驻于帝江号，更多的时间会留在狼群处理氏族事务，但找到她不会像找到狼卫一样困难。她也乐于接受终末地的一些训练计划。小道奇对她的评价：战术素养极高，具有相当的领袖魅力和战场指挥才能。\n洛茜干员更像是大众眼中狼群氏族该有的样子，重视族人，遵守规则，尊重长辈。洛茜干员来到帝江号的第一天，就拜访了几乎所有部门的负责人，以及极具声望的干员。她乖巧懂事的一面给很多人留下了深刻的印象。\n但在面对敌人时，你又会看到她锐利、凶狠的一面。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4056":16,"_15":4107,"_4092":4108,"_4094":4109,"_4096":58,"_4097":4110,"_4099":37,"_4100":37},"chr_0028_wulfa_3","《洛茜的观察笔记》\n罗赞爷爷\n罗赞爷爷走路时总是没有声音，真是奇怪，他明明有着那么高的个头，脚步声却像踩在毛绒地毯上般细微，在他身上几乎从来都看不到破绽。无论我藏在哪里，都会被他发现。\n每次看到罗赞爷爷用铳时，都会感觉时间像凝固了一样，连呼吸声都听不见了。不知道过了多久，他才会缓缓放下铳。我从没看到过他开枪，他用纸擦拭完铳身，将其收回盒子里，训练就结束了。我试着模仿过几次，但……没法像他那样坚持那么久。\n…………\n卡特洛\n卡特洛总是脚步匆匆，真不知道他都在忙些什么。他的训练方式倒是很简单，枯燥无味的力量训练穿插几组动态射击训练，要么就是实战演习……真没意思，完全找不到什么参考价值，略过！\n…………\n弧光姐姐\n弧光姐姐能够很快地在陡峭的石壁上移动。是不是只要速度够快就能办到呢？我问了弧光姐姐，她说需要借助一些法术……弧光姐姐训练时还会冥想，她说那会让她放空脑中的杂念。呜……一动不动那么久太困难了。\n…………\n管理员\n管理员总是会照顾别人的步伐，关心对方有没有跟上自己，和卡特洛完全不一样！管理员的训练基本都和操纵源石有关，那些源石在管理员手中会化身为锐利的武器。究竟是用了什么方法呢？这肯定是只有管理员才能做到的事，想学也没有办法……","CN_03","档案资料·一",{"_4056":16,"_15":4112,"_4092":4113,"_4094":4114,"_4096":64,"_4097":4115,"_4099":64,"_4100":3402},"chr_0028_wulfa_4","成年礼？狼群之中，每个人的成年礼内容都不太一样，有的人是独自完成一场狩猎，有的人是搞定一场复杂的生意。\n狼群似乎不担心这些年轻人把事情搞砸，他们会大胆地把那些重要事务作为试炼内容交给年轻的小狼，这在氏族之外的人看来简直是疯了。\n至于洛茜娜……狩猎和生意这些事情她在更小的时候就完成过，对她而言，这些事情只是家常便饭。\n狼群给她安排了一场特殊的试炼。\n他们把洛茜娜扔在了一个荒废的村落，村落里只有五个倒霉的匪盗。那些匪盗都是些亡命之徒，他们早就盯上了彼此手中仅剩的保命玩意儿，说不准哪天就会暗算对方。\n五个人相互掣肘，谁也不敢轻举妄动，但……一旦微妙的平衡被打破……\n洛茜娜的首要任务是在那群匪盗手中活下来，但除此之外还不够。那里隔三差五就会有野兽袭击，有时是一只，有时是一群。\n老狼们把洛茜娜扔下之后就走了，他们一点也不担心她能否在那样的环境里活下来。\n两周后，老狼们前往那个村落，被眼前的一幕惊呆了。\n村落中建起了篱笆，五个匪盗和洛茜娜轮班值岗，警惕着野兽来袭。没有袭击的日子，五个人中有的外出打猎，有的收集淡水，居然成为了一个像模像样的团队。\n没有人知道洛茜娜是如何让这些彼此觊觎的人听从她的安排的。按她自己的话说，只是“让他们明白了活下去的唯一方法”。\n顺带一提，卡特洛也经历过这样的试炼。呃……他用几天时间杀光了附近的野兽，留下了足够的食物，然后在谁也不知道的情况下溜走了，到了结束试炼的日子才回来。\n——狼群干部马尔科·狼豪·卢皮诺的访谈记录","CN_04","档案资料·二",{"_4056":16,"_15":4117,"_4092":4118,"_4094":4119,"_4096":66,"_4097":4120,"_4099":64,"_4100":3402},"chr_0028_wulfa_5","“狼群派这样乳臭未干的小毛孩来，是罗赞那群老家伙都死光了吗？”\n洛茜看了一眼正带着手下捧腹大笑的埃瑞克，她不由得对这位被称作“荒野重炮”的首领失去了兴趣。\n这本是洛茜第一次经手氏族的“生意”。一周前，一支商队在前往卢皮诺家的途中被埃瑞克截获。看在狼群的名号上，他们不敢动运送货物的人，但应当归还的货物却少了一大半。卡特洛此刻又不在氏族中，于是洛茜主动请缨，想要在这一笔“生意”上大显身手。\n但洛茜此刻有些后悔这个决定，这一趟还不如留在家里狩猎有趣。眼前的“荒野重炮”扭动着肥硕臃肿的身躯，用手拍打着桌子。打从一进门，他就在不断试图激怒洛茜。\n强者总是内敛的，不露破绽的。这是洛茜在氏族中学到的心得，不论是罗赞，或是其他老狼，他们没有人会这般粗野地夸耀着暴力。\n“罗赞爷爷告诉我这是一笔‘生意’，在我看来，生意总是有赚钱的一方，和亏本的另一方。”\n洛茜的目光扫过整个营帐，火药的味道飘到了她的鼻尖，她锁定了对方埋设炸弹的位置。火药的用量很少，看来对方并不是想以杀死自己为目的，活着的狼看起来对他们更加有用。\n“狼群不介意在生意中让一些利给朋友，但不巧，我还没通过成人礼，还不能算狼群的一员。我只喜欢赚，不喜欢亏。”\n“看来狼群不准备坐下来好好谈谈这个问题了，对吧？”\n埃瑞克的目光微动，四周的匪盗神情变得严肃，有的已经把手按在了武器上。\n有两个剑手，两个巨斧手，门外应该还埋伏着好几个术师，从营帐内的站位来看，很难在短时间内把他们处理干净。那么——\n洛茜结束了观察，她把玩着桌上的餐叉，伺机而动。\n“你知道吗？从我到这鬼地方的第一天起，总有人不停给我说这事不能干，那人不能杀，要听狼群的规矩——狼群的规矩。”\n埃瑞克的情绪激动起来，他死盯着眼前孤身前来的小女孩。原本这次的准备是针对狼群的罗赞，但没想到来的只是个小孩子……埃瑞克感觉自己受到了羞辱。\n“规矩？谁的拳头大，谁就是规矩！”\n埃瑞克提起了重炮。狼群重视族人，拿下这个小女孩，可能会更有用。\n霎时，一把餐叉飞向了埃瑞克，洛茜从座位上跳起，身影突然消失不见。埃瑞克随手挡开了餐叉，正欲瞄准……\n“别乱动。”\n一把匕首抵住了他的后颈。\n四周的匪盗这才拔出武器，但为时已晚。\n“别过来！你们先别过来！”\n埃瑞克大叫着，他感受到了后颈传来的一丝丝凉意。\n“你是不是在指望门口的术师能帮自己？但是好奇怪啊，怎么这么安静。看来我的族人已经快我一步完成工作了。你刚说什么来着？哦，规矩……”\n冰冷的刀尖似乎又近了一寸。\n“你现在懂得什么是狼群的规矩了吗？”\n洛茜收起匕首，埃瑞克暴怒地转过身。他筹备的这一切，会被这样的小孩捣毁？\n“货我都交给碾骨了。如果你们真有胆子，就去从他们手里拿回来啊！等你们被屠戮殆尽，这地方的规矩就由我说了算！”\n“你说什么？”\n一股从未感受过的杀气从眼前的女孩身上传来。\n埃瑞克并不知道在这个女孩面前提起碾骨氏族的下场，但他很快就会知道了。\n\n看着一片狼藉的营帐，洛茜不由叹了口气。\n“做生意真是件麻烦的事情。”","CN_05","档案资料·三",{"_4056":16,"_15":4122,"_4092":4123,"_4094":4124,"_4096":68,"_4097":4125,"_4099":64,"_4100":4126},"chr_0028_wulfa_6","三次钟声响起，席间的人摘下礼帽，一个个走上前，将手中的鲜花摆在了冰冷的棺木中。\n有人在轻声啜泣，有人低下头默不作声。罗赞默默地环视四周，他没有发现那个熟悉的红色的身影。\n棺木里，是那次事件中活下来的最后一位老狼，他的余生都在病痛中度过。碾骨的毒烟侵袭了他的内脏，刀刃贯穿了他的四肢，但他依然紧紧地抱住了襁褓中的那个幼小的婴儿……直到把她交给另一个男孩……\n“她还是没有来……”\n有人向罗赞传达了这一信息，他点了点头，把葬礼交给了另一位老狼。\n他知道能在哪里找到女孩，每当她心烦意乱的时候，她都会把自己扔到训练场，一直待到深夜。\n罗赞静静地看着那个女孩，女孩也发现了他，但彼此都没有说一句话。女孩用力地把剑刺入训练假人，随后瘫倒在地。没人知道她在这里练了多久。\n“他走了。”\n罗赞走到躺在泥土上喘气的洛茜身边，淡淡地说道。\n“我知道，我知道……”\n洛茜用兜帽遮住了自己的眼睛，但声音却止不住地颤抖。自她懂事以来，每周都会去拜访那位老人，让他见证自己健康长大的样子。对于洛茜而言，老人是她与那些灵魂连接的纽带。\n“你应该在场的，他会希望你在的。”\n“但，都是因为我……是为了我才……”\n没等洛茜说完，罗赞将其提了起来，扛在了肩上，朝着葬礼所在的庭院走去。\n“我不能去见他……都是我……我不要……”\n洛茜在罗赞肩上挣扎着，撕咬着。她的指甲划破了他的皮肤，牙齿扎进了他的手臂。罗赞的表情没有一丝变化，依然走向葬礼的方向。\n很快，洛茜用尽了力气。她趴在罗赞身上，垂着手臂。\n“我没有成长为一位可靠的狼……”\n洛茜喃喃道，不知道是在对着罗赞，还是对着谁。\n“没有能够独当一面，没能带领起大家，我什么都没做好……我不值得他们拯救……”\n罗赞停下了脚步，庭院内早已空无一人，只剩已经燃成灰烬的遗物，和孤零零的棺木。棺内的老人面容安详，身上摆满了鲜花。\n“每当你来照看他后，他总喜欢拉着我聊天，可能是上了年纪吧，他总是记不清上次说过了什么，一个话题颠来倒去地说，说了七八遍都不罢休。”\n罗赞放下了洛茜，他的手搭在棺材边，看着熟悉的老朋友。\n“他总是说起年轻时候的光辉事迹，说起和我的几次争执。只是细节总是在变，今天是他做错了事，明天是我闯了祸。同样的内容每次都说得不一样。只是有一句话，他从来没有变过说法。”\n罗赞摸了摸洛茜的脑袋。\n“他每一次都会说，救下你，是他这一生最伟大的成就。”\n洛茜低下了头，她摘下胸前的浅色吊坠——老人赠与自己的那串吊坠，将其和鲜花摆在了一起。\n棺木阖上。女孩也不再哭泣。","CN_06","档案资料·四",1500,"profileVoice",[4129,4137,4141,4145,4149,4153,4157,4162,4167,4172,4177,4182,4187,4192,4197,4202,4207,4212,4217,4222,4227,4232,4237,4242,4247,4252,4257,4262,4267,4272,4277,4282,4287,4292,4297,4302,4307,4312,4317,4322,4327,4332,4337,4342,4347,4352,4357,4362,4367,4372,4377,4382,4387,4392,4397,4402,4407,4412,4417,4422,4427,4432,4437,4442,4447,4452,4457,4462,4467,4472,4477,4482,4487,4492,4497,4502,4507,4512,4517,4522,4527,4532],{"_4056":16,"_15":4091,"_4099":37,"_4100":37,"_4130":4131,"_4132":4133,"_4134":39,"_4135":4136},"voId","chr_0028_wulfa_chrbark_squad_01","voiceDesc","这是在管理员面前表现的机会！","voiceIndex","voiceTitle","行动准备1",{"_4056":16,"_15":4102,"_4099":37,"_4100":37,"_4130":4138,"_4132":4139,"_4134":55,"_4135":4140},"chr_0028_wulfa_chrbark_squad_02","我不会辜负大家的期待的！","行动准备2",{"_4056":16,"_15":4107,"_4099":37,"_4100":37,"_4130":4142,"_4132":4143,"_4134":58,"_4135":4144},"chr_0028_wulfa_chrbark_join_01","狼群的洛茜，管、管理员，有什么任务要交给我？","编入队伍1",{"_4056":16,"_15":4112,"_4099":37,"_4100":37,"_4130":4146,"_4132":4147,"_4134":64,"_4135":4148},"chr_0028_wulfa_chrbark_join_02","我会努力做到最好的，管理员！","编入队伍2",{"_4056":16,"_15":4117,"_4099":37,"_4100":37,"_4130":4150,"_4132":4151,"_4134":66,"_4135":4152},"chr_0028_wulfa_chrbark_weap_01","好帅气的武器！我在氏族里都没有见过这样的！","更换武器",{"_4056":16,"_15":4122,"_4099":37,"_4100":37,"_4130":4154,"_4132":4155,"_4134":68,"_4135":4156},"chr_0028_wulfa_chrbark_gear_01","穿上这身有点不太好移动……嗯？是管理员给我挑选的吗？那，就要它吧！肯定有什么深意……","更换装备",{"_4056":16,"_15":4158,"_4099":37,"_4100":37,"_4130":4159,"_4132":4160,"_4134":70,"_4135":4161},"chr_0028_wulfa_7","chr_0028_wulfa_chrup_skill_01","我是群狼的后裔！","激活天赋阵列",{"_4056":16,"_15":4163,"_4099":37,"_4100":37,"_4130":4164,"_4132":4165,"_4134":88,"_4135":4166},"chr_0028_wulfa_8","chr_0028_wulfa_chrup_level_01","成熟的战士是这样战斗的吗……嗯……这样……这样……然后再那样……好，我学会了！","观看作战记录",{"_4056":16,"_15":4168,"_4099":55,"_4100":39,"_4130":4169,"_4132":4170,"_4134":90,"_4135":4171},"chr_0028_wulfa_9","chr_0028_wulfa_chrup_promt01_01","晋……升？啊，我懂了，氏族里也有类似的仪式！不过我一次都没有体验过，感觉……还不赖？","精英化晋升1",{"_4056":16,"_15":4173,"_4099":55,"_4100":55,"_4130":4174,"_4132":4175,"_4134":413,"_4135":4176},"chr_0028_wulfa_10","chr_0028_wulfa_chrup_promt02_01","嘿嘿，我做得还不错吧？不这样可承担不了氏族的重任，我可是还要带领狼群名扬塔卫二呢。","精英化晋升2",{"_4056":16,"_15":4178,"_4099":55,"_4100":58,"_4130":4179,"_4132":4180,"_4134":102,"_4135":4181},"chr_0028_wulfa_11","chr_0028_wulfa_chrup_promt03_01","哼哼，对于我来说，晋升简直再简单不过了！下次晋升是什么时候？我已经做好准备了！要等待机会？那好吧……","精英化晋升3",{"_4056":16,"_15":4183,"_4099":55,"_4100":64,"_4130":4184,"_4132":4185,"_4134":96,"_4135":4186},"chr_0028_wulfa_12","chr_0028_wulfa_chrup_promt04_01","这就证明我是最出色的干员了吧？不知道卡特洛有没有这么顺利。下次再见到那家伙，我可要好好炫耀一下！","精英化晋升4",{"_4056":16,"_15":4188,"_4099":37,"_4100":37,"_4130":4189,"_4132":4190,"_4134":529,"_4135":4191},"chr_0028_wulfa_13","chr_0028_wulfa_introduce_01","我是洛茜娜，授名是狼珀，寓意是狼群的瑰宝！可要乖乖记好了哦！啊……管理员用自己喜欢的方式称呼我就好……","干员报到",{"_4056":16,"_15":4193,"_4099":37,"_4100":37,"_4130":4194,"_4132":4195,"_4134":568,"_4135":4196},"chr_0028_wulfa_14","chr_0028_wulfa_mono_switch_01","嗜血的时刻已至！我是说……用餐时间到了！","待命1",{"_4056":16,"_15":4198,"_4099":37,"_4100":37,"_4130":4199,"_4132":4200,"_4134":99,"_4135":4201},"chr_0028_wulfa_15","chr_0028_wulfa_mono_switch_02","我是狼群的爪牙！……好像不太对？反正……啊呜！","待命2",{"_4056":16,"_15":4203,"_4099":37,"_4100":37,"_4130":4204,"_4132":4205,"_4134":646,"_4135":4206},"chr_0028_wulfa_16","chr_0028_wulfa_sim_assign_work_01","对于精锐来说小菜一碟！","进驻设施",{"_4056":16,"_15":4208,"_4099":37,"_4100":37,"_4130":4209,"_4132":4210,"_4134":686,"_4135":4211},"chr_0028_wulfa_17","chr_0028_wulfa_sim_hello_lower_01","管、管理员！今天有什么任务要交给我吗？","打招呼1",{"_4056":16,"_15":4213,"_4099":64,"_4100":3402,"_4130":4214,"_4132":4215,"_4134":725,"_4135":4216},"chr_0028_wulfa_18","chr_0028_wulfa_sim_hello_max_01","管理员，可以传授我一些作为领导者的经验吗？","打招呼2",{"_4056":16,"_15":4218,"_4099":37,"_4100":37,"_4130":4219,"_4132":4220,"_4134":765,"_4135":4221},"chr_0028_wulfa_19","chr_0028_wulfa_sim_talk_lv01_01","终末地是怎么管理这么多干员的？什么……系统……什么……中控来着？搞不懂……不过很值得学习。","帝江号闲聊1",{"_4056":16,"_15":4223,"_4099":64,"_4100":3402,"_4130":4224,"_4132":4225,"_4134":804,"_4135":4226},"chr_0028_wulfa_20","chr_0028_wulfa_sim_talk_lv02_01","氏族的老狼让我多来帝江号上看看，他们说在这里能学习到作为领导者的知识和经验，尤其是在管理员身边。可是能抓到管理员的机会太少了！","帝江号闲聊2",{"_4056":16,"_15":4228,"_4099":64,"_4100":3402,"_4130":4229,"_4132":4230,"_4134":875,"_4135":4231},"chr_0028_wulfa_21","chr_0028_wulfa_sim_talk_lv02_02","帝江号上的哥哥姐姐们总把我当小孩子看待！可我已经是狼群的精锐了，下次要和他们说清楚才行，不能再这样了！！不过他们给的小点心都很好吃……","帝江号闲聊3",{"_4056":16,"_15":4233,"_4099":64,"_4100":4126,"_4130":4234,"_4132":4235,"_4134":914,"_4135":4236},"chr_0028_wulfa_22","chr_0028_wulfa_sim_talk_max_01","氏族事务优先！不过，如果终末地有什么突发情况，我肯定会第一时间赶到的。只是不知道管理员需不需要我的帮助……管理员那么优秀，哪怕没有我也能轻松解决危机的吧，但我还是想帮到管理员……怎么办呢……","帝江号闲聊4",{"_4056":16,"_15":4238,"_4099":64,"_4100":4126,"_4130":4239,"_4132":4240,"_4134":954,"_4135":4241},"chr_0028_wulfa_23","chr_0028_wulfa_sim_talk_max_02","我听说在帝江号上能找到卡特洛，可他在这儿怎么也是神出鬼没？嗯……该说是本性难移吗？再找不到他，罗赞爷爷可就要生气了！我可不想见到他发火的样子……管理员，您知道在哪里能找到卡特洛吗？","帝江号闲聊5",{"_4056":16,"_15":4243,"_4099":64,"_4100":4126,"_4130":4244,"_4132":4245,"_4134":993,"_4135":4246},"chr_0028_wulfa_24","chr_0028_wulfa_sim_talk_max_03","帝江号上为什么也查询不到管理员的相关记录呢？我好不容易才学会使用这个什么情报档案库……查到的净是些没用的信息，或者就是说我权限不够……呜……管理员，您有时间亲自跟我说说您的那些英勇事迹吗？","帝江号闲聊6",{"_4056":16,"_15":4248,"_4099":37,"_4100":37,"_4130":4249,"_4132":4250,"_4134":62,"_4135":4251},"chr_0028_wulfa_25","chr_0028_wulfa_sim_gift_give_01","管理员，这是我得到的战利品！全都送给您！别担心，我还会弄到更多的！","赠送礼物",{"_4056":16,"_15":4253,"_4099":37,"_4100":37,"_4130":4254,"_4132":4255,"_4134":1071,"_4135":4256},"chr_0028_wulfa_26","chr_0028_wulfa_sim_gift_recv_01","这是……给我的？我真的可以收下吗？谢谢您，我会好好领会管理员的用意的！","接收礼物",{"_4056":16,"_15":4258,"_4099":37,"_4100":37,"_4130":4259,"_4132":4260,"_4134":1111,"_4135":4261},"chr_0028_wulfa_27","chr_0028_wulfa_mono_self_line01","这个？这个……我只是在记录管理员您的言行，我觉得这些细节也有值得我学习的地方。啊……不能给您看，这是私人物品！","信赖对话1",{"_4056":16,"_15":4263,"_4099":64,"_4100":3402,"_4130":4264,"_4132":4265,"_4134":1150,"_4135":4266},"chr_0028_wulfa_28","chr_0028_wulfa_mono_self_line02","我我我、我听过好多好多管理员的传说。一直在想您会是个怎么样的人！直到真正见到您，才觉得您比传说中更令人钦佩。具体哪一点？嗯……行事方式、领导力，我、我也不知道该怎么形容……","信赖对话2",{"_4056":16,"_15":4268,"_4099":64,"_4100":3402,"_4130":4269,"_4132":4270,"_4134":1190,"_4135":4271},"chr_0028_wulfa_29","chr_0028_wulfa_mono_self_line03","狼群的孩子会在十三岁时参加成人礼。族人们会聚在一起，为新的“狼”选出授名。卡特洛的授名是“狼卫”，而我则是“狼珀”。我喜欢氏族赋予我的名字，每当念出它时，我就能感受到狼群的血在我的身体里流淌……管理员觉得这个名字怎么样？","信赖对话3",{"_4056":16,"_15":4273,"_4099":64,"_4100":4126,"_4130":4274,"_4132":4275,"_4134":56,"_4135":4276},"chr_0028_wulfa_30","chr_0028_wulfa_mono_self_line04","管理员，我最近的任务表现还算不错吧？那个……可以找您要一些奖励吗？啊……不用太费心，多和我聊聊天就可以了！……可以吗？","信赖对话4",{"_4056":16,"_15":4278,"_4099":64,"_4100":4126,"_4130":4279,"_4132":4280,"_4134":1268,"_4135":4281},"chr_0028_wulfa_31","chr_0028_wulfa_mono_self_line05","我知道自己的能力还不足以胜任狼群的领袖，但元老们坚持让我代理氏族事务……所以、所以我想在管理员身边学到更多，学习怎么成为一个值得信赖的人。还有佩丽卡姐姐、M3姐姐……我会让大家刮目相看的！","信赖对话5",{"_4056":16,"_15":4283,"_4099":37,"_4100":37,"_4130":4284,"_4132":4285,"_4134":1307,"_4135":4286},"chr_0028_wulfa_32","chr_0028_wulfa_mono_chat_line01","终末地的哥哥姐姐们教了我好多东西，佩丽卡姐姐给我讲了协议同步器的用法，艾维文娜姐姐带我去逛了商会的服装店和首饰店，还有、还有……赛希姐姐说要与我探讨平方时间复杂度……那是什么？","交谈1",{"_4056":16,"_15":4288,"_4099":37,"_4100":37,"_4130":4289,"_4132":4290,"_4134":119,"_4135":4291},"chr_0028_wulfa_33","chr_0028_wulfa_mono_chat_line02","这里的哥哥姐姐们都很照顾我，还会给我小礼物。但，我也是通过了狼群试炼的，名副其实的狼！成熟的狼不能喜欢孩子气的东西，应该喜欢匕首和钱币！所以我收集了很多。等我再长高一些，大家就可以放心把那些最危险的任务交给我来处理了！","交谈2",{"_4056":16,"_15":4293,"_4099":37,"_4100":37,"_4130":4294,"_4132":4295,"_4134":1385,"_4135":4296},"chr_0028_wulfa_34","chr_0028_wulfa_mono_chat_line03","我一直以为罗赞爷爷就是世界上最强大的人，但他却总告诉我天外有天，还总是提到管理员。后来我还在别处听说了许多您的传奇事迹，哇，世界上居然还有这样的人！我一直想来看看您真实的样子，自从听说您苏醒了，我就在计划什么时候来个突然袭击了……嘿嘿。","交谈3",{"_4056":16,"_15":4298,"_4099":37,"_4100":37,"_4130":4299,"_4132":4300,"_4134":1425,"_4135":4301},"chr_0028_wulfa_35","chr_0028_wulfa_mono_chat_line04","我的第一把匕首是一次紧急狩猎后的奖励！装着它的盒子金光灿灿的，我现在还保管得好好的呢。这也是我最喜欢的一把，总是带在身边，不过它不够锋利，只能用来切一切水果。如果管理员也喜欢的话，嗯……等我带上盒子一起送给您！","交谈4",{"_4056":16,"_15":4303,"_4099":37,"_4100":37,"_4130":4304,"_4132":4305,"_4134":1464,"_4135":4306},"chr_0028_wulfa_36","chr_0028_wulfa_mono_chat_line05","小时候的事吗……狼群总是处于和碾骨氏族的斗争中，是哥哥带着我四处求医问诊，也是族人们帮忙……啊……不应该在管理员面前说这些的！到此为止、到此为止，管理员，我们还是说一说关于您的事吧，我听说……","交谈5",{"_4056":16,"_15":4308,"_4099":37,"_4100":37,"_4130":4309,"_4132":4310,"_4134":158,"_4135":4311},"chr_0028_wulfa_37","chr_0028_wulfa_mono_about_line01","“源石会开辟道路。”啊……我、我只是试着说一下，完了完了……不会被管理员讨厌吧？我知道学习管理员不是一味地模仿这么简单，我只是觉得……这样确实很帅气……","话题：管理员",{"_4056":16,"_15":4313,"_4099":37,"_4100":37,"_4130":4314,"_4132":4315,"_4134":1542,"_4135":4316},"chr_0028_wulfa_38","chr_0028_wulfa_mono_about_line02","我也可以像哥哥一样使用狼群的授名作为代号，但……我还没怎么被氏族以外的人那么叫过，有点不好意思。直接用“洛茜娜”的话又会显得太小孩子气，我可不要！所以，我就用了“洛茜”作为自己的代号，那代表着我斗篷的颜色。","话题：代号",{"_4056":16,"_15":4318,"_4099":37,"_4100":37,"_4130":4319,"_4132":4320,"_4134":41,"_4135":4321},"chr_0028_wulfa_39","chr_0028_wulfa_mono_about_line03","我不会放过哪怕一个碾骨氏族的暴虐之徒！这是狼群和碾骨之间的世仇。为了救下我，有太多狼……太多家人死在了碾骨手下。这是狼群的仇恨，也是我的仇恨。狼群是这个世界上最记仇的氏族，终有一天，我们会算清这笔账！","话题：碾骨氏族",{"_4056":16,"_15":4323,"_4099":37,"_4100":37,"_4130":4324,"_4132":4325,"_4134":44,"_4135":4326},"chr_0028_wulfa_40","chr_0028_wulfa_mono_about_line04","那上面沾染着族人的鲜血……但对我来说，每当触碰到它时，我就会感到无比的安心，仿佛那些族人们不曾离我远去。这件斗篷刺痛着我，提醒我决不忘记仇恨，但它也给予了我勇气，还有家人的温暖……嗯，他们一直陪伴着我。","话题：斗篷",{"_4056":16,"_15":4328,"_4099":37,"_4100":37,"_4130":4329,"_4132":4330,"_4134":47,"_4135":4331},"chr_0028_wulfa_41","chr_0028_wulfa_mono_about_line05","我之前把收集来的匕首跟钱币都放进了一个特制的宝箱里，结果由于搬家弄丢了……里面还有些不能见人的东西……是小时候做的手工。我费了好大劲才把宝箱找回来。现在我可以把东西都存放在帝江号上啦！也可以拿存东西当理由来找哥哥姐姐们玩。啊，不对……是来学习！","话题：收集品",{"_4056":16,"_15":4333,"_4099":37,"_4100":37,"_4130":4334,"_4132":4335,"_4134":50,"_4135":4336},"chr_0028_wulfa_42","chr_0028_wulfa_mono_about_line06","荒野上的人所做的一切都是为了活下去，有时还能看到和我一样大的孩子在做坏事……哪怕是那些裂地者，有时铤而走险也只是为了生存。我觉得任何人都应该按自己的想法活着，但是……管理员，终末地是不是能改变这一切，让那些孩子也能和我一样去做自己想做的事呢？","话题：荒野上的人",{"_4056":16,"_15":4338,"_4099":37,"_4100":37,"_4130":4339,"_4132":4340,"_4134":234,"_4135":4341},"chr_0028_wulfa_43","chr_0028_wulfa_explore_point_common_01","相信我，那边肯定有好东西！","发现资源1",{"_4056":16,"_15":4343,"_4099":37,"_4100":37,"_4130":4344,"_4132":4345,"_4134":1805,"_4135":4346},"chr_0028_wulfa_44","chr_0028_wulfa_explore_point_valub_01","狼群不会遗漏任何荒野中的资源，留意那边！","发现资源2",{"_4056":16,"_15":4348,"_4099":37,"_4100":37,"_4130":4349,"_4132":4350,"_4134":1845,"_4135":4351},"chr_0028_wulfa_45","chr_0028_wulfa_explore_find_locked_01","那边有奇怪的气味，去看看吧！","发现未探索区域",{"_4056":16,"_15":4353,"_4099":37,"_4100":37,"_4130":4354,"_4132":4355,"_4134":272,"_4135":4356},"chr_0028_wulfa_46","chr_0028_wulfa_explore_find_danger_01","有危险的味道，要上吗？","发现强敌",{"_4056":16,"_15":4358,"_4099":37,"_4100":37,"_4130":4359,"_4132":4360,"_4134":1923,"_4135":4361},"chr_0028_wulfa_47","chr_0028_wulfa_interact_mine_valub_01","能分给我几块这样的石头吗？我想把它们镶嵌在匕首上。","采集矿物1",{"_4056":16,"_15":4363,"_4099":37,"_4100":37,"_4130":4364,"_4132":4365,"_4134":72,"_4135":4366},"chr_0028_wulfa_48","chr_0028_wulfa_interact_mine_valub_echo2_01","大家一起来，工作很快就结束了！","采集矿物2",{"_4056":16,"_15":4368,"_4099":37,"_4100":37,"_4130":4369,"_4132":4370,"_4134":60,"_4135":4371},"chr_0028_wulfa_49","chr_0028_wulfa_interact_treasure_valub_01","嗯……我本想着如果打不开的话，可以试试咬一口。","打开储藏箱",{"_4056":16,"_15":4373,"_4099":37,"_4100":37,"_4130":4374,"_4132":4375,"_4134":76,"_4135":4376},"chr_0028_wulfa_50","chr_0028_wulfa_interact_etherium_01","为什么有的醚质总会飞来飞去，有的却静止不动呢？真神奇。","获得醚质",{"_4056":16,"_15":4378,"_4099":37,"_4100":37,"_4130":4379,"_4132":4380,"_4134":78,"_4135":4381},"chr_0028_wulfa_51","chr_0028_wulfa_interact_blight_break_01","搞定啦！再也没有这些恼人的侵蚀啦！","消除侵蚀",{"_4056":16,"_15":4383,"_4099":37,"_4100":37,"_4130":4384,"_4132":4385,"_4134":80,"_4135":4386},"chr_0028_wulfa_52","chr_0028_wulfa_interact_rest_01","好好吃饭，好好睡觉，好好休整。这是群狼的智慧！","休整",{"_4056":16,"_15":4388,"_4099":37,"_4100":37,"_4130":4389,"_4132":4390,"_4134":82,"_4135":4391},"chr_0028_wulfa_53","chr_0028_wulfa_combat_suppuse_using_01","快，用这些来恢复！","使用战术物品1",{"_4056":16,"_15":4393,"_4099":37,"_4100":37,"_4130":4394,"_4132":4395,"_4134":84,"_4135":4396},"chr_0028_wulfa_54","chr_0028_wulfa_combat_suppuse_getheal_01","真有效，我好多了！","使用战术物品2",{"_4056":16,"_15":4398,"_4099":37,"_4100":37,"_4130":4399,"_4132":4400,"_4134":86,"_4135":4401},"chr_0028_wulfa_55","chr_0028_wulfa_combat_remind_danger_01","小心！有些不对劲！","危险提醒",{"_4056":16,"_15":4403,"_4099":37,"_4100":37,"_4130":4404,"_4132":4405,"_4134":386,"_4135":4406},"chr_0028_wulfa_56","chr_0028_wulfa_combat_hurt_lowhp_01","不行……没时间舔伤口了……","负伤",{"_4056":16,"_15":4408,"_4099":37,"_4100":37,"_4130":4409,"_4132":4410,"_4134":2309,"_4135":4411},"chr_0028_wulfa_57","chr_0028_wulfa_combat_dead_01","狼群……不会就此作罢的……","力竭",{"_4056":16,"_15":4413,"_4099":37,"_4100":37,"_4130":4414,"_4132":4415,"_4134":2348,"_4135":4416},"chr_0028_wulfa_58","chr_0028_wulfa_combat_remind_praise_01","漂亮的一击！","小队激励1",{"_4056":16,"_15":4418,"_4099":37,"_4100":37,"_4130":4419,"_4132":4420,"_4134":2388,"_4135":4421},"chr_0028_wulfa_59","chr_0028_wulfa_combat_remind_praise_02","哇啊！完美的配合！","小队激励2",{"_4056":16,"_15":4423,"_4099":37,"_4100":37,"_4130":4424,"_4132":4425,"_4134":74,"_4135":4426},"chr_0028_wulfa_60","chr_0028_wulfa_combat_remind_praise_echo2_01","嘿嘿嘿，还有更厉害的呢！","回应激励1",{"_4056":16,"_15":4428,"_4099":37,"_4100":37,"_4130":4429,"_4132":4430,"_4134":2497,"_4135":4431},"chr_0028_wulfa_61","chr_0028_wulfa_combat_remind_praise_echo2_02","这就是我们要的成果！","回应激励2",{"_4056":16,"_15":4433,"_4099":37,"_4100":37,"_4130":4434,"_4132":4435,"_4134":2536,"_4135":4436},"chr_0028_wulfa_62","chr_0028_wulfa_combat_intobattle_01","群狼的血液在沸腾！","作战开始1",{"_4056":16,"_15":4438,"_4099":37,"_4100":37,"_4130":4439,"_4132":4440,"_4134":463,"_4135":4441},"chr_0028_wulfa_63","chr_0028_wulfa_combat_intobattle_echo2_01","我可不想错过这次狩猎！","作战开始2",{"_4056":16,"_15":4443,"_4099":37,"_4100":37,"_4130":4444,"_4132":4445,"_4134":2614,"_4135":4446},"chr_0028_wulfa_64","chr_0028_wulfa_combat_outbattle_nor_01","狼群之名终将响彻大地！","作战胜利1",{"_4056":16,"_15":4448,"_4099":37,"_4100":37,"_4130":4449,"_4132":4450,"