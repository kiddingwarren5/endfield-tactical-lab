821":8822,"_8827":8828,"_8832":8833,"_8309":8837,"_8842":8843,"_8847":8848,"_8850":8851,"_8854":8855,"_8859":8860,"_8863":8864,"_8869":8870,"_8873":8874,"_8878":8879,"_8883":8884,"_8326":8888,"_8892":8893,"_8895":8896,"_8346":8900,"_8904":8905,"_8909":8910,"_8914":8915,"_8919":8920,"_8923":8924,"_8928":8929,"_8146":8934,"_8185":8938,"_8943":8944,"_8948":8949,"_8953":8954,"_8372":8958,"_8963":8964,"_8966":8967,"_8970":8971,"_8974":8975,"_8979":8980,"_8984":8985,"_8988":8989,"_8993":8994,"_8412":8998,"_9002":9003,"_9007":9008,"_9012":9013,"_9017":9018,"_9021":9022,"_9025":9026,"_9030":9031,"_9035":9036,"_9039":9040,"_9045":9046,"_9049":9050,"_9053":9054,"_9058":9059,"_9062":9063,"_9066":9067,"_9070":9071,"_9076":9077,"_9081":9082,"_9086":9087,"_9091":9092,"_9096":9097,"_9101":9102,"_9106":9107,"_9111":9112,"_9116":9117,"_9121":9122,"_9126":9127,"_9131":9132,"_9136":9137,"_9141":9142},"adv.electricFence",{"_4633":8632,"_8633":4064,"_15":8630,"_8634":4064,"_19":8635,"_8636":8202},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4633":8639,"_8633":8640,"_15":8637,"_8634":4064,"_19":8641,"_8636":8255},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4633":8643,"_8633":8644,"_15":8319,"_8634":8645,"_19":8646,"_8636":8384},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4633":8649,"_8633":4064,"_15":8647,"_8634":4064,"_19":8650,"_8636":8202},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4633":8653,"_8633":8654,"_15":8651,"_8634":4064,"_19":8655,"_8636":8202},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4633":8658,"_8633":4064,"_15":8656,"_8634":4064,"_19":8659,"_8636":8202},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4633":8662,"_8633":8663,"_15":8660,"_8634":4064,"_19":8664,"_8636":8296},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4633":8667,"_8633":4064,"_15":8665,"_8634":4064,"_19":8668,"_8636":8202},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4633":8671,"_8633":8672,"_15":8669,"_8634":4064,"_19":8673,"_8636":8202},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4633":8676,"_8633":4064,"_15":8674,"_8634":4064,"_19":8677,"_8636":4064},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4633":8680,"_8633":8681,"_15":8678,"_8634":4064,"_19":8682,"_8636":8255},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4633":8684,"_8633":8685,"_15":8134,"_8634":8686,"_19":8687,"_8636":8384},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4633":8690,"_8633":4064,"_15":8688,"_8634":4064,"_19":8691,"_8636":8202},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4633":8694,"_8633":8695,"_15":8692,"_8634":4064,"_19":8696,"_8636":8202},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4633":8699,"_8633":8700,"_15":8697,"_8634":4064,"_19":8701,"_8636":8202},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4633":8704,"_8633":4064,"_15":8702,"_8634":4064,"_19":8705,"_8636":8229},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4633":8708,"_8633":8709,"_15":8706,"_8634":4064,"_19":8710,"_8636":8202},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4633":8713,"_8633":4064,"_15":8711,"_8634":4064,"_19":8714,"_8636":8229},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4633":8716,"_8633":8717,"_15":8217,"_8634":8718,"_19":8719,"_8636":8296},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4633":8722,"_8633":8717,"_15":8720,"_8634":4064,"_19":8723,"_8636":8296},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4633":8726,"_8633":8727,"_15":8724,"_8634":8728,"_19":8729,"_8636":8229},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4633":8732,"_8633":4064,"_15":8730,"_8634":4064,"_19":8733,"_8636":8229},"持续时间内，受影响的目标暂停行动。","定身",{"_4633":8735,"_8633":8736,"_15":8223,"_8634":8737,"_19":8738,"_8636":8408},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4633":8741,"_8633":8736,"_15":8739,"_8634":4064,"_19":8742,"_8636":8408},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4633":8745,"_8633":4064,"_15":8743,"_8634":8746,"_19":8747,"_8636":4064},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4633":8749,"_8633":8750,"_15":8241,"_8634":8751,"_19":8752,"_8636":8358},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4633":8755,"_8633":8750,"_15":8753,"_8634":4064,"_19":8756,"_8636":8358},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4633":8759,"_8633":8760,"_15":8757,"_8634":4064,"_19":8761,"_8636":8202},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4633":8763,"_8633":8764,"_15":8248,"_8634":8765,"_19":8766,"_8636":8384},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4633":8769,"_8633":8770,"_15":8767,"_8634":8771,"_19":8772,"_8636":8229},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4633":8775,"_8633":8776,"_15":8773,"_8634":4064,"_19":8777,"_8636":8229},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4633":8779,"_8633":8780,"_15":8272,"_8634":8781,"_19":8782,"_8636":8255},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4633":8785,"_8633":4064,"_15":8783,"_8634":8786,"_19":8787,"_8636":8255},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4633":8790,"_8633":8791,"_15":8788,"_8634":4064,"_19":8792,"_8636":8202},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4633":8795,"_8633":8796,"_15":8793,"_8634":4064,"_19":8797,"_8636":8202},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4633":8800,"_8633":8801,"_15":8798,"_8634":4064,"_19":8802,"_8636":8255},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4633":8804,"_8633":8640,"_15":8279,"_8634":8805,"_19":8806,"_8636":8255},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4633":8809,"_8633":4064,"_15":8807,"_8634":8810,"_19":8811,"_8636":8229},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4633":8814,"_8633":8815,"_15":8812,"_8634":4064,"_19":8816,"_8636":8202},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4633":8819,"_8633":4064,"_15":8817,"_8634":4064,"_19":8820,"_8636":4064},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4633":8823,"_8633":8824,"_15":8821,"_8634":8825,"_19":8826,"_8636":8229},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4633":8829,"_8633":8830,"_15":8827,"_8634":4064,"_19":8831,"_8636":8202},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4633":8834,"_8633":4064,"_15":8832,"_8634":8835,"_19":8836,"_8636":8296},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4633":8838,"_8633":8839,"_15":8309,"_8634":8840,"_19":8841,"_8636":8296},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4633":8844,"_8633":8845,"_15":8842,"_8634":4064,"_19":8846,"_8636":8202},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4633":8722,"_8633":8839,"_15":8847,"_8634":4064,"_19":8849,"_8636":8296},"干员受到灼热附着","sys.tacticalItem",{"_4633":8852,"_8633":4064,"_15":8850,"_8634":4064,"_19":8853,"_8636":8202},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4633":8856,"_8633":8857,"_15":8854,"_8634":4064,"_19":8858,"_8636":8296},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4633":8741,"_8633":8861,"_15":8859,"_8634":4064,"_19":8862,"_8636":8408},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4633":8865,"_8633":8866,"_15":8863,"_8634":8867,"_19":8868,"_8636":8229},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4633":8871,"_8633":4064,"_15":8869,"_8634":4064,"_19":8872,"_8636":8229},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4633":8875,"_8633":8876,"_15":8873,"_8634":4064,"_19":8877,"_8636":8384},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4633":8880,"_8633":8881,"_15":8878,"_8634":4064,"_19":8882,"_8636":8408},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4633":8885,"_8633":8886,"_15":8883,"_8634":4064,"_19":8887,"_8636":8229},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4633":8889,"_8633":8890,"_15":8326,"_8634":8781,"_19":8891,"_8636":8255},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4633":8639,"_8633":8890,"_15":8892,"_8634":4064,"_19":8894,"_8636":8255},"干员受到冻结","ba.naturalvul",{"_4633":8897,"_8633":8898,"_15":8895,"_8634":4064,"_19":8899,"_8636":8358},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4633":8684,"_8633":8901,"_15":8346,"_8634":8902,"_19":8903,"_8636":8384},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4633":8906,"_8633":8907,"_15":8904,"_8634":4064,"_19":8908,"_8636":8202},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4633":8911,"_8633":8912,"_15":8909,"_8634":4064,"_19":8913,"_8636":8202},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4633":8916,"_8633":8917,"_15":8914,"_8634":4064,"_19":8918,"_8636":8202},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4633":8921,"_8633":4064,"_15":8919,"_8634":4064,"_19":8922,"_8636":8202},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4633":8925,"_8633":4064,"_15":8923,"_8634":8926,"_19":8927,"_8636":4064},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4633":8930,"_8633":8931,"_15":8928,"_8634":8932,"_19":8933,"_8636":8229},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4633":8935,"_8633":4064,"_15":8146,"_8634":8936,"_19":8937,"_8636":8358},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4633":8939,"_8633":8940,"_15":8185,"_8634":8941,"_19":8942,"_8636":8384},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4633":8945,"_8633":8946,"_15":8943,"_8634":4064,"_19":8947,"_8636":8202},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4633":8950,"_8633":8951,"_15":8948,"_8634":4064,"_19":8952,"_8636":8358},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4633":8955,"_8633":8956,"_15":8953,"_8634":4064,"_19":8957,"_8636":8202},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4633":8959,"_8633":8960,"_15":8372,"_8634":8961,"_19":8962,"_8636":8358},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4633":8755,"_8633":8960,"_15":8963,"_8634":4064,"_19":8965,"_8636":8358},"干员受到自然附着","ba.originium",{"_4633":8968,"_8633":4064,"_15":8966,"_8634":4064,"_19":8969,"_8636":8229},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4633":8972,"_8633":4064,"_15":8970,"_8634":4064,"_19":8973,"_8636":8384},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4633":8976,"_8633":8977,"_15":8974,"_8634":4064,"_19":8978,"_8636":8384},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4633":8981,"_8633":4064,"_15":8979,"_8634":8982,"_19":8983,"_8636":8392},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4633":8986,"_8633":4064,"_15":8984,"_8634":4064,"_19":8987,"_8636":8202},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4633":8990,"_8633":4064,"_15":8988,"_8634":8991,"_19":8992,"_8636":8408},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4633":8995,"_8633":8996,"_15":8993,"_8634":4064,"_19":8997,"_8636":8202},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4633":8999,"_8633":8861,"_15":8412,"_8634":9000,"_19":9001,"_8636":8408},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4633":9004,"_8633":9005,"_15":9002,"_8634":4064,"_19":9006,"_8636":8408},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4633":9009,"_8633":4064,"_15":9007,"_8634":9010,"_19":9011,"_8636":8229},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4633":9014,"_8633":4064,"_15":9012,"_8634":9015,"_19":9016,"_8636":4064},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4633":9019,"_8633":4064,"_15":9017,"_8634":4064,"_19":9020,"_8636":8202},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4633":9023,"_8633":4064,"_15":9021,"_8634":4064,"_19":9024,"_8636":8229},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4633":9027,"_8633":9028,"_15":9025,"_8634":4064,"_19":9029,"_8636":8202},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4633":9032,"_8633":4064,"_15":9030,"_8634":9033,"_19":9034,"_8636":8229},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4633":9037,"_8633":4064,"_15":9035,"_8634":4064,"_19":9038,"_8636":8202},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4633":9041,"_8633":9042,"_15":9039,"_8634":9043,"_19":9044,"_8636":8229},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4633":9047,"_8633":4064,"_15":9045,"_8634":4064,"_19":9048,"_8636":8229},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4633":9051,"_8633":4064,"_15":9049,"_8634":4064,"_19":9052,"_8636":8229},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4633":9055,"_8633":9056,"_15":9053,"_8634":4064,"_19":9057,"_8636":8202},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4633":9060,"_8633":4064,"_15":9058,"_8634":4064,"_19":9061,"_8636":8229},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4633":9064,"_8633":4064,"_15":9062,"_8634":4064,"_19":9065,"_8636":8229},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4633":9068,"_8633":4064,"_15":9066,"_8634":4064,"_19":9069,"_8636":8229},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4633":9072,"_8633":9073,"_15":9070,"_8634":9074,"_19":9075,"_8636":8229},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4633":9078,"_8633":9079,"_15":9076,"_8634":4064,"_19":9080,"_8636":8202},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4633":9083,"_8633":9084,"_15":9081,"_8634":4064,"_19":9085,"_8636":8202},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4633":9088,"_8633":9089,"_15":9086,"_8634":4064,"_19":9090,"_8636":8202},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4633":9093,"_8633":9094,"_15":9091,"_8634":4064,"_19":9095,"_8636":8202},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4633":9098,"_8633":9099,"_15":9096,"_8634":4064,"_19":9100,"_8636":8202},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4633":9103,"_8633":9104,"_15":9101,"_8634":4064,"_19":9105,"_8636":8202},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4633":9108,"_8633":9109,"_15":9106,"_8634":4064,"_19":9110,"_8636":8202},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4633":9113,"_8633":9114,"_15":9111,"_8634":4064,"_19":9115,"_8636":8202},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4633":9118,"_8633":9119,"_15":9116,"_8634":4064,"_19":9120,"_8636":8202},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4633":9123,"_8633":9124,"_15":9121,"_8634":4064,"_19":9125,"_8636":8202},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4633":9128,"_8633":9129,"_15":9126,"_8634":4064,"_19":9130,"_8636":8202},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4633":9133,"_8633":9134,"_15":9131,"_8634":4064,"_19":9135,"_8636":8202},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4633":9138,"_8633":9139,"_15":9136,"_8634":4064,"_19":9140,"_8636":8202},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4633":9143,"_8633":9144,"_15":9141,"_8634":4064,"_19":9145,"_8636":8202},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7839":9148,"_7481":9157,"_7485":9159,"_7487":9161,"_7489":9163,"_5791":9165,"_7492":9167,"_7495":9169,"_7498":9171,"_7501":9172,"_5797":9174,"_7506":9176,"_5960":9177,"_7511":9178,"_7513":9181,"_6022":9182,"_7518":9183,"_7521":9184,"_7525":9186,"_7529":9187,"_7533":9188,"_7536":9189,"_7539":9190,"_7543":9191,"_7547":9192,"_7091":9193,"_7553":9194,"_7557":9196,"_7561":9197,"_7565":9199,"_7569":9201,"_7573":9203,"_7577":9204,"_7581":9206,"_7585":9208,"_7589":9209,"_7593":9211,"_7597":9213,"_7601":9215,"_7605":9217,"_7609":9220,"_7613":9223,"_7617":9226,"_7621":9229,"_7625":9230,"_7629":9232,"_7633":9233,"_7637":9234,"_7641":9236,"_7645":9238,"_7649":9239,"_7653":9241,"_7657":9243,"_7661":9245,"_7665":9247,"_7669":9249,"_7673":9251,"_7677":9253,"_7680":9255,"_7684":9257,"_7688":9259,"_7692":9260,"_7696":9262,"_7700":9263,"_7704":9264,"_7708":9265,"_7712":9266,"_7716":9267,"_7720":9268,"_7724":9269,"_7728":9270,"_7732":9271,"_7736":9272,"_7740":9273,"_7744":9274,"_7748":9275,"_7752":9276,"_7756":9277,"_7760":9278,"_7764":9279,"_7768":9280,"_7772":9281,"_7775":9282,"_7779":9283,"_7783":9284,"_7787":9285,"_7791":9286,"_7795":9287,"_7799":9289,"_7803":9290,"_7807":9291,"_9292":9293,"_9294":9295,"_9297":9298,"_9299":9300,"_9301":9302,"_9303":9304,"_9305":9306,"_9307":9308,"_9309":9310,"_9311":9312,"_9313":9314,"_9316":9317,"_9319":9320,"_9321":9322,"_9324":9325,"_9327":9328,"_9329":9330},{"_9149":37,"_9150":4064,"_9151":39,"_9152":5099,"_9153":5099,"_9154":4064,"_9155":37,"_9156":37},"attributeType","bigIconName","defaultValue","hasMaxValue","hasMinValue","iconName","maxValue","minValue",{"_9149":39,"_9150":4064,"_9151":39,"_9152":5099,"_9153":4082,"_9154":9158,"_9155":37,"_9156":37},"icon_attribute_maxHp",{"_9149