"_36":58,"_38":37},{"_36":60,"_38":3908},1.48469387755102,{"_36":62,"_38":3910},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3930,"_102":64},{"_33":3931},[3932,3933,3935,3937,3939,3941,3943,3945,3946,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966],{"_36":37,"_38":963},{"_36":41,"_38":3934},98.35051546391752,{"_36":44,"_38":3936},100.5360824742268,{"_36":47,"_38":3938},172.71466442247052,{"_36":50,"_38":3940},121.45221965074717,{"_36":39,"_38":3942},5888,{"_36":55,"_38":3944},324,{"_36":58,"_38":37},{"_36":60,"_38":3947},1.48979591836735,{"_36":62,"_38":2013},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":3968,"_102":64},{"_33":3969},[3970,3972,3974,3976,3978,3980,3982,3984,3985,3987,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006],{"_36":37,"_38":3971},98,{"_36":41,"_38":3973},99.2783505154639,{"_36":44,"_38":3975},101.48453608247422,{"_36":47,"_38":3977},174.28826004628706,{"_36":50,"_38":3979},122.57559436145618,{"_36":39,"_38":3981},5944,{"_36":55,"_38":3983},327,{"_36":58,"_38":37},{"_36":60,"_38":3986},1.49489795918367,{"_36":62,"_38":3988},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},{"_31":4008,"_102":64},{"_33":4009},[4010,4012,4014,4016,4018,4020,4022,4024,4025,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045],{"_36":37,"_38":4011},99,{"_36":41,"_38":4013},100.2061855670103,{"_36":44,"_38":4015},102.43298969072164,{"_36":47,"_38":4017},175.8618556701036,{"_36":50,"_38":4019},123.69896907216523,{"_36":39,"_38":4021},6000,{"_36":55,"_38":4023},330,{"_36":58,"_38":37},{"_36":60,"_38":4026},1.5,{"_36":62,"_38":2051},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":94},{"_36":98,"_38":99},{"_36":101,"_38":39},"charBattleTagIds",[4048,4049],"tag_02","tag_12","charId","charIllustInitPos",{"_4053":4054,"_4055":4056},"x",-140,"y",-186,"charPassiveUIPrefabName","","charTypeId","Pulse","cvName",{"_4063":4064,"_4065":4066,"_4067":4068,"_4069":4070,"_4050":16},"ChiCVName","陈婷婷","EngCVName","Jane Jackson","JapCVName","若山诗音","KorCVName","柳惠知","defaultWeaponId","wpn_funnel_0002","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Perlica","mainAttrType","phoneticName","profession","profileRecord",[4084,4095,4100,4105,4110,4115],{"_4050":16,"_15":4085,"_4086":4087,"_4088":4089,"_4090":39,"_4091":4092,"_4093":37,"_4094":37},"chr_0004_pelica_1","recordDesc","【代号】佩丽卡\n【性别】女\n【身份认证】终末地工业\n【生日】3月16日\n【种族】黎博利\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：标准\n战术规划：卓越\n源石技艺适应性：优良","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4050":16,"_15":4096,"_4086":4097,"_4088":4098,"_4090":55,"_4091":4099,"_4093":37,"_4094":37},"chr_0004_pelica_2","佩丽卡，终末地工业的监督，也是终末地的官方发言人之一，主要负责管理和推进协议源石技术的开发与应用，同时也承担帝江号的管理工作。\n\n对她是否配得上“监督”这一职位的质疑，我已经很久没听到了。她用实绩打消了所有人的怀疑，也用事实印证了M3的说法：“这个职位是因为佩丽卡才存在，别搞错了先后顺序。”确实连我也不敢相信，一个如此年轻的人能够担起协助管理整个终末地工业的重任，但在她的管理下，终末地所追求的未来景象更加清晰了。\n不过，她也不是事事都能处理妥当，比如，作为协助管理危机处理小组的关键人物，她不该总是陪着小组成员在第一线冒险。就算她继续驳回我的申请，我还是会督促她重新评估风险。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4050":16,"_15":4101,"_4086":4102,"_4088":4103,"_4090":58,"_4091":4104,"_4093":37,"_4094":37},"chr_0004_pelica_3","和终末地工业的不少干员一样，儿时的佩丽卡监督在灾难中幸存下来，并和其他失去家庭的孩子一同接受了管理员和终末地工业的庇护。在学习和成长的过程中，她对协议技术表现出了极大的好奇，并逐渐开始接触终末地工业在塔卫二的各项基础事务。不到两年的时间，她的足迹就已经遍布这颗星球的大小城市，她对我们所面对威胁的认知也远超常人。而她对协议技术的热情，也促使她加入了研发中心，并在日后帮助终末地工业在协议技术开发与应用领域取得了重大突破。之后她也顺理成章地被正式任命为“监督”，开始真正掌舵帝江号这个高悬于塔卫二人工静止轨道的庞然大物。\n\n【权限记录】\n佩丽卡的过去当然不可能像公开记录里那样总是被幸运所眷顾。\n十多年前，你在筹备远征时救下了她，在那个她还惶恐茫然的时候给了她最大的支持。但她也无法预料到不久后的远征会再一次改变她的生活……她失去了你。后来的日子里，和她一起被你救来的孩子大多也都开始了新生活，甚至连那个和她情同姐妹的孩子，莱西娅，也离开了帝江号，选择和她分道扬镳。\n身边朋友的逐渐离去，肩上扛下的责任越来越重，协议技术的研发屡遭瓶颈……\n她还是固执地留在了这条最难走的路上，并且用实际行动折服了我们。诚然，她一路走来得到了许多人的支持，但她自己付出的努力和经历的坎坷……我比任何人都清楚。\n去和她聊聊吧，她已经等了太久。\n——M3的语音备忘录","CN_03","档案资料·一",{"_4050":16,"_15":4106,"_4086":4107,"_4088":4108,"_4090":64,"_4091":4109,"_4093":64,"_4094":3633},"chr_0004_pelica_4","帝江号上其他干员总说，佩丽卡监督似乎有一种神奇的魔力。只要有她在，任何问题都会迎刃而解。\n所以当我得知能有幸在她身边学习的时候，我一度兴奋到失眠，可现实狠狠重击了我。因为没法适应她的工作强度还有严苛的标准，我一度考虑中途退出……但我实在不舍得放弃这次宝贵的机会。\n因为马上就是管理员预计苏醒的日子，每个人都绷着一根弦，连佩丽卡监督也不例外。在她日程全被塞满的情况下，她还要见缝插针地去见各部门的前辈，来确保工作万无一失。\n但这些临时的私密小会议之后，她的脸色总是不太好，难道有些事情连她也搞不定？我只能埋怨自己帮不上什么忙。\n我的无所适从被她看在眼里，她主动安慰了我，还塞给我从没见过的怪味鳞肉丸一起分享。那味道呛得我眼泪直流，佩丽卡监督反倒看着我心满意足地笑起来……那一天的苦恼，也都随着我的眼泪一起被冲刷一空。\n那一瞬间我才突然意识到，佩丽卡监督……的确存在那种魔力。\n——一位见习后勤干员的工作日志，她仍在继续申请留在佩丽卡监督身边见习的机会\n\n【未被成功删除的记录】\n“她也去找你了吧，卡拉德？请教要怎么和她在乎的管理员正常相处，对吧？”\n“不愧是搞情报的，不在帝江号消息还这么灵通。她匆忙来训练室找我的时候，我还以为是什么环节出了岔子。结果一本正经地问这个，吓我一跳。”\n“习惯了她当监督的日子，都快忘了她也不是真的无所不能。不过我喜欢她和我通信时忸怩的样子，还是和小时候一样可爱。”\n“所以你给了什么建议？”\n“和你一样喽，什么也没给。其他老家伙也都差不多，大家都准备看好戏呢。”\n“不过我打赌，她重新见到管理员的时候一定会藏得很好。”\n“反正M3肯定会陪着她，你还怕没法知道现场的所有细节？”\n“也是。还有，别忘了，我们答应过她要绝对保密。尤其是对管理员。”\n“放心吧，卡拉德。我的嘴可是最严的，这是职业操守。但这样就看不到小佩丽卡生闷气的样子，是不是有点太遗憾了？”","CN_04","档案资料·二",{"_4050":16,"_15":4111,"_4086":4112,"_4088":4113,"_4090":66,"_4091":4114,"_4093":64,"_4094":3633},"chr_0004_pelica_5","无论你在帝江号上的哪个地方偶遇佩丽卡监督，她总会平静地向你问好，然后继续投入到自己手头上的工作中，以至于不少人猜测监督的真面目是一台披着黎博利皮的机器，可以完美执行某个超级思维的指令。虽然这种玩笑话在新进干员间流传甚广，但监督本人不光不抵触，还偶尔故意在新人面前“调皮”一下，帮忙缓解干员们的压力。\n按照马丁·马文·马伦的非官方说法，正式担任监督之后，佩丽卡强迫自己用最恰当的面貌去履行自己的职责。但积累的情绪和压力总归需要一个宣泄口。而在管理员回归之前，佩丽卡就已经找到了一套足够让她放松自己的办法。“你听说过‘机油与机械的热弹创意赛’吗？据说它最初源于某位血魔天才和神秘机械师的创意对决。研发中心的前辈也把这项古老的泰拉活动带来了终末地。现如今，热弹赛中出现的怪点子不光给干员们带来了许多欢笑，还极大促进了我们的技术革新。但很少有人知道，这项活动在终末地的真正推手是佩丽卡监督。毕竟她从没有正式参过赛，也很少发表看法。事实上，她重启这项活动的初衷，只是给自己创造一个能缓解手痒，验证脑子里古怪想法的平台。”\n\n虽然今年我被禁止参赛，但也不算缺席吧。这辆获奖的“电浆轰鸣”还是我起的名！它主人带着“把引力铳械塞进加速引擎”的想法找到我时，我就知道有搞头。最后拆了不少好铳才成功呢……欸？当、当然没有动我爸的宝贝库存！\n——蝉联多届热弹赛冠军的铳械天才少女\n\n这辆车刚拿下了新都筑地下热力赛的冠军啊！怎么会在帝江号上？！\n——某位竞速爱好者\n\n“电浆轰鸣”？主人是“嫌疑人伊里奇”？佩丽卡，这又是哪个部门冒出来的新人？\n——陈千语","CN_05","档案资料·三",{"_4050":16,"_15":4116,"_4086":4117,"_4088":4118,"_4090":68,"_4091":4119,"_4093":64,"_4094":4120},"chr_0004_pelica_6","M3，这份文件作为“零号委托”的附件封存，不可强制生效。\n我现在任命佩丽卡为“‘零号委托’签署人”。\n但是否生效需完全遵循其个人意愿。\n如果她最终决定留在终末地工业，那由你作为执行人，带她去见创始人。\n\n【权限记录】\n“你决定了？”\n“留在终末地，我不需要犹豫，M3。”\n“那好吧。跟我来，创始人要见你。”\n…………\n“我们还是见面了，佩丽卡监督。”\n“监、监督？等等，你的样子——”\n“我们的时间不多了。”","CN_06","档案资料·四",1500,"profileVoice",[4123,4131,4135,4139,4143,4147,4151,4156,4161,4166,4171,4176,4181,4186,4191,4196,4201,4206,4211,4216,4221,4226,4231,4236,4241,4246,4251,4256,4261,4266,4271,4276,4281,4286,4291,4296,4301,4306,4311,4316,4321,4326,4331,4336,4341,4346,4351,4356,4361,4366,4371,4376,4381,4386,4391,4396,4401,4406,4411,4416,4421,4426,4431,4436,4441,4446,4451,4456,4461,4466,4471,4476,4481,4486,4491,4496,4501,4506,4511,4516,4521,4526,4531,4536],{"_4050":16,"_15":4085,"_4093":37,"_4094":37,"_4124":4125,"_4126":4127,"_4128":39,"_4129":4130},"voId","chr_0004_pelica_chrbark_squad_01","voiceDesc","全员待命，随时可以出发。","voiceIndex","voiceTitle","行动准备1",{"_4050":16,"_15":4096,"_4093":37,"_4094":37,"_4124":4132,"_4126":4133,"_4128":55,"_4129":4134},"chr_0004_pelica_chrbark_squad_02","终末地危机处理小组已就绪。","行动准备2",{"_4050":16,"_15":4101,"_4093":37,"_4094":37,"_4124":4136,"_4126":4137,"_4128":58,"_4129":4138},"chr_0004_pelica_chrbark_join_01","指挥权限暂时交给你了，管理员。","编入队伍1",{"_4050":16,"_15":4106,"_4093":37,"_4094":37,"_4124":4140,"_4126":4141,"_4128":64,"_4129":4142},"chr_0004_pelica_chrbark_join_02","带领我们更进一步吧，管理员。","编入队伍2",{"_4050":16,"_15":4111,"_4093":37,"_4094":37,"_4124":4144,"_4126":4145,"_4128":66,"_4129":4146},"chr_0004_pelica_chrbark_weap_01","该研究一下适合这件武器的作战方式了。","更换武器",{"_4050":16,"_15":4116,"_4093":37,"_4094":37,"_4124":4148,"_4126":4149,"_4128":68,"_4129":4150},"chr_0004_pelica_chrbark_gear_01","这也是集成工业系统的成果。","更换装备",{"_4050":16,"_15":4152,"_4093":37,"_4094":37,"_4124":4153,"_4126":4154,"_4128":70,"_4129":4155},"chr_0004_pelica_7","chr_0004_pelica_chrup_skill_01","只需略微调校……这便于取得更多战果。","激活天赋阵列",{"_4050":16,"_15":4157,"_4093":37,"_4094":37,"_4124":4158,"_4126":4159,"_4128":88,"_4129":4160},"chr_0004_pelica_8","chr_0004_pelica_chrup_level_01","我们曾这样不断抵抗……期待着你能再一次归来。","观看作战记录",{"_4050":16,"_15":4162,"_4093":55,"_4094":39,"_4124":4163,"_4126":4164,"_4128":90,"_4129":4165},"chr_0004_pelica_9","chr_0004_pelica_chrup_promt01_01","感谢你的认可，管理员。我会继续努力的。","精英化晋升1",{"_4050":16,"_15":4167,"_4093":55,"_4094":55,"_4124":4168,"_4126":4169,"_4128":94,"_4129":4170},"chr_0004_pelica_10","chr_0004_pelica_chrup_promt02_01","作为监督，我还有很多不成熟的地方，但我已经下定了决心，责无旁贷。","精英化晋升2",{"_4050":16,"_15":4172,"_4093":55,"_4094":58,"_4124":4173,"_4126":4174,"_4128":101,"_4129":4175},"chr_0004_pelica_11","chr_0004_pelica_chrup_promt03_01","你又一次选择了信任我……管理员。我绝对不会辜负你的期待。","精英化晋升3",{"_4050":16,"_15":4177,"_4093":55,"_4094":64,"_4124":4178,"_4126":4179,"_4128":96,"_4129":4180},"chr_0004_pelica_12","chr_0004_pelica_chrup_promt04_01","没什么，只是得到你的夸赞……让我有些怀念过去。那曾是我努力的唯一理由，而现在，我很庆幸能够带领着终末地，站在你的身旁。","精英化晋升4",{"_4050":16,"_15":4182,"_4093":37,"_4094":37,"_4124":4183,"_4126":4184,"_4128":526,"_4129":4185},"chr_0004_pelica_13","chr_0004_pelica_introduce_01","我一直坚信，你会再一次为我们指明前进的方向。欢迎回归终末地，管理员。","干员报到",{"_4050":16,"_15":4187,"_4093":37,"_4094":37,"_4124":4188,"_4126":4189,"_4128":565,"_4129":4190},"chr_0004_pelica_14","chr_0004_pelica_mono_switch_01","随时准备。","待命1",{"_4050":16,"_15":4192,"_4093":37,"_4094":37,"_4124":4193,"_4126":4194,"_4128":98,"_4129":4195},"chr_0004_pelica_15","chr_0004_pelica_mono_switch_02","干员佩丽卡，待命中。","待命2",{"_4050":16,"_15":4197,"_4093":37,"_4094":37,"_4124":4198,"_4126":4199,"_4128":643,"_4129":4200},"chr_0004_pelica_16","chr_0004_pelica_sim_assign_work_01","高效的规划，我会努力的。","进驻设施",{"_4050":16,"_15":4202,"_4093":37,"_4094":37,"_4124":4203,"_4126":4204,"_4128":683,"_4129":4205},"chr_0004_pelica_17","chr_0004_pelica_sim_hello_lower_01","适应得还好吗，管理员？","打招呼1",{"_4050":16,"_15":4207,"_4093":64,"_4094":3633,"_4124":4208,"_4126":4209,"_4128":722,"_4129":4210},"chr_0004_pelica_18","chr_0004_pelica_sim_hello_max_01","管理员，注意休息，不要勉强自己。","打招呼2",{"_4050":16,"_15":4212,"_4093":37,"_4094":37,"_4124":4213,"_4126":4214,"_4128":762,"_4129":4215},"chr_0004_pelica_19","chr_0004_pelica_sim_talk_lv01_01","自从管理员醒来以后，帝江号每天都在变得更有活力……我很期待未来的日子，管理员。","帝江号闲聊1",{"_4050":16,"_15":4217,"_4093":64,"_4094":3633,"_4124":4218,"_4126":4219,"_4128":801,"_4129":4220},"chr_0004_pelica_20","chr_0004_pelica_sim_talk_lv02_01","管理员，你的气色好多了。如果还有什么需要，可以随时找我。","帝江号闲聊2",{"_4050":16,"_15":4222,"_4093":64,"_4094":3633,"_4124":4223,"_4126":4224,"_4128":872,"_4129":4225},"chr_0004_pelica_21","chr_0004_pelica_sim_talk_lv02_02","管理员，你的需求是最优先的。我可以把其他事情先放下……或是交给菲奥娜去办。","帝江号闲聊3",{"_4050":16,"_15":4227,"_4093":64,"_4094":4120,"_4124":4228,"_4126":4229,"_4128":911,"_4129":4230},"chr_0004_pelica_22","chr_0004_pelica_sim_talk_max_01","中央环厅总是这么繁忙，这意味着一种责任。百余年来，一代又一代的终末地干员都在为复兴文明环带而努力。也许有一天，帝江号会落回到地上，在我们亲手建设的乐土中小憩片刻吧。","帝江号闲聊4",{"_4050":16,"_15":4232,"_4093":64,"_4094":4120,"_4124":4233,"_4126":4234,"_4128":951,"_4129":4235},"chr_0004_pelica_23","chr_0004_pelica_sim_talk_max_02","有很多干员并不会停留在帝江号，特别是精英干员们。比起逗留在天空之上的安全地带，危机四伏的文明环带更需要他们。没关系，你们迟早会见面的。到时候，我会好好向管理员介绍大家。","帝江号闲聊5",{"_4050":16,"_15":4237,"_4093":64,"_4094":4120,"_4124":4238,"_4126":4239,"_4128":990,"_4129":4240},"chr_0004_pelica_24","chr_0004_pelica_sim_talk_max_03","曾经我们在帝江号上这样交谈的时候，我还是个只有现在一半高的孩子。如今物换星移，我长大了，帝江号也有许多变化，管理员你却……依旧如初。","帝江号闲聊6",{"_4050":16,"_15":4242,"_4093":37,"_4094":37,"_4124":4243,"_4126":4244,"_4128":62,"_4129":4245},"chr_0004_pelica_25","chr_0004_pelica_sim_gift_give_01","管理员，我为你申请了一些补给，应该能帮上你的忙。你有时候太过努力了，但其实，依赖一下我和终末地也没什么不好。","赠送礼物",{"_4050":16,"_15":4247,"_4093":37,"_4094":37,"_4124":4248,"_4126":4249,"_4128":1068,"_4129":4250},"chr_0004_pelica_26","chr_0004_pelica_sim_gift_recv_01","非常感谢，管理员，我一定会珍惜的。","接收礼物",{"_4050":16,"_15":4252,"_4093":37,"_4094":37,"_4124":4253,"_4126":4254,"_4128":1108,"_4129":4255},"chr_0004_pelica_27","chr_0004_pelica_mono_self_line01","管理员，你需要定期检查身体，别太勉强自己。特别是，不要太滥用自己的源石技艺——如果还有干员请你维修Delta型机器人……请拒绝！","信赖对话1",{"_4050":16,"_15":4257,"_4093":64,"_4094":3633,"_4124":4258,"_4126":4259,"_4128":1147,"_4129":4260},"chr_0004_pelica_28","chr_0004_pelica_mono_self_line02","小时候，我走遍了帝江号的每一个角落，在心里为每一个房间都取了昵称。我以为我不会再回到地面上了，我觉得这艘船就是我的家。可是之后，为了能帮到管理员，我还是离开了帝江号，去了塔卫二的很多地方。帝江号看起来变得狭窄了，可我始终觉得……它能装得下我的所有回忆。","信赖对话2",{"_4050":16,"_15":4262,"_4093":64,"_4094":3633,"_4124":4263,"_4126":4264,"_4128":1187,"_4129":4265},"chr_0004_pelica_29","chr_0004_pelica_mono_self_line03","陈其实是我作为监督亲自招募的第一位干员，也是我最好的朋友之一。我在宏科院的合作项目现场偶遇了陈千语……呵呵，她总说那时候我不苟言笑，担心我，所以才主动帮了我的忙。也许真的是这样。刚成为监督的时候，有太多东西要学习，让我甚至无暇去关注身边的人和事。如果不是她的洒脱和笑容，恐怕我会走不少弯路吧。","信赖对话3",{"_4050":16,"_15":4267,"_4093":64,"_4094":4120,"_4124":4268,"_4126":4269,"_4128":56,"_4129":4270},"chr_0004_pelica_30","chr_0004_pelica_mono_self_line04","不用担心，管理员。我当然也是有休息时间的，不要听陈胡说。放假的时候会做什么？会看书。嗯，文学和理论类的都看，为了能在未来的工作中——抱着这种想法就不算休息了？那……其实我会一个人骑着摩托在开拓区驰骋。我、我只告诉了管理员，其他干员要是知道了会担心的。我能理解他们，但我只是想听听这颗星球的风声。","信赖对话4",{"_4050":16,"_15":4272,"_4093":64,"_4094":4120,"_4124":4273,"_4126":4274,"_4128":1265,"_4129":4275},"chr_0004_pelica_31","chr_0004_pelica_mono_self_line05","醒了吗，管理员？累的话，就早点休息吧。睡脸？管理员的睡脸我已经看了十年了。嗯？当然了，以前我总是会和其他孩子一起去探望石棺中沉睡的管理员。后来，就只剩我一个人了。通过干员测试的时候，当上监督的时候……我都会去探望沉睡中的管理员。你不必愧疚，毕竟我本来就打算等管理员恢复记忆之后，一股脑说给你听的。","信赖对话5",{"_4050":16,"_15":4277,"_4093":37,"_4094":37,"_4124":4278,"_4126":4279,"_4128":1304,"_4129":4280},"chr_0004_pelica_32","chr_0004_pelica_mono_chat_line01","终末地与这片大地上的许多组织都有合作。公约阵营自不必说，环塔商会是现代物流和物资供应的保障，联盟工团则是开拓区最有力的盟友，宏科院始终站在技术前沿与我们互通有无。正因为有这样的盟友，我们才能在这个残酷的新家园站稳脚跟。","交谈1",{"_4050":16,"_15":4282,"_4093":37,"_4094":37,"_4124":4283,"_4126":4284,"_4128":118,"_4129":4285},"chr_0004_pelica_33","chr_0004_pelica_mono_chat_line02","从没当面见过菲奥娜？啊……菲奥娜稍微有些特殊。她说过，她很喜欢现在这样在作战通讯中和大家沟通的感觉。特别是对于管理员你，菲奥娜很担心……见到她本人以后，你对她的态度会有很大的改变。","交谈2",{"_4050":16,"_15":4287,"_4093":37,"_4094":37,"_4124":4288,"_4126":4289,"_4128":1382,"_4129":4290},"chr_0004_pelica_34","chr_0004_pelica_mono_chat_line03","我作战的样子看起来像是一位指挥家？这是我接受作战训练的时候留下的习惯……传说在泰拉时期，莱塔尼亚人会将音乐和法术天赋联系起来，而教我使用法术战斗的老师也是一位和音乐有关的奇才。我的战斗天赋算不上出众，但只要把法术的流向理解为韵律和节奏，我很快就能抓住诀窍。","交谈3",{"_4050":16,"_15":4292,"_4093":37,"_4094":37,"_4124":4293,"_4126":4294,"_4128":1422,"_4129":4295},"chr_0004_pelica_35","chr_0004_pelica_mono_chat_line04","在帝江号上也能看见的那片极光，就像是塔卫二这颗星球开出的一朵诡异的花。北方的天幕被超域能量笼罩，极光像是一面墙阻拦在我们的面前。墙的那一边，曾经是无数人类的理想之地。如今，那里只剩下一片废墟，和占据了那片废墟的……敌人。","交谈4",{"_4050":16,"_15":4297,"_4093":37,"_4094":37,"_4124":4298,"_4126":4299,"_4128":157,"_4129":4300},"chr_0004_pelica_36","chr_0004_pelica_mono_chat_line05","管理员，你觉得帝江号的商铺应该新增什么品类？没什么，只是商务办公室定期会进行调研报告。帝江号的生活区并不大，常驻干员也不算很多，不过，只靠自动贩卖机确实缺乏了点人情味……咖啡厅怎么样？管理员，你会想在休息的时候去买一杯咖啡吗？","交谈5",{"_4050":16,"_15":4302,"_4093":37,"_4094":37,"_4124":4303,"_4126":4304,"_4128":1500,"_4129":4305},"chr_0004_pelica_37","chr_0004_pelica_mono_about_line01","……抱歉，管理员。这是我的私心……但是我不希望在现在的管理员面前主动提起我们相遇的过去。我希望——不是作为终末地的监督，只是作为佩丽卡——我希望管理员能……自己回想起那些回忆。","话题：相遇",{"_4050":16,"_15":4307,"_4093":37,"_4094":37,"_4124":4308,"_4126":4309,"_4128":1539,"_4129":4310},"chr_0004_pelica_38","chr_0004_pelica_mono_about_line02","帝江号很壮观，对吧。如果把协议技术理解为源石网络，帝江号就是所有协议源石的总服务器。不仅如此，它也是泰拉文明穿过星门，抵达塔卫二后的历史缩影。帝江号经历过战争和混乱，但最终翱翔在了这片星海之中。也许终有一天，所有人都可以不再受引力的束缚，如前人所想的那样，漫步于繁星身侧。","话题：帝江号",{"_4050":16,"_15":4312,"_4093":37,"_4094":37,"_4124":4313,"_4126":4314,"_4128":41,"_4129":4315},"chr_0004_pelica_39","chr_0004_pelica_mono_about_line03","很久以前，我会用“姐姐”来称呼M3。后来，我正式成为了终末地的干员，M3就不让我那么叫她了。对我来说，她真的就像姐姐一样，亲切，乐观，无所不能。不过这些年，她越来越少出现在帝江号上了。我知道她有一个独一无二的使命，但如果可以，我希望现在的终末地可以为她分担。","话题：M3",{"_4050":16,"_15":4317,"_4093":37,"_4094":37,"_4124":4318,"_4126":4319,"_4128":44,"_4129":4320},"chr_0004_pelica_40","chr_0004_pelica_mono_about_line04","很少有人知道，塔卫二这颗遥远的星球才是我们真正的起源，而即使知道这一点，也无法磨灭很多人对于泰拉故土的怀念。离开泰拉，前往塔卫二，就像是孩子离开柔软的摇篮，投入母亲的怀抱。可是，对我来说，情况完全相反……我在塔卫二加入了终末地，结识了管理员，而泰拉似乎只是一个使命的符号而已。","话题：塔卫二与泰拉",{"_4050":16,"_15":4322,"_4093":37,"_4094":37,"_4124":4323,"_4126":4324,"_4128":47,"_4129":4325},"chr_0004_pelica_41","chr_0004_pelica_mono_about_line05","参与零号委托的并不止我一人，而且参与者之间，也未必知道其他人负责的内容是什么。在过去的管理员意识到自己的情况时，就已经做好了很多的布置。在你这次醒来之前，我无数次预演过执行零号委托的那一刻……可当真的再见到你，好像很多话顺理成章地就说出口了。","话题：零号委托",{"_4050":16,"_15":4327,"_4093":37,"_4094":37,"_4124":4328,"_4126":4329,"_4128":50,"_4129":4330},"chr_0004_pelica_42","chr_0004_pelica_mono_about_line06","集成工业系统是终末地近些年的主要攻坚对象。它表面上的功能和意义，想必管理员已经深刻体会到了。不过，之所以执着于协议技术，当然是有更深层次的目的。源石即是信息，即是一切飘渺概念的体现和结晶。最终，我们能够“建设”和“生产”的，远不止工业品那么简单。","话题：集成工业系统",{"_4050":16,"_15":4332,"_4093":37,"_4094":37,"_4124":4333,"_4126":4334,"_4128":1764,"_4129":4335},"chr_0004_pelica_43","chr_0004_pelica_mono_about_line07","危机处理小组其实是管理员设立并领导的一支行动小队，一度是塔卫二名闻遐迩的尖兵队伍。后来，小队指挥权移交给了创始人和M3，但依然发挥着原本的作用。而在我成为监督并接任指挥权后，我确实感受到指挥“英雄们”所带来的压力……以及，所有人都在为了一个无私的目标而战的热血沸腾。","话题：危机处理小组",{"_4050":16,"_15":4337,"_4093":37,"_4094":37,"_4124":4338,"_4126":4339,"_4128":1803,"_4129":4340},"chr_0004_pelica_44","chr_0004_pelica_mono_about_line08","我听M3说，终末地过去并不设监督职位。管理员是终末地的领袖，M3、创始人和精英干员们辅佐着管理员，这一决策层被称为“源点”。“源点”管辖着三大中枢，支撑着终末地一路走到今天……但在你沉睡的时候，终末地也被迫做出了许多改变，不过也因此，我们才能继续前进……我才能站在你的身边。","话题：终末地监督",{"_4050":16,"_15":4342,"_4093":37,"_4094":37,"_4124":4343,"_4126":4344,"_4128":270,"_4129":4345},"chr_0004_pelica_45","chr_0004_pelica_explore_point_common_01","似乎有值得调查的东西……","发现资源1",{"_4050":16,"_15":4347,"_4093":37,"_4094":37,"_4124":4348,"_4126":4349,"_4128":1881,"_4129":4350},"chr_0004_pelica_46","chr_0004_pelica_explore_point_valub_01","附近似乎有高价值的物资，值得留意。","发现资源2",{"_4050":16,"_15":4352,"_4093":37,"_4094":37,"_4124":4353,"_4126":4354,"_4128":1921,"_4129":4355},"chr_0004_pelica_47","chr_0004_pelica_explore_find_locked_01","又一处未被人类探索的区域。","发现未探索区域",{"_4050":16,"_15":4357,"_4093":37,"_4094":37,"_4124":4358,"_4126":4359,"_4128":72,"_4129":4360},"chr_0004_pelica_48","chr_0004_pelica_explore_find_danger_01","眼前的敌人非同小可，提高警惕。","发现强敌",{"_4050":16,"_15":4362,"_4093":37,"_4094":37,"_4124":4363,"_4126":4364,"_4128":60,"_4129":4365},"chr_0004_pelica_49","chr_0004_pelica_interact_mine_valub_01","矿物是工业的基础，多准备一些吧。","采集矿物1",{"_4050":16,"_15":4367,"_4093":37,"_4094":37,"_4124":4368,"_4126":4369,"_4128":76,"_4129":4370},"chr_0004_pelica_50","chr_0004_pelica_interact_mine_valub_echo2_01","我也来帮忙。","采集矿物2",{"_4050":16,"_15":4372,"_4093":37,"_4094":37,"_4124":4373,"_4126":4374,"_4128":78,"_4129":4375},"chr_0004_pelica_51","chr_0004_pelica_interact_treasure_valub_01","不错的收获。","打开储藏箱",{"_4050":16,"_15":4377,"_4093":37,"_4094":37,"_4124":4378,"_4126":4379,"_4128":80,"_4129":4380},"chr_0004_pelica_52","chr_0004_pelica_interact_etherium_01","醚质是破碎的宇宙，它穿越了遥远的距离才抵达我们面前。","获得醚质",{"_4050":16,"_15":4382,"_4093":37,"_4094":37,"_4124":4383,"_4126":4384,"_4128":82,"_4129":4385},"chr_0004_pelica_53","chr_0004_pelica_interact_blight_break_01","侵蚀已经无法威胁如今的终末地。","消除侵蚀",{"_4050":16,"_15":4387,"_4093":37,"_4094":37,"_4124":4388,"_4126":4389,"_4128":84,"_4129":4390},"chr_0004_pelica_54","chr_0004_pelica_interact_rest_01","休整完毕，各位，准备继续行动。","休整",{"_4050":16,"_15":4392,"_4093":37,"_4094":37,"_4124":4393,"_4126":4394,"_4128":86,"_4129":4395},"chr_0004_pelica_55","chr_0004_pelica_combat_suppuse_using_01","不要掉以轻心。","使用战术物品1",{"_4050":16,"_15":4397,"_4093":37,"_4094":37,"_4124":4398,"_4126":4399,"_4128":2268,"_4129":4400},"chr_0004_pelica_56","chr_0004_pelica_combat_suppuse_getheal_01","调整好状态。","使用战术物品2",{"_4050":16,"_15":4402,"_4093":37,"_4094":37,"_4124":4403,"_4126":4404,"_4128":2308,"_4129":4405},"chr_0004_pelica_57","chr_0004_pelica_combat_remind_danger_01","未知的行为，小心！","危险提醒",{"_4050":16,"_15":4407,"_4093":37,"_4094":37,"_4124":4408,"_4126":4409,"_4128":421,"_4129":4410},"chr_0004_pelica_58","chr_0004_pelica_combat_hurt_lowhp_01","没关系……比起我们的目标……","负伤",{"_4050":16,"_15":4412,"_4093":37,"_4094":37,"_4124":4413,"_4126":4414,"_4128":2386,"_4129":4415},"chr_0004_pelica_59","chr_0004_pelica_combat_dead_01","保护好自己……管理员……","力竭",{"_4050":16,"_15":4417,"_4093":37,"_4094":37,"_4124":4418,"_4126":4419,"_4128":74,"_4129":4420},"chr_0004_pelica_60","chr_0004_pelica_combat_remind_praise_01","出色的技巧，令人赞叹。","小队激励1",{"_4050":16,"_15":4422,"_4093":37,"_4094":37,"_4124":4423,"_4126":4424,"_4128":460,"_4129":4425},"chr_0004_pelica_61","chr_0004_pelica_combat_remind_praise_02","我们团结一心！","小队激励2",{"_4050":16,"_15":4427,"_4093":37,"_4094":37,"_4124":4428,"_4126":4429,"_4128":2533,"_4129":4430},"chr_0004_pelica_62","chr_0004_pelica_combat_remind_praise_echo2_01","全靠大家。","回应激励1",{"_4050":16,"_15":4432,"_4093":37,"_4094":37,"_4124":4433,"_4126":4434,"_4128":2573,"_4129":4435},"chr_0004_pelica_63","chr_0004_pelica_combat_remind_praise_echo2_02","这就是终末地工业。","回应激励2",{"_4050":16,"_15":4437,"_4093":37,"_4094":37,"_4124":4438,"_4126":4439,"_4128":498,"_4129":4440},"chr_0004_pelica_64","chr_0004_pelica_combat_intobattle_01","战斗开始，请以自身安全为优先。","作战开始1",{"_4050":16,"_15":4442,"_4093":37,"_4094":37,"_4124":4443,"_4126":4444,"_4128":2651,"_4129":4445},"chr_0004_pelica_65","chr_0004_pelica_combat_intobattle_echo2_01","没有超过预案的设想。","作战开始2",{"_4050":16,"_15":4447,"_4093":37,"_4094":37,"_4124":4448,"_4126":4449,"_4128":2690,"_4129":4450},"chr_0004_pelica_66","chr_0004_pelica_combat_outbattle_nor_01","出色的配合，必然的结果。","作战胜利1",{"_4050":16,"_15":4452,"_4093":37,"_4094":37,"_4124":4453,"_4126":4454,"_4128":538,"_4129":4455},"chr_0004_pelica_67","chr_0004_pelica_combat_outbattle_nor_02","各位，确认一下自己的状况吧。","作战胜利2",{"_4050":16,"_15":4457,"_4093":37,"_4094":37,"_4124":4458,"_4126":4459,"_4128":2