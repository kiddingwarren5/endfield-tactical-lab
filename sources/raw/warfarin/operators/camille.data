7":8718,"_8721":8722,"_8726":8727,"_8731":8732,"_8735":8736,"_8740":8741,"_8246":8744,"_8749":8750,"_8753":8754,"_8759":8760,"_8252":8763,"_8768":8769,"_8772":8773,"_8270":8777,"_8782":8783,"_8786":8787,"_8277":8791,"_8796":8797,"_8802":8803,"_8301":8807,"_8812":8813,"_8817":8818,"_8822":8823,"_8827":8828,"_8308":8832,"_8836":8837,"_8841":8842,"_8846":8847,"_8850":8851,"_8856":8857,"_8861":8862,"_8338":8866,"_8871":8872,"_8876":8877,"_8879":8880,"_8883":8884,"_8888":8889,"_8892":8893,"_8898":8899,"_8902":8903,"_8907":8908,"_8912":8913,"_8355":8917,"_8921":8922,"_8924":8925,"_8375":8929,"_8933":8934,"_8938":8939,"_8943":8944,"_8948":8949,"_8952":8953,"_8957":8958,"_8175":8963,"_8214":8967,"_8972":8973,"_8977":8978,"_8982":8983,"_8401":8987,"_8992":8993,"_8995":8996,"_8999":9000,"_9003":9004,"_9008":9009,"_9013":9014,"_9017":9018,"_9022":9023,"_8441":9027,"_9031":9032,"_9036":9037,"_9041":9042,"_9046":9047,"_9050":9051,"_9054":9055,"_9059":9060,"_9064":9065,"_9068":9069,"_9074":9075,"_9078":9079,"_9082":9083,"_9087":9088,"_9091":9092,"_9095":9096,"_9099":9100,"_9105":9106,"_9110":9111,"_9115":9116,"_9120":9121,"_9125":9126,"_9130":9131,"_9135":9136,"_9140":9141,"_9145":9146,"_9150":9151,"_9155":9156,"_9160":9161,"_9165":9166,"_9170":9171},"adv.electricFence",{"_4639":8661,"_8662":4060,"_15":8659,"_8663":4060,"_19":8664,"_8665":8231},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4639":8668,"_8662":8669,"_15":8666,"_8663":4060,"_19":8670,"_8665":8284},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4639":8672,"_8662":8673,"_15":8348,"_8663":8674,"_19":8675,"_8665":8413},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4639":8678,"_8662":4060,"_15":8676,"_8663":4060,"_19":8679,"_8665":8231},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4639":8682,"_8662":8683,"_15":8680,"_8663":4060,"_19":8684,"_8665":8231},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4639":8687,"_8662":4060,"_15":8685,"_8663":4060,"_19":8688,"_8665":8231},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4639":8691,"_8662":8692,"_15":8689,"_8663":4060,"_19":8693,"_8665":8325},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4639":8696,"_8662":4060,"_15":8694,"_8663":4060,"_19":8697,"_8665":8231},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4639":8700,"_8662":8701,"_15":8698,"_8663":4060,"_19":8702,"_8665":8231},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4639":8705,"_8662":4060,"_15":8703,"_8663":4060,"_19":8706,"_8665":4060},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4639":8709,"_8662":8710,"_15":8707,"_8663":4060,"_19":8711,"_8665":8284},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4639":8713,"_8662":8714,"_15":8163,"_8663":8715,"_19":8716,"_8665":8413},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4639":8719,"_8662":4060,"_15":8717,"_8663":4060,"_19":8720,"_8665":8231},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4639":8723,"_8662":8724,"_15":8721,"_8663":4060,"_19":8725,"_8665":8231},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4639":8728,"_8662":8729,"_15":8726,"_8663":4060,"_19":8730,"_8665":8231},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4639":8733,"_8662":4060,"_15":8731,"_8663":4060,"_19":8734,"_8665":8258},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4639":8737,"_8662":8738,"_15":8735,"_8663":4060,"_19":8739,"_8665":8231},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4639":8742,"_8662":4060,"_15":8740,"_8663":4060,"_19":8743,"_8665":8258},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4639":8745,"_8662":8746,"_15":8246,"_8663":8747,"_19":8748,"_8665":8325},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4639":8751,"_8662":8746,"_15":8749,"_8663":4060,"_19":8752,"_8665":8325},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4639":8755,"_8662":8756,"_15":8753,"_8663":8757,"_19":8758,"_8665":8258},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4639":8761,"_8662":4060,"_15":8759,"_8663":4060,"_19":8762,"_8665":8258},"持续时间内，受影响的目标暂停行动。","定身",{"_4639":8764,"_8662":8765,"_15":8252,"_8663":8766,"_19":8767,"_8665":8437},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4639":8770,"_8662":8765,"_15":8768,"_8663":4060,"_19":8771,"_8665":8437},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4639":8774,"_8662":4060,"_15":8772,"_8663":8775,"_19":8776,"_8665":4060},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4639":8778,"_8662":8779,"_15":8270,"_8663":8780,"_19":8781,"_8665":8387},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4639":8784,"_8662":8779,"_15":8782,"_8663":4060,"_19":8785,"_8665":8387},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4639":8788,"_8662":8789,"_15":8786,"_8663":4060,"_19":8790,"_8665":8231},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4639":8792,"_8662":8793,"_15":8277,"_8663":8794,"_19":8795,"_8665":8413},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4639":8798,"_8662":8799,"_15":8796,"_8663":8800,"_19":8801,"_8665":8258},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4639":8804,"_8662":8805,"_15":8802,"_8663":4060,"_19":8806,"_8665":8258},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4639":8808,"_8662":8809,"_15":8301,"_8663":8810,"_19":8811,"_8665":8284},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4639":8814,"_8662":4060,"_15":8812,"_8663":8815,"_19":8816,"_8665":8284},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4639":8819,"_8662":8820,"_15":8817,"_8663":4060,"_19":8821,"_8665":8231},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4639":8824,"_8662":8825,"_15":8822,"_8663":4060,"_19":8826,"_8665":8231},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4639":8829,"_8662":8830,"_15":8827,"_8663":4060,"_19":8831,"_8665":8284},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4639":8833,"_8662":8669,"_15":8308,"_8663":8834,"_19":8835,"_8665":8284},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4639":8838,"_8662":4060,"_15":8836,"_8663":8839,"_19":8840,"_8665":8258},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4639":8843,"_8662":8844,"_15":8841,"_8663":4060,"_19":8845,"_8665":8231},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4639":8848,"_8662":4060,"_15":8846,"_8663":4060,"_19":8849,"_8665":4060},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4639":8852,"_8662":8853,"_15":8850,"_8663":8854,"_19":8855,"_8665":8258},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4639":8858,"_8662":8859,"_15":8856,"_8663":4060,"_19":8860,"_8665":8231},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4639":8863,"_8662":4060,"_15":8861,"_8663":8864,"_19":8865,"_8665":8325},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4639":8867,"_8662":8868,"_15":8338,"_8663":8869,"_19":8870,"_8665":8325},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4639":8873,"_8662":8874,"_15":8871,"_8663":4060,"_19":8875,"_8665":8231},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4639":8751,"_8662":8868,"_15":8876,"_8663":4060,"_19":8878,"_8665":8325},"干员受到灼热附着","sys.tacticalItem",{"_4639":8881,"_8662":4060,"_15":8879,"_8663":4060,"_19":8882,"_8665":8231},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4639":8885,"_8662":8886,"_15":8883,"_8663":4060,"_19":8887,"_8665":8325},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4639":8770,"_8662":8890,"_15":8888,"_8663":4060,"_19":8891,"_8665":8437},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4639":8894,"_8662":8895,"_15":8892,"_8663":8896,"_19":8897,"_8665":8258},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4639":8900,"_8662":4060,"_15":8898,"_8663":4060,"_19":8901,"_8665":8258},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4639":8904,"_8662":8905,"_15":8902,"_8663":4060,"_19":8906,"_8665":8413},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4639":8909,"_8662":8910,"_15":8907,"_8663":4060,"_19":8911,"_8665":8437},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4639":8914,"_8662":8915,"_15":8912,"_8663":4060,"_19":8916,"_8665":8258},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4639":8918,"_8662":8919,"_15":8355,"_8663":8810,"_19":8920,"_8665":8284},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4639":8668,"_8662":8919,"_15":8921,"_8663":4060,"_19":8923,"_8665":8284},"干员受到冻结","ba.naturalvul",{"_4639":8926,"_8662":8927,"_15":8924,"_8663":4060,"_19":8928,"_8665":8387},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4639":8713,"_8662":8930,"_15":8375,"_8663":8931,"_19":8932,"_8665":8413},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4639":8935,"_8662":8936,"_15":8933,"_8663":4060,"_19":8937,"_8665":8231},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4639":8940,"_8662":8941,"_15":8938,"_8663":4060,"_19":8942,"_8665":8231},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4639":8945,"_8662":8946,"_15":8943,"_8663":4060,"_19":8947,"_8665":8231},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4639":8950,"_8662":4060,"_15":8948,"_8663":4060,"_19":8951,"_8665":8231},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4639":8954,"_8662":4060,"_15":8952,"_8663":8955,"_19":8956,"_8665":4060},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4639":8959,"_8662":8960,"_15":8957,"_8663":8961,"_19":8962,"_8665":8258},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4639":8964,"_8662":4060,"_15":8175,"_8663":8965,"_19":8966,"_8665":8387},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4639":8968,"_8662":8969,"_15":8214,"_8663":8970,"_19":8971,"_8665":8413},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4639":8974,"_8662":8975,"_15":8972,"_8663":4060,"_19":8976,"_8665":8231},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4639":8979,"_8662":8980,"_15":8977,"_8663":4060,"_19":8981,"_8665":8387},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4639":8984,"_8662":8985,"_15":8982,"_8663":4060,"_19":8986,"_8665":8231},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4639":8988,"_8662":8989,"_15":8401,"_8663":8990,"_19":8991,"_8665":8387},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4639":8784,"_8662":8989,"_15":8992,"_8663":4060,"_19":8994,"_8665":8387},"干员受到自然附着","ba.originium",{"_4639":8997,"_8662":4060,"_15":8995,"_8663":4060,"_19":8998,"_8665":8258},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4639":9001,"_8662":4060,"_15":8999,"_8663":4060,"_19":9002,"_8665":8413},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4639":9005,"_8662":9006,"_15":9003,"_8663":4060,"_19":9007,"_8665":8413},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4639":9010,"_8662":4060,"_15":9008,"_8663":9011,"_19":9012,"_8665":8421},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4639":9015,"_8662":4060,"_15":9013,"_8663":4060,"_19":9016,"_8665":8231},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4639":9019,"_8662":4060,"_15":9017,"_8663":9020,"_19":9021,"_8665":8437},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4639":9024,"_8662":9025,"_15":9022,"_8663":4060,"_19":9026,"_8665":8231},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4639":9028,"_8662":8890,"_15":8441,"_8663":9029,"_19":9030,"_8665":8437},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4639":9033,"_8662":9034,"_15":9031,"_8663":4060,"_19":9035,"_8665":8437},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4639":9038,"_8662":4060,"_15":9036,"_8663":9039,"_19":9040,"_8665":8258},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4639":9043,"_8662":4060,"_15":9041,"_8663":9044,"_19":9045,"_8665":4060},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4639":9048,"_8662":4060,"_15":9046,"_8663":4060,"_19":9049,"_8665":8231},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4639":9052,"_8662":4060,"_15":9050,"_8663":4060,"_19":9053,"_8665":8258},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4639":9056,"_8662":9057,"_15":9054,"_8663":4060,"_19":9058,"_8665":8231},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4639":9061,"_8662":4060,"_15":9059,"_8663":9062,"_19":9063,"_8665":8258},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4639":9066,"_8662":4060,"_15":9064,"_8663":4060,"_19":9067,"_8665":8231},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4639":9070,"_8662":9071,"_15":9068,"_8663":9072,"_19":9073,"_8665":8258},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4639":9076,"_8662":4060,"_15":9074,"_8663":4060,"_19":9077,"_8665":8258},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4639":9080,"_8662":4060,"_15":9078,"_8663":4060,"_19":9081,"_8665":8258},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4639":9084,"_8662":9085,"_15":9082,"_8663":4060,"_19":9086,"_8665":8231},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4639":9089,"_8662":4060,"_15":9087,"_8663":4060,"_19":9090,"_8665":8258},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4639":9093,"_8662":4060,"_15":9091,"_8663":4060,"_19":9094,"_8665":8258},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4639":9097,"_8662":4060,"_15":9095,"_8663":4060,"_19":9098,"_8665":8258},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4639":9101,"_8662":9102,"_15":9099,"_8663":9103,"_19":9104,"_8665":8258},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4639":9107,"_8662":9108,"_15":9105,"_8663":4060,"_19":9109,"_8665":8231},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4639":9112,"_8662":9113,"_15":9110,"_8663":4060,"_19":9114,"_8665":8231},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4639":9117,"_8662":9118,"_15":9115,"_8663":4060,"_19":9119,"_8665":8231},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4639":9122,"_8662":9123,"_15":9120,"_8663":4060,"_19":9124,"_8665":8231},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4639":9127,"_8662":9128,"_15":9125,"_8663":4060,"_19":9129,"_8665":8231},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4639":9132,"_8662":9133,"_15":9130,"_8663":4060,"_19":9134,"_8665":8231},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4639":9137,"_8662":9138,"_15":9135,"_8663":4060,"_19":9139,"_8665":8231},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4639":9142,"_8662":9143,"_15":9140,"_8663":4060,"_19":9144,"_8665":8231},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4639":9147,"_8662":9148,"_15":9145,"_8663":4060,"_19":9149,"_8665":8231},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4639":9152,"_8662":9153,"_15":9150,"_8663":4060,"_19":9154,"_8665":8231},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4639":9157,"_8662":9158,"_15":9155,"_8663":4060,"_19":9159,"_8665":8231},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4639":9162,"_8662":9163,"_15":9160,"_8663":4060,"_19":9164,"_8665":8231},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4639":9167,"_8662":9168,"_15":9165,"_8663":4060,"_19":9169,"_8665":8231},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4639":9172,"_8662":9173,"_15":9170,"_8663":4060,"_19":9174,"_8665":8231},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7868":9177,"_7422":9186,"_7388":9188,"_7522":9190,"_7524":9192,"_7526":9194,"_7528":9196,"_7531":9198,"_7533":9200,"_7536":9201,"_5620":9203,"_7541":9205,"_7544":9206,"_7547":9207,"_7549":9209,"_6465":9210,"_5623":9211,"_7556":9212,"_5728":9214,"_7561":9215,"_5780":9216,"_7568":9217,"_7571":9218,"_7575":9219,"_7579":9220,"_7582":9221,"_7586":9222,"_7590":9224,"_7594":9225,"_7598":9227,"_7602":9229,"_7606":9231,"_6467":9232,"_7613":9234,"_7617":9236,"_7621":9237,"_6616":9239,"_7628":9241,"_7632":9243,"_7636":9245,"_6671":9248,"_7643":9251,"_7647":9254,"_7651":9257,"_7655":9258,"_5961":9260,"_7662":9261,"_7666":9262,"_7670":9264,"_7674":9266,"_7678":9267,"_7682":9269,"_7686":9271,"_7690":9273,"_7694":9275,"_7698":9277,"_7702":9279,"_7706":9281,"_7709":9283,"_7713":9285,"_7717":9287,"_7721":9288,"_7725":9290,"_7729":9291,"_7733":9292,"_7737":9293,"_7741":9294,"_7745":9295,"_7749":9296,"_7753":9297,"_7757":9298,"_7761":9299,"_7765":9300,"_7769":9301,"_7773":9302,"_7777":9303,"_7781":9304,"_7785":9305,"_7789":9306,"_7793":9307,"_7797":9308,"_7801":9309,"_7804":9310,"_7808":9311,"_7812":9312,"_7816":9313,"_7820":9314,"_7824":9315,"_7828":9317,"_7832":9318,"_7836":9319,"_9320":9321,"_9322":9323,"_9324":9325,"_9326":9327,"_9328":9329,"_9330":9331,"_9332":9333,"_9334":9335,"_9336":9337,"_9338":9339,"_9340":9341,"_9343":9344,"_9346":9347,"_9349":9350,"_9351":93