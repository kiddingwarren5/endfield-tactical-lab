3845,3846,3847,3848,3849,3850],{"_36":37,"_38":3815},94,{"_36":41,"_38":3817},161.02103934357297,{"_36":44,"_38":3819},108.72093414685459,{"_36":47,"_38":3821},97.69072164948453,{"_36":50,"_38":3823},113.30000000000027,{"_36":39,"_38":3825},5719,{"_36":55,"_38":3827},309,{"_36":58,"_38":37},{"_36":60,"_38":3830},1.47448979591837,{"_36":62,"_38":3832},1.23724489795918,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3852,"_101":64},{"_33":3853},[3854,3856,3858,3860,3862,3864,3866,3868,3869,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889],{"_36":37,"_38":3855},95,{"_36":41,"_38":3857},162.55291394908528,{"_36":44,"_38":3859},109.75695350305068,{"_36":47,"_38":3861},98.63917525773195,{"_36":50,"_38":3863},114.40000000000026,{"_36":39,"_38":3865},5776,{"_36":55,"_38":3867},312,{"_36":58,"_38":37},{"_36":60,"_38":3870},1.47959183673469,{"_36":62,"_38":1972},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3891,"_101":64},{"_33":3892},[3893,3894,3896,3898,3900,3902,3904,3906,3907,3909,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928],{"_36":37,"_38":961},{"_36":41,"_38":3895},164.0847885545976,{"_36":44,"_38":3897},110.79297285924676,{"_36":47,"_38":3899},99.58762886597937,{"_36":50,"_38":3901},115.50000000000027,{"_36":39,"_38":3903},5832,{"_36":55,"_38":3905},315,{"_36":58,"_38":37},{"_36":60,"_38":3908},1.48469387755102,{"_36":62,"_38":3910},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3930,"_101":64},{"_33":3931},[3932,3934,3936,3938,3940,3942,3944,3946,3947,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967],{"_36":37,"_38":3933},97,{"_36":41,"_38":3935},165.6166631601099,{"_36":44,"_38":3937},111.82899221544285,{"_36":47,"_38":3939},100.5360824742268,{"_36":50,"_38":3941},116.60000000000026,{"_36":39,"_38":3943},5888,{"_36":55,"_38":3945},318,{"_36":58,"_38":37},{"_36":60,"_38":3948},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3969,"_101":64},{"_33":3970},[3971,3973,3975,3977,3979,3981,3983,3985,3986,3988,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007],{"_36":37,"_38":3972},98,{"_36":41,"_38":3974},167.14853776562222,{"_36":44,"_38":3976},112.86501157163895,{"_36":47,"_38":3978},101.48453608247422,{"_36":50,"_38":3980},117.70000000000027,{"_36":39,"_38":3982},5944,{"_36":55,"_38":3984},321,{"_36":58,"_38":37},{"_36":60,"_38":3987},1.49489795918367,{"_36":62,"_38":3989},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4009,"_101":64},{"_33":4010},[4011,4012,4014,4016,4018,4020,4022,4024,4025,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045],{"_36":37,"_38":1000},{"_36":41,"_38":4013},168.68041237113454,{"_36":44,"_38":4015},113.90103092783502,{"_36":47,"_38":4017},102.43298969072164,{"_36":50,"_38":4019},118.80000000000028,{"_36":39,"_38":4021},6000,{"_36":55,"_38":4023},324,{"_36":58,"_38":37},{"_36":60,"_38":4026},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4048,4049,4050],"tag_19","tag_06","tag_14","charId","charIllustInitPos",{"_4054":4055,"_4056":4057},"x",127,"y",-440,"charPassiveUIPrefabName","","charTypeId","Cryst","cvName",{"_4064":4065,"_4066":4067,"_4068":4069,"_4070":4071,"_4051":16},"ChiCVName","刘十四","EngCVName","Stephanie Southerland","JapCVName","明坂聪美","KorCVName","刘荣","defaultWeaponId","wpn_claym_0010","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Snowshine","mainAttrType","phoneticName","profession","profileRecord",[4085,4096,4101,4106,4111,4116],{"_4051":16,"_15":4086,"_4087":4088,"_4089":4090,"_4091":39,"_4092":4093,"_4094":37,"_4095":37},"chr_0014_aurora_1","recordDesc","【代号】昼雪\n【性别】女\n【身份认证】罗德岛\n【生日】12月19日\n【种族】乌萨斯\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：普通\n战术规划：标准\n源石技艺适应性：标准\n\n鉴于昼雪小姐需长期在侵蚀环境下进行救援活动，医疗部门建议在她的定期体检中增加相关方面的检测，以避免意外情况的发生。","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4051":16,"_15":4097,"_4087":4098,"_4089":4099,"_4091":55,"_4092":4100,"_4094":37,"_4095":37},"chr_0014_aurora_2","干员昼雪，隶属于罗德岛。在罗德岛与终末地工业合力进行的多次救援行动中，以救援专家的身份解决难题，现以此身份派驻终末地工业开展合作。\n\n无论是干员昼雪的生存能力还是她在危机时刻的应变能力，都不止一次地向我们表明了她在北方的救援经历是何等的可贵。\n她曾向我绘声绘色地介绍了她是如何在极端环境下救出那些铁誓军与极地商旅的，包括如何规划并实施有效的救援行动，以及在危险的自然环境中如何选择应对策略。她的工程学背景为她提供了强大的技术支持，使她能够在救援行动中发挥相当关键的作用。干员昼雪对待工作充满热情和责任感。她在工程学和救援工作上的丰富经验和深刻理解，将为终末地带来宝贵的价值。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4051":16,"_15":4102,"_4087":4103,"_4089":4104,"_4091":58,"_4092":4105,"_4094":37,"_4095":37},"chr_0014_aurora_3","在加入终末地后，仅仅几个月的时间，昼雪小姐就给帝江号的很多干员留下了非常亲切的印象。\n她经常在空闲的时候给其他人帮忙，有时是帮忙跑个腿，有时则是替人传个信。尽管大多是些小事，可有时候却是能让人长松一口气的“雪中送炭”。\n“……要不是昼雪小姐及时送来那瓶陈醋，我这道糖醋兽肉可就出不了锅了！”来自食堂后厨的报告。\n同时，在科普救援知识与教授雪地生存技巧方面，昼雪小姐更是不遗余力，经常亲自向大家演示——无论是急救时的关键步骤，还是雪地滑行时快速过弯的技巧。\n“天啊……她到底是怎么做到的！我上次看到这么漂亮的过弯……还是在环带滑雪大赛的总决赛上！我打赌，要是她去参赛，至少能拿前三名回来！”某位没有透露姓名的干员曾在观看了昼雪小姐的演示后这么说。\n而特种技术部门的伊冯小姐更是对她赞不绝口：\n“哇！我还是第一次遇到能有人这么熟练地使用这套制冰施术单元！来来！再帮我多试用几套吧！至少能省掉十天的测试时间喔！”\n但食堂负责现场补货的干员总会在昼雪小姐驻留帝江号时严阵以待，以免“甜品区好像只剩下了甜品名标签”的报告反复出现。","CN_03","档案资料·一",{"_4051":16,"_15":4107,"_4087":4108,"_4089":4109,"_4091":64,"_4092":4110,"_4094":64,"_4095":3711},"chr_0014_aurora_4","你问我对北方的印象？那真是糟透了……我发誓，当初答应和鲁特一块儿去找根本不知道在哪儿的什么萨米商人就是一个错误！我们才进到那里没两天，刚越过第一座雪山，就在山脚下被一场侵蚀雪暴给“逮住”了！\n我这辈子都忘不了那沾了侵蚀的雪唰的一下把驮兽卷飞的画面。当时脑子里就剩一个念头：“完了，这下肯定得交待在这儿了……”\n谁知道是不是我前十几年没用上的好运气都留在这一遭了，就在那雪暴离我们只剩几米不到的时候，一个乌萨斯姑娘突然从天而降——对，我没说错，她就是踩着一个滑雪板飞过来的，落在我们旁边二话没说，拿着个大盾往地上一砸！也是唰的一下，就造出了个大冰墙！把那雪暴全挡在外面了！\n总之，我和鲁特就这么被她给救了下来，送到了一个山洞里，说是什么临时的避难所。\n那里真是什么人都有……什么铁誓军军人、塞什卡商旅，甚至还有裂地者！\n我到现在还记得，我们才刚进去就被一个看起来凶神恶煞的高个儿菲林指着鼻子骂：“这就是两个打算去萨米招摇撞骗的奸商！我在路上就听到他们在密谋怎么骗人。你们救援队怎么连这种货色都救！别被骗了！”我这才认出来，这菲林是之前和我们同行过几天的向导……难怪他突然就赔了我们佣金，不肯继续当我们的向导了……\n我本以为这下要糟，不曾想带我们进来的乌萨斯姑娘却什么都没说，只是看了那菲林一眼，然后……然后那菲林就乖乖坐下，什么都没再说了。\n当时呢，我本想亲自谢谢她的，但她立马又继续出去救人了。我连她名字都没问到，就被后来的救援队带去了另一处安全地带。\n不过我记住了她衣服上的标志，和那个避难所里画的一样。\n然后……然后我不就找到你们这儿了吗？哈哈，这些物资就当是给那位乌萨斯姑娘的谢礼吧！\n——北方走廊救助联合会的一位捐赠者的来访录音记录","CN_04","档案资料·二",{"_4051":16,"_15":4112,"_4087":4113,"_4089":4114,"_4091":66,"_4092":4115,"_4094":64,"_4095":3711},"chr_0014_aurora_5","【一封私人信件】\n艾尔温：\n现在或许该叫你“昼雪”？总之，原谅我离队时没能来得及和你告别……这并非我的本意，但那时队长和为我治疗的玛格丽特医生都强烈建议我最好立刻离开北方，以免我的幻觉症状进一步加重。\n耶尔什是个美丽的城市，尽管这里看不到极光，但一样有巍峨的雪山。山脉之间没有侵蚀也没有天使，只有印着城市标志的悬空缆车来往交错——我坐过几次，那种毫无顾虑地望着雪原发呆的体验令人难忘……\n我想你肯定会很意外。曾经入队时发誓要留在北方永远走在救援路上的人，竟然会在那么一场寻常的暴雪救援后退缩了……但我想说的是，有时候人或许真的没有自己想象中那么坚强，或者说比自己以为的更脆弱。\n我不曾畏惧过暴雪、侵蚀这些指不定什么时候就带走我们性命的灾害。只是当目睹内尔森为了护住那个倒霉的勘探员而被卷入侵蚀最后失去了一条腿，当得知莉莎为了给所有人预警而超负荷使用她的源石技艺最终确诊失明……我逐渐开始自我质疑，质疑自己是不是哪里做得还不够，最终开始质疑起了其他队员……\n多亏了队长，那时是他制止了我继续拿起施术单元，让玛格丽特医生及时替莱德进行了治疗……不然我一定会后悔一辈子吧。而艾尔温，你作为队里我曾经最看好的后辈，甚至是我心中最合适的副队长继任者，其实是个比我更重视情谊、更容易因为顾及他人而忘了自己的人啊。所以，就当是过来人的劝诫吧，在救助他人的时候，也多在乎一点自己，保护好自己。\n因为你对我们、对那些关心着你的人，都一样重要，都是最无可替代的。\n我期待你的回信，也随时欢迎你来耶尔什做客，最好拉上队长一起。到时我就带你们去吃这里味道最好的奶酪火锅，它的味道和你跟我描述的简直一模一样。\n\n玛德琳·克里克\n\n【一封私人信件】\n玛德琳前辈：\n谢谢你寄给我这封信！\n直到现在，我都始终记得你第一次教我在雪地里修建避难所时的耐心，记得你告诫我作为救援队员必须保持警惕时的严肃，记得你半夜四点帮我修好了我那台无人机并让我下次注意时的温柔……这些都是我终生难忘的重要回忆。\n所以我从来没有怀疑过前辈对救援行动的热忱，也一直相信就算离开了北方，前辈也一定在用自己的方式在哪里帮助着别人。\n那时山上的事，莱德和队长他们虽然一直不肯多说，但我大概也从行动记录里猜到了一些……我想无论是他们还是其他人，都不会责怪前辈的，所以希望你好好养病，有空的时候也别忘了到处走走。等到我什么时候路过了耶尔什（队长好像最近依然很忙，我都没能联系上他），肯定会来看望你的。对了，你说的那家奶酪火锅真的那么好吃吗？真想吃一次看看！\n另，信件附上的包裹里我放了你最喜欢的莓果果干，记得在保质期之前吃掉哦！\n\n艾尔温","CN_05","档案资料·三",{"_4051":16,"_15":4117,"_4087":4118,"_4089":4119,"_4091":68,"_4092":4120,"_4094":64,"_4095":4121},"chr_0014_aurora_6","【记录编号0000000】\n……呼，给未来某个时刻的我与能够听到这份记录的人。\n在离开那片森林后，她曾说：“可以尝试记录一些你认为意义非凡的时刻，这或许有助于你锚定自身在这个世界的位置。”\n到现在我都不确定自己是不是真的理解了她的意思，也不知道究竟怎样的时刻能算是“意义非凡”……所以干脆就把我觉得值得记一下的事都记录下来吧！\n\n【记录编号0000001】\n……这是我第一次离开罗德岛，踏上塔卫二的土地。这里好像比地图与全息投影展示的景象更加广阔一些呢……有很多即使在她的记忆里也没有见过的东西，虽然和泰拉都不太一样了，但不知道为什么，有时候看着这里的人与建筑，总有种陌生但好像又有一些熟悉的感觉……真奇妙啊……\n不过如果可以，果然还是想看看这里的雪……听说在北方和环带中部都能看见雪山，好像北方离这里更近一点，就先去那里看看吧。\n\n【记录编号0000009】\n……今天抵达的地方是北方的一座雪山。这些极地的风景常常让我觉得特别亲切，无论是那六棱柱状的雪花，还是薄纱般的极光……对了，下山的时候遇到了一场大暴雪，有两个信使打扮的丰蹄差点被卷进附近的侵蚀里，我用滑雪板把其中一个拉了出来，另一个则被一名全副武装的佩洛及时送到了安全位置……后来我才知道，那名佩洛是一位隶属于“北方走廊救助联合会”的救援志愿者，正在筹备一支专门的救援队伍。和他告别时，他还给我留了一张名片，说是觉得我虽然没经过专业训练，在救援过程中却十分冷静沉稳，选择了最恰当的救援手段，问我有没有兴趣加入他的队伍……\n老实说，当我把那位信使救出来的时候，确实感受到了一种……从没有过的喜悦，让我觉得我应该这么做，甚至该做得更多。\n\n【记录编号0000010】\n……我想试试看，于是联系了那位名叫“克里斯”的佩洛，跟他说我想成为一名救援队员。\n为了再次见到那天暴雪过后格外晴朗的天空，也为了我自己。","CN_06","档案资料·四",1500,"profileVoice",[4124,4132,4136,4140,4144,4148,4152,4157,4162,4167,4172,4177,4182,4187,4192,4197,4202,4207,4212,4217,4222,4227,4232,4237,4242,4247,4252,4257,4262,4267,4272,4277,4282,4287,4292,4297,4302,4307,4312,4317,4322,4327,4332,4337,4342,4347,4352,4357,4362,4367,4372,4377,4382,4387,4392,4397,4402,4407,4412,4417,4422,4427,4432,4437,4442,4447,4452,4457,4462,4467,4472,4477,4482,4487,4492,4497,4502,4507,4512],{"_4051":16,"_15":4086,"_4094":37,"_4095":37,"_4125":4126,"_4127":4128,"_4129":39,"_4130":4131},"voId","chr_0014_aurora_chrbark_squad_01","voiceDesc","听候你的指示，管理员。","voiceIndex","voiceTitle","行动准备1",{"_4051":16,"_15":4097,"_4094":37,"_4095":37,"_4125":4133,"_4127":4134,"_4129":55,"_4130":4135},"chr_0014_aurora_chrbark_squad_02","管理员，你来啦！","行动准备2",{"_4051":16,"_15":4102,"_4094":37,"_4095":37,"_4125":4137,"_4127":4138,"_4129":58,"_4130":4139},"chr_0014_aurora_chrbark_join_01","是新的外勤任务吗？我准备好啦！","编入队伍1",{"_4051":16,"_15":4107,"_4094":37,"_4095":37,"_4125":4141,"_4127":4142,"_4129":64,"_4130":4143},"chr_0014_aurora_chrbark_join_02","我会保护好大家的！","编入队伍2",{"_4051":16,"_15":4112,"_4094":37,"_4095":37,"_4125":4145,"_4127":4146,"_4129":66,"_4130":4147},"chr_0014_aurora_chrbark_weap_01","很棒的性能，能适应各种极端环境！","更换武器",{"_4051":16,"_15":4117,"_4094":37,"_4095":37,"_4125":4149,"_4127":4150,"_4129":68,"_4130":4151},"chr_0014_aurora_chrbark_gear_01","这套装备充满了工匠的巧思呢。","更换装备",{"_4051":16,"_15":4153,"_4094":37,"_4095":37,"_4125":4154,"_4127":4155,"_4129":70,"_4130":4156},"chr_0014_aurora_7","chr_0014_aurora_chrup_skill_01","我有在努力锻炼身体呢！为了应对各种突发情况！","激活天赋阵列",{"_4051":16,"_15":4158,"_4094":37,"_4095":37,"_4125":4159,"_4127":4160,"_4129":88,"_4130":4161},"chr_0014_aurora_8","chr_0014_aurora_chrup_level_01","这份记录也很有参考价值，很多思路都可以用在救援行动里！","观看作战记录",{"_4051":16,"_15":4163,"_4094":55,"_4095":39,"_4125":4164,"_4127":4165,"_4129":90,"_4130":4166},"chr_0014_aurora_9","chr_0014_aurora_chrup_promt01_01","嗯，我会继续努力的！肯定不会辜负终末地和大家的信任！","精英化晋升1",{"_4051":16,"_15":4168,"_4094":55,"_4095":55,"_4125":4169,"_4127":4170,"_4129":409,"_4130":4171},"chr_0014_aurora_10","chr_0014_aurora_chrup_promt02_01","接下来就能去更远的地方完成任务了？放心吧，野外急救、数据采样、后勤支援之类的工作都可以交给我哦！","精英化晋升2",{"_4051":16,"_15":4173,"_4094":55,"_4095":58,"_4125":4174,"_4127":4175,"_4129":100,"_4130":4176},"chr_0014_aurora_11","chr_0014_aurora_chrup_promt03_01","这一次我把救援用的制冰施术单元都升级了一下！管理员，这是我新造的临时庇护所！要不要进来住一晚？","精英化晋升3",{"_4051":16,"_15":4178,"_4094":55,"_4095":64,"_4125":4179,"_4127":4180,"_4129":95,"_4130":4181},"chr_0014_aurora_12","chr_0014_aurora_chrup_promt04_01","在终末地的这段时光，我学到了很多新知识，也收获了很多美好回忆……这都多亏了你们的信任，管理员。今后，我也会继续尝试攀越更高的山峰，去帮助更多身处险境的人们。","精英化晋升4",{"_4051":16,"_15":4183,"_4094":37,"_4095":37,"_4125":4184,"_4127":4185,"_4129":525,"_4130":4186},"chr_0014_aurora_13","chr_0014_aurora_introduce_01","你好，我是罗德岛的特派干员，代号昼雪，擅长极寒地带的救援工作。如果有需要前往冰原或雪山的任务，请一定要带上我！","干员报到",{"_4051":16,"_15":4188,"_4094":37,"_4095":37,"_4125":4189,"_4127":4190,"_4129":564,"_4130":4191},"chr_0014_aurora_14","chr_0014_aurora_mono_switch_01","要来和我一起滑一段吗，管理员？","待命1",{"_4051":16,"_15":4193,"_4094":37,"_4095":37,"_4125":4194,"_4127":4195,"_4129":97,"_4130":4196},"chr_0014_aurora_15","chr_0014_aurora_mono_switch_02","风速适中，能见度良好，是滑雪的好天气。","待命2",{"_4051":16,"_15":4198,"_4094":37,"_4095":37,"_4125":4199,"_4127":4200,"_4129":642,"_4130":4201},"chr_0014_aurora_16","chr_0014_aurora_sim_assign_work_01","没问题！这里的工作我都尝试过！比搭建工事轻松多了！","进驻设施",{"_4051":16,"_15":4203,"_4094":37,"_4095":37,"_4125":4204,"_4127":4205,"_4129":682,"_4130":4206},"chr_0014_aurora_17","chr_0014_aurora_sim_hello_lower_01","你好啊，管理员。","打招呼1",{"_4051":16,"_15":4208,"_4094":64,"_4095":3711,"_4125":4209,"_4127":4210,"_4129":721,"_4130":4211},"chr_0014_aurora_18","chr_0014_aurora_sim_hello_max_01","需要帮忙吗，管理员？我可以当你的护卫。","打招呼2",{"_4051":16,"_15":4213,"_4094":37,"_4095":37,"_4125":4214,"_4127":4215,"_4129":761,"_4130":4216},"chr_0014_aurora_19","chr_0014_aurora_sim_talk_lv01_01","每次来帝江号都能学到很多新东西：没见过的技术设备，特别的作战思路，大胆的监测方案……真的是数都数不过来！嗯，终末地果然好厉害！","帝江号闲聊1",{"_4051":16,"_15":4218,"_4094":64,"_4095":3711,"_4125":4219,"_4127":4220,"_4129":800,"_4130":4221},"chr_0014_aurora_20","chr_0014_aurora_sim_talk_lv02_01","什么？帝江号食堂的点心是不限量供应的吗？！啊，抱歉，我只是稍微有些吃惊……没、没打算一口气全吃完的！真的！","帝江号闲聊2",{"_4051":16,"_15":4223,"_4094":64,"_4095":3711,"_4125":4224,"_4127":4225,"_4129":871,"_4130":4226},"chr_0014_aurora_21","chr_0014_aurora_sim_talk_lv02_02","管理员你来得正好！我刚好收到了之前采购的食材，要不要来试试我亲手做的奶酪火锅呀？……唔，口味应该算比较特别的吧？好多吃了的同事都说是种“终生难忘的味道”……","帝江号闲聊3",{"_4051":16,"_15":4228,"_4094":64,"_4095":4121,"_4125":4229,"_4127":4230,"_4129":909,"_4130":4231},"chr_0014_aurora_22","chr_0014_aurora_sim_talk_max_01","嘿咻！伸展四肢，活动关节。这套热身运动不仅有助于预防拉伤，在极地环境下也能降低失温风险哦，管理员，来一起试试吧？没关系，我当过培训课的助教，会帮你调整姿势的！——你看，很简单吧？","帝江号闲聊4",{"_4051":16,"_15":4233,"_4094":64,"_4095":4121,"_4125":4234,"_4127":4235,"_4129":949,"_4130":4236},"chr_0014_aurora_23","chr_0014_aurora_sim_talk_max_02","每次遇到小道奇教官，我就会想起我们的队长。他也是个佩洛，虽然平时很好说话，但到了救援行动的时候，他总是要求最严格的那个，连热水钻头的直径都会反复确认……“救援无小事”的道理就是他教给我的。","帝江号闲聊5",{"_4051":16,"_15":4238,"_4094":64,"_4095":4121,"_4125":4239,"_4127":4240,"_4129":988,"_4130":4241},"chr_0014_aurora_24","chr_0014_aurora_sim_talk_max_03","塔卫二云层上的光真的很漂亮，很像我印象里的“极光”……如同梦中的景色。我常在北方雪峰的最高处望见它们，虽然知道那是危险的超域能量，却总觉得像遇到了一个老朋友，在遥远的地方注视着我，守护着我……","帝江号闲聊6",{"_4051":16,"_15":4243,"_4094":37,"_4095":37,"_4125":4244,"_4127":4245,"_4129":62,"_4130":4246},"chr_0014_aurora_25","chr_0014_aurora_sim_gift_give_01","管理员，我从冰原带回来了一点小东西，请收下吧。","赠送礼物",{"_4051":16,"_15":4248,"_4094":37,"_4095":37,"_4125":4249,"_4127":4250,"_4129":1066,"_4130":4251},"chr_0014_aurora_26","chr_0014_aurora_sim_gift_recv_01","这是给我的吗？谢谢，有种很温暖的感觉……我会好好珍藏的！","接收礼物",{"_4051":16,"_15":4253,"_4094":37,"_4095":37,"_4125":4254,"_4127":4255,"_4129":1106,"_4130":4256},"chr_0014_aurora_27","chr_0014_aurora_mono_self_line01","管理员，你看，这是我用源石技艺新造的冰墙！是不是很结实？别担心，就算再用力些也没事！不会裂开的！","信赖对话1",{"_4051":16,"_15":4258,"_4094":64,"_4095":3711,"_4125":4259,"_4127":4260,"_4129":1145,"_4130":4261},"chr_0014_aurora_28","chr_0014_aurora_mono_self_line02","最近有好好休息吗，管理员？总看到你到处跑来跑去，就没怎么停下来过……要注意劳逸结合噢！上回救援训练，我背你的时候真的被吓了一跳……简直比刚出生的小驮兽还要轻……","信赖对话2",{"_4051":16,"_15":4263,"_4094":64,"_4095":3711,"_4125":4264,"_4127":4265,"_4129":1185,"_4130":4266},"chr_0014_aurora_29","chr_0014_aurora_mono_self_line03","救援工作也不是每次都那么顺利……突发天气或是地形变化总会来得比预想中更快。所以每次出发前，我都会多检查两遍我们的救援设备，从无人机到体温识别仪……它们也是救援队员重要的伙伴，是我们敢于大胆行动的底气来源。","信赖对话3",{"_4051":16,"_15":4268,"_4094":64,"_4095":4121,"_4125":4269,"_4127":4270,"_4129":56,"_4130":4271},"chr_0014_aurora_30","chr_0014_aurora_mono_self_line04","我曾在一场雪难里救下过一对父女……他们那时好像在闹矛盾，待在我搭的临时庇护所里也互不理睬。但当风雪来袭的时候，爸爸总会把食物留给女儿，女儿也总关心着爸爸……等到获救后，两个人还是不和对方说话。那时我就在想，这会不会就是那种叫做“亲情”的牵绊呢？即使说不出口，关键时刻也会为彼此挺身而出……","信赖对话4",{"_4051":16,"_15":4273,"_4094":64,"_4095":4121,"_4125":4274,"_4127":4275,"_4129":1263,"_4130":4276},"chr_0014_aurora_31","chr_0014_aurora_mono_self_line05","拯救生命是一项艰苦的工作，而我也没妄想过能不付出任何代价就帮助所有人。我入队时的同期，已经没人留在队里了。他们有些在侵蚀灾害中落下了残疾，有些在冰冷的雪夜失去了理性……我的确感到过茫然，甚至有些胆怯。但是，终末地的大家都很厉害，也很坚强！在管理员的帮助下，相信我们所有人都能走得更远一点！","信赖对话5",{"_4051":16,"_15":4278,"_4094":37,"_4095":37,"_4125":4279,"_4127":4280,"_4129":1302,"_4130":4281},"chr_0014_aurora_32","chr_0014_aurora_mono_chat_line01","这块滑雪板吗？它是我离开罗德岛时，华法琳女士送我的礼物。和我的盾牌一样，它也是用稀有的材料打造的，在救援行动时特别有用！嗯？难道管理员对滑雪感兴趣？我可以教你！","交谈1",{"_4051":16,"_15":4283,"_4094":37,"_4095":37,"_4125":4284,"_4127":4285,"_4129":117,"_4130":4286},"chr_0014_aurora_33","chr_0014_aurora_mono_chat_line02","救援队隶属于北方走廊救助联合会，我们遇到的救援对象常常是那些因公前往北方的信使、来往贸易的商人，偶尔还有遭到天使或野兽袭击后迷路的军队斥候。而我们的成员同样来自天南海北，大多数是志愿者。虽然总是在和冰天雪地打交道，但其实也结识了很多不一样的人呢。","交谈2",{"_4051":16,"_15":4288,"_4094":37,"_4095":37,"_4125":4289,"_4127":4290,"_4129":1380,"_4130":4291},"chr_0014_aurora_34","chr_0014_aurora_mono_chat_line03","最近也有干员问过我，要怎样才能加入救援队。其实不难的！只要平时经常进行高地徒步训练，能坚持数个小时无休的搜救，学过一些极地生存技巧，知道怎么躲避锚点与大型野兽，再接受完整的急救培训课程——至少到能处理突发矿石病的水平，最后通过我们队长专门设计的实地测试，就能正式加入啦！","交谈3",{"_4051":16,"_15":4293,"_4094":37,"_4095":37,"_4125":4294,"_4127":4295,"_4129":1420,"_4130":4296},"chr_0014_aurora_35","chr_0014_aurora_mono_chat_line04","我喜欢冰雪，喜欢雪山，喜欢这些严寒下依然璀璨的事物……所以我才更不希望它们给人带来痛苦的回忆。我想要让更多人在看到雪山时，最先想到的是山顶美丽的风景；想要让更多人看到冰雪时，最先想到的是纯净的冰晶与漂亮的雪花……而不是那些因雪灾带来的不幸。为了这个目标，我想我会一直努力下去的。","交谈4",{"_4051":16,"_15":4298,"_4094":37,"_4095":37,"_4125":4299,"_4127":4300,"_4129":156,"_4130":4301},"chr_0014_aurora_36","chr_0014_aurora_mono_chat_line05","昨天你有来找我吗，管理员？抱歉，我那时肯定是在补觉，所以才没发现。对，现在每次救援行动回来，我都会先好好睡一觉……有时一不小心就睡过头了，要过好久才能自然醒。不过要是有什么急事，直接来叫我就好啦！要是听到管理员的声音，我肯定马上就醒过来了！","交谈5",{"_4051":16,"_15":4303,"_4094":37,"_4095":37,"_4125":4304,"_4127":4305,"_4129":1498,"_4130":4306},"chr_0014_aurora_37","chr_0014_aurora_mono_about_line01","救援训练当然很重要啊！尤其是面对雪崩这样的自然灾害，如果大家都有很强的避险意识，可以在最短时间里找到身边坚固的躲藏地，往往就能大幅提高生存的可能性……所以管理员，下次的训练你肯定会来的，对吧？","话题：应急救援训练",{"_4051":16,"_15":4308,"_4094":37,"_4095":37,"_4125":4309,"_4127":4310,"_4129":1537,"_4130":4311},"chr_0014_aurora_38","chr_0014_aurora_mono_about_line02","洁尔佩塔小姐现在也在帝江号上吗？啊，之前的救援行动中，她帮我们做了很多额外的工作，像是物资搬运和伤员运送，甚至还在暴雪中精准定位到了高空中的求救信号。后来救援队本想送她点什么作为谢礼，她却全都拒绝了，说是拍些雪山的风景给她就好啦。嘿嘿，管理员你看，这些照片怎么样？相框也是我亲手制作的哦！","话题：洁尔佩塔",{"_4051":16,"_15":4313,"_4094":37,"_4095":37,"_4125":4314,"_4127":4315,"_4129":41,"_4130":4316},"chr_0014_aurora_39","chr_0014_aurora_mono_about_line03","想在极地生存可不是件容易的事……你要懂得怎么在暴雪中的帐篷里过夜才不至于失温，要学会从存在侵蚀的冰原上找到能入口的食材，要能判断冰川上哪里才适合落脚。最重要的是，要知道怎么在没有向导的时候，找出一条前往目的地的安全路线——避开天使、饥饿的动物还有那些危险的受灾地带。","话题：极地生存",{"_4051":16,"_15":4318,"_4094":37,"_4095":37,"_4125":4319,"_4127":4320,"_4129":44,"_4130":4321},"chr_0014_aurora_40","chr_0014_aurora_explore_point_common_01","这些物资最好都收集起来，救援时说不定能用上！","发现资源1",{"_4051":16,"_15":4323,"_4094":37,"_4095":37,"_4125":4324,"_4127":4325,"_4129":47,"_4130":4326},"chr_0014_aurora_41","chr_0014_aurora_explore_point_valub_01","好像找到了不得了的东西呢，或许能在以后的行动中发挥很大作用！","发现资源2",{"_4051":16,"_15":4328,"_4094":37,"_4095":37,"_4125":4329,"_4127":4330,"_4129":50,"_4130":4331},"chr_0014_aurora_42","chr_0014_aurora_explore_find_locked_01","是无人机还没探测到的地带，大家多注意防范。","发现未探索区域",{"_4051":16,"_15":4333,"_4094":37,"_4095":37,"_4125":4334,"_4127":4335,"_4129":1762,"_4130":4336},"chr_0014_aurora_43","chr_0014_aurora_explore_find_danger_01","前面的敌人很危险！各位小心！","发现强敌",{"_4051":16,"_15":4338,"_4094":37,"_4095":37,"_4125":4339,"_4127":4340,"_4129":1801,"_4130":4341},"chr_0014_aurora_44","chr_0014_aurora_interact_mine_valub_01","高质量的矿物，也许能用在临时庇护所的搭建上……","采集矿物1",{"_4051":16,"_15":4343,"_4094":37,"_4095":37,"_4125":4344,"_4127":4345,"_4129":269,"_4130":4346},"chr_0014_aurora_45","chr_0014_aurora_interact_mine_valub_echo2_01","大家一起来？肯定很快就能采完啦！","采集矿物2",{"_4051":16,"_15":4348,"_4094":37,"_4095":37,"_4125":4349,"_4127":4350,"_4129":1879,"_4130":4351},"chr_0014_aurora_46","chr_0014_aurora_interact_treasure_valub_01","作为救援物资储备起来吧！","打开储藏箱",{"_4051":16,"_15":4353,"_4094":37,"_4095":37,"_4125":4354,"_4127":4355,"_4129":1919,"_4130":4356},"chr_0014_aurora_47","chr_0014_aurora_interact_etherium_01","这就是醚质吧？好漂亮！赶紧收好吧！","获得醚质",{"_4051":16,"_15":4358,"_4094":37,"_4095":37,"_4125":4359,"_4127":4360,"_4129":72,"_4130":4361},"chr_0014_aurora_48","chr_0014_aurora_interact_blight_break_01","破坏成功！记得检查一下防侵蚀涂层的受损程度哦！","消除侵蚀",{"_4051":16,"_15":4363,"_4094":37,"_4095":37,"_4125":4364,"_4127":4365,"_4129":60,"_4130":4366},"chr_0014_aurora_49","chr_0014_aurora_interact_rest_01","要不要来一片奶酪？有助于体力恢复喔！","休整",{"_4051":16,"_15":4368,"_4094":37,"_4095":37,"_4125":4369,"_4127":4370,"_4129":76,"_4130":4371},"chr_0014_aurora_50","chr_0014_aurora_combat_suppuse_using_01","已进行应急处理！","使用战术物品1",{"_4051":16,"_15":4373,"_4094":37,"_4095":37,"_4125":4374,"_4127":4375,"_4129":78,"_4130":4376},"chr_0014_aurora_51","chr_0014_aurora_combat_suppuse_getheal_01","抱歉，让我先喘口气！","使用战术物品2",{"_4051":16,"_15":4378,"_4094":37,"_4095":37,"_4125":4379,"_4127":4380,"_4129":80,"_4130":4381},"chr_0014_aurora_52","chr_0014_aurora_combat_remind_danger_01","这个不能硬扛的！","危险提醒",{"_4051":16,"_15":4383,"_4094":37,"_4095":37,"_4125":4384,"_4127":4385,"_4129":82,"_4130":4386},"chr_0014_aurora_53","chr_0014_aurora_combat_hurt_lowhp_01","没事，我还忍得住……","负伤",{"_4051":16,"_15":4388,"_4094":37,"_4095":37,"_4125":4389,"_4127":4390,"_4129":84,