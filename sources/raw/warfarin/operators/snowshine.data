852,7851],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":7853,"_7350":7855,"_7353":7856},[7352,7352,7352],[7640,7641,7642],"toast_focal.key",{"_15":7857,"_7350":7859,"_7353":7860},[7352,7352,7352],[7852,7852,7852],"weapon.stress",{"_15":7861,"_7350":7863,"_7353":7864},[7352,7352,7352],[7865,7865,7865],"<color=#fe5a00>","weekraid.key",{"_15":7866,"_7350":7868,"_7353":7869},[7509,7509,7509],[7870,7870,7871],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_7874":7875,"_7881":7882,"_7563":7886,"_7891":7892,"_7895":7896,"_7900":7901,"_7904":7905,"_7909":7910,"_7913":7914,"_7918":7919,"_7922":7923,"_7378":7927,"_7932":7933,"_7936":7937,"_7941":7942,"_7946":7947,"_7950":7951,"_7955":7956,"_7461":7959,"_7964":7965,"_7968":7969,"_7974":7975,"_7467":7978,"_7983":7984,"_7987":7988,"_7485":7992,"_7997":7998,"_8001":8002,"_7492":8006,"_8011":8012,"_8017":8018,"_7516":8022,"_8027":8028,"_8032":8033,"_8037":8038,"_8042":8043,"_7523":8047,"_8051":8052,"_8056":8057,"_8061":8062,"_8065":8066,"_8071":8072,"_8076":8077,"_7553":8081,"_8086":8087,"_8091":8092,"_8094":8095,"_8098":8099,"_8103":8104,"_8107":8108,"_8113":8114,"_8117":8118,"_8122":8123,"_8127":8128,"_7570":8132,"_8136":8137,"_8139":8140,"_7590":8144,"_8148":8149,"_8153":8154,"_8158":8159,"_8163":8164,"_8167":8168,"_8172":8173,"_7390":8178,"_7429":8182,"_8187":8188,"_8192":8193,"_8197":8198,"_7616":8202,"_8207":8208,"_8210":8211,"_8214":8215,"_8218":8219,"_8223":8224,"_8228":8229,"_8232":8233,"_8237":8238,"_7656":8242,"_8246":8247,"_8251":8252,"_8256":8257,"_8260":8261,"_8264":8265,"_8268":8269,"_8273":8274,"_8278":8279,"_8282":8283,"_8288":8289,"_8292":8293,"_8296":8297,"_8301":8302,"_8305":8306,"_8309":8310,"_8313":8314,"_8319":8320,"_8324":8325,"_8329":8330,"_8334":8335,"_8339":8340,"_8344":8345,"_8349":8350,"_8354":8355,"_8359":8360,"_8364":8365,"_8369":8370,"_8374":8375,"_8379":8380,"_8384":8385},"adv.electricFence",{"_4613":7876,"_7877":4059,"_15":7874,"_7878":4059,"_19":7879,"_7880":7446},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4613":7883,"_7877":7884,"_15":7881,"_7878":4059,"_19":7885,"_7880":7499},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4613":7887,"_7877":7888,"_15":7563,"_7878":7889,"_19":7890,"_7880":7628},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4613":7893,"_7877":4059,"_15":7891,"_7878":4059,"_19":7894,"_7880":7446},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4613":7897,"_7877":7898,"_15":7895,"_7878":4059,"_19":7899,"_7880":7446},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4613":7902,"_7877":4059,"_15":7900,"_7878":4059,"_19":7903,"_7880":7446},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4613":7906,"_7877":7907,"_15":7904,"_7878":4059,"_19":7908,"_7880":7540},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4613":7911,"_7877":4059,"_15":7909,"_7878":4059,"_19":7912,"_7880":7446},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4613":7915,"_7877":7916,"_15":7913,"_7878":4059,"_19":7917,"_7880":7446},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4613":7920,"_7877":4059,"_15":7918,"_7878":4059,"_19":7921,"_7880":4059},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4613":7924,"_7877":7925,"_15":7922,"_7878":4059,"_19":7926,"_7880":7499},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4613":7928,"_7877":7929,"_15":7378,"_7878":7930,"_19":7931,"_7880":7628},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4613":7934,"_7877":4059,"_15":7932,"_7878":4059,"_19":7935,"_7880":7446},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4613":7938,"_7877":7939,"_15":7936,"_7878":4059,"_19":7940,"_7880":7446},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4613":7943,"_7877":7944,"_15":7941,"_7878":4059,"_19":7945,"_7880":7446},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4613":7948,"_7877":4059,"_15":7946,"_7878":4059,"_19":7949,"_7880":7473},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4613":7952,"_7877":7953,"_15":7950,"_7878":4059,"_19":7954,"_7880":7446},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4613":7957,"_7877":4059,"_15":7955,"_7878":4059,"_19":7958,"_7880":7473},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4613":7960,"_7877":7961,"_15":7461,"_7878":7962,"_19":7963,"_7880":7540},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4613":7966,"_7877":7961,"_15":7964,"_7878":4059,"_19":7967,"_7880":7540},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4613":7970,"_7877":7971,"_15":7968,"_7878":7972,"_19":7973,"_7880":7473},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4613":7976,"_7877":4059,"_15":7974,"_7878":4059,"_19":7977,"_7880":7473},"持续时间内，受影响的目标暂停行动。","定身",{"_4613":7979,"_7877":7980,"_15":7467,"_7878":7981,"_19":7982,"_7880":7652},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4613":7985,"_7877":7980,"_15":7983,"_7878":4059,"_19":7986,"_7880":7652},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4613":7989,"_7877":4059,"_15":7987,"_7878":7990,"_19":7991,"_7880":4059},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4613":7993,"_7877":7994,"_15":7485,"_7878":7995,"_19":7996,"_7880":7602},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4613":7999,"_7877":7994,"_15":7997,"_7878":4059,"_19":8000,"_7880":7602},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4613":8003,"_7877":8004,"_15":8001,"_7878":4059,"_19":8005,"_7880":7446},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4613":8007,"_7877":8008,"_15":7492,"_7878":8009,"_19":8010,"_7880":7628},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4613":8013,"_7877":8014,"_15":8011,"_7878":8015,"_19":8016,"_7880":7473},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4613":8019,"_7877":8020,"_15":8017,"_7878":4059,"_19":8021,"_7880":7473},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4613":8023,"_7877":8024,"_15":7516,"_7878":8025,"_19":8026,"_7880":7499},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4613":8029,"_7877":4059,"_15":8027,"_7878":8030,"_19":8031,"_7880":7499},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4613":8034,"_7877":8035,"_15":8032,"_7878":4059,"_19":8036,"_7880":7446},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4613":8039,"_7877":8040,"_15":8037,"_7878":4059,"_19":8041,"_7880":7446},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4613":8044,"_7877":8045,"_15":8042,"_7878":4059,"_19":8046,"_7880":7499},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4613":8048,"_7877":7884,"_15":7523,"_7878":8049,"_19":8050,"_7880":7499},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4613":8053,"_7877":4059,"_15":8051,"_7878":8054,"_19":8055,"_7880":7473},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4613":8058,"_7877":8059,"_15":8056,"_7878":4059,"_19":8060,"_7880":7446},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4613":8063,"_7877":4059,"_15":8061,"_7878":4059,"_19":8064,"_7880":4059},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4613":8067,"_7877":8068,"_15":8065,"_7878":8069,"_19":8070,"_7880":7473},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4613":8073,"_7877":8074,"_15":8071,"_7878":4059,"_19":8075,"_7880":7446},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4613":8078,"_7877":4059,"_15":8076,"_7878":8079,"_19":8080,"_7880":7540},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4613":8082,"_7877":8083,"_15":7553,"_7878":8084,"_19":8085,"_7880":7540},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4613":8088,"_7877":8089,"_15":8086,"_7878":4059,"_19":8090,"_7880":7446},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4613":7966,"_7877":8083,"_15":8091,"_7878":4059,"_19":8093,"_7880":7540},"干员受到灼热附着","sys.tacticalItem",{"_4613":8096,"_7877":4059,"_15":8094,"_7878":4059,"_19":8097,"_7880":7446},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4613":8100,"_7877":8101,"_15":8098,"_7878":4059,"_19":8102,"_7880":7540},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4613":7985,"_7877":8105,"_15":8103,"_7878":4059,"_19":8106,"_7880":7652},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4613":8109,"_7877":8110,"_15":8107,"_7878":8111,"_19":8112,"_7880":7473},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4613":8115,"_7877":4059,"_15":8113,"_7878":4059,"_19":8116,"_7880":7473},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4613":8119,"_7877":8120,"_15":8117,"_7878":4059,"_19":8121,"_7880":7628},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4613":8124,"_7877":8125,"_15":8122,"_7878":4059,"_19":8126,"_7880":7652},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4613":8129,"_7877":8130,"_15":8127,"_7878":4059,"_19":8131,"_7880":7473},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4613":8133,"_7877":8134,"_15":7570,"_7878":8025,"_19":8135,"_7880":7499},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4613":7883,"_7877":8134,"_15":8136,"_7878":4059,"_19":8138,"_7880":7499},"干员受到冻结","ba.naturalvul",{"_4613":8141,"_7877":8142,"_15":8139,"_7878":4059,"_19":8143,"_7880":7602},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4613":7928,"_7877":8145,"_15":7590,"_7878":8146,"_19":8147,"_7880":7628},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4613":8150,"_7877":8151,"_15":8148,"_7878":4059,"_19":8152,"_7880":7446},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4613":8155,"_7877":8156,"_15":8153,"_7878":4059,"_19":8157,"_7880":7446},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4613":8160,"_7877":8161,"_15":8158,"_7878":4059,"_19":8162,"_7880":7446},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4613":8165,"_7877":4059,"_15":8163,"_7878":4059,"_19":8166,"_7880":7446},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4613":8169,"_7877":4059,"_15":8167,"_7878":8170,"_19":8171,"_7880":4059},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4613":8174,"_7877":8175,"_15":8172,"_7878":8176,"_19":8177,"_7880":7473},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4613":8179,"_7877":4059,"_15":7390,"_7878":8180,"_19":8181,"_7880":7602},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4613":8183,"_7877":8184,"_15":7429,"_7878":8185,"_19":8186,"_7880":7628},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4613":8189,"_7877":8190,"_15":8187,"_7878":4059,"_19":8191,"_7880":7446},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4613":8194,"_7877":8195,"_15":8192,"_7878":4059,"_19":8196,"_7880":7602},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4613":8199,"_7877":8200,"_15":8197,"_7878":4059,"_19":8201,"_7880":7446},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4613":8203,"_7877":8204,"_15":7616,"_7878":8205,"_19":8206,"_7880":7602},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4613":7999,"_7877":8204,"_15":8207,"_7878":4059,"_19":8209,"_7880":7602},"干员受到自然附着","ba.originium",{"_4613":8212,"_7877":4059,"_15":8210,"_7878":4059,"_19":8213,"_7880":7473},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4613":8216,"_7877":4059,"_15":8214,"_7878":4059,"_19":8217,"_7880":7628},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4613":8220,"_7877":8221,"_15":8218,"_7878":4059,"_19":8222,"_7880":7628},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4613":8225,"_7877":4059,"_15":8223,"_7878":8226,"_19":8227,"_7880":7636},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4613":8230,"_7877":4059,"_15":8228,"_7878":4059,"_19":8231,"_7880":7446},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4613":8234,"_7877":4059,"_15":8232,"_7878":8235,"_19":8236,"_7880":7652},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4613":8239,"_7877":8240,"_15":8237,"_7878":4059,"_19":8241,"_7880":7446},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4613":8243,"_7877":8105,"_15":7656,"_7878":8244,"_19":8245,"_7880":7652},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4613":8248,"_7877":8249,"_15":8246,"_7878":4059,"_19":8250,"_7880":7652},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4613":8253,"_7877":4059,"_15":8251,"_7878":8254,"_19":8255,"_7880":7473},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4613":8258,"_7877":4059,"_15":8256,"_7878":8259,"_19":6074,"_7880":4059},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","sys.manualCraftTonic",{"_4613":8262,"_7877":4059,"_15":8260,"_7878":4059,"_19":8263,"_7880":7446},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4613":8266,"_7877":4059,"_15":8264,"_7878":4059,"_19":8267,"_7880":7473},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4613":8270,"_7877":8271,"_15":8268,"_7878":4059,"_19":8272,"_7880":7446},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4613":8275,"_7877":4059,"_15":8273,"_7878":8276,"_19":8277,"_7880":7473},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4613":8280,"_7877":4059,"_15":8278,"_7878":4059,"_19":8281,"_7880":7446},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4613":8284,"_7877":8285,"_15":8282,"_7878":8286,"_19":8287,"_7880":7473},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4613":8290,"_7877":4059,"_15":8288,"_7878":4059,"_19":8291,"_7880":7473},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4613":8294,"_7877":4059,"_15":8292,"_7878":4059,"_19":8295,"_7880":7473},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4613":8298,"_7877":8299,"_15":8296,"_7878":4059,"_19":8300,"_7880":7446},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4613":8303,"_7877":4059,"_15":8301,"_7878":4059,"_19":8304,"_7880":7473},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4613":8307,"_7877":4059,"_15":8305,"_7878":4059,"_19":8308,"_7880":7473},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4613":8311,"_7877":4059,"_15":8309,"_7878":4059,"_19":8312,"_7880":7473},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4613":8315,"_7877":8316,"_15":8313,"_7878":8317,"_19":8318,"_7880":7473},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4613":8321,"_7877":8322,"_15":8319,"_7878":4059,"_19":8323,"_7880":7446},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4613":8326,"_7877":8327,"_15":8324,"_7878":4059,"_19":8328,"_7880":7446},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4613":8331,"_7877":8332,"_15":8329,"_7878":4059,"_19":8333,"_7880":7446},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4613":8336,"_7877":8337,"_15":8334,"_7878":4059,"_19":8338,"_7880":7446},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4613":8341,"_7877":8342,"_15":8339,"_7878":4059,"_19":8343,"_7880":7446},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4613":8346,"_7877":8347,"_15":8344,"_7878":4059,"_19":8348,"_7880":7446},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4613":8351,"_7877":8352,"_15":8349,"_7878":4059,"_19":8353,"_7880":7446},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4613":8356,"_7877":8357,"_15":8354,"_7878":4059,"_19":8358,"_7880":7446},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4613":8361,"_7877":8362,"_15":8359,"_7878":4059,"_19":8363,"_7880":7446},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4613":8366,"_7877":8367,"_15":8364,"_7878":4059,"_19":8368,"_7880":7446},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4613":8371,"_7877":8372,"_15":8369,"_7878":4059,"_19":8373,"_7880":7446},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4613":8376,"_7877":8377,"_15":8374,"_7878":4059,"_19":8378,"_7880":7446},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4613":8381,"_7877":8382,"_15":8379,"_7878":4059,"_19":8383,"_7880":7446},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4613":8386,"_7877":8387,"_15":8384,"_7878":4059,"_19":8388,"_7880":7446},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7081":8391,"_6736":8400,"_6740":8402,"_5669":8404,"_6743":8406,"_6414":8408,"_6746":8410,"_6749":8412,"_6752":8414,"_6755":8415,"_5672":8417,"_6760":8419,"_6763":8420,"_6766":8421,"_6768":8422,"_6407":8423,"_6773":8424,"_6776":8425,"_6780":8427,"_6783":8428,"_6067":8429,"_6790":8430,"_6793":8431,"_6797":8432,"_5660":8433,"_6803":8434,"_6807":8435,"_6811":8437,"_6815":8438,"_5694":8440,"_6073":8442,"_6825":8444,"_6829":8445,"_6833":8447,"_5720":8449,"_6840":8450,"_6844":8452,"_6848":8454,"_5746":8456,"_6855":8458,"_6859":8461,"_5772":8464,"_6866":8467,"_5797":8470,"_6873":8471,"_6877":8473,"_5822":8474,"_6884":8475,"_5844":8477,"_6891":8479,"_5869":8480,"_6898":8482,"_5894":8484,"_5918":8486,"_5939":8488,"_6911":8490,"_6915":84