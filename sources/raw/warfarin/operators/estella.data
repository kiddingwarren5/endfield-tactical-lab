],"<mark=#444444><color=#44444400>","<mark=#E6E6E6><color=#E6E6E600>","qu.largenumdown",{"_15":7631,"_7190":7633,"_7193":7635},[7634,7634,7634],"</color></size>",[7636,7636,7636],"<size=54><color=#e74414>","nar.quote",{"_15":7637,"_7190":7639,"_7193":7641},[7640,7640,7640],"</i>",[7642,7642,7642],"<i>","nar.right",{"_15":7643,"_7190":7645,"_7193":7646},[7529,7529,7529],[7647,7647,7647],"<align=\"right\">","opt.key",{"_15":7648,"_7190":7650,"_7193":7651},[7192,7192,7192],[7652,7652,7652],"<color=#5ECDFF>","qu.numdown",{"_15":7653,"_7190":7655,"_7193":7656},[7192,7192,7192],[7657,7657,7657],"<color=#e74414>","toast_craft.key",{"_15":7658,"_7190":7660,"_7193":7661},[7192,7192,7192],[7245,7245,7246],"qu.numup",{"_15":7662,"_7190":7664,"_7193":7665},[7192,7192,7192],[7666,7666,7666],"<color=#c7fe02>","rac.tec",{"_15":7667,"_7190":7669,"_7193":7670},[7192,7192,7192],[7671,7671,7671],"<color=#FFCC00>","scene_grade.down",{"_15":7672,"_7190":7674,"_7193":7675},[7192,7192,7192],[7676,7676,7676],"<color=#D12E42>","set.key",{"_15":7677,"_7190":7679,"_7193":7680},[7192,7192,7192],[7681,7681,7681],"<color=#A7A7A7>","tech.get",{"_15":7682,"_7190":7684,"_7193":7685},[7192,7192,7192],[7686,7686,7686],"<color=#1e1e1e>","tips.key",{"_15":7687,"_7190":7689,"_7193":7690},[7192,7192,7192],[7691,7692,7691],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":7693,"_7190":7695,"_7193":7696},[7192,7192,7192],[7480,7481,7482],"toast_focal.key",{"_15":7697,"_7190":7699,"_7193":7700},[7192,7192,7192],[7692,7692,7692],"weapon.stress",{"_15":7701,"_7190":7703,"_7193":7704},[7192,7192,7192],[7705,7705,7705],"<color=#fe5a00>","weekraid.key",{"_15":7706,"_7190":7708,"_7193":7709},[7349,7349,7349],[7710,7710,7711],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_7714":7715,"_7721":7722,"_7403":7726,"_7731":7732,"_7735":7736,"_7740":7741,"_7744":7745,"_7749":7750,"_7753":7754,"_7758":7759,"_7762":7763,"_7218":7767,"_7772":7773,"_7776":7777,"_7781":7782,"_7786":7787,"_7790":7791,"_7795":7796,"_7301":7799,"_7804":7805,"_7808":7809,"_7814":7815,"_7307":7818,"_7823":7824,"_7827":7828,"_7325":7832,"_7837":7838,"_7841":7842,"_7332":7846,"_7851":7852,"_7857":7858,"_7356":7862,"_7867":7868,"_7872":7873,"_7877":7878,"_7882":7883,"_7363":7887,"_7891":7892,"_7896":7897,"_7901":7902,"_7905":7906,"_7911":7912,"_7916":7917,"_7393":7921,"_7926":7927,"_7931":7932,"_7934":7935,"_7938":7939,"_7943":7944,"_7947":7948,"_7953":7954,"_7957":7958,"_7962":7963,"_7967":7968,"_7410":7972,"_7976":7977,"_7979":7980,"_7430":7984,"_7988":7989,"_7993":7994,"_7998":7999,"_8003":8004,"_8007":8008,"_8012":8013,"_7230":8018,"_7269":8022,"_8027":8028,"_8032":8033,"_8037":8038,"_7456":8042,"_8047":8048,"_8050":8051,"_8054":8055,"_8058":8059,"_8063":8064,"_8068":8069,"_8072":8073,"_8077":8078,"_7496":8082,"_8086":8087,"_8091":8092,"_8096":8097,"_8101":8102,"_8105":8106,"_8109":8110,"_8114":8115,"_8119":8120,"_8123":8124,"_8129":8130,"_8133":8134,"_8137":8138,"_8142":8143,"_8146":8147,"_8150":8151,"_8154":8155,"_8160":8161,"_8165":8166,"_8170":8171,"_8175":8176,"_8180":8181,"_8185":8186,"_8190":8191,"_8195":8196,"_8200":8201,"_8205":8206,"_8210":8211,"_8215":8216,"_8220":8221,"_8225":8226},"adv.electricFence",{"_4620":7716,"_7717":4060,"_15":7714,"_7718":4060,"_19":7719,"_7720":7286},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4620":7723,"_7717":7724,"_15":7721,"_7718":4060,"_19":7725,"_7720":7339},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4620":7727,"_7717":7728,"_15":7403,"_7718":7729,"_19":7730,"_7720":7468},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4620":7733,"_7717":4060,"_15":7731,"_7718":4060,"_19":7734,"_7720":7286},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4620":7737,"_7717":7738,"_15":7735,"_7718":4060,"_19":7739,"_7720":7286},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4620":7742,"_7717":4060,"_15":7740,"_7718":4060,"_19":7743,"_7720":7286},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4620":7746,"_7717":7747,"_15":7744,"_7718":4060,"_19":7748,"_7720":7380},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4620":7751,"_7717":4060,"_15":7749,"_7718":4060,"_19":7752,"_7720":7286},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4620":7755,"_7717":7756,"_15":7753,"_7718":4060,"_19":7757,"_7720":7286},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4620":7760,"_7717":4060,"_15":7758,"_7718":4060,"_19":7761,"_7720":4060},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4620":7764,"_7717":7765,"_15":7762,"_7718":4060,"_19":7766,"_7720":7339},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4620":7768,"_7717":7769,"_15":7218,"_7718":7770,"_19":7771,"_7720":7468},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4620":7774,"_7717":4060,"_15":7772,"_7718":4060,"_19":7775,"_7720":7286},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4620":7778,"_7717":7779,"_15":7776,"_7718":4060,"_19":7780,"_7720":7286},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4620":7783,"_7717":7784,"_15":7781,"_7718":4060,"_19":7785,"_7720":7286},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4620":7788,"_7717":4060,"_15":7786,"_7718":4060,"_19":7789,"_7720":7313},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4620":7792,"_7717":7793,"_15":7790,"_7718":4060,"_19":7794,"_7720":7286},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4620":7797,"_7717":4060,"_15":7795,"_7718":4060,"_19":7798,"_7720":7313},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4620":7800,"_7717":7801,"_15":7301,"_7718":7802,"_19":7803,"_7720":7380},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4620":7806,"_7717":7801,"_15":7804,"_7718":4060,"_19":7807,"_7720":7380},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4620":7810,"_7717":7811,"_15":7808,"_7718":7812,"_19":7813,"_7720":7313},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4620":7816,"_7717":4060,"_15":7814,"_7718":4060,"_19":7817,"_7720":7313},"持续时间内，受影响的目标暂停行动。","定身",{"_4620":7819,"_7717":7820,"_15":7307,"_7718":7821,"_19":7822,"_7720":7492},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4620":7825,"_7717":7820,"_15":7823,"_7718":4060,"_19":7826,"_7720":7492},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4620":7829,"_7717":4060,"_15":7827,"_7718":7830,"_19":7831,"_7720":4060},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4620":7833,"_7717":7834,"_15":7325,"_7718":7835,"_19":7836,"_7720":7442},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4620":7839,"_7717":7834,"_15":7837,"_7718":4060,"_19":7840,"_7720":7442},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4620":7843,"_7717":7844,"_15":7841,"_7718":4060,"_19":7845,"_7720":7286},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4620":7847,"_7717":7848,"_15":7332,"_7718":7849,"_19":7850,"_7720":7468},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4620":7853,"_7717":7854,"_15":7851,"_7718":7855,"_19":7856,"_7720":7313},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4620":7859,"_7717":7860,"_15":7857,"_7718":4060,"_19":7861,"_7720":7313},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4620":7863,"_7717":7864,"_15":7356,"_7718":7865,"_19":7866,"_7720":7339},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4620":7869,"_7717":4060,"_15":7867,"_7718":7870,"_19":7871,"_7720":7339},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4620":7874,"_7717":7875,"_15":7872,"_7718":4060,"_19":7876,"_7720":7286},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4620":7879,"_7717":7880,"_15":7877,"_7718":4060,"_19":7881,"_7720":7286},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4620":7884,"_7717":7885,"_15":7882,"_7718":4060,"_19":7886,"_7720":7339},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4620":7888,"_7717":7724,"_15":7363,"_7718":7889,"_19":7890,"_7720":7339},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4620":7893,"_7717":4060,"_15":7891,"_7718":7894,"_19":7895,"_7720":7313},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4620":7898,"_7717":7899,"_15":7896,"_7718":4060,"_19":7900,"_7720":7286},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4620":7903,"_7717":4060,"_15":7901,"_7718":4060,"_19":7904,"_7720":4060},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4620":7907,"_7717":7908,"_15":7905,"_7718":7909,"_19":7910,"_7720":7313},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4620":7913,"_7717":7914,"_15":7911,"_7718":4060,"_19":7915,"_7720":7286},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4620":7918,"_7717":4060,"_15":7916,"_7718":7919,"_19":7920,"_7720":7380},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4620":7922,"_7717":7923,"_15":7393,"_7718":7924,"_19":7925,"_7720":7380},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4620":7928,"_7717":7929,"_15":7926,"_7718":4060,"_19":7930,"_7720":7286},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4620":7806,"_7717":7923,"_15":7931,"_7718":4060,"_19":7933,"_7720":7380},"干员受到灼热附着","sys.tacticalItem",{"_4620":7936,"_7717":4060,"_15":7934,"_7718":4060,"_19":7937,"_7720":7286},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4620":7940,"_7717":7941,"_15":7938,"_7718":4060,"_19":7942,"_7720":7380},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4620":7825,"_7717":7945,"_15":7943,"_7718":4060,"_19":7946,"_7720":7492},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4620":7949,"_7717":7950,"_15":7947,"_7718":7951,"_19":7952,"_7720":7313},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4620":7955,"_7717":4060,"_15":7953,"_7718":4060,"_19":7956,"_7720":7313},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4620":7959,"_7717":7960,"_15":7957,"_7718":4060,"_19":7961,"_7720":7468},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4620":7964,"_7717":7965,"_15":7962,"_7718":4060,"_19":7966,"_7720":7492},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4620":7969,"_7717":7970,"_15":7967,"_7718":4060,"_19":7971,"_7720":7313},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4620":7973,"_7717":7974,"_15":7410,"_7718":7865,"_19":7975,"_7720":7339},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4620":7723,"_7717":7974,"_15":7976,"_7718":4060,"_19":7978,"_7720":7339},"干员受到冻结","ba.naturalvul",{"_4620":7981,"_7717":7982,"_15":7979,"_7718":4060,"_19":7983,"_7720":7442},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4620":7768,"_7717":7985,"_15":7430,"_7718":7986,"_19":7987,"_7720":7468},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4620":7990,"_7717":7991,"_15":7988,"_7718":4060,"_19":7992,"_7720":7286},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4620":7995,"_7717":7996,"_15":7993,"_7718":4060,"_19":7997,"_7720":7286},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4620":8000,"_7717":8001,"_15":7998,"_7718":4060,"_19":8002,"_7720":7286},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4620":8005,"_7717":4060,"_15":8003,"_7718":4060,"_19":8006,"_7720":7286},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4620":8009,"_7717":4060,"_15":8007,"_7718":8010,"_19":8011,"_7720":4060},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4620":8014,"_7717":8015,"_15":8012,"_7718":8016,"_19":8017,"_7720":7313},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4620":8019,"_7717":4060,"_15":7230,"_7718":8020,"_19":8021,"_7720":7442},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4620":8023,"_7717":8024,"_15":7269,"_7718":8025,"_19":8026,"_7720":7468},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4620":8029,"_7717":8030,"_15":8027,"_7718":4060,"_19":8031,"_7720":7286},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4620":8034,"_7717":8035,"_15":8032,"_7718":4060,"_19":8036,"_7720":7442},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4620":8039,"_7717":8040,"_15":8037,"_7718":4060,"_19":8041,"_7720":7286},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4620":8043,"_7717":8044,"_15":7456,"_7718":8045,"_19":8046,"_7720":7442},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4620":7839,"_7717":8044,"_15":8047,"_7718":4060,"_19":8049,"_7720":7442},"干员受到自然附着","ba.originium",{"_4620":8052,"_7717":4060,"_15":8050,"_7718":4060,"_19":8053,"_7720":7313},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4620":8056,"_7717":4060,"_15":8054,"_7718":4060,"_19":8057,"_7720":7468},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4620":8060,"_7717":8061,"_15":8058,"_7718":4060,"_19":8062,"_7720":7468},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4620":8065,"_7717":4060,"_15":8063,"_7718":8066,"_19":8067,"_7720":7476},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4620":8070,"_7717":4060,"_15":8068,"_7718":4060,"_19":8071,"_7720":7286},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4620":8074,"_7717":4060,"_15":8072,"_7718":8075,"_19":8076,"_7720":7492},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4620":8079,"_7717":8080,"_15":8077,"_7718":4060,"_19":8081,"_7720":7286},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4620":8083,"_7717":7945,"_15":7496,"_7718":8084,"_19":8085,"_7720":7492},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4620":8088,"_7717":8089,"_15":8086,"_7718":4060,"_19":8090,"_7720":7492},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4620":8093,"_7717":4060,"_15":8091,"_7718":8094,"_19":8095,"_7720":7313},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4620":8098,"_7717":4060,"_15":8096,"_7718":8099,"_19":8100,"_7720":4060},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4620":8103,"_7717":4060,"_15":8101,"_7718":4060,"_19":8104,"_7720":7286},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4620":8107,"_7717":4060,"_15":8105,"_7718":4060,"_19":8108,"_7720":7313},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4620":8111,"_7717":8112,"_15":8109,"_7718":4060,"_19":8113,"_7720":7286},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4620":8116,"_7717":4060,"_15":8114,"_7718":8117,"_19":8118,"_7720":7313},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4620":8121,"_7717":4060,"_15":8119,"_7718":4060,"_19":8122,"_7720":7286},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4620":8125,"_7717":8126,"_15":8123,"_7718":8127,"_19":8128,"_7720":7313},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4620":8131,"_7717":4060,"_15":8129,"_7718":4060,"_19":8132,"_7720":7313},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4620":8135,"_7717":4060,"_15":8133,"_7718":4060,"_19":8136,"_7720":7313},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4620":8139,"_7717":8140,"_15":8137,"_7718":4060,"_19":8141,"_7720":7286},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4620":8144,"_7717":4060,"_15":8142,"_7718":4060,"_19":8145,"_7720":7313},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4620":8148,"_7717":4060,"_15":8146,"_7718":4060,"_19":8149,"_7720":7313},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4620":8152,"_7717":4060,"_15":8150,"_7718":4060,"_19":8153,"_7720":7313},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4620":8156,"_7717":8157,"_15":8154,"_7718":8158,"_19":8159,"_7720":7313},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4620":8162,"_7717":8163,"_15":8160,"_7718":4060,"_19":8164,"_7720":7286},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4620":8167,"_7717":8168,"_15":8165,"_7718":4060,"_19":8169,"_7720":7286},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4620":8172,"_7717":8173,"_15":8170,"_7718":4060,"_19":8174,"_7720":7286},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4620":8177,"_7717":8178,"_15":8175,"_7718":4060,"_19":8179,"_7720":7286},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4620":8182,"_7717":8183,"_15":8180,"_7718":4060,"_19":8184,"_7720":7286},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4620":8187,"_7717":8188,"_15":8185,"_7718":4060,"_19":8189,"_7720":7286},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4620":8192,"_7717":8193,"_15":8190,"_7718":4060,"_19":8194,"_7720":7286},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4620":8197,"_7717":8198,"_15":8195,"_7718":4060,"_19":8199,"_7720":7286},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4620":8202,"_7717":8203,"_15":8200,"_7718":4060,"_19":8204,"_7720":7286},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4620":8207,"_7717":8208,"_15":8205,"_7718":4060,"_19":8209,"_7720":7286},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4620":8212,"_7717":8213,"_15":8210,"_7718":4060,"_19":8214,"_7720":7286},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4620":8217,"_7717":8218,"_15":8215,"_7718":4060,"_19":8219,"_7720":7286},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4620":8222,"_7717":8223,"_15":8220,"_7718":4060,"_19":8224,"_7720":7286},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4620":8227,"_7717":8228,"_15":8225,"_7718":4060,"_19":8229,"_7720":7286},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_6923":8232,"_6564":8241,"_6568":8243,"_6570":8245,"_6572":8247,"_6574":8249,"_6085":8251,"_6578":8253,"_6581":8255,"_6583":8256,"_5357":8258,"_6588":8261,"_6591":8262,"_6594":8263,"_6596":8265,"_6308":8266,"_6601":8267,"_6604":8268,"_6608":8270,"_6612":8271,"_6390":8272,"_6619":8273,"_6622":8274,"_6626":8275,"_6630":8276,"_6633":8277,"_6637":8278,"_6641":8280,"_6645":8281,"_6649":8283,"_6653":8285,"_6657":8287,"_6661":8288,"_6665":8290,"_6669":8292,"_6673":8293,"_6677":8295,"_6681":8297,"_6685":8299,"_6689":8301,"_6693":8304,"_6697":8307,"_6701":8310,"_6705":8313,"_6709":8314,"_6713":8316,"_6717":8317,"_6721":8318,"_6725":8320,"_6729":8322,"_6733":8323,"_6737":8325,"_6741":8327,"_6745":8329,"_6749":8331,"_6753":8333,"_6757":8335,"_6761":8337,"_6764":8339,"_6768":8341,"_6772":8343,"_6776":8344,"_6780":8346,"_6784":8347,"_6788":8348,"_6792":8349,"_6796":8350,"_6800":8351,"_6804":8352,"_6808":8353,"_6812":8354,"_6816":8355,"_6820":8356,"_6824":8357,"_6828":8358,"_6832":8359,"_6836":8360,"_6840":8361,"_6844":8362,"_6848":8363,"_6852":8364,"_6856":8365,"_6859":8366,"_6863":8367,"_6867":8368,"_6871":8369,"_6875":8370,"_6879":8371,"_6883":8373,"_6887":8374,"_6891":8375,"_8376":8377,"_8378":8379,"_8381":8382,"_8383":8384,"_8385":8386,"_8387":8388,"_8389":8390,"_8391":8392,"_8393":8394,"_8395":8396,"_8397":8398,"_8400":8401,"_8403":8404,"_8405":8406,"_8408":8409,"_8411":8412,"_8413":8414},{"_8233":37,"_8234":4060,"_8235