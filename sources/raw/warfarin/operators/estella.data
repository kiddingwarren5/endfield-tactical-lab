3904},5832,{"_36":55,"_38":3906},331,{"_36":58,"_38":37},{"_36":60,"_38":3909},1.48469387755102,{"_36":62,"_38":3911},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3931,"_101":64},{"_33":3932},[3933,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":3934},97,{"_36":41,"_38":3936},111.84266778876525,{"_36":44,"_38":3938},104.88407321691562,{"_36":47,"_38":3940},118.08163265306123,{"_36":50,"_38":3942},162.27203871239266,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},334,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3970,"_101":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},112.8718493583003,{"_36":44,"_38":3977},105.88533557752999,{"_36":47,"_38":3979},119.1645276667368,{"_36":50,"_38":3981},163.80612244898006,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},337,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4010,"_101":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},113.90103092783532,{"_36":44,"_38":4017},106.88659793814433,{"_36":47,"_38":4019},120.24742268041238,{"_36":50,"_38":4021},165.3402061855675,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},340,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4050,4051,4052],"tag_14","tag_03","tag_17","charId","charIllustInitPos",{"_4056":566,"_4057":4058},"x","y",-363,"charPassiveUIPrefabName","","charTypeId","Cryst","cvName",{"_4065":4066,"_4067":4068,"_4069":4070,"_4071":4072,"_4053":16},"ChiCVName","张炜萱","EngCVName","Risa Mei","JapCVName","高桥花林","KorCVName","李恩造","defaultWeaponId","wpn_lance_0009","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Estella","mainAttrType","phoneticName","profession","profileRecord",[4086,4097,4102,4107,4113,4118],{"_4053":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0021_whiten_1","recordDesc","【代号】埃特拉\n【性别】女\n【身份认证】终末地工业\n【生日】4月9日\n【种族】菲林\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：普通\n作战技巧：标准\n战术规划：优良\n源石技艺适应性：标准\n\n针对埃特拉小姐最新的体测数据，我们强烈建议其强化耐力训练，以提升肌肉耐受力。下一次体测数据如果依旧不理想，会强制安排训练日程，并交由Z7行动组组长监督执行。","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0021_whiten_2","干员埃特拉，本名埃特拉·科尔，在环塔商会与联盟工团管辖区域均有活动记录。其在侦察与情报收集方面展现了过人天赋，经干员秋栗申请，纳入Z7行动组管理。\n\n埃特拉有着丰富的经历，我本想深入了解她的过往，可她在签约过程中始终很安静，除了回答问题外并无主动沟通的意愿。此外，在仅有的一些话题中，她的回答常常让我无法理解……好在她并没有什么原则性的问题。鉴于其直属上司秋栗女士的良好声誉与预先担保，暂不考虑由于她沟通能力不足导致的管理风险，准许入职。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0021_whiten_3","提起Z7行动组集结周年纪念日，除埃特拉以外的成员，恐怕都不会觉得这是什么愉快的回忆。但是，也不会有人否认，这是一段终生难忘的回忆。\n起初，秋栗只是发现纪念日那天正好没有外勤任务，便提议要不要小小庆祝一下。大家都觉得不错，便讨论起如何庆祝。由于那时他们驻扎在远离文明环带的荒野，大家的建议不外乎是一些户外活动，所以投票时均遭到了不愿进行体力活动的埃特拉的否决。最终，只有“河边野餐”这个方案通过了。它未必是所有人的最优选，但也没人不喜欢。\n纪念日当天，大家情绪高昂地收集着食材，不外乎是一些山菜野味。唯独埃特拉，捧着一堆五颜六色的菌类归来，遭到了队友们的强烈抵制，拒绝她的食材入锅。最终，在秋栗的把关下，才勉强从埃特拉的食材中，取出了一些长相低调的蘑菇入锅烹饪。\n伴着落日，小队的大家在河边架起了锅，开始享用劳动成果。然而，这些蘑菇虽然没有太强的毒性，却也不似长相般温和，尝起来辛辣无比。喝完了携带的水，还是不解辣，大家索性来到河边，捧起河水狂饮，希望能压制口中的辛辣。可喝着喝着，上游传来低沉的轰鸣——是上游的水坝在泄洪！\n“坏了，我忘了今天没外勤就是因为工团的泄洪通知！”\n关于被洪流卷入的细节，大家都记不太清楚了。待他们回过神，发现埃特拉已经踩着锅，像一个熟练的冲浪者一般踏浪远去了。当剩余四人互相搀扶着上了岸，天色已晚，只能摸黑顺着河向下游寻找埃特拉。最终，在凌晨时分，才在一个流民的篝火边找到了熟睡的埃特拉。流民们热情招待了秋栗一行人，他们也吃到了一顿真正的野味大餐。\n在流民们的好心挽留下，小队决定在这里休息一夜。当秋栗枕着漫天群星，准备好好睡上一觉时，想起了明早还有外勤任务。最终，四人轮流背着无法叫醒的埃特拉，在东方鱼肚白时分，赶回了营地。\n据事后回忆，埃特拉之所以无法叫醒，大约是偷吃了她自己采摘的菌类，以至于她将洪流看作了沸腾的人潮，她像个摇滚明星一般进行着“跳水”的仪式，被人流托举着高歌。至于埃特拉当时唱了什么，没人知道。秋栗只记得，自己背着埃特拉一步一步走回营地时，背上的少女说着梦话——关于回家。","CN_03","档案资料·一",{"_4053":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":4112},"chr_0021_whiten_4","【行动记录归档资料（已作废）】\n“埃特拉干员，此次针对裂地者残党的潜入所进行的侦察与反侦察行动大获成功，你功不可没。我需要针对以下战果进行细节复盘，作为后续行动的参照与指导。”\n“好的，过奖了。”\n“你是如何巧妙避开了敌人的佯攻，并推测出其主攻部队的动向的？”\n“是……我进行了非受迫性待命。当待命结束，敌人的大部队已行进至视野范围内。”\n“也就是说，你接收到了相关指令吗？好强的前瞻性，是秋栗组长下达的吗？”\n“是无氧代谢副产物累积与电解质失衡，我是这么感觉的……”\n“唔……所以你只是因为休息错过了敌人的佯攻部队，结果碰上了主力部队。好吧……下一个问题。”\n“你是如何截获了敌人的行动暗号，并破译出敌人下一步动向的？”\n“拍子不对，我听到了。”\n“什么的拍子？”\n“残党的驻地，我潜伏了一天一夜，他们一直在播放《DEATH☆DREAMS》那张专辑，我从小时候就开始听了。秋栗和萤石嫌吵，我很久没听过了。”\n“麻烦说重点……”\n“这张专辑的编曲很简单，鼓组从头到尾都是4/4拍，我对每首歌的节奏型都很熟。但那天却很怪，低频不稳，有一个不断变化的声音潜伏在鼓点下。”\n“越来越听不懂了，然后呢？”\n“我以为是什么荒野Remix，就认真听了那个节奏，并记了下来。那是一段裂地者暗号，我学过。后来，我们集结并肃清了这个据点，发现他们在用震荡器向外发送暗码，《DEATH☆DREAMS》只是障眼法，糟蹋了好音乐。”\n“呃……不管怎么说，你成功提供了关键情报，谢谢，询问结束。”\n\n以上行动记录对一般行动组并无参考价值，申请作废。\n——Z7行动组组长 秋栗","CN_04","档案资料·二",300,{"_4053":16,"_15":4114,"_4088":4115,"_4090":4116,"_4092":66,"_4093":4117,"_4095":64,"_4096":4112},"chr_0021_whiten_5","【与秋栗组长就干员埃特拉背景调查的对谈记录】\n由于干员情况特殊，秋栗组长事先与我进行了干员背景说明，并出示了相关物件资料。\n\n物件：照片\n这是一张老照片。银白色头发的菲林女孩坐在木制摇椅上，一脸幸福。她的身边是同为银白发色的青年男女，他们的手轻柔地搭在女孩两肩，看上去是非常幸福的一家人。\n据秋栗介绍，这是埃特拉干员10岁生日时摄于家中书房的照片，那里如今已是一片废墟。天使与侵蚀迫使他们流离失所，一家人带着所有积蓄来到菈梵朵玛，希望可以在那里安顿下来。\n可是，事情并没有如他们所愿。接下来是秋栗组长出示的报刊资料，记录了埃特拉一家人是如何在投资中受骗，损失了几乎所有存款。\n\n物件：旧报刊\n《麦道夫金融欺诈案终告破：受害者血本无归，主犯挥霍殆尽》\n本报9日讯（记者 梅拉达）曾轰动塔卫二、造成巨额经济损失的特大金融诈骗案主犯伯纳·麦道夫，在潜逃多年后，已于日前被缉拿归案。\n经司法机关深入调查查明，该犯罪团伙长期以虚假的高额投资回报为诱饵，编织了一个巨大的金融骗局。其利用新投资者的本金，伪装成支付给老投资者的所谓“收益”，以此制造盈利丰厚的假象，吸引更多不明真相的企业与个体商户不断投入资金。这种“拆东墙补西墙”的违法活动，完全背离了真实投资创造价值的规律。\n经过执法部门锲而不舍的追捕，麦道夫终于落入法网，等待他的将是法律的严厉审判。但令人痛心的是，麦道夫团伙在潜逃过程中，已将绝大部分非法所得挥霍或转移，导致立案后可供追缴返还受害者的涉案资产所剩无几。这意味着，尽管主犯落网，但众多遭受重创的企业与个体商户，其巨大经济损失恐难以挽回。\n此案再次以沉重的代价警示社会：天上不会掉馅饼。广大投资者务必高度警惕，擦亮双眼，谨防落入不法分子精心设置的陷阱。\n\n案件告破时，埃特拉一家已经加入了工团，在北部矿区的39号矿洞工作，可好运还是没有眷顾这家人。秋栗组长拿出另一份简报。\n\n物件：旧报刊\n《北部矿区遭遇矿难 裂地者侵袭雪上加霜》\n本报19日讯（记者 里瑟），北部矿区39号矿洞发生大型矿难，多名矿工滞留矿洞。地面办事处几乎在同一时间被裂地者突袭，多名工人及家属失联。\n据矿区总负责人柳拜称，18日傍晚时分，39号矿洞即将结束作业，一声巨响后矿洞入口坍塌，仅少数距地表较近的矿工成功脱逃。目前，援救工作尚在进行，预计20日凌晨可以完成救援。目前，伤亡情况不明。\n本报也采访到矿区地面办事处负责人波夫科娃。据她介绍，18日傍晚，矿洞巨响后5分钟，大量武装裂地者出现，对地面设施进行破坏与掠夺。工团武装在几分钟内就被裂地者击溃，地面办事处职员与生活区的家属纷纷出逃。目前，伤亡情况还在统计，出逃人员仍处于失联状态。至于矿难与裂地者的袭击之间是否有关联，目前尚未有确切的调查结果。\n工团总部对此事高度重视，目前，已派出多支搜救部队，在北部矿区进行援救工作。本报也会持续跟进报导。\n\n据秋栗组长介绍，科尔先生，也就是埃特拉的父亲，事后被救援队从矿洞中救出，所幸生命无碍。而埃特拉和母亲则在裂地者的袭击中走散。科尔太太很快被工团的救援队所救，埃特拉则被裂地者俘获，被迫作为苦力在荒野上辗转。可是，这样严酷的经历却无意中展现了她的天赋。\n当时，Z7行动组潜入了某裂地者营地，秋栗组长遇到了埃特拉。这名浑身脏污的少女竟然通过口述交代了营地区域所有的地形结构与布防信息，甚至能单靠记忆在沙地上绘出地形图。通过这些情报，Z7行动组以极低的损失成功攻陷了该营地，并解救出了所有平民。\n秋栗组长看重埃特拉的情报能力，邀请她加入终末地。而埃特拉在多年颠沛流离后，非常渴望有一个安定的归宿，几乎没有犹豫便选择了加入。秋栗组长特别补充，由于这段艰苦的经历，埃特拉干员对重体力活动呈现出非常抵触的态度。\n\n以上是全部记录信息，已提交人力资源事务部进行参考。","CN_05","档案资料·三",{"_4053":16,"_15":4119,"_4088":4120,"_4090":4121,"_4092":68,"_4093":4122,"_4095":64,"_4096":4123},"chr_0021_whiten_6","【秋栗反复查看的一份医疗档案】\n基本信息\n患者名：埃特拉·科尔\n职务：Z7行动组成员，终末地工业正式干员\n行动代号：埃特拉\n入院方式：战地无人机转运\n接诊时间：23时07分\n接诊地点：终末地三号谷地荒野医护站点\n\n主诉\n卷入爆炸，全身多处出血、剧痛45分钟后陷入休克。\n\n现病史\n患者原本在距离事发地5千米处执行侦察任务，于45分钟前自行变更行动计划，为掩护受困战友突围，强行冲入交叉火力区，被迫与敌人近距离缠斗，并暴露在敌人的火力压制下。自述被当场震倒，意识短暂模糊，随后匍匐撤离约20米，被Z7行动组其余成员发现并快速送医。\n\n既往史\n既往体健，否认慢性病、手术史、输血史，非矿石病感染者。\n\n体格检查（入院时）\n意识模糊，面色苍白，神情痛苦\n生命体征：体温正常，脉搏细弱，血压偏低，呼吸微弱\n头颅：左侧额颞区4cm裂创，骨皮质连续，未及骨折征\n颈部：无气管偏移，平卧位颈静脉可见塌陷\n胸部：右肋贯通伤口，直径约1.2cm；叩诊鼓音，呼吸音减弱；心音低钝，节律齐\n腹部：右下腹肿胀压痛\n四肢：左股骨中段开放性骨折，创口6cm，可见骨端；右小腿后外侧贯通伤，出血处已加压包扎；双下肢远端动脉搏动减弱\n皮肤黏膜：多处擦挫伤\n\n初步诊断\n右侧开放性气胸\n失血性休克（Ⅲ级）\n左股骨开放性Ⅲ型骨折\n多发软组织贯通伤\n颅脑轻度闭合性损伤\n\n紧急处理清单\n开放性气胸处理\n血容量复苏\n抗休克\n止痛\n抗源石感染\n左股骨与右小腿伤口\n破伤风免疫\n\n预后评估\n紧急处理后，转入终末地医疗部门\n根据战伤评估，24小时内生存率预估85%\n若血流动力学稳定且无继发感染，预期6～8周后可进行负重训练\n\n陪诊记录\n陪诊人：秋栗、萤石、卡契尔、安塔尔","CN_06","档案资料·四",1500,"profileVoice",[4126,4134,4138,4142,4146,4150,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4434,4439,4444,4449,4454,4459,4464,4469,4474,4479,4484,4489,4494,4499,4504,4509,4514,4519],{"_4053":16,"_15":4087,"_4095":37,"_4096":37,"_4127":4128,"_4129":4130,"_4131":39,"_4132":4133},"voId","chr_0021_whiten_chrbark_squad_01","voiceDesc","休息时间……要结束了吗？","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4098,"_4095":37,"_4096":37,"_4127":4135,"_4129":4136,"_4131":55,"_4132":4137},"chr_0021_whiten_chrbark_squad_02","再给我两分钟就出发……","行动准备2",{"_4053":16,"_15":4103,"_4095":37,"_4096":37,"_4127":4139,"_4129":4140,"_4131":58,"_4132":4141},"chr_0021_whiten_chrbark_join_01","又要出任务了吗？呼……趁我的体能还没耗尽……","编入队伍1",{"_4053":16,"_15":4108,"_4095":37,"_4096":37,"_4127":4143,"_4129":4144,"_4131":64,"_4132":4145},"chr_0021_whiten_chrbark_join_02","该去探索哪些……不为人知的秘辛呢？哼哼……","编入队伍2",{"_4053":16,"_15":4114,"_4095":37,"_4096":37,"_4127":4147,"_4129":4148,"_4131":66,"_4132":4149},"chr_0021_whiten_chrbark_weap_01","啊啊……无法匹敌的力量……呼呃……好沉……","更换武器",{"_4053":16,"_15":4119,"_4095":37,"_4096":37,"_4127":4151,"_4129":4152,"_4131":68,"_4132":4153},"chr_0021_whiten_chrbark_gear_01","武库的工程师们显然高估了我的持续作战能力……不过……就这样吧。","更换装备",{"_4053":16,"_15":4155,"_4095":37,"_4096":37,"_4127":4156,"_4129":4157,"_4131":70,"_4132":4158},"chr_0021_whiten_7","chr_0021_whiten_chrup_skill_01","提升能力就能减少工作了吗？好耶……","激活天赋阵列",{"_4053":16,"_15":4160,"_4095":37,"_4096":37,"_4127":4161,"_4129":4162,"_4131":88,"_4132":4163},"chr_0021_whiten_8","chr_0021_whiten_chrup_level_01","除了身体机能以外的部分都成长了……嗯，看来我已经没救了。","观看作战记录",{"_4053":16,"_15":4165,"_4095":55,"_4096":39,"_4127":4166,"_4129":4167,"_4131":90,"_4132":4168},"chr_0021_whiten_9","chr_0021_whiten_chrup_promt01_01","真是突如其来的晋升机会……本以为还需要花更多时间的……","精英化晋升1",{"_4053":16,"_15":4170,"_4095":55,"_4096":55,"_4127":4171,"_4129":4172,"_4131":410,"_4132":4173},"chr_0021_whiten_10","chr_0021_whiten_chrup_promt02_01","看来我的工作比我预想中完成得还要出色……管理员……我需要请两天假犒劳一下自己……","精英化晋升2",{"_4053":16,"_15":4175,"_4095":55,"_4096":58,"_4127":4176,"_4129":4177,"_4131":100,"_4132":4178},"chr_0021_whiten_11","chr_0021_whiten_chrup_promt03_01","让我晋升这么快真的好吗……还是说这是什么试探下属的管理方式吗？我得好好琢磨一下……","精英化晋升3",{"_4053":16,"_15":4180,"_4095":55,"_4096":64,"_4127":4181,"_4129":4182,"_4131":95,"_4132":4183},"chr_0021_whiten_12","chr_0021_whiten_chrup_promt04_01","喔喔！这是不是意味着我可以去指挥秋栗做事了？哼哼……等下就去试试。","精英化晋升4",{"_4053":16,"_15":4185,"_4095":37,"_4096":37,"_4127":4186,"_4129":4187,"_4131":527,"_4132":4188},"chr_0021_whiten_13","chr_0021_whiten_introduce_01","又是这个环节吗？你好……管理员，我的名字是埃特拉，还请不要分配太多重体力工作给我。","干员报到",{"_4053":16,"_15":4190,"_4095":37,"_4096":37,"_4127":4191,"_4129":4192,"_4131":566,"_4132":4193},"chr_0021_whiten_14","chr_0021_whiten_mono_switch_01","哈……活过来了。我暂时不想再去做任何事了……","待命1",{"_4053":16,"_15":4195,"_4095":37,"_4096":37,"_4127":4196,"_4129":4197,"_4131":97,"_4132":4198},"chr_0021_whiten_15","chr_0021_whiten_mono_switch_02","又过度劳动了……嗯……忙里偷闲的时光可要好好珍惜。","待命2",{"_4053":16,"_15":4200,"_4095":37,"_4096":37,"_4127":4201,"_4129":4202,"_4131":644,"_4132":4203},"chr_0021_whiten_16","chr_0021_whiten_sim_assign_work_01","又是什么新的工作吗？我还是蛮期待的……真的哦。","进驻设施",{"_4053":16,"_15":4205,"_4095":37,"_4096":37,"_4127":4206,"_4129":4207,"_4131":684,"_4132":4208},"chr_0021_whiten_17","chr_0021_whiten_sim_hello_lower_01","管理员……休息得怎么样？","打招呼1",{"_4053":16,"_15":4210,"_4095":64,"_4096":4112,"_4127":4211,"_4129":4212,"_4131":723,"_4132":4213},"chr_0021_whiten_18","chr_0021_whiten_sim_hello_max_01","难得看到管理员这么有空。","打招呼2",{"_4053":16,"_15":4215,"_4095":37,"_4096":37,"_4127":4216,"_4129":4217,"_4131":763,"_4132":4218},"chr_0021_whiten_19","chr_0021_whiten_sim_talk_lv01_01","自从我告诉安塔尔我不喜欢他的那些数字游戏后……他就再也不向我推荐了。嗯……其他人也应该这么做的。","帝江号闲聊1",{"_4053":16,"_15":4220,"_4095":64,"_4096":4112,"_4127":4221,"_4129":4222,"_4131":802,"_4132":4223},"chr_0021_whiten_20","chr_0021_whiten_sim_talk_lv02_01","武库的工程师总是向我抱怨我的枪破损率太高……那也没办法……我能挥舞起这么重的家伙已经是不小的奇迹了。","帝江号闲聊2",{"_4053":16,"_15":4225,"_4095":64,"_4096":4112,"_4127":4226,"_4129":4227,"_4131":872,"_4132":4228},"chr_0021_whiten_21","chr_0021_whiten_sim_talk_lv02_02","安德烈先生……他的脑袋能做到一百八十度旋转吗？嗯……下次我会去问问他的。","帝江号闲聊3",{"_4053":16,"_15":4230,"_4095":64,"_4096":4123,"_4127":4231,"_4129":4232,"_4131":911,"_4132":4233},"chr_0021_whiten_22","chr_0021_whiten_sim_talk_max_01","秋栗很喜欢长耳兽，所以我专门收集了许多长耳兽的料理食谱送给她……不知为何在那之后她整整一个星期没和我说话……真奇怪……","帝江号闲聊4",{"_4053":16,"_15":4235,"_4095":64,"_4096":4123,"_4127":4236,"_4129":4237,"_4131":951,"_4132":4238},"chr_0021_whiten_23","chr_0021_whiten_sim_talk_max_02","我已经习惯孤军深入的战术行动了……虽然很麻烦，但总得有人去做这些事。毕竟……我比其他人更耐得住寂寞。","帝江号闲聊5",{"_4053":16,"_15":4240,"_4095":64,"_4096":4123,"_4127":4241,"_4129":4242,"_4131":989,"_4132":4243},"chr_0021_whiten_24","chr_0021_whiten_sim_talk_max_03","噪音和金属乐更能让我变得平静……停住那些声音很容易，但我喜欢嘈杂声中的些许迷失感，会有些……忘我？","帝江号闲聊6",{"_4053":16,"_15":4245,"_4095":37,"_4096":37,"_4127":4246,"_4129":4247,"_4131":62,"_4132":4248},"chr_0021_whiten_25","chr_0021_whiten_sim_gift_give_01","管理员，你愿意收下这个吗？放心……不是什么奇怪的东西。","赠送礼物",{"_4053":16,"_15":4250,"_4095":37,"_4096":37,"_4127":4251,"_4129":4252,"_4131":1067,"_4132":4253},"chr_0021_whiten_26","chr_0021_whiten_sim_gift_recv_01","送给我的……？嗯……很感谢……很少有小队以外的人送给我礼物。","接收礼物",{"_4053":16,"_15":4255,"_4095":37,"_4096":37,"_4127":4256,"_4129":4257,"_4131":1107,"_4132":4258},"chr_0021_whiten_27","chr_0021_whiten_mono_self_line01","为什么不加入攻坚小组？不了不了，我对自己体能的不足可是很有自信的……不能给他人增加负担。","信赖对话1",{"_4053":16,"_15":4260,"_4095":64,"_4096":4112,"_4127":4261,"_4129":4262,"_4131":1146,"_4132":4263},"chr_0021_whiten_28","chr_0021_whiten_mono_self_line02","有位同行曾说过我对信息的利用率太低……嗯……不过我根本没考虑过怎么去利用那些秘密，太麻烦了……收集它们只是我的爱好……","信赖对话2",{"_4053":16,"_15":4265,"_4095":64,"_4096":4112,"_4127":4266,"_4129":4267,"_4131":1186,"_4132":4268},"chr_0021_whiten_29","chr_0021_whiten_mono_self_line03","运气差？我的父母倒是时不时会怀念过去的生活，认为生活的落差是运气差所致……但是，嗯……我觉得无论什么样的经历都有它存在的意义，正如我由此认识了Z7小队的伙伴……","信赖对话3",{"_4053":16,"_15":4270,"_4095":64,"_4096":4123,"_4127":4271,"_4129":4272,"_4131":56,"_4132":4273},"chr_0021_whiten_30","chr_0021_whiten_mono_self_line04","遇到Z7小队前我正处于人生的最低谷……啊……真是灾难。钱被骗光，饥肠辘辘……秋栗和萤石起初把我和被救出的难民们安置在一起，直到我告诉她们裂地者换班的细节和组织情报……萤石一脸惊异地问我怎么做到的……嗯，那时她的表情我依然还记得。","信赖对话4",{"_4053":16,"_15":4275,"_4095":64,"_4096":4123,"_4127":4276,"_4129":4277,"_4131":1264,"_4132":4278},"chr_0021_whiten_31","chr_0021_whiten_mono_self_line05","我想过随遇而安的生活……我曾以为霉运缠身的我有这样的想法很奢侈。直到我来到了终末地……加入了Z7小队，遇见了管理员……谢谢你们一直在包容我……","信赖对话5",{"_4053":16,"_15":4280,"_4095":37,"_4096":37,"_4127":4281,"_4129":4282,"_4131":1303,"_4132":4283},"chr_0021_whiten_32","chr_0021_whiten_mono_chat_line01","我的过去没有那么跌宕起伏，我只记得自己跟着家人辗转各地……嗯，很累、很辛苦，和塔卫二上的大多数人一样。所以我想生活得更轻松一些……","交谈1",{"_4053":16,"_15":4285,"_4095":37,"_4096":37,"_4127":4286,"_4129":4287,"_4131":117,"_4132":4288},"chr_0021_whiten_33","chr_0021_whiten_mono_chat_line02","在空旷的环境……去感受失真的吉他声给耳朵带来的轻微刺痛感……嗯……我很喜欢……","交谈2",{"_4053":16,"_15":4290,"_4095":37,"_4096":37,"_4127":4291,"_4129":4292,"_4131":1381,"_4132":4293},"chr_0021_whiten_34","chr_0021_whiten_mono_chat_line03","我并不觉得敌后的工作艰苦，相反……不知何时将至的威胁有些微妙的刺激感……嗯，只要准备足够充分，没什么应付不了的。","交谈3",{"_4053":16,"_15":4295,"_4095":37,"_4096":37,"_4127":4296,"_4129":4297,"_4131":1421,"_4132":4298},"chr_0021_whiten_35","chr_0021_whiten_mono_chat_line04","管理员会有觉得被我冒犯到的时候吗？抱歉……人事部门提醒过我这一点……Z7小队的大家让我不用太介意，理由是他们已经习惯了……","交谈4",{"_4053":16,"_15":4300,"_4095":37,"_4096":37,"_4127":4301,"_4129":4302,"_4131":156,"_4132":4303},"chr_0021_whiten_36","chr_0021_whiten_mono_chat_line05","该怎么利用情报去猜测人的内心？我只负责收集，萤石负责剖析……嗯，我也很想知道她是怎么做到的。不过……她只是告诉我说“经验之谈”。","交谈5",{"_4053":16,"_15":4305,"_4095":37,"_4096":37,"_4127":4306,"_4129":4307,"_4131":1499,"_4132":4308},"chr_0021_whiten_37","chr_0021_whiten_mono_about_line01","嗯……作为超额劳动的报复，我要把秋栗与纸杯蛋糕的秘密公之于众……呵呵，我真是太恶毒了。","话题：秋栗",{"_4053":16,"_15":4310,"_4095":37,"_4096":37,"_4127":4311,"_4129":4312,"_4131":1538,"_4132":4313},"chr_0021_whiten_38","chr_0021_whiten_mono_about_line02","卡契尔是个毫无秘密的人……嗯，他的一切似乎都已经写在述职报告里了……世界上居然还存在这样的人？","话题：卡契尔",{"_4053":16,"_15":4315,"_4095":37,"_4096":37,"_4127":4316,"_4129":4317,"_4131":41,"_4132":4318},"chr_0021_whiten_39","chr_0021_whiten_mono_about_line03","萤石和我搭档的次数最多，她总是因为我说了什么而笑个不停，还会让我多说点话……嗯……人内心的想法真是难以捉摸。","话题：萤石",{"_4053":16,"_15":4320,"_4095":37,"_4096":37,"_4127":4321,"_4129":4322,"_4131":44,"_4132":4323},"chr_0021_whiten_40","chr_0021_whiten_mono_about_line04","那位萨弗拉是个很认真的人……有时候是不是有点认真过头了？工作本就如此辛苦……不过他讲的笑话非常有意思，总能把我和萤石逗笑。","话题：安塔尔",{"_4053":16,"_15":4325,"_4095":37,"_4096":37,"_4127":4326,"_4129":4327,"_4131":47,"_4132":4328},"chr_0021_whiten_41","chr_0021_whiten_explore_point_common_01","那个看起来还不错……嗯，找个机会带回去吧。","发现资源1",{"_4053":16,"_15":4330,"_4095":37,"_4096":37,"_4127":4331,"_4129":4332,"_4131":50,"_4132":4333},"chr_0021_whiten_42","chr_0021_whiten_explore_point_valub_01","那边那个……就算再累也有跑一趟的价值。","发现资源2",{"_4053":16,"_15":4335,"_4095":37,"_4096":37,"_4127":4336,"_4129":4337,"_4131":232,"_4132":4338},"chr_0021_whiten_43","chr_0021_whiten_explore_find_locked_01","呼……得去那边探索一番了。","发现未探索区域",{"_40