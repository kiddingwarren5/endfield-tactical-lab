4534,{"_36":44,"_38":3904},186.95434462444823,{"_36":47,"_38":3906},105.99999999999997,{"_36":50,"_38":3908},127.47872922364854,{"_36":39,"_38":3910},5888,{"_36":55,"_38":3912},334,{"_36":58,"_38":37},{"_36":60,"_38":3915},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":96},{"_36":98,"_38":99},{"_36":94,"_38":39},{"_31":3936,"_101":64},{"_33":3937},[3938,3939,3941,3943,3945,3947,3949,3951,3952,3954,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970,3971,3972,3973],{"_36":37,"_38":3598},{"_36":41,"_38":3940},105.89690721649482,{"_36":44,"_38":3942},188.6730486008842,{"_36":47,"_38":3944},106.99999999999997,{"_36":50,"_38":3946},128.65070481800998,{"_36":39,"_38":3948},5944,{"_36":55,"_38":3950},337,{"_36":58,"_38":37},{"_36":60,"_38":3953},1.49489795918367,{"_36":62,"_38":3955},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":96},{"_36":98,"_38":99},{"_36":94,"_38":39},{"_31":3975,"_101":64},{"_33":3976},[3977,3978,3980,3982,3984,3986,3988,3990,3991,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011],{"_36":37,"_38":3636},{"_36":41,"_38":3979},106.88659793814432,{"_36":44,"_38":3981},190.39175257732012,{"_36":47,"_38":3983},107.99999999999997,{"_36":50,"_38":3985},129.82268041237145,{"_36":39,"_38":3987},6000,{"_36":55,"_38":3989},340,{"_36":58,"_38":37},{"_36":60,"_38":3992},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":94},{"_36":96,"_38":96},{"_36":98,"_38":99},{"_36":94,"_38":39},"charBattleTagIds",[4014,4015],"tag_07","tag_28","charId","charIllustInitPos",{"_4019":422,"_4020":4021},"x","y",-120,"charPassiveUIPrefabName","OverlayInfoNodeTyphoea","charTypeId","Natural","cvName",{"_4028":4029,"_4030":4031,"_4032":4033,"_4034":4035,"_4016":16},"ChiCVName","皛四白","EngCVName","Hanna Johansson","JapCVName","大空直美","KorCVName","彩琳","defaultWeaponId","wpn_funnel_0002","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Typhoeus","mainAttrType","phoneticName","","profession","profileRecord",[4050,4061,4066,4071,4077,4082],{"_4016":16,"_15":4051,"_4052":4053,"_4054":4055,"_4056":39,"_4057":4058,"_4059":37,"_4060":37},"chr_0034_typhoea_1","recordDesc","【代号】提弗洛斯\n【性别】女\n【身份认证】罗德岛\n【生日】1月13日\n【种族】萨卡兹\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：优良\n战术规划：普通\n源石技艺适应性：标准","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4016":16,"_15":4062,"_4052":4063,"_4054":4064,"_4056":55,"_4057":4065,"_4059":37,"_4060":37},"chr_0034_typhoea_2","干员提弗洛斯，来自罗德岛的再旅者干员，在追寻萨米失落传说的旅途中与管理员偶遇，后经管理员本人邀请，加入终末地工业。\n\n与提弗洛斯小姐交谈时，她表现出的冷静与沉稳远超成年人，但旺盛的好奇心与不合时宜的探究眼神还是暴露出了她的孩子心性。按流程，我该询问她很多，但当她将自己的笔记本拿出后，我就找不到合适的时机向她提问了。\n很难想象，一个人的问题可以多到让我都疲于应付。我曾提醒她，许多问题都可以在那本《新进干员手册》中得到答案，她却转了圈笔，平静地说，她对我讲述事情的方式很着迷。\n长达三个小时的盘问结束后，她满意离开，在她合上那本笔记前，我扫描到了她对我的评价：\n“三个脑袋，无所不知，有问必答，传说故事里总需要这样的角色。”\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4016":16,"_15":4067,"_4052":4068,"_4054":4069,"_4056":58,"_4057":4070,"_4059":37,"_4060":37},"chr_0034_typhoea_3","有提弗洛斯这样擅长野外生存的干员加入，让我们在北方的工作顺利不少。\n终末地虽与铁誓军合作密切，但对方战事繁忙，难以抽身，往往将我们带至裂隙发生地，就得继续返回战场，剩下的工作，只能靠我们自己。\n极地环境复杂，常年积雪覆盖，气温很低，给我们的监测工作造成许多困难。一次突发的暴风雪将我们的营地摧毁，仪器设备全面瘫痪。绝望中，我们将所有毛毯裹在身上，等待被这冰天雪地吞噬，但好在，提弗洛斯干员及时赶到了。\n与她一同出现的，还有一整只兽腿。\n废墟中，提弗洛斯升起篝火，用一顿萨米风味烧烤带来温暖。随后又孤身深入风雪中，带回木头和树皮，仅仅花了一个下午，就在完全原始的环境中搭建出了可供四人容身的木屋。\n虽然她对我们带来的设备一窍不通，但依然能按我们的需求，搭建可供其良好运行的稳定环境。当我们直面裂隙时，她能借助狩猎经验高效清理来袭的天使群，协助我们放置设备，获取关键数据。\n除却野外生存经验不谈，最令大家信赖的，是她极为准确的预感。\n是的，靠同事的预感进行工作，不像是专业的人会说的话，但在导航设备全部瘫痪的时候，我们却能够凭借她的预感，侥幸与危险擦肩而过，平安撤离。行进路上，我们一直提心吊胆，她却不曾面露惧色，总是平静地为大家在雪暴中指出道路。\n有人猜测，是生活在群山中的独眼巨人教会提弗洛斯该如何洞见未来。但我认为，或许这便是萨米人与自然的相处之道——置身其中，融入其中，才能敏锐感知自然的呼吸、脉搏与心跳，从而获得自然赐予的“启示”。","CN_03","档案资料·一",{"_4016":16,"_15":4072,"_4052":4073,"_4054":4074,"_4056":64,"_4057":4075,"_4059":64,"_4060":4076},"chr_0034_typhoea_4","“终末地是一家正经企业，要学会分辨事实和谣言，那些传说不都是真的。”\n每当有新员工加入终末地时，老员工会刻意提醒他们。\n直到干员提弗洛斯加入终末地，一切努力付诸流水。这个女孩用她神神叨叨的故事模糊了谣言与现实，让我们从一家有传奇色彩的企业彻底变成了……传奇。\n在屏幕上闪过的神秘字符，深夜在舰桥响起的哭泣声，工程中心永远修不好的照明设施，总在人落单的时候一闪一灭……这些本可以一笑了之的“小巧合”，在提弗洛斯的收集整合下，变成了一个令人毛骨悚然的传说故事。\n\n很久以前，天空之舟帝江号上的器械经常损坏，可怜的工匠只能栖身工坊，日夜不断进行着锻造、修复。可一年的辛劳后，待修复的器械却越来越多，堆在身边如同群山般连绵起伏。\n激愤消耗了他最后的善意，他化身怨灵进入仪器内部，誓要报复每个为图省事而不当操作的家伙。\n夜里闪烁的灯火，便是他巡行的预兆……\n——提弗洛斯笔记本中的一段记录\n\n当这篇故事在帝江号流传开来后，工程中心当月收到的修复清单上，损坏数量大幅减少。\n震撼的安德烈先生查明原委后，对故事做出了中肯的评价：这不是故事，这是不可辩驳的事实。\n而这只是提弗洛斯为终末地撰写的诸多传说中的一章。在她的笔记本里，管理员是手握初始之石的大贤者，佩丽卡监督是身负闪电之力的雷电法师，陈小姐是背着长剑的游侠……而终末地在塔卫二所做的一切，则是在这片大地上插满石之巨剑，维护世间安定，庇佑万物。\n十二岁的孩子听到这些传说会觉得幼稚，但对于脑袋里充满奇思妙想的终末地干员则刚刚好。\n“我现在工作时，会想象自己是来自萨米的神秘雪祀，当仪器过热时，就大声呼喊古老的祷词……”随后，安德烈从墙角拎起降温枪，对准机器大喊道，“风雪啊，请降至人间吧！”","CN_04","档案资料·二",300,{"_4016":16,"_15":4078,"_4052":4079,"_4054":4080,"_4056":66,"_4057":4081,"_4059":64,"_4060":4076},"chr_0034_typhoea_5","《萨米战歌》\n阳光融化积雪，\n冻土之下，阴影四散。\n但我们的迁徙不会结束。\n阳光破开云层，\n森林之中，阴雨不再，\n但我们的战斗不会停止。\n拾起盾牌，披上重甲，\n命运令我们停留在此，\n在阳光下，\n浴血奋战。\n\n从泰拉来到塔卫二后，巨兽萨米结束长达数年的“漂流”，选择了位于北极圈内的一块土地，连同背负的黑森林一同落脚于此。在巨兽的庇佑下，萨米人度过了短暂的安宁岁月。但很快，随着星门被毁，第一次天使战争爆发，巨兽萨米为保护萨米人而牺牲，陨落在北极，萨米人甚至来不及哀悼，便要参与到铁誓军要塞的建设中。其后，更是一段可谓持续到今日的漫长战役。\n当提弗洛斯从罗德岛苏醒，得知族人当前的使命时，她便立刻收拾行囊赶赴北方。但她千里迢迢来到铁誓军要塞后，一位才从战场退下的萨米雪祀拍了拍她的后脑勺，落下一个带有泥土腥气的巴掌，将她拒之门外。\n“等你长得比你的弓更高，再上战场吧。”\n虽然提弗洛斯坚称自己只是长得小，但谁都不信，毕竟在她的手上，尚未来得及留下因长期射箭而形成的厚茧。\n失落的她只能乘上前往黑森林的大篷车，去见自己未曾谋面的族人。这是她所熟悉的萨米，环境、习俗、语言、口音，一切都被保留下来。但同时，这里也让她觉得陌生，聚落中，只有老者、伤患和孩子，仍能拿起武器的人，都选择走向战场，守护那道血肉铸就的阵线，阻止天使南下的步伐。\n失落的提弗洛斯留在了黑森林中。很快，她便得知萨米沉寂后，祂的传说也随之支离破碎，那些知晓往事的老者还未来得及将故事传诵，便已随萨米一同在战场化为骸骨。于是，无法参与前线战斗的提弗洛斯决定收集那些传说并将其保存。\n\n管理员，你知道吗？萨米的陨落，是萨米的选择，族人认同，并且义无反顾追随。\n我在黑森林中找到了一块用来占卜的密文板，上面记载了雪祀与萨米的“沟通”。\n在祂落至北方前，曾提醒黑森林的族人，自己早已洞见一场残酷漫长的战争，祂必须前往北方，在未来某一刻，牺牲自己，守护所有生灵。\n祂给了族人离开的机会……\n但密文板上，是族人的回答——\n萨米的意志便是萨米人的意志，萨米的使命便是萨米人的使命，我们会同您前往北方。\n狩猎永不结束。","CN_05","档案资料·三",{"_4016":16,"_15":4083,"_4052":4084,"_4054":4085,"_4056":68,"_4057":4086,"_4059":64,"_4060":4087},"chr_0034_typhoea_6","自萨米陨落后，大多数萨米人接受了结局，他们生活在巨兽的尸骸之上，继承萨米遗志，为守护塔卫二而与天使作战。\n但仍有雪祀坚信，萨米并未死去，只是灵魂迷失在裂隙中，陷入沉睡。终有一日，萨米会从梦中苏醒，重新回到族人身边。他们前往塔卫二各地的裂隙处，搭建祭坛，举行仪式，试图从裂隙中唤回萨米的灵魂。但前去之人无一复还，后来北方战事吃紧，更是无人愿意继续尝试。\n在武陵甚大裂隙附近的一片雪松林中，提弗洛斯找到其中一位萨米雪祀留下的手稿，手稿上详细记载了她为唤醒萨米做的种种尝试。虽经过探索，提弗洛斯能够确定，唤醒仪式并未成功，雪祀本人也不知所终，但女孩还是从剩下的资料中，敏锐地嗅到了一丝唤醒萨米的可能。\n但很可惜，几个月的钻研后，提弗洛斯并未收获成果。\n尽管她问遍了铁誓军要塞与黑森林中的所有雪祀与萨满，大家也只是摇摇头，认为这是注定会失败的尝试。\n好在即便多次碰壁，提弗洛斯也并不丧气。手稿中，雪祀对梦的独到见解，让女孩学会洞见他人梦境中的特殊启示。\n\n“不知道为什么，我最近总梦到被巨大的怪物追赶，脚下的路也摇摇晃晃的，像是在吊桥上似的，天天辗转反侧……”\n“很简单，那个怪物在狩猎你，你被追到绝路了。”\n“我该怎么办？”\n“让自己变得强壮，不要做猎物，要做猎手。”\n“……我有点明白了。”\n\n在与提弗洛斯谈过后，这位干员为自己计划了一整月的强化训练，运动带来的满足与疲惫让他能够安睡一整夜。久而久之，终末地同僚们开始带着自己五花八门的梦，来找提弗洛斯卜梦、解梦。\n而提弗洛斯也在倾听大家的梦境后，以此为灵感，创作了一篇有着巨兽萨米、梦境和雪祀的传说故事。\n很快，提弗洛斯写完了结局，她本以为这件事会同故事一般尘埃落定。于是她抱起笔记，准备将结局分享给苦苦等待的众人。但行至半路，她与一个女孩在走廊擦身而过。\n提弗洛斯不认识她，却从她身上感受到了莫名熟悉的气息。\n那气息曾陪伴族人穿梭在沼泽和树林，陪伴族人度过冬天，迎接春天，陪伴族人从出生行至死亡……\n等提弗洛斯回过神，那女孩早已走远。\n后来，她从旁人处听说了那女孩的代号——别礼。\n出于一种神秘的预感，她将原本写好的结局撕去，并在新的一页，写上了那个代号。","CN_06","档案资料·四",1500,"profileVoice",[4090,4098,4102,4106,4110,4114,4118,4123,4128,4133,4138,4143,4148,4153,4158,4163,4168,4173,4178,4183,4188,4193,4198,4203,4208,4213,4218,4223,4228,4233,4238,4243,4248,4253,4258,4263,4268,4273,4278,4283,4288,4293,4298,4303,4308,4313,4318,4323,4328,4333,4338,4343,4348,4353,4358,4363,4368,4373,4378,4383,4388,4394,4399,4405,4411,4416,4422,4428,4434,4439,4445,4450,4456,4461,4467,4473,4479,4485,4491,4497,4502],{"_4016":16,"_15":4051,"_4059":37,"_4060":37,"_4091":4092,"_4093":4094,"_4095":39,"_4096":4097},"voId","chr_0034_typhoea_chrbark_squad_01","voiceDesc","带好自己的武器和工具，半途跑回来取就太丢人了。","voiceIndex","voiceTitle","行动准备1",{"_4016":16,"_15":4062,"_4059":37,"_4060":37,"_4091":4099,"_4093":4100,"_4095":55,"_4096":4101},"chr_0034_typhoea_chrbark_squad_02","出门在外要有计划的，别乱跑，别乱吃，也别乱说话。","行动准备2",{"_4016":16,"_15":4067,"_4059":37,"_4060":37,"_4091":4103,"_4093":4104,"_4095":58,"_4096":4105},"chr_0034_typhoea_chrbark_join_01","说吧，你要委托我做什么？","编入队伍1",{"_4016":16,"_15":4072,"_4059":37,"_4060":37,"_4091":4107,"_4093":4108,"_4095":64,"_4096":4109},"chr_0034_typhoea_chrbark_join_02","突击测试，野外哪些食物可以生吃？最好别生吃。很好，你过关了。","编入队伍2",{"_4016":16,"_15":4078,"_4059":37,"_4060":37,"_4091":4111,"_4093":4112,"_4095":66,"_4096":4113},"chr_0034_typhoea_chrbark_weap_01","谢谢你，但野外也能获取武器，我会用树枝削箭头，你想看吗？","更换武器",{"_4016":16,"_15":4083,"_4059":37,"_4060":37,"_4091":4115,"_4093":4116,"_4095":68,"_4096":4117},"chr_0034_typhoea_chrbark_gear_01","我不冷，也不怕危险，不需要穿这么多装备。唔，你会担心？那……给我吧。","更换装备",{"_4016":16,"_15":4119,"_4059":37,"_4060":37,"_4091":4120,"_4093":4121,"_4095":70,"_4096":4122},"chr_0034_typhoea_7","chr_0034_typhoea_chrup_skill_01","拨开一层迷雾后，许多事情变得更清晰了。","激活天赋阵列",{"_4016":16,"_15":4124,"_4059":37,"_4060":37,"_4091":4125,"_4093":4126,"_4095":88,"_4096":4127},"chr_0034_typhoea_8","chr_0034_typhoea_chrup_level_01","我还是更喜欢亲身经历战斗的感觉。","观看作战记录",{"_4016":16,"_15":4129,"_4059":55,"_4060":39,"_4091":4130,"_4093":4131,"_4095":90,"_4096":4132},"chr_0034_typhoea_9","chr_0034_typhoea_chrup_promt01_01","好吧，很高兴你能把我当作合格的伙伴。","精英化晋升1",{"_4016":16,"_15":4134,"_4059":55,"_4060":55,"_4091":4135,"_4093":4136,"_4095":410,"_4096":4137},"chr_0034_typhoea_10","chr_0034_typhoea_chrup_promt02_01","他们都说获得你的认可是很好的事情，但我觉得没什么特殊的，不管你怎么想我，该为你做的事，我都会为你做。","精英化晋升2",{"_4016":16,"_15":4139,"_4059":55,"_4060":58,"_4091":4140,"_4093":4141,"_4095":94,"_4096":4142},"chr_0034_typhoea_11","chr_0034_typhoea_chrup_promt03_01","认同？这和你之前说的认可有区别吗？更信任我了……那你信任的是我的能力，还是我本人？","精英化晋升3",{"_4016":16,"_15":4144,"_4059":55,"_4060":64,"_4091":4145,"_4093":4146,"_4095":96,"_4096":4147},"chr_0034_typhoea_12","chr_0034_typhoea_chrup_promt04_01","夸奖？你对我还需要说这种话吗？同伴间一个眼神就足够了。","精英化晋升4",{"_4016":16,"_15":4149,"_4059":37,"_4060":37,"_4091":4150,"_4093":4151,"_4095":527,"_4096":4152},"chr_0034_typhoea_13","chr_0034_typhoea_introduce_01","管理员，我按当时约定的来找你。那你呢？有没有想好我来到这里后，要给我讲个什么样的故事？","干员报到",{"_4016":16,"_15":4154,"_4059":37,"_4060":37,"_4091":4155,"_4093":4156,"_4095":566,"_4096":4157},"chr_0034_typhoea_14","chr_0034_typhoea_mono_switch_01","预言并非注定，结局该是我们自己书写。","待命1",{"_4016":16,"_15":4159,"_4059":37,"_4060":37,"_4091":4160,"_4093":4161,"_4095":98,"_4096":4162},"chr_0034_typhoea_15","chr_0034_typhoea_mono_switch_02","传说不总是久远的……也可以发生在你我身边。","待命2",{"_4016":16,"_15":4164,"_4059":37,"_4060":37,"_4091":4165,"_4093":4166,"_4095":872,"_4096":4167},"chr_0034_typhoea_21","chr_0034_typhoea_sim_assign_work_01","我是学过如何操作机器，但记忆……已经像融雪一样化开了。","进驻设施",{"_4016":16,"_15":4169,"_4059":37,"_4060":37,"_4091":4170,"_4093":4171,"_4095":911,"_4096":4172},"chr_0034_typhoea_22","chr_0034_typhoea_sim_hello_lower_01","今天黑森林会下雨，如果要去，记得带伞。","打招呼1",{"_4016":16,"_15":4174,"_4059":64,"_4060":4076,"_4091":4175,"_4093":4176,"_4095":951,"_4096":4177},"chr_0034_typhoea_23","chr_0034_typhoea_sim_hello_max_01","愿你今夜好梦。","打招呼2",{"_4016":16,"_15":4179,"_4059":37,"_4060":37,"_4091":4180,"_4093":4181,"_4095":989,"_4096":4182},"chr_0034_typhoea_24","chr_0034_typhoea_sim_talk_lv01_01","我刚刚在舰桥上兜了一圈，很多人都问我能不能摸摸这把弓……奇怪，他们难道不怕我吗？","帝江号闲聊1",{"_4016":16,"_15":4184,"_4059":64,"_4060":4076,"_4091":4185,"_4093":4186,"_4095":62,"_4096":4187},"chr_0034_typhoea_25","chr_0034_typhoea_sim_talk_lv02_01","找你什么事？我觉得就算没事，我也可以来看看你。好了，看到了，我要离开了。","帝江号闲聊2",{"_4016":16,"_15":4189,"_4059":64,"_4060":4076,"_4091":4190,"_4093":4191,"_4095":1067,"_4096":4192},"chr_0034_typhoea_26","chr_0034_typhoea_sim_talk_lv02_02","来这里我认识了很多人，他们都给我讲了有趣的故事。嗯，我都记在笔记本上。不过我留了一页给你，最后一页，整整一页，你得给我讲一个很长很长的故事。","帝江号闲聊3",{"_4016":16,"_15":4194,"_4059":64,"_4060":4087,"_4091":4195,"_4093":4196,"_4095":1107,"_4096":4197},"chr_0034_typhoea_27","chr_0034_typhoea_sim_talk_max_01","武库的哥哥姐姐帮我升级了箭头，其中一支信号箭射向天空会爆开，随后出现终末地的标志，要是遇到危险可以用来联系帝江号。我不怕危险，也不怕一个人……这是属于我的考验，不该求助。","帝江号闲聊4",{"_4016":16,"_15":4199,"_4059":64,"_4060":4087,"_4091":4200,"_4093":4201,"_4095":1146,"_4096":4202},"chr_0034_typhoea_28","chr_0034_typhoea_sim_talk_max_02","这里和我在其他地方的营地不一样，没有篝火，也没有雪和树林，但我睡着时挨着地板，依然听到了一个很有力的心跳，咚咚、咚咚。不，当然不是大地，是帝江号自己的心跳。","帝江号闲聊5",{"_4016":16,"_15":4204,"_4059":64,"_4060":4087,"_4091":4205,"_4093":4206,"_4095":1186,"_4096":4207},"chr_0034_typhoea_29","chr_0034_typhoea_sim_talk_max_03","我刚做了梦，醒来就再也睡不着了。看窗外，星星也醒着……它们在说悄悄话，说沉没在水下的，会再度浮出，沉睡在梦中的，会再度苏醒，萨米维格的命运因此而改变……可星星什么时候会说话的？好怪，我还在梦中吗？","帝江号闲聊6",{"_4016":16,"_15":4209,"_4059":37,"_4060":37,"_4091":4210,"_4093":4211,"_4095":56,"_4096":4212},"chr_0034_typhoea_30","chr_0034_typhoea_sim_gift_give_01","对了，从北方给你带了些东西，不用担心放坏，我用源石技艺将它最美的一刻冻起来了。咦，会冻手吗？抱歉，是我没考虑到，呼呼……这下呢，有没有温暖些？","赠送礼物",{"_4016":16,"_15":4214,"_4059":37,"_4060":37,"_4091":4215,"_4093":4216,"_4095":1264,"_4096":4217},"chr_0034_typhoea_31","chr_0034_typhoea_sim_gift_recv_01","我会一直带在身边，或许未来，会有个不错的故事等着我们。","接收礼物",{"_4016":16,"_15":4219,"_4059":37,"_4060":37,"_4091":4220,"_4093":4221,"_4095":47,"_4096":4222},"chr_0034_typhoea_41","chr_0034_typhoea_mono_self_line01","冷静，管理员，别着急，我会保护你的。现在和我说，是什么让你慌成这样？被五花大绑的巨大野兽，挂在门口……那是我带给你的猎物。我一个人，在林子里守了好多好多天才抓到的。你要是不喜欢，我带走好了，那皮毛可是上好的。","信赖对话1",{"_4016":16,"_15":4224,"_4059":64,"_4060":4076,"_4091":4225,"_4093":4226,"_4095":50,"_4096":4227},"chr_0034_typhoea_42","chr_0034_typhoea_mono_self_line02","别动，再忍下，马上就画完了。这次要带你去的，是一处封存多年的萨米遗迹。你需要一些伪装，才能避开当时留下的禁制与恶咒。别皱鼻子，只是泥土和苔藓的味道，你会习惯的。好了，你现在闻起来……像个萨米人了。","信赖对话2",{"_4016":16,"_15":4229,"_4059":64,"_4060":4076,"_4091":4230,"_4093":4231,"_4095":232,"_4096":4232},"chr_0034_typhoea_43","chr_0034_typhoea_mono_self_line03","冷吗？我再添些柴火，睡袋已经铺好了，你先睡吧，今天我来守夜就好。嗯……不困的，我带了用来提神的草药。别乱碰，还想睡着就不要碰！唔，抱歉，我不是故意凶你，草药气味很冲，你今天帮了我很多，我只想你能好好休息。","信赖对话3",{"_4016":16,"_15":4234,"_4059":64,"_4060":4087,"_4091":4235,"_4093":4236,"_4095":1801,"_4096":4237},"chr_0034_typhoea_44","chr_0034_typhoea_mono_self_line04","不可以，我的笔记本不给别人看的，求我也不可以。上面的故事我都讲给你听过，你为什么还是好奇。用一段在应龙关的故事换？好吧，只许看一小会儿……那个脸上糊着黑方块的人？是你啊。为什么旁边的人拿着三角尺？谁许你这么说我的弓！笔记本还给我！","信赖对话4",{"_4016":16,"_15":4239,"_4059":64,"_4060":4087,"_4091":4240,"_4093":4241,"_4095":1841,"_4096":4242},"chr_0034_typhoea_45","chr_0034_typhoea_mono_self_line05","离开罗德岛后，我一直在各地旅行，见识了许多不同的风土人情，但哪儿都和萨米维格一样，也有很多传说随着当事人的离开，逐渐被人淡忘。一路上，只有我一个人，收集了一肚子的故事。我不怕孤单，狩猎……单独一人足够，但那些故事很好，需要同伴分享，需要有人记住。只有我知道，太可惜了。","信赖对话5",{"_4016":16,"_15":4244,"_4059":37,"_4060":37,"_4091":4245,"_4093":4246,"_4095":270,"_4096":4247},"chr_0034_typhoea_46","chr_0034_typhoea_mono_chat_line01","手摊开，给你……是黑森林里的小浆果，有点酸，不要吐出来，咽下去，它能带来一整月的好运气。","交谈1",{"_4016":16,"_15":4249,"_4059":37,"_4060":37,"_4091":4250,"_4093":4251,"_4095":1919,"_4096":4252},"chr_0034_typhoea_47","chr_0034_typhoea_mono_chat_line02","听说你最近睡得不好，把这块密文板挂在床头，它能恐吓那些进入你梦境的脏东西。上面符文的意思是，敢靠近你就把它们挫骨扬灰，丢进萨米维格最寒冷的冰涧冻得邦邦硬。","交谈2",{"_4016":16,"_15":4254,"_4059":37,"_4060":37,"_4091":4255,"_4093":4256,"_4095":72,"_4096":4257},"chr_0034_typhoea_48","chr_0034_typhoea_mono_chat_line03","管理员，别担心，常年身处荒野，我早已不害怕迷失，星星、风、树枝都会为我指明道路。难道一直朝着一个方向，死也不回头，硬是一条路走到底，就不会迷失方向吗？低头看看我们脚下的路吧，它永远是朝四面八方展开的，无论怎么走，都有新的机遇，新的发现。别怕，我和你一起走。","交谈3",{"_4016":16,"_15":4259,"_4059":37,"_4060":37,"_4091":4260,"_4093":4261,"_4095":60,"_4096":4262},"chr_0034_typhoea_49","chr_0034_typhoea_mono_chat_line04","你的剑钝了，给我吧，我带了磨刀石。你疏忽了，这不应该，你在担心什么吗？别隐瞒，猎人的观察力不仅会用在猎物身上，也会用在自己的伙伴身上……算了，你不想说就别说，我知道，有些经历不适合被讲述，也不该变成故事，被再次咀嚼。","交谈4",{"_4016":16,"_15":4264,"_4059":37,"_4060":37,"_4091":4265,"_4093":4266,"_4095":76,"_4096":4267},"chr_0034_typhoea_50","chr_0034_typhoea_mono_chat_line05","我不懂，我们剩下的电池不多了，这份报告你非要今天看完吗？借着月光也不行，眼睛会坏！在白天善用每一寸阳光，在夜晚就该沉入黑暗。谁说的？萨米人祖祖辈辈都这么说。现在看着我的眼睛，告诉我，我该敲晕你吗？","交谈5",{"_4016":16,"_15":4269,"_4059":37,"_4060":37,"_4091":4270,"_4093":4271,"_4095":78,"_4096":4272},"chr_0034_typhoea_51","chr_0034_typhoea_mono_about_line01","得知巨兽萨米为保护族人而陨落后，我很震惊，很难想象，族人在失去祂的庇佑后，该如何继续自己的生活。到达北方要塞后，我见到祂的尸骸上，族人仍在风雪中进行狩猎。之后，我前往战场，又亲眼见证了雪祀和天使间的殊死争斗……我才明白，祂还在，祂不屈的意志还在。死亡不是终结，放弃才是。","话题：巨兽萨米",{"_4016":16,"_15":4274,"_4059":37,"_4060":37,"_4091":4275,"_4093":4276,"_4095":80,"_4096":4277},"chr_0034_typhoea_52","chr_0034_typhoea_mono_about_line02","安玛，我知道祂，也记得祂。在塔卫二，那位老妈妈的传说已经支离破碎，族人曾试图铭记，但祂离开得太早，人的记忆又太脆弱……我也试图四处寻访那些还能完整讲述安玛故事的人，但很可惜，最终也只收获了只言片语。算了，就算是片段，只要还有人记得，终有一日能孕育出新的传说……像种子一样。","话题：安玛",{"_4016":16,"_15":4279,"_4059":37,"_4060":37,"_4091":4280,"_4093":4281,"_4095":82,"_4096":4282},"chr_0034_typhoea_53","chr_0034_typhoea_mono_about_line03","铁誓军的人是难得的好邻居，我们和他们能共同分享营火、武器、法术，还有食物，也能一起面对严寒、北风、天使，还有锚点。他们的血肉可以腐烂在我们的冻土上，他们的血脉也可以生长在我们的森林中，但他们不是我们，也无法成为我们。不，不是排外，是因为大家的使命不同，铁誓军的远征会胜利，而萨米人的狩猎不会有尽头。","话题：铁誓军",{"_4016":16,"_15":4284,"_4059":37,"_4060":37,"_4091":4285,"_4093":4286,"_4095":84,"_4096":4287},"chr_0034_typhoea_54","chr_0034_typhoea_mono_about_line04","不是我们不好客，天使和锚点的侵袭已经很烦人了，每天还有一群乘着大篷车前来探险的人。有什么可好奇的？捕鳞、狩猎、伐木，聚在篝火前煮汤，然后伴着火焰入眠，再睁眼，开始新的一天……都只是最寻常的生活而已。","话题：黑森林",{"_4016":16,"_15":4289,"_4059":37,"_4060":37,"_4091":4290,"_4093":4291,"_4095":86,"_4096":4292},"chr_0034_typhoea_55","chr_0034_typhoea_mono_about_line05","曾经的阴影已经是萨米历史中的一个注脚，这一章实在太过久远。就像被泡湿的笔记本，字迹已经被洇湿为一团团黑墨，挺不祥的，也没人愿意追究了。管理员，那一页已经被翻过了……至少现在，我们面前的敌人可以被看见。","话题：邪魔",{"_4016":16,"_15":4294,"_4059":37,"_4060":37,"_4091":4295,"_4093":4296,"_4095":578,"_4096":4297},"chr_0034_typhoea_71","chr_0034_typhoea_explore_point_common_01","等等，那里……有些东西。","发现资源1",{"_4016":16,"_15":4299,"_4059":37,"_4060":37,"_4091":4300,"_4093":4301,"_4095":2574,"_4096":4302},"chr_0034_typhoea_72","chr_0034_typhoea_explore_point_valub_01","直觉告诉我，这附近值得我们再仔细看看。","发现资源2",{"_4016":16,"_15":4304,"_4059":37,"_4060":37,"_4091":4305,"_4093":4306,"_4095":2612,"_4096":4307},"chr_0034_typhoea_73","chr_0034_typhoea_explore_find_locked_01","或许那些未知之地会给我们不一样的答案。","发现未探索区域",{"_4016":16,"_15":4309,"_4059":37,"_4060":37,"_4091":4310,"_4093":4311,"_4095":617,"_4096":4312},"chr_0034_typhoea_74","chr_0034_typhoea_explore_find_danger_01","别往前走，很危险。","发现强敌",{"_4016":16,"_15":4314,"_4059":37,"_4060":37,"_4091":4315,"_4093":4316,"_4095":2688,"_4096":4317},"chr_0034_typhoea_75","chr_0034_typhoea_interact_mine_valub_01","这些矿物很珍贵，需要多少就拿多少，不要贪心。","采集矿物1",{"_4016":16,"_15":4319,"_4059":37,"_4060":37,"_4091":4320,"_4093":4321,"_4095":2727,"_4096":4322},"chr_0034_typhoea_76","chr_0034_typhoea_interact_mine_valub_echo2_01","我也来，这得用巧劲儿才能取下来。","采集矿物2",{"_4016":16,"_15":4324,"_4059":37,"_4060":37,"_4091":4325,"_4093":4326,"_4095":656,"_4096":4327},"chr_0034_typhoea_77","chr_0034_typhoea_interact_treasure_valub_01","命运的馈赠。","打开储藏箱",{"_4016":16,"_15":4329,"_4059":37,"_4060":37,"_4091":4330,"_4093":4331,"_4095":2803,"_4096":4332},"chr_0034_typhoea_78","chr_0034_typhoea_interact_etherium_01","醚质……想捉到它们，得像猎人一样靠近。","获得醚质",{"_4016":16,"_15":4334,"_4059":37,"_4060":37,"_4091":4335,"_4093":4336,"_4095":2841,"_4096":4337},"chr_0034_typhoea_79","chr_0034_typhoea_interact_blight_break_01","希望它们没有伤害到更多生灵。","消除侵蚀",{"_4016":16,"_15":4339,"_4059":37,"_4060":37,"_4091":4340,"_4093":4341,"_4095":2880,"_4096":4342},"chr_0034_typhoea_80","chr_0034_typhoea_interact_rest_01","我感觉……精神多了。","休整",{"_4016":16,"_15":4344,"_4059":37,"_4060":37,"_4091":4345,"_4093":4346,"_4095":3330,"_4096":4347},"chr_0034_typhoea_91","chr_0034_typhoea_combat_suppuse_using_01","你受伤了，我帮你。","使用战术物品1",{"_4016":16,"_15":4349,"_4059":37,"_4060":37,"_4091":4350,"_4093":4351,"_4095":3369,"_4096":4352},"chr_0034_typhoea_92","chr_0034_typhoea_combat_suppuse_getheal_01","感觉好多了，别担心。","使用战术物品2",{"_4016":16,"_15":4354,"_4059":37,"_4060":37,"_4091":4355,"_4093":4356,"_4095":884,"_4096":4357},"chr_0034_typhoea_93","chr_0034_typhoea_combat_remind_danger_01","留心！","危险提醒",{"_4016":16,"_15":4359,"_4059":37,"_4060":37,"_4091":4360,"_4093":4361,"_4095":3445,"_4096":4362},"chr_0034_typhoea_94","chr_0034_typhoea_combat_hurt_lowhp_01","不行，还没到最后一刻。","负伤",{"_4016":16,"_15":4364,"_4059":37,"_4060":37,"_4091":4365,"_4093":4366,"_4095":3483,"_4096":4367},"chr_0034_typhoea_95","chr_0034_typhoea_combat_dead_01","抱歉，没能坚持到最后。","力竭",{"_4016":16,"_15":4369,"_4059":37,"_4060":37,"_4091":4370,"_4093":4371,"_4095":923,"_4096":4372},"chr_0034_typhoea_96","chr_0034_typhoea_combat_remind_praise_01","很荣幸有你做同伴。","小队激励1",{"_4016":16,"_15":4374,"_4059":37,"_4060":37,"_4091":4375,"_4093":4376,"_4095":3559,"_4096":4377},"chr_0034_typhoea_97","chr_0034_typhoea_combat_remind_praise_02","有同伴一起……很好，我很喜欢。","小队激励2",{"_4016":16,"_15":4379,"_4059":37,"_4060":37,"_4091":4380,"_4093":4381,"_4095":3598,"_4096":4382},"chr_0034_typhoea_98","chr_0034_typhoea_combat_remind_praise_echo2_01","没什么，是我该做的。","回应激励1",{"_4016":16,"_15":4384,"_4059":37,"_4060":37,"_4091":4385,"_4093":4386,"_4095":3636,"_4096":4387},"chr_0034_typhoea_99","chr_0034_typhoea_combat_remind_praise_echo2_02","我也一样，认可大家。","回应激励2",{"_4016":16,"_15":4389,"_4059":37,"_4060":37,"_4091":4390,"_4093":4391,"_4095":4392,"_4096":4393},"chr_0034_typhoea_111","chr_0034_typhoea_combat_intobattle_01","不要紧张，我们能应对。",111,"作战开始1",{"_4016":16,"_15":4395,"_4059":37,"_4060":37,"_4091":4396,"_4093":4397,"_4095":1119,"_4096":4398},"chr_0034_typhoea_112","chr_0034_typhoea_combat_intobattle_echo2_01","你已经进入状态了，很好。","作战开始2",{"_4016":16,"_15":4400,"_4059":37,"_4060":37,"_4091":4401,"_4093":4402,"_4095":4403,"_4096":4404},"chr_0034_typhoea_113","chr_0034_typhoea_combat_outbattle_nor_01","我喜欢这个结局。",113,"作战胜利1",{"_4016":16,"_15":4406,"_4059":37,"_4060":37,"_4091":4407,"_4093":4408,"_4095":4409,"_4096":4410},"chr_0034_typhoea_114","chr_0034_typhoea_combat_outbattle_nor_02","不该沉醉在胜利的喜悦中，得警惕。",114,"作战胜利2",{"_4016":16,"_15":4412,"_4059":37,"_4060":37,"_4091":4413,"_4093":4414,"_4095":1158,"_4096":4415},"chr_0034_typhoea_115","chr_0034_typhoea_combat_outbattle_nor_echo2_01","在我的故事中，始终有大家的位置。","作战胜利3",{"_4016":16,"_15":4417,"_4059":37,"_4060":37,"_4091":4418,"_4093":4419,"_4095":4420,"_4096":4421},"chr_0034_typhoea_116","chr_0034_typhoea_combat_outbattle_hard_01","故事中总有波折，但只要坚持，总能翻过那一页。",116,"作战胜利4",{"_4016":16,"_15":4423,"_4059":37,"_4060":37,"_4091":4424,"_4093":4425,"_4095":4426,"_4096":4427},"chr_0034_typhoea_117","chr_0034_typho