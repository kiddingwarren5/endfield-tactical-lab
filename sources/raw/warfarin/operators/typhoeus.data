":9308,"_9312":9313,"_9316":9317,"_9322":9323,"_9327":9328,"_8804":9332,"_9337":9338,"_9342":9343,"_9345":9346,"_9349":9350,"_9354":9355,"_9358":9359,"_9364":9365,"_9368":9369,"_9373":9374,"_9378":9379,"_8821":9383,"_9387":9388,"_9390":9391,"_8841":9395,"_9399":9400,"_9404":9405,"_9409":9410,"_9414":9415,"_9418":9419,"_9423":9424,"_8641":9429,"_8680":9433,"_9438":9439,"_9443":9444,"_9448":9449,"_8867":9453,"_9458":9459,"_9461":9462,"_9465":9466,"_9469":9470,"_9474":9475,"_9479":9480,"_9483":9484,"_9488":9489,"_8907":9493,"_9497":9498,"_9502":9503,"_9507":9508,"_9512":9513,"_9516":9517,"_9520":9521,"_9525":9526,"_9530":9531,"_9534":9535,"_9540":9541,"_9544":9545,"_9548":9549,"_9553":9554,"_9557":9558,"_9561":9562,"_9565":9566,"_9571":9572,"_9576":9577,"_9581":9582,"_9586":9587,"_9591":9592,"_9596":9597,"_9601":9602,"_9606":9607,"_9611":9612,"_9616":9617,"_9621":9622,"_9626":9627,"_9631":9632,"_9636":9637},"adv.electricFence",{"_4604":9127,"_9128":4046,"_15":9125,"_9129":4046,"_19":9130,"_9131":8697},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4604":9134,"_9128":9135,"_15":9132,"_9129":4046,"_19":9136,"_9131":8750},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4604":9138,"_9128":9139,"_15":8814,"_9129":9140,"_19":9141,"_9131":8879},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4604":9144,"_9128":4046,"_15":9142,"_9129":4046,"_19":9145,"_9131":8697},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4604":9148,"_9128":9149,"_15":9146,"_9129":4046,"_19":9150,"_9131":8697},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4604":9153,"_9128":4046,"_15":9151,"_9129":4046,"_19":9154,"_9131":8697},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4604":9157,"_9128":9158,"_15":9155,"_9129":4046,"_19":9159,"_9131":8791},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4604":9162,"_9128":4046,"_15":9160,"_9129":4046,"_19":9163,"_9131":8697},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4604":9166,"_9128":9167,"_15":9164,"_9129":4046,"_19":9168,"_9131":8697},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4604":9171,"_9128":4046,"_15":9169,"_9129":4046,"_19":9172,"_9131":4046},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4604":9175,"_9128":9176,"_15":9173,"_9129":4046,"_19":9177,"_9131":8750},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4604":9179,"_9128":9180,"_15":8629,"_9129":9181,"_19":9182,"_9131":8879},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4604":9185,"_9128":4046,"_15":9183,"_9129":4046,"_19":9186,"_9131":8697},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4604":9189,"_9128":9190,"_15":9187,"_9129":4046,"_19":9191,"_9131":8697},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4604":9194,"_9128":9195,"_15":9192,"_9129":4046,"_19":9196,"_9131":8697},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4604":9199,"_9128":4046,"_15":9197,"_9129":4046,"_19":9200,"_9131":8724},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4604":9203,"_9128":9204,"_15":9201,"_9129":4046,"_19":9205,"_9131":8697},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4604":9208,"_9128":4046,"_15":9206,"_9129":4046,"_19":9209,"_9131":8724},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4604":9211,"_9128":9212,"_15":8712,"_9129":9213,"_19":9214,"_9131":8791},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4604":9217,"_9128":9212,"_15":9215,"_9129":4046,"_19":9218,"_9131":8791},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4604":9221,"_9128":9222,"_15":9219,"_9129":9223,"_19":9224,"_9131":8724},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4604":9227,"_9128":4046,"_15":9225,"_9129":4046,"_19":9228,"_9131":8724},"持续时间内，受影响的目标暂停行动。","定身",{"_4604":9230,"_9128":9231,"_15":8718,"_9129":9232,"_19":9233,"_9131":8903},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4604":9236,"_9128":9231,"_15":9234,"_9129":4046,"_19":9237,"_9131":8903},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4604":9240,"_9128":4046,"_15":9238,"_9129":9241,"_19":9242,"_9131":4046},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4604":9244,"_9128":9245,"_15":8736,"_9129":9246,"_19":9247,"_9131":8853},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4604":9250,"_9128":9245,"_15":9248,"_9129":4046,"_19":9251,"_9131":8853},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4604":9254,"_9128":9255,"_15":9252,"_9129":4046,"_19":9256,"_9131":8697},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4604":9258,"_9128":9259,"_15":8743,"_9129":9260,"_19":9261,"_9131":8879},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4604":9264,"_9128":9265,"_15":9262,"_9129":9266,"_19":9267,"_9131":8724},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4604":9270,"_9128":9271,"_15":9268,"_9129":4046,"_19":9272,"_9131":8724},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4604":9274,"_9128":9275,"_15":8767,"_9129":9276,"_19":9277,"_9131":8750},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4604":9280,"_9128":4046,"_15":9278,"_9129":9281,"_19":9282,"_9131":8750},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4604":9285,"_9128":9286,"_15":9283,"_9129":4046,"_19":9287,"_9131":8697},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4604":9290,"_9128":9291,"_15":9288,"_9129":4046,"_19":9292,"_9131":8697},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4604":9295,"_9128":9296,"_15":9293,"_9129":4046,"_19":9297,"_9131":8750},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4604":9299,"_9128":9135,"_15":8774,"_9129":9300,"_19":9301,"_9131":8750},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4604":9304,"_9128":4046,"_15":9302,"_9129":9305,"_19":9306,"_9131":8724},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4604":9309,"_9128":9310,"_15":9307,"_9129":4046,"_19":9311,"_9131":8697},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4604":9314,"_9128":4046,"_15":9312,"_9129":4046,"_19":9315,"_9131":4046},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4604":9318,"_9128":9319,"_15":9316,"_9129":9320,"_19":9321,"_9131":8724},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4604":9324,"_9128":9325,"_15":9322,"_9129":4046,"_19":9326,"_9131":8697},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4604":9329,"_9128":4046,"_15":9327,"_9129":9330,"_19":9331,"_9131":8791},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4604":9333,"_9128":9334,"_15":8804,"_9129":9335,"_19":9336,"_9131":8791},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4604":9339,"_9128":9340,"_15":9337,"_9129":4046,"_19":9341,"_9131":8697},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4604":9217,"_9128":9334,"_15":9342,"_9129":4046,"_19":9344,"_9131":8791},"干员受到灼热附着","sys.tacticalItem",{"_4604":9347,"_9128":4046,"_15":9345,"_9129":4046,"_19":9348,"_9131":8697},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4604":9351,"_9128":9352,"_15":9349,"_9129":4046,"_19":9353,"_9131":8791},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4604":9236,"_9128":9356,"_15":9354,"_9129":4046,"_19":9357,"_9131":8903},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4604":9360,"_9128":9361,"_15":9358,"_9129":9362,"_19":9363,"_9131":8724},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4604":9366,"_9128":4046,"_15":9364,"_9129":4046,"_19":9367,"_9131":8724},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4604":9370,"_9128":9371,"_15":9368,"_9129":4046,"_19":9372,"_9131":8879},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4604":9375,"_9128":9376,"_15":9373,"_9129":4046,"_19":9377,"_9131":8903},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4604":9380,"_9128":9381,"_15":9378,"_9129":4046,"_19":9382,"_9131":8724},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4604":9384,"_9128":9385,"_15":8821,"_9129":9276,"_19":9386,"_9131":8750},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4604":9134,"_9128":9385,"_15":9387,"_9129":4046,"_19":9389,"_9131":8750},"干员受到冻结","ba.naturalvul",{"_4604":9392,"_9128":9393,"_15":9390,"_9129":4046,"_19":9394,"_9131":8853},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4604":9179,"_9128":9396,"_15":8841,"_9129":9397,"_19":9398,"_9131":8879},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4604":9401,"_9128":9402,"_15":9399,"_9129":4046,"_19":9403,"_9131":8697},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4604":9406,"_9128":9407,"_15":9404,"_9129":4046,"_19":9408,"_9131":8697},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4604":9411,"_9128":9412,"_15":9409,"_9129":4046,"_19":9413,"_9131":8697},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4604":9416,"_9128":4046,"_15":9414,"_9129":4046,"_19":9417,"_9131":8697},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4604":9420,"_9128":4046,"_15":9418,"_9129":9421,"_19":9422,"_9131":4046},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4604":9425,"_9128":9426,"_15":9423,"_9129":9427,"_19":9428,"_9131":8724},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4604":9430,"_9128":4046,"_15":8641,"_9129":9431,"_19":9432,"_9131":8853},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4604":9434,"_9128":9435,"_15":8680,"_9129":9436,"_19":9437,"_9131":8879},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4604":9440,"_9128":9441,"_15":9438,"_9129":4046,"_19":9442,"_9131":8697},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4604":9445,"_9128":9446,"_15":9443,"_9129":4046,"_19":9447,"_9131":8853},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4604":9450,"_9128":9451,"_15":9448,"_9129":4046,"_19":9452,"_9131":8697},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4604":9454,"_9128":9455,"_15":8867,"_9129":9456,"_19":9457,"_9131":8853},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4604":9250,"_9128":9455,"_15":9458,"_9129":4046,"_19":9460,"_9131":8853},"干员受到自然附着","ba.originium",{"_4604":9463,"_9128":4046,"_15":9461,"_9129":4046,"_19":9464,"_9131":8724},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4604":9467,"_9128":4046,"_15":9465,"_9129":4046,"_19":9468,"_9131":8879},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4604":9471,"_9128":9472,"_15":9469,"_9129":4046,"_19":9473,"_9131":8879},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4604":9476,"_9128":4046,"_15":9474,"_9129":9477,"_19":9478,"_9131":8887},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4604":9481,"_9128":4046,"_15":9479,"_9129":4046,"_19":9482,"_9131":8697},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4604":9485,"_9128":4046,"_15":9483,"_9129":9486,"_19":9487,"_9131":8903},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4604":9490,"_9128":9491,"_15":9488,"_9129":4046,"_19":9492,"_9131":8697},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4604":9494,"_9128":9356,"_15":8907,"_9129":9495,"_19":9496,"_9131":8903},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4604":9499,"_9128":9500,"_15":9497,"_9129":4046,"_19":9501,"_9131":8903},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4604":9504,"_9128":4046,"_15":9502,"_9129":9505,"_19":9506,"_9131":8724},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4604":9509,"_9128":4046,"_15":9507,"_9129":9510,"_19":9511,"_9131":4046},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4604":9514,"_9128":4046,"_15":9512,"_9129":4046,"_19":9515,"_9131":8697},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4604":9518,"_9128":4046,"_15":9516,"_9129":4046,"_19":9519,"_9131":8724},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4604":9522,"_9128":9523,"_15":9520,"_9129":4046,"_19":9524,"_9131":8697},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4604":9527,"_9128":4046,"_15":9525,"_9129":9528,"_19":9529,"_9131":8724},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4604":9532,"_9128":4046,"_15":9530,"_9129":4046,"_19":9533,"_9131":8697},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4604":9536,"_9128":9537,"_15":9534,"_9129":9538,"_19":9539,"_9131":8724},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4604":9542,"_9128":4046,"_15":9540,"_9129":4046,"_19":9543,"_9131":8724},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4604":9546,"_9128":4046,"_15":9544,"_9129":4046,"_19":9547,"_9131":8724},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4604":9550,"_9128":9551,"_15":9548,"_9129":4046,"_19":9552,"_9131":8697},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4604":9555,"_9128":4046,"_15":9553,"_9129":4046,"_19":9556,"_9131":8724},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4604":9559,"_9128":4046,"_15":9557,"_9129":4046,"_19":9560,"_9131":8724},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4604":9563,"_9128":4046,"_15":9561,"_9129":4046,"_19":9564,"_9131":8724},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4604":9567,"_9128":9568,"_15":9565,"_9129":9569,"_19":9570,"_9131":8724},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4604":9573,"_9128":9574,"_15":9571,"_9129":4046,"_19":9575,"_9131":8697},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4604":9578,"_9128":9579,"_15":9576,"_9129":4046,"_19":9580,"_9131":8697},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4604":9583,"_9128":9584,"_15":9581,"_9129":4046,"_19":9585,"_9131":8697},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4604":9588,"_9128":9589,"_15":9586,"_9129":4046,"_19":9590,"_9131":8697},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4604":9593,"_9128":9594,"_15":9591,"_9129":4046,"_19":9595,"_9131":8697},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4604":9598,"_9128":9599,"_15":9596,"_9129":4046,"_19":9600,"_9131":8697},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4604":9603,"_9128":9604,"_15":9601,"_9129":4046,"_19":9605,"_9131":8697},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4604":9608,"_9128":9609,"_15":9606,"_9129":4046,"_19":9610,"_9131":8697},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4604":9613,"_9128":9614,"_15":9611,"_9129":4046,"_19":9615,"_9131":8697},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4604":9618,"_9128":9619,"_15":9616,"_9129":4046,"_19":9620,"_9131":8697},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4604":9623,"_9128":9624,"_15":9621,"_9129":4046,"_19":9625,"_9131":8697},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4604":9628,"_9128":9629,"_15":9626,"_9129":4046,"_19":9630,"_9131":8697},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4604":9633,"_9128":9634,"_15":9631,"_9129":4046,"_19":9635,"_9131":8697},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4604":9638,"_9128":9639,"_15":9636,"_9129":4046,"_19":9640,"_9131":8697},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_8333":9643,"_7883":9652,"_7464":9654,"_7850":9656,"_7982":9658,"_7984":9660,"_7986":9662,"_7989":9664,"_7991":9666,"_7993":9667,"_6301":9669,"_7998":9671,"_5754":9672,"_8003":9673,"_8005":9675,"_8008":9676,"_8011":9677,"_8014":9678,"_8018":9680,"_8022":9681,"_5748":9682,"_8029":9683,"_8032":9684,"_8036":9685,"_8040":9686,"_8043":9687,"_8047":9688,"_8051":9690,"_8055":9691,"_8059":9693,"_8063":9695,"_8067":9697,"_8071":9698,"_8075":9700,"_8079":9702,"_8083":9703,"_8087":9705,"_8091":9707,"_8095":9709,"_8099":9711,"_8103":9714,"_8107":9717,"_8111":9720,"_8115":9723,"_8119":9724,"_8123":9726,"_8127":9727,"_8131":9728,"_8135":9730,"_8139":9732,"_8143":9733,"_8147":9735,"_8151":9737,"_8155":9739,"_8159":9741,"_8163":9743,"_8167":9745,"_8171":9747,"_8174":9749,"_8178":9751,"_8182":9753,"_8186":9754,"_8190":9756,"_8194":9757,"_8198":9758,"_8202":9759,"_8206":9760,"_8210":9761,"_8214":9762,"_8218":9763,"_8222":9764,"_8226":9765,"_8230":9766,"_8234":9767,"_8238":9768,"_8242":9769,"_8246":9770,"_8250":9771,"_8254":9772,"_8258":9773,"_8262":9774,"_8266":9775,"_8269":9776,"_8273":9777,"_8277":9778,"_8281":9779,"_8285":9780,"_8289":9781,"_8293":9783,"_8297":9784,"_8301":9785,"_9786":9787,"_9788":9789,"_9790":9791,"_9792":9793,"_9794":9795,"_9796":9797,"_9798":9799,"_9800":9801,"_9802":9803,"_9804":9805,"_9806":9807,"_9809":9810,"_9812":9813,"_9814":9815,"_9817":9818,"_9820":9821,"_9822":9823},{"_9644":37,"_9645":4046,"_9646":39,"_9647":5084,"_9648":5084,"_9649":4046,"_9650":37,"_9651":37},"attributeType","bigIconName","defaultValue","hasMaxValue","hasMinValue","iconName","maxValue","minValue",{"_9644":39,"_9645":4046,"_9646":39,"_9647":5084,"_9648":4041,"_9649":9653,"_9650":37,"_9651":37},"icon_a