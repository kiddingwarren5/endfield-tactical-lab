6":39,"_38":3906},5832,{"_36":55,"_38":3908},340,{"_36":58,"_38":37},{"_36":60,"_38":3911},1.48469387755102,{"_36":62,"_38":3913},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3933,"_101":64},{"_33":3934},[3935,3937,3939,3941,3943,3945,3947,3949,3950,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970],{"_36":37,"_38":3936},97,{"_36":41,"_38":3938},108.22974963181147,{"_36":44,"_38":3940},117.85297706711577,{"_36":47,"_38":3942},103.82495266147694,{"_36":50,"_38":3944},185.2804544498217,{"_36":39,"_38":3946},5888,{"_36":55,"_38":3948},343,{"_36":58,"_38":37},{"_36":60,"_38":3951},1.48979591836735,{"_36":62,"_38":2014},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3972,"_101":64},{"_33":3973},[3974,3976,3978,3980,3982,3984,3986,3988,3989,3991,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010],{"_36":37,"_38":3975},98,{"_36":41,"_38":3977},109.2282768777614,{"_36":44,"_38":3979},118.93885966757864,{"_36":47,"_38":3981},104.79907426888279,{"_36":50,"_38":3983},187.00105196717914,{"_36":39,"_38":3985},5944,{"_36":55,"_38":3987},347,{"_36":58,"_38":37},{"_36":60,"_38":3990},1.49489795918367,{"_36":62,"_38":3992},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4012,"_101":64},{"_33":4013},[4014,4015,4017,4019,4021,4023,4025,4027,4028,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048],{"_36":37,"_38":925},{"_36":41,"_38":4016},110.22680412371133,{"_36":44,"_38":4018},120.0247422680415,{"_36":47,"_38":4020},105.77319587628864,{"_36":50,"_38":4022},188.7216494845366,{"_36":39,"_38":4024},6000,{"_36":55,"_38":4026},350,{"_36":58,"_38":37},{"_36":60,"_38":4029},1.5,{"_36":62,"_38":2052},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4051,4052],"tag_05","tag_11","charId","charIllustInitPos",{"_4056":462,"_4057":4058},"x","y",-190,"charPassiveUIPrefabName","","charTypeId","Physical","cvName",{"_4065":4066,"_4067":4068,"_4069":4070,"_4071":4072,"_4053":16},"ChiCVName","刘若班","EngCVName","Sergey Ponomaryov","JapCVName","速水奖","KorCVName","权星赫","defaultWeaponId","wpn_sword_0003","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Pogranichnik","mainAttrType","phoneticName","profession","profileRecord",[4086,4097,4102,4107,4113,4118],{"_4053":16,"_15":4087,"_4088":4089,"_4090":4091,"_4092":39,"_4093":4094,"_4095":37,"_4096":37},"chr_0029_pograni_1","recordDesc","【代号】骏卫\n【性别】男\n【身份认证】罗德岛\n【生日】7月23日\n【种族】黎博利\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：优良\n作战技巧：优良\n战术规划：卓越\n源石技艺适应性：标准","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4053":16,"_15":4098,"_4088":4099,"_4090":4100,"_4092":55,"_4093":4101,"_4095":37,"_4096":37},"chr_0029_pograni_2","骏卫，本名赫尔森，罗德岛驻外干员，铁誓军盾卫旗队指挥官，常年驻扎在塔卫二北方的环北极圈前线。因局势需要，现加入终末地工业，协助执行相关作战任务。\n\n第一次见到骏卫，他不折不扣的军人身姿就给我留下了深刻的印象。骏卫行事果断且迅速，绝不拖泥带水。并且无论事情大小，只要他给予了承诺，就一定会尽全力做到。\n虽然骏卫没有对《环带公约》的三巨头表现出明显的偏好，但很显然，他对联盟工团的“城市母亲”情有独钟。他并不介意漫步在移动地块生产坞的阴影下，和工人们聊聊天。有时候，他也会遇到几个对理想和生活感到迷茫的工团成员。他很擅长激励士气，即使对方是远离战场的普通人，他也有办法令人对未来重拾信心。在骏卫留给铁誓军战士和工团成员的印象中，锋利但从不伤人的冷幽默也是其中之一。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4053":16,"_15":4103,"_4088":4104,"_4090":4105,"_4092":58,"_4093":4106,"_4095":37,"_4096":37},"chr_0029_pograni_3","【两张照片】\n一张边角泛黄的照片。骏卫和熔炉要塞兵工厂的几位工匠并肩而立，其中有男有女，种族各异。在所有人的背后，是一道覆盖着冰雪的钢制要塞强化工事，两名铁誓军哨兵在工事顶端举起望远镜凝视远方。更远处，稍显模糊的地平线上，要塞的轮廓若隐若现，大口径火炮直指天际。而在骏卫的身边，一位工匠带着不同于众人的骄傲神情，手指向天空，那里悬浮着一艘庞大的飞行器，通过照片无法看清它完整的姿态。\n\n一张俯瞰要塞大厅的照片。大厅正中的铁誓军战士们抬起手来，对讲台上的骏卫举杯。照片的左上角，骏卫将一只拳头放在身后的巨幅地图上；照片右上角，是一张很长的餐桌，除了一位脸庞棱角分明的银发老者——因望向另一边而面貌不清，每一个人都佩戴着旗队指挥官的徽记和绶带，他们同样举起了手中的杯子。而在照片的左下角，年轻的新兵们勾肩搭背，其中一位不知从哪里拿出了手风琴，周围的战士们大张着嘴，似乎在齐声欢呼。大厅中有许多笑容，但骏卫从未向任何人主动展示过这张照片，也未曾将它装进哪一个相框。\n\n【三份食谱】\n正餐食谱C5：“原切驮兽肉排套餐”，由联盟工团提供。厚切整块驮兽腿肉，添加营养剂，烟熏风味。工人卫队军标食谱，连续二十年荣获全联盟工团中央生产计划委员会嘉奖。\n“盾卫们还在适应营养添加剂的异味。除此之外，这是一份无可挑剔的作战口粮，能量充足，营养充分，肉排口感良好——我在记忆中品尝过相似的味道，它来自乌萨斯。”\n\n正餐食谱C8：“磐蟹奶酪盖饭定食”，由环塔商会提供。菈梵朵玛特供磐蟹，新都筑烹饪大师亲自操刀，以耶尔什的奶酪烹饪激发极致鲜味，为铁誓军的无畏战士们带来山海一体的味觉享受。\n“自热口粮中难得一见的精致食谱，在维持旗队士气的方面效果显著，但对盾卫们来说，目前的分量并不足以补充他们消耗的体能，请改进。”\n\n正餐食谱C12：“尚蜀风味即热锅”，由宏山科学院提供。在装口粮包的箱子背面，有人用潦草的笔迹写着：赫尔森，你的兵也算是能征善战，可饮食的口味怎么能这么清淡！光看着嘴里都淡出羽兽来！看在你对我一口一个“天师”的份上，这种口味的吃食我白送给你们了，驱寒提神暖肠胃，别忘了熬一下驮兽油，打个油碟。\n“这道主菜击败了我的战士们，半个旗队的盾卫喊着要止痛剂，还有人从地上抓起雪往嘴里塞。不过，旗队在接下来三十公里的徒步行进中都没有再感到寒冷。”\n\n【一张地图】\n一张绘制在鞣制瘤兽皮上的巨幅地图，为了应对现有源石技术装备全部失效的情况而绘制。\n地图上密密麻麻地标注着铁誓军的防区和补给线，以及重要防御工事的所在位置。熔炉要塞兵工厂的所在之处同样被囊括其中。\n在地图所示的南部，数十道弯弯扭扭的路线沿着等高线延伸至各个要塞，其中有些穿过了黑森林——这些路线是铁誓军与文明环带间的生命线，北方走廊的末梢。而在北部，还有一道极为显眼的锯齿状战线。这条战线像一道伤痕，从铁誓军的主要防区一路向北延伸，直到极光壁的边界为止。\n在地图陈列架旁的标签上，绘制这张地图的骏卫留下了笔迹：\n一千两百三十七个名字，这就是它的价值。","CN_03","档案资料·一",{"_4053":16,"_15":4108,"_4088":4109,"_4090":4110,"_4092":64,"_4093":4111,"_4095":64,"_4096":4112},"chr_0029_pograni_4","【记录在█████要塞的对话片段】\n“请等一下，教官，请等一下。刚才的授课非常精彩，您一定是对抗天使的专家。我们刚才听那些战士喊您——赫尔森？”\n“能帮助你们掌握在交战中活下去的方法就够了。你们找我有什么事？”\n“太好了，我叫瓦季姆，瓦季姆·伊格纳季耶维奇·斯米尔诺夫，这是穆拉维约夫，我们两个来自联盟工团。”\n“伊格纳季？我记得这个名字。新兵，你是因为你的父亲离开的故土？你的父亲常给我们看你的照片。”\n“家父尚在时，常常在书信里写下您的事迹。能和您一同挡住冲击战线的天使，是他的荣幸——他一直在信里这么写。”\n“没错！我和瓦沙小时候，经常像信……信里的一样！玩模仿铁誓军盾卫的游戏。我们希望能像信里的您那样英勇。”\n“我们……我和穆拉维约夫通过了要塞的选拔，希望继承父亲的勇气，哪怕献出生命！”\n“令人钦佩的志向。但我希望你们能明白，牺牲不是目的，铁誓军的战斗是为了阻止更多的牺牲。”\n“赫尔森教官，从还在学校念书起，我就在想象，当北地的天使冲击着防线，其他旗队的战士们都在苦苦支撑，眼看就要挡不住了，终于，身后传来铁盾砸地的巨响——是英雄赫尔森带着盾卫冲了上来！这声巨响让每个人知道，你们矗立的地方，就是敌人无法逾越的边界。”\n“瓦沙说得对，教官，我们不怕牺牲！”\n“不。我见过太多想要成为英雄的人倒在这里。如果你们真的想要成为一名盾卫，需要的就不是对‘英雄’或者‘牺牲’的崇拜。”\n“可您……”\n“你们需要活下去，出现在其他人需要你们的地方，需要将盾立在你们的面前。然后——”\n“帮助……其他人活下去？”\n“不错，你们确实听得很认真。这是盾卫在列阵作战时最基本的战术，我们并肩而立，为了让更多人活下去——无论是苟且偷生，传承意志，还是为了执行下一次的有效战术反击。”\n“您的教导让我充满了力量，赫尔森教官！我……我们！咳，瓦沙，你倒是说句话呀！”\n“我，还有穆拉维约夫！我们一定会成为盾卫，去您的旗队服役！”\n“那么，我期待与你们并肩而立的那一天。”","CN_04","档案资料·二",300,{"_4053":16,"_15":4114,"_4088":4115,"_4090":4116,"_4092":66,"_4093":4117,"_4095":64,"_4096":4112},"chr_0029_pograni_5","环塔联合服务研究所关于█████战役的汇报：\n尊敬的环塔企业联席会议的各位代表，本人——特派观察员兼战争资产保险业务代表坦纳·奥瑞根，在此对本人随铁誓军参与的█████战役做出报告。\n在此次铁誓军与北方天使集群的高强度冲突中，由《环带公约》缔约各方提供的战争资产遭到了严重的损耗。铁誓军方面的主要资产损失主要包括三十一部步行火炮平台以及其他用于加固防区的重型无人装备，更多损失细节请查阅各位代表手边的纸质附录a3。\n…………\n诚然，由于突然出现的未知个体，铁誓军逼近极光壁的攻势被迫中止。但请各位代表注意，在进攻行动中造成的所有损失，恰恰证明了我方与铁誓军进一步展开合作，提供无偿援助的前景。在协助完善铁誓军的工业生产设施建设后，北方对各企业的产品需求将不减反增，还将从大宗装备购置领域合作转入更加深层、对我方更加有利的技术产权合作。\n…………\n此次战役中，本人随负责主要进攻方向的旗队到达一处山脊前方，逼近前进要塞。仅凭肉眼观测，完全无法从毫无空隙的天使集群中找到要塞的位置——直到那位在消耗战争资产时毫不吝啬的旗队指挥官赫尔森，在天使集群的另一侧杀出，盾卫随之列阵上前，将战线推过山脊，把要塞火炮的导引信标部署在高处。\n与此同时，先前导致其他方向的旗队受挫的未知个体再次在极光下方出现。各位代表，在此我想声明一项本人与铁誓军方面达成的共识：在任何情况下，我们绝不能放任此类个体进入人口密集区域。彼时，我尚处在相对安全的前线指挥中心，但该个体引发的超域活动已让我携带的记录设备陷入失灵状态。在这一危急时刻，盾卫旗队的领袖赫尔森在战线的最前方率领进攻，在他的身后，盾卫们举起铁壁，英勇又坚定地向前推进。接下来的景象无法用客观的语言描述，我看到红色的光切开最坚固的天使，让它们化作沉默的墓碑；盾墙每分每秒都在出现空缺，但任何一处空隙都会立刻由另一名盾卫补上。在进行了四十七分钟的激烈交战后，赫尔森和他的盾卫在天使集群的中央踏出一条道路，围困了那个需要对数百名最优秀的铁誓军战士阵亡负责的未知个体，在一次交锋中将它雕塑般的表面沿中轴线切开。未知个体将其内侧构成物喷向空中试图突围，但自空中降下的火焰以及铁甲间喷涌出的蒸汽最终扑灭了它的反抗。\n…………\n各位代表，本次作战印证了铁誓军不可取代的地位。我方的支援行动不仅是对《环带公约》利他精神的阐释，更是对北方前线“关键韧性战略”的投资。本次报告的另一项主旨在于澄清，铁誓军真正的遗产不在要塞深处的遗产库内，而是被寄托在赫尔森这样的关键人物身上。在可预见的未来，他们无法被估价，也不能被交易，但毫无疑问——“文明环带的英雄”将是环塔商会最有价值的投资。","CN_05","档案资料·三",{"_4053":16,"_15":4119,"_4088":4120,"_4090":4121,"_4092":68,"_4093":4122,"_4095":64,"_4096":4123},"chr_0029_pograni_6","“城市母亲”。\n还未去过那里时，我曾无数次在联盟工团拍摄的各种艺术片里看到这个名字。那是塔卫二全联盟工团的心脏，高耸的指挥塔，集成式移动地块生产坞，与记忆所见的那些移动城市一样——坚固、庞大无比。\n然而，在进入那座城市后，我首先看到的不是惊人的工业巨构，而是扛着建材、奔赴劳动现场的工团成员们。这些永远不会失掉精力的工人们，正将“血液”输送到这座城市的每一个角落，在每一平方米的混凝土表面留下自己的手印。\n出于好奇，我没有去寻找一位本地向导，而是跟随着刚刚结束一天工作的工人，走进了一栋庞大、简约的建筑。一阵拥挤后，我来到了大厅的二层，在一张柔软的椅子上坐下——直到这时，我才意识到，这里是这座城市的工人剧院。而刚才那队刚刚结束工作的工人，已经换好服装，变成了舞台上的音乐剧演员。\n与我的猜测不同，他们没有演出歌颂劳动英雄的戏码，反而将一出讽刺官僚的诙谐喜剧搬上了舞台——在工人们默契的“唬骗”下，腐败官僚以为自己真的找到了在塔卫二上并不存在的赤金，最终尝到了贪婪的苦果。当然，工人们仍然在故事里扮演了英雄，只不过英雄们充满了幽默感，还有对幸福生活的无穷热情。\n当剧目散场，我怀揣心事，即将离开剧场的时候，一对大约十岁的双胞胎姐弟不知怎么发现了我的身份。“铁誓军！铁誓军！”他们兴奋地尖叫着，拦在我的面前，对我行了个相当稚嫩的铁誓军军礼。他们的父母，还有其他工人不得不费一番功夫，才将两个不断提出我难以解答的问题的小家伙带走。但我可以从表情上看出，如果再稍微年轻一些，那些在场的成年人也会毫不犹豫地做出同样孩子气的事情。\n还未离开罗德岛时，我见过一个梦境。梦里的宴会上，集团军贵族的孩子们穿着华丽，被仆人和家庭教师严密看管，如同一个个被精心打扮的玩偶。他们的眼里也有过与那对双胞胎相似的纯真和激情，只是夹杂了其他东西。家族的荣耀？还是对老一辈权力的渴望？我说不清，只知道那些杂质绝不可能来自他们自己的意志。慢慢地，我看着杂质化为野心，闪烁着构思阴谋时闪烁的寒光，最终变成我无论如何都认不出的样子。\n当我走出剧院，独自走上“城市母亲”的街头的那一刻，一种奇异的自由感追上了我。我仍会想起身后冲锋的帝国百战先锋、患有矿石病的女孩、沦为废墟的地下诊所、四处奔走的人群、嬉戏打闹的孩童，他们仍在我体内的某处驻留，但我已几乎不再感到沉重。\n旧日的坟墓上立起了新碑，短暂地游览过这座城市后，我很快回到了北方。那是一片牺牲了一整个时代、没有旧世界的尘埃和新世界的蓝图、只为“活着”而战的战场。\n那是我们的战场。\n——未署名的语音转录记录，留档于罗德岛","CN_06","档案资料·四",1500,"profileVoice",[4126,4134,4138,4142,4146,4150,4154,4159,4164,4169,4174,4179,4184,4189,4194,4199,4204,4209,4214,4219,4224,4229,4234,4239,4244,4249,4254,4259,4264,4269,4274,4279,4284,4289,4294,4299,4304,4309,4314,4319,4324,4329,4334,4339,4344,4349,4354,4359,4364,4369,4374,4379,4384,4389,4394,4399,4404,4409,4414,4419,4424,4429,4434,4439,4444,4449,4454,4459,4464,4469,4474,4479,4484,4489,4494,4499,4504,4509,4514,4519,4524,4529],{"_4053":16,"_15":4087,"_4095":37,"_4096":37,"_4127":4128,"_4129":4130,"_4131":39,"_4132":4133},"voId","chr_0029_pograni_chrbark_squad_01","voiceDesc","已到达待命位置。","voiceIndex","voiceTitle","行动准备1",{"_4053":16,"_15":4098,"_4095":37,"_4096":37,"_4127":4135,"_4129":4136,"_4131":55,"_4132":4137},"chr_0029_pograni_chrbark_squad_02","随时准备拔营。","行动准备2",{"_4053":16,"_15":4103,"_4095":37,"_4096":37,"_4127":4139,"_4129":4140,"_4131":58,"_4132":4141},"chr_0029_pograni_chrbark_join_01","战斗即是军人的天职。","编入队伍1",{"_4053":16,"_15":4108,"_4095":37,"_4096":37,"_4127":4143,"_4129":4144,"_4131":64,"_4132":4145},"chr_0029_pograni_chrbark_join_02","我们总是需要为生存付出代价。","编入队伍2",{"_4053":16,"_15":4114,"_4095":37,"_4096":37,"_4127":4147,"_4129":4148,"_4131":66,"_4132":4149},"chr_0029_pograni_chrbark_weap_01","必须学会如何去运用暴力，只为生存，无关善恶。","更换武器",{"_4053":16,"_15":4119,"_4095":37,"_4096":37,"_4127":4151,"_4129":4152,"_4131":68,"_4132":4153},"chr_0029_pograni_chrbark_gear_01","在军需官眼中，完备的武装无异于胜利的起点。","更换装备",{"_4053":16,"_15":4155,"_4095":37,"_4096":37,"_4127":4156,"_4129":4157,"_4131":70,"_4132":4158},"chr_0029_pograni_7","chr_0029_pograni_chrup_skill_01","懈怠与疏忽，才是战场上最棘手的敌人。","激活天赋阵列",{"_4053":16,"_15":4160,"_4095":37,"_4096":37,"_4127":4161,"_4129":4162,"_4131":88,"_4132":4163},"chr_0029_pograni_8","chr_0029_pograni_chrup_level_01","很有价值的战斗……真令人热血沸腾。","观看作战记录",{"_4053":16,"_15":4165,"_4095":55,"_4096":39,"_4127":4166,"_4129":4167,"_4131":90,"_4132":4168},"chr_0029_pograni_9","chr_0029_pograni_chrup_promt01_01","无需勋章与仪式，我明白这代表着什么……谢谢你的信任，终末地的管理员。","精英化晋升1",{"_4053":16,"_15":4170,"_4095":55,"_4096":55,"_4127":4171,"_4129":4172,"_4131":411,"_4132":4173},"chr_0029_pograni_10","chr_0029_pograni_chrup_promt02_01","如果是在铁誓军的堡垒，今晚我就不得不成为一场宴会的主持了。","精英化晋升2",{"_4053":16,"_15":4175,"_4095":55,"_4096":58,"_4127":4176,"_4129":4177,"_4131":100,"_4132":4178},"chr_0029_pograni_11","chr_0029_pograni_chrup_promt03_01","无论在战场还是别处，这都是一种荣誉。管理员，感谢你托付的信任，我会在最前线证明它的意义。","精英化晋升3",{"_4053":16,"_15":4180,"_4095":55,"_4096":64,"_4127":4181,"_4129":4182,"_4131":95,"_4132":4183},"chr_0029_pograni_12","chr_0029_pograni_chrup_promt04_01","塔卫二的战争依然残酷，至今仍有无数人于北方前赴后继，只为众多的生机能够延续。我相信，管理员你所做的，会让这惨烈的循环得到一份庄严的结局。","精英化晋升4",{"_4053":16,"_15":4185,"_4095":37,"_4096":37,"_4127":4186,"_4129":4187,"_4131":528,"_4132":4188},"chr_0029_pograni_13","chr_0029_pograni_introduce_01","骏卫，罗德岛驻外干员兼铁誓军军官，向你报到。事态紧急，我希望尽快了解你的作战计划……最好就是现在。","干员报到",{"_4053":16,"_15":4190,"_4095":37,"_4096":37,"_4127":4191,"_4129":4192,"_4131":567,"_4132":4193},"chr_0029_pograni_14","chr_0029_pograni_mono_switch_01","再推演一次作战计划，如何？","待命1",{"_4053":16,"_15":4195,"_4095":37,"_4096":37,"_4127":4196,"_4129":4197,"_4131":97,"_4132":4198},"chr_0029_pograni_15","chr_0029_pograni_mono_switch_02","战场上的生与死，往往只在一念之间。","待命2",{"_4053":16,"_15":4200,"_4095":37,"_4096":37,"_4127":4201,"_4129":4202,"_4131":645,"_4132":4203},"chr_0029_pograni_16","chr_0029_pograni_sim_assign_work_01","我并未尝试过这种工作……但出于战略考量，或许值得一试。","进驻设施",{"_4053":16,"_15":4205,"_4095":37,"_4096":37,"_4127":4206,"_4129":4207,"_4131":685,"_4132":4208},"chr_0029_pograni_17","chr_0029_pograni_sim_hello_lower_01","你好，管理员，又来巡视了吗？","打招呼1",{"_4053":16,"_15":4210,"_4095":64,"_4096":4112,"_4127":4211,"_4129":4212,"_4131":724,"_4132":4213},"chr_0029_pograni_18","chr_0029_pograni_sim_hello_max_01","向你致敬，管理员。","打招呼2",{"_4053":16,"_15":4215,"_4095":37,"_4096":37,"_4127":4216,"_4129":4217,"_4131":764,"_4132":4218},"chr_0029_pograni_19","chr_0029_pograni_sim_talk_lv01_01","帝江号比我以为的更加巨大，但我熟悉它的各个部分却只花了极短的时间。这大概要归功于建造者赋予它的，那近乎精巧的合理构造。这是一个远大理想的起点，我很期待，管理员。","帝江号闲聊1",{"_4053":16,"_15":4220,"_4095":64,"_4096":4112,"_4127":4221,"_4129":4222,"_4131":803,"_4132":4223},"chr_0029_pograni_20","chr_0029_pograni_sim_talk_lv02_01","集成工业系统确实远超我的想象。借由协议核心，泰拉文明的军工机器将拥有一颗无可匹敌的钢铁心脏，能够不断向这颗星球所有危险的角落输送血液。管理员，你们将会拯救无数人的性命，我可以向你保证。","帝江号闲聊2",{"_4053":16,"_15":4225,"_4095":64,"_4096":4112,"_4127":4226,"_4129":4227,"_4131":874,"_4132":4228},"chr_0029_pograni_21","chr_0029_pograni_sim_talk_lv02_02","终末地的武库工程师着实令人钦佩，竟然能在这样有限的时间内，完成所有人员的武器维护工作……这样的效率即使是在北方前线也称得上是数一数二。不过，他们的负责人为何如此年幼？","帝江号闲聊3",{"_4053":16,"_15":4230,"_4095":64,"_4096":4123,"_4127":4231,"_4129":4232,"_4131":913,"_4132":4233},"chr_0029_pograni_22","chr_0029_pograni_sim_talk_max_01","我看过小道奇教官为你们拟定的训练方案，十分务实也足够循序渐进。我并没有改动的打算，只是会根据经验额外追加一两场小小试炼……但想必是难不倒你的，管理员。","帝江号闲聊4",{"_4053":16,"_15":4235,"_4095":64,"_4096":4123,"_4127":4236,"_4129":4237,"_4131":953,"_4132":4238},"chr_0029_pograni_23","chr_0029_pograni_sim_talk_max_02","在你醒来前，我已许久未直接参与过终末地的行动。对我而言，罗德岛、终末地、铁誓军，并无不同。我只是想保护那些值得保护的东西，而这一次，我可以义无反顾。","帝江号闲聊5",{"_4053":16,"_15":4240,"_4095":64,"_4096":4123,"_4127":4241,"_4129":4242,"_4131":992,"_4132":4243},"chr_0029_pograni_24","chr_0029_pograni_sim_talk_max_03","眺望塔卫二总是能给我莫大的鼓舞，足以覆盖整颗卫星的异类被战士们以血肉之躯拦截在北方极光下的方寸之地中。这是铁誓军最伟大的军事成就之一，也是我们值得被委以文明延续之重任的铁证。","帝江号闲聊6",{"_4053":16,"_15":4245,"_4095":37,"_4096":37,"_4127":4246,"_4129":4247,"_4131":62,"_4132":4248},"chr_0029_pograni_25","chr_0029_pograni_sim_gift_give_01","这是我在北方意外得到的……也许对你有用，管理员。","赠送礼物",{"_4053":16,"_15":4250,"_4095":37,"_4096":37,"_4127":4251,"_4129":4252,"_4131":1070,"_4132":4253},"chr_0029_pograni_26","chr_0029_pograni_sim_gift_recv_01","感谢你的馈赠，管理员。这对我来说亦是一种嘉奖……请收下这个吧，就当是我的回礼。","接收礼物",{"_4053":16,"_15":4255,"_4095":37,"_4096":37,"_4127":4256,"_4129":4257,"_4131":1110,"_4132":4258},"chr_0029_pograni_27","chr_0029_pograni_mono_self_line01","离开罗德岛后，我最先落脚的地方是工团的工业母舰。出于一些原因，我想见证某一段过往在这片土地缔造出的结果。看到那座顽强的城市时，我确实深受触动。如果乌萨斯人的后裔能以另一个面貌赢得属于他们的荣誉，那么，赫尔森也不应该再犹豫下去。","信赖对话1",{"_4053":16,"_15":4260,"_4095":64,"_4096":4112,"_4127":4261,"_4129":4262,"_4131":1149,"_4132":4263},"chr_0029_pograni_28","chr_0029_pograni_mono_self_line02","铁誓军的军旅生活教会我三件事。第一，信任你的战友；第二，不要轻易退缩；第三，不可怀揣侥幸。在那里，违背上述任意一条都可能为自身或是战友带来不幸。","信赖对话2",{"_4053":16,"_15":4265,"_4095":64,"_4096":4112,"_4127":4266,"_4129":4267,"_4131":1189,"_4132":4268},"chr_0029_pograni_29","chr_0029_pograni_mono_self_line03","我在铁誓军重组并训练了盾卫。这个想法诞生自我抵达堡垒群的前夜。厚重的建筑群依山而建，萨米的黑森林像深绿色的火焰，沿着河流燃烧。无数人的墓碑如同城墙排列，挡住来自北方的敌人。铁誓军是文明环带的一面盾，而我又为铁誓军带去了另一面。我相信，这些战士坚不可摧。","信赖对话3",{"_4053":16,"_15":4270,"_4095":64,"_4096":4123,"_4127":4271,"_4129":4272,"_4131":56,"_4132":4273},"chr_0029_pograni_30","chr_0029_pograni_mono_self_line04","赫拉格更像是我的良师益友。我饱尝了他的遗憾与愧疚，也学习了他的想法与技能。这里没有乌萨斯的赫拉格将军，这里只有罗德岛和终末地的赫尔森。偶尔，我庆幸自己了无牵挂。偶尔，我又会感到……孤独。我所保护的东西若是虚指，那和帝国虚伪的荣光并无二致。管理员，我希望……你能成为我的答案。","信赖对话4",{"_4053":16,"_15":4275,"_4095":64,"_4096":4123,"_4127":4276,"_4129":4277,"_4131":1267,"_4132":4278},"chr_0029_pograni_31","chr_0029_pograni_mono_self_line05","我希望管理员你能够实现目标；我希望罗德岛的人们能够回到普通的生活；我希望铁誓军有朝一日铸剑为犁，解甲归田；我希望生命能在这颗古老的星球得以延续。管理员，每当获胜，我都希望能与你们一同庆祝。但哪怕仅有一次的失败到来，我希望你能活下去，以任何方式活下去，那我便不枉此行。","信赖对话5",{"_4053":16,"_15":4280,"_4095":37,"_4096":37,"_4127":4281,"_4129":4282,"_4131":1306,"_4132":4283},"chr_0029_pograni_32","chr_0029_pograni_mono_chat_line01","Z7行动组的年轻人们确实让我印象深刻。他们虽然只接受了简单的军事训练，却凭借个人努力收获了与普通军人同等水平的作战意识……这点尤为可贵。","交谈1",{"_4053":16,"_15":4285,"_4095":37,"_4096":37,"_4127":4286,"_4129":4287,"_4131":117,"_4132":4288},"chr_0029_pograni_33","chr_0029_pograni_mono_chat_line02","我在北方有过很多工作经验。除了指挥官之外，我同时还是军需官和教官。我锻造过武器，为新品种的瘤兽挤奶，甚至亲自酿过一些葡萄酒……","交谈2",{"_4053":16,"_15":4290,"_4095":37,"_4096":37,"_4127":4291,"_4129":4292,"_4131":1384,"_4132":4293},"chr_0029_pograni_34","chr_0029_pograni_mono_chat_line03","什么是军人的荣誉？就算是我，恐怕也没法做出断言。但管理员，倘若有一天你到达北方的要塞，可以去看看铁誓军在那里立下的纪念碑……上面的每一个名字，都曾是一个答案。","交谈3",{"_4053":16,"_15":4295,"_4095":37,"_4096":37,"_4127":4296,"_4129":4297,"_4131":1424,"_4132":4298},"chr_0029_pograni_35","chr_0029_pograni_mono_chat_line04","大司库管理着一座遗产库。“遗产”的定义多种多样，除去铁誓军历代英杰的遗物，还有一些是难以复原的泰拉技术，或是原理未知的前文明发现。我曾被允许挑选一把“遗产”作为己用，但我拒绝了。借用前人荣耀的事，我早已做过一次。此身此世，我应当留下属于自己的荣耀。","交谈4",{"_4053":16,"_15":4300,"_4095":37,"_4096":37,"_4127":4301,"_4129":4302,"_4131":1463,"_4132":4303},"chr_0029_pograni_36","chr_0029_pograni_mono_chat_line05","铁誓军的敌人大部分时候都是天使和锚点，以及超域活动带来的灾害。但极少数情况下，我们会面对一些自身无法理解的现象：巨大的生物痕迹，奇异人类个体的目击报告……这也是我得知管理员苏醒后，立刻申请重回终末地的原因。","交谈5",{"_4053":16,"_15":4305,"_4095":37,"_4096":37,"_4127":4306,"_4129":4307,"_4131":156,"_4132":4308},"chr_0029_pograni_37","chr_0029_pograni_mono_about_line01","北方和很多人的想象并不相同。百年的运营使得铁誓军的堡垒也拥有兴盛的商业和娱乐业，人们在习以为常的战事下孕育了一种朝气蓬勃的生活方式。而堡垒之外，萨米人在那里的黑森林安家，古老的知识和文化得以保留，大篷车来往于堡垒与森林之间。管理员，你应该去一趟北方。那里很美，我会陪着你。","话题：铁誓军",{"_4053":16,"_15":4310,"_4095":37,"_4096":37,"_4127":4311,"_4129":4312,"_4131":1541,"_4132":4313},"chr_0029_pograni_38","chr_0029_pograni_mono_about_line02","工业母舰，这座工团最大的城市如今有很多名字与简称。而我知道一个她在泰拉时的名字——“塞梦珂”。在帝国的暴政下，她曾被沉入了一片大湖。我不清楚乌萨斯为何要捞起她，又为何要把这样一座废城改造成他们在异星的飞地。但至少，这座塔卫二现存最巨大的移动城市，已然成为了无数人的精神象征。","话题：联盟工团",{"_4053":16,"_15":4315,"_4095":37,"_4096":37,"_4127":4316,"_4129":4317,"_4131":41,"_4132":4318},"chr_0029_pograni_39","chr_0029_pograni_mono_about_line03","最初挑选盾卫的时候，我看见的是一群比我还要年轻的战士。第一步，我需要从他们的身上削去锐气，他们应当守卫，而非主动出击；随后，我将战术倾囊相授，令他们成为战线本身；最后一步，让他们掌握活下去的方法……在这件事上，我始终担心自己做得还不够。牺牲不是目的，牺牲是为了阻止更多的牺牲。","话题：盾卫",{"_4053":16,"_15":4320,"_4095":37,"_4096":37,"_4127":4321,"_4129":4322,"_4131":44,"_4132":4323},"chr_0029_pograni_40","chr_0029_pograni_mono_about_line04","我听说过余烬女士的事迹，她是一名可敬的战士。我想管理员应该有所了解，她的长官令她回到南方重组小队，其实是给她一个“回到普通生活”的机会。这是一种意义不大的宽容。能和自己的过去和解的战士，压根就不会走到这一步。","话题：余烬",{"_4053":16,"_15":4325,"_4095":37,"_4096":37,"_4127":4326,"_4129":4327,"_4131":47,"_4132":4328},"chr_0029_pograni_41","chr_0029_pograni_mono_about_line05","萨米人并没传闻中那么排外。的确，他们对外来者常怀戒备，百余年来始终在“祖灵之父”遗留的庇荫下生活，但对尊重萨米习俗的旅人，他们也不吝于救济。独眼巨人曾将萨米的牙齿赠与塞什卡用作其飞空据点的动力源，雪祀也把传承的法术向铁誓军倾囊相授。看得出，萨米人来到塔卫二后也在用自己的方式延续过往的生活。","话题：萨米人",{"_4053":16,"_15":4330,"_4095":37,"_4096":37,"_4127":4331,"_4129":4332,"_4131":50,"_4132":4333},"chr_0029_pograni_42","chr_0029_pograni_explore_point_common_01","那或许是你们需要的东西。","发现资源1",{"_4053":16,"_15":4335,"_4095":37,"_4096":37,"_4127":4336,"_4129":4337,"_4131":232,"_4132":4338},"chr_0029_pograni_43","chr_0029_pograni_explore_point_valub_01","如果不想错过重要的物资，最好留心下那里。","发现资源2",{"_4053":16,"_15":4340,"_4095":37,"_4096":37,"_4127":4341,"_4129":4342,"_4131":1804,"_4132":4343},"chr_0029_pograni_44","chr_0029_pograni_explore_find_locked_01","未知的区域，切记保持队形。","发现未探索区域",{"_4053":16,"_15":4345,"_4095":37,"_4096":37,"_4127":4346,"_4129":4347,"_4131":1844,"_4132":4348},"chr_0029_pograni_45","chr_0029_pograni_explore_find_danger_01","注意提防，那边的敌手不容小觑。","发现强敌",{"_4053":16,"_15":4350,"_4095":37,"_4096":37,"_4127":4351,"_4129":4352,"_4131":270,"_4132":4353},"chr_0029_pograni_46","chr_0029_pograni_interact_mine_valub_01","优质的矿藏……它们将成为我手中的利剑与坚盾。","采集矿物1",{"_4053":16,"_15":4355,"_4095":37,"_4096":37,"_4127":4356,"_4129":4357,"_4131":1922,"_4132":4358},"chr_0029_pograni_47","chr_0029_pograni_interact_mine_valub_echo2_01","群策群力之下，再没有难事。","采集矿物2",{"_4053":16,"_15":4360,"_4095":37,"_4096":37,"_4127":4361,"_4129":4362,"_4131":72,"_4132":4363},"chr_0029_pograni_48","chr_0029_pograni_interact_treasure_valub_01","是十分珍贵的物资储备，足以影响战局。","打开储藏箱",{"_4053":16,"_15":4365,"_4095":37,"_4096":37,"_4127":4366,"_4129":4367,"_4131":60,"_4132":4368},"chr_0029_pograni_49","chr_0029_pograni_interact_etherium_01","获得醚质的战略意义恐怕高于它本身的价值。","获得醚质",{"_4053":16,"_15":4370,"_4095":37,"_4096":37,"_4127":4371,"_4129":4372,"_4131":76,"_4132":4373},"chr_0029_pograni_50","chr_0029_pograni_interact_blight_break_01","不利的因素最好从一开始就解决掉。","消除侵蚀",{"_4053":16,"_15":4375,"_4095":37,"_4096":37,"_4127":4376,"_4129":4377,"_4131":78,"_4132":4378},"chr_0029_pograni_51","chr_0029_pograni_interact_rest_01","每一次的休整都尤为重要。这意味着在下一场战斗来临前，你还有准备的机会。","休整",{"_4053":16,"_15":4380,"_4095":37,"_4096":37,"_4127":4381,"_4129":4382,"_4131":80,"_4132":4383},"chr_0029_pograni_52","chr_0029_pograni_combat_suppuse_using_01","注意恢复，切勿心急。","使用战术物品1",{"_4053":16,"_15":4385,"_4095":37,"_4096":37,"_4127":4386,"_4129":4387,"_4131":82,"_4132":4388},"chr_0029_pograni_53","chr_0029_pograni_combat_suppuse_getheal_01","一时疏忽了。","使用战术物品2",{"_4053":16,"_15":4390,"_4095":37,"_4096":37,"_4127":4391,"_4129":4392,"_4131":84,"_4132":4393},"chr_0029_pograni_54","chr_0029_pograni_combat_remind_danger_01","全军！避让！","危险提醒",{"_4053":16,"_15":4395,"_4095":37,"_4096":37,"_4127":4396,"_4129":4397,"_4131":86,"_4132":4398},"chr_0029_pograni_55","chr_0029_pograni_combat_hurt_lowhp_01","还未到绝境。","负伤",{"_4053":16,"_15":4400,"_4095":37,"_4096":37,"_4127":4401,"_4129":4402,"_4131":384,"_4132":4403},"chr_0029_pograni_56","chr_0029_pograni_combat_dead_01","战场的终点……不该在此……","力竭",{"_4053":16,"_15":4405,"_4095":37,"_4096":37,"_4127":4406,"_4129":4407,"_4131":2308,"_4132":4408},"chr_0029_pograni_57","chr_0029_pograni_combat_remind_praise_01","高明的决策。","小队激励1",{"_4053":16,"_15":4410,"_4095":37,"_4096":37,"_4127":4411,"_4129":4412,"_4131":2347,"_4132":4413},"chr_0029_pograni_58","chr_0029_pograni_combat_remind_praise_02","教科书般的示范。","小队激励2",{"_4053":16,"_15":4415,"_4095":37,"_4096":37,"_4127":4416,"_4129":4417,"_4131":423,"_4132":4418},"chr_0029_pograni_59","chr_0029_pograni_combat_remind_praise_echo2_01","诸位过奖了。","回应激励1",{"_4053":16,"_15":4420,"_4095":37,"_4096":37,"_4127":4421,"_4129":4422,"_4131":74,"_4132":4423},"chr_0029_pograni_60","chr_0029_pograni_combat_remind_praise_echo2_02","你们证明了团队的价值。","回应激励2",{"_4053":16,"_15":4425,"_4095":37,"_4096":37,"_4127":4426,"_4129":4427,"_4131":2495,"_4132":4428},"chr_0029_pograni_61","chr_0029_pograni_combat_intobattle_01","战场从不仁慈。","作战开始1",{"_4053":16,"_15":4430,"_4095":37,"_4096":37,"_4127":4431,"_4129":4432,"_4131":2534,"_4132":4433},"chr_0029_pograni_62","chr_0029_pograni_combat_intobattle_echo2_01","开始接敌。","作战开始2",{"_4053":16,"_15":4435,"_4095":37,"_4096":37,"_4127":4436,"_4129":4437,"_4131":462,"_4132":4438},"chr_0029_pograni_63","chr_0029_pograni_combat_outbattle_nor_01","均在作战计划内。","作战胜利1",{"_4053":16,"_15":4440,"_4095":37,"_4096":37,"_4127":4441,"_4129":4442,"_4131":2612,"_4132":4443},"chr_0029_pograni_64","chr_0029_pograni_combat_outbattle_nor_02","不错的战果。","作战胜利2",{"_4053":16,"_15":4445,"_4095":37,"_4096":37,"_4127":4446,"_4129":4447,"_4131":2652,"_4132":4448},"chr_0029_pograni_65","chr_0029_pograni_combat_outbattle_nor_echo2_01","值得庆祝一番。","作战胜利3",{"_4053":16,"_15":4450,"_4095":37,"_4096":37,"_4127":4451,"_4129":4452,"_4131":500,"_4132":4453},"chr_0029_pograni_66","chr_0029_pograni_combat_outbattle_hard_01","胜利总是代价高昂……珍视你由此得到的，勿忘你为此失去的。","作战胜利4",{"_4053":16,"_15":4455,"_4095":37,"_4096":37,"_4127":4456,"_4129":4457,"_4131":2730,"_4132":4458},"chr_0029_pograni_67","chr_0029_pograni_combat_battle_defeat_01","无需因失败感到耻辱，正视它，然后让它成为你更进一步的垫脚石。","作战失败",{"_4053":16,"_15":4460,"_4095":37,"_4096":3