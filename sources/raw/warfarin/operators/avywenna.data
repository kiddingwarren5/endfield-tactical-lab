38":3904},5832,{"_36":55,"_38":3906},331,{"_36":58,"_38":37},{"_36":60,"_38":3909},1.48469387755102,{"_36":62,"_38":3911},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3931,"_101":64},{"_33":3932},[3933,3935,3937,3939,3941,3943,3945,3947,3948,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968],{"_36":37,"_38":3934},97,{"_36":41,"_38":3936},114.78434672838208,{"_36":44,"_38":3938},114.19587628866006,{"_36":47,"_38":3940},118.08163265306123,{"_36":50,"_38":3942},159.00000000000045,{"_36":39,"_38":3944},5888,{"_36":55,"_38":3946},334,{"_36":58,"_38":37},{"_36":60,"_38":3949},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3970,"_101":64},{"_33":3971},[3972,3974,3976,3978,3980,3982,3984,3986,3987,3989,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008],{"_36":37,"_38":3973},98,{"_36":41,"_38":3975},115.84578161161372,{"_36":44,"_38":3977},115.27319587628892,{"_36":47,"_38":3979},119.1645276667368,{"_36":50,"_38":3981},160.50000000000045,{"_36":39,"_38":3983},5944,{"_36":55,"_38":3985},337,{"_36":58,"_38":37},{"_36":60,"_38":3988},1.49489795918367,{"_36":62,"_38":3990},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4010,"_101":64},{"_33":4011},[4012,4014,4016,4018,4020,4022,4024,4026,4027,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047],{"_36":37,"_38":4013},99,{"_36":41,"_38":4015},116.90721649484536,{"_36":44,"_38":4017},116.3505154639178,{"_36":47,"_38":4019},120.24742268041238,{"_36":50,"_38":4021},162.00000000000045,{"_36":39,"_38":4023},6000,{"_36":55,"_38":4025},340,{"_36":58,"_38":37},{"_36":60,"_38":4028},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":58},{"_36":95,"_38":58},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4050,4051],"tag_07","tag_20","charId","charIllustInitPos",{"_4055":70,"_4056":4057},"x","y",-100,"charPassiveUIPrefabName","","charTypeId","Pulse","cvName",{"_4064":4065,"_4066":4067,"_4068":4069,"_4070":4071,"_4052":16},"ChiCVName","蔡娜","EngCVName","Sheena May","JapCVName","喜多村英梨","KorCVName","姜恩爱","defaultWeaponId","wpn_lance_0009","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Avywenna","mainAttrType","phoneticName","profession","profileRecord",[4085,4096,4101,4106,4112,4117],{"_4052":16,"_15":4086,"_4087":4088,"_4089":4090,"_4091":39,"_4092":4093,"_4094":37,"_4095":37},"chr_0012_avywen_1","recordDesc","【代号】艾维文娜\n【性别】女\n【身份认证】环塔商会\n【生日】10月25日\n【种族】卡特斯\n【矿石病感染情况】\n参照医学检测报告，确认为非感染者。\n\n【综合体检测试】\n生理强度：标准\n作战技巧：优良\n战术规划：标准\n源石技艺适应性：标准","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4052":16,"_15":4097,"_4087":4098,"_4089":4099,"_4091":55,"_4092":4100,"_4094":37,"_4095":37},"chr_0012_avywen_2","艾维文娜，武装信使，现隶属于终末地工业特种技术部门。\n\n一个同时持有胡萝卜和大棒的人——这就是我对艾维文娜的评价。对于她意图之事，她将以甜蜜的态度和残酷的手段达成，当然，如果后者显露于众，对她而言将是一种小小的失误。她坦承：“在荒地上行动，即便是最善良的人也要扮出最凶恶的样子。”稚童的心性，打手的行动，骗子的周旋——我们不知道哪一面是真正的艾维文娜，这也是她能够出色地履行她的职责的原因之一。\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4052":16,"_15":4102,"_4087":4103,"_4089":4104,"_4091":58,"_4092":4105,"_4094":37,"_4095":37},"chr_0012_avywen_3","同在特种技术部门担任信使一职，艾维文娜干员给人的感觉却与洁尔佩塔干员截然不同。后者以毫无保留的甜美和宜人著称于终末地，前者则似乎将相处之道视为专业加以经营。\n与艾维文娜干员接触久了，才会注意到她身上一些古怪的点。例如，她在一些小的聚会和私下相处时经常侃侃而谈。大家在事后回想起时，却很少能够捕捉到她提过的有关自己的真实信息。但人们总是控制不住地与她交心，因为她是一个极佳的倾听者，总能以和善的提问和恰到好处的总结，将谈话带往她想要的方向。\n她个人对此解释的理由是，她来自于合金萝卜自由市一个庞大的卡特斯家族，在与家人们的群居生活中，最重要的品质就是耐心。这一事实，确实如她所言，在合金萝卜自由市的人口数据库里搜索“艾维文娜”时，跳出了八十多个以此冠姓的人名。\n当她简要地抛出了有关自己的一点情报作为诱饵之后，她会毫无痕迹地让对话者以和盘托出来偿还。转瞬间，她便已对所有人的出身及往来了如指掌。而她又会狡黠地辩称，这是她与人打交道为业的信使生涯中保留的职业习惯。\n值得一提的是，她的这些神秘所为并不惹人厌烦，而是吸引大家更进一步向她靠近的筹码。她的助力，显然也让终末地在处理一些复杂而微妙的在地事务时锦上添花。她擅长周旋于纷争与纠葛之间，并总能全身而退，就像穿行于合金萝卜自由市四通八达的矿洞中一样。主宰方向的人，从来不会迷路。","CN_03","档案资料·一",{"_4052":16,"_15":4107,"_4087":4108,"_4089":4109,"_4091":64,"_4092":4110,"_4094":64,"_4095":4111},"chr_0012_avywen_4","【山恩伍德镇邮件集散处人事招聘记录】\n那个卡特斯女人走进门来的时候我就发现，她的衣摆沾着一大块红色的污渍，可能有两到三天左右的时间，已经开始发黑了。我马上向她询问是否需要帮助，她回答只要一份工作就可以，原来她是看到了门外的招人告示，临时起意而来的。\n“是番茄酱啦，”她说，“不要在意哦。”\n“那小姐您的吃相有够糟糕的。”我讪讪地笑。\n我不擅长与美丽的女人说话，而山恩伍德镇也没有给我提供充足的机会锻炼，这里离最近的环塔商会城市有三百六十八公里，离开拓区另一个驿站有一百一十公里，截止到现在——下午三点多了——我看到最让人心动的异性是一头在店门口外面找草吃的驮兽。这个女人显然是从距此三百六十八公里的方向过来，奔着一百一十公里远的方向去的。非常有趣的选择，和大部分人相反。\n前天晚上，二十三公里外发生了一场与裂地者有关的斗殴事故。六人械斗，五伤，一逃逸。次日，开拓区工团安全局站点发来通信，要我们注意独身在外的旅行者。\n“你们在外面贴的告示说要招一个邮件派送员。”卡特斯女人用大拇指朝背后指了指。\n“啊，是的，是的，两个月前你的前任退休了。”\n“我的？你的意思是我已经拿到这份工作了？”\n“你会驾驶载具吗？几种？会就行，不用算上有证的那些。”\n“包括卡车在内的话，六种吧。”\n“棒！”我说，“你应聘成功了。明天开始工作吧！另外，我要先请你出示身份证明并填写这个表格。只是留个档而已。”\n我把纸和笔从小窗口里向她挪过去。她不假思索地填写完毕，将纸张递还给我，对我大大地微笑了一下。多么善解人意、和蔼，又配合工作的卡特斯女士！\n她娴熟地向我提问，以主人的姿态布置起了自己生活的方方面面：“你们这里后面可以停车吗？就是铁门后面那块长了很多杂草的荒地。可以，嗯哼，没问题。你这里有源石电桩吗？我要修下车，抛锚了。网络的密码是多少？快吗？能看电影吗？噢噢，真不错……你邀请我……去你家？共进晚餐？不是这个意思？和你爷爷莱恩站长？不管怎样，都有点太早了哦，小朋友。没关系的，我晚上就睡车里，习惯了。”\n她对我眨了眨眼，施施然打开门出去了。\n我这才想起看她填写的表格。等等！\n姓名：秘密，或者六万折金票\n年龄：想得美\n联系地址：很多人都想知道\n家庭情况：复杂\n工作经历：职业旅人\n健康信息：基本无害\n…………","CN_04","档案资料·二",300,{"_4052":16,"_15":4113,"_4087":4114,"_4089":4115,"_4091":66,"_4092":4116,"_4094":64,"_4095":4111},"chr_0012_avywen_5","【一封来自站长莱恩的推荐信】\n马马马：\n看在你我老友交情的份上，当你读到这封推荐信时，务必把你们面前这个女人从我的站点里弄走。我选择到山恩伍德这个羽兽不拉屎的地方退休，是为了颐养天年的，不是为了应付那些隔三岔五就提着刀上门来寻仇的商会家伙的。没错，这一年这破地方，可真是热闹非凡！光拉人的救护车就给镇上的源石充电站带来了不少收入。我不知道艾维文娜哪里得罪过他们，但她显然也没给他们什么好处。\n我把她赶到你们那儿的原因很简单，她这样的雷姆必拓矿工小姐根本不会挤奶。瘤兽被她打铁的手劲撵得嗷嗷叫，现在它们都害怕得要死。除此之外，她将邮件系统整理得很好，周全，现在山恩伍德这些幸运的混蛋们都能在节日前准时收到他们的礼物了！而我甚至没有给她几个子儿作为工资！从她的吃穿用度作风，和那套格外讲究的户外装备来看，她在环带的上一份安保工作——我猜是在史隆安保，合金萝卜自由市最大的家族企业之一——想必有过不菲的收入。所以，选择到山恩伍德镇来隐居，我判定她有严重的精神问题。\n哦，还有一点。她对终末地的管理员有着极其浓厚的兴趣，自从她发现我藏在抽屉里的退休证明以后，她每天都给我们做晚饭，以求换取我口中关于管理员的只言片语，真是毛骨悚然。说实话，我认识管理员，那都是上辈子的事了。这话光在你我之间说说就算了——从褒义的角度来看：疯子只有另一个疯子能应付得来。\n祝好。\n\n莱恩\n\n【一封回信】\n莱恩：\n候选人艾维文娜小姐已经顺利通过我们的一系列测试，成为正式干员，感谢您的推荐，我们将向您寄送终末地奖励物资箱一份。\n…………\n出于安全角度考虑，我想向您咨询艾维文娜小姐随身携带的那杆长柄武器的来由。她对此爱之如命，却只肯交代那是来自她祖母的传承。这位干员的武装程度显然超过我们的想象，每次在安检处，她都要花五六分钟的时间才能完全解除身上的全部武器，包括鞋底里隐藏的刀片等。你知道她背后那两条长绑带其实并非出于装饰作用吗？在安全训练项目中我们领教了这一点。同时掌握着胡萝卜和大棒，这是一种独特的本事。\n作为一位来自雷姆必拓居住带的干员，艾维文娜小姐以柔软的身段展示出了强力的攻击性，这让我们对如今该环带地区的民俗生态保存程度怀有积极的观感。\n\n马丁·马文·马伦","CN_05","档案资料·三",{"_4052":16,"_15":4118,"_4087":4119,"_4089":4120,"_4091":68,"_4092":4121,"_4094":64,"_4095":4122},"chr_0012_avywen_6","【一封私人信件】\n兰珀：\n宝贝，你已经走到哪里了？曾祖母、姨婆、姨妈和你姐姐这周家宴才从我这里得知你辞职离家的消息，她们追问得太细，再详尽的谎言都抵御不住这么强烈的攻势。你离开家的消息就像我们预料到的那样炸了锅。往好处看，我还是为你保守了三个周末。所以，这三周以来，你走到哪儿了？\n上个月我们在阿利莱餐馆的争吵为彼此留下了不太好的记忆。虽然妈妈还是很不支持你的选择，但当我回到家里坐下时，突然回想起我年轻时候计划好的一次出行。当时，打包好的行囊已经在墙边放好，我几乎马上可以背起来走出门去，到遥远的地方去。就在那时我听到了你的声音。你坐在宝宝餐椅上抓着刀叉看着我微笑，于是我留了下来。我提起这件事，是为了告诉你，你离开家的念头其实是一种遗传下来的习惯。\n尽管你的曾祖母常常挂在嘴边，但我们家族的祖辈最初跨过星门，来到塔卫二时的场景，已经淡化成了墙上的霉斑：那些排列在天边的巨大卡车组成了一道黑压压的长城，在断绝事故的前一刻都依然行进不休。这也是我们积累下原始财富，在合金萝卜城建立起物流生意的基础。但随着逐矿而居的日子日益变长，我们的族人似乎已经很久没有出发了。\n路上要小心你的敌人。你在商会的工作并不低调，不断有人找上门来。不过，他们谁也别想欺负我的宝贝女儿。\n家里那边，我会为你解释的。记得经常给我们分享沿途的风景。\n\n妈妈\n\n【一封私人信件】\n妈妈：\n在荒野里找到有网络的地方可不太容易。但是，一个人的旅程如我梦中的那般，非常甜美。\n我离开家以后立即拜访了新蓝卡坞。他们似乎想要通过情景重现疗法来治愈创伤，所以不太有人涉足恐怖片的题材，不免令人失望。这里老下雨，我不喜欢。\n再往前走就是北方走廊了，我即将到达环带的边境。昨天，我在旅馆里听到一个画家说，出了环带诸城，才会亲眼见到冠绝一切的自然风光。我打算去北方旧开拓区逛逛，那边好像有一些星门崩溃前的废墟，是曾祖母经常提到的那种东西吧？不要担心我的危险，我一路上都跟着一队众生长地的游人行动，等信号好了，我就把骑在驮兽身上的照片发给你。\n最近，有一个人引起了我的注意。每当我找到一个落脚的地方，与那里的人稍事接触后，就能听到他们说起一个叫“管理员”的人。刚巧，我选择的漫游路线，和这个“管理员”当时北进的方向基本一致呢。难道塔卫二上还有比我更在行的旅行家？\n\n兰珀","CN_06","档案资料·四",1500,"profileVoice",[4125,4133,4137,4141,4145,4149,4153,4158,4163,4168,4173,4178,4183,4188,4193,4198,4203,4208,4213,4218,4223,4228,4233,4238,4243,4248,4253,4258,4263,4268,4273,4278,4283,4288,4293,4298,4303,4308,4313,4318,4323,4328,4333,4338,4343,4348,4353,4358,4363,4368,4373,4378,4383,4388,4393,4398,4403,4408,4413,4418,4423,4428,4433,4438,4443,4448,4453,4458,4463,4468,4473,4478,4483,4488,4493,4498,4503,4508,4513,4518],{"_4052":16,"_15":4086,"_4094":37,"_4095":37,"_4126":4127,"_4128":4129,"_4130":39,"_4131":4132},"voId","chr_0012_avywen_chrbark_squad_01","voiceDesc","嗯？我刚好也找到了你呢，管理员。","voiceIndex","voiceTitle","行动准备1",{"_4052":16,"_15":4097,"_4094":37,"_4095":37,"_4126":4134,"_4128":4135,"_4130":55,"_4131":4136},"chr_0012_avywen_chrbark_squad_02","嘘，别眨眼，否则会跟丢我哦。","行动准备2",{"_4052":16,"_15":4102,"_4094":37,"_4095":37,"_4126":4138,"_4128":4139,"_4130":58,"_4131":4140},"chr_0012_avywen_chrbark_join_01","你果然信任我——不惜花费这么高昂的费用。","编入队伍1",{"_4052":16,"_15":4107,"_4094":37,"_4095":37,"_4126":4142,"_4128":4143,"_4130":64,"_4131":4144},"chr_0012_avywen_chrbark_join_02","能把我排得再前一点吗？只是不喜欢站在后面，离你有点远呢！","编入队伍2",{"_4052":16,"_15":4113,"_4094":37,"_4095":37,"_4126":4146,"_4128":4147,"_4130":66,"_4131":4148},"chr_0012_avywen_chrbark_weap_01","用我们家族的一句祖训来说，武器就是我们身体的一部分，我猜，是弥补身高的意思吧。","更换武器",{"_4052":16,"_15":4118,"_4094":37,"_4095":37,"_4126":4150,"_4128":4151,"_4130":68,"_4131":4152},"chr_0012_avywen_chrbark_gear_01","在这一点上，我从来不会对自己吝啬。决定远大路途的除了目标，还有一双好鞋子。","更换装备",{"_4052":16,"_15":4154,"_4094":37,"_4095":37,"_4126":4155,"_4128":4156,"_4130":70,"_4131":4157},"chr_0012_avywen_7","chr_0012_avywen_chrup_skill_01","回头一看，竟然走了这么多的路！距离家、距离那些日子，已经好远好远了呢。","激活天赋阵列",{"_4052":16,"_15":4159,"_4094":37,"_4095":37,"_4126":4160,"_4128":4161,"_4130":88,"_4131":4162},"chr_0012_avywen_8","chr_0012_avywen_chrup_level_01","这些作战过程会被外人看到吗？有些家伙只认识我的长枪，最好别让他们知道我的名字……","观看作战记录",{"_4052":16,"_15":4164,"_4094":55,"_4095":39,"_4126":4165,"_4128":4166,"_4130":90,"_4131":4167},"chr_0012_avywen_9","chr_0012_avywen_chrup_promt01_01","小事。我可是专业人士。","精英化晋升1",{"_4052":16,"_15":4169,"_4094":55,"_4095":55,"_4126":4170,"_4128":4171,"_4130":410,"_4131":4172},"chr_0012_avywen_10","chr_0012_avywen_chrup_promt02_01","嗯哼，我就知道，你迟早会依赖这种感觉的。所以，下一个非我不可的任务，是什么？","精英化晋升2",{"_4052":16,"_15":4174,"_4094":55,"_4095":58,"_4126":4175,"_4128":4176,"_4130":100,"_4131":4177},"chr_0012_avywen_11","chr_0012_avywen_chrup_promt03_01","既然于公于私都合情合理，稍微往私人的方面想一想，也没问题吧？……不要脸红嘛！我知道你的意思，我当然知道。","精英化晋升3",{"_4052":16,"_15":4179,"_4094":55,"_4095":64,"_4126":4180,"_4128":4181,"_4130":95,"_4131":4182},"chr_0012_avywen_12","chr_0012_avywen_chrup_promt04_01","我小时候在一个大家族里，哪怕是吃饭睡觉，都要和弟弟妹妹们争个先后。所以，管理员，保持在前列对我而言并不是难事。作为交换，你也要……常常在第一时间想起我哦。","精英化晋升4",{"_4052":16,"_15":4184,"_4094":37,"_4095":37,"_4126":4185,"_4128":4186,"_4130":527,"_4131":4187},"chr_0012_avywen_13","chr_0012_avywen_introduce_01","终于见到本尊了，大名鼎鼎的管理员。我在来的路上，收集了不少关于你的传言哦。唔？要说哪条传言更接近你本人嘛……这样吧，你对我还一无所知，这不能算作是等价交易。待我告诉你一个我的秘密，你再告诉我，你的某一面是什么样子。就这么说好了哦？","干员报到",{"_4052":16,"_15":4189,"_4094":37,"_4095":37,"_4126":4190,"_4128":4191,"_4130":566,"_4131":4192},"chr_0012_avywen_14","chr_0012_avywen_mono_switch_01","朝哪个方向去？","待命1",{"_4052":16,"_15":4194,"_4094":37,"_4095":37,"_4126":4195,"_4128":4196,"_4130":97,"_4131":4197},"chr_0012_avywen_15","chr_0012_avywen_mono_switch_02","我这个角度好看么？","待命2",{"_4052":16,"_15":4199,"_4094":37,"_4095":37,"_4126":4200,"_4128":4201,"_4130":644,"_4131":4202},"chr_0012_avywen_16","chr_0012_avywen_sim_assign_work_01","即刻启程。","进驻设施",{"_4052":16,"_15":4204,"_4094":37,"_4095":37,"_4126":4205,"_4128":4206,"_4130":684,"_4131":4207},"chr_0012_avywen_17","chr_0012_avywen_sim_hello_lower_01","是你呀，管理员，要去哪儿？","打招呼1",{"_4052":16,"_15":4209,"_4094":64,"_4095":4111,"_4126":4210,"_4128":4211,"_4130":723,"_4131":4212},"chr_0012_avywen_18","chr_0012_avywen_sim_hello_max_01","你好啊，管理员，没有在躲着我吧？","打招呼2",{"_4052":16,"_15":4214,"_4094":37,"_4095":37,"_4126":4215,"_4128":4216,"_4130":763,"_4131":4217},"chr_0012_avywen_19","chr_0012_avywen_sim_talk_lv01_01","管理员，又见面了，你还像五分钟前那么可爱呢。","帝江号闲聊1",{"_4052":16,"_15":4219,"_4094":64,"_4095":4111,"_4126":4220,"_4128":4221,"_4130":802,"_4131":4222},"chr_0012_avywen_20","chr_0012_avywen_sim_talk_lv02_01","管理员，这艘帝江号是你的心血？真厉害，光是在天上漂一会儿，就走完了我几年的路途！","帝江号闲聊2",{"_4052":16,"_15":4224,"_4094":64,"_4095":4111,"_4126":4225,"_4128":4226,"_4130":872,"_4131":4227},"chr_0012_avywen_21","chr_0012_avywen_sim_talk_lv02_02","你脸上沾着的是什么？不对，在右边……哈哈，逗你的。不常见到你这么迷茫的样子呢！","帝江号闲聊3",{"_4052":16,"_15":4229,"_4094":64,"_4095":4122,"_4126":4230,"_4128":4231,"_4130":911,"_4131":4232},"chr_0012_avywen_22","chr_0012_avywen_sim_talk_max_01","站在舰桥上才感受到，塔卫二是一颗大圆球。这样的话，不论往哪里走，都会重逢呢。","帝江号闲聊4",{"_4052":16,"_15":4234,"_4094":64,"_4095":4122,"_4126":4235,"_4128":4236,"_4130":951,"_4131":4237},"chr_0012_avywen_23","chr_0012_avywen_sim_talk_max_02","我马上又要到地面上去旅行啦，要给你带点儿什么回来？快想想，我走得很急哦！","帝江号闲聊5",{"_4052":16,"_15":4239,"_4094":64,"_4095":4122,"_4126":4240,"_4128":4241,"_4130":989,"_4131":4242},"chr_0012_avywen_24","chr_0012_avywen_sim_talk_max_03","昨晚的恐怖电影没有吓着你吧？……看来还是没有找到一部能挑战到我们胆量的片子！唔，那么，下次再叫上你。","帝江号闲聊6",{"_4052":16,"_15":4244,"_4094":37,"_4095":37,"_4126":4245,"_4128":4246,"_4130":62,"_4131":4247},"chr_0012_avywen_25","chr_0012_avywen_sim_gift_give_01","这可是我专门从下面给你带回来的哦，找得很辛苦！看到它，有没有再想起点儿什么？","赠送礼物",{"_4052":16,"_15":4249,"_4094":37,"_4095":37,"_4126":4250,"_4128":4251,"_4130":1067,"_4131":4252},"chr_0012_avywen_26","chr_0012_avywen_sim_gift_recv_01","我这么漂亮的女孩子，当然收到过很多礼物啦！但你这一份，和别的那些完全不一样哦。","接收礼物",{"_4052":16,"_15":4254,"_4094":37,"_4095":37,"_4126":4255,"_4128":4256,"_4130":1107,"_4131":4257},"chr_0012_avywen_27","chr_0012_avywen_mono_self_line01","人心可是很复杂的。但是对于我来说呀，从前并不需要理解这些。做信使的时候，将邮件点对点送到就可以了，要是强行介入其中，反而会让自己……算了，具体的嘛，下一次再告诉你。","信赖对话1",{"_4052":16,"_15":4259,"_4094":64,"_4095":4111,"_4126":4260,"_4128":4261,"_4130":1146,"_4131":4262},"chr_0012_avywen_28","chr_0012_avywen_mono_self_line02","我以前那份工作的薪水——和在这里的酬劳比起来，应该算是天价吧！哈哈哈，但是，我们家族的人从来不做让自己吃亏的打算，所以，你知道弥补了那个落差的，是什么。你知道的，你只是……害羞而已。","信赖对话2",{"_4052":16,"_15":4264,"_4094":64,"_4095":4111,"_4126":4265,"_4128":4266,"_4130":1186,"_4131":4267},"chr_0012_avywen_29","chr_0012_avywen_mono_self_line03","我从环带一路过来，在北方旧开拓区的废墟底下熬过极冻，在众生长地的牧棚里睡过白夜，见过塞什卡人那艘游荡在空中的船，听过铁誓军堡垒外经久不息的雨。管理员，最后呀，我听说那些地方，都回荡着你的名字。","信赖对话3",{"_4052":16,"_15":4269,"_4094":64,"_4095":4122,"_4126":4270,"_4128":4271,"_4130":56,"_4131":4272},"chr_0012_avywen_30","chr_0012_avywen_mono_self_line04","嗯，就叫我兰珀吧，“艾维文娜”其实是我们的族姓。嘿，别笑，这对我来说，可是很重要的正事——这是我托付给你的一个秘密。别声张，我可不想让那些坏人顺着我找上你来，除非……你也愿意保护我？","信赖对话4",{"_4052":16,"_15":4274,"_4094":64,"_4095":4122,"_4126":4275,"_4128":4276,"_4130":1264,"_4131":4277},"chr_0012_avywen_31","chr_0012_avywen_mono_self_line05","管理员，塔卫二很大，你究竟去过多少地方？或者……你还记得多少地方？……唔，真希望你能早日都想起来。这样，我们之间，就可以再多一些共同的记忆了。","信赖对话5",{"_4052":16,"_15":4279,"_4094":37,"_4095":37,"_4126":4280,"_4128":4281,"_4130":1303,"_4131":4282},"chr_0012_avywen_32","chr_0012_avywen_mono_chat_line01","我的家族在环带的城市里，祖祖辈辈都是信使。管理员，你的家族是什么样的？","交谈1",{"_4052":16,"_15":4284,"_4094":37,"_4095":37,"_4126":4285,"_4128":4286,"_4130":117,"_4131":4287},"chr_0012_avywen_33","chr_0012_avywen_mono_chat_line02","欢迎来到我的“秘密小窝”——想不到吧？虽然不怎么回来，但我喜欢把家里整得舒舒服服的。旅行的人，最需要的反而是一个可以回去的地方哦。","交谈2",{"_4052":16,"_15":4289,"_4094":37,"_4095":37,"_4126":4290,"_4128":4291,"_4130":1381,"_4131":4292},"chr_0012_avywen_34","chr_0012_avywen_mono_chat_line03","信使要护送许多秘密，每一个秘密都有昂贵的价格，但比它们更昂贵的，是……我的守口如瓶。","交谈3",{"_4052":16,"_15":4294,"_4094":37,"_4095":37,"_4126":4295,"_4128":4296,"_4130":1421,"_4131":4297},"chr_0012_avywen_35","chr_0012_avywen_mono_chat_line04","没有人喜欢被人拒绝……所以，能好好说话就能解决的事儿，我当然不想动手啦。不过，我也不喜欢被人拒绝哦。","交谈4",{"_4052":16,"_15":4299,"_4094":37,"_4095":37,"_4126":4300,"_4128":4301,"_4130":156,"_4131":4302},"chr_0012_avywen_36","chr_0012_avywen_mono_chat_line05","那个莱恩站长，你还记得么？就是他推荐我到终末地来工作的。那个老头子，几个月里都没给过我一个好脸色。呵呵，他说，要把我这个“灾星”送到你们这儿来。不过，管理员，我听说他是荣誉退休员工，大家送别他的时候，至少有十好几号人眼泪汪汪呢。他一定不会害你们的，对吧？","交谈5",{"_4052":16,"_15":4304,"_4094":37,"_4095":37,"_4126":4305,"_4128":4306,"_4130":1499,"_4131":4307},"chr_0012_avywen_37","chr_0012_avywen_mono_about_line01","终末地，现在已经是我除了从小生活的合金萝卜城以外，停留时间最长的地方了。也许，我又开始习惯定居的生活了？","话题：终末地",{"_4052":16,"_15":4309,"_4094":37,"_4095":37,"_4126":4310,"_4128":4311,"_4130":1538,"_4131":4312},"chr_0012_avywen_38","chr_0012_avywen_mono_about_line02","我家族里的先人在跨越星门的时期都在担任卡车司机。一辆辆巨大的卡车压着天际线的边缘行进，组成了一道辉煌的长城。从那以后，我的曾祖母、祖母、母亲……反正她们全都在环带的史隆安保公司工作！当我决定辞职时，她们……嗯哼，你知道，我扛住了多少压力，才最终站在这儿，站在你面前的。","话题：家族事业",{"_4052":16,"_15":4314,"_4094":37,"_4095":37,"_4126":4315,"_4128":4316,"_4130":41,"_4131":4317},"chr_0012_avywen_39","chr_0012_avywen_mono_about_line03","我的衣服，都是兼顾实用和美观的设计！长期在野外活动，只有两条原则：多往身上绑，少管路边事。","话题：服装",{"_4052":16,"_15":4319,"_4094":37,"_4095":37,"_4126":4320,"_4128":4321,"_4130":44,"_4131":4322},"chr_0012_avywen_40","chr_0012_avywen_mono_about_line04","管理员，没想到你竟然没有造访过合金萝卜城！事先声明，我没有在自吹自擂——整个塔卫二，我待过不少地方，最有人情味的，还是我们合金萝卜城大大小小的矿洞。那儿的孩子们，都是在精巧的人情关系和七嘴八舌的热闹气氛里长大的哦！我们那里常说：没有什么比大钻头更坚硬，除了我们的友谊。","话题：合金萝卜城",{"_4052":16,"_15":4324,"_4094":37,"_4095":37,"_4126":4325,"_4128":4326,"_4130":47,"_4131":4327},"chr_0012_avywen_41","chr_0012_avywen_explore_point_common_01","指针在跳动，附近也许有好东西。","发现资源1",{"_4052":16,"_15":4329,"_4094":37,"_4095":37,"_4126":4330,"_4128":4331,"_4130":50,"_4131":4332},"chr_0012_avywen_42","chr_0012_avywen_explore_point_valub_01","跟我来，上次路过这儿，我做过宝藏的标记！","发现资源2",{"_4052":16,"_15":4334,"_4094":37,"_4095":37,"_4126":4335,"_4128":4336,"_4130":232,"_4131":4337},"chr_0012_avywen_43","chr_0012_avywen_explore_find_locked_01","这附近竟然还有连我都没去过的地方？","发现未探索区域",{"_4052":16,"_15":4339,"_4094":37,"_4095":37,"_4126":4340,"_4128":4341,"_4130":1801,"_4131":4342},"chr_0012_avywen_44","chr_0012_avywen_explore_find_danger_01","那个家伙，似乎回绝了谈判的可能哦。","发现强敌",{"_4052":16,"_15":4344,"_4094":37,"_4095":37,"_41