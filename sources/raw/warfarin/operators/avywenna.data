5,"_8148":8149,"_8153":8154,"_8157":8158,"_7613":8162,"_8167":8168,"_8171":8172,"_8176":8177,"_8181":8182,"_8185":8186,"_8190":8191,"_7696":8194,"_8199":8200,"_8203":8204,"_8209":8210,"_7702":8213,"_8218":8219,"_8222":8223,"_7720":8227,"_8232":8233,"_8236":8237,"_7727":8241,"_8246":8247,"_8252":8253,"_7751":8257,"_8262":8263,"_8267":8268,"_8272":8273,"_8277":8278,"_7758":8282,"_8286":8287,"_8291":8292,"_8296":8297,"_8300":8301,"_8306":8307,"_8311":8312,"_7788":8316,"_8321":8322,"_8326":8327,"_8329":8330,"_8333":8334,"_8338":8339,"_8342":8343,"_8348":8349,"_8352":8353,"_8357":8358,"_8362":8363,"_7805":8367,"_8371":8372,"_8374":8375,"_7825":8379,"_8383":8384,"_8388":8389,"_8393":8394,"_8398":8399,"_8402":8403,"_8407":8408,"_7625":8413,"_7664":8417,"_8422":8423,"_8427":8428,"_8432":8433,"_7851":8437,"_8442":8443,"_8445":8446,"_8449":8450,"_8453":8454,"_8458":8459,"_8463":8464,"_8467":8468,"_8472":8473,"_7891":8477,"_8481":8482,"_8486":8487,"_8491":8492,"_8496":8497,"_8500":8501,"_8504":8505,"_8509":8510,"_8514":8515,"_8518":8519,"_8524":8525,"_8528":8529,"_8532":8533,"_8537":8538,"_8541":8542,"_8545":8546,"_8549":8550,"_8555":8556,"_8560":8561,"_8565":8566,"_8570":8571,"_8575":8576,"_8580":8581,"_8585":8586,"_8590":8591,"_8595":8596,"_8600":8601,"_8605":8606,"_8610":8611,"_8615":8616,"_8620":8621},"adv.electricFence",{"_4619":8111,"_8112":4059,"_15":8109,"_8113":4059,"_19":8114,"_8115":7681},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4619":8118,"_8112":8119,"_15":8116,"_8113":4059,"_19":8120,"_8115":7734},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4619":8122,"_8112":8123,"_15":7798,"_8113":8124,"_19":8125,"_8115":7863},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4619":8128,"_8112":4059,"_15":8126,"_8113":4059,"_19":8129,"_8115":7681},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4619":8132,"_8112":8133,"_15":8130,"_8113":4059,"_19":8134,"_8115":7681},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4619":8137,"_8112":4059,"_15":8135,"_8113":4059,"_19":8138,"_8115":7681},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4619":8141,"_8112":8142,"_15":8139,"_8113":4059,"_19":8143,"_8115":7775},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4619":8146,"_8112":4059,"_15":8144,"_8113":4059,"_19":8147,"_8115":7681},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4619":8150,"_8112":8151,"_15":8148,"_8113":4059,"_19":8152,"_8115":7681},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4619":8155,"_8112":4059,"_15":8153,"_8113":4059,"_19":8156,"_8115":4059},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4619":8159,"_8112":8160,"_15":8157,"_8113":4059,"_19":8161,"_8115":7734},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4619":8163,"_8112":8164,"_15":7613,"_8113":8165,"_19":8166,"_8115":7863},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4619":8169,"_8112":4059,"_15":8167,"_8113":4059,"_19":8170,"_8115":7681},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4619":8173,"_8112":8174,"_15":8171,"_8113":4059,"_19":8175,"_8115":7681},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4619":8178,"_8112":8179,"_15":8176,"_8113":4059,"_19":8180,"_8115":7681},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4619":8183,"_8112":4059,"_15":8181,"_8113":4059,"_19":8184,"_8115":7708},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4619":8187,"_8112":8188,"_15":8185,"_8113":4059,"_19":8189,"_8115":7681},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4619":8192,"_8112":4059,"_15":8190,"_8113":4059,"_19":8193,"_8115":7708},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4619":8195,"_8112":8196,"_15":7696,"_8113":8197,"_19":8198,"_8115":7775},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4619":8201,"_8112":8196,"_15":8199,"_8113":4059,"_19":8202,"_8115":7775},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4619":8205,"_8112":8206,"_15":8203,"_8113":8207,"_19":8208,"_8115":7708},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4619":8211,"_8112":4059,"_15":8209,"_8113":4059,"_19":8212,"_8115":7708},"持续时间内，受影响的目标暂停行动。","定身",{"_4619":8214,"_8112":8215,"_15":7702,"_8113":8216,"_19":8217,"_8115":7887},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4619":8220,"_8112":8215,"_15":8218,"_8113":4059,"_19":8221,"_8115":7887},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4619":8224,"_8112":4059,"_15":8222,"_8113":8225,"_19":8226,"_8115":4059},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4619":8228,"_8112":8229,"_15":7720,"_8113":8230,"_19":8231,"_8115":7837},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4619":8234,"_8112":8229,"_15":8232,"_8113":4059,"_19":8235,"_8115":7837},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4619":8238,"_8112":8239,"_15":8236,"_8113":4059,"_19":8240,"_8115":7681},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4619":8242,"_8112":8243,"_15":7727,"_8113":8244,"_19":8245,"_8115":7863},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4619":8248,"_8112":8249,"_15":8246,"_8113":8250,"_19":8251,"_8115":7708},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4619":8254,"_8112":8255,"_15":8252,"_8113":4059,"_19":8256,"_8115":7708},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4619":8258,"_8112":8259,"_15":7751,"_8113":8260,"_19":8261,"_8115":7734},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4619":8264,"_8112":4059,"_15":8262,"_8113":8265,"_19":8266,"_8115":7734},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4619":8269,"_8112":8270,"_15":8267,"_8113":4059,"_19":8271,"_8115":7681},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4619":8274,"_8112":8275,"_15":8272,"_8113":4059,"_19":8276,"_8115":7681},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4619":8279,"_8112":8280,"_15":8277,"_8113":4059,"_19":8281,"_8115":7734},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4619":8283,"_8112":8119,"_15":7758,"_8113":8284,"_19":8285,"_8115":7734},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4619":8288,"_8112":4059,"_15":8286,"_8113":8289,"_19":8290,"_8115":7708},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4619":8293,"_8112":8294,"_15":8291,"_8113":4059,"_19":8295,"_8115":7681},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4619":8298,"_8112":4059,"_15":8296,"_8113":4059,"_19":8299,"_8115":4059},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4619":8302,"_8112":8303,"_15":8300,"_8113":8304,"_19":8305,"_8115":7708},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4619":8308,"_8112":8309,"_15":8306,"_8113":4059,"_19":8310,"_8115":7681},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4619":8313,"_8112":4059,"_15":8311,"_8113":8314,"_19":8315,"_8115":7775},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4619":8317,"_8112":8318,"_15":7788,"_8113":8319,"_19":8320,"_8115":7775},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4619":8323,"_8112":8324,"_15":8321,"_8113":4059,"_19":8325,"_8115":7681},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4619":8201,"_8112":8318,"_15":8326,"_8113":4059,"_19":8328,"_8115":7775},"干员受到灼热附着","sys.tacticalItem",{"_4619":8331,"_8112":4059,"_15":8329,"_8113":4059,"_19":8332,"_8115":7681},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4619":8335,"_8112":8336,"_15":8333,"_8113":4059,"_19":8337,"_8115":7775},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4619":8220,"_8112":8340,"_15":8338,"_8113":4059,"_19":8341,"_8115":7887},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4619":8344,"_8112":8345,"_15":8342,"_8113":8346,"_19":8347,"_8115":7708},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4619":8350,"_8112":4059,"_15":8348,"_8113":4059,"_19":8351,"_8115":7708},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4619":8354,"_8112":8355,"_15":8352,"_8113":4059,"_19":8356,"_8115":7863},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4619":8359,"_8112":8360,"_15":8357,"_8113":4059,"_19":8361,"_8115":7887},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4619":8364,"_8112":8365,"_15":8362,"_8113":4059,"_19":8366,"_8115":7708},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4619":8368,"_8112":8369,"_15":7805,"_8113":8260,"_19":8370,"_8115":7734},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4619":8118,"_8112":8369,"_15":8371,"_8113":4059,"_19":8373,"_8115":7734},"干员受到冻结","ba.naturalvul",{"_4619":8376,"_8112":8377,"_15":8374,"_8113":4059,"_19":8378,"_8115":7837},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4619":8163,"_8112":8380,"_15":7825,"_8113":8381,"_19":8382,"_8115":7863},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4619":8385,"_8112":8386,"_15":8383,"_8113":4059,"_19":8387,"_8115":7681},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4619":8390,"_8112":8391,"_15":8388,"_8113":4059,"_19":8392,"_8115":7681},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4619":8395,"_8112":8396,"_15":8393,"_8113":4059,"_19":8397,"_8115":7681},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4619":8400,"_8112":4059,"_15":8398,"_8113":4059,"_19":8401,"_8115":7681},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4619":8404,"_8112":4059,"_15":8402,"_8113":8405,"_19":8406,"_8115":4059},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4619":8409,"_8112":8410,"_15":8407,"_8113":8411,"_19":8412,"_8115":7708},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4619":8414,"_8112":4059,"_15":7625,"_8113":8415,"_19":8416,"_8115":7837},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4619":8418,"_8112":8419,"_15":7664,"_8113":8420,"_19":8421,"_8115":7863},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4619":8424,"_8112":8425,"_15":8422,"_8113":4059,"_19":8426,"_8115":7681},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4619":8429,"_8112":8430,"_15":8427,"_8113":4059,"_19":8431,"_8115":7837},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4619":8434,"_8112":8435,"_15":8432,"_8113":4059,"_19":8436,"_8115":7681},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4619":8438,"_8112":8439,"_15":7851,"_8113":8440,"_19":8441,"_8115":7837},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4619":8234,"_8112":8439,"_15":8442,"_8113":4059,"_19":8444,"_8115":7837},"干员受到自然附着","ba.originium",{"_4619":8447,"_8112":4059,"_15":8445,"_8113":4059,"_19":8448,"_8115":7708},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4619":8451,"_8112":4059,"_15":8449,"_8113":4059,"_19":8452,"_8115":7863},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4619":8455,"_8112":8456,"_15":8453,"_8113":4059,"_19":8457,"_8115":7863},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4619":8460,"_8112":4059,"_15":8458,"_8113":8461,"_19":8462,"_8115":7871},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4619":8465,"_8112":4059,"_15":8463,"_8113":4059,"_19":8466,"_8115":7681},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4619":8469,"_8112":4059,"_15":8467,"_8113":8470,"_19":8471,"_8115":7887},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4619":8474,"_8112":8475,"_15":8472,"_8113":4059,"_19":8476,"_8115":7681},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4619":8478,"_8112":8340,"_15":7891,"_8113":8479,"_19":8480,"_8115":7887},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4619":8483,"_8112":8484,"_15":8481,"_8113":4059,"_19":8485,"_8115":7887},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4619":8488,"_8112":4059,"_15":8486,"_8113":8489,"_19":8490,"_8115":7708},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4619":8493,"_8112":4059,"_15":8491,"_8113":8494,"_19":8495,"_8115":4059},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4619":8498,"_8112":4059,"_15":8496,"_8113":4059,"_19":8499,"_8115":7681},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4619":8502,"_8112":4059,"_15":8500,"_8113":4059,"_19":8503,"_8115":7708},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4619":8506,"_8112":8507,"_15":8504,"_8113":4059,"_19":8508,"_8115":7681},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4619":8511,"_8112":4059,"_15":8509,"_8113":8512,"_19":8513,"_8115":7708},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4619":8516,"_8112":4059,"_15":8514,"_8113":4059,"_19":8517,"_8115":7681},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4619":8520,"_8112":8521,"_15":8518,"_8113":8522,"_19":8523,"_8115":7708},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4619":8526,"_8112":4059,"_15":8524,"_8113":4059,"_19":8527,"_8115":7708},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4619":8530,"_8112":4059,"_15":8528,"_8113":4059,"_19":8531,"_8115":7708},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4619":8534,"_8112":8535,"_15":8532,"_8113":4059,"_19":8536,"_8115":7681},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4619":8539,"_8112":4059,"_15":8537,"_8113":4059,"_19":8540,"_8115":7708},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4619":8543,"_8112":4059,"_15":8541,"_8113":4059,"_19":8544,"_8115":7708},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4619":8547,"_8112":4059,"_15":8545,"_8113":4059,"_19":8548,"_8115":7708},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4619":8551,"_8112":8552,"_15":8549,"_8113":8553,"_19":8554,"_8115":7708},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4619":8557,"_8112":8558,"_15":8555,"_8113":4059,"_19":8559,"_8115":7681},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4619":8562,"_8112":8563,"_15":8560,"_8113":4059,"_19":8564,"_8115":7681},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4619":8567,"_8112":8568,"_15":8565,"_8113":4059,"_19":8569,"_8115":7681},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4619":8572,"_8112":8573,"_15":8570,"_8113":4059,"_19":8574,"_8115":7681},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4619":8577,"_8112":8578,"_15":8575,"_8113":4059,"_19":8579,"_8115":7681},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4619":8582,"_8112":8583,"_15":8580,"_8113":4059,"_19":8584,"_8115":7681},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4619":8587,"_8112":8588,"_15":8585,"_8113":4059,"_19":8589,"_8115":7681},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4619":8592,"_8112":8593,"_15":8590,"_8113":4059,"_19":8594,"_8115":7681},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4619":8597,"_8112":8598,"_15":8595,"_8113":4059,"_19":8599,"_8115":7681},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4619":8602,"_8112":8603,"_15":8600,"_8113":4059,"_19":8604,"_8115":7681},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4619":8607,"_8112":8608,"_15":8605,"_8113":4059,"_19":8609,"_8115":7681},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4619":8612,"_8112":8613,"_15":8610,"_8113":4059,"_19":8614,"_8115":7681},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4619":8617,"_8112":8618,"_15":8615,"_8113":4059,"_19":8619,"_8115":7681},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4619":8622,"_8112":8623,"_15":8620,"_8113":4059,"_19":8624,"_8115":7681},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_5948":8627,"_6868":8636,"_6863":8638,"_6966":8640,"_6968":8642,"_6235":8644,"_6971":8646,"_6974":8648,"_6977":8650,"_6979":8651,"_5942":8653,"_6984":8655,"_6987":8656,"_6990":8657,"_6992":8659,"_6652":8660,"_6997":8661,"_7000":8662,"_7004":8664,"_7008":8665,"_6771":8666,"_7015":8667,"_7018":8668,"_7022":8669,"_7026":8670,"_7029":8671,"_7033":8672,"_7037":8674,"_7041":8675,"_7045":8677,"_5945":8679,"_7052":8681,"_7056":8682,"_7060":8684,"_7064":8686,"_7068":8687,"_7072":8689,"_7076":8691,"_7080":8693,"_7084":8695,"_7088":8698,"_7092":8701,"_7096":8704,"_7100":8707,"_7104":8708,"_7108":8710,"_7112":8711,"_7116":8712,"_7120":8714,"_7124":8716,"_7128":8717,"_7132":8719,"_7136":8721,"_7140":8723,"_7144":8725,"_7148":8727,"_7152":8729,"_7156":8731,"_7159":8733,"_7163":8735,"_7167":8737,"_7171":8738,"_7175":8740,"_7179":8741,"_7183":8742,"_7187":8743,"_7191":8744,"_7195":8745,"_7199":8746,"_7203":8747,"_7207":8748,"_7211":8749,"_7215":8750,"_7219":8751,"_7223":8752,"_7227":8753,"_7231":8754,"_7235":8755,"_7239":8756,"_7243":8757,"_7247":8758,"_7251":8759,"_7254":8760,"_7258":8761,"_7262":8762,"_7266":8763,"_7270":8764,"_7274":8765,"_7278":8767,"_7282":8768,"_7286":8769,"_8770":8771,"_8772":8773,"_8775":8776,"_8777":8778,"_8779":8780,"_8781":8782,"_8783":8784,"_8785":8786,"_8787":8788,"_8789":8790,"_8