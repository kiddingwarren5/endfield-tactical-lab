34":8035,"_7532":8039,"_8044":8045,"_8048":8049,"_7539":8053,"_8058":8059,"_8064":8065,"_7563":8069,"_8074":8075,"_8079":8080,"_8084":8085,"_8089":8090,"_7570":8094,"_8098":8099,"_8103":8104,"_8108":8109,"_8112":8113,"_8118":8119,"_8123":8124,"_7600":8128,"_8133":8134,"_8138":8139,"_8141":8142,"_8145":8146,"_8150":8151,"_8154":8155,"_8160":8161,"_8164":8165,"_8169":8170,"_8174":8175,"_7617":8179,"_8183":8184,"_8186":8187,"_7637":8191,"_8195":8196,"_8200":8201,"_8205":8206,"_8210":8211,"_8214":8215,"_8219":8220,"_7437":8225,"_7476":8229,"_8234":8235,"_8239":8240,"_8244":8245,"_7663":8249,"_8254":8255,"_8257":8258,"_8261":8262,"_8265":8266,"_8270":8271,"_8275":8276,"_8279":8280,"_8284":8285,"_7703":8289,"_8293":8294,"_8298":8299,"_8303":8304,"_8308":8309,"_8312":8313,"_8316":8317,"_8321":8322,"_8326":8327,"_8330":8331,"_8336":8337,"_8340":8341,"_8344":8345,"_8349":8350,"_8353":8354,"_8357":8358,"_8361":8362,"_8367":8368,"_8372":8373,"_8377":8378,"_8382":8383,"_8387":8388,"_8392":8393,"_8397":8398,"_8402":8403,"_8407":8408,"_8412":8413,"_8417":8418,"_8422":8423,"_8427":8428,"_8432":8433},"adv.electricFence",{"_4612":7923,"_7924":4058,"_15":7921,"_7925":4058,"_19":7926,"_7927":7493},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4612":7930,"_7924":7931,"_15":7928,"_7925":4058,"_19":7932,"_7927":7546},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4612":7934,"_7924":7935,"_15":7610,"_7925":7936,"_19":7937,"_7927":7675},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4612":7940,"_7924":4058,"_15":7938,"_7925":4058,"_19":7941,"_7927":7493},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4612":7944,"_7924":7945,"_15":7942,"_7925":4058,"_19":7946,"_7927":7493},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4612":7949,"_7924":4058,"_15":7947,"_7925":4058,"_19":7950,"_7927":7493},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4612":7953,"_7924":7954,"_15":7951,"_7925":4058,"_19":7955,"_7927":7587},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4612":7958,"_7924":4058,"_15":7956,"_7925":4058,"_19":7959,"_7927":7493},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4612":7962,"_7924":7963,"_15":7960,"_7925":4058,"_19":7964,"_7927":7493},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4612":7967,"_7924":4058,"_15":7965,"_7925":4058,"_19":7968,"_7927":4058},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4612":7971,"_7924":7972,"_15":7969,"_7925":4058,"_19":7973,"_7927":7546},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4612":7975,"_7924":7976,"_15":7425,"_7925":7977,"_19":7978,"_7927":7675},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4612":7981,"_7924":4058,"_15":7979,"_7925":4058,"_19":7982,"_7927":7493},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4612":7985,"_7924":7986,"_15":7983,"_7925":4058,"_19":7987,"_7927":7493},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4612":7990,"_7924":7991,"_15":7988,"_7925":4058,"_19":7992,"_7927":7493},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4612":7995,"_7924":4058,"_15":7993,"_7925":4058,"_19":7996,"_7927":7520},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4612":7999,"_7924":8000,"_15":7997,"_7925":4058,"_19":8001,"_7927":7493},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4612":8004,"_7924":4058,"_15":8002,"_7925":4058,"_19":8005,"_7927":7520},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4612":8007,"_7924":8008,"_15":7508,"_7925":8009,"_19":8010,"_7927":7587},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4612":8013,"_7924":8008,"_15":8011,"_7925":4058,"_19":8014,"_7927":7587},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4612":8017,"_7924":8018,"_15":8015,"_7925":8019,"_19":8020,"_7927":7520},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4612":8023,"_7924":4058,"_15":8021,"_7925":4058,"_19":8024,"_7927":7520},"持续时间内，受影响的目标暂停行动。","定身",{"_4612":8026,"_7924":8027,"_15":7514,"_7925":8028,"_19":8029,"_7927":7699},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4612":8032,"_7924":8027,"_15":8030,"_7925":4058,"_19":8033,"_7927":7699},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4612":8036,"_7924":4058,"_15":8034,"_7925":8037,"_19":8038,"_7927":4058},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4612":8040,"_7924":8041,"_15":7532,"_7925":8042,"_19":8043,"_7927":7649},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4612":8046,"_7924":8041,"_15":8044,"_7925":4058,"_19":8047,"_7927":7649},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4612":8050,"_7924":8051,"_15":8048,"_7925":4058,"_19":8052,"_7927":7493},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4612":8054,"_7924":8055,"_15":7539,"_7925":8056,"_19":8057,"_7927":7675},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4612":8060,"_7924":8061,"_15":8058,"_7925":8062,"_19":8063,"_7927":7520},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4612":8066,"_7924":8067,"_15":8064,"_7925":4058,"_19":8068,"_7927":7520},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4612":8070,"_7924":8071,"_15":7563,"_7925":8072,"_19":8073,"_7927":7546},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4612":8076,"_7924":4058,"_15":8074,"_7925":8077,"_19":8078,"_7927":7546},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4612":8081,"_7924":8082,"_15":8079,"_7925":4058,"_19":8083,"_7927":7493},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4612":8086,"_7924":8087,"_15":8084,"_7925":4058,"_19":8088,"_7927":7493},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4612":8091,"_7924":8092,"_15":8089,"_7925":4058,"_19":8093,"_7927":7546},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4612":8095,"_7924":7931,"_15":7570,"_7925":8096,"_19":8097,"_7927":7546},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4612":8100,"_7924":4058,"_15":8098,"_7925":8101,"_19":8102,"_7927":7520},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4612":8105,"_7924":8106,"_15":8103,"_7925":4058,"_19":8107,"_7927":7493},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4612":8110,"_7924":4058,"_15":8108,"_7925":4058,"_19":8111,"_7927":4058},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4612":8114,"_7924":8115,"_15":8112,"_7925":8116,"_19":8117,"_7927":7520},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4612":8120,"_7924":8121,"_15":8118,"_7925":4058,"_19":8122,"_7927":7493},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4612":8125,"_7924":4058,"_15":8123,"_7925":8126,"_19":8127,"_7927":7587},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4612":8129,"_7924":8130,"_15":7600,"_7925":8131,"_19":8132,"_7927":7587},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4612":8135,"_7924":8136,"_15":8133,"_7925":4058,"_19":8137,"_7927":7493},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4612":8013,"_7924":8130,"_15":8138,"_7925":4058,"_19":8140,"_7927":7587},"干员受到灼热附着","sys.tacticalItem",{"_4612":8143,"_7924":4058,"_15":8141,"_7925":4058,"_19":8144,"_7927":7493},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4612":8147,"_7924":8148,"_15":8145,"_7925":4058,"_19":8149,"_7927":7587},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4612":8032,"_7924":8152,"_15":8150,"_7925":4058,"_19":8153,"_7927":7699},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4612":8156,"_7924":8157,"_15":8154,"_7925":8158,"_19":8159,"_7927":7520},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4612":8162,"_7924":4058,"_15":8160,"_7925":4058,"_19":8163,"_7927":7520},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4612":8166,"_7924":8167,"_15":8164,"_7925":4058,"_19":8168,"_7927":7675},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4612":8171,"_7924":8172,"_15":8169,"_7925":4058,"_19":8173,"_7927":7699},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4612":8176,"_7924":8177,"_15":8174,"_7925":4058,"_19":8178,"_7927":7520},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4612":8180,"_7924":8181,"_15":7617,"_7925":8072,"_19":8182,"_7927":7546},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4612":7930,"_7924":8181,"_15":8183,"_7925":4058,"_19":8185,"_7927":7546},"干员受到冻结","ba.naturalvul",{"_4612":8188,"_7924":8189,"_15":8186,"_7925":4058,"_19":8190,"_7927":7649},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4612":7975,"_7924":8192,"_15":7637,"_7925":8193,"_19":8194,"_7927":7675},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4612":8197,"_7924":8198,"_15":8195,"_7925":4058,"_19":8199,"_7927":7493},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4612":8202,"_7924":8203,"_15":8200,"_7925":4058,"_19":8204,"_7927":7493},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4612":8207,"_7924":8208,"_15":8205,"_7925":4058,"_19":8209,"_7927":7493},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4612":8212,"_7924":4058,"_15":8210,"_7925":4058,"_19":8213,"_7927":7493},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4612":8216,"_7924":4058,"_15":8214,"_7925":8217,"_19":8218,"_7927":4058},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4612":8221,"_7924":8222,"_15":8219,"_7925":8223,"_19":8224,"_7927":7520},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4612":8226,"_7924":4058,"_15":7437,"_7925":8227,"_19":8228,"_7927":7649},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4612":8230,"_7924":8231,"_15":7476,"_7925":8232,"_19":8233,"_7927":7675},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4612":8236,"_7924":8237,"_15":8234,"_7925":4058,"_19":8238,"_7927":7493},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4612":8241,"_7924":8242,"_15":8239,"_7925":4058,"_19":8243,"_7927":7649},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4612":8246,"_7924":8247,"_15":8244,"_7925":4058,"_19":8248,"_7927":7493},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4612":8250,"_7924":8251,"_15":7663,"_7925":8252,"_19":8253,"_7927":7649},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4612":8046,"_7924":8251,"_15":8254,"_7925":4058,"_19":8256,"_7927":7649},"干员受到自然附着","ba.originium",{"_4612":8259,"_7924":4058,"_15":8257,"_7925":4058,"_19":8260,"_7927":7520},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4612":8263,"_7924":4058,"_15":8261,"_7925":4058,"_19":8264,"_7927":7675},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4612":8267,"_7924":8268,"_15":8265,"_7925":4058,"_19":8269,"_7927":7675},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4612":8272,"_7924":4058,"_15":8270,"_7925":8273,"_19":8274,"_7927":7683},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4612":8277,"_7924":4058,"_15":8275,"_7925":4058,"_19":8278,"_7927":7493},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4612":8281,"_7924":4058,"_15":8279,"_7925":8282,"_19":8283,"_7927":7699},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4612":8286,"_7924":8287,"_15":8284,"_7925":4058,"_19":8288,"_7927":7493},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4612":8290,"_7924":8152,"_15":7703,"_7925":8291,"_19":8292,"_7927":7699},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4612":8295,"_7924":8296,"_15":8293,"_7925":4058,"_19":8297,"_7927":7699},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4612":8300,"_7924":4058,"_15":8298,"_7925":8301,"_19":8302,"_7927":7520},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4612":8305,"_7924":4058,"_15":8303,"_7925":8306,"_19":8307,"_7927":4058},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4612":8310,"_7924":4058,"_15":8308,"_7925":4058,"_19":8311,"_7927":7493},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4612":8314,"_7924":4058,"_15":8312,"_7925":4058,"_19":8315,"_7927":7520},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4612":8318,"_7924":8319,"_15":8316,"_7925":4058,"_19":8320,"_7927":7493},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4612":8323,"_7924":4058,"_15":8321,"_7925":8324,"_19":8325,"_7927":7520},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4612":8328,"_7924":4058,"_15":8326,"_7925":4058,"_19":8329,"_7927":7493},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4612":8332,"_7924":8333,"_15":8330,"_7925":8334,"_19":8335,"_7927":7520},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4612":8338,"_7924":4058,"_15":8336,"_7925":4058,"_19":8339,"_7927":7520},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4612":8342,"_7924":4058,"_15":8340,"_7925":4058,"_19":8343,"_7927":7520},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4612":8346,"_7924":8347,"_15":8344,"_7925":4058,"_19":8348,"_7927":7493},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4612":8351,"_7924":4058,"_15":8349,"_7925":4058,"_19":8352,"_7927":7520},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4612":8355,"_7924":4058,"_15":8353,"_7925":4058,"_19":8356,"_7927":7520},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4612":8359,"_7924":4058,"_15":8357,"_7925":4058,"_19":8360,"_7927":7520},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4612":8363,"_7924":8364,"_15":8361,"_7925":8365,"_19":8366,"_7927":7520},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4612":8369,"_7924":8370,"_15":8367,"_7925":4058,"_19":8371,"_7927":7493},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4612":8374,"_7924":8375,"_15":8372,"_7925":4058,"_19":8376,"_7927":7493},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4612":8379,"_7924":8380,"_15":8377,"_7925":4058,"_19":8381,"_7927":7493},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4612":8384,"_7924":8385,"_15":8382,"_7925":4058,"_19":8386,"_7927":7493},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4612":8389,"_7924":8390,"_15":8387,"_7925":4058,"_19":8391,"_7927":7493},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4612":8394,"_7924":8395,"_15":8392,"_7925":4058,"_19":8396,"_7927":7493},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4612":8399,"_7924":8400,"_15":8397,"_7925":4058,"_19":8401,"_7927":7493},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4612":8404,"_7924":8405,"_15":8402,"_7925":4058,"_19":8406,"_7927":7493},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4612":8409,"_7924":8410,"_15":8407,"_7925":4058,"_19":8411,"_7927":7493},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4612":8414,"_7924":8415,"_15":8412,"_7925":4058,"_19":8416,"_7927":7493},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4612":8419,"_7924":8420,"_15":8417,"_7925":4058,"_19":8421,"_7927":7493},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4612":8424,"_7924":8425,"_15":8422,"_7925":4058,"_19":8426,"_7927":7493},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4612":8429,"_7924":8430,"_15":8427,"_7925":4058,"_19":8431,"_7927":7493},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4612":8434,"_7924":8435,"_15":8432,"_7925":4058,"_19":8436,"_7927":7493},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_7129":8439,"_6116":8448,"_6213":8450,"_6676":8452,"_6777":8454,"_6779":8456,"_6781":8458,"_6784":8460,"_6787":8462,"_6790":8463,"_5888":8465,"_6795":8467,"_6798":8468,"_6801":8469,"_6803":8471,"_6442":8472,"_6808":8473,"_6811":8474,"_6815":8476,"_6818":8477,"_6448":8478,"_6825":8479,"_6828":8480,"_6832":8481,"_6836":8482,"_6839":8483,"_6843":8484,"_6847":8486,"_6851":8487,"_6855":8489,"_6859":8491,"_6863":8493,"_6867":8494,"_6871":8496,"_6875":8498,"_6879":8499,"_6883":8501,"_6887":8503,"_6891":8505,"_6895":8507,"_6899":8510,"_6903":8513,"_6907":8516,"_6911":8519,"_6915":8520,"_6919":8522,"_6923":8523,"_6927":8524,"_6931":8526,"_6935":8528,"_6939":8529,"_6943":8531,"_6947":8533,"_6951":8535,"_6955":8537,"_6959":8539,"_6963":8541,"_6967":8543,"_6970":8545,"_6974":8547,"_6978":8549,"_6982":8550,"_6986":8552,"_6990":8553,"_6994":8554,"_6998":8555,"_7002":8556,"_7006":8557,"_7010":8558,"_7014":8559,"_7018":8560,"_7022":8561,"_7026":8562,"_7030":8563,"_7034":8564,"_7038":8565,"_7042":8566,"_7046":8567,"_7050":8568,"_7054":8569,"_7058":8570,"_7062":8571,"_7065":8572,"_7069":8573,"_7073":8574,"_7077":8575,"_7081":8576,"_7085":8577,"_7089":8579,"_7093":8580,"_7097":8581,"_8582":8583,"_8584":8585,"_8587":8588,"_8589":8590,"_8591":8592,"_8593":8594,"_8595":8596,"_8597":8598,"_8599":8600,"_8601":8602,"_8603":8604,"_8606":8607,"_8608":8609,"_8611":8612,"_8614":8615,"_8616":8617,"_8619":8620},{"_8440":37,"_8441":4058,"_8442":39,"_8443":5076,"_8444":5076,"_8445":4058,"_8446":37,"_8447":37},"attributeType","bigIconNam