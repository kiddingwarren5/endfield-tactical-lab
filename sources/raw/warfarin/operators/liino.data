212":9213,"_9218":9219,"_8717":9223,"_9228":9229,"_9233":9234,"_9238":9239,"_9243":9244,"_8724":9248,"_9252":9253,"_9257":9258,"_9262":9263,"_9266":9267,"_9272":9273,"_9277":9278,"_8754":9282,"_9287":9288,"_9292":9293,"_9295":9296,"_9299":9300,"_9304":9305,"_9308":9309,"_9314":9315,"_9318":9319,"_9323":9324,"_9328":9329,"_8771":9333,"_9337":9338,"_9340":9341,"_8791":9345,"_9349":9350,"_9354":9355,"_9359":9360,"_9364":9365,"_9368":9369,"_9373":9374,"_8591":9379,"_8630":9383,"_9388":9389,"_9393":9394,"_9398":9399,"_8817":9403,"_9408":9409,"_9411":9412,"_9415":9416,"_9419":9420,"_9424":9425,"_9429":9430,"_9433":9434,"_9438":9439,"_8857":9443,"_9447":9448,"_9452":9453,"_9457":9458,"_9462":9463,"_9466":9467,"_9470":9471,"_9475":9476,"_9480":9481,"_9484":9485,"_9490":9491,"_9494":9495,"_9498":9499,"_9503":9504,"_9507":9508,"_9511":9512,"_9515":9516,"_9521":9522,"_9526":9527,"_9531":9532,"_9536":9537,"_9541":9542,"_9546":9547,"_9551":9552,"_9556":9557,"_9561":9562,"_9566":9567,"_9571":9572,"_9576":9577,"_9581":9582,"_9586":9587},"adv.electricFence",{"_4637":9077,"_9078":4080,"_15":9075,"_9079":4080,"_19":9080,"_9081":8647},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_4637":9084,"_9078":9085,"_15":9082,"_9079":4080,"_19":9086,"_9081":8700},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_4637":9088,"_9078":9089,"_15":8764,"_9079":9090,"_19":9091,"_9081":8829},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_4637":9094,"_9078":4080,"_15":9092,"_9079":4080,"_19":9095,"_9081":8647},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_4637":9098,"_9078":9099,"_15":9096,"_9079":4080,"_19":9100,"_9081":8647},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_4637":9103,"_9078":4080,"_15":9101,"_9079":4080,"_19":9104,"_9081":8647},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_4637":9107,"_9078":9108,"_15":9105,"_9079":4080,"_19":9109,"_9081":8741},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_4637":9112,"_9078":4080,"_15":9110,"_9079":4080,"_19":9113,"_9081":8647},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_4637":9116,"_9078":9117,"_15":9114,"_9079":4080,"_19":9118,"_9081":8647},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_4637":9121,"_9078":4080,"_15":9119,"_9079":4080,"_19":9122,"_9081":4080},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_4637":9125,"_9078":9126,"_15":9123,"_9079":4080,"_19":9127,"_9081":8700},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_4637":9129,"_9078":9130,"_15":8579,"_9079":9131,"_19":9132,"_9081":8829},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_4637":9135,"_9078":4080,"_15":9133,"_9079":4080,"_19":9136,"_9081":8647},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_4637":9139,"_9078":9140,"_15":9137,"_9079":4080,"_19":9141,"_9081":8647},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_4637":9144,"_9078":9145,"_15":9142,"_9079":4080,"_19":9146,"_9081":8647},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_4637":9149,"_9078":4080,"_15":9147,"_9079":4080,"_19":9150,"_9081":8674},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_4637":9153,"_9078":9154,"_15":9151,"_9079":4080,"_19":9155,"_9081":8647},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_4637":9158,"_9078":4080,"_15":9156,"_9079":4080,"_19":9159,"_9081":8674},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_4637":9161,"_9078":9162,"_15":8662,"_9079":9163,"_19":9164,"_9081":8741},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_4637":9167,"_9078":9162,"_15":9165,"_9079":4080,"_19":9168,"_9081":8741},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_4637":9171,"_9078":9172,"_15":9169,"_9079":9173,"_19":9174,"_9081":8674},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_4637":9177,"_9078":4080,"_15":9175,"_9079":4080,"_19":9178,"_9081":8674},"持续时间内，受影响的目标暂停行动。","定身",{"_4637":9180,"_9078":9181,"_15":8668,"_9079":9182,"_19":9183,"_9081":8853},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_4637":9186,"_9078":9181,"_15":9184,"_9079":4080,"_19":9187,"_9081":8853},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_4637":9190,"_9078":4080,"_15":9188,"_9079":9191,"_19":9192,"_9081":4080},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_4637":9194,"_9078":9195,"_15":8686,"_9079":9196,"_19":9197,"_9081":8803},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_4637":9200,"_9078":9195,"_15":9198,"_9079":4080,"_19":9201,"_9081":8803},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_4637":9204,"_9078":9205,"_15":9202,"_9079":4080,"_19":9206,"_9081":8647},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_4637":9208,"_9078":9209,"_15":8693,"_9079":9210,"_19":9211,"_9081":8829},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_4637":9214,"_9078":9215,"_15":9212,"_9079":9216,"_19":9217,"_9081":8674},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_4637":9220,"_9078":9221,"_15":9218,"_9079":4080,"_19":9222,"_9081":8674},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_4637":9224,"_9078":9225,"_15":8717,"_9079":9226,"_19":9227,"_9081":8700},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_4637":9230,"_9078":4080,"_15":9228,"_9079":9231,"_19":9232,"_9081":8700},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_4637":9235,"_9078":9236,"_15":9233,"_9079":4080,"_19":9237,"_9081":8647},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_4637":9240,"_9078":9241,"_15":9238,"_9079":4080,"_19":9242,"_9081":8647},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_4637":9245,"_9078":9246,"_15":9243,"_9079":4080,"_19":9247,"_9081":8700},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_4637":9249,"_9078":9085,"_15":8724,"_9079":9250,"_19":9251,"_9081":8700},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_4637":9254,"_9078":4080,"_15":9252,"_9079":9255,"_19":9256,"_9081":8674},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_4637":9259,"_9078":9260,"_15":9257,"_9079":4080,"_19":9261,"_9081":8647},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_4637":9264,"_9078":4080,"_15":9262,"_9079":4080,"_19":9265,"_9081":4080},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_4637":9268,"_9078":9269,"_15":9266,"_9079":9270,"_19":9271,"_9081":8674},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_4637":9274,"_9078":9275,"_15":9272,"_9079":4080,"_19":9276,"_9081":8647},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_4637":9279,"_9078":4080,"_15":9277,"_9079":9280,"_19":9281,"_9081":8741},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_4637":9283,"_9078":9284,"_15":8754,"_9079":9285,"_19":9286,"_9081":8741},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_4637":9289,"_9078":9290,"_15":9287,"_9079":4080,"_19":9291,"_9081":8647},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_4637":9167,"_9078":9284,"_15":9292,"_9079":4080,"_19":9294,"_9081":8741},"干员受到灼热附着","sys.tacticalItem",{"_4637":9297,"_9078":4080,"_15":9295,"_9079":4080,"_19":9298,"_9081":8647},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_4637":9301,"_9078":9302,"_15":9299,"_9079":4080,"_19":9303,"_9081":8741},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_4637":9186,"_9078":9306,"_15":9304,"_9079":4080,"_19":9307,"_9081":8853},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_4637":9310,"_9078":9311,"_15":9308,"_9079":9312,"_19":9313,"_9081":8674},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_4637":9316,"_9078":4080,"_15":9314,"_9079":4080,"_19":9317,"_9081":8674},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_4637":9320,"_9078":9321,"_15":9318,"_9079":4080,"_19":9322,"_9081":8829},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_4637":9325,"_9078":9326,"_15":9323,"_9079":4080,"_19":9327,"_9081":8853},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_4637":9330,"_9078":9331,"_15":9328,"_9079":4080,"_19":9332,"_9081":8674},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_4637":9334,"_9078":9335,"_15":8771,"_9079":9226,"_19":9336,"_9081":8700},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_4637":9084,"_9078":9335,"_15":9337,"_9079":4080,"_19":9339,"_9081":8700},"干员受到冻结","ba.naturalvul",{"_4637":9342,"_9078":9343,"_15":9340,"_9079":4080,"_19":9344,"_9081":8803},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_4637":9129,"_9078":9346,"_15":8791,"_9079":9347,"_19":9348,"_9081":8829},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_4637":9351,"_9078":9352,"_15":9349,"_9079":4080,"_19":9353,"_9081":8647},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_4637":9356,"_9078":9357,"_15":9354,"_9079":4080,"_19":9358,"_9081":8647},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_4637":9361,"_9078":9362,"_15":9359,"_9079":4080,"_19":9363,"_9081":8647},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_4637":9366,"_9078":4080,"_15":9364,"_9079":4080,"_19":9367,"_9081":8647},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_4637":9370,"_9078":4080,"_15":9368,"_9079":9371,"_19":9372,"_9081":4080},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_4637":9375,"_9078":9376,"_15":9373,"_9079":9377,"_19":9378,"_9081":8674},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_4637":9380,"_9078":4080,"_15":8591,"_9079":9381,"_19":9382,"_9081":8803},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_4637":9384,"_9078":9385,"_15":8630,"_9079":9386,"_19":9387,"_9081":8829},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_4637":9390,"_9078":9391,"_15":9388,"_9079":4080,"_19":9392,"_9081":8647},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_4637":9395,"_9078":9396,"_15":9393,"_9079":4080,"_19":9397,"_9081":8803},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_4637":9400,"_9078":9401,"_15":9398,"_9079":4080,"_19":9402,"_9081":8647},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_4637":9404,"_9078":9405,"_15":8817,"_9079":9406,"_19":9407,"_9081":8803},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_4637":9200,"_9078":9405,"_15":9408,"_9079":4080,"_19":9410,"_9081":8803},"干员受到自然附着","ba.originium",{"_4637":9413,"_9078":4080,"_15":9411,"_9079":4080,"_19":9414,"_9081":8674},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_4637":9417,"_9078":4080,"_15":9415,"_9079":4080,"_19":9418,"_9081":8829},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_4637":9421,"_9078":9422,"_15":9419,"_9079":4080,"_19":9423,"_9081":8829},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_4637":9426,"_9078":4080,"_15":9424,"_9079":9427,"_19":9428,"_9081":8837},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_4637":9431,"_9078":4080,"_15":9429,"_9079":4080,"_19":9432,"_9081":8647},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_4637":9435,"_9078":4080,"_15":9433,"_9079":9436,"_19":9437,"_9081":8853},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_4637":9440,"_9078":9441,"_15":9438,"_9079":4080,"_19":9442,"_9081":8647},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_4637":9444,"_9078":9306,"_15":8857,"_9079":9445,"_19":9446,"_9081":8853},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_4637":9449,"_9078":9450,"_15":9447,"_9079":4080,"_19":9451,"_9081":8853},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_4637":9454,"_9078":4080,"_15":9452,"_9079":9455,"_19":9456,"_9081":8674},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_4637":9459,"_9078":4080,"_15":9457,"_9079":9460,"_19":9461,"_9081":4080},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_4637":9464,"_9078":4080,"_15":9462,"_9079":4080,"_19":9465,"_9081":8647},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_4637":9468,"_9078":4080,"_15":9466,"_9079":4080,"_19":9469,"_9081":8674},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_4637":9472,"_9078":9473,"_15":9470,"_9079":4080,"_19":9474,"_9081":8647},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_4637":9477,"_9078":4080,"_15":9475,"_9079":9478,"_19":9479,"_9081":8674},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_4637":9482,"_9078":4080,"_15":9480,"_9079":4080,"_19":9483,"_9081":8647},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_4637":9486,"_9078":9487,"_15":9484,"_9079":9488,"_19":9489,"_9081":8674},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_4637":9492,"_9078":4080,"_15":9490,"_9079":4080,"_19":9493,"_9081":8674},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_4637":9496,"_9078":4080,"_15":9494,"_9079":4080,"_19":9497,"_9081":8674},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_4637":9500,"_9078":9501,"_15":9498,"_9079":4080,"_19":9502,"_9081":8647},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_4637":9505,"_9078":4080,"_15":9503,"_9079":4080,"_19":9506,"_9081":8674},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_4637":9509,"_9078":4080,"_15":9507,"_9079":4080,"_19":9510,"_9081":8674},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_4637":9513,"_9078":4080,"_15":9511,"_9079":4080,"_19":9514,"_9081":8674},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_4637":9517,"_9078":9518,"_15":9515,"_9079":9519,"_19":9520,"_9081":8674},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_4637":9523,"_9078":9524,"_15":9521,"_9079":4080,"_19":9525,"_9081":8647},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_4637":9528,"_9078":9529,"_15":9526,"_9079":4080,"_19":9530,"_9081":8647},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_4637":9533,"_9078":9534,"_15":9531,"_9079":4080,"_19":9535,"_9081":8647},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_4637":9538,"_9078":9539,"_15":9536,"_9079":4080,"_19":9540,"_9081":8647},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_4637":9543,"_9078":9544,"_15":9541,"_9079":4080,"_19":9545,"_9081":8647},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_4637":9548,"_9078":9549,"_15":9546,"_9079":4080,"_19":9550,"_9081":8647},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_4637":9553,"_9078":9554,"_15":9551,"_9079":4080,"_19":9555,"_9081":8647},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_4637":9558,"_9078":9559,"_15":9556,"_9079":4080,"_19":9560,"_9081":8647},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_4637":9563,"_9078":9564,"_15":9561,"_9079":4080,"_19":9565,"_9081":8647},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_4637":9568,"_9078":9569,"_15":9566,"_9079":4080,"_19":9570,"_9081":8647},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_4637":9573,"_9078":9574,"_15":9571,"_9079":4080,"_19":9575,"_9081":8647},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_4637":9578,"_9078":9579,"_15":9576,"_9079":4080,"_19":9580,"_9081":8647},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_4637":9583,"_9078":9584,"_15":9581,"_9079":4080,"_19":9585,"_9081":8647},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_4637":9588,"_9078":9589,"_15":9586,"_9079":4080,"_19":9590,"_9081":8647},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维","attributeMetaTable",{"_8284":9593,"_7953":9602,"_7957":9604,"_6473":9606,"_7960":9608,"_6191":9610,"_7963":9612,"_7965":9614,"_7968":9616,"_7971":9617,"_6470":9619,"_7976":9621,"_7979":9622,"_7982":9623,"_7984":9625,"_7330":9626,"_7989":9627,"_7992":9628,"_6482":9630,"_7997":9631,"_6194":9632,"_8004":9633,"_6515":9634,"_8010":9635,"_8014":9636,"_6549":9637,"_8020":9638,"_8024":9640,"_8028":9641,"_6582":9643,"_8035":9645,"_6614":9647,"_6643":9648,"_8045":9650,"_6675":9652,"_8052":9653,"_6706":9655,"_8059":9657,"_6736":9659,"_6770":9661,"_6803":9664,"_6833":9667,"_8075":9670,"_7371":9673,"_8082":9674,"_8086":9676,"_8090":9677,"_8094":9678,"_8098":9680,"_8102":9682,"_7415":9683,"_8109":9685,"_8113":9687,"_8117":9689,"_8121":9691,"_8125":9693,"_8129":9695,"_8133":9697,"_7459":9699,"_8139":9701,"_6476":9703,"_7503":9704,"_8149":9706,"_8153":9707,"_8157":9708,"_7546":9709,"_8164":9710,"_8168":9711,"_7589":9712,"_8175":9713,"_8179":9714,"_8183":9715,"_6197":9716,"_8190":9717,"_8194":9718,"_8198":9719,"_7672":9720,"_7716":9721,"_8208":9722,"_7759":9723,"_8215":9724,"_7798":9725,"_8221":9726,"_8225":9727,"_8229":9728,"_8233":9729,"_6221":9730,"_8240":9731,"_8244":9733,"_8248":9734,"_8252":9735,"_9736":9737,"_9738":9739,"_9740":9741,"_9742":9743,"_9744":9745,"_9746":9747,"_9748":9749,"_9750":9751,"_9752":9753,"_9754":9755,"_6242":9756,"_9758":9759,"_9760":9761,"_9763":9764,"_9766":9767,"_9768":9769,"_9771":9772},{"_9594":37,"_9595":4080,"_9596":39,"_9597":5104,"_9598":5104,"_9599":4080,"_9600":37,"_9601":37},"attributeType","bigIconName","defaultValue","hasMaxValue","hasMinValue","iconName","maxVal