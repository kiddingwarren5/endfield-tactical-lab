4628":4080,"_4629":4080,"_4630":4080,"_4631":4080,"_4632":4080,"_4633":4080,"_4634":4080,"_4635":4080,"_4636":4080,"_4637":4649,"_4639":4650,"_19":4651,"_4642":4647,"_4643":37,"_4644":4652},"普通攻击：\n对敌人进行至多5段攻击，造成<@ba.pulse>电磁伤害</>。作为主控干员时，<#ba.lastcombo>重击</>会造成<@ba.poise>{poise:0}</>点失衡。\n\n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成<@ba.pulse>电磁伤害</>。\n\n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量<@ba.pulse>电磁伤害</>并恢复一定技力。","icon_attack_lance","怦然星动",[4653,4654,4655,4656,4657,4658,4659],"chr_0035_liino_attack1","chr_0035_liino_attack2","chr_0035_liino_attack3","chr_0035_liino_attack4","chr_0035_liino_attack5","chr_0035_liino_power_attack","chr_0035_liino_plunging_attack_end","chr_0035_liino_NormalSkill",{"_4625":4080,"_4626":4080,"_4627":4080,"_4628":4080,"_4629":4080,"_4630":4080,"_4631":4080,"_4632":4080,"_4633":4080,"_4634":4080,"_4635":4080,"_4636":4080,"_4637":4662,"_4639":4663,"_19":4664,"_4642":4660,"_4643":39,"_4644":4665},"对敌人造成<@ba.pulse>电磁伤害</>，随后进入<@ba.key>演唱姿态</>，期间若附近有敌人，则每隔一段时间追加攻击，对敌人造成<@ba.pulse>电磁伤害</>。\n<@ba.key>演唱姿态</>：持续期间提升全队攻击力，并在进入战斗后持续<@ba.heal>治疗</>范围内干员。\n<@ba.info>持续期间战技替换为姿态中止，施放将提前结束演唱姿态且不消耗技力，战技进入短暂冷却。</>","icon_skill_liino_01","闪耀焦点",[4666,4667,4668],"chr_0035_liino_normal_skill","chr_0035_liino_normal_skill_end","chr_0035_liino_normal_skill_combo","chr_0035_liino_UltimateSkill",{"_4625":4080,"_4626":4080,"_4627":4080,"_4628":4080,"_4629":4080,"_4630":4080,"_4631":4080,"_4632":4080,"_4633":4080,"_4634":4080,"_4635":4080,"_4636":4080,"_4637":4671,"_4639":4672,"_19":4673,"_4642":4669,"_4643":55,"_4644":4674},"<@ba.heal>治疗</>全队，同时进入<@ba.key>高歌姿态</>，持续释放舞台焰火造成<@ba.pulse>电磁伤害</>，随后引发<@ba.key>华彩爆点</>，对大范围内的敌人造成<@ba.pulse>电磁伤害</>，并强制施加<#ba.conduct>导电</>。\n<@ba.key>高歌姿态</>：代替<@ba.key>演唱姿态</>，持续期间提升全队攻击力，并施加受意志提升的<#ba.pulseenhance>电磁增幅</>和<#ba.naturalenhance>自然增幅</>。歌声对范围内的敌人持续造成<@ba.pulse>电磁伤害</>，并持续<@ba.heal>治疗</>范围内的友方干员。结束时，对范围内敌人造成3倍单次歌声伤害，并为全队回复3倍单次治疗量的生命值，提前结束时该效果不会生效。\n<@ba.info>持续期间战技替换为姿态中止，施放将提前结束高歌姿态且不消耗技力。</>","icon_ultimate_skill_liino_01","晨星的