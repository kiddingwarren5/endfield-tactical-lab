6":58,"_38":37},{"_36":60,"_38":3907},1.48469387755102,{"_36":62,"_38":3909},1.24234693877551,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":68},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3929,"_101":64},{"_33":3930},[3931,3933,3935,3937,3939,3941,3943,3945,3946,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966],{"_36":37,"_38":3932},97,{"_36":41,"_38":3934},96.16494845360825,{"_36":44,"_38":3936},129.8782242794028,{"_36":47,"_38":3938},98.35051546391752,{"_36":50,"_38":3940},190.22638333684046,{"_36":39,"_38":3942},5888,{"_36":55,"_38":3944},331,{"_36":58,"_38":37},{"_36":60,"_38":3947},1.48979591836735,{"_36":62,"_38":2011},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":68},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":3968,"_101":64},{"_33":3969},[3970,3972,3974,3976,3978,3980,3982,3984,3985,3987,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006],{"_36":37,"_38":3971},98,{"_36":41,"_38":3973},97.0721649484536,{"_36":44,"_38":3975},131.07519461392835,{"_36":47,"_38":3977},99.2783505154639,{"_36":50,"_38":3979},191.97917104986382,{"_36":39,"_38":3981},5944,{"_36":55,"_38":3983},334,{"_36":58,"_38":37},{"_36":60,"_38":3986},1.49489795918367,{"_36":62,"_38":3988},1.24744897959184,{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":68},{"_36":97,"_38":98},{"_36":100,"_38":39},{"_31":4008,"_101":64},{"_33":4009},[4010,4011,4013,4015,4017,4019,4021,4023,4024,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044],{"_36":37,"_38":963},{"_36":41,"_38":4012},97.97938144329896,{"_36":44,"_38":4014},132.27216494845393,{"_36":47,"_38":4016},100.2061855670103,{"_36":50,"_38":4018},193.73195876288716,{"_36":39,"_38":4020},6000,{"_36":55,"_38":4022},337,{"_36":58,"_38":37},{"_36":60,"_38":4025},1.5,{"_36":62,"_38":2049},{"_36":64,"_38":39},{"_36":66,"_38":39},{"_36":68,"_38":39},{"_36":70,"_38":39},{"_36":72,"_38":39},{"_36":74,"_38":39},{"_36":76,"_38":37},{"_36":78,"_38":37},{"_36":80,"_38":37},{"_36":82,"_38":37},{"_36":84,"_38":37},{"_36":86,"_38":37},{"_36":88,"_38":39},{"_36":90,"_38":91},{"_36":93,"_38":66},{"_36":95,"_38":68},{"_36":97,"_38":98},{"_36":100,"_38":39},"charBattleTagIds",[4047,4048],"tag_06","tag_09","charId","charIllustInitPos",{"_4052":4053,"_4054":4055},"x",-131,"y",-120,"charPassiveUIPrefabName","OverlayInfoNodeLiino","charTypeId","Pulse","cvName",{"_4062":4063,"_4064":4065,"_4066":4067,"_4068":4069,"_4049":16},"ChiCVName","多多poi","EngCVName","Maddie Matsumoto","JapCVName","佐佐木李子","KorCVName","金真娥","defaultWeaponId","wpn_lance_0009","department","ENDFIELD INDUSTRIES","dontInterruptCombo",true,"engName","Liino","mainAttrType","phoneticName","","profession","profileRecord",[4084,4095,4100,4105,4111,4116],{"_4049":16,"_15":4085,"_4086":4087,"_4088":4089,"_4090":39,"_4091":4092,"_4093":37,"_4094":37},"chr_0035_liino_1","recordDesc","【代号】梨诺\n【性别】女\n【身份认证】环塔商会\n【生日】7月27日\n【种族】萨卡兹\n【矿石病感染情况】\n参照医学检测报告，确认为感染者。\n\n【综合体检测试】\n生理强度：普通\n作战技巧：普通\n战术规划：标准\n源石技艺适应性：优良\n\n尽管梨诺对此并不介意，但鉴于其本人作为偶像的知名程度，我们强烈建议加强相关档案的保密工作，以便降低某些意外状况发生的可能性。\n——人事部干员","recordID","CN_01","recordIndex","recordTitle","基础档案","unlockType","unlockValue",{"_4049":16,"_15":4096,"_4086":4097,"_4088":4098,"_4090":55,"_4091":4099,"_4093":37,"_4094":37},"chr_0035_liino_2","干员梨诺，文明环带流行文化圈当前风头正盛的新锐偶像，被称为“菈梵朵玛的晨星”。因私人原因加入终末地工业，目前负责终末地的部分对外交流与宣传工作。\n\n作为一位具备较高人气的演艺界人士，干员梨诺显然比大多数人想象中的偶像艺人要易于相处得多。尽管她偶尔也会为了达成一些个人目的（如争取帝江号部分区域的使用许可），刻意以相对柔弱的姿态与一些工程中心的干员进行交流，但经过佩丽卡监督的友善提醒后，此类情况已大幅减少。\n需要注意的是，虽然梨诺并不乐于谈及她的家庭情况，但经由她提交的档案我们得知，她的父母早在她8岁时便在一次意外中不幸去世，她本人则是那次意外中唯一的幸存者。\n而关于她那位同为笞心魔的母亲——在与“筑桥者”弗莱明先生进行简短沟通后，可以确定她一样出身塞什卡，但在成年后不久便主动脱离了家族，此后杳无音信。\n而鉴于“笞心魔传闻”给梨诺带来的“一点小麻烦（本人描述）”，弗莱明先生也借此契机和她洽谈了合作事宜。关于他们最终究竟达成了怎样的共识，我们不得而知。只是从梨诺此后更为大胆的演出风格转变与“笞心魔传闻”被逐渐淡化的迹象来看，想必当时的结论应该让双方都十分满意。\n尽管如此，我们依然无法判断干员梨诺在未来还想以怎样的方式继续扩张她的演出事业，但或许就像她本人所说的那样——\n“以后的事？嗯哼，还是等我把剩下的几十场巡回演唱会全开完了再说吧！”\n——终末地人事助理 马丁·马文·马伦","CN_02","人事简述",{"_4049":16,"_15":4101,"_4086":4102,"_4088":4103,"_4090":58,"_4091":4104,"_4093":37,"_4094":37},"chr_0035_liino_3","加入终末地后，梨诺小姐仍旧将大部分时间与精力投在了她本人的演出计划中，但即便如此，对于所有经管理员转交给她的工作（包括协同情报办公室的干员完成部分合作方的考察等等），她依然秉持了极强的热情与专业度，完成得十分出色。\n但医疗部干员也曾多次反馈，梨诺小姐在饮食与作息方面的不规律程度已经远远超出普通干员的最高水平，并且常常因其行程安排密度而发生极大波动。与她有过工作接触的干员逐渐意识到，梨诺小姐无论在舞台演出的实际效果上，还是在已承接工作的完成情况上，都有着过于完美主义的一面，以至于很难接受细节上的瑕疵。为了达成她心中理想的效果或是结局，她十分乐于不厌其烦地精益求精，直至自己满意为止。\n作为代价，医疗部每隔一段时间都会委派专员对梨诺小姐近期的生活规律程度进行评估，然后在管理员的劝说下，获得她短期内的配合。\n\n天啊……从她开始改那份企划书到现在已经快30个小时了！难道笞心魔能不睡觉吗？\n——某位曾与梨诺合作过的匿名干员\n\n准点睡觉？按时吃饭？哎呀，这些事相比我想追求的理想舞台……根本不值一提啦！\n——梨诺","CN_03","档案资料·一",{"_4049":16,"_15":4106,"_4086":4107,"_4088":4108,"_4090":64,"_4091":4109,"_4093":64,"_4094":4110},"chr_0035_liino_4","我一向对自己的记忆力缺乏自信，也没有写日记的习惯。\n只是，当我回到自己在艾什柏环岛的住所，从行李箱里拿出那张梨诺小姐亲笔签名的专辑，还是回想起了见面会那天的美好时光，于是忍不住拿起笔写下了这篇记录。\n\n在这场见面会之前，我并没去过菈梵朵玛。这次虽然提前一个月就订好了酒店，仍然花了不少时间才在导航与一位好心菲林的帮助下，找到了酒店大门。最近大概有很多客人都是像我这样的粉丝，接待我的前台小姐一眼认出了我背包上的梨诺玩偶，轻车熟路地告诉了我前往见面会的最佳路线，还十分热情地推荐了一家会场附近的咖啡店——\n“就是梨诺小姐在访谈里称赞的那家哦，可以试试他们最经典的那款。”\n等到第二天进场的时候，几乎每个人手里都拿了一杯那家店的经典款，而我也早早买了一杯，安静且毫不突兀地混进了这些同好之中，丝毫没有暴露我其实从没看过梨诺小姐访谈的事实。\n是的，和身边这些看起来非常年轻的忠实粉丝不同，我仅仅是个听过几首歌就喜欢上了梨诺小姐的普通粉丝，在她之前从未对偶像产生过兴趣，更没去过什么见面会。此时此刻的一切，对我来说都是如此地神秘且新奇。\n所以，当梨诺小姐接过我诚惶诚恐递过去的礼物，非常亲切地喊出我的名字，握着我的手说道：\n“Twinkle-twinkle！我记得你！在沥青环岛的长途汽车站，是你帮梨诺办好了通行证，对不对？”\n我听了，讷讷地点了点头，原本想好的话语一句都没能说出口，只是茫然地做出了答谢——\n“谢谢，我很高兴能帮上您……”\n更高兴能听到您当时即兴唱的那首歌——然而最终我还是没能把这句心声讲出来。\n但她仿佛听见了我心底的声音，非常自然地接了话。\n“你还记得那首歌吗？是梨诺下张专辑里的曲子哦！要是喜欢的话，可以来听我下个月的演唱会，梨诺会在现场把完整版唱给大家听的！”\n说完，她就将不知何时已经签好的专辑送到了我的手中，笑着再次开口：\n“希望到时候还能见到你，伊芙琳！”\n\n现在回想起来，简直就像做梦一样。\n我想我终于理解了那些狂热粉丝们的心情，在望着一颗那么闪耀的星星时，真的很难不去想“要是能再看一次就好了”。\n由衷地希望还能与梨诺小姐再次相见——不管是在菈梵朵玛、新蓝卡坞、塞梦珂，还是更遥远的地方，我肯定都会去的。\n肯定。\n\n——一位之后为了梨诺孤身前往四号谷地的客运站文员的《记一次见面会》","CN_04","档案资料·二",300,{"_4049":16,"_15":4112,"_4086":4113,"_4088":4114,"_4090":66,"_4091":4115,"_4093":64,"_4094":4110},"chr_0035_liino_5","《走红疑云！究竟是大众的集体选择，还是笞心魔带来的空洞幻觉？》\n近日，一位来自菈梵朵玛，名叫“梨诺”的新锐偶像逐渐走进大众视野。据悉，她目前正以极其夸张的速度刷新各大传媒榜单上的排名，其粉丝团也从最初的数百人急速增长到上万人。\n该偶像的出道专辑《环塔飞行超音速》目前已因众人抢购而宣告脱销，而她即将在菈梵朵玛举办的第一场演唱会如今更是一票难求。\n但与此同时，笔者在整理资料时发现，该偶像“笞心魔”的身份，也让她的爆火遭到了大量质疑。有知情人表示，他的姐姐仅仅是听了一首梨诺的歌后就狂热地喜欢上了这位偶像，而在这之前他姐姐一直对偶像毫无兴趣。类似的指控在最近几天层出不穷，甚至有人猜测是该偶像在自己的歌声中施放了某种古老的笞心魔巫术——尽管学界尚缺乏对于这类“可录制保存的巫术”的研究证明，但这不失为一种具有较高可信度的猜测。\n因此笔者有理由认为，偶像梨诺的爆火极有可能只是大集团的运营搭配笞心魔巫术的商业炒作成果，其本身真正的实力与她造成的影响或许并不相称。\n塔卫二的传统偶像业界竟会沦落至此，这其中的内幕实在引人深思。\n——《周刊艺术》第143期星闻专栏\n\n《震惊！业内知情人揭秘：某知名偶像首次演唱会遭专业人士质疑！》\n就在上个月，文明环带如今最出名的新锐偶像梨诺，在菈梵朵玛的海岸边完成了她的第一场演唱会。\n据悉，梨诺本次以“颠覆‘舞台’”为主题，力求突破传统演唱会场地固定、内容固定的框架，在演出过程中加入了大量颇具挑战性的表演内容。\n根据最终的票务数据，本次演唱会显然大获成功，但也有不少知名乐评人未能认可——如路易斯·怀森先生，对她的这次演出给出了如下评价：\n“……似乎太过花哨了，在技巧上还有不少改进空间。”\n由此看来，这位新锐偶像在演唱技巧上似乎还存在较大的不足，她独具特色但过于花哨的现场表演也难以弥补这一点。\n笔者对此深感痛心，一位有追求且具备一定专业素养的偶像居然会有如此瑕疵，令人惋惜！\n望业内其他新锐偶像能引以为戒，更多地打磨自身业务水平，毕竟只专注粉丝活动的偶像注定无法走得长远。\n——《周刊艺术》第151期星闻专栏\n\n《恐为误解？偶像梨诺近日在行业专访上进行澄清》\n最近，大名鼎鼎的新锐偶像梨诺再度接受了菈梵朵玛唱片业协会的专访，访谈中她与记者畅谈了近三十分钟，着重回答了近期的争议性问题与之后的演出安排。\n其中，对于自身的笞心魔身份，梨诺的态度似乎比想象中更为坦诚，她并未回避，反而直白地表明了自己对质疑的接纳。而针对演出风格的评价，梨诺也表现出相当的包容，表示愿意接受所有观众发自内心的建议，并会在此基础上继续精进自己的业务能力。\n不得不承认，在观看了本次专访后，笔者也对梨诺有了些许改观，之后或许会进一步对其此后的创作进行一定研究，看她是否有履行她的“诺言”。\n特别声明：本文撰写于梨诺最新一次粉丝见面会之前，笔者的观点并未受梨诺在现场诚挚感谢《周刊艺术》编辑部一事的影响，望周知。\n——《周刊艺术》第155期星闻专栏\n\n《梨诺首次公布新歌〈新蓝卡坞的星光〉小样，播放次数已破百万》\n本周日，备受广大粉丝期待的梨诺小姐终于公布了她下一张专辑的主打曲目——《新蓝卡坞的星光》的最新歌曲小样。\n据悉，这是梨诺将传统古典音乐旋律与当代流行音乐编曲进行融合的首次尝试，她又一次完成了自身风格的突破，不少粉丝纷纷惊叹：“不愧是梨诺小姐！太好听了！”\n目前，《新蓝卡坞的星光》小样版本的播放次数已破百万。而笔者相信，等到正式版本，梨诺还会为大家带来更多的惊喜。\n——《周刊艺术》第158期星闻专栏\n\n《“晨星”即将降落于四号谷地！慰问演唱会受万众期待！》\n塔卫二当下最热门的新锐偶像梨诺，似乎正打算前往四号谷地。知情人表示，她将会作为特邀嘉宾，参与由布莱迪矿业集团牵头的慰问演出活动，在当地举办一场个人演唱会。\n众所周知，梨诺在前几次演唱会中展示的演出风格与音乐素养，都受到了众多粉丝与专业人士的认可，相信这一次她也会为大家带来更闪耀、更特别的体验。\n据悉，售票渠道将在本月底于梨诺的个人网站上公开，届时可前去了解详情。\n——《周刊艺术》第160期星闻专栏","CN_05","档案资料·三",{"_4049":16,"_15":4117,"_4086":4118,"_4088":4119,"_4090":68,"_4091":4120,"_4093":64,"_4094":4121},"chr_0035_liino_6","当梨诺第一次见到那位被尊称为“筑桥者”的弗莱明先生时，她立刻意识到——他是专程找上门的。\n有别于大多数人过分鲜明的红与黑、蓝与黄，梨诺有些戒备地一眼望去，竟然在这位据说来自巫术时刻的发言人身上，看到了至少三种色彩——\n忧郁的蓝色、惋惜的绿色与神秘的紫色。\n它们共同构成了一份难以轻易解读的心象，让向来敏锐的她都陷入了短暂的困惑。\n弗莱明似乎也发现了这点，了然地颔首。\n“你明明是个非常有天赋的笞心魔……却没有在演出里用过一次自己的能力。是因为芙蕾达的教导吗？”\n彼时，梨诺有过一瞬间的恍惚。\n她都忘了自己有多久没有从旁人口中听到这个名字了，这个……属于母亲的名字。\n当然，身为一向追求完美的偶像，她实在积累了太多应对突发状况的经验，不管是过去还是现在。\n于是也只是这么一瞬，她便毫无畏惧地与弗莱明对视，目光直接且锐利，仿佛是想就此看穿他的内心。\n“……你又是什么人？为什么会知道这个名字？”\n弗莱明露出一个平和的笑容，并不介意她毫不客气地发问，反而饶有兴致地环顾了这个作为后台的房间。他有些感慨地说道：\n“只是个偶尔还会怀念她琴声的老友。我还记得她很喜欢莱塔尼亚的古典音乐，曾经委托我们收集了不少从泰拉带过来的乐谱。\n“后来……后来就被她全部带走了——为了跟一个梅什科工业的黎博利远走高飞，她居然就那样割舍了其他，义无反顾地离开了家乡……一眨眼，都二十多年了啊。”\n梨诺看着弗莱明身上的色彩逐渐泛黄，如同那些过去深受母亲喜爱，现今被她珍藏的老乐谱，心情忽然变得更加复杂。\n“弗莱明先生，难道你来这里……只是专门找我叙旧的吗？”\n弗莱明摇摇头。\n“不，或者说不仅如此。我只是在为我们接下来或许有幸达成的合作关系做一个有点温度的开场白，以免一些戒心太重的合作伙伴还不等我说到正题，就贸然拒绝。”\n“合作？……和谁？巫术时刻吗？”\n“作为巫术时刻的高级商业顾问，我当然乐于与你这样的顶级偶像进行合作。但为什么——不更进一步呢？”\n“你是说……塞什卡？”\n“呵呵，你果然很像你的母亲……和聪明人谈话总能省下我不少事。没错，无论是‘笞心魔传闻’这样的烦心事，还是与各地势力的斡旋……对于这些影响你完美演出的不确定因素，塞什卡愿意为可爱的梨诺小姐给予可观的帮助。”\n“那代价呢？与你们……与塞什卡合作后，我需要付出什么？”\n“虽然我很想说梨诺小姐本身，就是最大的‘价值’，但——想必这不会是你希望听到的答案吧？一些信息、一些渠道，乃至一些关系……这个答案如何？”\n“……”\n“好了，现在能告诉我你的选择了吗？”","CN_06","档案资料·四",1500,"profileVoice",[4124,4132,4136,4140,4144,4148,4152,4157,4162,4167,4172,4177,4182,4187,4192,4197,4202,4207,4212,4217,4222,4227,4232,4237,4242,4247,4252,4257,4262,4267,4272,4277,4282,4287,4292,4297,4302,4307,4312,4317,4322,4327,4332,4337,4342,4347,4352,4357,4362,4367,4372,4377,4382,4387,4392,4397,4402,4407,4412,4417,4422,4427,4433,4439,4445,4450,4456,4462,4467,4473,4478,4484,4490,4496,4502,4508,4513,4519,4524,4529,4535],{"_4049":16,"_15":4085,"_4093":37,"_4094":37,"_4125":4126,"_4127":4128,"_4129":39,"_4130":4131},"voId","chr_0035_liino_chrbark_squad_01","voiceDesc","嗯嗯？可以上台了吗？","voiceIndex","voiceTitle","行动准备1",{"_4049":16,"_15":4096,"_4093":37,"_4094":37,"_4125":4133,"_4127":4134,"_4129":55,"_4130":4135},"chr_0035_liino_chrbark_squad_02","Twinkle-twinkle！新的演出马上开始！","行动准备2",{"_4049":16,"_15":4101,"_4093":37,"_4094":37,"_4125":4137,"_4127":4138,"_4129":58,"_4130":4139},"chr_0035_liino_chrbark_join_01","我可是舞蹈、演唱、临场应变都拿满分的全能偶像！","编入队伍1",{"_4049":16,"_15":4106,"_4093":37,"_4094":37,"_4125":4141,"_4127":4142,"_4129":64,"_4130":4143},"chr_0035_liino_chrbark_join_02","无论在哪里，我都想成为最引人注目的那颗星星！","编入队伍2",{"_4049":16,"_15":4112,"_4093":37,"_4094":37,"_4125":4145,"_4127":4146,"_4129":66,"_4130":4147},"chr_0035_liino_chrbark_weap_01","可以帮我挑一件吗？最好能让不擅长战斗的人也能轻松上手！","更换武器",{"_4049":16,"_15":4117,"_4093":37,"_4094":37,"_4125":4149,"_4127":4150,"_4129":68,"_4130":4151},"chr_0035_liino_chrbark_gear_01","我还是头一次穿这样的演出服……唔，要不要再设计下配套的动作？","更换装备",{"_4049":16,"_15":4153,"_4093":37,"_4094":37,"_4125":4154,"_4127":4155,"_4129":70,"_4130":4156},"chr_0035_liino_7","chr_0035_liino_chrup_skill_01","咻的一下就理解了！像是星星跳进了心里……是不是让我变得更耀眼了？","激活天赋阵列",{"_4049":16,"_15":4158,"_4093":37,"_4094":37,"_4125":4159,"_4127":4160,"_4129":88,"_4130":4161},"chr_0035_liino_8","chr_0035_liino_chrup_level_01","这个登场方式——真的不能用在我下次的演出里吗？呜哇，好遗憾……","观看作战记录",{"_4049":16,"_15":4163,"_4093":55,"_4094":39,"_4125":4164,"_4127":4165,"_4129":90,"_4130":4166},"chr_0035_liino_9","chr_0035_liino_chrup_promt01_01","好感动！我该怎么答谢这份信赖才好……唔，再多给你几张下次演出的门票，怎么样？","精英化晋升1",{"_4049":16,"_15":4168,"_4093":55,"_4094":55,"_4125":4169,"_4127":4170,"_4129":410,"_4130":4171},"chr_0035_liino_10","chr_0035_liino_chrup_promt02_01","欸？这样就可以了吗？我还以为会像跟事务所签续约合同一样，追加一大堆条件……老实说，有点不习惯……","精英化晋升2",{"_4049":16,"_15":4173,"_4093":55,"_4094":58,"_4125":4174,"_4127":4175,"_4129":100,"_4130":4176},"chr_0035_liino_11","chr_0035_liino_chrup_promt03_01","嗯哼，彻底拜倒在我的魅力下了吗？终于开窍——欸？什么叫“今后终末地的宣传也靠你了”？重点是这个吗？！","精英化晋升3",{"_4049":16,"_15":4178,"_4093":55,"_4094":64,"_4125":4179,"_4127":4180,"_4129":95,"_4130":4181},"chr_0035_liino_12","chr_0035_liino_chrup_promt04_01","管理员，我决定了，以后你就是我巡演的常驻特邀嘉宾啦！这样一来，我的任何一次“闪耀时刻”，你都不会错过！怎么样？是不是很感动？到时可要好好看着我！要是我发现你走神了……哼哼！","精英化晋升4",{"_4049":16,"_15":4183,"_4093":37,"_4094":37,"_4125":4184,"_4127":4185,"_4129":527,"_4130":4186},"chr_0035_liino_13","chr_0035_liino_introduce_01","管理员，好久不见呀！欸？作为全塔卫二最闪耀可爱的第一偶像，梨诺正式加入终末地——居然没有什么特别优待吗？真是的……你果然还是老样子，坦率到让人想讨厌都讨厌不起来呢……","干员报到",{"_4049":16,"_15":4188,"_4093":37,"_4094":37,"_4125":4189,"_4127":4190,"_4129":566,"_4130":4191},"chr_0035_liino_14","chr_0035_liino_mono_switch_01","嘿嘿，这个姿势也很可爱吧？","待命1",{"_4049":16,"_15":4193,"_4093":37,"_4094":37,"_4125":4194,"_4127":4195,"_4129":97,"_4130":4196},"chr_0035_liino_15","chr_0035_liino_mono_switch_02","啦——啦啦——试音完毕，可以开始啦！","待命2",{"_4049":16,"_15":4198,"_4093":37,"_4094":37,"_4125":4199,"_4127":4200,"_4129":872,"_4130":4201},"chr_0035_liino_21","chr_0035_liino_sim_assign_work_01","能在这里多放两个音响吗？一个也行！让我试试扩声效果就好……","进驻设施",{"_4049":16,"_15":4203,"_4093":37,"_4094":37,"_4125":4204,"_4127":4205,"_4129":911,"_4130":4206},"chr_0035_liino_22","chr_0035_liino_sim_hello_lower_01","管理员，你好呀！要陪我去看演出场地吗？","打招呼1",{"_4049":16,"_15":4208,"_4093":64,"_4094":4110,"_4125":4209,"_4127":4210,"_4129":951,"_4130":4211},"chr_0035_liino_23","chr_0035_liino_sim_hello_max_01","我正找你呢，管理员！快来听我的新歌小样！","打招呼2",{"_4049":16,"_15":4213,"_4093":37,"_4094":37,"_4125":4214,"_4127":4215,"_4129":990,"_4130":4216},"chr_0035_liino_24","chr_0035_liino_sim_talk_lv01_01","管理员，是来看我的进场排练吗？这次我专门设计了两个特别难的滑翔动作，总算是练好了！嘿嘿，别担心，我提前就给你留好位置啦！","帝江号闲聊1",{"_4049":16,"_15":4218,"_4093":64,"_4094":4110,"_4125":4219,"_4127":4220,"_4129":62,"_4130":4221},"chr_0035_liino_25","chr_0035_liino_sim_talk_lv02_01","帝江号真的好大！第一次来的时候，真是把我都吓了一跳！当时我就在想——“啊，要是能让我在这里开一场太空主题的个人演唱会，该多好！”你说是不是，管理员？","帝江号闲聊2",{"_4049":16,"_15":4223,"_4093":64,"_4094":4110,"_4125":4224,"_4127":4225,"_4129":1068,"_4130":4226},"chr_0035_liino_26","chr_0035_liino_sim_talk_lv02_02","哼哼，这回又拿到了一个不错的赞助！看来下场演出可以试试新方案了……嗯？比如把舞台搭成环形的结构，然后彻底去掉观众席，让每一个来看演出的人都成为演出的一分子——听起来是不是很有意思？","帝江号闲聊3",{"_4049":16,"_15":4228,"_4093":64,"_4094":4121,"_4125":4229,"_4127":4230,"_4129":1108,"_4130":4231},"chr_0035_liino_27","chr_0035_liino_sim_talk_max_01","真是的，受不了那些整天乱编萨卡兹笞心魔能力的家伙了！怎么可能做到“对你笑一下，你就会乖乖掏钱了”啊？要是我真有这种能力……管理员，保持这样别动，就看着我的脸！现在有把零花钱全交给我的冲动了吗？","帝江号闲聊4",{"_4049":16,"_15":4233,"_4093":64,"_4094":4121,"_4125":4234,"_4127":4235,"_4129":1147,"_4130":4236},"chr_0035_liino_28","chr_0035_liino_sim_talk_max_02","当初筹备第一场演出的时候，我接连七天都没睡好，整天不是在练歌，就是在检查我的舞台方案，直到上台前都很紧张，生怕出一点纰漏。但最后——看着观众们惊喜的目光，我忽然觉得之前付出的一切……还蛮值得的。","帝江号闲聊5",{"_4049":16,"_15":4238,"_4093":64,"_4094":4121,"_4125":4239,"_4127":4240,"_4129":1187,"_4130":4241},"chr_0035_liino_29","chr_0035_liino_sim_talk_max_03","管理员，你说我下次演出安排在哪里呢？新蓝卡坞那个空中舞台挺有趣的，新都筑的演歌馆也不错，至于菈梵朵玛……直接在海上演出怎么样？应该很有话题度。嗯？为什么都是商会的城市？啧，那当然是为了能多赚一点！","帝江号闲聊6",{"_4049":16,"_15":4243,"_4093":37,"_4094":37,"_4125":4244,"_4127":4245,"_4129":56,"_4130":4246},"chr_0035_liino_30","chr_0035_liino_sim_gift_give_01","欸嘿，这是我在采风路上专门为你挑选的伴手礼！你就心满意足地收下吧。","赠送礼物",{"_4049":16,"_15":4248,"_4093":37,"_4094":37,"_4125":4249,"_4127":4250,"_4129":1265,"_4130":4251},"chr_0035_liino_31","chr_0035_liino_sim_gift_recv_01","虽然收到过各式各样的礼物，但从你那里得到的……总感觉更特别一点。","接收礼物",{"_4049":16,"_15":4253,"_4093":37,"_4094":37,"_4125":4254,"_4127":4255,"_4129":47,"_4130":4256},"chr_0035_liino_41","chr_0035_liino_mono_self_line01","每结束一场演出，我都会兴奋好一阵！嗯，就像工匠们打造出足够锋利的兵器一样，区别只在于……好兵器会被用来粉碎他人的心，但好演出却能让人看清自己的心。","信赖对话1",{"_4049":16,"_15":4258,"_4093":64,"_4094":4110,"_4125":4259,"_4127":4260,"_4129":50,"_4130":4261},"chr_0035_liino_42","chr_0035_liino_mono_self_line02","“真心”——是我一直在用的香水的名字哦。我很喜欢它的味道，紫丁香配上些许蔷薇的芬芳，开场盛大而梦幻，最后偏偏却以杉木的苦味收尾……所以，才格外让人难忘，不是吗？","信赖对话2",{"_4049":16,"_15":4263,"_4093":64,"_4094":4110,"_4125":4264,"_4127":4265,"_4129":232,"_4130":4266},"chr_0035_liino_43","chr_0035_liino_mono_self_line03","因为我笞心魔的身份，外界传过好多夸张的说法，像是“歌声里的源石技艺会操控心灵”“演出用的巫术装置能把观众变为傀儡”……可管理员，你知道吗？我在耳环与发卡上施的巫术，反而是遏制笞心魔能力的。我才不允许最重要的舞台上出现与演出无关的“瑕疵”……哪怕是这份与生俱来的力量。","信赖对话3",{"_4049":16,"_15":4268,"_4093":64,"_4094":4121,"_4125":4269,"_4127":4270,"_4129":1801,"_4130":4271},"chr_0035_liino_44","chr_0035_liino_mono_self_line04","小时候，我的梦里有一朵美丽又芬芳的紫色玫瑰，它和一艘云朵一样的白船陪伴着我，在漫无边际的天空中飞呀飞，和我讲述着星星的故事……某一天，红色的风暴出现了，白船被掀翻，与玫瑰一起掉进了漆黑的漩涡里。后来？后来我一个人醒来了呀……从此就再没做过梦了。","信赖对话4",{"_4049":16,"_15":4273,"_4093":64,"_4094":4121,"_4125":4274,"_4127":4275,"_4129":1841,"_4130":4276},"chr_0035_liino_45","chr_0035_liino_mono_self_line05","我一直觉得世界就是个大一些的舞台，只是要耗费更多的“心”才能驾驭。大家不过是为了喝彩声而努力表演，我也不例外。但偶尔，只是偶尔……即使是我，也会想偷个懒呢。所以管理员，能让我再在这儿多待一会儿吗？好像就只有在你身边的时候，感觉能松懈一点……真奇妙啊。","信赖对话5",{"_4049":16,"_15":4278,"_4093":37,"_4094":37,"_4125":4279,"_4127":4280,"_4129":270,"_4130":4281},"chr_0035_liino_46","chr_0035_liino_mono_chat_line01","怎么又有这种需要背稿子才方便答的“现场问题”啊……唉，都好几次了，问的一堆问题还是围绕我出道时的事。在这些节目组心里，一个没上过选秀节目，直接被星探发掘，出道后立马走红，只凭个人的努力就走到这一步的偶像，莫非就这么难以置信吗？","交谈1",{"_4049":16,"_15":4283,"_4093":37,"_4094":37,"_4125":4284,"_4127":4285,"_4129":1919,"_4130":4286},"chr_0035_liino_47","chr_0035_liino_mono_chat_line02","和粉丝互动也好，上台演出也好……对我而言，都是需要全力以赴的事。尤其是面对粉丝的时候，绝对不能够让大家留下任何的遗憾，务必要为他们送上一场醒来后依然会觉得幸福的梦才可以。所以就算已经累到能站着睡着了，我也总会坚持到最后一名粉丝离场了才喝水休息……这就是偶像应尽的义务。","交谈2",{"_4049":16,"_15":4288,"_4093":37,"_4094":37,"_4125":4289,"_4127":4290,"_4129":72,"_4130":4291},"chr_0035_liino_48","chr_0035_liino_mono_chat_line03","我确实受过那种“绝对不能提这些话题”的培训。不过，如果是和你说……应该没问题吧？比如，其实我作息时间一点都不规律，老是熬夜，还不按时吃饭，经常为了争取更好的舞台效果让工作人员头疼。真是的，这么说出来总觉得更不好意思了……作为交换，也和我说说你的事吧，管理员？","交谈3",{"_4049":16,"_15":4293,"_4093":37,"_4094":37,"_4125":4294,"_4127":4295,"_4129":60,"_4130":4296},"chr_0035_liino_49","chr_0035_liino_mono_chat_line04","平时喜欢的放松方式？如果是别人来问，那肯定要回答“听音乐”之类的安全选项啦。其实我更喜欢睡觉，经常一睡就是十几个小时，有一次把新来的工作人员都吓到了，她当时完全叫不醒我……还好那天我的经纪人在，直接冲进来大喊了一声“演出十秒后开始——”，然后还没等她数到九，我就醒了。","交谈4",{"_4049":16,"_15":4298,"_4093":37,"_4094":37,"_4125":4299,"_4127":4300,"_4129":76,"_4130":4301},"chr_0035_liino_50","chr_0035_liino_mono_chat_line05","这个月我收到了上家事务所一位工作人员寄来的信件……他在信上说自己已经离职，想为之前在赞助商平白指责时没有维护我而道歉。但我其实没有怪过他。毕竟……他也只是为了那点养家的薪水才被迫选择那么做——和那些生活艰难的人们一样，没有谁是应该被责备的。","交谈5",{"_4049":16,"_15":4303,"_4093":37,"_4094":37,"_4125":4304,"_4127":4305,"_4129":78,"_4130":4306},"chr_0035_liino_51","chr_0035_liino_mono_about_line01","一开始，我不怎么反感商会的那些条条框框。但当我见过了更多的人，经历了更多的事，发现生活的真相不止一种的时候，我才意识到——原来就算是在商会的地盘，人们也未必只有一种活法；原来就算是在传统的舞台上，偶像也未必只有一种演出方式。","话题：环塔商会",{"_4049":16,"_15":4308,"_4093":37,"_4094":37,"_4125":4309,"_4127":4310,"_4129":80,"_4130":4311},"chr_0035_liino_52","chr_0035_liino_mono_about_line02","管理员，你觉得“偶像”是怎样的存在呢？我想，在每个人心里肯定都有一个属于自己的答案吧？至少对我来说，所谓的“偶像”只是一艘承载愿望的航船，只有航行到足够高的地方，才有履行“职责”的资格……而“我”一直以来的愿望都是——将名为“梨诺”的航船开往塔卫二的最高处，努力去照亮她承载的每一个愿望。","话题：偶像",{"_4049":16,"_15":4313,"_4093":37,"_4094":37,"_4125":4314,"_4127":4315,"_4129":82,"_4130":4316},"chr_0035_liino_53","chr_0035_liino_mono_about_line03","欸？你不觉得玩音乐游戏是一种很棒的解压方式吗？像我的话，就习惯在通告最密集的空隙打一些高难度的谱面。就算拿不到全完美判定，打完时也会有种神清气爽的感觉！不过我不太擅长下落式，还是习惯玩单轨的那种啦！比如《二郎达人》和《律动派对》，我都很喜欢！","话题：音乐游戏",{"_4049":16,"_15":4318,"_4093":37,"_4094":37,"_4125":4319,"_4127":4320,"_4129":84,"_4130":4321},"chr_0035_liino_54","chr_0035_liino_mono_about_line04","母亲在我很小的时候就告诫过我——“笞心魔”是很容易贪食他人心灵的一族，在尝试鞭笞他人心灵的时候，也千万不要忘记鞭笞自己的心……对于笞心魔而言，了解他人藏在心里的秘密就像吃饭喝水一样寻常，无须刻意便能轻松做到。于是我们总容易忘记，忘记对于他人而言，被随意探知内心从来不是件开心的事。","话题：笞心魔",{"_4049":16,"_15":4323,"_4093":37,"_4094":37,"_4125":4324,"_4127":4325,"_4129":86,"_4130":4326},"chr_0035_liino_55","chr_0035_liino_mono_about_line05","父母最后一次带我出门的那天，是当年那届黑曜石音乐节的第一日。夕阳很美，余晖染红了城市的边缘，而我望着大楼上最醒目的宣传海报，指着上面拿着麦克风的女孩子问母亲：“妈妈，我什么时候也能像她一样？”母亲笑着摸了摸我的头，第一次这么鼓励我：“会有那一天的。只要梨诺愿意，一定会成为菈梵朵玛最耀眼的那颗星。”","话题：菈梵朵玛",{"_4049":16,"_15":4328,"_4093":37,"_4094":37,"_4125":4329,"_4127":4330,"_4129":578,"_4130":4331},"chr_0035_liino_71","chr_0035_liino_explore_point_common_01","那边应该有什么……好让人在意！","发现资源1",{"_4049":16,"_15":4333,"_4093":37,"_4094":37,"_4125":4334,"_4127":4335,"_4129":2923,"_4130":4336},"chr_0035_liino_72","chr_0035_liino_explore_point_valub_01","咦？好像发现了很贵重的东西……说不定能大赚一笔？","发现资源2",{"_4049":16,"_15":4338,"_4093":37,"_4094":37,"_4125":4339,"_4127":4340,"_4129":2963,"_4130":4341},"chr_0035_liino_73","chr_0035_liino_explore_find_locked_01","是之前没来过的地方！唔，希望能遇到一点有趣的东西。","发现未探索区域",{"_4049":16,"_15":4343,"_4093":37,"_4094":37,"_4125":4344,"_4127":4345,"_4129":617,"_4130":4346},"chr_0035_liino_74","chr_0035_liino_explore_find_danger_01","哎呀，好像有没被邀请的大家伙出场了！","发现强敌",{"_4049":16,"_15":4348,"_4093":37,"_4094":37,"_4125":4349,"_4127":4350,"_4129":3041,"_4130":4351},"chr_0035_liino_75","chr_0035_liino_interact_mine_valub_01","哇，这样的矿物我只在百科全书上见过……","采集矿物1",{"_4049":16,"_15":4353,"_4093":37,"_4094":37,"_4125":4354,"_4127":4355,"_4129":3080,"_4130":4356},"chr_0035_liino_76","chr_0035_liino_interact_mine_valub_echo2_01","哼哼，是时候收集一些特别的动作素材了。","采集矿物2",{"_4049":16,"_15":4358,"_4093":37,"_4094":37,"_4125":4359,"_4127":4360,"_4129":656,"_4130":4361},"chr_0035_liino_77","chr_0035_liino_interact_treasure_valub_01","好棒的收获！值得为它追加十个聚光灯！","打开储藏箱",{"_4049":16,"_15":4363,"_4093":37,"_4094":37,"_4125":4364,"_4127":4365,"_4129":3158,"_4130":4366},"chr_0035_liino_78","chr_0035_liino_interact_etherium_01","欸？真正的醚质原来这么闪亮吗！应该会很值钱……","获得醚质",{"_4049":16,"_15":4368,"_4093":37,"_4094":37,"_4125":4369,"_4127":4370,"_4129":3198,"_4130":4371},"chr_0035_liino_79","chr_0035_liino_interact_blight_break_01","附近的一切都让人不舒服……我可不要在这种地方演出！","消除侵蚀",{"_4049":16,"_15":4373,"_4093":37,"_4094":37,"_4125":4374,"_4127":4375,"_4129":696,"_4130":4376},"chr_0035_liino_80","chr_0035_liino_interact_rest_01","现在算是幕间休息时间？呼，让我先喝几口水！马上就好！","休整",{"_4049":16,"_15":4378,"_4093":37,"_4094":37,"_4125":4379,"_4127":4380,"_4129":3697,"_4130":4381},"chr_0035_liino_91","chr_0035_liino_combat_suppuse_using_01","这就来帮你！","使用战术物品1",{"_4049":16,"_15":4383,"_4093":37,"_4094":37,"_4125":4384,"_4127":4385,"_4129":3736,"_4130":4386},"chr_0035_liino_92","chr_0035_liino_combat_suppuse_getheal_01","好温暖的感觉……","使用战术物品2",{"_4049":16,"_15":4388,"_4093":37,"_4094":37,"_4125":4389,"_4127":4390,"_4129":884,"_4130":4391},"chr_0035_liino_93","chr_0035_liino_combat_remind_danger_01","快躲开！可别硬撑！","危险提醒",{"_4049":16,"_15":4393,"_4093":37,"_4094":37,"_4125":4394,"_4127":4395,"_4129":3814,"_4130":4396},"chr_0035_liino_94","chr_0035_liino_combat_hurt_lowhp_01","呜，这种小瑕疵……","负伤",{"_4049":16,"_15":4398,"_4093":37,"_4094":37,"_4125":4399,"_4127":4400,"_4129":3854,"_4130":4401},"chr_0035_liino_95","chr_0035_liino_combat_dead_01","不甘心……明明再撑一下就……","力竭",{"_4049":16,"_15":4403,"_4093":37,"_4094":37,"_4125":4404,"_4127":4405,"_4129":923,"_4130":4406},"chr_0035_liino_96","chr_0035_liino_combat_remind_praise_01","哇，好想再看一次！","小队激励1",{"_4049":16,"_15":4408,"_4093":37,"_4094":37,"_4125":4409,"_4127":4410,"_4129":3932,"_4130":4411},"chr_0035_liino_97","chr_0035_liino_combat_remind_praise_02","什么时候能像你们一样……","小队激励2",{"_4049":16,"_15":4413,"_4093":37,"_4094":37,"_4125":4414,"_4127":4415,"_4129":3971,"_4130":4416},"chr_0035_liino_98","chr_0035_liino_combat_remind_praise_echo2_01","下回再一起共演吧！","回应激励1",{"_4049":16,"_15":4418,"_4093":37,"_4094":37,"_4125":4419,"_4127":4420,"_4129":963,"_4130":4421},"chr_0035_liino_99","chr_0035_liino_combat_remind_praise_echo2_02","和大家更有默契了！","回应激励2",{"_4049":16,"_15":4423,"_4093":37,"_4094":37,"_4125":4424,"_4127":4425,"_4129":1120,"_4130":4426},"chr_0035_liino_111","chr_0035_liino_combat_intobattle_01","呼……就这么上吧！Twinkle-twinkle！","作战开始1",{"_4049":16,"_15":4428,"_4093":37,"_4094":37,"_4125":4429,"_4127":4430,"_4129":4431,"_4130":4432},"chr_0035_liino_112","chr_0035_liino_combat_intobattle_echo2_01","一起清除“不和谐音”！",112,"作战开始2",{"_4049":16,"_15":4434,"_4093":37,"_4094":37,"_4125":4435,"_4127":4436,"_4129":4437,"_4130":4438},"chr_0035_liino_113","chr_0035_liino_combat_outbattle_nor_01","都说了我不擅长了……欸？结束了吗？",113,"作战胜利1",{"_4049":16,"_15":4440,"_4093":37,"_4094":37,"_4125":4441,"_4127":4442,"_4129":4443,"_4130":4444},"chr_0035_liino_114","chr_0035_liino_combat_outbattle_nor_02","圆满的谢幕！这也在我的预期内。",114,"作战胜利2",{"_4049":16,"_15":4446,"_4093":37,"_4094":37,"_4125":4447,"_4127":4448,"_4129":1159,"_4130":4449},"chr_0035_liino_115","chr_0035_liino_combat_outbattle_nor_echo2_01","不赖嘛，竟然跟上了我的节奏！","作战胜利3",{"_4049