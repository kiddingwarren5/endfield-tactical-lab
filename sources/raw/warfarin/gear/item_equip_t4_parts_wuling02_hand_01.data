,{"_15":1475,"_1099":1477,"_1102":1478},[1101,1101,1101],[1154,1154,1154],"sns.key",{"_15":1479,"_1099":1481,"_1102":1482},[1101,1101,1101],[1483,1483,1483],"<color=#169ED9>","fac.blue",{"_15":1484,"_1099":1486,"_1102":1487},[1101,1101,1101],[1488,1488,1488],"<color=#2f8baf>","gembox.num",{"_15":1489,"_1099":1491,"_1102":1492},[1101,1101,1101],[1493,1493,1493],"<color=#fff100>","gray.note",{"_15":1494,"_1099":1496,"_1102":1497},[1101,1101,1101],[1498,1498,1498],"<color=#7a7a7a>","ld.key",{"_15":1499,"_1099":1501,"_1102":1502},[1101,1101,1101],[1170,1170,1170],"nar.center",{"_15":1503,"_1099":1505,"_1102":1506},[1438,1438,1438],[1507,1507,1507],"<align=\"center\">","scene_grade.up",{"_15":1508,"_1099":1510,"_1102":1511},[1101,1101,1101],[1512,1512,1512],"<color=#ABCD47>","tech.key",{"_15":1513,"_1099":1515,"_1102":1516},[1101,1101,1101],[1154,1154,1154],"nar.clue",{"_15":1517,"_1099":1519,"_1102":1520},[1101,1101,1101],[1521,1522,1194],"<color=##333333>","<color=#f2f2f2>","nar.enter",{"_15":1523,"_1099":1525,"_1102":1526},[],[1527,1527,1527],"<br>","nar.left",{"_15":1528,"_1099":1530,"_1102":1531},[1438,1438,1438],[1532,1532,1532],"<align=\"left\">","nar.mark",{"_15":1533,"_1099":1535,"_1102":1537},[1536,1536,1536],"</color></mark>",[1538,1539,1538],"<mark=#444444><color=#44444400>","<mark=#E6E6E6><color=#E6E6E600>","qu.largenumdown",{"_15":1540,"_1099":1542,"_1102":1544},[1543,1543,1543],"</color></size>",[1545,1545,1545],"<size=54><color=#e74414>","nar.quote",{"_15":1546,"_1099":1548,"_1102":1550},[1549,1549,1549],"</i>",[1551,1551,1551],"<i>","nar.right",{"_15":1552,"_1099":1554,"_1102":1555},[1438,1438,1438],[1556,1556,1556],"<align=\"right\">","opt.key",{"_15":1557,"_1099":1559,"_1102":1560},[1101,1101,1101],[1561,1561,1561],"<color=#5ECDFF>","qu.numdown",{"_15":1562,"_1099":1564,"_1102":1565},[1101,1101,1101],[1566,1566,1566],"<color=#e74414>","toast_craft.key",{"_15":1567,"_1099":1569,"_1102":1570},[1101,1101,1101],[1154,1154,1155],"qu.numup",{"_15":1571,"_1099":1573,"_1102":1574},[1101,1101,1101],[1575,1575,1575],"<color=#c7fe02>","rac.tec",{"_15":1576,"_1099":1578,"_1102":1579},[1101,1101,1101],[1580,1580,1580],"<color=#FFCC00>","scene_grade.down",{"_15":1581,"_1099":1583,"_1102":1584},[1101,1101,1101],[1585,1585,1585],"<color=#D12E42>","set.key",{"_15":1586,"_1099":1588,"_1102":1589},[1101,1101,1101],[1590,1590,1590],"<color=#A7A7A7>","tech.get",{"_15":1591,"_1099":1593,"_1102":1594},[1101,1101,1101],[1595,1595,1595],"<color=#1e1e1e>","tips.key",{"_15":1596,"_1099":1598,"_1102":1599},[1101,1101,1101],[1600,1601,1600],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1602,"_1099":1604,"_1102":1605},[1101,1101,1101],[1389,1390,1391],"toast_focal.key",{"_15":1606,"_1099":1608,"_1102":1609},[1101,1101,1101],[1601,1601,1601],"weapon.stress",{"_15":1610,"_1099":1612,"_1102":1613},[1101,1101,1101],[1614,1614,1614],"<color=#fe5a00>","weekraid.key",{"_15":1615,"_1099":1617,"_1102":1618},[1258,1258,1258],[1619,1619,1620],"<color=#ffcc00><u>","<color=#cc9900><u>","tooltips",{"_1623":1624,"_1630":1631,"_1312":1635,"_1640":1641,"_1644":1645,"_1649":1650,"_1653":1654,"_1658":1659,"_1662":1663,"_1667":1668,"_1671":1672,"_1127":1676,"_1681":1682,"_1685":1686,"_1690":1691,"_1695":1696,"_1699":1700,"_1704":1705,"_1210":1708,"_1713":1714,"_1717":1718,"_1723":1724,"_1216":1727,"_1732":1733,"_1736":1737,"_1234":1741,"_1746":1747,"_1750":1751,"_1241":1755,"_1760":1761,"_1766":1767,"_1265":1771,"_1776":1777,"_1781":1782,"_1786":1787,"_1791":1792,"_1272":1796,"_1800":1801,"_1805":1806,"_1810":1811,"_1814":1815,"_1820":1821,"_1825":1826,"_1302":1830,"_1835":1836,"_1840":1841,"_1843":1844,"_1847":1848,"_1852":1853,"_1856":1857,"_1862":1863,"_1866":1867,"_1871":1872,"_1876":1877,"_1319":1881,"_1885":1886,"_1888":1889,"_1339":1893,"_1897":1898,"_1902":1903,"_1907":1908,"_1912":1913,"_1916":1917,"_1921":1922,"_1139":1927,"_1178":1931,"_1936":1937,"_1941":1942,"_1946":1947,"_1365":1951,"_1956":1957,"_1959":1960,"_1963":1964,"_1967":1968,"_1972":1973,"_1977":1978,"_1981":1982,"_1986":1987,"_1405":1991,"_1995":1996,"_2000":2001,"_2005":2006,"_2010":2011,"_2014":2015,"_2018":2019,"_2023":2024,"_2028":2029,"_2032":2033,"_2038":2039,"_2042":2043,"_2046":2047,"_2051":2052,"_2055":2056,"_2059":2060,"_2063":2064,"_2069":2070,"_2074":2075,"_2079":2080,"_2084":2085,"_2089":2090,"_2094":2095,"_2099":2100,"_2104":2105,"_2109":2110,"_2114":2115,"_2119":2120,"_2124":2125,"_2129":2130,"_2134":2135},"adv.electricFence",{"_31":1625,"_1626":34,"_15":1623,"_1627":34,"_18":1628,"_1629":1195},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_31":1632,"_1626":1633,"_15":1630,"_1627":34,"_18":1634,"_1629":1248},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_31":1636,"_1626":1637,"_15":1312,"_1627":1638,"_18":1639,"_1629":1377},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_31":1642,"_1626":34,"_15":1640,"_1627":34,"_18":1643,"_1629":1195},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_31":1646,"_1626":1647,"_15":1644,"_1627":34,"_18":1648,"_1629":1195},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_31":1651,"_1626":34,"_15":1649,"_1627":34,"_18":1652,"_1629":1195},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_31":1655,"_1626":1656,"_15":1653,"_1627":34,"_18":1657,"_1629":1289},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_31":1660,"_1626":34,"_15":1658,"_1627":34,"_18":1661,"_1629":1195},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_31":1664,"_1626":1665,"_15":1662,"_1627":34,"_18":1666,"_1629":1195},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_31":1669,"_1626":34,"_15":1667,"_1627":34,"_18":1670,"_1629":34},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_31":1673,"_1626":1674,"_15":1671,"_1627":34,"_18":1675,"_1629":1248},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_31":1677,"_1626":1678,"_15":1127,"_1627":1679,"_18":1680,"_1629":1377},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_31":1683,"_1626":34,"_15":1681,"_1627":34,"_18":1684,"_1629":1195},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_31":1687,"_1626":1688,"_15":1685,"_1627":34,"_18":1689,"_1629":1195},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_31":1692,"_1626":1693,"_15":1690,"_1627":34,"_18":1694,"_1629":1195},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_31":1697,"_1626":34,"_15":1695,"_1627":34,"_18":1698,"_1629":1222},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_31":1701,"_1626":1702,"_15":1699,"_1627":34,"_18":1703,"_1629":1195},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_31":1706,"_1626":34,"_15":1704,"_1627":34,"_18":1707,"_1629":1222},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_31":1709,"_1626":1710,"_15":1210,"_1627":1711,"_18":1712,"_1629":1289},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_31":1715,"_1626":1710,"_15":1713,"_1627":34,"_18":1716,"_1629":1289},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_31":1719,"_1626":1720,"_15":1717,"_1627":1721,"_18":1722,"_1629":1222},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_31":1725,"_1626":34,"_15":1723,"_1627":34,"_18":1726,"_1629":1222},"持续时间内，受影响的目标暂停行动。","定身",{"_31":1728,"_1626":1729,"_15":1216,"_1627":1730,"_18":1731,"_1629":1401},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_31":1734,"_1626":1729,"_15":1732,"_1627":34,"_18":1735,"_1629":1401},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_31":1738,"_1626":34,"_15":1736,"_1627":1739,"_18":1740,"_1629":34},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_31":1742,"_1626":1743,"_15":1234,"_1627":1744,"_18":1745,"_1629":1351},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_31":1748,"_1626":1743,"_15":1746,"_1627":34,"_18":1749,"_1629":1351},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_31":1752,"_1626":1753,"_15":1750,"_1627":34,"_18":1754,"_1629":1195},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_31":1756,"_1626":1757,"_15":1241,"_1627":1758,"_18":1759,"_1629":1377},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_31":1762,"_1626":1763,"_15":1760,"_1627":1764,"_18":1765,"_1629":1222},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_31":1768,"_1626":1769,"_15":1766,"_1627":34,"_18":1770,"_1629":1222},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_31":1772,"_1626":1773,"_15":1265,"_1627":1774,"_18":1775,"_1629":1248},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_31":1778,"_1626":34,"_15":1776,"_1627":1779,"_18":1780,"_1629":1248},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_31":1783,"_1626":1784,"_15":1781,"_1627":34,"_18":1785,"_1629":1195},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_31":1788,"_1626":1789,"_15":1786,"_1627":34,"_18":1790,"_1629":1195},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_31":1793,"_1626":1794,"_15":1791,"_1627":34,"_18":1795,"_1629":1248},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_31":1797,"_1626":1633,"_15":1272,"_1627":1798,"_18":1799,"_1629":1248},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_31":1802,"_1626":34,"_15":1800,"_1627":1803,"_18":1804,"_1629":1222},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_31":1807,"_1626":1808,"_15":1805,"_1627":34,"_18":1809,"_1629":1195},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_31":1812,"_1626":34,"_15":1810,"_1627":34,"_18":1813,"_1629":34},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_31":1816,"_1626":1817,"_15":1814,"_1627":1818,"_18":1819,"_1629":1222},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_31":1822,"_1626":1823,"_15":1820,"_1627":34,"_18":1824,"_1629":1195},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_31":1827,"_1626":34,"_15":1825,"_1627":1828,"_18":1829,"_1629":1289},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_31":1831,"_1626":1832,"_15":1302,"_1627":1833,"_18":1834,"_1629":1289},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_31":1837,"_1626":1838,"_15":1835,"_1627":34,"_18":1839,"_1629":1195},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_31":1715,"_1626":1832,"_15":1840,"_1627":34,"_18":1842,"_1629":1289},"干员受到灼热附着","sys.tacticalItem",{"_31":1845,"_1626":34,"_15":1843,"_1627":34,"_18":1846,"_1629":1195},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_31":1849,"_1626":1850,"_15":1847,"_1627":34,"_18":1851,"_1629":1289},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_31":1734,"_1626":1854,"_15":1852,"_1627":34,"_18":1855,"_1629":1401},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_31":1858,"_1626":1859,"_15":1856,"_1627":1860,"_18":1861,"_1629":1222},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_31":1864,"_1626":34,"_15":1862,"_1627":34,"_18":1865,"_1629":1222},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_31":1868,"_1626":1869,"_15":1866,"_1627":34,"_18":1870,"_1629":1377},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_31":1873,"_1626":1874,"_15":1871,"_1627":34,"_18":1875,"_1629":1401},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_31":1878,"_1626":1879,"_15":1876,"_1627":34,"_18":1880,"_1629":1222},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_31":1882,"_1626":1883,"_15":1319,"_1627":1774,"_18":1884,"_1629":1248},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_31":1632,"_1626":1883,"_15":1885,"_1627":34,"_18":1887,"_1629":1248},"干员受到冻结","ba.naturalvul",{"_31":1890,"_1626":1891,"_15":1888,"_1627":34,"_18":1892,"_1629":1351},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_31":1677,"_1626":1894,"_15":1339,"_1627":1895,"_18":1896,"_1629":1377},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_31":1899,"_1626":1900,"_15":1897,"_1627":34,"_18":1901,"_1629":1195},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_31":1904,"_1626":1905,"_15":1902,"_1627":34,"_18":1906,"_1629":1195},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_31":1909,"_1626":1910,"_15":1907,"_1627":34,"_18":1911,"_1629":1195},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_31":1914,"_1626":34,"_15":1912,"_1627":34,"_18":1915,"_1629":1195},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_31":1918,"_1626":34,"_15":1916,"_1627":1919,"_18":1920,"_1629":34},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_31":1923,"_1626":1924,"_15":1921,"_1627":1925,"_18":1926,"_1629":1222},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_31":1928,"_1626":34,"_15":1139,"_1627":1929,"_18":1930,"_1629":1351},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_31":1932,"_1626":1933,"_15":1178,"_1627":1934,"_18":1935,"_1629":1377},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_31":1938,"_1626":1939,"_15":1936,"_1627":34,"_18":1940,"_1629":1195},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_31":1943,"_1626":1944,"_15":1941,"_1627":34,"_18":1945,"_1629":1351},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_31":1948,"_1626":1949,"_15":1946,"_1627":34,"_18":1950,"_1629":1195},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_31":1952,"_1626":1953,"_15":1365,"_1627":1954,"_18":1955,"_1629":1351},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_31":1748,"_1626":1953,"_15":1956,"_1627":34,"_18":1958,"_1629":1351},"干员受到自然附着","ba.originium",{"_31":1961,"_1626":34,"_15":1959,"_1627":34,"_18":1962,"_1629":1222},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_31":1965,"_1626":34,"_15":1963,"_1627":34,"_18":1966,"_1629":1377},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_31":1969,"_1626":1970,"_15":1967,"_1627":34,"_18":1971,"_1629":1377},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_31":1974,"_1626":34,"_15":1972,"_1627":1975,"_18":1976,"_1629":1385},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_31":1979,"_1626":34,"_15":1977,"_1627":34,"_18":1980,"_1629":1195},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_31":1983,"_1626":34,"_15":1981,"_1627":1984,"_18":1985,"_1629":1401},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_31":1988,"_1626":1989,"_15":1986,"_1627":34,"_18":1990,"_1629":1195},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_31":1992,"_1626":1854,"_15":1405,"_1627":1993,"_18":1994,"_1629":1401},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_31":1997,"_1626":1998,"_15":1995,"_1627":34,"_18":1999,"_1629":1401},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_31":2002,"_1626":34,"_15":2000,"_1627":2003,"_18":2004,"_1629":1222},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_31":2007,"_1626":34,"_15":2005,"_1627":2008,"_18":2009,"_1629":34},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_31":2012,"_1626":34,"_15":2010,"_1627":34,"_18":2013,"_1629":1195},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_31":2016,"_1626":34,"_15":2014,"_1627":34,"_18":2017,"_1629":1222},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_31":2020,"_1626":2021,"_15":2018,"_1627":34,"_18":2022,"_1629":1195},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_31":2025,"_1626":34,"_15":2023,"_1627":2026,"_18":2027,"_1629":1222},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_31":2030,"_1626":34,"_15":2028,"_1627":34,"_18":2031,"_1629":1195},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_31":2034,"_1626":2035,"_15":2032,"_1627":2036,"_18":2037,"_1629":1222},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_31":2040,"_1626":34,"_15":2038,"_1627":34,"_18":2041,"_1629":1222},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_31":2044,"_1626":34,"_15":2042,"_1627":34,"_18":2045,"_1629":1222},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_31":2048,"_1626":2049,"_15":2046,"_1627":34,"_18":2050,"_1629":1195},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_31":2053,"_1626":34,"_15":2051,"_1627":34,"_18":2054,"_1629":1222},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_31":2057,"_1626":34,"_15":2055,"_1627":34,"_18":2058,"_1629":1222},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_31":2061,"_1626":34,"_15":2059,"_1627":34,"_18":2062,"_1629":1222},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_31":2065,"_1626":2066,"_15":2063,"_1627":2067,"_18":2068,"_1629":1222},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_31":2071,"_1626":2072,"_15":2069,"_1627":34,"_18":2073,"_1629":1195},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_31":2076,"_1626":2077,"_15":2074,"_1627":34,"_18":2078,"_1629":1195},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_31":2081,"_1626":2082,"_15":2079,"_1627":34,"_18":2083,"_1629":1195},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_31":2086,"_1626":2087,"_15":2084,"_1627":34,"_18":2088,"_1629":1195},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_31":2091,"_1626":2092,"_15":2089,"_1627":34,"_18":2093,"_1629":1195},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_31":2096,"_1626":2097,"_15":2094,"_1627":34,"_18":2098,"_1629":1195},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_31":2101,"_1626":2102,"_15":2099,"_1627":34,"_18":2103,"_1629":1195},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_31":2106,"_1626":2107,"_15":2104,"_1627":34,"_18":2108,"_1629":1195},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_31":2111,"_1626":2112,"_15":2109,"_1627":34,"_18":2113,"_1629":1195},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_31":2116,"_1626":2117,"_15":2114,"_1627":34,"_18":2118,"_1629":1195},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_31":2121,"_1626":2122,"_15":2119,"_1627":34,"_18":2123,"_1629":1195},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_31":2126,"_1626":2127,"_15":2124,"_1627":34,"_18":2128,"_1629":1195},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_31":2131,"_1626":2132,"_15":2129,"_1627":34,"_18":2133,"_1629":1195},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_31":2136,"_1626":2137,"_15":2134,"_1627":34,"_18":2138,"_1629":1195},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维"]
