lor=#c7fe02>","rac.tec",{"_15":1574,"_1097":1576,"_1100":1577},[1099,1099,1099],[1578,1578,1578],"<color=#FFCC00>","scene_grade.down",{"_15":1579,"_1097":1581,"_1100":1582},[1099,1099,1099],[1583,1583,1583],"<color=#D12E42>","set.key",{"_15":1584,"_1097":1586,"_1100":1587},[1099,1099,1099],[1588,1588,1588],"<color=#A7A7A7>","tech.get",{"_15":1589,"_1097":1591,"_1100":1592},[1099,1099,1099],[1593,1593,1593],"<color=#1e1e1e>","tips.key",{"_15":1594,"_1097":1596,"_1100":1597},[1099,1099,1099],[1598,1599,1598],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1600,"_1097":1602,"_1100":1603},[1099,1099,1099],[1387,1388,1389],"toast_focal.key",{"_15":1604,"_1097":1606,"_1100":1607},[1099,1099,1099],[1599,1599,1599],"weapon.stress",{"_15":1608,"_1097":1610,"_1100":1611},[1099,1099,1099],[1612,1612,1612],"<color=#fe5a00>","weekraid.key",{"_15":1613,"_1097":1615,"_1100":1616},[1256,1256,1256],[1617,1617,1618],"<color=#ffcc00><u>","<color=#cc9900><u>","tooltips",{"_1621":1622,"_1628":1629,"_1310":1633,"_1638":1639,"_1642":1643,"_1647":1648,"_1651":1652,"_1656":1657,"_1660":1661,"_1665":1666,"_1669":1670,"_1125":1674,"_1679":1680,"_1683":1684,"_1688":1689,"_1693":1694,"_1697":1698,"_1702":1703,"_1208":1706,"_1711":1712,"_1715":1716,"_1721":1722,"_1214":1725,"_1730":1731,"_1734":1735,"_1232":1739,"_1744":1745,"_1748":1749,"_1239":1753,"_1758":1759,"_1764":1765,"_1263":1769,"_1774":1775,"_1779":1780,"_1784":1785,"_1789":1790,"_1270":1794,"_1798":1799,"_1803":1804,"_1808":1809,"_1812":1813,"_1818":1819,"_1823":1824,"_1300":1828,"_1833":1834,"_1838":1839,"_1841":1842,"_1845":1846,"_1850":1851,"_1854":1855,"_1860":1861,"_1864":1865,"_1869":1870,"_1874":1875,"_1317":1879,"_1883":1884,"_1886":1887,"_1337":1891,"_1895":1896,"_1900":1901,"_1905":1906,"_1910":1911,"_1914":1915,"_1919":1920,"_1137":1925,"_1176":1929,"_1934":1935,"_1939":1940,"_1944":1945,"_1363":1949,"_1954":1955,"_1957":1958,"_1961":1962,"_1965":1966,"_1970":1971,"_1975":1976,"_1979":1980,"_1984":1985,"_1403":1989,"_1993":1994,"_1998":1999,"_2003":2004,"_2008":2009,"_2012":2013,"_2016":2017,"_2021":2022,"_2026":2027,"_2030":2031,"_2036":2037,"_2040":2041,"_2044":2045,"_2049":2050,"_2053":2054,"_2057":2058,"_2061":2062,"_2067":2068,"_2072":2073,"_2077":2078,"_2082":2083,"_2087":2088,"_2092":2093,"_2097":2098,"_2102":2103,"_2107":2108,"_2112":2113,"_2117":2118,"_2122":2123,"_2127":2128,"_2132":2133},"adv.electricFence",{"_31":1623,"_1624":34,"_15":1621,"_1625":34,"_18":1626,"_1627":1193},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_31":1630,"_1624":1631,"_15":1628,"_1625":34,"_18":1632,"_1627":1246},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_31":1634,"_1624":1635,"_15":1310,"_1625":1636,"_18":1637,"_1627":1375},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_31":1640,"_1624":34,"_15":1638,"_1625":34,"_18":1641,"_1627":1193},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_31":1644,"_1624":1645,"_15":1642,"_1625":34,"_18":1646,"_1627":1193},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_31":1649,"_1624":34,"_15":1647,"_1625":34,"_18":1650,"_1627":1193},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_31":1653,"_1624":1654,"_15":1651,"_1625":34,"_18":1655,"_1627":1287},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_31":1658,"_1624":34,"_15":1656,"_1625":34,"_18":1659,"_1627":1193},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_31":1662,"_1624":1663,"_15":1660,"_1625":34,"_18":1664,"_1627":1193},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_31":1667,"_1624":34,"_15":1665,"_1625":34,"_18":1668,"_1627":34},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_31":1671,"_1624":1672,"_15":1669,"_1625":34,"_18":1673,"_1627":1246},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_31":1675,"_1624":1676,"_15":1125,"_1625":1677,"_18":1678,"_1627":1375},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_31":1681,"_1624":34,"_15":1679,"_1625":34,"_18":1682,"_1627":1193},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_31":1685,"_1624":1686,"_15":1683,"_1625":34,"_18":1687,"_1627":1193},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_31":1690,"_1624":1691,"_15":1688,"_1625":34,"_18":1692,"_1627":1193},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_31":1695,"_1624":34,"_15":1693,"_1625":34,"_18":1696,"_1627":1220},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_31":1699,"_1624":1700,"_15":1697,"_1625":34,"_18":1701,"_1627":1193},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_31":1704,"_1624":34,"_15":1702,"_1625":34,"_18":1705,"_1627":1220},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_31":1707,"_1624":1708,"_15":1208,"_1625":1709,"_18":1710,"_1627":1287},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_31":1713,"_1624":1708,"_15":1711,"_1625":34,"_18":1714,"_1627":1287},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_31":1717,"_1624":1718,"_15":1715,"_1625":1719,"_18":1720,"_1627":1220},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_31":1723,"_1624":34,"_15":1721,"_1625":34,"_18":1724,"_1627":1220},"持续时间内，受影响的目标暂停行动。","定身",{"_31":1726,"_1624":1727,"_15":1214,"_1625":1728,"_18":1729,"_1627":1399},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_31":1732,"_1624":1727,"_15":1730,"_1625":34,"_18":1733,"_1627":1399},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_31":1736,"_1624":34,"_15":1734,"_1625":1737,"_18":1738,"_1627":34},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_31":1740,"_1624":1741,"_15":1232,"_1625":1742,"_18":1743,"_1627":1349},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_31":1746,"_1624":1741,"_15":1744,"_1625":34,"_18":1747,"_1627":1349},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_31":1750,"_1624":1751,"_15":1748,"_1625":34,"_18":1752,"_1627":1193},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_31":1754,"_1624":1755,"_15":1239,"_1625":1756,"_18":1757,"_1627":1375},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_31":1760,"_1624":1761,"_15":1758,"_1625":1762,"_18":1763,"_1627":1220},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_31":1766,"_1624":1767,"_15":1764,"_1625":34,"_18":1768,"_1627":1220},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_31":1770,"_1624":1771,"_15":1263,"_1625":1772,"_18":1773,"_1627":1246},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_31":1776,"_1624":34,"_15":1774,"_1625":1777,"_18":1778,"_1627":1246},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_31":1781,"_1624":1782,"_15":1779,"_1625":34,"_18":1783,"_1627":1193},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_31":1786,"_1624":1787,"_15":1784,"_1625":34,"_18":1788,"_1627":1193},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_31":1791,"_1624":1792,"_15":1789,"_1625":34,"_18":1793,"_1627":1246},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_31":1795,"_1624":1631,"_15":1270,"_1625":1796,"_18":1797,"_1627":1246},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_31":1800,"_1624":34,"_15":1798,"_1625":1801,"_18":1802,"_1627":1220},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_31":1805,"_1624":1806,"_15":1803,"_1625":34,"_18":1807,"_1627":1193},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_31":1810,"_1624":34,"_15":1808,"_1625":34,"_18":1811,"_1627":34},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_31":1814,"_1624":1815,"_15":1812,"_1625":1816,"_18":1817,"_1627":1220},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_31":1820,"_1624":1821,"_15":1818,"_1625":34,"_18":1822,"_1627":1193},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_31":1825,"_1624":34,"_15":1823,"_1625":1826,"_18":1827,"_1627":1287},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_31":1829,"_1624":1830,"_15":1300,"_1625":1831,"_18":1832,"_1627":1287},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_31":1835,"_1624":1836,"_15":1833,"_1625":34,"_18":1837,"_1627":1193},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_31":1713,"_1624":1830,"_15":1838,"_1625":34,"_18":1840,"_1627":1287},"干员受到灼热附着","sys.tacticalItem",{"_31":1843,"_1624":34,"_15":1841,"_1625":34,"_18":1844,"_1627":1193},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_31":1847,"_1624":1848,"_15":1845,"_1625":34,"_18":1849,"_1627":1287},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_31":1732,"_1624":1852,"_15":1850,"_1625":34,"_18":1853,"_1627":1399},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_31":1856,"_1624":1857,"_15":1854,"_1625":1858,"_18":1859,"_1627":1220},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_31":1862,"_1624":34,"_15":1860,"_1625":34,"_18":1863,"_1627":1220},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_31":1866,"_1624":1867,"_15":1864,"_1625":34,"_18":1868,"_1627":1375},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_31":1871,"_1624":1872,"_15":1869,"_1625":34,"_18":1873,"_1627":1399},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_31":1876,"_1624":1877,"_15":1874,"_1625":34,"_18":1878,"_1627":1220},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_31":1880,"_1624":1881,"_15":1317,"_1625":1772,"_18":1882,"_1627":1246},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_31":1630,"_1624":1881,"_15":1883,"_1625":34,"_18":1885,"_1627":1246},"干员受到冻结","ba.naturalvul",{"_31":1888,"_1624":1889,"_15":1886,"_1625":34,"_18":1890,"_1627":1349},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_31":1675,"_1624":1892,"_15":1337,"_1625":1893,"_18":1894,"_1627":1375},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_31":1897,"_1624":1898,"_15":1895,"_1625":34,"_18":1899,"_1627":1193},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_31":1902,"_1624":1903,"_15":1900,"_1625":34,"_18":1904,"_1627":1193},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_31":1907,"_1624":1908,"_15":1905,"_1625":34,"_18":1909,"_1627":1193},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_31":1912,"_1624":34,"_15":1910,"_1625":34,"_18":1913,"_1627":1193},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_31":1916,"_1624":34,"_15":1914,"_1625":1917,"_18":1918,"_1627":34},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_31":1921,"_1624":1922,"_15":1919,"_1625":1923,"_18":1924,"_1627":1220},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_31":1926,"_1624":34,"_15":1137,"_1625":1927,"_18":1928,"_1627":1349},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_31":1930,"_1624":1931,"_15":1176,"_1625":1932,"_18":1933,"_1627":1375},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_31":1936,"_1624":1937,"_15":1934,"_1625":34,"_18":1938,"_1627":1193},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_31":1941,"_1624":1942,"_15":1939,"_1625":34,"_18":1943,"_1627":1349},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_31":1946,"_1624":1947,"_15":1944,"_1625":34,"_18":1948,"_1627":1193},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_31":1950,"_1624":1951,"_15":1363,"_1625":1952,"_18":1953,"_1627":1349},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_31":1746,"_1624":1951,"_15":1954,"_1625":34,"_18":1956,"_1627":1349},"干员受到自然附着","ba.originium",{"_31":1959,"_1624":34,"_15":1957,"_1625":34,"_18":1960,"_1627":1220},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_31":1963,"_1624":34,"_15":1961,"_1625":34,"_18":1964,"_1627":1375},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_31":1967,"_1624":1968,"_15":1965,"_1625":34,"_18":1969,"_1627":1375},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_31":1972,"_1624":34,"_15":1970,"_1625":1973,"_18":1974,"_1627":1383},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_31":1977,"_1624":34,"_15":1975,"_1625":34,"_18":1978,"_1627":1193},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_31":1981,"_1624":34,"_15":1979,"_1625":1982,"_18":1983,"_1627":1399},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_31":1986,"_1624":1987,"_15":1984,"_1625":34,"_18":1988,"_1627":1193},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_31":1990,"_1624":1852,"_15":1403,"_1625":1991,"_18":1992,"_1627":1399},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_31":1995,"_1624":1996,"_15":1993,"_1625":34,"_18":1997,"_1627":1399},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_31":2000,"_1624":34,"_15":1998,"_1625":2001,"_18":2002,"_1627":1220},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_31":2005,"_1624":34,"_15":2003,"_1625":2006,"_18":2007,"_1627":34},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_31":2010,"_1624":34,"_15":2008,"_1625":34,"_18":2011,"_1627":1193},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_31":2014,"_1624":34,"_15":2012,"_1625":34,"_18":2015,"_1627":1220},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_31":2018,"_1624":2019,"_15":2016,"_1625":34,"_18":2020,"_1627":1193},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_31":2023,"_1624":34,"_15":2021,"_1625":2024,"_18":2025,"_1627":1220},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_31":2028,"_1624":34,"_15":2026,"_1625":34,"_18":2029,"_1627":1193},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_31":2032,"_1624":2033,"_15":2030,"_1625":2034,"_18":2035,"_1627":1220},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_31":2038,"_1624":34,"_15":2036,"_1625":34,"_18":2039,"_1627":1220},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_31":2042,"_1624":34,"_15":2040,"_1625":34,"_18":2043,"_1627":1220},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_31":2046,"_1624":2047,"_15":2044,"_1625":34,"_18":2048,"_1627":1193},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_31":2051,"_1624":34,"_15":2049,"_1625":34,"_18":2052,"_1627":1220},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_31":2055,"_1624":34,"_15":2053,"_1625":34,"_18":2056,"_1627":1220},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_31":2059,"_1624":34,"_15":2057,"_1625":34,"_18":2060,"_1627":1220},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_31":2063,"_1624":2064,"_15":2061,"_1625":2065,"_18":2066,"_1627":1220},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_31":2069,"_1624":2070,"_15":2067,"_1625":34,"_18":2071,"_1627":1193},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_31":2074,"_1624":2075,"_15":2072,"_1625":34,"_18":2076,"_1627":1193},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_31":2079,"_1624":2080,"_15":2077,"_1625":34,"_18":2081,"_1627":1193},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_31":2084,"_1624":2085,"_15":2082,"_1625":34,"_18":2086,"_1627":1193},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_31":2089,"_1624":2090,"_15":2087,"_1625":34,"_18":2091,"_1627":1193},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_31":2094,"_1624":2095,"_15":2092,"_1625":34,"_18":2096,"_1627":1193},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_31":2099,"_1624":2100,"_15":2097,"_1625":34,"_18":2101,"_1627":1193},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_31":2104,"_1624":2105,"_15":2102,"_1625":34,"_18":2106,"_1627":1193},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_31":2109,"_1624":2110,"_15":2107,"_1625":34,"_18":2111,"_1627":1193},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_31":2114,"_1624":2115,"_15":2112,"_1625":34,"_18":2116,"_1627":1193},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_31":2119,"_1624":2120,"_15":2117,"_1625":34,"_18":2121,"_1627":1193},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_31":2124,"_1624":2125,"_15":2122,"_1625":34,"_18":2126,"_1627":1193},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_31":2129,"_1624":2130,"_15":2127,"_1625":34,"_18":2131,"_1627":1193},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_31":2134,"_1624":2135,"_15":2132,"_1625":34,"_18":2136,"_1627":1193},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维"]
