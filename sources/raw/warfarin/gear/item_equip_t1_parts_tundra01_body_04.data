1098,1098,1098],[1597,1598,1597],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1599,"_1096":1601,"_1099":1602},[1098,1098,1098],[1386,1387,1388],"toast_focal.key",{"_15":1603,"_1096":1605,"_1099":1606},[1098,1098,1098],[1598,1598,1598],"weapon.stress",{"_15":1607,"_1096":1609,"_1099":1610},[1098,1098,1098],[1611,1611,1611],"<color=#fe5a00>","weekraid.key",{"_15":1612,"_1096":1614,"_1099":1615},[1255,1255,1255],[1616,1616,1617],"<color=#ffcc00><u>","<color=#cc9900><u>","tooltips",{"_1620":1621,"_1627":1628,"_1309":1632,"_1637":1638,"_1641":1642,"_1646":1647,"_1650":1651,"_1655":1656,"_1659":1660,"_1664":1665,"_1668":1669,"_1124":1673,"_1678":1679,"_1682":1683,"_1687":1688,"_1692":1693,"_1696":1697,"_1701":1702,"_1207":1705,"_1710":1711,"_1714":1715,"_1720":1721,"_1213":1724,"_1729":1730,"_1733":1734,"_1231":1738,"_1743":1744,"_1747":1748,"_1238":1752,"_1757":1758,"_1763":1764,"_1262":1768,"_1773":1774,"_1778":1779,"_1783":1784,"_1788":1789,"_1269":1793,"_1797":1798,"_1802":1803,"_1807":1808,"_1811":1812,"_1817":1818,"_1822":1823,"_1299":1827,"_1832":1833,"_1837":1838,"_1840":1841,"_1844":1845,"_1849":1850,"_1853":1854,"_1859":1860,"_1863":1864,"_1868":1869,"_1873":1874,"_1316":1878,"_1882":1883,"_1885":1886,"_1336":1890,"_1894":1895,"_1899":1900,"_1904":1905,"_1909":1910,"_1913":1914,"_1918":1919,"_1136":1924,"_1175":1928,"_1933":1934,"_1938":1939,"_1943":1944,"_1362":1948,"_1953":1954,"_1956":1957,"_1960":1961,"_1964":1965,"_1969":1970,"_1974":1975,"_1978":1979,"_1983":1984,"_1402":1988,"_1992":1993,"_1997":1998,"_2002":2003,"_2007":2008,"_2011":2012,"_2015":2016,"_2020":2021,"_2025":2026,"_2029":2030,"_2035":2036,"_2039":2040,"_2043":2044,"_2048":2049,"_2052":2053,"_2056":2057,"_2060":2061,"_2066":2067,"_2071":2072,"_2076":2077,"_2081":2082,"_2086":2087,"_2091":2092,"_2096":2097,"_2101":2102,"_2106":2107,"_2111":2112,"_2116":2117,"_2121":2122,"_2126":2127,"_2131":2132},"adv.electricFence",{"_31":1622,"_1623":34,"_15":1620,"_1624":34,"_18":1625,"_1626":1192},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_31":1629,"_1623":1630,"_15":1627,"_1624":34,"_18":1631,"_1626":1245},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_31":1633,"_1623":1634,"_15":1309,"_1624":1635,"_18":1636,"_1626":1374},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_31":1639,"_1623":34,"_15":1637,"_1624":34,"_18":1640,"_1626":1192},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_31":1643,"_1623":1644,"_15":1641,"_1624":34,"_18":1645,"_1626":1192},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_31":1648,"_1623":34,"_15":1646,"_1624":34,"_18":1649,"_1626":1192},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_31":1652,"_1623":1653,"_15":1650,"_1624":34,"_18":1654,"_1626":1286},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_31":1657,"_1623":34,"_15":1655,"_1624":34,"_18":1658,"_1626":1192},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_31":1661,"_1623":1662,"_15":1659,"_1624":34,"_18":1663,"_1626":1192},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_31":1666,"_1623":34,"_15":1664,"_1624":34,"_18":1667,"_1626":34},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_31":1670,"_1623":1671,"_15":1668,"_1624":34,"_18":1672,"_1626":1245},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_31":1674,"_1623":1675,"_15":1124,"_1624":1676,"_18":1677,"_1626":1374},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_31":1680,"_1623":34,"_15":1678,"_1624":34,"_18":1681,"_1626":1192},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_31":1684,"_1623":1685,"_15":1682,"_1624":34,"_18":1686,"_1626":1192},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_31":1689,"_1623":1690,"_15":1687,"_1624":34,"_18":1691,"_1626":1192},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_31":1694,"_1623":34,"_15":1692,"_1624":34,"_18":1695,"_1626":1219},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_31":1698,"_1623":1699,"_15":1696,"_1624":34,"_18":1700,"_1626":1192},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_31":1703,"_1623":34,"_15":1701,"_1624":34,"_18":1704,"_1626":1219},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_31":1706,"_1623":1707,"_15":1207,"_1624":1708,"_18":1709,"_1626":1286},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_31":1712,"_1623":1707,"_15":1710,"_1624":34,"_18":1713,"_1626":1286},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_31":1716,"_1623":1717,"_15":1714,"_1624":1718,"_18":1719,"_1626":1219},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_31":1722,"_1623":34,"_15":1720,"_1624":34,"_18":1723,"_1626":1219},"持续时间内，受影响的目标暂停行动。","定身",{"_31":1725,"_1623":1726,"_15":1213,"_1624":1727,"_18":1728,"_1626":1398},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_31":1731,"_1623":1726,"_15":1729,"_1624":34,"_18":1732,"_1626":1398},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_31":1735,"_1623":34,"_15":1733,"_1624":1736,"_18":1737,"_1626":34},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_31":1739,"_1623":1740,"_15":1231,"_1624":1741,"_18":1742,"_1626":1348},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_31":1745,"_1623":1740,"_15":1743,"_1624":34,"_18":1746,"_1626":1348},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_31":1749,"_1623":1750,"_15":1747,"_1624":34,"_18":1751,"_1626":1192},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_31":1753,"_1623":1754,"_15":1238,"_1624":1755,"_18":1756,"_1626":1374},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_31":1759,"_1623":1760,"_15":1757,"_1624":1761,"_18":1762,"_1626":1219},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_31":1765,"_1623":1766,"_15":1763,"_1624":34,"_18":1767,"_1626":1219},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_31":1769,"_1623":1770,"_15":1262,"_1624":1771,"_18":1772,"_1626":1245},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_31":1775,"_1623":34,"_15":1773,"_1624":1776,"_18":1777,"_1626":1245},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_31":1780,"_1623":1781,"_15":1778,"_1624":34,"_18":1782,"_1626":1192},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_31":1785,"_1623":1786,"_15":1783,"_1624":34,"_18":1787,"_1626":1192},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_31":1790,"_1623":1791,"_15":1788,"_1624":34,"_18":1792,"_1626":1245},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_31":1794,"_1623":1630,"_15":1269,"_1624":1795,"_18":1796,"_1626":1245},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_31":1799,"_1623":34,"_15":1797,"_1624":1800,"_18":1801,"_1626":1219},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_31":1804,"_1623":1805,"_15":1802,"_1624":34,"_18":1806,"_1626":1192},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_31":1809,"_1623":34,"_15":1807,"_1624":34,"_18":1810,"_1626":34},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_31":1813,"_1623":1814,"_15":1811,"_1624":1815,"_18":1816,"_1626":1219},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_31":1819,"_1623":1820,"_15":1817,"_1624":34,"_18":1821,"_1626":1192},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_31":1824,"_1623":34,"_15":1822,"_1624":1825,"_18":1826,"_1626":1286},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_31":1828,"_1623":1829,"_15":1299,"_1624":1830,"_18":1831,"_1626":1286},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_31":1834,"_1623":1835,"_15":1832,"_1624":34,"_18":1836,"_1626":1192},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_31":1712,"_1623":1829,"_15":1837,"_1624":34,"_18":1839,"_1626":1286},"干员受到灼热附着","sys.tacticalItem",{"_31":1842,"_1623":34,"_15":1840,"_1624":34,"_18":1843,"_1626":1192},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_31":1846,"_1623":1847,"_15":1844,"_1624":34,"_18":1848,"_1626":1286},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_31":1731,"_1623":1851,"_15":1849,"_1624":34,"_18":1852,"_1626":1398},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_31":1855,"_1623":1856,"_15":1853,"_1624":1857,"_18":1858,"_1626":1219},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_31":1861,"_1623":34,"_15":1859,"_1624":34,"_18":1862,"_1626":1219},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_31":1865,"_1623":1866,"_15":1863,"_1624":34,"_18":1867,"_1626":1374},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_31":1870,"_1623":1871,"_15":1868,"_1624":34,"_18":1872,"_1626":1398},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_31":1875,"_1623":1876,"_15":1873,"_1624":34,"_18":1877,"_1626":1219},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_31":1879,"_1623":1880,"_15":1316,"_1624":1771,"_18":1881,"_1626":1245},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_31":1629,"_1623":1880,"_15":1882,"_1624":34,"_18":1884,"_1626":1245},"干员受到冻结","ba.naturalvul",{"_31":1887,"_1623":1888,"_15":1885,"_1624":34,"_18":1889,"_1626":1348},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_31":1674,"_1623":1891,"_15":1336,"_1624":1892,"_18":1893,"_1626":1374},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_31":1896,"_1623":1897,"_15":1894,"_1624":34,"_18":1898,"_1626":1192},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_31":1901,"_1623":1902,"_15":1899,"_1624":34,"_18":1903,"_1626":1192},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_31":1906,"_1623":1907,"_15":1904,"_1624":34,"_18":1908,"_1626":1192},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_31":1911,"_1623":34,"_15":1909,"_1624":34,"_18":1912,"_1626":1192},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_31":1915,"_1623":34,"_15":1913,"_1624":1916,"_18":1917,"_1626":34},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_31":1920,"_1623":1921,"_15":1918,"_1624":1922,"_18":1923,"_1626":1219},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_31":1925,"_1623":34,"_15":1136,"_1624":1926,"_18":1927,"_1626":1348},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_31":1929,"_1623":1930,"_15":1175,"_1624":1931,"_18":1932,"_1626":1374},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_31":1935,"_1623":1936,"_15":1933,"_1624":34,"_18":1937,"_1626":1192},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_31":1940,"_1623":1941,"_15":1938,"_1624":34,"_18":1942,"_1626":1348},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_31":1945,"_1623":1946,"_15":1943,"_1624":34,"_18":1947,"_1626":1192},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_31":1949,"_1623":1950,"_15":1362,"_1624":1951,"_18":1952,"_1626":1348},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_31":1745,"_1623":1950,"_15":1953,"_1624":34,"_18":1955,"_1626":1348},"干员受到自然附着","ba.originium",{"_31":1958,"_1623":34,"_15":1956,"_1624":34,"_18":1959,"_1626":1219},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_31":1962,"_1623":34,"_15":1960,"_1624":34,"_18":1963,"_1626":1374},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_31":1966,"_1623":1967,"_15":1964,"_1624":34,"_18":1968,"_1626":1374},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_31":1971,"_1623":34,"_15":1969,"_1624":1972,"_18":1973,"_1626":1382},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_31":1976,"_1623":34,"_15":1974,"_1624":34,"_18":1977,"_1626":1192},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_31":1980,"_1623":34,"_15":1978,"_1624":1981,"_18":1982,"_1626":1398},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_31":1985,"_1623":1986,"_15":1983,"_1624":34,"_18":1987,"_1626":1192},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_31":1989,"_1623":1851,"_15":1402,"_1624":1990,"_18":1991,"_1626":1398},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_31":1994,"_1623":1995,"_15":1992,"_1624":34,"_18":1996,"_1626":1398},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_31":1999,"_1623":34,"_15":1997,"_1624":2000,"_18":2001,"_1626":1219},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_31":2004,"_1623":34,"_15":2002,"_1624":2005,"_18":2006,"_1626":34},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_31":2009,"_1623":34,"_15":2007,"_1624":34,"_18":2010,"_1626":1192},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_31":2013,"_1623":34,"_15":2011,"_1624":34,"_18":2014,"_1626":1219},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_31":2017,"_1623":2018,"_15":2015,"_1624":34,"_18":2019,"_1626":1192},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_31":2022,"_1623":34,"_15":2020,"_1624":2023,"_18":2024,"_1626":1219},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_31":2027,"_1623":34,"_15":2025,"_1624":34,"_18":2028,"_1626":1192},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_31":2031,"_1623":2032,"_15":2029,"_1624":2033,"_18":2034,"_1626":1219},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_31":2037,"_1623":34,"_15":2035,"_1624":34,"_18":2038,"_1626":1219},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_31":2041,"_1623":34,"_15":2039,"_1624":34,"_18":2042,"_1626":1219},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_31":2045,"_1623":2046,"_15":2043,"_1624":34,"_18":2047,"_1626":1192},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_31":2050,"_1623":34,"_15":2048,"_1624":34,"_18":2051,"_1626":1219},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_31":2054,"_1623":34,"_15":2052,"_1624":34,"_18":2055,"_1626":1219},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_31":2058,"_1623":34,"_15":2056,"_1624":34,"_18":2059,"_1626":1219},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_31":2062,"_1623":2063,"_15":2060,"_1624":2064,"_18":2065,"_1626":1219},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_31":2068,"_1623":2069,"_15":2066,"_1624":34,"_18":2070,"_1626":1192},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_31":2073,"_1623":2074,"_15":2071,"_1624":34,"_18":2075,"_1626":1192},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_31":2078,"_1623":2079,"_15":2076,"_1624":34,"_18":2080,"_1626":1192},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_31":2083,"_1623":2084,"_15":2081,"_1624":34,"_18":2085,"_1626":1192},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_31":2088,"_1623":2089,"_15":2086,"_1624":34,"_18":2090,"_1626":1192},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_31":2093,"_1623":2094,"_15":2091,"_1624":34,"_18":2095,"_1626":1192},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_31":2098,"_1623":2099,"_15":2096,"_1624":34,"_18":2100,"_1626":1192},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_31":2103,"_1623":2104,"_15":2101,"_1624":34,"_18":2105,"_1626":1192},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_31":2108,"_1623":2109,"_15":2106,"_1624":34,"_18":2110,"_1626":1192},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_31":2113,"_1623":2114,"_15":2111,"_1624":34,"_18":2115,"_1626":1192},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_31":2118,"_1623":2119,"_15":2116,"_1624":34,"_18":2120,"_1626":1192},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_31":2123,"_1623":2124,"_15":2121,"_1624":34,"_18":2125,"_1626":1192},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_31":2128,"_1623":2129,"_15":2126,"_1624":34,"_18":2130,"_1626":1192},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_31":2133,"_1623":2134,"_15":2131,"_1624":34,"_18":2135,"_1626":1192},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维"]
