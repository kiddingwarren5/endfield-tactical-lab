,1102,1102],[1484,1484,1484],"<color=#169ED9>","fac.blue",{"_15":1485,"_1100":1487,"_1103":1488},[1102,1102,1102],[1489,1489,1489],"<color=#2f8baf>","gembox.num",{"_15":1490,"_1100":1492,"_1103":1493},[1102,1102,1102],[1494,1494,1494],"<color=#fff100>","gray.note",{"_15":1495,"_1100":1497,"_1103":1498},[1102,1102,1102],[1499,1499,1499],"<color=#7a7a7a>","ld.key",{"_15":1500,"_1100":1502,"_1103":1503},[1102,1102,1102],[1171,1171,1171],"nar.center",{"_15":1504,"_1100":1506,"_1103":1507},[1439,1439,1439],[1508,1508,1508],"<align=\"center\">","scene_grade.up",{"_15":1509,"_1100":1511,"_1103":1512},[1102,1102,1102],[1513,1513,1513],"<color=#ABCD47>","tech.key",{"_15":1514,"_1100":1516,"_1103":1517},[1102,1102,1102],[1155,1155,1155],"nar.clue",{"_15":1518,"_1100":1520,"_1103":1521},[1102,1102,1102],[1522,1523,1195],"<color=##333333>","<color=#f2f2f2>","nar.enter",{"_15":1524,"_1100":1526,"_1103":1527},[],[1528,1528,1528],"<br>","nar.left",{"_15":1529,"_1100":1531,"_1103":1532},[1439,1439,1439],[1533,1533,1533],"<align=\"left\">","nar.mark",{"_15":1534,"_1100":1536,"_1103":1538},[1537,1537,1537],"</color></mark>",[1539,1540,1539],"<mark=#444444><color=#44444400>","<mark=#E6E6E6><color=#E6E6E600>","qu.largenumdown",{"_15":1541,"_1100":1543,"_1103":1545},[1544,1544,1544],"</color></size>",[1546,1546,1546],"<size=54><color=#e74414>","nar.quote",{"_15":1547,"_1100":1549,"_1103":1551},[1550,1550,1550],"</i>",[1552,1552,1552],"<i>","nar.right",{"_15":1553,"_1100":1555,"_1103":1556},[1439,1439,1439],[1557,1557,1557],"<align=\"right\">","opt.key",{"_15":1558,"_1100":1560,"_1103":1561},[1102,1102,1102],[1562,1562,1562],"<color=#5ECDFF>","qu.numdown",{"_15":1563,"_1100":1565,"_1103":1566},[1102,1102,1102],[1567,1567,1567],"<color=#e74414>","toast_craft.key",{"_15":1568,"_1100":1570,"_1103":1571},[1102,1102,1102],[1155,1155,1156],"qu.numup",{"_15":1572,"_1100":1574,"_1103":1575},[1102,1102,1102],[1576,1576,1576],"<color=#c7fe02>","rac.tec",{"_15":1577,"_1100":1579,"_1103":1580},[1102,1102,1102],[1581,1581,1581],"<color=#FFCC00>","scene_grade.down",{"_15":1582,"_1100":1584,"_1103":1585},[1102,1102,1102],[1586,1586,1586],"<color=#D12E42>","set.key",{"_15":1587,"_1100":1589,"_1103":1590},[1102,1102,1102],[1591,1591,1591],"<color=#A7A7A7>","tech.get",{"_15":1592,"_1100":1594,"_1103":1595},[1102,1102,1102],[1596,1596,1596],"<color=#1e1e1e>","tips.key",{"_15":1597,"_1100":1599,"_1103":1600},[1102,1102,1102],[1601,1602,1601],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1603,"_1100":1605,"_1103":1606},[1102,1102,1102],[1390,1391,1392],"toast_focal.key",{"_15":1607,"_1100":1609,"_1103":1610},[1102,1102,1102],[1602,1602,1602],"weapon.stress",{"_15":1611,"_1100":1613,"_1103":1614},[1102,1102,1102],[1615,1615,1615],"<color=#fe5a00>","weekraid.key",{"_15":1616,"_1100":1618,"_1103":1619},[1259,1259,1259],[1620,1620,1621],"<color=#ffcc00><u>","<color=#cc9900><u>","tooltips",{"_1624":1625,"_1631":1632,"_1313":1636,"_1641":1642,"_1645":1646,"_1650":1651,"_1654":1655,"_1659":1660,"_1663":1664,"_1668":1669,"_1672":1673,"_1128":1677,"_1682":1683,"_1686":1687,"_1691":1692,"_1696":1697,"_1700":1701,"_1705":1706,"_1211":1709,"_1714":1715,"_1718":1719,"_1724":1725,"_1217":1728,"_1733":1734,"_1737":1738,"_1235":1742,"_1747":1748,"_1751":1752,"_1242":1756,"_1761":1762,"_1767":1768,"_1266":1772,"_1777":1778,"_1782":1783,"_1787":1788,"_1792":1793,"_1273":1797,"_1801":1802,"_1806":1807,"_1811":1812,"_1815":1816,"_1821":1822,"_1826":1827,"_1303":1831,"_1836":1837,"_1841":1842,"_1844":1845,"_1848":1849,"_1853":1854,"_1857":1858,"_1863":1864,"_1867":1868,"_1872":1873,"_1877":1878,"_1320":1882,"_1886":1887,"_1889":1890,"_1340":1894,"_1898":1899,"_1903":1904,"_1908":1909,"_1913":1914,"_1917":1918,"_1922":1923,"_1140":1928,"_1179":1932,"_1937":1938,"_1942":1943,"_1947":1948,"_1366":1952,"_1957":1958,"_1960":1961,"_1964":1965,"_1968":1969,"_1973":1974,"_1978":1979,"_1982":1983,"_1987":1988,"_1406":1992,"_1996":1997,"_2001":2002,"_2006":2007,"_2011":2012,"_2015":2016,"_2019":2020,"_2024":2025,"_2029":2030,"_2033":2034,"_2039":2040,"_2043":2044,"_2047":2048,"_2052":2053,"_2056":2057,"_2060":2061,"_2064":2065,"_2070":2071,"_2075":2076,"_2080":2081,"_2085":2086,"_2090":2091,"_2095":2096,"_2100":2101,"_2105":2106,"_2110":2111,"_2115":2116,"_2120":2121,"_2125":2126,"_2130":2131,"_2135":2136},"adv.electricFence",{"_31":1626,"_1627":34,"_15":1624,"_1628":34,"_18":1629,"_1630":1196},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_31":1633,"_1627":1634,"_15":1631,"_1628":34,"_18":1635,"_1630":1249},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_31":1637,"_1627":1638,"_15":1313,"_1628":1639,"_18":1640,"_1630":1378},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_31":1643,"_1627":34,"_15":1641,"_1628":34,"_18":1644,"_1630":1196},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_31":1647,"_1627":1648,"_15":1645,"_1628":34,"_18":1649,"_1630":1196},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_31":1652,"_1627":34,"_15":1650,"_1628":34,"_18":1653,"_1630":1196},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_31":1656,"_1627":1657,"_15":1654,"_1628":34,"_18":1658,"_1630":1290},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_31":1661,"_1627":34,"_15":1659,"_1628":34,"_18":1662,"_1630":1196},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_31":1665,"_1627":1666,"_15":1663,"_1628":34,"_18":1667,"_1630":1196},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_31":1670,"_1627":34,"_15":1668,"_1628":34,"_18":1671,"_1630":34},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_31":1674,"_1627":1675,"_15":1672,"_1628":34,"_18":1676,"_1630":1249},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_31":1678,"_1627":1679,"_15":1128,"_1628":1680,"_18":1681,"_1630":1378},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_31":1684,"_1627":34,"_15":1682,"_1628":34,"_18":1685,"_1630":1196},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_31":1688,"_1627":1689,"_15":1686,"_1628":34,"_18":1690,"_1630":1196},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_31":1693,"_1627":1694,"_15":1691,"_1628":34,"_18":1695,"_1630":1196},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_31":1698,"_1627":34,"_15":1696,"_1628":34,"_18":1699,"_1630":1223},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_31":1702,"_1627":1703,"_15":1700,"_1628":34,"_18":1704,"_1630":1196},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_31":1707,"_1627":34,"_15":1705,"_1628":34,"_18":1708,"_1630":1223},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_31":1710,"_1627":1711,"_15":1211,"_1628":1712,"_18":1713,"_1630":1290},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_31":1716,"_1627":1711,"_15":1714,"_1628":34,"_18":1717,"_1630":1290},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_31":1720,"_1627":1721,"_15":1718,"_1628":1722,"_18":1723,"_1630":1223},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_31":1726,"_1627":34,"_15":1724,"_1628":34,"_18":1727,"_1630":1223},"持续时间内，受影响的目标暂停行动。","定身",{"_31":1729,"_1627":1730,"_15":1217,"_1628":1731,"_18":1732,"_1630":1402},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_31":1735,"_1627":1730,"_15":1733,"_1628":34,"_18":1736,"_1630":1402},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_31":1739,"_1627":34,"_15":1737,"_1628":1740,"_18":1741,"_1630":34},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_31":1743,"_1627":1744,"_15":1235,"_1628":1745,"_18":1746,"_1630":1352},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_31":1749,"_1627":1744,"_15":1747,"_1628":34,"_18":1750,"_1630":1352},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_31":1753,"_1627":1754,"_15":1751,"_1628":34,"_18":1755,"_1630":1196},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_31":1757,"_1627":1758,"_15":1242,"_1628":1759,"_18":1760,"_1630":1378},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_31":1763,"_1627":1764,"_15":1761,"_1628":1765,"_18":1766,"_1630":1223},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_31":1769,"_1627":1770,"_15":1767,"_1628":34,"_18":1771,"_1630":1223},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_31":1773,"_1627":1774,"_15":1266,"_1628":1775,"_18":1776,"_1630":1249},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_31":1779,"_1627":34,"_15":1777,"_1628":1780,"_18":1781,"_1630":1249},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_31":1784,"_1627":1785,"_15":1782,"_1628":34,"_18":1786,"_1630":1196},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_31":1789,"_1627":1790,"_15":1787,"_1628":34,"_18":1791,"_1630":1196},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_31":1794,"_1627":1795,"_15":1792,"_1628":34,"_18":1796,"_1630":1249},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_31":1798,"_1627":1634,"_15":1273,"_1628":1799,"_18":1800,"_1630":1249},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_31":1803,"_1627":34,"_15":1801,"_1628":1804,"_18":1805,"_1630":1223},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_31":1808,"_1627":1809,"_15":1806,"_1628":34,"_18":1810,"_1630":1196},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_31":1813,"_1627":34,"_15":1811,"_1628":34,"_18":1814,"_1630":34},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_31":1817,"_1627":1818,"_15":1815,"_1628":1819,"_18":1820,"_1630":1223},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_31":1823,"_1627":1824,"_15":1821,"_1628":34,"_18":1825,"_1630":1196},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_31":1828,"_1627":34,"_15":1826,"_1628":1829,"_18":1830,"_1630":1290},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_31":1832,"_1627":1833,"_15":1303,"_1628":1834,"_18":1835,"_1630":1290},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_31":1838,"_1627":1839,"_15":1836,"_1628":34,"_18":1840,"_1630":1196},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_31":1716,"_1627":1833,"_15":1841,"_1628":34,"_18":1843,"_1630":1290},"干员受到灼热附着","sys.tacticalItem",{"_31":1846,"_1627":34,"_15":1844,"_1628":34,"_18":1847,"_1630":1196},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_31":1850,"_1627":1851,"_15":1848,"_1628":34,"_18":1852,"_1630":1290},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_31":1735,"_1627":1855,"_15":1853,"_1628":34,"_18":1856,"_1630":1402},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_31":1859,"_1627":1860,"_15":1857,"_1628":1861,"_18":1862,"_1630":1223},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_31":1865,"_1627":34,"_15":1863,"_1628":34,"_18":1866,"_1630":1223},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_31":1869,"_1627":1870,"_15":1867,"_1628":34,"_18":1871,"_1630":1378},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_31":1874,"_1627":1875,"_15":1872,"_1628":34,"_18":1876,"_1630":1402},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_31":1879,"_1627":1880,"_15":1877,"_1628":34,"_18":1881,"_1630":1223},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_31":1883,"_1627":1884,"_15":1320,"_1628":1775,"_18":1885,"_1630":1249},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_31":1633,"_1627":1884,"_15":1886,"_1628":34,"_18":1888,"_1630":1249},"干员受到冻结","ba.naturalvul",{"_31":1891,"_1627":1892,"_15":1889,"_1628":34,"_18":1893,"_1630":1352},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_31":1678,"_1627":1895,"_15":1340,"_1628":1896,"_18":1897,"_1630":1378},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_31":1900,"_1627":1901,"_15":1898,"_1628":34,"_18":1902,"_1630":1196},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_31":1905,"_1627":1906,"_15":1903,"_1628":34,"_18":1907,"_1630":1196},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_31":1910,"_1627":1911,"_15":1908,"_1628":34,"_18":1912,"_1630":1196},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_31":1915,"_1627":34,"_15":1913,"_1628":34,"_18":1916,"_1630":1196},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_31":1919,"_1627":34,"_15":1917,"_1628":1920,"_18":1921,"_1630":34},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_31":1924,"_1627":1925,"_15":1922,"_1628":1926,"_18":1927,"_1630":1223},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_31":1929,"_1627":34,"_15":1140,"_1628":1930,"_18":1931,"_1630":1352},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_31":1933,"_1627":1934,"_15":1179,"_1628":1935,"_18":1936,"_1630":1378},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_31":1939,"_1627":1940,"_15":1937,"_1628":34,"_18":1941,"_1630":1196},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_31":1944,"_1627":1945,"_15":1942,"_1628":34,"_18":1946,"_1630":1352},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_31":1949,"_1627":1950,"_15":1947,"_1628":34,"_18":1951,"_1630":1196},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_31":1953,"_1627":1954,"_15":1366,"_1628":1955,"_18":1956,"_1630":1352},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_31":1749,"_1627":1954,"_15":1957,"_1628":34,"_18":1959,"_1630":1352},"干员受到自然附着","ba.originium",{"_31":1962,"_1627":34,"_15":1960,"_1628":34,"_18":1963,"_1630":1223},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_31":1966,"_1627":34,"_15":1964,"_1628":34,"_18":1967,"_1630":1378},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_31":1970,"_1627":1971,"_15":1968,"_1628":34,"_18":1972,"_1630":1378},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_31":1975,"_1627":34,"_15":1973,"_1628":1976,"_18":1977,"_1630":1386},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_31":1980,"_1627":34,"_15":1978,"_1628":34,"_18":1981,"_1630":1196},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_31":1984,"_1627":34,"_15":1982,"_1628":1985,"_18":1986,"_1630":1402},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_31":1989,"_1627":1990,"_15":1987,"_1628":34,"_18":1991,"_1630":1196},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_31":1993,"_1627":1855,"_15":1406,"_1628":1994,"_18":1995,"_1630":1402},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_31":1998,"_1627":1999,"_15":1996,"_1628":34,"_18":2000,"_1630":1402},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_31":2003,"_1627":34,"_15":2001,"_1628":2004,"_18":2005,"_1630":1223},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_31":2008,"_1627":34,"_15":2006,"_1628":2009,"_18":2010,"_1630":34},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_31":2013,"_1627":34,"_15":2011,"_1628":34,"_18":2014,"_1630":1196},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_31":2017,"_1627":34,"_15":2015,"_1628":34,"_18":2018,"_1630":1223},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_31":2021,"_1627":2022,"_15":2019,"_1628":34,"_18":2023,"_1630":1196},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_31":2026,"_1627":34,"_15":2024,"_1628":2027,"_18":2028,"_1630":1223},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_31":2031,"_1627":34,"_15":2029,"_1628":34,"_18":2032,"_1630":1196},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_31":2035,"_1627":2036,"_15":2033,"_1628":2037,"_18":2038,"_1630":1223},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_31":2041,"_1627":34,"_15":2039,"_1628":34,"_18":2042,"_1630":1223},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_31":2045,"_1627":34,"_15":2043,"_1628":34,"_18":2046,"_1630":1223},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_31":2049,"_1627":2050,"_15":2047,"_1628":34,"_18":2051,"_1630":1196},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_31":2054,"_1627":34,"_15":2052,"_1628":34,"_18":2055,"_1630":1223},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_31":2058,"_1627":34,"_15":2056,"_1628":34,"_18":2059,"_1630":1223},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_31":2062,"_1627":34,"_15":2060,"_1628":34,"_18":2063,"_1630":1223},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_31":2066,"_1627":2067,"_15":2064,"_1628":2068,"_18":2069,"_1630":1223},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_31":2072,"_1627":2073,"_15":2070,"_1628":34,"_18":2074,"_1630":1196},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_31":2077,"_1627":2078,"_15":2075,"_1628":34,"_18":2079,"_1630":1196},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_31":2082,"_1627":2083,"_15":2080,"_1628":34,"_18":2084,"_1630":1196},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_31":2087,"_1627":2088,"_15":2085,"_1628":34,"_18":2089,"_1630":1196},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_31":2092,"_1627":2093,"_15":2090,"_1628":34,"_18":2094,"_1630":1196},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_31":2097,"_1627":2098,"_15":2095,"_1628":34,"_18":2099,"_1630":1196},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_31":2102,"_1627":2103,"_15":2100,"_1628":34,"_18":2104,"_1630":1196},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_31":2107,"_1627":2108,"_15":2105,"_1628":34,"_18":2109,"_1630":1196},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_31":2112,"_1627":2113,"_15":2110,"_1628":34,"_18":2114,"_1630":1196},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_31":2117,"_1627":2118,"_15":2115,"_1628":34,"_18":2119,"_1630":1196},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_31":2122,"_1627":2123,"_15":2120,"_1628":34,"_18":2124,"_1630":1196},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_31":2127,"_1627":2128,"_15":2125,"_1628":34,"_18":2129,"_1630":1196},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_31":2132,"_1627":2133,"_15":2130,"_1628":34,"_18":2134,"_1630":1196},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_31":2137,"_1627":2138,"_15":2135,"_1628":34,"_18":2139,"_1630":1196},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维"]
