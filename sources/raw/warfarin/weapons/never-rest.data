[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_788":789},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0016","slug","never-rest","name","不知归","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Never Rest","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0016.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","随着向天空轰鸣的巨炮将黑夜还给熔炉要塞，蒸汽停止了嘶鸣，最后一只天使被碾成一堆碎石。胜利的号角声沿着雪地，穿过坍塌的壁垒，传入一处临时停放战死者遗体的石室内。\n对于熔炉要塞的工匠们而言，这声号角所代表的更多是和战士的道别。一名熔炉工匠拖着一车刚回收的装备，停在了一位年轻的战士面前——他早已没了呼吸。\n是什么让工匠停下脚步，对死亡的恐惧？他并不这么觉得，从递交加入铁誓军的申请书那天起，他便想到了自己会有像这名战士一样倒下的那天；当他真正来到熔炉要塞前，他也下定决心，要像一颗钉子一般钉在这里。如果有一天，他不再挥舞铁锤，不是他见证到了那个未来，便是到了需要有另一个人顶上他位置的那天。\n工匠弯下腰，捡起年轻战士手上的那柄长刀。\n他的视线始终无法从战士的脸庞移开。这是在向曾并肩作战的战友告别？不对，在他尚在南方，还没有出发北上的那段日子里，他也曾与各式各样的人告别。他见过至亲背着他落泪，见过至爱不舍的双眼，甚至在进入训练营的前夜，他还参加了一位挚友的葬礼。\n但他从未像现在这般，被这股莫名的情绪牢牢地拽在原地，即便他反复催促着自己离去。\n石室中骤然响起了一阵沉重的脚步声，工匠抬起头，然后屏住了呼吸。\n“杰拉德堡主！抱歉，我只是……我正在进行回收工作！”\n披甲的巨人伸出手，从工匠手中接过了那把刀，刀刃已经弯曲，刀身上隐隐浮现出一条裂痕。\n“你认识他？”\n“没……没有，算不上认识，前几天为我们办的欢迎会上，和他碰过一次杯……”\n“这把刀，你打算怎么办？”\n工匠接回刀，将刀柄上的积雪抖落，仔细观察着刀身上的伤痕：“能将他的刀投入熔炉中重铸是我的荣幸，就像能见证你们将这批天使击退。他是一个英雄……没有人会记得的英雄。”\n“也是一个普通人，正如这把刀。”\n“堡主阁下……那我该拿这把刀怎么办？”\n“再好的刀也会有折断的那天。”杰拉德拍了拍工匠的肩膀，“回熔炉去吧，它会在铁誓军中传递下去，完成他未完成的任务。”","weaponId","weaponPotentialSkill","sk_wpn_sword_0016","weaponSkillList",[51,52,48],"wpn_attr_will_high","wpn_sp_attr_atk_high","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":54},"backpackCanDiscard",false,"decoDesc","熔炉要塞锻造的武器之一。即使经过反复重铸，锋芒内敛，却依旧蕴含迫人威势。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",39,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,272,276,281,286,291,296,301,306,311,316,321,325,329,334,339,344,349,353,358,363,368,373,377,382,387,392,397,401,406,411,416,420,424,429,434,439,444,448,453,458,463,467,471,475,480,485,490,493,498,502,507],{"_99":100,"_101":102,"_103":86,"_104":54},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},56,2,{"_99":109,"_101":102,"_103":86,"_104":110},61,3,{"_99":112,"_101":113,"_103":86,"_104":114},66,20,4,{"_99":116,"_101":117,"_103":86,"_104":91},71,40,{"_99":119,"_101":120,"_103":86,"_104":41},76,50,{"_99":122,"_101":123,"_103":86,"_104":124},81,80,7,{"_99":126,"_101":127,"_103":86,"_104":128},86,110,8,{"_99":130,"_101":131,"_103":86,"_104":132},91,150,9,{"_99":134,"_101":135,"_103":102,"_104":102},96,200,{"_99":137,"_101":138,"_103":102,"_104":139},101,270,11,{"_99":141,"_101":142,"_103":102,"_104":143},106,370,12,{"_99":145,"_101":146,"_103":113,"_104":147},111,480,13,{"_99":149,"_101":150,"_103":151,"_104":152},116,620,30,14,{"_99":154,"_101":155,"_103":120,"_104":156},121,780,15,{"_99":158,"_101":159,"_103":160,"_104":161},126,990,70,16,{"_99":163,"_101":164,"_103":165,"_104":166},131,1250,100,17,{"_99":168,"_101":169,"_103":170,"_104":171},136,1550,140,18,{"_99":173,"_101":174,"_103":135,"_104":175},141,1900,19