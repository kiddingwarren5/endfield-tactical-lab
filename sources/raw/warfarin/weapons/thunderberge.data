[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_761":762},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0007","slug","thunderberge","name","大雷斑","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_494":495,"_556":557},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_1","engName","Thunderberge","levelTemplateId","weapon_upgrade_curve_6star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0007.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","她比其他人看得更清楚一些。\n跨过那扇门的旅途比她想象的要局促一些。一些幻影，一些迷离的色彩，肌肤上一闪而过的不切实际的触感，还有短暂的眩晕、低语、关于过往的碎片，紧接着，是严寒。从冬天回到冬天的严寒，很有真实感。\n她立刻询问身边的每一个人，每一个人都告诉了她不同的答案。有些人觉得眼睛一闭一睁就没事了，有些人则气喘吁吁地表示自己仿佛静滞了好几天的时间。\n她很好奇自己所见的东西是否有什么意义——好奇是她的天性。她花了几个小时在脑海里锚定那些色块、线条和不规律的音色。但它们就像春天小憩时的梦境那样难以捉摸，缺乏含义。\n直到她在一片旖旎的光线中看向了没有阻隔层的星空。\n塔罗斯。\n\n时间并没有把夕阳带到塔卫二的极点，巨大的星球占据了所有人的视野，像是某种远超巫王的巫术那样死死掐住了她的灵魂。她无法移开目光，她从未想过知识和财富之外，自然的景色会如此吸引她——如果宇宙这个崭新的视角能归类为自然的话，她不是很确定。\n她端详着塔罗斯。这是一颗几乎静止的大星球，戴上了可爱的环形丝带。她只在婶婶的缝纫机上见过这样可爱的丝带，像是花瓣的边缘。很快，她就发现静止只是塔罗斯可爱的小伎俩，这颗星球似乎正在不起眼地运动着。表面的光泽在流动，她能听见风声。\n但很快，这一切都消失了。塔罗斯又变回了那个一动不动的巨物。她感到心跳加速，一些不规律的想法涌现在脑海里。从儿时第一份法术课答卷开始，一直到去年在高塔上完成的进取研究。她看到了父母的面孔，看到了老师，看到了残垣断壁里伸出的一只手，看到了深远的流沙。她在漆黑的海岸边站稳脚跟，最后是自己的面庞，儿时所见的莱塔尼亚的天空，数星星的玩伴变成了无数个自己。\n她生平第一次有了这样的冲动。她狂热地爱上塔罗斯，狂热地想要触碰那颗巨大的星星。\n她感到那颗巨大的星星将一切联系了起来。\n依照这种联系，流淌在她体内的源石开始轻声合唱。\n从那一天起，她不再变化，她必须成为一位长生者，一如她痴爱的星球。","weaponId","weaponPotentialSkill","sk_wpn_claym_0007","weaponSkillList",[51,52,48],"wpn_attr_str_high","wpn_sp_attr_hp_high","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","终末地工业制造的特别装备之一。焰形剑搭配的交错式源石线路能提高基质效率。灵感来于观测到的塔罗斯现象。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",44,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,111,115,118,120,123,127,130,133,137,141,144,149,153,157,161,166,169,173,177,182,187,192,197,202,207,212,217,221,225,230,235,240,245,250,254,259,263,267,272,277,282,286,290,295,300,305,310,314,318,323,328,333,337,342,346,351,356,360,365,370,374,379,382,387,392,397,401,405,410,415,419,424,428,433,437,442,447,451,456,461,465,470,474,479,483,488,492],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":108},55,2,{"_100":110,"_102":103,"_104":86,"_105":54},60,{"_100":112,"_102":113,"_104":86,"_105":114},65,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},70,40,{"_100":119,"_102":101,"_104":86,"_105":41},75,{"_100":121,"_102":121,"_104":86,"_105":122},80,7,{"_100":124,"_102":125,"_104":86,"_105":126},85,110,8,{"_100":35,"_102":128,"_104":86,"_105":129},150,9,{"_100":131,"_102":132,"_104":103,"_105":103},95,200,{"_100":134,"_102":135,"_104":103,"_105":136},100,270,11,{"_100":138,"_102":139,"_104":103,"_105":140},105,370,12,{"_100":125,"_102":142,"_104":113,"_105":143},480,13,{"_100":145,"_102":146,"_104":147,"_105":148},115,620,30,14,{"_100":150,"_102":151,"_104":101,"_105":152},120,780,15,{"_100":154,"_102":155,"_104":116,"_105":156},125,990,16,{"_100":158,"_102":159,"_104":134,"_105":160},130,1250,17,{"_100":162,"_102":163,"_104":164,"_105":165},135,1550,140,18,{"_100":164,"_102":167,"_104":132,"_105":168}