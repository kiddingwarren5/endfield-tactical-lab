[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_763":764},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0006","slug","cohesive-traction","name","向心之引","type","weapon","version","1.6",{"_26":27,"_54":55,"_93":94,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":41},"breakthroughTemplateId","weapon_breakthrough_456star_C_2","engName","Cohesive Traction","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0006.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","这城里有许多家族。提起最和睦美好的，大家一时间还真想不起来，但要是说起最不和睦的，一定是韦伯家。很少有一个家庭，在有如此多孩子的同时，又有如此多的嫌隙，每六十四平方公里的土地上，只能有一个韦伯家的孩子，不然便会有暴力的流血事件降临这片不幸的土地。\n上个月，韦伯家最年长的孩子在战场上接到一封信，杀死眼前的敌人后，他找到长官，请了一个月的假，踏上了返城的旅途。他走过林地，遇到自己的弟弟，在斧头砸向面门前，他将信里的内容说了出来。他的弟弟随即将斧子丢下，草草收拾了几样东西，便一同踏上长路。\n河流的岸边，他们的妹妹已经早早乘船等候，她手里巨大的船桨让他们不得不一路提防，上一次他们在她面前大意，醒过来就是三天后了。\n他们剩下的时间不多，但他们剩下的旅途还很长。\n前方还有一片辽阔的沙漠要穿越，就在他们迷失于随时会变换形状的沙丘中时，一支车队及时赶来。为首的车降下窗户，露出一张他们深恶痛绝的脸——卑鄙无耻的小叔。从小到大，只要他们陷入困境，小叔必定不远万里赶来嘲笑。\n“上车吧，你们这群小崽子。”小叔挥挥手，招呼他们坐上车，无视翻给自己的三个白眼。后面的车子一起响起喇叭，催促他们赶紧上车，吵闹的声音后不知又藏了多少个烦人的亲戚。\n车队再次启程，只在沙漠中留下几行易逝的车辙。日夜兼程，他们终于成功抵达最后一站，丰水期的湖泊在暴风的裹挟下，翻起巨大的浪花，好在他们最富裕的姑妈有一艘坚固、宏伟的大船，足够把整个韦伯家族的人都塞进去。\n暴风雨中，姑妈迎着浪头，昂首走在颠簸的甲板上，用左边的鼻孔鄙视了所有吐出来的人，用右边的鼻孔嘲笑了剩下扶着栏杆脸色苍白的人。在狂风的护送下，他们顺利抵达了家乡。\n当天城内，一众韦伯家族的成员争分夺秒跑过主街的景象让所有人咋舌，从街头到街尾，浩浩荡荡，直奔最大的医院。\n最终，他们齐齐聚在病房中，将一个还在襁褓中的女孩团团围住。女孩掀起眼皮，虚弱地扫过在场所有人，随后，那双未被世事烦扰过的眼睛便永久闭上了。\n“谢谢你们愿意来见她最后一面。”抱紧孩子逐渐冰冷的尸体，韦伯家最年幼的女儿轻声道。","weaponId","weaponPotentialSkill","sk_wpn_lance_0006","weaponSkillList",[51,52,48],"wpn_attr_will_mid","wpn_sp_attr_electrondam_mid","weaponType","itemTable",{"_56":57,"_58":59,"_60":61,"_62":63,"_64":16,"_15":16,"_65":66,"_67":66,"_68":69,"_19":20,"_70":71,"_72":63,"_73":74,"_75":76,"_77":63,"_78":79,"_81":82,"_40":41,"_83":57,"_84":85,"_86":87,"_88":89,"_21":41,"_90":57,"_91":92},"backpackCanDiscard",false,"decoDesc","雷神工业客制化产品线的经典案例。在军用刺枪形制的基础上，增添了多样化的特殊功能和个人化的美学设计。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[80],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",24,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_95":96},"list",[97,104,107,110,114,117,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,183,188,193,197,202,207,212,217,222,226,231,236,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_98":99,"_100":101,"_102":85,"_103":92},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_98":105,"_100":101,"_102":85,"_103":106},46,2,{"_98":108,"_100":101,"_102":85,"_103":109},50,3,{"_98":111,"_100":112,"_102":85,"_103":113},54,20,4,{"_98":115,"_100":116,"_102":85,"_103":41},58,40,{"_98":118,"_100":108,"_102":85,"_103":119},62,6,{"_98":121,"_100":122,"_102":85,"_103":123},66,80,7,{"_98":125,"_100":126,"_102":85,"_103":127},71,110,8,{"_98":129,"_100":130,"_102":85,"_103":131},75,150,9,{"_98":133,"_100":134,"_102":101,"_103":101},79,200,{"_98":136,"_100":137,"_102":101,"_103":138},83,270,11,{"_98":140,"_100":141,"_102":101,"_103":142},87,370,12,{"_98":144,"_100":145,"_102":112,"_103":146},91,480,13,{"_98":148,"_100":149,"_102":150,"_103":151},95,620,30,14,{"_98":153,"_100":154,"_102":108,"_103":155},100,780,15,{"_98":157,"_100":158,"_102":159,"_103":160},104,990,70,16,{"_98":162,"_100":163,"_102":153,"_103":164},108,1250,17,{"_98":166,"_100":167,"_102":168,"_103":169},112