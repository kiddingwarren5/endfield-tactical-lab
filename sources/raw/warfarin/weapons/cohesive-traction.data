5":1278,"_786":1280,"_789":1281},[788,788,788],[1282,1282,1282],"<color=#1e1e1e>","tips.key",{"_15":1283,"_786":1285,"_789":1286},[788,788,788],[1287,1288,1287],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1289,"_786":1291,"_789":1292},[788,788,788],[1076,1077,1078],"toast_focal.key",{"_15":1293,"_786":1295,"_789":1296},[788,788,788],[1288,1288,1288],"weapon.stress",{"_15":1297,"_786":1299,"_789":1300},[788,788,788],[1301,1301,1301],"<color=#fe5a00>","weekraid.key",{"_15":1302,"_786":1304,"_789":1305},[945,945,945],[1306,1306,1307],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_1310":1311,"_1317":1318,"_999":1322,"_1327":1328,"_1331":1332,"_1336":1337,"_1340":1341,"_1345":1346,"_1349":1350,"_1354":1355,"_1358":1359,"_814":1363,"_1368":1369,"_1372":1373,"_1377":1378,"_1382":1383,"_1386":1387,"_1391":1392,"_897":1395,"_1400":1401,"_1404":1405,"_1410":1411,"_903":1414,"_1419":1420,"_1423":1424,"_921":1428,"_1433":1434,"_1437":1438,"_928":1442,"_1447":1448,"_1453":1454,"_952":1458,"_1463":1464,"_1468":1469,"_1473":1474,"_1478":1479,"_959":1483,"_1487":1488,"_1492":1493,"_1497":1498,"_1501":1502,"_1507":1508,"_1512":1513,"_989":1517,"_1522":1523,"_1527":1528,"_1530":1531,"_1534":1535,"_1539":1540,"_1543":1544,"_1549":1550,"_1553":1554,"_1558":1559,"_1563":1564,"_1006":1568,"_1572":1573,"_1575":1576,"_1026":1580,"_1584":1585,"_1589":1590,"_1594":1595,"_1599":1600,"_1603":1604,"_1608":1609,"_826":1614,"_865":1618,"_1623":1624,"_1628":1629,"_1633":1634,"_1052":1638,"_1643":1644,"_1646":1647,"_1650":1651,"_1654":1655,"_1659":1660,"_1664":1665,"_1668":1669,"_1673":1674,"_1092":1678,"_1682":1683,"_1687":1688,"_1692":1693,"_1697":1698,"_1701":1702,"_1705":1706,"_1710":1711,"_1715":1716,"_1719":1720,"_1725":1726,"_1729":1730,"_1733":1734,"_1738":1739,"_1742":1743,"_1746":1747,"_1750":1751,"_1756":1757,"_1761":1762,"_1766":1767,"_1771":1772,"_1776":1777,"_1781":1782,"_1786":1787,"_1791":1792,"_1796":1797,"_1801":1802,"_1806":1807,"_1811":1812,"_1816":1817,"_1821":1822},"adv.electricFence",{"_60":1312,"_1313":63,"_15":1310,"_1314":63,"_19":1315,"_1316":882},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_60":1319,"_1313":1320,"_15":1317,"_1314":63,"_19":1321,"_1316":935},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_60":1323,"_1313":1324,"_15":999,"_1314":1325,"_19":1326,"_1316":1064},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_60":1329,"_1313":63,"_15":1327,"_1314":63,"_19":1330,"_1316":882},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_60":1333,"_1313":1334,"_15":1331,"_1314":63,"_19":1335,"_1316":882},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_60":1338,"_1313":63,"_15":1336,"_1314":63,"_19":1339,"_1316":882},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_60":1342,"_1313":1343,"_15":1340,"_1314":63,"_19":1344,"_1316":976},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_60":1347,"_1313":63,"_15":1345,"_1314":63,"_19":1348,"_1316":882},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_60":1351,"_1313":1352,"_15":1349,"_1314":63,"_19":1353,"_1316":882},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_60":1356,"_1313":63,"_15":1354,"_1314":63,"_19":1357,"_1316":63},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_60":1360,"_1313":1361,"_15":1358,"_1314":63,"_19":1362,"_1316":935},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_60":1364,"_1313":1365,"_15":814,"_1314":1366,"_19":1367,"_1316":1064},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_60":1370,"_1313":63,"_15":1368,"_1314":63,"_19":1371,"_1316":882},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_60":1374,"_1313":1375,"_15":1372,"_1314":63,"_19":1376,"_1316":882},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_60":1379,"_1313":1380,"_15":1377,"_1314":63,"_19":1381,"_1316":882},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_60":1384,"_1313":63,"_15":1382,"_1314":63,"_19":1385,"_1316":909},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_60":1388,"_1313":1389,"_15":1386,"_1314":63,"_19":1390,"_1316":882},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_60":1393,"_1313":63,"_15":1391,"_1314":63,"_19":1394,"_1316":909},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_60":1396,"_1313":1397,"_15":897,"_1314":1398,"_19":1399,"_1316":976},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_60":1402,"_1313":1397,"_15":1400,"_1314":63,"_19":1403,"_1316":976},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_60":1406,"_1313":1407,"_15":1404,"_1314":1408,"_19":1409,"_1316":909},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_60":1412,"_1313":63,"_15":1410,"_1314":63,"_19":1413,"_1316":909},"持续时间内，受影响的目标暂停行动。","定身",{"_60":1415,"_1313":1416,"_15":903,"_1314":1417,"_19":1418,"_1316":1088},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_60":1421,"_1313":1416,"_15":1419,"_1314":63,"_19":1422,"_1316":1088},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_60":1425,"_1313":63,"_15":1423,"_1314":1426,"_19":1427,"_1316":63},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_60":1429,"_1313":1430,"_15":921,"_1314":1431,"_19":1432,"_1316":1038},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_60":1435,"_1313":1430,"_15":1433,"_1314":63,"_19":1436,"_1316":1038},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_60":1439,"_1313":1440,"_15":1437,"_1314":63,"_19":1441,"_1316":882},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_60":1443,"_1313":1444,"_15":928,"_1314":1445,"_19":1446,"_1316":1064},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_60":1449,"_1313":1450,"_15":1447,"_1314":1451,"_19":1452,"_1316":909},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_60":1455,"_1313":1456,"_15":1453,"_1314":63,"_19":1457,"_1316":909},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_60":1459,"_1313":1460,"_15":952,"_1314":1461,"_19":1462,"_1316":935},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_60":1465,"_1313":63,"_15":1463,"_1314":1466,"_19":1467,"_1316":935},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_60":1470,"_1313":1471,"_15":1468,"_1314":63,"_19":1472,"_1316":882},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_60":1475,"_1313":1476,"_15":1473,"_1314":63,"_19":1477,"_1316":882},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_60":1480,"_1313":1481,"_15":1478,"_1314":63,"_19":1482,"_1316":935},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_60":1484,"_1313":1320,"_15":959,"_1314":1485,"_19":1486,"_1316":935},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_60":1489,"_1313":63,"_15":1487,"_1314":1490,"_19":1491,"_1316":909},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_60":1494,"_1313":1495,"_15":1492,"_1314":63,"_19":1496,"_1316":882},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_60":1499,"_1313":63,"_15":1497,"_1314":63,"_19":1500,"_1316":63},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_60":1503,"_1313":1504,"_15":1501,"_1314":1505,"_19":1506,"_1316":909},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_60":1509,"_1313":1510,"_15":1507,"_1314":63,"_19":1511,"_1316":882},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_60":1514,"_1313":63,"_15":1512,"_1314":1515,"_19":1516,"_1316":976},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_60":1518,"_1313":1519,"_15":989,"_1314":1520,"_19":1521,"_1316":976},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_60":1524,"_1313":1525,"_15":1522,"_1314":63,"_19":1526,"_1316":882},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_60":1402,"_1313":1519,"_15":1527,"_1314":63,"_19":1529,"_1316":976},"干员受到灼热附着","sys.tacticalItem",{"_60":1532,"_1313":63,"_15":1530,"_1314":63,"_19":1533,"_1316":882},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_60":1536,"_1313":1537,"_15":1534,"_1314":63,"_19":1538,"_1316":976},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_60":1421,"_1313":1541,"_15":1539,"_1314":63,"_19":1542,"_1316":1088},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_60":1545,"_1313":1546,"_15":1543,"_1314":1547,"_19":1548,"_1316":909},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_60":1551,"_1313":63,"_15":1549,"_1314":63,"_19":1552,"_1316":909},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_60":1555,"_1313":1556,"_15":1553,"_1314":63,"_19":1557,"_1316":1064},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_60":1560,"_1313":1561,"_15":1558,"_1314":63,"_19":1562,"_1316":1088},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_60":1565,"_1313":1566,"_15":1563,"_1314":63,"_19":1567,"_1316":909},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_60":1569,"_1313":1570,"_15":1006,"_1314":1461,"_19":1571,"_1316":935},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_60":1319,"_1313":1570,"_15":1572,"_1314":63,"_19":1574,"_1316":935},"干员受到冻结","ba.naturalvul",{"_60":1577,"_1313":1578,"_15":1575,"_1314":63,"_19":1579,"_1316":1038},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_60":1364,"_1313":1581,"_15":1026,"_1314":1582,"_19":1583,"_1316":1064},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_60":1586,"_1313":1587,"_15":1584,"_1314":63,"_19":1588,"_1316":882},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_60":1591,"_1313":1592,"_15":1589,"_1314":63,"_19":1593,"_1316":882},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_60":1596,"_1313":1597,"_15":1594,"_1314":63,"_19":1598,"_1316":882},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_60":1601,"_1313":63,"_15":1599,"_1314":63,"_19":1602,"_1316":882},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_60":1605,"_1313":63,"_15":1603,"_1314":1606,"_19":1607,"_1316":63},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_60":1610,"_1313":1611,"_15":1608,"_1314":1612,"_19":1613,"_1316":909},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_60":1615,"_1313":63,"_15":826,"_1314":1616,"_19":1617,"_1316":1038},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_60":1619,"_1313":1620,"_15":865,"_1314":1621,"_19":1622,"_1316":1064},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_60":1625,"_1313":1626,"_15":1623,"_1314":63,"_19":1627,"_1316":882},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_60":1630,"_1313":1631,"_15":1628,"_1314":63,"_19":1632,"_1316":1038},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_60":1635,"_1313":1636,"_15":1633,"_1314":63,"_19":1637,"_1316":882},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_60":1639,"_1313":1640,"_15":1052,"_1314":1641,"_19":1642,"_1316":1038},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_60":1435,"_1313":1640,"_15":1643,"_1314":63,"_19":1645,"_1316":1038},"干员受到自然附着","ba.originium",{"_60":1648,"_1313":63,"_15":1646,"_1314":63,"_19":1649,"_1316":909},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_60":1652,"_1313":63,"_15":1650,"_1314":63,"_19":1653,"_1316":1064},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_60":1656,"_1313":1657,"_15":1654,"_1314":63,"_19":1658,"_1316":1064},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_60":1661,"_1313":63,"_15":1659,"_1314":1662,"_19":1663,"_1316":1072},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_60":1666,"_1313":63,"_15":1664,"_1314":63,"_19":1667,"_1316":882},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_60":1670,"_1313":63,"_15":1668,"_1314":1671,"_19":1672,"_1316":1088},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_60":1675,"_1313":1676,"_15":1673,"_1314":63,"_19":1677,"_1316":882},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_60":1679,"_1313":1541,"_15":1092,"_1314":1680,"_19":1681,"_1316":1088},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_60":1684,"_1313":1685,"_15":1682,"_1314":63,"_19":1686,"_1316":1088},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_60":1689,"_1313":63,"_15":1687,"_1314":1690,"_19":1691,"_1316":909},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_60":1694,"_1313":63,"_15":1692,"_1314":1695,"_19":1696,"_1316":63},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_60":1699,"_1313":63,"_15":1697,"_1314":63,"_19":1700,"_1316":882},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_60":1703,"_1313":63,"_15":1701,"_1314":63,"_19":1704,"_1316":909},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_60":1707,"_1313":1708,"_15":1705,"_1314":63,"_19":1709,"_1316":882},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_60":1712,"_1313":63,"_15":1710,"_1314":1713,"_19":1714,"_1316":909},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_60":1717,"_1313":63,"_15":1715,"_1314":63,"_19":1718,"_1316":882},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_60":1721,"_1313":1722,"_15":1719,"_1314":1723,"_19":1724,"_1316":909},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_60":1727,"_1313":63,"_15":1725,"_1314":63,"_19":1728,"_1316":909},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_60":1731,"_1313":63,"_15":1729,"_1314":63,"_19":1732,"_1316":909},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_60":1735,"_1313":1736,"_15":1733,"_1314":63,"_19":1737,"_1316":882},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_60":1740,"_1313":63,"_15":1738,"_1314":63,"_19":1741,"_1316":909},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_60":1744,"_1313":63,"_15":1742,"_1314":63,"_19":1745,"_1316":909},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_60":1748,"_1313":63,"_15":1746,"_1314":63,"_19":1749,"_1316":909},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_60":1752,"_1313":1753,"_15":1750,"_1314":1754,"_19":1755,"_1316":909},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_60":1758,"_1313":1759,"_15":1756,"_1314":63,"_19":1760,"_1316":882},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_60":1763,"_1313":1764,"_15":1761,"_1314":63,"_19":1765,"_1316":882},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_60":1768,"_1313":1769,"_15":1766,"_1314":63,"_19":1770,"_1316":882},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_60":1773,"_1313":1774,"_15":1771,"_1314":63,"_19":1775,"_1316":882},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_60":1778,"_1313":1779,"_15":1776,"_1314":63,"_19":1780,"_1316":882},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_60":1783,"_1313":1784,"_15":1781,"_1314":63,"_19":1785,"_1316":882},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_60":1788,"_1313":1789,"_15":1786,"_1314":63,"_19":1790,"_1316":882},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_60":1793,"_1313":1794,"_15":1791,"_1314":63,"_19":1795,"_1316":882},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_60":1798,"_1313":1799,"_15":1796,"_1314":63,"_19":1800,"_1316":882},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_60":1803,"_1313":1804,"_15":1801,"_1314":63,"_19":1805,"_1316":882},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_60":1808,"_1313":1809,"_15":1806,"_1314":63,"_19":1810,"_1316":882},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_60":1813,"_1313":1814,"_15":1811,"_1314":63,"_19":1815,"_1316":882},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_60":1818,"_1313":1819,"_15":1816,"_1314":63,"_19":1820,"_1316":882},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_60":1823,"_1313":1824,"_15":1821,"_1314":63,"_19":1825,"_1316":882},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维",{"_513":1827,"_528":1829,"_538":1831,"_547":1833,"_549":1835,"_559":1837,"_561":1839,"_1841":1842},{"_15":513,"_64":513,"_19":1828,"_40":109},"强固模具",{"_15":528,"_64":528,"_19":1830,"_40":113},"轻黯石",{"_15":538,"_64":538,"_19":1832,"_40":113},"中黯石",{"_15":547,"_64":547,"_19":1834,"_40":113},"重型强固模具",{"_15":549,"_64":549,"_19":1836,"_40":113},"重黯石",{"_15":559,"_64":559,"_19":1838,"_40":41},"快子遴捡晶格",{"_15":561,"_64":561,"_19":1840,"_40":41},"武陵石","item_gold",{"_15":1841,"_64":1841,"_19":1843,"_40":113},"折金票"]
