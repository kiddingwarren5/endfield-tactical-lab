[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_744":745},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0014","slug","ancient-canal","name","古渠","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_2","engName","Ancient Canal","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0014.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","我并不能触摸所有人的心，但我至少能看透我自己的。\n此时此刻，我的心中只有无边的恐惧，我们的科考站，我们为了战胜无边无际的甚大裂隙而准备的“观景台”，就这样被淹没在了侵蚀中，这让我感到绝望。息壤真的可行吗？我们过去的所作所为真的有任何意义吗？比起超域，人类还是过于渺小了。武陵会被吞没，万事万物都会被吞没，我们如何撼动巨物？\n…………\n我们需要挖一道水渠，虽然现在针对事故现场受灾者的抢救才是最重要的，但这道水渠也是必须的，它至少能保证地下水脉不被渗透进来的侵蚀潮污染。但这也没什么意义，只不过是早死一天和晚死一天的区别。\n…………\n满手水泡。就算我完全不懂工程，只是设备车间的职工，现在也要加入施工……本部的支援到来前，只能先靠我们自己撑住。\n…………\n手被划伤了，我在水渠工地挖出了一把折断的匕首，它在这里埋了多久？一百年？看看手上的血吧！不愿意直视的那根弦早就绷断了！父母妻儿都不在了，我也不再相信什么荣光和牺牲。我为什么还要活着，我为什么还要活着，我为什么还要活着，我为什么还要活着？\n…………\n明天就自杀吧。\n…………\n我选了深夜，在施工现场自杀。确实是个好地方，也是个好天气，大雨瓢泼，好像所有东西都泡在了泥里，我们这种失败者，就应该这样死在泥地里。\n大雨冲垮了水渠尚未挖掘完成的部分。我在被冲开的泥土中，看到了一点点金属的光泽。不知道为什么，我走了过去，用双手刨开土，看到了下面埋着的是什么，那是一个锈蚀的阀门。\n原来如此。\n没有资料，没有确认，就只是最仓促的施工，极巧合地，我们挖通了前人未能完工的水渠。\n锈蚀掉渣的阀门在那一瞬间变换了形象，它是我父亲的嘱托、我母亲的肖像，又或者是我祖父母坟前的纸花。\n最后是我，污水倒影中的我。\n原来如此。\n永远有人想要活下去，也永远有人能够活下去。\n天地并非无限，恐惧亦会被蚕食干净。\n故我不再想着死亡。\n我所延续的，仅是生命存续的本相，如此反复，千古恒常。","weaponId","weaponPotentialSkill","sk_wpn_claym_0014","weaponSkillList",[51,52,48],"wpn_attr_str_mid","wpn_sp_attr_phy_spell_mid","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","宏山选剑局制造的优质大剑。较之同类产品，它更轻盈，但杀伤力却没有降低分毫。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",34,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,110,114,117,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,183,188,193,198,203,208,213,218,223,227,232,237,242,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},46,2,{"_99":109,"_101":102,"_103":86,"_104":54},50,{"_99":111,"_101":112,"_103":86,"_104":113},54,20,4,{"_99":115,"_101":116,"_103":86,"_104":41},58,40,{"_99":118,"_101":109,"_103":86,"_104":119},62,6,{"_99":121,"_101":122,"_103":86,"_104":123},66,80,7,{"_99":125,"_101":126,"_103":86,"_104":127},71,110,8,{"_99":129,"_101":130,"_103":86,"_104":131},75,150,9,{"_99":133,"_101":134,"_103":102,"_104":102},79,200,{"_99":136,"_101":137,"_103":102,"_104":138},83,270,11,{"_99":140,"_101":141,"_103":102,"_104":142},87,370,12,{"_99":144,"_101":145,"_103":112,"_104":146},91,480,13,{"_99":148,"_101":149,"_103":150,"_104":151},95,620,30,14,{"_99":153,"_101":154,"_103":109,"_104":155},100,780,15,{"_99":157,"_101":158,"_103":159,"_104":160},104,990,70,16,{"_99":162,"_101":163,"_103":153,"_104":164},108,1250,17,{"_99":166,"_101":167,"_103":168,"_104":169},112,1550,140,18,{"_99":171,"_101":172,"_103":134,"_104":173},116,1900,19,