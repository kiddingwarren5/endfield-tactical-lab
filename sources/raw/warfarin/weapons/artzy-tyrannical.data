[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_774":775},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_pistol_0010","slug","artzy-tyrannical","name","艺术暴君","type","weapon","version","1.6",{"_26":27,"_54":55,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":41},"breakthroughTemplateId","weapon_breakthrough_456star_C_2","engName","Artzy Tyrannical","levelTemplateId","weapon_upgrade_curve_6star_1.02","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_pistol_0010.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","对塔卫二当今“前卫”艺术的挑战书\n\n致自诩“前卫”的大艺术家们：\n你们好吗？我指的是那些在废墟墙上喷涂图案，在菈梵朵玛的地下酒吧里嘶吼，自认为创造“史无前例”艺术的各位。\n告诉你们一个残酷事实，你们所谓的前卫艺术，九成都是从泰拉历史中翻出的陈年旧货。\n菈梵朵玛的新说唱厂牌？在看完汐斯塔黑曜石音乐节的十大经典音乐现场后，我并不觉得他们比起那位名为“大帝”的说唱巨星在律动和韵脚上有任何的创新。[链接已失效] \n艾什柏环岛的百人涂鸦？根据我挖到的资料，这些东西在泰拉曾经的乌萨斯工厂基地早就烂大街了。许多年前，感染者工人就在厂房墙上画着同样的东西。[附件已丢失]\n至于新蓝卡坞的新青年电影节？那就更搞笑了，因为他们连自由市的名字都沿用的泰拉上的蓝卡坞！\n真正属于塔卫二的前卫艺术在哪儿？\n既然渴望创新，我告诉你们什么才是真前卫。\n这是我挖到的关于终末地协议源石技术的一段视频。[作者已将此视频设为付费观看]\n可能很多人会对我提到协议源石技术感到困惑，但想想看，艺术离不开工艺技术，我们如果一直在源自泰拉的技术基础上进行审美文化的再创作，就像我先前举的那些例子那样，那么我们当然就难以摆脱泰拉文化的标签！\n而协议源石技术，可以说是塔卫二独有的最“前卫”、最“酷”的技术了，不是么？它彻底打破了我们对空间维度的认知，怎么我还没看到将它应用于艺术创作的艺术家？\n前卫艺术不是翻新旧货，不是给古董贴新标签。\n如果你们继续玩祖父辈的把戏，请不要再自诩“前卫”。\n\n本文不代表任何官方立场，仅为个人观点。如有不适，请自行离开。\n\n\n作者：艺术暴君\n发布时间：151年██月██日","weaponId","weaponPotentialSkill","sk_wpn_pistol_0010","weaponSkillList",[51,52,48],"wpn_attr_wisd_high","wpn_sp_attr_crirate_high","weaponType","itemTable",{"_56":57,"_58":59,"_60":61,"_62":63,"_64":16,"_15":16,"_65":66,"_67":66,"_68":69,"_19":20,"_70":71,"_72":63,"_73":74,"_75":76,"_77":63,"_78":79,"_81":82,"_40":41,"_83":57,"_84":85,"_86":87,"_88":89,"_21":90,"_91":57,"_92":93},"backpackCanDiscard",false,"decoDesc","梅什科工业大胆推出的艺术家联名系列中最受欢迎的产品之一。充满个性的造型匹配狂暴的性能，在二级市场的溢价足以证明它的人气。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[80],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",43,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,267,272,276,281,286,290,294,299,304,309,314,319,323,327,332,337,342,347,351,356,361,366,371,375,380,385,390,395,399,404,409,414,418,422,427,432,437,442,447,451,456,461,465,470,474,479,484,489,494,497,502,506],{"_99":100,"_101":102,"_103":85,"_104":93},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":85,"_104":107},56,2,{"_99":109,"_101":102,"_103":85,"_104":110},61,3,{"_99":112,"_101":113,"_103":85,"_104":114},66,20,4,{"_99":116,"_101":117,"_103":85,"_104":90},71,40,{"_99":119,"_101":120,"_103":85,"_104":41},77,50,{"_99":122,"_101":123,"_103":85,"_104":124},82,80,7,{"_99":126,"_101":127,"_103":85,"_104":128},87,110,8,{"_99":130,"_101":131,"_103":85,"_104":132},92,150,9,{"_99":134,"_101":135,"_103":102,"_104":102},97,200,{"_99":137,"_101":138,"_103":102,"_104":139},102,270,11,{"_99":141,"_101":142,"_103":102,"_104":143},107,370,12,{"_99":145,"_101":146,"_103":113,"_104":147},112,480,13,{"_99":149,"_101":150,"_103":151,"_104":152},117,620,30,14,{"_99":154,"_101":155,"_103":120,"_104":156},122,780,15,{"_99":158,"_101":159,"_103":160,"_104":161},128,990,70,16,{"_99":163,"_101":164,"_103":165,"_104":166},133,1250,100,17,{"_99":168,"_101":169,"_103":170,"_104":171},138,1550,140,18,{"_99":173,"_101":174,"_103":135,"_104":175},143,1900,19,{"_99":177,"_101":178,"_103":179,"_104":113},148,2360,240,{"_99":181,"_101"