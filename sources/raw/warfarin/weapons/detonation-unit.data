[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_766":767},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0008","slug","detonation-unit","name","爆破单元","type","weapon","version","1.6",{"_26":27,"_55":56,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_2","engName","Detonation Unit","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0010.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","我收到了沃尔特的需求，简直匪夷所思。我反复确认他是否在输出功率一栏多写了个零。他要的不是施术单元，而是便携式巨炮。他声称这是开拓前线急需的装备，但我不愿将如此危险的武器交给前线开拓者。\n…………\n理论上，达到这种输出功率并非不可能。我的计算显示，这是可行的。但风险太大了。我必须重新设计施术单元的结构……这会使其重量增加两倍。\n…………\n链式切割器？这需求荒谬至极。难道他们打算用施术单元去砸敌人吗？不过，按照现有构型，确实有空间加装。或许值得一试。\n…………\n战线推进后，沃尔特邀我实地考察。用他的话说……是去看看我的“杰作”。我希望他能给出充分理由，解释为何我提供的原型机连一片残骸都没带回来。\n…………\n那场景我终生难忘——一个如山般巨大的天使。它的残骸堵塞了整个山谷。沃尔特告诉我，他操控原型机撞向这个天使，用链锯在其表面开出一道裂缝。随后……天崩地裂。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0008","weaponSkillList",[51,52,48],"wpn_attr_main_high","wpn_sp_attr_phy_spell_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":64,"_75":76,"_77":78,"_79":64,"_80":81,"_83":84,"_40":41,"_85":58,"_86":87,"_88":89,"_90":91,"_21":92,"_93":58,"_94":95},"backpackCanDiscard",false,"decoDesc","北进重工支援所开发的施术单元，拥有毫无争议的最佳源石技艺传导性。只有最强壮的使用者才能驾驭这一产品。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","wpn_funnel_0010","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain