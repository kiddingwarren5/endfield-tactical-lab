[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_756":757},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0014","slug","white-night-nova","name","白夜新星","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_D_1","engName","White Night Nova","levelTemplateId","weapon_upgrade_curve_6star_1.02","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0014.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","她开始回想自己为什么会被选中执行这个任务。\n不仅因为她擅长冰冻的源石技艺，能更好适应雪原环境，更是因为她极为擅长在荒野中寻找道路。几乎像直觉一般，她能在夜晚将高天上的星辰视作引路明灯，若是在铁誓军这个刚刚成立不到一年的组织中，寻找一个最适合出发探路，重建与文明间联系的人，那自然非她莫属。\n她很清楚，所以带着那块硬盘出发了。\n硬盘中存放着的是铁誓军这一年以来收集到的所有数据，有关北地、敌人与朋友。曾经，不惧死亡的人们站出队列，集合在一处，念诵出如钢铁般的誓言后，他们与文明相背而行，走向北方，走回被毁灭的战场，开始用自身为诱饵，吸引天使的攻势……许多人将他们的离开视为一个信号——文明即将崩溃的信号。悲观者笃信，自牺牲者——如今已被称为铁誓军的人们——开始，会有更多的人成为文明弃子……铁誓军清楚这一点，所以，他们必须恢复与文明的联系，以生命换来的情报必须成为一颗引明前路的星辰。\n小小“星辰”如今就在送信者的包裹中，她深深喘息，在冰天雪地中缓缓行走。\n大量血液顺着手臂流下来，滴落在地上。左臂和左腿几乎粉碎，她能清楚地感觉到骨头碴儿在体内摩擦，带来剧痛，这些伤来自于一种从未见过的新天使。送信者想到了要塞城门……击碎她肢体的天使或许本是为了攻城而形成的？\n一些繁杂念头开始翻涌，在铁誓军最初前往北地的路上，几乎每天都能遇到闻所未闻的天使。就好像有某个拷问官兴致勃勃地展示刑具似的，无数种能够越发高效地杀戮人类的天使在战场各处止不住地涌现。想打败它们，需要代价——很多人，前赴后继……\n打败它们……是了……\n送信者回想起来，原来自己还活着。刚刚胜利的并非天使，而是自己……她将那个狭长沉重的、狂奔着的岩块冻了起来……打碎了……那些碎块在阳光的照耀下就像是星辰一样闪亮。\n又是一些念头涌出。\n星辰能为我引路，爸爸和妈妈告诉过我，它们能为荒野上的旅人指路……不……我们才是星辰……我要去告诉一些人，在比死亡更冷的北边，我们站稳了脚跟，他们会因此重燃希望……\n更多的血流淌，沁入冻土。\n但星辰在哪儿？我手中？\n我又在哪儿？\n我看不到它，明明眼前便是夜色，但为什么……没有一颗星辰肯为我闪烁？\n…………\n原来如此，因为旧的星辰已然熄灭，新的星辰还未诞生……\n她尽可能高地举起手……源石技艺造就的寒冰随之蔓延，从浸满鲜血的大地开始，寒冰攀上她的躯体，覆盖她的面庞，再然后，顺着她的手臂向天空，向某个安全的方向延展而去。\n高一些，再高一些吧……至少能为他人指明道路。这是最后一个念头，接着便只剩寒冰铸就的星辰无声屹立。\n…………\n她已无法知晓，数十个日夜后，会有后继者受到指引，再向南行，他们的脚步止于冻土边缘，但还有更多的人，唱着苦痛歌谣的人、横穿战场的人……\n小小的“星辰”在人们手中传递，在终点，帝江号以它点亮了北方的天空。","weaponId","weaponPotentialSkill","sk_wpn_sword_0014","weaponSkillList",[51,52,48],"wpn_attr_main_high","wpn_sp_attr_phy_spell_high","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":54},"backpackCanDiscard",false,"decoDesc","熔炉要塞铸造的武器之一。剑柄采用了拉丝设计，增加阻尼，握持感优良。剑身取自荒原上的稀有矿石。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",51,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_96":97},"list",[98,104,107,110,114,117,120,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,266,271,275,280,285,290,294,299,304,309,314,319,323,327,332,337,342,347,351,356,361,366,371,375,380,385,390,395,399,404,409,414,418,422,427,432,437,442,447,451,456,461,465,470,474,479,484,489,494,497,502,506],{"_99":90,"_100":101,"_102":86,"_103":54},"baseAtk","lvUpExp",10,"lvUpGold","weaponLv",{"_99":105,"_100":101,"_102":86,"_103":106},56,2,{"_99":108,"_100":101,"_102":86,"_103":109},61,3,{"_99":111,"_100":112,"_102":86,"_103":113},66,20,4,{"_99":115,"_100":116,"_102":86,"_103":91},71,40,{"_99":118,"_100":119,"_102":86,"_103":41},77,50,{"_99":121,"_100":122,"_102":86,"_103":123},82,80,7,{"_99":125,"_100":126,"_102":86,"_103":127},87,110,8,{"_99":129,"_100":130,"_102":86,"_103":131},92,150,9,{"_99":133,"_100":134,"_102":101,"_103":101},97,200,{"_99":136,"_100":137,"_102":101,"_103":138},102,270,11,{"_99":140,"_100":141,"_102":101,"_103":142},107,370,12,{"_99":144,"_100":145,"_