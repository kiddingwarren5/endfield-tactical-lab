[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_774":775},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0012","slug","mountain-bearer","name","负山","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Mountain Bearer","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0012.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","先祖居尚蜀，好游学，一日远游，遇骤雨，避之山壁下，拾枯草燃火自暖。方将小憩，忽见一玄衣人，其人状甚异，无目无口，臂接于山。先祖异之，问曰：“先生手生岩中，所为何故？”\n怪人答曰：“昔日我居百灶，一日梦黄衣小人立于掌心，问人之性命几重。答曰：‘人命重于山。’小人闻之欣然笑曰：‘吾乃掌中国之君也。’言毕遂去，自此不复见。我不忍覆其国，遂置手于地，百年不移。年久日深，掌上渐生大山，汝今所见者是也。”\n先祖未解，复问曰：“先生仁厚矜怜，何不怜己，断腕以求解脱，何如？”怪人曰：“我不知‘掌中一国’孰与‘臂前一掌’重，及至通悟，或可负山而行矣。”怪人复曰：“勿忧我，自可安眠。”先祖遂寝。及晓，不复见怪人。\n吾尝闻尚蜀之地有草名“枕黄”，微毒，焚之令人入幻，先祖或为之惑欤！","weaponId","weaponPotentialSkill","sk_wpn_lance_0012","weaponSkillList",[51,52,48],"wpn_attr_agi_high","wpn_sp_attr_phydam_high","weaponType",5,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":54,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","宏山选剑局研发的实验型长枪。枪杆部位在铸造时混入了极特殊的金合金，在保证强度的同时极大提高了韧性。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId