[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_782":783},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_pistol_0009","slug","clannibal","name","同类相食","type","weapon","version","1.6",{"_26":27,"_54":55,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":41},"breakthroughTemplateId","weapon_breakthrough_456star_D_2","engName","Clannibal","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_pistol_0009.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“因此我诅咒你们，你们的血液将在荒芜的大地之上流淌，汇聚成池，你们的族人，你们的所爱，将于血池中溺毙。”\n古旧笔记上写着这样的话，于是他想了想，拿出了自己的信纸，开始书写——\n“很少有人清楚裂地者为什么要追杀裂地者，毕竟他们曾是一个还算团结的整体，曾受同一个首领指挥……就算他们后续分裂了，也很难产生如此激烈的矛盾……这本笔记中记录的刻骨仇恨，以及作者抓捕到那些零散裂地者后，对他们施展出的残酷手段……似乎只有‘恐怖’两个字能形容。”\n他继续思考着，但似乎对结论很不满意，于是笔尖与纸张的摩擦声继续传出。\n“我试图在这些文字中寻找到一些‘共性’，比如裂地者们是否真的犯下过什么会让人觉得‘见之必杀’的罪孽，又或者他们是否有什么持续至今的邪恶计划……无论是出于工作还是爱好，探寻这些历史中的秘辛都让我足够畅快，但很可惜，这本笔记的作者只是一个质朴的恶棍，是因一次分赃不匀产生摩擦就绞死了‘同僚’全家的杀戮狂人。”\n他顿了顿笔，又以更大的力度，继续书写。\n“个人仇恨毫无意义，这些文字对我推进《维护塔卫二安全法案》的计划毫无帮助，只有从规则，从文明的认知，从一切黑色、白色和灰色上将裂地者彻底抹掉，人类才能足够安全。”\n似乎是纸上的文字正源源不断地为他提供力量，他的书写速度愈发快了起来。\n“任何文明都存在边缘处的腐烂，这些腐烂永远存在，无法根除，但我们至少要有切除它们的态度与行动。”\n他写下了最后一句话。\n“我以裂地者身份存活了三十年，你必须相信我。”","weaponId","weaponPotentialSkill","sk_wpn_pistol_0009","weaponSkillList",[51,52,48],"wpn_attr_main_high","wpn_sp_attr_magicdam_high","weaponType","itemTable",{"_56":57,"_58":59,"_60":61,"_62":63,"_64":16,"_15":16,"_65":66,"_67":66,"_68":69,"_19":20,"_70":71,"_72":63,"_73":74,"_75":76,"_77":63,"_78":79,"_81":82,"_40":41,"_83":57,"_84":85,"_86":87,"_88":89,"_21":90,"_91":57,"_92":93},"backpackCanDiscard",false,"decoDesc","雷神工业制造的特殊铳械，使用难度极高。因为是实验型武器，所以仅在市场上投放了少量样品。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxB