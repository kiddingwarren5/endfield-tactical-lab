[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_752":753},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0004","slug","wild-wanderer","name","迷失荒野","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_C_1","engName","Wild Wanderer","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0004.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","我在荒野中遇到了他们。\n起初，他们对我并不友善。一位师者检查了我的伤势，允许我在此逗留，直至能独自行动。其他人则拒绝与我进一步交流。或许，这是因为我身着环塔商会的制服。\n他们的生活方式……令我印象深刻。我认为这群人已形成了独特的传统，其核心是“节俭”，或更恰当地说，是“克制”。虽然他们的技术水平不算高超，但他们竭尽全力充分利用每一份材料。这赋予了他们的造物一种独特的“简洁之美”——一种由这颗星球的严酷荒野锤炼而成的美。\n我告诉他们我也是个工匠，因此得以参与他们的生产。近距离观察他们的工作后，我发现一个令人惊讶的事实：尽管他们的产品用料远少于我们，生产流程也相当简单，但武器性能损耗却不是很大。这一发现让我意识到，我们的设计还有极大的优化空间。\n我在他们中间生活了三年才离开。临别时，他们以师者的礼节对待我。然而，我深感自己从他们身上学到的，远比我教给他们的要多得多。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0004","weaponSkillList",[51,52,48],"wpn_attr_wisd_mid","wpn_sp_attr_electrondam_mid","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","雷神工业研发的一款施术单元，以简洁和轻量著称。其材料用量不足普通施术单元的一半。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",