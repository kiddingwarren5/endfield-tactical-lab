[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_735":736},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0001","slug","hypernova-auto","name","全自动骇新星","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_499":500,"_561":562},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_1","engName","Hypernova Auto","levelTemplateId","weapon_upgrade_curve_4star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0001.prefab","potentialUpItemList",[],"rarity",4,"talentTemplateId","wpn_potential_456star","weaponDesc","“塔罗斯会成为一座最最了不起的城市。”他的父母说。安德烈·斯洛塔利德，你要从学徒做起，先干体力活，然后去上学。长大以后要离开这个小小的定居点，去建设塔卫二的未来，和你的新家庭一起过上有意义的生活。\n“塔罗斯是塔卫二的主星。”他的书上写着。这是一颗气态巨行星，在星门打开的那几年里，赫赫有名的斐尔迪南·克鲁尼估算出了它的质量，还有它与塔卫二之间的距离。在塔卫二上，星荚似乎不曾存在，他们在这里找到了更多星星，比泰拉的天空中还要多得多。\n“星星在很近的地方，可惜门已经关上了。”他的导师说。如果源石应用专业的授课内容不能满足你，大可以去参加学院的占星家沙龙。除了算命，他们还探讨天文学，科学的天文学。不过，你对星星的兴趣看起来不仅仅在于观测和记录。安德烈，你想要造一颗星星，对吗？\n“星星在你无法触及的地方。”暴力的诸多代理人趾高气扬。“不对，星星就在我手里。”安德烈答道，“先生们，我将向你们介绍本人为终末地工业设计的第一款施术单元……的原型机。”停在他肩头上的施术单元跃上半空，光芒刺入对方的眼睛，如同在黑夜至深处绽裂的骇新星。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0001","weaponSkillList",[51,52,48],"wpn_attr_wisd_low","wpn_sp_attr_magicdam_low","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","终末地工业制造的干员进阶装备之一。武库沿用了安德烈的设计方案，可预存储术式，在紧急情况下快速传导法术。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true