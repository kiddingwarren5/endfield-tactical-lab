[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_803":804},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0018","slug","jade-vessel","name","玉中身","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_F_2","engName","Jade Vessel","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0018.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","武陵有一玉匠，巧夺天工，雕山水可听泉声激荡，刻花草可嗅清香扑鼻。然其恃才傲物，脾性古怪，好吹毛求疵，又有一怪癖——若是没能一气呵成雕出心满意足之作，无论多好的玉都弃如敝履。\n玉匠曾于深山溪涧之中摸得一块好料，碑般大小，借着光瞧，可见莹白通透，内里烟缕流转，聚散如有生机。\n玉匠大喜，将作坊门窗能锁尽锁，对外称闭门谢客，欲雕琢恢宏绝世之作，自此扬名立万。\n可刻刀提起来，悬在玉面之上，颤了又颤，始终狠不下心。落下么？怕毁了那天然走势。不落么？又不甘心。如此不食不寝往复七日，那块玉仍浑然如初，连一丝划痕也不见。而玉匠却憔悴落魄，几欲向天恳拜以求一解，这第一刀到底该如何而下。\n第八日黄昏，他终于支撑不住，伏案睡去。\n梦里，玉匠仍抱着那玉，却闻玉中一声呜咽，他好奇看去，见青白之下，一只墨色的长耳兽兜兜转转，似在寻一出口，却屡屡碰壁，磕得奄奄一息，只得可怜地趴伏在烟缕之中，无助地耷拉下耳朵。\n玉匠大惊，下意识攥起刻刀，要破壁救兽而出。谁料刀尖才刚碰触到壁身，霎时间，那好玉竟变得黯淡无光，成了随处可见的一块滩石。\n玉匠不可置信地揉揉眼睛，发现那只长耳兽竟出现在了自己身旁，摇摇晃晃蹭过来，拱了自己一身墨。再环视，周遭一片碧色，自己竟也进了玉中。\n这时，玉外头忽然凑近一张脸，眼窝深陷，眸子发亮，悬臂提着刻刀，岿然不动，似要瞪出一幅雕刻在玉面上的泼墨山水画——\n正是他自己的面容。\n玉匠猛然惊醒，冷汗涔涔。窗外羽兽啁啾，天色微亮，已是翌日清晨。他忽然眯起眼，连滚带爬赶忙瞧那块玉：第一刀已然刻出。再看自己手里，刻刀正攥得死紧。\n他怔怔坐了片刻，而后笑出声来。梦中他为救玉中小兽而提刀破壁，那玉便成了不值一提的石头，自己反倒被熬困于玉内。这些日子，自己又何尝不是被这块玉困在外头，被雕琢上乘好玉的负担和创造惊世之作的执念困在心里？\n玉匠当这梦是神仙给的启示，向天拜谢后，立刻抱着玉重返山间。溪涧潺潺如旧，风软日煦，他盘腿坐到地上，依着那梦中的一刀好一番大刀阔斧，偌大的玉便只雕琢出巴掌大小的一只长耳兽来。他将玉兽送回流水，余下的好料也还给山林，随即归去。\n此后，玉匠不图成名，也不求刻下传世之作，石头也雕，木头也刻，给迟暮的老者削结实顺手的竹杖，给年幼的孩子们捏花样繁多的玩具，也别有一番乐趣。\n而那只玉琢成的长耳兽在河中沉浮漂荡，似有生机，又忽地静滞，漾出一圈墨色，遁入画卷般的天瀑之中，消失不见，只在山谷里留了句回响：“好玉本该拿来雕有山野之趣的小东西，哪来那么多繁复心肠。”","weaponId","weaponPotentialSkill","sk_wpn_claym_0018","weaponSkillList",[51,52,48],"wpn_attr_wisd_high","wpn_sp_attr_crystdam_high","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","宏山选剑局特制的双手剑。选用特殊材质制成，形似炎国远古时期祭祀用玉器，剑身巨大而重量轻巧，能够展开凌厉的连续性攻势。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",81,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,111,115,118,121,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,267,272,276,281,286,291,296,301,306,311,316,321,325,329,334,339,344,349,353,358,363,368,373,377,382,387,392,397,401,406,411,416,420,424,429,434,439,444,448,453,458,463,467,471,475,480,485,490,493,498,502,507],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":108},56,2,{"_100":110,"_102":103,"_104":86,"_105":54},61,{"_100":112,"_102":113,"_104":86,"_105":114},66,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},71,40,{"_100":119,"_102":120,"_104":86,"_105":41},76,50,{"_100":90,"_102":122,"_104":86,"_105":123},80,7,{"_100":125,"_102":126,"_104":86,"_105":127},86,110,8,{"_100":129,"_102":130,"_104":86,"_105":131},91,150,9,{"_100":133,"_102":134,"_104":103,"_105":103},96,200,{"_100":136,"_102":137,"_104":103,"_105":138},101,270,11,{"_100":140,"_102":141,"_104":103,"_105":142},106,370,12,{"_100":144,"_102":145,"_104":113,"_105":146},111,480,13,{"_100":148,"_102":149,"_104":150,"_105":151},116,620,30,14,{"_100":153,"_102":154,"_1