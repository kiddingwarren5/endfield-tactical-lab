[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_759":760},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0020","slug","finchaser-30","name","逐鳞3.0","type","weapon","version","1.6",{"_26":27,"_55":56,"_93":94,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Finchaser 3.0","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0020.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","库尔，老大我最后还是逮到了这条海王鳞。\n你看看，它是否还像你记忆中的那样耀眼？\n那时我们的罗萨号还在，海上没有我们捕不到的鳞，直到那个暴雨夜。\n小贝塔在桅杆上第一眼就发现了它，和传说中的一模一样，通体金光的鳞竟然真的存在！\n当时我在想，只要干上这一票，塔卫二的捕鳞史都将留下我们的名字！我一点没听你林克斯大哥的劝，笔直把船开进了那片风暴之中……\n唉，实话跟你说吧，其实从那之后我就一直在后悔，我就是个不听劝的老混蛋。\n都是因为这条鳞，罗萨号毁了，小贝塔坐上了轮椅，林克斯也再没找过我。\n可是我不甘心，我史宾赛自诩捕鳞第一人，不能让海王鳞落入他人之手，更不能被当成茶余饭后的笑料。\n我一闭上眼就是它身上的金光，我每天都和自己说，只要我要逮到它，便能拿回失去的一切。\n只有你相信我……你怎么这么蠢，还相信我这个老混蛋？还去向环塔商会贷款给我买新的船？你就应该像其他人那样一走了之！\n不然你也不会搭上你那两年的大好青春，陪我追逐这虚无缥缈的金光，还在我们第二次差点追到它的那个暴雨夜，把你的命也搭上了……\n那之后的事，你肯定不知道了吧？讽刺的是，最该死的我却活了下来……从此我再也没出过海。\n直到上周，雷声将我从梦中惊醒。那熟悉的金光竟然在门缝外摇曳，我推开门一看，海王鳞它竟然在我家的鱼缸里！可它怎么能是海王鳞！它只是你嫂子随手在某个鳞店买的最普通的热带彩鳞而已！\n我拜托从前工团的朋友给它做了个检测，原来它真的就是条普通的热带彩鳞，传说中的金光只不过是它身上一部分变异的脂肪……在雷光下产生了金色的折射……\n所以说，库尔，老大我最后还是逮到了这条鳞。\n只不过，原来它是饵，我才是鳞。\n一条在虚无之海以执念为饵的鳞。","weaponId","weaponPotentialSkill","sk_wpn_sword_0020","weaponSkillList",[51,52,48],"wpn_attr_str_mid","wpn_sp_attr_crystdam_mid","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":54},"backpackCanDiscard",false,"decoDesc","北进重工支援所“户外探索”系列的旗舰产品。因其亲近自然的设计理念和便携的功能性，受到许多探险家与捕鳞爱好者的强烈推荐。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",25,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_95":96},"list",[97,104,107,110,114,117,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,183,188,193,198,202,207,212,217,222,226,231,236,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_98":99,"_100":101,"_102":86,"_103":54},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_98":105,"_100":101,"_102":86,"_103":106},46,2,{"_98":108,"_100":101,"_102":86,"_103":109},50,3,{"_98":111,"_100":112,"_102":86,"_103":113},54,20,4,{"_98":115,"_100":116,"_102":86,"_103":41},58,40,{"_98":118,"_100":108,"_102":86,"_103":119},62,6,{"_98":121,"_100":122,"_102":86,"_103":123},66,80,7,{"_98":125,"_100":126,"_102":86,"_103":127},71,110,8,{"_98":129,"_100":130,"_102":86,"_103":131},75,150,9,{"_98":133,"_100":134,"_102":101,"_103":101},79,200,{"_98":136,"_100":137,"_102":101,"_103":138},83,270,11,{"_98":140,"_100":141,"_102":101,"_103":142},87,370,12,{"_98":144,"_100":145,"_102":112,"_103":146},91,480,13,{"_98":148,"_100":149,"_102":150,"_103":151},95,620,30,14,{"_98":153,"_100":154,"_102":108,"_103":155},100,780,15,{"_98":157,"_100":158,"_102":159,"_103":160},104,990,70,16,{"_98":162,"_100":163,"_102":153,"_103":164},108,1250,17,{"_98":166,"_100":167,"_102":168,"_103":169},112,1550,140,18,{"_98":171,"_100":172,"_102":134,"_103":173},116,1900,19,{"_98":175,"_100":176,"_102":177,"_103":112},120,2360,240,{"_98":179,"_100":180,"