[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_791":792},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0011","slug","delivery-guaranteed","name","使命必达","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_C_2","engName","Delivery Guaranteed","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0011.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","前天，我外出拾荒的时候，遇到了一位奇怪的佩洛大姐姐。\n她看上去也不像是之前关照过我们的众生长地人。她穿着奇怪的装束，还扶着一块报废的铁疙瘩，她管它叫“摩托”，说是被天使弄坏的。\n她问我能不能把我的驮兽借给她。\n我不想借给她。\n我问她是谁，她说她是一个“信使”。\n信使？从来没听过的名字。\n她向我解释，在很久很久以前，当星门依旧伫立的时候，信使会带着塔卫二的东西穿过星门到泰拉去，然后再带着泰拉的东西回到塔卫二，交换着双方的思念和寄托。\n可是爸爸说，星门早就坏了呀，早就没有泰拉了？\n她回答道，赶走天使后，人们又陷入了战争与猜疑，都封闭了自己，就像我脚边的小沙地兽把自己埋在窝里不出来一样。\n战争？\n人与天使的战争，以及人与人的战争。她告诉我，我和爸爸的聚落或许就是为了躲避战争而定居荒野。\n我并不想把驮兽借给她。\n她直视着我的眼睛，认真地说，她向我借驮兽是为了去告诉大家，战争已经结束了。\n虽然失去了与泰拉的连接，但信使想让塔卫二的大家重新团结在一起，重新信任彼此。\n她是战争结束后的第一位信使，她要替一个叫“终末地”的人寄出第一封信——一封代表和平的信。\n但我还是不想把驮兽借给她。\n她温柔地笑了笑，将漂浮在身上的铁球摘下来，说这是她身上除了那封信之外最值钱的东西，可以先放在我这里抵押，直到她把驮兽还给我。\n嗯，一般能漂浮的东西都挺值钱的。\n我答应了，把驮兽借给了她，告诉了她我的名字，并给她指了指聚落的方向。\n…………\n今早起床的时候，有人告诉我，聚落外面拴着我的驮兽，上面有一封信与一件包裹，信上有我的名字。\n果然是那个信使姐姐。\n她在信里说，抵押在我这儿的东西就不用还她了，算是一份谢礼，感谢我的驮兽让她和信离目的地更近了一步。\n信使的时代重新来临了！她的语气似乎很高兴。\n包裹里面是一个“通信装置”，附上了一段说明，现在我们都可以用这个“通信装置”呼叫附近的信使们了。\n可是我该写信给谁？又该寄去哪儿呢？我从来就没离开过聚落。\n那我就先写给那个信使姐姐吧。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0011","weaponSkillList",[51,52,48],"wpn_attr_will_high","wpn_sp_attr_usgs_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","雷神工业的经典尖端产品，其原型从第一次天使战争时便投入使用。该产品不断迭代至今，强大的火力意味着安全与保障。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",41,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,281,286,291,296,301,306,311,316,321,325,329,334,339,344,349,353,358,363,368,373,377,382,387,392,397,401,406,411,416,420,424,429,434,439,444,448,453,458,463,467,471,475,480,485,490,493,498,502,507],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":54},56,{"_100":109,"_102":103,"_104":86,"_105":110},61,3,{"_100":112,"_102":113,"_104":86,"_105":114},66,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},71,40,{"_100":119,"_102":120,"_104":86,"_105":41},76,50,{"_100":122,"_102":123,"_104":86,"_105":124},81,80,7,{"_100":126,"_102":127,"_104":86,"_105":128},86,110,8,{"_100":130,"_102":131,"_104":86,"_105":132},91,150,9,{"_100":134,"_102":135,"_104":103,"_105":103},96,200,{"_100":137,"_102":138,"_104":103,"_105":139},101,270,11,{"_100":141,"_102":142,"_104":103,"_105":143},106,370,12,{"_100":145,"_102":146,"_104":113,"_105":147},111,480,13,{"_100":149,"_102":150,"_104":151,"_105":152},116,620,30,14,{"_100":154,"_102":155,"_104":120,"_105":156},121,780,15,{"_100":158,"_102":159,"_104":160,"_105":161},126,990,70,16,{"_100":163,"_102":164,"_104":165,"_105":166},131,1250,100,17,{"_100":168,"_102":169