[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_789":790},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0016","slug","golden-age","name","黄金时代","type","weapon","version","1.6",{"_26":27,"_56":57,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_D_2","engName","Golden Age","levelTemplateId","weapon_upgrade_curve_6star_0.98","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0016.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“老家伙，岁月真是不饶人啊，你的枪法……居然变得这么沉重了。”\n库兰塔将长枪插进了充满裂痕的屋顶，脱下早已不堪重负的护甲。\n“我只比你年长几岁，你又能年轻到哪儿去？难道你还是那爱听英雄故事的小孩？”\n“跟我回去，别再做傻事。‘军阀’雅各布已死，他那所谓‘更加伟大的城市’的理想，不值得你把自己的命留在这儿。”\n\n“……我原本以为你能理解我。”望向越过第三十九具裂地者尸体的黎博利，库兰塔抽出了别在腰间的短剑——几十年的岁月，精致的剑鞘早已锈蚀，但短剑依旧反射着寒光，“我只相信一个理想——老师把短剑交到我们手中时讲过的，回到泰拉、回到那个黄金时代的理想。但现在，他的墓碑都被锚点给砸碎了，我们甚至连回到塔卫二的北方都做不到……感到失望的可不只有雅各布。你来告诉我，‘偶尔’的物资匮乏、遍地的侵蚀、天使的袭击，还有那座文明环带许诺已久的理想城，这些又算什么？”\n\n黎博利无奈地叹了口气，停在了距离库兰塔十步的地方。靴子踩在了风吹来的沙尘上，咯吱作响。\n“你真是挑了个好地方，这屋顶的风，怕是能让羽兽不用扇动翅膀就可以飞起来。”\n“是啊，好大的风……可惜快停了。”库兰塔举起手中的短剑，“我们打赢了天使战争。但那之后呢？我们都老了，再等下去，我肯定等不到老师的理想实现的那天。我得自谋出路。”\n“但这不是你跟着雅各布，把老师的那杆长枪指向比你更绝望的人的借口。”\n“弱肉强食，总得有人这么做。”库兰塔站直了身子，略显生疏地挥了挥手中的短剑，“为了老师的理想，这就是我选择的路……你阻止不了我。”\n“以前的你，明明是个为了救援被天使袭击的聚落，和大伙儿连夜奔袭十几里的英雄。”黎博利摸向腰间，那是一柄与库兰塔手中相同的短剑。\n他仍记得老师将短剑交给他们的那天；记得那个接过短剑时眼睛发亮，说想要老师那杆枪的义兄；记得义兄说“我要成为大英雄”时，自己忍不住哈哈大笑。为什么要笑？不记得了。\n\n“英雄？我算是个什么英雄。”库兰塔说罢，便将手中的短剑举至胸前，“你说的英雄，要么只活在你的脑子里，要么就已经死在了那天晚上。”\n“你的所作所为亵渎了老师的长枪。”黎博利扔下打完蚀刻弹药的手铳，抽出短剑，直冲库兰塔而去，“把它还来。”\n“那就要看……你的本事了！”","weaponId","weaponPotentialSkill","sk_wpn_lance_0016","weaponSkillList",[52,53,49],"wpn_attr_will_high","wpn_sp_attr_heal_high","weaponType",5,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":55,"_92":59,"_93":94},"backpackCanDiscard",false,"decoDesc","梅什科工业的高端线产品之一。枪尖由特殊金合金制成，坚固且锋利，造型典雅，造价高昂，常被用于需要彰显使用者地位的场合。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",76,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,112,116,119,122,126,130,134,137,141,145,149,154,158,163,168,173,177,181,186,191,196,201,206,211,216,221,226,230,235,240,245,250,255,260,264,269,274,277,282,287,292,297,302,306,311,316,320,324,329,334,339,343,348,353,358,363,367,372,377,382,387,391,396,401,406,411,415,419,424,429,434,438,443,447,452,456,461,465,470,475,479,484,489,494,499,503,507],{"_100":101,"_102":103,"_104":87,"_105":94},"baseAtk",49,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":87,"_105":108},54,2,{"_100":110,"_102":103,"_104":87,"_105":111},59,3,{"_100":113,"_102":114,"_104":87,"_105":115},64,20,4,{"_100":117,"_102":118,"_104":87,"_105":55},69,40,{"_100":120,"_102":121,"_104":87,"_105":42},74,50,{"_100":123,"_102":124,"_104":87,"_105":125},78,80,7,{"_100":127,"_102":128,"_104":87,"_105":129},83,110,8,{"_100":131,"_102":132,"_104":87,"_105":133},88,150,9,{"_100":135,"_102":136,"_104":103,"_105":103},93,200,{"_100":138,"_102":139,"_104":103,"_105":140},98,270,11,{"_100":142,"_102":143,"_104":103,"_105":144},103,370,12,{"_100":146,"_102":147,"_104":114,"_105":148},108,480,13,{"_100":150,"_102":151,"_104":152,"_105":153},113,620,30,14,{"_100":155,"_102":156,"_104":121,"_105":157},118,780,15,{"_100":159,"_102":160,"_104":161,"_105":162},123,990,70,16,{"_10