[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_789":790},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0019","slug","long-heritage","name","悠久传承","type","weapon","version","1.6",{"_26":27,"_56":57,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_F_3","engName","Long Heritage","levelTemplateId","weapon_upgrade_curve_6star_0.98","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0019.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“尊敬的汉森·罗伯特先生，我们不得不遗憾地通知您，关于您撰写的第四版《曼迪兄弟公司创业历程编年史》，我方相关部门人员在经过详尽评估后，认为其存在‘过于晦涩’‘重点模糊’‘看不到与雷神工业的关联性’等问题。\n“因此判定为‘不予采用’，请重新撰写并在三个工作日内提交。同时这里再次提醒您，您与我们曼迪兄弟公司签订的合同里已经写明，最终截稿日为下周三，届时如有逾期，您将需要交付违约金，还请务必注意。\n“期待您下次提交的稿件，再会。”\n电话自动挂断后，汉森从没像此刻这样后悔接下一个如此吃力不讨好的业务——帮一家寂寂无名的载具公司撰写一段完整的发家历史。\n老实说，在第一次听到曼迪兄弟的老板说出要求时，他作为一位前历史学助教兼史学论文代笔，一度以为这是件轻松到仿佛在菈梵朵玛度假一般的活。毕竟对方只提了两个要求：第一，要与大名鼎鼎的雷神工业搭上关系——因为他父亲是雷神工业的忠实拥趸，遗愿之一就是有一天自家企业能和雷神工业出现在报纸的同个版面，而他们公司最近刚好在《艾什柏环岛日报》的头版上买了一个角落，打算把企业发家史放进去，让父亲心愿得偿；第二，要尽可能地令人信服——下个月他们打算参与一个大型竞标会，其中最有威胁的竞争者竟然自称是梅什科工业的子公司，对此，曼迪兄弟的老板认为他们有必要拿出一段更加传奇的创业经历，才能在气势上震慑住对方。\n虽然汉森压根不觉得编造一段企业的传奇发家历史就能吓到谁或是让哪家公司竞标成功，但谁叫曼迪兄弟光是给的定金就约等于他十个月的饭钱呢。塔罗斯在上，他现在只是个穷困潦倒、需要为自己的温饱负责的普通黎博利，什么学术道德，什么历史客观性……还是先放在一边好了。\n是的，事情到这一步的时候，一切都很顺利——\n他想要的曼迪兄弟过往资料有了，他要求的包吃包住有了，接下来只要他再一口气把这段历史编完就万事大吉了。\n万万没想到的是，这却是噩梦的开始——他以为自己连资料里写的所有具体日期都忽略不计这点已经够不严谨了，却依然被质疑为什么要写那么多无意义的年份；他以为只要写出曼迪兄弟疑似继承了雷神工业某种工程技术的意思就好，结果却被说“看着就像编的”“比新蓝卡坞的广告还莫名其妙”。\n真的，他想他已经受够了这些对历史编写方式毫无概念、对他的工作成果全无尊重的外行人了，但考虑到十天后他还有一份房租要交，在经历了一分钟的心理斗争后，汉森再次坐回书桌前，开始了第五版《曼迪兄弟公司创业历程编年史》的撰写……\n这一次，他放弃了所有的坚持，几乎破罐破摔地编造了一个“曾经有一位雷神工业的顶级设计师，不愿让技术只服务于军工企业，于是来到了艾什柏环岛，为工人们画下了一辆重装大巴车的图纸——这正是曼迪兄弟公司的起点”的唬人小故事。里面没有引用任何关于雷神工业的历史典故，不涉及曼迪兄弟真正的发家过程，唯一有关联的只是一张曼迪兄弟提供的资料里保存完好的早期图纸，署名来自一个叫“约翰·维里蒂”的年轻临时工。\n就这样，汉森飞快交了稿，然后便闷头大睡到了三天后。\n结果他等来的不是违约金的通知，而是一条尾款已支付的短讯，与一通陌生的电话——\n“请问是汉森·罗伯特先生吗？我是雷神工业的公关顾问埃文斯。”\n“你、你好……先说清楚啊，那稿子是曼迪兄弟公司找我写的，如果你们有什么问题，还是找他们……”\n“请别误会，我并非来向您追究什么……只是想问一件事——您是如何发现约翰·维里蒂和我们雷神工业存在关联的？”\n“……啊？什么关联……？”\n“您不必如此谦逊。雷神工业并没有任何一位在职或曾任职的设计师叫这个名字，但关于这个名字的主人……这个化名的背后有一个您或许听说过的真名：肖恩·布洛赫——\n“也就是我们雷神工业曾经的执行主管兼首席设计总监。\n“他年轻时曾在艾什柏环岛……旅居。但这段经历极其隐秘，连企业内部也缺乏相关的记录……所以，也许您现在可以和我说说，您到底是如何察觉到‘约翰·维里蒂’的真实身份的？”","weaponId","weaponPotentialSkill","sk_wpn_claym_0019","weaponSkillList",[52,53,49],"wpn_attr_wisd_high","wpn_sp_attr_crystdam_high","weaponType",3,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":95},"backpackCanDiscard",false,"decoDesc","雷神工业的客制化优秀案例之一，包含了设计师对新型合金的应用思路，以繁复的对称结构完成了客户指定的个性需求。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",82,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_98":99},"list",[100,107,110,112,116,119,122,126,130,134,137,141,145,149,154,158,163,168,173,177,181,186,191,196,201,206,211,216,221,226,230,235,240,245,250,255,260,264,269,274,277,282,287,292,297,302,306,311,316,320,324,329,334,339,343,348,353,358,363,367,372,377,382,387,391,396,401,406,411,415,419,424,429,434,438,443,448,453,457,462,466,471,475,479,484,489,494,499,503,507],{"_101":102,"_103":104,"_105":87,"_106":95},"baseAtk",49,"lvUpExp",10,"lvUpGold","weaponLv",{"_101":108,"_103":104,"_105":87,"_106":109},54,2,{"_101":111,"_103":104,"_105":87,"_106":55},59,{"_101":113,"_103":114,"_105":87,"