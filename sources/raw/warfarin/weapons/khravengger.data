[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_782":783},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0013","slug","khravengger","name","赫拉芬格","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_2","engName","Khravengger","levelTemplateId","weapon_upgrade_curve_6star_1.02","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0013.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","食腐者瘫坐在地上，面前摆着他的巨剑。\n他已经在荒野上流浪了数日。回想起不久前倒在自己剑下的亡魂，那双绝望的眼睛，紧紧盯着他的双角。像这样充满恨意的眼睛他早就习以为常。不过是对他这位剥夺自己生命之人的憎恨罢了，只需要将他们吞食便能缓解他的苦痛。\n他的双腿肿胀，灼热得像是要融化。不知不觉，他早就在饥饿与持续溃烂带来的痛苦中蜷曲了脊背。从父辈手中接过这柄寒霜时，他曾发誓要将它当作自己的第二条生命。但现在，他只想找个还有人迹的地方，用这位老友换一些净水和干粮。\n但眼前荒废的聚落显然没有那种东西。食腐者起身正欲离去，身后传来了粗鲁的嘲弄。\n\n“喂，魔族佬，这剑卖么？”\n“……你们是佣兵，还是强盗？”\n“哼，有什么关系？要是你身手不错，我们可以连你也买下来。”\n\n疲惫的食腐者没有拒绝，他稍稍握紧了双拳，估摸着自己的臂膀还剩多少力气：“怎样才算不错？”\n“看见那个大石头没有？劈开！”\n“看着。”\n这块大石头似乎在这个聚落里有些年头，上面还刻着小孩子的画作，以及一些已经看不大清的字样。食腐者大概比划了下，似乎要两个他张开手臂才能抱住这块石头。\n食腐者站直身子，用尽力气将手中的剑高高举起。然而等到尘雾散去，他这才发现，在那块石头底下，居然有个洞穴。\n洞里闪着不安的眼睛，比他更虚弱，比他更绝望。背后的人们放声大笑，围了上来。\n“身手挺好。跟我们走吧，你觉得自己值多少，说个数。”\n“我是佣兵，不是屠夫。”\n\n短暂的安静过后，依旧粗鲁的嘲弄从面前传了过来。\n“不是屠夫？哈，不是屠夫！魔族佬，你们现在是发达了，但做的不还是刀口舔血的生意？少给我装什么好人！”\n他们是对的。佣兵不是个清白的行当，已经夺走过生命，就不会有借口。\n但是，洞穴里望向他的眼睛，望向他头上双角的目光，平静得让他难过。\n十几年前，穿过星门的时候，他本以为可以不再看到这样的眼神。\n“这剑不卖。”\n食腐者深吸一口气，再一次举起巨剑。\n“萨卡兹，也不卖。”\n\n…………\n\n疲惫与饥饿的身躯将食腐者缓缓拖向远方。\n现在的塔卫二，还没到他能卖掉武器的时候。","weaponId","weaponPotentialSkill","sk_wpn_claym_0013","weaponSkillList",[51,52,48],"wpn_attr_str_high","wpn_sp_attr_atk_high","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","巫术时刻推出的古怪武器之一。刀身由寻常的冰块打造，但表面附着的奇特源石技艺让其变得坚不可摧。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",45,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,267,272,276,281,286,291,295,299,304,309,314,319,323,327,332,337,342,347,351,356,361,366,371,375,380,385,390,395,399,404,409,414,418,422,427,432,437,442,447,451,456,461,465,470,474,479,484,489,494,497,502,506],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":108},56,2,{"_100":110,"_102":103,"_104":86,"_105":54},61,{"_100":112,"_102":113,"_104":86,"_105":114},66,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},71,40,{"_100":119,"_102":120,"_104":86,"_105":41},77,50,{"_100":122,"_102":123,"_104":86,"_105":124},82,80,7,{"_100":126,"_102":127,"_104":86,"_105":128},87,110,8,{"_100":130,"_102":131,"_104":86,"_105":132},92,150,9,{"_100":134,"_102":135,"_104":103,"_105":103},97,200,{"_100":137,"_102":138,"_104":103,"_105":139},102,270,11,{"_100":141,"_102":142,"_104":103,"_105":143},107,370,12,{"_100":145,"_102":146,"_104":113,"_105":147},112,480,13,{"_100":149,"_102":150,"_104":151,"_105":152},117,620,30,14,{"_100":154,"_102":155,"_104":120,"_105":156},122,780,15,{"_100":158,"_102":159,"_104":160,"_105":161},128,990,70,16,{"_100":163,"_102":164,"_104":165,"_105":166},133,1250,100,17,{"_100":168,"_102":169,