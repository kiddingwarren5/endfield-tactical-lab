[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_750":751},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0012","slug","finishing-call","name","终点之声","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_D_1","engName","Finishing Call","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0012.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","“黑骑士朴实刚健，技艺精湛。她不借助任何源石技艺便能力压群雄，看似以力破巧，实际上招招看准要害。每逢兵刃交击，黑骑士都屡占上风，说明她对支点与平衡的掌握远超对手。据传这柄大剑并非黑骑士真正擅长使用的武器，且曾有人目击她在谢拉格使用双锏血战千余士兵，足以证明我的猜想。\n“血骑士力量更甚，战法也大有文章可作。相比黑骑士总是一点突破，此人实际更加擅长利用源石技艺制造压制局面，逼迫对方在自己期望的时机展开决战。一人成军，处处造势。\n“耀骑士的战斗记录……多说无益，不是重点。她的高强技艺毋庸置疑，但大家心里都清楚，令她如此成功的根本原因并不是战斗本身。就算更换武器，改变战法，甚至换一个人，只要带着那样的理念在那个时刻挺身而出，切实行动，都能成为耀骑士——当然，这本身就已经无从学起了。”\n…………\n“这个骑士……应该是骑士吧。这份录像是什么时候，从哪里得来的？不……我不确定……但我对此人毫无印象。画面断断续续，敌人也乱七八糟，但他确实很强，不知为何，我总觉得他真正的战场应该在……大海？你看他的身后……但他的身姿让我心潮澎湃，比起技艺，那股力量，那股愤怒，那简直是海浪组成的一首歌。对，歌声，我之前都在想什么？真相，联系……太亮了，好渴，渴，我要——”\n\n“没了？”\n“到这儿就断了，字都没写完。先生写到这儿，突然就不省人事了。”\n“你说，先生都这样了，这份草稿真的没问题吗？”\n“别想太多，任务就是任务。把先生的手放回去，我们走。”","weaponId","weaponPotentialSkill","sk_wpn_claym_0012","weaponSkillList",[51,52,48],"wpn_attr_str_mid","wpn_sp_attr_hp_mid","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","梅什科工业小规模生产的特别产品。本品是梅什科工业与骑士竞技专家克伦威尔合作系列的最后一款设计。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackSt