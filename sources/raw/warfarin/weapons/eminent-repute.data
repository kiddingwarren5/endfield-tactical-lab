[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_777":778},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0013","slug","eminent-repute","name","显赫声名","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_C_2","engName","Eminent Repute","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0013.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“所以，我那个小学徒，是你杀的对吗，为什么？”\n“噢……噢噢……您的小学徒，唉，其实都是误会，主要……主要是，他来我们的黑拳擂台，连胜十场，那就是想踩着我们办的比赛出名嘛，我们毕竟也是要赚金票的，所以呢，就派了几个人……当然不是我派的……就派了几个人劝了劝他，结果，唉，谁也没想到会出事……”\n“不对。”\n“请……请您指正？”\n“你不是没想到会出事，你没想到的是我会杀到你们面前……另外也不用装成这种谨小慎微的样子，看着让人恶心。”\n“老先生，您这样可就稍显无趣了。”\n“无趣？不如我给你讲讲艾什柏环岛的历史吧。”\n“洗耳恭听。”\n“最开始，没人能想象到艾什柏环岛能变成今天这样子，一群道路工人把这里当成宿舍用，后来开长途汽车的司机们也会把家属安排到这里住。道路，加上货运，这里自然就变成了交通枢纽，形形色色的人多了起来，地下黑拳赛事，各式各样的比赛，都是在那时候兴起的。在这里，你能买到各种各样的武器、装备，甚至奢侈品也能找到不少款式，最繁华的时候，武力、欲望、金钱……这座沥青环岛应有尽有，当然，也有底线。\n“我那时是道路工人之一，看着这样一个小聚落一点点壮大，甚至一度到了自由市的规模，开心极了，我只觉得艾什柏环岛比那个建不成的塔罗斯城不知道好了多少倍，有时我甚至会思考，像我这种在意所谓‘集体荣誉’的人，是不是申请调到联盟工团更合适一点，你能理解吗？”\n“我很理解。”\n“不，年轻人，看看你自己，你不是一个能理解荣誉的人，你能理解的只有体面，但这不怪你，现在这里有不少人和你一模一样……半脸人、托马西诺先生……当我们不再修路，这里也不再是交通建设枢纽后，很多人离开了，但接着又来了很多人，个个都和你一样，肆无忌惮，破坏底线，把好好一个艾什柏环岛变得乌烟瘴气……”\n“这确实让我感到好奇，老先生，当我决定带着兄弟们到艾什柏环岛发展，谋一个出路后，我对这里进行了详细的调查。无论是从梅什科工业手中获得合规的营业资格，还是提前跟各个帮派打好招呼，夹缝里求生存，各个步骤我自认为做得都很完美。我确确实实，想要洗白自己，也确确实实，是在按规矩办事……可为什么在您口中，我才像是那个坏了规矩的人，而不是您那个愣头青小学徒？”\n“规矩是什么？规矩只有一条，那就是将他人视为人类，将自己也视为人类……只这一点，你们无论如何也做不到。”\n“这倒是第一次听说，是您编的规矩吗？”\n“是我一直以来呕心沥血维护的规矩。”\n“原来如此，原来如此，我懂了，您是那种‘蒙面英雄’吧……哈哈，我还以为只在故事书里才有……不瞒您说，我小时候很想成为您这样的人。我甚至会想，如果我早一百多年出生，是不是能成为终结第一次天使战争的英雄之一？但老人家呀老人家，这不现实了。如今已不是英雄的时代，想要获得显赫声名，要靠别的办法。”\n“呵，我这种只在忍无可忍时才动武的老东西，你这种为达目的不择手段的渣滓，也配成为英雄？”\n“明白，明白，老先生，就让咱们用刀剑说话吧。”","weaponId","weaponPotentialSkill","sk_wpn_sword_0013","weaponSkillList",[51,52,48],"wpn_attr_main_high","wpn_sp_attr_phydam_high","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":54},"backpackCanDiscard",false,"decoDesc","梅什科工业推出的高品质佩剑，深受环塔商会上流人士的青睐。精细雕琢的外表下，性能同样值得信赖。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",53,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,120,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,267,272,276,281,286,291,296,301,306,311,316,321,325,330,335,339,343,348,353,358,363,367,372,377,382,387,391,396,401,406,411,415,419,424,429,434,438,443,448,453,458,462,466,471,476,481,484,489,494,499,503,507],{"_99":100,"_101":102,"_103":86,"_104":54},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},54,2,{"_99":109,"_101":102,"_103":86,"_104":110},59,3,{"_99":112,"_101":113,"_103":86,"_104":114},64,20,4,{"_99":116,"_101":117,"_103":86,"_104":91},69,40,{"_99":119,"_101":100,"_103":86,"_104":41},74,{"_99":121,"_101":122,"_103":86,"_104":123},79,80,7,{"_99":125,"_101":126,"_103":86,"_104":127},84,110,8,{"_99":129,"_101":130,"_103":86,"_104":131},89,150,9,{"_99":133,"_101":134,"_103":102,"_104":102},94,200,{"_99":136,"_101":137,"_103":102,"_104":138},99,270,11,{"_99":140,"_101":141,"_103":102,