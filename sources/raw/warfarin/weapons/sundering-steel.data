[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_779":780},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0005","slug","sundering-steel","name","钢铁余音","type","weapon","version","1.6",{"_26":27,"_55":56,"_93":94,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_2","engName","Sundering Steel","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0005.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","我知道你是谁，从哪里来。\n你曾经是他们的一员，对吗？你的眼睛里有熔炉的火，你曾经日夜守候在旁。\n你逃回了南方，不想再面对那些天使强加给你的梦魇。但你也不想变成一个名副其实的逃兵，因此，你隐姓埋名，加入终末地，成为了我们的武库工程师。在这里，你找到了平凡生活的价值。你帮助其他人从他们自己的战斗中活了下来，他们感谢你，赞美你为他们设计的武器，趁手、轻快，设计者将自己多年的实战经验融入其中。你看见了终末地的新技术，也许你还想过，如果那个时候有这些技术，很多事情都会有转机。\n不用说，那个孩子很喜欢你。你是一位脾气古怪的长辈，但你会讲故事，很多她父母不曾讲过的故事。那些故事里有勇士，有他们奋不顾身的战斗，生活，还有不为人知的牺牲。你还悄悄从她那里学了两手，对吗？这种一体化设计……在你过去工作的地方可不多见。\n所以，当那孩子请求你教她如何用剑的时候，你犹豫了。你先是想起了自己意气风发的岁月，也许剑术能帮助那孩子保护好自己。然后，你转念一想，她哪里需要什么剑术，整个终末地的武库都在她的身后，还有爱她的父母。你认为，她不需要一个逃兵，一个失败屠夫的指导。一条荒废已久的老路再不需要另一位过路客。\n接下来，你申请了部门转调，远离武库，试图强迫自己重新回到前线——至少是终末地工业的前线。\n别这么看着我，我不是笞心魔，也没有拿机器读你的心。\n但我确实有话要捎带给你：无论你做何选择，佩丽卡监督都不会反对你的决定。但是，请别让那孩子难过，好吗？","weaponId","weaponPotentialSkill","sk_wpn_sword_0005","weaponSkillList",[51,52,48],"wpn_attr_agi_mid","wpn_sp_attr_phydam_mid","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":54},"backpackCanDiscard",false,"decoDesc","终末地工业制造的干员高级装备之一。握柄与护手采用一体化设计，应力充能机构储存动能，提高武器的杀伤力。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBa