[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_786":787},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0020","slug","sufferings-end","name","苦难的尽头","type","weapon","version","1.6",{"_26":27,"_56":57,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Suffering's End","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0020.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“苦难终有尽头，萨卡兹将……得到和平……”\n年迈的萨卡兹一边回味着这句话，一边擦拭着手中的施术单元。在他的周围，络绎不绝、携家带口的游客，用源石技艺释放绚丽火花的巫妖，在石翼魔战士身上爬上爬下的孩童。不同种族的人们欢呼着，亦如塞什卡升空、战争结束后的每一个开放日。\n“这就是‘苦难的尽头’吗。”\n年迈的萨卡兹只是简单收拾了行李，他早就攒够了足够在环带诸城间穿梭的金票，早就打算离开塞什卡，开始他计划许久的环带旅行。\n\n旅行本来进行得十分顺利，直到那一天：他正躺在巨石上仰望星空，旁边煮着咖啡的源石壶“啪”的一声关了机。一开始，他还只是感到疑惑，随后，一阵爆炸声传来，他听见了呼喊和尖叫。\n他警惕地望向蔓延的雾火，看见一家三口正在荒野上徒步奔逃，模糊的人影挥舞着武器追赶在后——三十人左右，是裂地者。目睹了这一切后，年迈的萨卡兹……什么也没做，他又躺了回去。\n\n他实在是太老了，又太过普通。没有石翼魔那要塞般坚固的身躯，也没有巫妖神秘且致命的法术，更没有食腐者那恐怖的怪力。他只是一个在天使战争、耻辱战争，还有之后剿灭军阀雅各布的战争中幸存下来的混血萨卡兹，有的只有保下自己性命的技巧。\n但没过多久，大概十秒钟后，萨卡兹拿出了施术单元，就从巨石顶端跳了下来。他突然想起了那位疯疯癫癫的议长，她咬文嚼字的许诺一听就不是自己写的，但有件事从来都没有发生改变：要让苦难到达尽头，总有人得先做点什么。\n他轻轻擦拭着那枚施术单元，外壳上映出了一个比过去衰老太多太多的萨卡兹。\n\n抱着孩子的父亲中了一箭，很快便跌倒在地，母亲连忙扔掉手中的通信终端，试图拉起倒地的丈夫。也是这时，裂地者出现在了他们身旁，黑夜下的荒野瞬间恢复了安静。\n裂地者们大声哄笑着围上来，无情地举起武器。父母张开手臂，将孩童笼罩在他们的怀抱之中，而经由长刀与弩箭反射的火光，此刻正映照在孩童滴落的泪水上。\n突然，一个头顶双角的影子出现在了裂地者的身后，没有声响，也没有任何预兆。比夜更深的黑色蔓延，裂地者接二连三地被卷入其中，发出临终的哀嚎。恐惧弥漫在剩下的人之间，他们想要找出袭击究竟来自何处，最终却只能听见夜风带来一句苍老的萨卡兹语——\n“我的苦难已经到了尽头，但你们的那份……才刚要开始。”","weaponId","weaponPotentialSkill","sk_wpn_funnel_0020","weaponSkillList",[52,53,49],"wpn_attr_agi_high","wpn_sp_attr_naturaldam_high","weaponType",2,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":95},"backpackCanDiscard",false,"decoDesc","巫术时刻推出的古怪施术单元之一。似乎是附着了什么奇特的源石技艺，总是能让持有者有一种莫名的安心感。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",79,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_98":99},"list",[100,107,109,112,116,119,121,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,267,272,276,281,286,291,296,301,306,311,316,321,325,330,335,340,344,349,354,359,364,368,373,378,383,388,392,397,402,407,412,416,420,425,430,435,439,444,449,454,459,463,467,472,477,482,485,490,495,500,504,508],{"_101":102,"_103":104,"_105":87,"_106":95},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_101":108,"_103":104,"_105":87,"_106":55},54,{"_101":110,"_103":104,"_105":87,"_106":111},59,3,{"_101":113,"_103":114,"_105":87,"_106":115},64,20,4,{"_101":117,"_103":118,"_105":87,"_106":92},69,40,{"_101":120,"_103":102,"_105":87,"_106":42},74,{"_101":91,"_103":122,"_105":87,"_106":123},80,7,{"_101":125,"_103":126,"_105":87,"_106":127},84,110,8,{"_101":129,"_103":130,"_105":87,"_106":131},89,150,9,{"_101":133,"_103":134,"_105":104,"_106":104},94,200,{"_101":136,"_103":137,"_105":104,"_106":138},99,270,11,{"_101":140,"_103":141,"_105":104,"_106":142},104,370,12,{"_101":144,"_103":145,"_105":114,"_106":146},109,480,13,{"_101":148,"_103":149,"_105":150,"_106":151},114,620,30,14,{"_101":153,"_103":154,"_105":102,"_106":155},119,780,15,{"_101":157,"_103":158,"_105":159,"_106":160},124,990,70,16,{"_