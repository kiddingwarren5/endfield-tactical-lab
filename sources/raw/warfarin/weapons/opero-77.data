[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_665":666},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0009","slug","opero-77","name","奥佩罗77","type","weapon","version","1.6",{"_26":27,"_54":55,"_92":93,"_493":494,"_555":556},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_52":53},"breakthroughTemplateId","weapon_breakthrough_3star_A_1","engName","Opero 77","levelTemplateId","weapon_upgrade_curve_3star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0009.prefab","potentialUpItemList",[],"rarity",3,"talentTemplateId","wpn_potential_3star","weaponDesc","……综上所述，我必须再次强调武器应以实用性为第一要义的观点——77的菱形凹槽是绝对失败的冗余设计！您该清楚，我们的敌人已经不再是那些有血有肉的同类了，此后的设计绝不能再照搬罗德岛的那些工程资料。\n美观？！您这是程度相当严重的侮辱。武器最重要的美德绝不是它的外表！如果我想做的是那样的设计，我早就跳槽去梅什科工业了！\n——奥佩罗79设计会第三次会议纪要","weaponId","weaponPotentialSkill","sk_wpn_lance_0009","weaponSkillList",[51,48],"wpn_attr_main_low","weaponType",5,"itemTable",{"_56":57,"_58":59,"_60":61,"_62":63,"_64":16,"_15":16,"_65":66,"_67":66,"_68":69,"_19":20,"_70":71,"_72":63,"_73":74,"_75":76,"_77":63,"_78":79,"_81":82,"_40":41,"_83":57,"_84":85,"_86":87,"_88":89,"_21":53,"_90":57,"_91":89},"backpackCanDiscard",false,"decoDesc","终末地工业制造的干员基础装备之一。由资深武库工程师奥佩罗亲自设计。其舒适的握持感令新进干员也能运用自如。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[80],"item_obtain_explore","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",1,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_94":95},"list",[96,103,106,108,112,114,118,122,126,130,133,137,141,145,150,154,159,164,169,172,176,181,186,191,196,201,2