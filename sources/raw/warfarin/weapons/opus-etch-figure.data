,"<align=\"right\">","opt.key",{"_15":1272,"_814":1274,"_817":1275},[816,816,816],[1276,1276,1276],"<color=#5ECDFF>","qu.numdown",{"_15":1277,"_814":1279,"_817":1280},[816,816,816],[1281,1281,1281],"<color=#e74414>","toast_craft.key",{"_15":1282,"_814":1284,"_817":1285},[816,816,816],[869,869,870],"qu.numup",{"_15":1286,"_814":1288,"_817":1289},[816,816,816],[1290,1290,1290],"<color=#c7fe02>","rac.tec",{"_15":1291,"_814":1293,"_817":1294},[816,816,816],[1295,1295,1295],"<color=#FFCC00>","scene_grade.down",{"_15":1296,"_814":1298,"_817":1299},[816,816,816],[1300,1300,1300],"<color=#D12E42>","set.key",{"_15":1301,"_814":1303,"_817":1304},[816,816,816],[1305,1305,1305],"<color=#A7A7A7>","tech.get",{"_15":1306,"_814":1308,"_817":1309},[816,816,816],[1310,1310,1310],"<color=#1e1e1e>","tips.key",{"_15":1311,"_814":1313,"_817":1314},[816,816,816],[1315,1316,1315],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1317,"_814":1319,"_817":1320},[816,816,816],[1104,1105,1106],"toast_focal.key",{"_15":1321,"_814":1323,"_817":1324},[816,816,816],[1316,1316,1316],"weapon.stress",{"_15":1325,"_814":1327,"_817":1328},[816,816,816],[1329,1329,1329],"<color=#fe5a00>","weekraid.key",{"_15":1330,"_814":1332,"_817":1333},[973,973,973],[1334,1334,1335],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_1338":1339,"_1345":1346,"_1027":1350,"_1355":1356,"_1359":1360,"_1364":1365,"_1368":1369,"_1373":1374,"_1377":1378,"_1382":1383,"_1386":1387,"_842":1391,"_1396":1397,"_1400":1401,"_1405":1406,"_1410":1411,"_1414":1415,"_1419":1420,"_925":1423,"_1428":1429,"_1432":1433,"_1438":1439,"_931":1442,"_1447":1448,"_1451":1452,"_949":1456,"_1461":1462,"_1465":1466,"_956":1470,"_1475":1476,"_1481":1482,"_980":1486,"_1491":1492,"_1496":1497,"_1501":1502,"_1506":1507,"_987":1511,"_1515":1516,"_1520":1521,"_1525":1526,"_1529":1530,"_1535":1536,"_1540":1541,"_1017":1545,"_1550":1551,"_1555":1556,"_1558":1559,"_1562":1563,"_1567":1568,"_1571":1572,"_1577":1578,"_1581":1582,"_1586":1587,"_1591":1592,"_1034":1596,"_1600":1601,"_1603":1604,"_1054":1608,"_1612":1613,"_1617":1618,"_1622":1623,"_1627":1628,"_1631":1632,"_1636":1637,"_854":1642,"_893":1646,"_1651":1652,"_1656":1657,"_1661":1662,"_1080":1666,"_1671":1672,"_1674":1675,"_1678":1679,"_1682":1683,"_1687":1688,"_1692":1693,"_1696":1697,"_1701":1702,"_1120":1706,"_1710":1711,"_1715":1716,"_1720":1721,"_1725":1726,"_1729":1730,"_1733":1734,"_1738":1739,"_1743":1744,"_1747":1748,"_1753":1754,"_1757":1758,"_1761":1762,"_1766":1767,"_1770":1771,"_1774":1775,"_1778":1779,"_1784":1785,"_1789":1790,"_1794":1795,"_1799":1800,"_1804":1805,"_1809":1810,"_1814":1815,"_1819":1820,"_1824":1825,"_1829":1830,"_1834":1835,"_1839":1840,"_1844":1845,"_1849":1850},"adv.electricFence",{"_62":1340,"_1341":65,"_15":1338,"_1342":65,"_19":1343,"_1344":910},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_62":1347,"_1341":1348,"_15":1345,"_1342":65,"_19":1349,"_1344":963},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_62":1351,"_1341":1352,"_15":1027,"_1342":1353,"_19":1354,"_1344":1092},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_62":1357,"_1341":65,"_15":1355,"_1342":65,"_19":1358,"_1344":910},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_62":1361,"_1341":1362,"_15":1359,"_1342":65,"_19":1363,"_1344":910},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_62":1366,"_1341":65,"_15":1364,"_1342":65,"_19":1367,"_1344":910},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_62":1370,"_1341":1371,"_15":1368,"_1342":65,"_19":1372,"_1344":1004},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_62":1375,"_1341":65,"_15":1373,"_1342":65,"_19":1376,"_1344":910},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_62":1379,"_1341":1380,"_15":1377,"_1342":65,"_19":1381,"_1344":910},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_62":1384,"_1341":65,"_15":1382,"_1342":65,"_19":1385,"_1344":65},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_62":1388,"_1341":1389,"_15":1386,"_1342":65,"_19":1390,"_1344":963},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_62":1392,"_1341":1393,"_15":842,"_1342":1394,"_19":1395,"_1344":1092},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_62":1398,"_1341":65,"_15":1396,"_1342":65,"_19":1399,"_1344":910},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_62":1402,"_1341":1403,"_15":1400,"_1342":65,"_19":1404,"_1344":910},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_62":1407,"_1341":1408,"_15":1405,"_1342":65,"_19":1409,"_1344":910},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_62":1412,"_1341":65,"_15":1410,"_1342":65,"_19":1413,"_1344":937},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_62":1416,"_1341":1417,"_15":1414,"_1342":65,"_19":1418,"_1344":910},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_62":1421,"_1341":65,"_15":1419,"_1342":65,"_19":1422,"_1344":937},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_62":1424,"_1341":1425,"_15":925,"_1342":1426,"_19":1427,"_1344":1004},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_62":1430,"_1341":1425,"_15":1428,"_1342":65,"_19":1431,"_1344":1004},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_62":1434,"_1341":1435,"_15":1432,"_1342":1436,"_19":1437,"_1344":937},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_62":1440,"_1341":65,"_15":1438,"_1342":65,"_19":1441,"_1344":937},"持续时间内，受影响的目标暂停行动。","定身",{"_62":1443,"_1341":1444,"_15":931,"_1342":1445,"_19":1446,"_1344":1116},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_62":1449,"_1341":1444,"_15":1447,"_1342":65,"_19":1450,"_1344":1116},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_62":1453,"_1341":65,"_15":1451,"_1342":1454,"_19":1455,"_1344":65},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_62":1457,"_1341":1458,"_15":949,"_1342":1459,"_19":1460,"_1344":1066},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_62":1463,"_1341":1458,"_15":1461,"_1342":65,"_19":1464,"_1344":1066},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_62":1467,"_1341":1468,"_15":1465,"_1342":65,"_19":1469,"_1344":910},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_62":1471,"_1341":1472,"_15":956,"_1342":1473,"_19":1474,"_1344":1092},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_62":1477,"_1341":1478,"_15":1475,"_1342":1479,"_19":1480,"_1344":937},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_62":1483,"_1341":1484,"_15":1481,"_1342":65,"_19":1485,"_1344":937},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_62":1487,"_1341":1488,"_15":980,"_1342":1489,"_19":1490,"_1344":963},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_62":1493,"_1341":65,"_15":1491,"_1342":1494,"_19":1495,"_1344":963},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_62":1498,"_1341":1499,"_15":1496,"_1342":65,"_19":1500,"_1344":910},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_62":1503,"_1341":1504,"_15":1501,"_1342":65,"_19":1505,"_1344":910},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_62":1508,"_1341":1509,"_15":1506,"_1342":65,"_19":1510,"_1344":963},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_62":1512,"_1341":1348,"_15":987,"_1342":1513,"_19":1514,"_1344":963},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_62":1517,"_1341":65,"_15":1515,"_1342":1518,"_19":1519,"_1344":937},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_62":1522,"_1341":1523,"_15":1520,"_1342":65,"_19":1524,"_1344":910},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_62":1527,"_1341":65,"_15":1525,"_1342":65,"_19":1528,"_1344":65},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_62":1531,"_1341":1532,"_15":1529,"_1342":1533,"_19":1534,"_1344":937},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_62":1537,"_1341":1538,"_15":1535,"_1342":65,"_19":1539,"_1344":910},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_62":1542,"_1341":65,"_15":1540,"_1342":1543,"_19":1544,"_1344":1004},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_62":1546,"_1341":1547,"_15":1017,"_1342":1548,"_19":1549,"_1344":1004},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_62":1552,"_1341":1553,"_15":1550,"_1342":65,"_19":1554,"_1344":910},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_62":1430,"_1341":1547,"_15":1555,"_1342":65,"_19":1557,"_1344":1004},"干员受到灼热附着","sys.tacticalItem",{"_62":1560,"_1341":65,"_15":1558,"_1342":65,"_19":1561,"_1344":910},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_62":1564,"_1341":1565,"_15":1562,"_1342":65,"_19":1566,"_1344":1004},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_62":1449,"_1341":1569,"_15":1567,"_1342":65,"_19":1570,"_1344":1116},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_62":1573,"_1341":1574,"_15":1571,"_1342":1575,"_19":1576,"_1344":937},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_62":1579,"_1341":65,"_15":1577,"_1342":65,"_19":1580,"_1344":937},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_62":1583,"_1341":1584,"_15":1581,"_1342":65,"_19":1585,"_1344":1092},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_62":1588,"_1341":1589,"_15":1586,"_1342":65,"_19":1590,"_1344":1116},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_62":1593,"_1341":1594,"_15":1591,"_1342":65,"_19":1595,"_1344":937},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_62":1597,"_1341":1598,"_15":1034,"_1342":1489,"_19":1599,"_1344":963},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_62":1347,"_1341":1598,"_15":1600,"_1342":65,"_19":1602,"_1344":963},"干员受到冻结","ba.naturalvul",{"_62":1605,"_1341":1606,"_15":1603,"_1342":65,"_19":1607,"_1344":1066},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_62":1392,"_1341":1609,"_15":1054,"_1342":1610,"_19":1611,"_1344":1092},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_62":1614,"_1341":1615,"_15":1612,"_1342":65,"_19":1616,"_1344":910},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_62":1619,"_1341":1620,"_15":1617,"_1342":65,"_19":1621,"_1344":910},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_62":1624,"_1341":1625,"_15":1622,"_1342":65,"_19":1626,"_1344":910},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_62":1629,"_1341":65,"_15":1627,"_1342":65,"_19":1630,"_1344":910},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_62":1633,"_1341":65,"_15":1631,"_1342":1634,"_19":1635,"_1344":65},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_62":1638,"_1341":1639,"_15":1636,"_1342":1640,"_19":1641,"_1344":937},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_62":1643,"_1341":65,"_15":854,"_1342":1644,"_19":1645,"_1344":1066},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_62":1647,"_1341":1648,"_15":893,"_1342":1649,"_19":1650,"_1344":1092},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_62":1653,"_1341":1654,"_15":1651,"_1342":65,"_19":1655,"_1344":910},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_62":1658,"_1341":1659,"_15":1656,"_1342":65,"_19":1660,"_1344":1066},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_62":1663,"_1341":1664,"_15":1661,"_1342":65,"_19":1665,"_1344":910},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_62":1667,"_1341":1668,"_15":1080,"_1342":1669,"_19":1670,"_1344":1066},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_62":1463,"_1341":1668,"_15":1671,"_1342":65,"_19":1673,"_1344":1066},"干员受到自然附着","ba.originium",{"_62":1676,"_1341":65,"_15":1674,"_1342":65,"_19":1677,"_1344":937},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_62":1680,"_1341":65,"_15":1678,"_1342":65,"_19":1681,"_1344":1092},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_62":1684,"_1341":1685,"_15":1682,"_1342":65,"_19":1686,"_1344":1092},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_62":1689,"_1341":65,"_15":1687,"_1342":1690,"_19":1691,"_1344":1100},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_62":1694,"_1341":65,"_15":1692,"_1342":65,"_19":1695,"_1344":910},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_62":1698,"_1341":65,"_15":1696,"_1342":1699,"_19":1700,"_1344":1116},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_62":1703,"_1341":1704,"_15":1701,"_1342":65,"_19":1705,"_1344":910},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_62":1707,"_1341":1569,"_15":1120,"_1342":1708,"_19":1709,"_1344":1116},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_62":1712,"_1341":1713,"_15":1710,"_1342":65,"_19":1714,"_1344":1116},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_62":1717,"_1341":65,"_15":1715,"_1342":1718,"_19":1719,"_1344":937},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_62":1722,"_1341":65,"_15":1720,"_1342":1723,"_19":1724,"_1344":65},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_62":1727,"_1341":65,"_15":1725,"_1342":65,"_19":1728,"_1344":910},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_62":1731,"_1341":65,"_15":1729,"_1342":65,"_19":1732,"_1344":937},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_62":1735,"_1341":1736,"_15":1733,"_1342":65,"_19":1737,"_1344":910},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_62":1740,"_1341":65,"_15":1738,"_1342":1741,"_19":1742,"_1344":937},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_62":1745,"_1341":65,"_15":1743,"_1342":65,"_19":1746,"_1344":910},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_62":1749,"_1341":1750,"_15":1747,"_1342":1751,"_19":1752,"_1344":937},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_62":1755,"_1341":65,"_15":1753,"_1342":65,"_19":1756,"_1344":937},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_62":1759,"_1341":65,"_15":1757,"_1342":65,"_19":1760,"_1344":937},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_62":1763,"_1341":1764,"_15":1761,"_1342":65,"_19":1765,"_1344":910},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_62":1768,"_1341":65,"_15":1766,"_1342":65,"_19":1769,"_1344":937},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_62":1772,"_1341":65,"_15":1770,"_1342":65,"_19":1773,"_1344":937},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_62":1776,"_1341":65,"_15":1774,"_1342":65,"_19":1777,"_1344":937},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_62":1780,"_1341":1781,"_15":1778,"_1342":1782,"_19":1783,"_1344":937},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_62":1786,"_1341":1787,"_15":1784,"_1342":65,"_19":1788,"_1344":910},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_62":1791,"_1341":1792,"_15":1789,"_1342":65,"_19":1793,"_1344":910},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_62":1796,"_1341":1797,"_15":1794,"_1342":65,"_19":1798,"_1344":910},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_62":1801,"_1341":1802,"_15":1799,"_1342":65,"_19":1803,"_1344":910},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_62":1806,"_1341":1807,"_15":1804,"_1342":65,"_19":1808,"_1344":910},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_62":1811,"_1341":1812,"_15":1809,"_1342":65,"_19":1813,"_1344":910},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_62":1816,"_1341":1817,"_15":1814,"_1342":65,"_19":1818,"_1344":910},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_62":1821,"_1341":1822,"_15":1819,"_1342":65,"_19":1823,"_1344":910},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_62":1826,"_1341":1827,"_15":1824,"_1342":65,"_19":1828,"_1344":910},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_62":1831,"_1341":1832,"_15":1829,"_1342":65,"_19":1833,"_1344":910},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_62":1836,"_1341":1837,"_15":1834,"_1342":65,"_19":1838,"_1344":910},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_62":1841,"_1341":1842,"_15":1839,"_1342":65,"_19":1843,"_1344":910},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_62":1846,"_1341":1847,"_15":1844,"_1342":65,"_19":1848,"_1344":910},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_62":1851,"_1341":1852,"_15":1849,"_1342":65,"_19":1853,"_1344":910},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维",{"_517":1855,"_532":1857,"_542":1859,"_551":1861,"_553":1863,"_563":1865,"_565":1867,"_1869":1870},{"_15":517,"_66":517,"_19":1856,"_41":111},"强固模具",{"_15":532,"_66":532,"_19":1858,"_41":115},"轻黯石",{"_15":542,"_66":542,"_19":1860,"_41":115},"中黯石",{"_15":551,"_66":551,"_19":1862,"_41":115},"重型强固模具",{"_15":553,"_66":553,"_19":1864,"_41":115},"重黯石",{"_15":563,"_66":563,"_19":1866,"_41":92},"象限拟合液",{"_15":565,"_66":565,"_19":1868,"_41":92},"武陵石","item_gold",{"_15":1869,"_66":1869,"_19":1871,"_41":115},"折金票"]
