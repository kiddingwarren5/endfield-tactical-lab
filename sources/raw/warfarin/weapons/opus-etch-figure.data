[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_791":792},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0006","slug","opus-etch-figure","name","作品：蚀迹","type","weapon","version","1.6",{"_26":27,"_56":57,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_D_2","engName","Opus: Etch Figure","levelTemplateId","weapon_upgrade_curve_6star_0.98","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0006.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","蚀迹：塔卫二地质学名词，原指晶体表面受溶蚀而形成的规则状凹斑，现多指自然物遭到侵蚀作用而形成的各种痕迹。\n\n“我想将侵蚀作用在岩石上形成的痕迹统一命名为‘蚀迹’。”\n“你又在挪用已有的名词术语了。”\n“不出五年，学生们就会扔掉从泰拉带来的旧教科书，转而学习我写的《塔卫二地质学》。到那时候，我定下来的才是正确用法。”\n“你还是这样异想天开，真不知道该说是自大还是自信。”\n“异想天开？我太喜欢这个词了。你怎么知道来这儿之前我主修的是航天，梦想的就是有朝一日骑着火箭飞到星星上去？”\n“那怎么改行和我一起下地底了？”\n“还不是因为那‘该死’的、‘颠覆了一切已知法则’的、‘不可理解’的东西！”\n“超域？”\n“还能是什么？这东西比天使要麻烦一万倍。我分析了捕捉到的所有数据，得出的结论是，星空中这样那样无法观测的盲点，都可能是被超域覆盖了。最近的……离这颗星球的距离就像你我鼻尖的距离一样近。”\n“天哪，那我们岂不是……”\n“没错，宇宙是危险的，在我们有生之年，恐怕都没法飞出塔罗斯的掌心。”\n“呃……我的意思是超域会不会把我们吞掉，看来还是你比较乐观。”\n“谁知道呢，总之我得在这之前搞清楚超域到底是怎么出现的，最古老的侵蚀痕迹离现在到底有多久，所以我就来和你做同伴了。”\n“要是能弄明白这些，别说地质学了，物理学、天文学……连小孩写作文都得出现你‘卡蒂娅’的大名。”\n“谢谢鼓励，那我一定不会忘了在扉页鸣谢你，莫里斯。咦？指数计有响动，那边！”\n“我看看，哇噢！”\n——一份古旧的录音资料\n\n“这就是您老师的老师的老师的故事？伊冯干员？”\n“确切地说比这还要早一些。这是他们的最后一段音频资料。”\n“然后？”\n“然后他们就再也没有回来。他们遗物里的第一块侵蚀冰碛岩样本，后来辗转落到了我老师的老师的老师手里。他从这里开始了研究，成为了‘超域研究之父’。”\n“那您讲这个故事的用意是……”\n“不是问我怎么踏上超域研究之路吗？向你介绍的就是，我真正的师承。”","weaponId","weaponPotentialSkill","sk_wpn_funnel_0006","weaponSkillList",[52,53,49],"wpn_attr_will_high","wpn_sp_attr_naturaldam_high","weaponType",2,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":95},"backpackCanDiscard",false,"decoDesc","轻超域技术实验室签约作品。艺术家亲手錾刻的金属器件与冰碛岩的纹理缀合，形成独一无二的施术回路。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",47,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_98":99},"list",[100,107,109,112,116,119,122,126,130,134,137,141,145,149,154,158,163,168,173,177,181,186,191,196,201,206,211,216,221,226,230,235,240,245,250,255,260,264,269,274,277,282,287,292,297,302,306,310,315,319,323,328,333,338,342,347,352,357,362,366,371,376,381,386,390,395,400,405,410,414,418,423,428,433,437,442,447,452,456,461,465,470,475,479,484,489,494,499,503,507],{"_101":102,"_103":104,"_105":87,"_106":95},"baseAtk",49,"lvUpExp",10,"lvUpGold","weaponLv",{"_101":108,"_103":104,"_105":87,"_106":55},54,{"_101":110,"_103":104,"_105":87,"_106":111},59,3,{"_101":113,"_103":114,"_105":87,"_106":115},64,20,4,{"_101":117,"_103":118,"_105":87,"_106":92},69,40,{"_101":120,"_103":121,"_105":87,"_106":42},74,50,{"_101":123,"_103":124,"_105":87,"_106":125},78,80,7,{"_101":127,"_103":128,"_105":87,"_106":129},83,110,8,{"_101":131,"_103":132,"_105":87,"_106":133},88,150,9,{"_101":135,"_103":136,"_105":104,"_106":104},93,200,{"_101":138,"_103":139,"_105":104,"_106":140},98,270,11,{"_101":142,"_103":143,"_105":104,"_106":144},103,370,12,{"_101":146,"_103":147,"_105":114,"_106":148},108,480,13,{"_101":150,"_103":151,"_105":152,"_106":153},113,620,30,14,{"_101":155,"_103":156,"_105":121,"_106":157},118,780,15,{"_101":159,"_103":160,"_105":161,"_106":162},123,990,70,16,{"_101":164,"_103":165,"_105":166,"_106":167},127,1250,100,17,{"_101":169,"_103":1