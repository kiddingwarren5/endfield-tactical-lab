[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_770":771},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0018","slug","twelve-questions","name","十二问","type","weapon","version","1.6",{"_26":27,"_55":56,"_93":94,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_2","engName","Twelve Questions","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0018.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","……于是，尚未成为师者的奥里莎在十二具尸骸旁，向沙盗提问。\n“你为何杀戮众生长地？”\n“因为厌恶。”沙盗回答。\n“你为何厌恶？”\n“因为黑白相映。”沙盗复又回答。\n众生长地的道路否定了裂地者的道路。众生长地使人知晓躲避灾难的手段，因此人们便不必争抢；众生长地使人知晓种植瓜果的办法，因此人们便不必杀戮……而在杀戮者眼中，这便是否定其道路的力证。\n……于是，沙盗在十二具尸骸旁，向奥里莎提问。\n“你为何甘愿怯懦？”\n“因为此即为最大之勇敢。”奥里莎回答。\n“你为何不愿杀戮？”\n“因为我们的敌人并非彼此。”奥里莎复又回答。\n众生长地选择了自然，其所选择的，是更遥远、更漫长的道路。与塔卫二共存并非是怯懦，援助弱小亦非抛弃血性。以最初的、最痛苦的歌谣为起点，声声传唱响起，世上便不会再有被抛下的人。\n……于是，奥里莎在十二具尸骸旁，拔出刀来，向沙盗最后提问。\n“横跨万年的痕迹，自何处来？”\n“高天之上的星辰，将往何方？”\n“浸染大地的色彩，因何而止？”\n“见自然而不思，何以称智？”\n“困己身于争杀，可是自愿？”\n“持刀铳而伤弱小，何以为勇？”\n“多掠夺而少庇护，何以同行？”\n“视万变而如无物，何以长存？”\n\n那沉迷杀戮的沙盗绝无答案，尚且年轻的师者也并非在指点迷津。\n十二个交织的问题，是一把武器。\n复仇的终点在于击碎心灵。","weaponId","weaponPotentialSkill","sk_wpn_sword_0018","weaponSkillList",[51,52,48],"wpn_attr_agi_mid","wpn_sp_attr_atk_mid","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":54},"backpackCanDiscard",false,"decoDesc","产自荒野的锋利长剑。不同的武器工匠在这类武器上缠裹饰品的方式截然不同。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_dr