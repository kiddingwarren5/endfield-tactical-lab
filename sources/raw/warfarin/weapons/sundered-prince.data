[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_763":764},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0008","slug","sundered-prince","name","破碎君王","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_1","engName","Sundered Prince","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0008.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","我正被一名山丘般的萨卡兹战士单手拎起，走向塞什卡的某个角落。\n周围的小孩兴奋地指着我们，和他们的父母激动地交流，或许是把我们误会成“诸王庭的游行”期间与各位“王庭之主”近距离互动的一环了。\n想起父亲第一次带着我来到这座空中乐园的时候，我也是这般兴奋。\n而现在，我似乎很快就要被眼前这个看不出悲喜的、沉默不语的战士处以极刑了。\n“我、我不该逃票的！”\n“……”\n我是否会像那部记不起名字的老电影演的一样，被一位优雅的血魔提取出所有的血液，盛满他晚餐前的酒杯？\n“我、我小时候来这里玩过，最喜欢的就是‘游侠大冒险’了！我只是想重温一下儿时的美好回忆！”\n“……”\n我是否会像小时候人手一本的《卡兹戴尔战记》漫画里提到的那样，被一人高的巨剑大卸八块，投入某座熔炉之中，成为燃料，化作滚烫的尘埃撒向空中？\n“我、我不该趁着检票区人满为患时，从疲于应对孩子们的父母口袋中顺走那些金票！我错了！”\n“……”\n这不管用。难道说，我真正的企图早已被隐居在这座巫术迷城的某位独眼巨人所预见？那就全完了，为我的小命着想，我还是从实招来吧！\n“我认罪，我认罪！我实在是没钱了！我确实怀有某种……犯罪企图，比如说，趁着塞什卡开放日结束的最后时刻，偷偷地从巫术时刻的品牌总店带走一把设计师本人签名的‘破碎君王’！但这只是我心中的邪念罢了！我才刚进塞什卡就被您逮着了！这一切仍未发生，我发誓！我保证！！”\n“人我带到了，够聒噪的。”\n砰的一声，我摔倒在一片漆黑之中。我小心翼翼地睁开双眼，发现自己落在一张精致、柔软的沙发上，而非预想中的地牢砖面。\n“欢迎您的归来，勇敢的游侠。”\n一位西装革履，佩戴游行假面的萨卡兹坐在我面前的古朴石桌后，念出了我儿时曾通关无数遍的“游侠大冒险”的经典台词。\n\n“来自艾什柏环岛的马克西姆先生，距离您上一次光临塞什卡已经十六年了。但，属于您的奖品，我们一直为您留着。”\n不对，“游侠大冒险”的主持人不是会穿上复古的礼服，扮演神秘的巫术预言者吗？还没等我想明白，那些不愿触及的回忆就一口气涌了上来。\n上一次通关“游侠大冒险”的时候，我终于可以换取最终的“魔王大奖”——一把巧夺天工的玩具佩剑，它曾让儿时的我魂牵梦绕。然而，开放日结束的钟声响起，我错过了那天最后的兑换时机。父亲安慰我，等到下次塞什卡飞回来的时候，再来一次就好。\n我没等到塞什卡重新降临菈梵朵玛的日子，等到的是父亲告诉我，我们如今一贫如洗，要搬去艾什柏环岛“避避风头”。再之后，我当然没能成为什么无畏的游侠，陪伴着我的只剩下扒窃、走私和诈骗……直到我今天为了赚笔大的，故地重游。\n萨卡兹将石桌上的帷布掀开，里面并不是什么按下按钮就会发光的玩具佩剑，而是那把“破碎君王”！一把真正的，由巫术工匠精心打造的利刃！不仅如此，她还当着我的面凭空变出一支笔，签上了名。\n“您……您确定，我十六年前落下的奖品……就是这把贵重的武器吗？”\n“是的，一柄属于游侠的武器，正如预言揭示。”\n“预言……我能斗胆请求您再揭示一个预言吗？”\n“我愿聆听。”\n“我的生活……会变好吗？”\n萨卡兹看着我，她说了些什么，但我的耳中只有时隔十六年后再次响起的，宣告开放日结束的钟声。当我回过神时，双脚已经重新踏上了坚实的地面。人群簇拥着我，他们——孩子们，大人们，许多种族的人们——正抬起头，对放着烟花的塞什卡挥手告别。我像个孩子一样攥紧了手中的剑，我多希望钟声晚一点再响起，我多希望这把剑只要按下一个按钮就会发光。\n不，我已经得到了我想要的东西，而我也知道接下来该怎么做。\n游侠的冒险要开始了。","weaponId","weaponPotentialSkill","sk_wpn_claym_0008","weaponSkillList",[51,52,48],"wpn_attr_str_high","wpn_sp_attr_crirate_high","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","巫术时刻限量发行的特殊武器之一，似乎是依循着什么古老传说打造的外形，仿佛能捕捉梦境中的呻吟。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",62,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,111,115,118,120,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,267,272,276,281,286,291,296,301,306,311,316,321,325,330,335,340,344,349,354,359,364,368,373,378,382,387,391,396,401,406,411,415,419,424,429,434,438,443,448,453,458,462,466,471,476,481,484,489,494,499,503,507],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":108},54,2,{"_100":110,"_102":103,"_104":86,"_105":54},59,{"_100":112,"_102":113,"_104":86,"_105":114},64,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},69,40,{"_100":119,"_102":101,"_104":86,"_105":41},74,{"_100":121,"_102":122,"_104":