[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_756":757},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0021_ink","slug","grand-vision","name","宏愿","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_2","engName","Grand Vision","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0021_ink.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","好像一口井啊……\n他将手肘搭在观景台的栏杆上，让视线随着第十二个飞向远处海里的空酒瓶前进。随即，他看到了那个巨大的“圆环”，它是某种设施，他工作的地方。这还是他第一次，站在这样高，这样远的地方俯瞰它。\n它究竟是用来做什么的呢？是某种海下避难所吗？但好像也听到过什么发射一类的说法……\n他开始胡乱猜测，但很快又制止了自己涌起的念头，无论这设施为何存在，都和自己没什么关系……或许再提前几个月，在自己的小队没有横尸在战场上之前，在自己没有丢掉一只眼睛之前，他会接受人员选拔，接触设施里机密程度更高的工作内容。但现在，他已经没有什么为人类奉献的雄心壮志了，那些东西都已经被埋在了战友们的尸骨下。\n如今他只是一个普通的甲板清洁工……谁家的来着？低头看看挂在胸前的工牌……哦，终末地工业，算了，谁家的都一样……终末地的、工团的、商会的、宏科院的……这里什么地方的人都有。\n在这种远离主要战场的地方，各势力的大人物们又在拼凑什么大项目……\n没什么用处吧，战线一个接着一个崩溃，人类生存空间在被不断压缩，还有什么手段能挽救颓势？\n别想了……只是徒增烦恼……\n既然已经决定了要浑浑噩噩度日，那就要更彻底一点。只不过，他还是能听到一些议论：军人世家的独子，青年俊杰，甘于堕落，退到距离战场最远的地方，只愿意做一个甲板清洁工——这样的话时不时仍会灌进他的耳朵。\n他诧异于如此话语为什么还能刺到自己，所以今日才来到这种地方开解自己，当然，开解到最后无非就是连续不断地灌酒罢了。\n第十三个空酒瓶飞进海里。\n所以，为什么呢？还有什么是自己没放下的吗？勋章？都扔干净了。惯用的武器？埋在哪里了来着？噢……对呀，还有这东西，哎呀，真是……这可真是最标准的“视而不见”。\n他解开眼罩，将眼窝中怎么也捂不热的东西取出来，由黄金和晶体外壳制成的义眼在掌心注视着他。在代代相传的故事中，它是由众王赐予的黄金铸成……他的祖先曾在四皇会战的战场上，亲眼见证了高卢的灭亡……无论是富甲一方的巨商，还是足迹遍布泰拉的旅人，它在之后的每一代子孙手中流传，直到他——失败者手中。\n家族荣光穿透黄金丝缕嵌成的瞳孔，向他投来刺骨的瞥视。\n他攥紧拳头，把绵延不绝的历史遮住，接着，毫不拖泥带水地扔进海里。\n好了，这下干干净净。\n他打着酒嗝，看向远处的圆环，确实很像一口井。他想起在泰拉游学时，在某个小村落里看到过的许愿井，人们将金币和银币扔进井中，祈求自己的愿望能够实现，扔进井中的东西越珍贵，能实现的愿望就越宏大。\n呵呵，真够蠢的。\n若这种说法是真的，那么他刚刚扔进“井”里的东西，能帮助他实现怎样的愿望呢？\n见证过大国崩溃、文明变迁的珍宝，见证过杀戮与新生、毁灭与延续的珍宝，能被“井”塑造成什么样的东西呢？\n算了吧，还是睡一觉好。\n他抬手，将第十四个酒瓶抛上半空，而后，看着它静滞于天上。\n“许愿井”的馈赠已至。\n\n万物皆静，之后是巨大的晶簇。\n天空被开启了，源石之路自天上来。\n无数宏伟的身影隐在云中，就在长路尽头，巨大的星门在他们身后。\n为什么？众王，为什么？\n因为我抛弃了你们的赠予？因为我抛弃了我的历史，我的血脉，我的光荣？\n昔日丧生的战友们自源石的道路上生长出来，他们伸出枯瘦的残肢、崩碎的武器，竭尽所能地挽留着。\n于是他拔出长矛。\n每刺穿一具尸骸，身上便会现出许多文字，那文字极重，他低头看去，是一个个名字。\n父亲的名字、祖父的名字、帕夏的名字、教宗的名字、审判官的名字、拓荒者的名字、矿工的名字……\n他逆着死者的河流向上走，又走过那些史书中的身影。\n众王将自己的名字留在他的矛尖上。\n所以他高举着断矛，刺向那巨大的门扉。而后，被轰鸣声唤醒。\n远处的圆环上，大海被打开，那尖锐的矛，那由所有势力、所有人的绝望与希望、渴盼与伤痕所铸成的井中巨物，就此刺入天空。\n\n██年██月██日，帝江号发射成功。","weaponId","weaponPotentialSkill","sk_wpn_sword_0021","weaponSkillList",[51,52,48],"wpn_attr_agi_high","wpn_sp_attr_atk_high","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":64,"_75":76,"_77":78,"_79":64,"_80":81,"_83":84,"_40":41,"_85":58,"_86":87,"_88":89,"_90":91,"_21":92,"_93":58,"_94":54},"backpackCanDiscard",false,"decoDesc","终末地工业制造的优质武器，极具创意地将实验型源石材料作为剑身主体，使其拥有了极佳的能量传导性能。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","wpn_sword_0021","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",85,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,112,116,119,122,126,130,134,137,141,145,149,154,158,163,168,173,177,181,186,191,196,201,206,211,216,221,226,230,235,240,245,250,255,260,264,269,274,278,283,288,293,298,303,308,313,318,323,327,331,336,341,346,351,355,360,365,370,375,379,384,389,394,399,403,408,413,418,422,426,431,436,441,446,450,455,460,465,469,473,477,482,487,491,494,499,503,508],{"_100":101,"_102":103,"_104":87,"_105":54},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":87,"_105":108},56,2,{"_100":110,"_102":103,"_104":87,"_105":111},61,3,{"_100":113,"_102":114,"_104":87,"_105":11