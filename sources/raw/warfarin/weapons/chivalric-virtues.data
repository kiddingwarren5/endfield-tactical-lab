[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_772":773},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0010","slug","chivalric-virtues","name","骑士精神","type","weapon","version","1.6",{"_26":27,"_55":56,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_2","engName","Chivalric Virtues","levelTemplateId","weapon_upgrade_curve_6star_0.98","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0008.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","伟大的总发言人马克维茨为我们留下的，不是乏味、空虚、苦修一般的生活。正是因为我们面临困苦，面临侵蚀、天使与整个塔卫二的敌意，我们才更需要人类社会中不可或缺的东西——刺激！\n小雅各宾说得很对，从书本到电影，从牌类游戏到电子产品，我们得幸保留了相当部分源自故乡的文娱形式，但为何我依然坚持这份事业？为何我一直在重提“骑士竞技文化的复辟”？\n少安毋躁！少安毋躁！请不要造谣，我从来不是个泰拉主义者或是归乡派。我关注的只有此时，此地。你觉得我是因为怀念卡西米尔才搞的这一套？我出生的时候我爸爸连卡西米尔的照片都没留下一张！\n恰恰相反！正因为我关注现实，我才会斥我毕生巨资，在家乡打造这样一个地下竞技场！\n各位，我们已经不在高雅的泰拉城市街道上啦！各位，我们在荒野，我们在异星，我们在一片陌生的土地上！文学？影视？那些温吞的东西只会让年轻人沉溺在安全坚固的住宅里，难道你要让一群书呆子去工团工厂搬源矿，让一群近视眼去铁誓军的堡垒对付天使吗？\n想想骑士竞技吧。对武器和身体的打磨，对源石技艺的极致钻研。这样尚武的运动难道不吻合我们残酷的现状吗？——换句话说，这话只对各位说——难道不会得到商会和军队的大力支持吗？\n不不不，别说得好像我们在培养野蛮人一样。骑士竞技确实强调武力，但对自我肉体和精神的打磨，不才是骑士精神的最好展现吗？\n道德……道德当然是必要的……但道德是赚到钱以后再商量的事情，对不？\n得了吧红下巴，你自己说，你那个当医生的儿子要是更强壮些，他去北面就职的时候，你还会担心吗？\n哦，你说得太对了。我甚至觉得铁誓军会投资我们……嗯。不妨这么想，若真能培养出几个擂台上的超级明星，也许其他合作方也都会为了他们抛来橄榄枝呢？我听说以前的卡西米尔就有这种先例！输出超级战士！\n投资？当然……投资。我把各位父老乡亲喊来可不是为了耍嘴皮子的……直白地说，我已经找到第一批选手了。有工程师，有医生，甚至有土匪……不过他们都是一些陪衬，我相中了两位退役士兵，他们一定能崭露头角！\n啊。你的提议也没错，这很稳妥。可是等到大街小巷都在关注我这场血脉偾张的赛事时，再想入局可就不是今天这个价了……算了吧，等到铁誓军都来投资我的时候，我可不需要你那点卖粮食的钱了，我的好舅舅！\n还有人没有签字吗？很好。\n既然是咱们一大家子攒的钱，竞技场就以我们的家族命名……不只如此，当骑士竞技重新风靡大地的时候，整个协会都应该冠以我们的名字！\n——汉尼克协会！","weaponId","weaponPotentialSkill","sk_wpn_funnel_0010","weaponSkillList",[51,52,48],"wpn_attr_will_high","wpn_sp_attr_hp_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":64,"_75":76,"_77":78,"_79":64,"_80":81,"_83":84,"_40":41,"_85":58,"_86":87,"_88":89,"_90":91,"_21":92,"_93":58,"_94":95},"backpackCanDiscard",false,"decoDesc","梅什科工业研发的施术单元之一。选用特制D64钢壳，配多款定制模块。这款产品让人联想起昔日竞技场的烟火秀。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","wpn_funnel_0008","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",57,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_98":99},"list",[100,107,109,112,116,119,122,126,130,134,137,141,145,149,154,158,163,168,173,177,181,186,191,196,201,206,211,216,221,226,230,235,240,245,250,255,260,264,269,274,277,282,287,292,297,302,306,311,316,320,324,329,334,339,343,348,353,357,362,366,371,376,381,386,390,395,400,405,410,414,418,423,428,433,437,442,447,452,456,461,465,470,475,479,484,489,494,499,503,507],{"_101":102,"_103":104,"_105":87,"_106":95},"baseAtk",49,"lvUpExp",10,"lvUpGold","weaponLv",{"_101":108,"_103":104,"_105":87,"_106":54},54,{"_101":110,"_103":104,"_105":87,"_106":111},59,3,{"_101":113,"_103":114,"_105":87,"_106":115},64,20,4,{"_101":117,"_103":118,"_105":87,"_106":92},69,40,{"_101":120,"_103":121,"_105":87,"_106":41},74,50,{"_101":123,"_103":124,"_105":87,"_106":125},78,80,7,{"_101":127,"_103":128,"_105":87,"_106":129},83,110,8,{"_101":131,"_103":132,"_105":87,"_106":133},88,150,9,{"_101":135,"_103":136,"_105":104,"_106":104},93,200,{"_101":138,"_103":139,"_105":104,"_106":140},98,270,11,{"_101":142,"_103":143,"_105":104,"_106":144},103,370,12,{"_101":146,"_103":147,"_105":114,"_106":148},108,480,13,{"_101":150,"_103":151,"_105":152,"_106":153},113,620,30,14,{"_101":155,"_103":156,"_