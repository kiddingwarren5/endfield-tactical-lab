[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_784":785},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0015","slug","blessing-of-lustrous-carmine","name","镀红祝福","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_2","engName","Blessing of Lustrous Carmine","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0015.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","萨卡兹们围成圈，坐在松软的积雪上。过去的几个月，他们进行了多次谈话，讨论该如何应对无处不在的天使，该分派多少人手去搜救那些不擅战斗的异族，又该怎么接受星门崩溃，他们再也回不去卡兹戴尔的事实。\n天使就像是永不止歇的潮水，漫过了所有道路，逼迫他们从北方的开拓据点狼狈撤出，再一次成了无根之人，看不到前路，也失去了归途。\n星环反射出的光线日益黯淡，墙上的血污越来越厚，存粮日渐减少，只剩下窒人的空气，愿意开口的人也越来越少。即使是面对萨米人送来的善意，众萨卡兹也依旧沉默。\n“确定就那么处理巨兽的牙了？把它转化成另一个‘生命脊椎’？”但今天不一样——弗莱明想，今天，所有人都得开口，于是他率先打破了沉默。\n“我不太明白，他们为什么愿意送出这么贵重的东西？”\n“也许因为我们提供过几次关键的军事援助吧。”\n“……可巨兽还是陨落了。”\n“雪祀提到了关于我们的预言……”\n人们的话语依旧充斥着迷茫与困惑，但至少在缓缓推进。弗莱明适时地拨动话题，试图让对话朝他想要的方向流动：“别想得太复杂。这颗小星球脾气太坏，要想活下去，就得互帮互助。何况萨米和我们本就有些渊源。”\n“不只有我们，其他人也需要‘生命脊椎’。我们需要去北方，赢下来，救更多的人……我们只需要考虑怎么获得祝福。”\n提起北方，萨卡兹们又缄口不言。谁也不知道这场战争还要打多久，而他们早已感到疲惫。\n糟糕。弗莱明抹去额头的汗，顶尖的推销员不该这么急切地暴露目的。正当他强挤出笑容，准备转换话题时，坐在最外侧的血魔——弗莱明不熟悉这位女士，甚至记不清她的名字，只知道她有温柔的嗓音——以优雅的姿态扶着点缀有荆棘的血色长枪，说道：“你们不期待吗？”\n“在泰拉时，我们曾有过几座城市？”可塑的血液在空中泛起涟漪般的微光，勾勒出模糊的城市轮廓，“何况是在一颗遥远的、充满未知的星球？想象一下吧，假如我们能缔造一个更加和平的时代，那时的塔卫二的土地和天空——我想，是时候着手建立我们的新家了。”\n“一座靠巨兽骸骨飞在天上的悬空城。它得有自己的风格，还得有个厉害的名字。”弗莱明听到自己的声音。\n“新卡兹戴尔？好像太大了……新的熔炉？”\n“得围上永固火炮工事，免得天使从空中过来！”\n庄严的，肃穆的，凛然的……人们脸上露出对这座即将被亲手打造出的悬空城市的憧憬。笼罩着萨卡兹们的踟蹰、不安被一扫而空，取而代之的是前所未有的躁动。人群喧哗间，不知道谁脱口而出了“塞什卡”这个词——没有复杂的目的性，没想象中威风，只是一处介于前路与归路间的歇脚地。\n但这是个多美妙的词儿啊。弗莱明将它放在舌尖，咀嚼了几次，细细品味着从肺部呼出的气流与下颚的震颤。他心中隐约升起一个想法——何必让人们继续觉得他们阴郁暴戾，唯愿与战争为伴？那城市该建成一处游乐园，摩天轮、露天集市、剧场……所有好玩的东西，无论它们是否属于过去的萨卡兹，全都塞进去。\n北方的风冷得刺骨，托它的福，弗莱明的大脑前所未有地清醒。他想到了很多很多，比如弄些活动，叫“升空节”“开放日”“诸王庭游行”——萨卡兹们会借着它，像蒲公英一样，温柔地落在这颗星球上。\n这座城市上方不会再出现焚烧战死者的烟霾，自有更美丽的东西——比如烟花，为它的存在祝福。\n不知道其他人怎么想，但星门另一头的议长肯定喜欢这主意。每次只要提到爆炸，她就很开心。\n弗莱明有很多机会证明自己是个好商人。接下来他要做的，就是把点子推销出去。","weaponId","weaponPotentialSkill","sk_wpn_lance_0015","weaponSkillList",[51,52,48],"wpn_attr_agi_high","wpn_sp_attr_firedam_high","weaponType",5,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":54,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","巫术时刻发行的长枪之一。在塞什卡开放日上推出的特别纪念款，枪身采用了特殊的镀层工艺，兼具实用性与美学价值。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",72,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,330,335,340,345,350,354,359,364,369,374,378,383,388,393,398,402,407,412,417,421,425,429,434,439,444,448,453,458,463,467,471,475,480,485,490,493,498,502,507],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},56,2,{"_99":109,"_101":102,"_103":86,"_104":110},61,3,{"_99":112,"_101":113,"_103":86,"_104":114},66,20,4,{"_99":116,"_101":117,"_103":86,"_104":54},71,40,{"_99":119,"_101":120,"_103":86,"_104":41},76,50,{"_99":122,"_101":123,"_103":86,"_104":124},81,80,7,{"_99":126,"_101":127,"_10