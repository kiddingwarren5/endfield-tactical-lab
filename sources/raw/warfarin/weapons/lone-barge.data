[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_801":802},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0015","slug","lone-barge","name","孤舟","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Lone Barge","levelTemplateId","weapon_upgrade_curve_6star_1.03","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0015.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“黄老，上午派出去的几支救援队回来了，没有找到名单上的科研人员。目前就差下午出发的那支救援队还没有任何的消息。”\n“嗯，还不能掉以轻心。伤员可都安置妥当了？”\n“已经按照您的吩咐，将伤情较轻的人一同安置在了临时避难所。伤情较重的人员，都紧急送往了最近的城市，接受更全面的治疗。”\n老者叹了口气，自救援队抵达武陵地区起，已经过去了七十二小时。七十二小时，武陵科考站所在的地区依然被吞没在侵蚀潮中，宏科院投入了全部救援力量，也没能救出被困在科考站中的科研人员。\n收到命令后，身着防护服的年轻巡卫们简单行了一礼便退了下去，从搭起临时指挥所的帐篷开始，他们就再也没有合过眼。\n临时指挥所重新安静了下来，帐内只剩下老者，和他那些埋头监测甚大裂隙状态的学生们。\n“黄天师。”一名带着本部最新指示的信使走了进来。\n“有劳信使专程跑一趟，文件我已收到。另外，在终末地工业的帮助下，明日一早我们便能全面恢复与外界的远程通信，还望信使将这条消息带给武陵外的临时通信站，好让本部尽快知晓。”\n“好，辛苦诸位。”\n“院里有什么指示？”见信使离去，天师们围了上来，但当看清文件上的内容，时间仿佛在他们的脸上静止。\n“二十四小时后，宏科院本部将对是否中止深入裂隙爆发区域的救援行动……进行表决。本部认为，现场救援负责人的意见至关重要。”\n“表决？为什么？裂隙的扩张明明已经暂时减缓了！”\n“下一步，不会就是要我们带着所有人一块撤回本部了吧。”\n“难道要放弃武陵地区？”\n短暂的沉默后，老者吩咐了救援队接下来的工作安排。\n“别胡思乱想。明天恢复远程通信后，或许还会有其他指示。今晚我自己值班，大家抓紧时间休息。”\n“好吧，那学生就……先行告退了。”\n“老师，保重。”\n帐内再次恢复寂静，只剩老者站在投影的地形图前，不断闪烁着的红光映在了老者的眼中，映在了他手中一纸被捏皱了的文件上。\n他的女儿在那里，他的学生在那里。\n老者咬紧牙关，颤颤巍巍地拿起了学生们留在指挥部的监测报告，在灯光下看着。他们还是太缺乏经验了，看不出裂隙的扩张减缓并不代表着威胁解除，反而预示着更加巨大的危机。裂隙周围的侵蚀物质会短暂地“淤积”起来，造成安全的假象，然后带来令人猝不及防的二次爆发。他发现这一现象的时候还不到三十岁，正是披荆斩棘的年纪。\n老者在塑料椅上坐下，第一次感觉自己到了必须退休的时候。\n\n“已经几十个小时了。很遗憾，甚大裂隙周遭已经没有任何生命反应。既然大家都没有意见，我们决定停止一切搜救行动——”\n老者的面前摆着一支话筒。本部的表决已经结束了，如今他的工作，只剩下宣布最终的决定。\n年轻的天师站了起来，向他咆哮；年轻的天师站了起来，争取继续搜救行动的机会。\n他记得自己还说了其他几句话，重申了这一决定的必要性。\n但最终，老者闭上了眼睛，再不言语。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0015","weaponSkillList",[51,52,48],"wpn_attr_will_high","wpn_sp_attr_atk_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","宏山选剑局研发的施术单元。大胆采用了与息壤相结合的新型材料，优秀的性能可以大幅提高施术效能，但对使用者而言也有着一定的门槛。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",67,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,108,111,114,117,120,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,267,272,276,281,286,291,296,301,306,311,316,321,325,330,334,339,344,348,353,357,362,367,372,377,381,386,391,396,401,405,410,415,419,424,428,433,438,443,448,452,457,462,466,471,475,480,485,490,495,500,503,508],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",52,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":54},57,{"_100":109,"_102":103,"_104":86,"_105":110},62,3,{"_100":90,"_102":112,"_104":86,"_105":113},20,4,{"_100":115,"_102":116,"_104":86,"_105":91},72,40,{"_100":118,"_102":119,"_104":86,"_105":41},77,50,{"_100":121,"_102":122,"_104":86,"_105":123},82,80,7,{"_100":125,"_102":126,"_104":86,"_105":127},88,110,8,{"_100":129,"_102":130,"_104":86,"_105":131},93,150,9,{"_100":133,"_102":134,"_104":103,"_105":103},98,200,{"_100":136,"_102":137,"_104":103,"_105":138},103,270,11,{"_100":140,"_102":141,"_104":103,"_105":142},108,370,12,{"_100":144,