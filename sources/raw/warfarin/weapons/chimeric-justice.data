[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_762":763},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0004","slug","chimeric-justice","name","嵌合正义","type","weapon","version","1.6",{"_26":27,"_54":55,"_93":94,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":41},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Chimeric Justice","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0004.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","听我给你讲个故事吧，好吗，一个很简单的故事，就是关于我为什么一定要拿着这个破烂的、生锈的、终末地生产的、握柄缝隙里满是洗不掉的血污的长枪，不顾你们阻拦地一定要走出医院——相信我吧，等我讲完，你们就会理解我，而不是把我当成一个恋物癖疯子按在轮椅上。\n这绝对是个足够简单的故事，我绝不会骗你们。四年前，准确来讲是1522天前，四号谷地安保队员中的六个，为了救援被困野外的一家而遭到了天使袭击——十只天使，十头没有感情的畜生把他们团团围住了，结局很简单，你一定能猜到个大概。\n\n只剩下两个人。\n\n只有两个人还活着，队伍里最强壮的男人，他赤手空拳站在自己战友们的尸堆旁，在他身后，有个哭泣不止的孩子，在他对面，则是一只半残废的天使，那个怪物用来进攻的肢体虽然断了，可它还能冲锋……啊，这可怎么办呢？这个赤手空拳的可怜人。\n很快，他想到了办法，这要感谢终末地工业，对吧，终末地工业的这款枪可以自由拼组，于是……\n他从队长的身上取下枪尖，从██████的断骨中取下第一节握柄，从█████的手中拿起基质模块，从██████背上取出第二节握柄，最后，他从妻子眉间取下最后一节握柄。\n然后，他胜利了，带着孩子回到了四号谷地，将他的长枪传续下……\n等等，为什么你们一副恍然大悟的表情？\n我是幸存者？我将我的枪命名为“嵌合正义”？\n我是那个孩子？我一定要知恩图报？\n不。\n不不不。\n好好看看我手中的枪，它仅仅是终末地工业的制式产品。\n那么，再好好看看我。\n我只是个先天不足的病秧子，与故事并无直接关联。\n但是……\n请感受我的角膜、我的心脏、我的血液，听一听我体内为了让人类存续下去而奉献的灵魂，听一听他们的呐喊。\n我无法枯坐于此。\n我应是“嵌合正义”。","weaponId","weaponPotentialSkill","sk_wpn_lance_0004","weaponSkillList",[51,52,48],"wpn_attr_str_mid","wpn_sp_attr_usgs_mid","weaponType","itemTable",{"_56":57,"_58":59,"_60":61,"_62":63,"_64":16,"_15":16,"_65":66,"_67":66,"_68":69,"_19":20,"_70":71,"_72":63,"_73":74,"_75":76,"_77":63,"_78":79,"_81":82,"_40":41,"_83":57,"_84":85,"_86":87,"_88":89,"_21":41,"_90":57,"_91":92},"backpackCanDiscard",false,"decoDesc","终末地工业设计的实验型长枪，实际投产量较少，为了适应复杂多变的战场而采用了便于拆卸拼接的模块化设计。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[80],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",16,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_95":96},"list",[97,104,107,110,114,117,120,124,128,132,135,139,143,147,152,156,160,164,169,173,177,182,187,192,197,202,207,212,217,222,226,231,236,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_98":99,"_100":101,"_102":85,"_103":92},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_98":105,"_100":101,"_102":85,"_103":106},46,2,{"_98":108,"_100":101,"_102":85,"_103":109},50,3,{"_98":111,"_100":112,"_102":85,"_103":113},54,20,4,{"_98":115,"_100":116,"_102":85,"_103":41},58,40,{"_98":118,"_100":108,"_102":85,"_103":119},62,6,{"_98":121,"_100":122,"_102":85,"_103":123},66,80,7,{"_98":125,"_100":126,"_102":85,"_103":127},71,110,8,{"_98":129,"_100":130,"_102":85,"_103":131},75,150,9,{"_98":133,"_100":134,"_102":101,"_103":101},79,200,{"_98":136,"_100":137,"_102":101,"_103":138},83,270,11,{"_98":140,"_100":141,"_102":101,"_103":142},87,370,12,{"_98":144,"_100":145,"_102":112,"_103":146},91,480,13,{"_98":148,"_100":149,"_102":150,"_103":151},95,620,30,14,{"_98":153,"_100":154,"_102":108,"_103":155},100,780,15,{"_98":157,"_100":158,"_102":159,"_103":89},104,990,70,{"_98":161,"_100":162,"_102":153,"_103":163},108,1250,17,{"_98":165,"_100":166,"_102":167,"_103":168},112,1550,140,18,{"_98":170,"_100":171,"_102":134,"_103":172},116,1900,19,{"_98":174,"_100":175,"_102":176,"_103":112},120,2360,240,{"_98":178,"_100":17