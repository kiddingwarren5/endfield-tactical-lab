[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_774":775},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0012","slug","freedom-to-proselytize","name","布道自由","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_2","engName","Freedom to Proselytize","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0012.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","名为“会话”的修士步入荒野，\n他来到一片荒芜的聚落，溪流干涸，土地龟裂。\n饥渴的丰蹄们，向他寻求救赎。\n“你们需要知识将你们引向那水草丰茂之处。”\n“我来教你们如何解读这片土地。”\n他手中闪烁着源石网络的光芒，\n他传授着来自极远方之人的学识。\n七个昼夜后，\n明悟的丰蹄学会了如何在荒芜之中挖掘一口水井，\n聚落自此水草丰茂。\n\n名为“重现”的修士步入荒野，\n他来到一片荒芜的聚落，溪流干涸，土地龟裂。\n饥渴的丰蹄们，向他寻求救赎。\n“你们需要力量将本属于你们的水源夺回。”\n“我将赠予你们保护自己的武器。”\n他将身后背负的数把铳取下，\n他将这些四处收集而来的前人遗物赠予今人。\n七个昼夜后，\n武装的丰蹄将霸占了溪流上游的裂地者驱逐出了这片土地，\n聚落自此水草丰茂。\n\n名为“阐释”的修士步入荒野，\n他来到一片荒芜的聚落，溪流干涸，土地龟裂。\n饥渴的丰蹄们，向他寻求救赎。\n“你们需要将信念凝聚在一起，祈祷丰沛的雨终会降临。”\n“我将陪伴、带领你们等待这注定的雨季。”\n他为众人划定律法与规范，让他们学会团结与忍耐，\n他耐心地鼓励着每位绝望的丰蹄，给他们平静与希望。\n七个昼夜后，\n坚定的丰蹄等来了滂沱的生机之雨，\n聚落自此水草丰茂。\n\n汝若是那饥渴的丰蹄，\n会选择接受哪一位修士的救赎？\n\n——“三位修士”的寓言一则，刻于寂语移动大教堂的一角","weaponId","weaponPotentialSkill","sk_wpn_funnel_0012","weaponSkillList",[51,52,48],"wpn_attr_will_mid","wpn_sp_attr_heal_mid","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","梅什科工业为寂语修会定制的施术单元。该产品从设计、验证到落地生产和调试都在寂语修会修士的指导建议下完成。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBac