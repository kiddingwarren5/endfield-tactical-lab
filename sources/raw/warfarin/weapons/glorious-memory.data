[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_786":787},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0017","slug","glorious-memory","name","光荣记忆","type","weapon","version","1.6",{"_26":27,"_56":57,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_B_2","engName","Glorious Memory","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0017.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","【语音日志节选·一】\n“咳——塔罗斯历15年██月██日，嗯，搬进临时安置区的第三天……托里！小声点！你是在修椅子还是拆房子？\n“好了别抱怨了，也别再提你那蓝卡坞主城区的工作室，难道我不希望能有热水和烂片陪我泡澡？可现在连干净的毛巾都算奢侈。\n“要不你去北边找个‘天使先生’喝一杯，顺便问问它们把星门钥匙藏哪儿了？——我当然知道没那种钥匙。你的幽默感和稳定器一起被天使炸飞了吗？\n“我在干嘛？录日志啊。你那台摄影机借我用用行吗？反正纪录片也拍不成了。……不行？好吧，又是摄影师的尊严。\n“刚录到哪儿了？对，今天是塔罗斯历15年——”\n\n【语音日志节选·二】\n“住了两周了，还是没其他人的消息。莫瑞、艾丽、亨利……他们肯定还活着。得这么想。\n“我们算幸运的，至少这儿还有屋顶。别的安置区都挤爆了。战争是结束了，可回不去泰拉，连饭都不一定能吃饱，这日子……\n“……你回来了？等下，那是什么？一把剑？你用罐头换的？！疯了吧！……这剑杀过天使？那又怎样，你的备用镜头也差点杀过天使——停停，我知道那次是我错了！\n“你打听到艾丽和莫瑞在工人联合指挥部那边的安置区？太好了。不过那边物资更紧缺。听说工人联合指挥部和企业安全理事会这几天要开会谈‘安置方案’。呵，像泰拉报纸上的无聊新闻一样，没想到有一天我也会关心这种事。\n“最近别乱跑了，托里，也别再去换那些破烂，留着你那点可怜的罐头吧。\n“还有，检查一下你的摄影机。……我也不知道，只是觉得……或许我们还会用得上它。”\n\n【语音日志节选·三】\n“……已经多久了？我懒得算，大概五个月多点吧。\n“我和托里现在跟着企业安全理事会的队伍——临时的，哪儿能拍到东西，我们就去哪儿。\n“这支队伍今天刚输了一仗，撤退时碰上另一支同样灰头土脸的队伍，是工人联合指挥部的人。两边对望半分钟，谁都没说话，也没人伸手摸武器，就这么走过去了。真挺滑稽的——要命的是我一点都笑不出来。\n“这边不想打，那边也不想打，可这场仗还是打了五个多月。为什么？你知道吗，托里？\n“哦，对了，托里出去拍东西了。我让他别去，他没听。我羡慕他还能举得起摄影机，我已经搞不懂自己在拍什么，也不想拍了。没人会想看这种纪录片的。不过托里说得对，总得有人把这些烂事留下来。\n“托里用罐头换来的那把剑还在。多亏它，我们活到了现在。听说它的原主人这次也上了战场，可不久前死了，因为不肯向天使战争中的老战友拔剑。哈，这回我倒能笑出来了，难不成我真的已经疯了？\n“该死的，外面又开始了。谁在打谁，我不知道，从来没知道过。\n“……*哥伦比亚俚语*，托里怎么还不回来？”\n\n【一段模糊晃动的影像】\n“——哈哈！*哥伦比亚俚语*！我们赢了，伙计，我们的战争终于把老天惹疯了！这是源石天灾，塔卫二的第一场源石天灾，独家首映！看啊，和泰拉多像！你看到了吗托里？！你应该在这儿的，和我一起，这片子会拿奖的，托里！给这片子取个名字吧托里！我想想……对！就叫它‘光荣*哥伦比亚俚语*记忆’！没错，没错，我们*哥伦比亚俚语*要拿奖了！！\n“哦快看，那座塔要倒了——完美的收尾镜头！恭喜，人类！”","weaponId","weaponPotentialSkill","sk_wpn_sword_0017","weaponSkillList",[52,53,49],"wpn_attr_agi_high","wpn_sp_attr_crirate_high","weaponType",1,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":55},"backpackCanDiscard",false,"decoDesc","熔炉要塞铸造的武器之一。造型典雅精致，常用于铁誓军的仪式场合而非前线搏杀，剑身经多重精磨，刃口锋锐至极。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",65,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,112,116,119,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,331,336,341,345,350,355,360,365,369,374,379,384,389,393,397,402,407,412,416,420,425,430,435,439,444,449,454,459,463,467,472,477,482,485,490,495,500,504,508],{"_100":101,"_102":103,"_104":87,"_105":55},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":87,"_105":108},54,2,{"_100":110,"_102":103,"_104":87,"_105":111},59,3,{"_100":113,"_102":114,"_104":87,"_105":115},64,20,4,{"_100":117,"_102":118,"_104":87,"_105":92},69,40,{"_100":120,"_102":101,"_104":87,"_105":42},74,{"_100":122,"_102":123,"_104":87,"_105":124},79,80,7,{"_100":126,"_102":127,"_104":87,"_105":128},84,110,8,{"_100":130,"_102":131,"_104":87,"_105":132},89,150,9,{"_100":134,"_102":135,"_104":103,"_10