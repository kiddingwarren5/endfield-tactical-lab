[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_760":761},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0013","slug","dreams-of-the-starry-beach","name","沧溟星梦","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_494":495,"_556":557},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_D_1","engName","Dreams of the Starry Beach","levelTemplateId","weapon_upgrade_curve_6star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0013.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","我也曾忧虑自己该去往何处。我这体格，首先就考虑去艾什柏环岛参加地下格斗。但我被那里的萧条景象给吓到了，我可不想在那儿度过我的余生。于是我就来到了菈梵朵玛，这可是座充满机会的大都市，无数大人物来到这里，联席会议、论坛、展会，这里应有尽有！\n…………\n一年过去了，我花光了全部身家，买了一辆车，在一位好心商人的帮助下改造成了移动餐厅，也就是现在这辆。毕竟在海边嘛，我就管它叫“船”，“船”停在哪儿，哪儿就是我的“码头”。我还找了一些人来帮我打下手，当时正好是黑曜石音乐节，到处都是游客，遍地都是金票。\n…………\n两年过去了，越来越多的人像我一样，开着辆小车，接待着往来的游客。唉，成也黑曜石音乐节，败也黑曜石音乐节……你们说，这楼是越盖越多，怎么我的顾客怎么反而变少了？那一年啊，我还看见有一个菲林，和当年的我一样，花光了所有身家，但最后什么都没了……\n…………\n三年过去了，我当时也不知道自己还能撑多久，收益越来越少。最气人的是，经常把车开到我对面的那个佩洛，居然还跑到我这儿来抢我的店员，跟他们说什么我很快就撑不下去了……气死我了。\n…………\n我开始收拾行李，反正“船”上只剩我一个，开走就能回老家。但就是那年，菈梵朵玛发生了一场海啸。灾难结束后，一支终末地的医疗救援队来了……你说终末地和我这家小店有什么关系？当然没关系咯，但在一天夜里，我听到他们在说什么，很漂亮，像星空一样。我出去一看，漆黑的海滩上散布着被海水吹过来的贝壳，其中一些散发着一缕缕幽光。我突然想起，以前的音乐节也能看到这种景象，那时候人还没有现在这么多。于是我便有了主意，第二天就把“船”给抵押了，搞了一批会发光的贝壳，再加点装饰品，对，和你手上那个一样。然后？然后这里的“码头”变多了，“船”也就好走咯。\n不瞒你说，我准备把这一块沙滩承包下来，对对，就你脚下这一片。然后把这些贝壳磨碎，搞个夜光海滩！名字我都想好了，叫“星砂海梦”。说不定下一次黑曜石音乐节的夜场就会选在我这里，到时候你们可一定要来捧场啊，我给你们打个折。\n那个佩洛？不就在那儿吗，我们现在可是合伙人。为什么选他？这座菈梵朵玛，不就是做生意的互帮互助，才有了现在的样子吗？","weaponId","weaponPotentialSkill","sk_wpn_funnel_0013","weaponSkillList",[51,52,48],"wpn_attr_wisd_high","wpn_sp_attr_heal_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_