[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_780":781},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0011","slug","seeker-of-dark-lung","name","探骊","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_B_1","engName","Seeker of Dark Lung","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0011.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","“实验数据还是对不上吗？”\n他垂着头，感觉到导师那审视的目光又一次沉重地打在了他身上。\n接着就是一声更重的叹息。\n“唉，子源，我记得你做这个‘息壤功率转换’的项目也已经三年了吧？”\n他点点头，低声补充了一句。\n“嗯，三年四个月零八天了。”\n“那你知道你隔壁组的师兄，还有和你一样是做息壤研究方向的明枢，他们手上的项目进度如何吗？”\n“……知道。”\n“那我也没什么能说的了，你自己……再好好考虑下吧。师生一场，我会帮你留一个转项目的名额的。”\n\n离开研究所的时候，天色已经不早，约莫是放学的时间，沿街时不时能看到几个小学徒结伴而行。\n而他只是像往常那样，沿着方兴衢往里走，在第二个拐角转弯，又走了七八步，才踏入这家铺面不大的面馆。\n“老板，一碗焖肉面，不要葱花。”\n他坐在最常坐的那个位置，点了自己最常吃的面，然后看着店主也像往常那样什么都没说，利落地下好一碗端上了桌。\n可才吃下第一口，他就皱了眉——只觉得面硬得不行，焖肉也腻了太多。\n“这味道……怎么变了这么多？换师傅了吗？”\n店主瞥了他一眼，笑了笑，难得接了话。\n“年轻人，我家的面从浇头到面条全是我自己做的，和你昨天吃的那碗也没什么区别。我看不是面的味道变了，是你吃面的心变了……既然都没心思吃这碗面，何必要来呢？”\n他先是沉默，随即摇摇头。\n“老人家，你不明白……我做了那么一件事整整三年，坚持了整整三年，所以到了该结束的时候，就算没了心思，我也不想缺了哪一环……况且，这面的味道确实不如昨天。”\n“哈，你这小子倒是嘴硬，分明是你自己舍不得，却还怪到我这面上了。”\n他苦笑，倒是没继续争辩下去。\n“就当是我舍不得吧，但我又能怎么办呢……\n“别人的项目才几个月就有了看得见的阶段成果，探了骊也得了珠，只有我……一个项目做了三年，还是不得其门而入……\n“再不换个项目，怕是就要自取其辱了。”\n也顾不上店主听不听得懂，他竟然一口气将从没敢在导师、组员面前说的苦水都吐完了。\n店主听了却敛了笑，认真地看向他。\n“所以，你只是因为没能‘得珠’，就想半途而废了？”\n“我……”他愣了愣，没能反驳。\n“看你的样子，应该也是学材料的……那这三年你还记得你积累了多少次实验经验？尝试过多少种替换方案？留下过多少卷参考数据吗？”\n“记得……353次、172种、561——不，算上最新一次，是562卷。”他有点艰难地说出了这么一串数字，忽然感觉心中一松。\n“你看，这么多的东西，难道不是只属于你的另一份珍宝吗？”\n“相较于最终结果，过程中积累的经验一样很重要吗……”\n他有些恍然，若有所思地感叹道。\n“说来惭愧，我当了快八年的天师学徒，竟然今天才因为您的这番话明白了这么简单的道理……真的是受教了。”\n店主却是摆了摆手，像是想起了什么往事，将目光投向望不见终点的远处。\n“客套话就免了，这里可没人爱听……我不过是见不得你这样的年轻人，明明还有很长的路能走，偏觉得自己走到了头。\n“不像我那几个学生，就算真走到了头，他们也敢不要命地朝前冲，硬生生给自己再闯出一条路来……”\n老人的嘴角不知何时带出了几分笑意，虽然很快就如面汤刚出锅时的热气那样散去了。\n“只是运气都不太好……十年前嬉皮笑脸地跟我说‘老师，等我们去把裂隙关了就回来交结业论文’的小混蛋们，最后一个都没回来……”\n\n“十年前……？您说的……莫非是……”\n\n“都是些陈芝麻烂谷子的伤心事……不提了！\n“唉，你小子傻愣在那儿干什么！还不快把这碗面吃了？\n“等面坨了，就真要变味儿咯！”","weaponId","weaponPotentialSkill","sk_wpn_claym_0011","weaponSkillList",[51,52,48],"wpn_attr_str_mid","wpn_sp_attr_usgs_mid","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","宏山选剑局研发的制式大剑。剑身使用了新型特种涂料，防护能力优良，即使处于极端恶劣环境下也能免受影响。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",22,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,110,114,117,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,183,187,192,197,202,207,212,217,222,226,231,236,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},46,2,{"_99":109,"_101":102,"_103":86,"_104":54},50,{"_99":111,"_101":112,"_103":86,"_104":113},54,20,4,{"_99":115,"_101":116,"_103":86,"_104":41},58,40,{"_99":118,"_101":109,"_103":86,"_104":119},62,6,{"_99":121,"_101":122,"_103":86,"_104":123},66