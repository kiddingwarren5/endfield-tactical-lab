[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_775":776},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_pistol_0007","slug","home-longing","name","望乡","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":42},"breakthroughTemplateId","weapon_breakthrough_456star_C_1","engName","Home Longing","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_pistol_0007.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“做些月饼吧。”我突然说。\n伊森明显愣了一下，但在他背后，沃尔科夫把酒瓶放下，猛地拍起大腿，顺着我的话喊了起来：“做月饼！朋友们！做月饼吧！”\n伊森先是扇了扇风，试图把空气中的酒味扇走，未果后索性放弃了。他向沃尔科夫提问，试图让他说出月饼到底是什么东西，以确定他没有喝醉，但不幸的是，沃尔科夫只能磕磕巴巴地重复着“是一种饼，我们乌萨斯工团也有饼”这样的醉话。于是他又看向我。\n“我是开……”\n“好。”\n我甚至没有把“玩笑”两个字说出口，伊森就表示了支持。他对炎国历史、习俗比我这个炎国人还了解，应该很清楚距离中秋节还有一个半月，所谓做月饼只是我随口说出的胡话。但此刻，我理解这个仿佛把全哥伦比亚的严肃性都汇聚在自己身上的男人为什么会陪着我们一起发疯。\n因为天使战争结束了。\n一段时间之前，战胜的消息突然从前线传到了我们这座通信哨站——管理员和四十位英雄冲进了极光壁，解决了敌人，人类终于从天使战争中解脱了出来。一开始我们并不相信这件事，但连续数日都仅有寥寥几个锚点飞过头顶，冲击哨站的天使也少得可怜，这些事实让我们意识到战争或许真的结束了。\n可惜的是，它没有这么容易从我们的心里离去。\n我们三个人似乎已经没有办法适应战争结束的生活，我会看着自己的断手发呆，沃尔科夫会偷喝防冻液，而伊森会写日记，但我瞥见过那些文字——死亡、战友、故乡……只有不成句的词在纸上堆砌。可这些词却能割伤我，很多年过去了，我从青涩的少年，到了如今的中年，侥幸还活着……那么，付出了怎样的代价，忘记了什么东西？我试着回忆尚蜀老宅的石阶，试着回忆中秋时祖父母制作月饼的步骤，试着回忆第一个死在我眼前的战友……这些早已模糊不堪。\n我忽然觉得做月饼这种想法无比可笑，塔卫二没有月亮，被称为月亮的是塔卫一，就算天师府的诸位同僚对着万年历将大炎的节日完全照搬到了塔卫二，又有什么用呢？月亮是假的，连二十四节气也对不上气候……这里不是我们的家，我们早已是没有归处的游魂。令我们恐惧的是塔卫二本身，在无数个噩梦中，有新的怪物从海中来，有新的怪物从星空中来，我们的昂扬壮志早就在向南撤退的行程中被碾得粉碎。\n“做些月饼吧。”但我仍在坚持。\n伊森用低筋面粉做了饼皮，我将能量棒碾碎，混上巧克力做成了馅料，沃尔科夫……他用源石技艺将水冻结成冰，勉强制成了模具。两小时后，我们围坐在一起，开始艰难地嚼食仅有一丝甜味和暖意的褐色面团，沃尔科夫表示原来正宗的月饼是这种味道，我想了想，把一些污言秽语压了下去。又过了两个小时，我仰面在雪地上醒来——防冻液确实不是什么人都能喝上几口的。“月亮”闯进我的眼睛，我忽然觉得苍白的塔卫一要比泰拉的月亮更明亮一些，可惜，有关故乡月亮的记忆也很模糊了。但这好像无伤大雅吧？防冻液中的醇对我窃窃私语。是啊，我回答它，我们已经拥有了新的月亮，在陌生的土地上，人类已站稳了脚跟。\n直至此时，我终于感受到了战争的离去，这颗星球仍令我恐惧，但我心中也有微小的希望萌发出来。我走回哨站，听着沃尔科夫和伊森聊起新收到的情报，难民营的小规模冲突，还有其他哨站也在悄悄交换节日祝福……战争离去，未知且庞大的塔卫二正等待着我们，从今往后，就是重新建设未来的时代，人类再一次拥有了希望，我如此相信。\n——耻辱战争爆发前夜，某位天师的日记","weaponId","weaponPotentialSkill","sk_wpn_pistol_0007","weaponSkillList",[52,53,49],"wpn_attr_agi_high","wpn_sp_attr_crystdam_high","weaponType","itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_41":42,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","宏山选剑局研发的铳械。为贴合宏科院武装力量的基本方针，在设计时特别减轻了重量，优化了持握手感。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",66,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,112,116,119,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,331,336,341,345,350,355,360,365,369,374,379,384,389,393,398,402,407,412,416,420,425,430,435,439,444,449,454,459,463,467,472,477,482,485,490,495,500,504,508],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":108},54,2,{"_100":110,"_102":103,"_104":86,"_105":111},59,3,{"_100":113,"_102":114,"_104":86,"_105":115},64,20,4,{"_100":117,"_102":118,"_104":86,"_105":91},69,40,{"_100":120,"_102":101,"_104":86,"_105":42},74,{"_100":122,"_102":123,"_104":86,"_105":124},79,80,7,{"_100":126,"_102":127,"_104":86,"_105":128},84,110,8,{"_100":130,"_102":131,"_104":86,"_105":132}