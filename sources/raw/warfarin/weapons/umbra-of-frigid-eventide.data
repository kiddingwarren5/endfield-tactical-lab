[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_806":807},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0019","slug","umbra-of-frigid-eventide","name","寒夜幽影","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_D_3","engName","Umbra of Frigid Eventide","levelTemplateId","weapon_upgrade_curve_6star_1.02","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0019.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","太阳还未升起。\n寒松部落的勇士已经苏醒，他手里捏着一只短粗的炭笔，笔下的纸只有巴掌大小。\n他想写的话有很多，一点纸也浪费不得，所以下笔谨慎，一边念，一边写。他尽量压低声，可还是吵醒了一旁的人。女人睁开仅剩的一只眼，狠狠踹了他一脚，冷酷地说：\n“闭嘴。”\n他哂笑几下，不敢做声，只能在心里默念：\n“母亲，冰已经融化，偶尔能看到苔藓，摸起来手感很好，很可爱。\n“我猜，你在的地方，春天已经到了，溪水从你的树屋下流过，灌溉花园中的植物。屋檐下，羽兽早已回来，在你打开窗时飞进屋，又落在你的掌心。\n“或许有一日，我也能像羽兽一样，去往你身边，然后留在你身边，留在永恒的春天，留在……”\n这个词母亲常年挂在嘴边，他记住了却不知道怎么拼，只能停笔，无奈地看向女人，面露恳求。\n女人不耐的语气下藏着好奇：“怎么不写了？”\n“有个词不会拼？”\n“什么词不会拼？”\n“安、安心之处。”\n“没学过吗？”\n“妈妈还没来得及教我，我们就分开了。”\n“哦……”\n女人拉长尾音，似乎有些懊恼。然后她抬起手，在空中比划，圆润的弧度和笔直的线条交织，像一只羽兽掠过天空留下的尾迹。\n第一遍很快，勇士倦怠的双眼甚至捕捉不到那指尖。看到他纠在一起的眉毛，女人嗤笑，然后在空中比划起第二遍。\n勇士的笔、女人的手、纸上的线、空中的形，一起勾勒出一个词，缓缓而就，落笔清晰，像一只羽兽从天空慢慢落下。\n举起满满的纸，勇士满意地笑笑，然后把它递向篝火，灼烧声响起，一颗火光在女人眼中闪了闪，又在眼角熄灭。\n“觉得寄不到吗？”\n勇士点点头，女人了然叹气，沉默半晌，又突然出声。\n“孩子，你叫什么？”\n“比约恩，来自寒松部落。”\n女人陷入回忆，断断续续道：“寒松部落……哦，我记得你们的族长……勇猛的女人，战死时无愧勇士之名，令人敬佩。”\n“有她陪伴我长大，我很幸运。”勇士感激地朝她点头，面色涨红。\n“愿她回到萨米身边，去往永恒的春天，去往……”\n“安心之处。”\n对上女人的笑脸，勇士与她一起念出那个词。\n太阳还未升起，号角已经响起，天使出现在天边，浩浩荡荡向此地迈进。\n寒松部落的勇士已经站起，他捡起地上的长矛，又搀起女人，与士兵一起，迎向天使潮群。\n他们身后，火焰悄悄蚕食纸张，然后吐出几颗火星，飘向远方。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0019","weaponSkillList",[51,52,48],"wpn_attr_agi_high","wpn_sp_attr_atk_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_