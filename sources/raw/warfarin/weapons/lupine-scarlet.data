[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_792":793},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0022","slug","lupine-scarlet","name","狼之绯","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_1","engName","Lupine Scarlet","levelTemplateId","weapon_upgrade_curve_6star_1.02","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0022.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","男人走进来，接着用迅雷不及掩耳的速度将简易营房的大门关上。这扇门只来得及发出较短促的一声惨叫，便不甘心地合了起来，将寒风挡在了外面。他左右看看，长出一口气，隔间里的女儿没有被吵醒——小姑娘今年四岁，狼群所有幼崽里，她是最难哄睡的那一个。\n妻子在整理武器，瞄准镜、施术单元被拆开，铺满了一桌子，门被关上时，她正全神贯注地打磨一把短刃。\n“给武器架做扫除？”\n男人坐在桌子对面，随手用匕首撬开一个兽肉军粮罐头，它被加热过，现在温度刚好适合入口。\n“我的猜测不会出错，亲爱的，很快你就会用到这些东西了，难道不是吗？”\n“实际上我是想和你开个玩笑，和你说‘你有关狩猎会议的判断完全错误了’的，可惜的是，那些老狼嘴里说出来的话，简直像是在你这里提前背过剧本……我赌输了，接下来的一周我来哄宝贝睡觉……但你知道，我输得不算甘心。”\n女人将磨好的刀抛给丈夫，示意他挥砍几下试试手感，接着她拿起一把铳，开始装填子弹。\n“狼群和雅各布的观点本就不合，裂地者出现内部分裂是早晚的事……如果不再是‘朋友’，那么就只剩下一种关系——猎人和猎物……猎杀他们，喂饱我们，同类相食。”\n“同类相食……这个词我喜欢，就像老路易在开会时说的，‘文明环带收紧了扼在裂地者脖子上的手，狼不能因此而死，就让我们尝尝朋友的血肉是否香甜吧’……哈哈，老东西文绉绉的。”\n“所以目标是？”\n“碾骨。他们太喜欢雅各布了，狂热得让我有点恶心。”\n“你的任务呢？”\n“估计是破坏他们的巢雕？我们趁今晚劫走他们的物资，快去快回，没人知道是狼群动的手，半小时后出发，甚至来得及吃第二天的早饭。”\n“记得和女儿道别。”\n“……别叫醒她了吧。”\n“你确定吗？”\n“我确定，这任务也没什么危险……”\n“砰”的一声。\n男人看着妻子将铳械拍在桌子上，看着她冰冷的眼神，看着没装完的子弹滚过桌面，掉在地上，向角落滚去，他知道，妻子已看穿了他的谎言。\n“不要骗我。”\n“我可没……”\n“你们会议真正的内容并不难猜……雅各布和文明环带的谈判破裂了，他和他的死忠会被碾碎……你们想要做的事只有一件……在这场动荡里保全狼群。”\n女人深深地呼出一口气。\n“狼会杀死狼，氏族内部会有一场清洗，那些认同雅各布的人会被除掉，甚至那些因劫掠、杀戮而在文明环带‘留名’的狼也会流干血液，死在荒野上。不止于此，你们中有些人会真的被派去袭击其他氏族，光明正大地袭击，这会是一个信号，文明环带会知道最佳的进攻时机已至，也会知道狼群与其他裂地者道路不同……你们想要加快裂地者的覆灭……一些人故意走上死路，借此换来氏族的延续。”\n“你是怎么猜到的？”\n“我杀过的人远比你多，亲爱的，死亡正在你眼睛里流淌。”\n“但我并不惧怕它……或许等我闭上眼睛，就能看到爷爷在故乡，在叙拉古的庄园里等我……我会和他说，我把妻子、女儿还有其他幼狼保护得很好，我还会和他说，我们的血脉得以延续了，无论是在丰茂的草场中奔跑，还是在城市的暗巷中清点金票，甚至完全拥抱塔卫二，用氏族的名字洗去家族的名字……无论什么活法，一切都会由狼群自己来选……”\n“我和你一起去。”\n“不可能，我选择死亡，选择加入这场狩猎，就是为了让你们能活着，哪怕是忘记故乡，抛弃家族，你们也要活下去，我……”\n男人无法再说下去了，在他眼前不远处，一只小小的手掌张开着，掌心处是刚刚滚落的那颗子弹。\n“爸爸，打猎加油……”\n醒来的女儿明显只听到了谈话的一部分，但这已经足够。计划中的不告而别，在寒风之中徘徊许久才坚定下来的信念被激励的话语轻轻击碎。他从死亡的大河中猛地抽身出来。\n“我……”\n“血脉将我们相连，因此它才得以延续，不是吗？”\n柔软的手，小小的手，粗粝的手，握在一起。\n“在幼狼们能自由奔行于荒野之前，没有人能杀死我们，没有任何人。”","weaponId","weaponPotentialSkill","sk_wpn_sword_0022","weaponSkillList",[51,52,48],"wpn_attr_agi_high","wpn_sp_attr_crirate_high","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":54},"backpackCanDiscard",false,"decoDesc","雷神工业生产的热销款长剑，经黑市渠道行销文明环带之外，在裂地者中颇受欢迎，不少人都会为它增加特殊改装模块。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",63,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,267,272,276,281,286,291,295,300,305,310,315,320,324,328,333,338,343,348,352,357,362,367,372,376,381,385,390,395,399,404,409,414,418,422,427,432,437,442,447,451,456,461,465,470,474,479,484,489,494,497,502,506],{"_99":100,"_101":102,"_103":86,"_104":54},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},56,2,{"_99":109,"_101":102,"_103":86,"_104":110},61,3,{"_99":112,"_101":113,"_103":86,"_104":114},66,20,4,{"_99":116,"_101":117,"_103":86,"_104":9