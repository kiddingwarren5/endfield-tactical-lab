[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_766":767},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0004","slug","exemplar","name","典范","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_1","engName","Exemplar","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0004.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","我没法认同亨利的想法。\n雷神工业的产品一直沉浸在那套实用主义说辞当中，这显然只是自我逃避。形式是传统的积累，是经验的总和，自然赋予了人们趋利避害的直观感触，典雅与融洽本身就是茫茫历史对何为完美的无声回答。\n就算是为了向他们证明这一点，我也一定要拿下这次竞标。\n\n我有九种办法达到目标破坏效果，但哪种都不应该出现在这个尺寸的武器上。\n听说亨利打算试试爆燃脉冲，可笑。那得是一把剑，客户可没答应咱们给大炮安个握柄。\n\n参数不合格。\n亨利找我聊了一会儿，他们似乎也束手无策。不知道客户看见两家竞标企业的设计师凑在一块聊天会是什么感想。\n\n指标定得太高了，老板怎么会同意这种要求？\n就算那位老兄直接提着样品去了总部，只想要个一模一样的，那也是怪家伙们挖出来的怪东西。该想的不应该是丢不丢脸，而是会不会丢命吧？\n\n洗澡的时候灵光乍现，顺利满足了最低要求。唱歌果然有用。\n一口气劈断四层装甲车的核心装甲板，我不相信雷神工业能给出比这更好的方案。物理学是有极限的，不管我们之间存在多少异见，至少都应该认识到这一点。\n\n寂语修会顺利重启了那件样品。\n十六层。等抢修完天花板，他们似乎打算试试三十二层。\n沿对角线斜着劈。\n我还是找领导再商量商量吧。","weaponId","weaponPotentialSkill","sk_wpn_claym_0004","weaponSkillList",[51,52,48],"wpn_attr_main_high","wpn_sp_attr_atk_high","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","梅什科工业最新推出的独立产品。据传这款设计源于寂语修会的发掘产物，内含绝密技术，分金裂石，无坚不摧。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainW