[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_804":805},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0017","slug","amaranthine-tassel","name","赤缨","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_D_1","engName","Amaranthine Tassel","levelTemplateId","weapon_upgrade_curve_6star_1.03","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0017.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“武人爱好锻造金铁，犹可称得上风雅；而让无心争斗的匠人挥剑，只能说是一个错误。时也，命也。”\n老师晚年说这话时，总会盯着那张未完成的大剑图纸。我知道，那是他又想起了师兄。\n那张图纸，老师、师姐与师兄在上面倾注了七年心血。七年间，老师的两鬓从点点星霜化作斑白，师兄由意气风发变得沉默寡言，唯有师姐仍旧每日笑盈盈的，如春日暖风。按原本的进度，只要待师兄补上剑镡结构的设计，原型图纸便可送交评审，我们笃定，它会成为典范之作。\n然而，直到他们的名字从选剑局的名录中消失，那一日都还没有到来。\n那个秋天，师兄和师姐作为技术人员被派往前线，负责交付一批武器装备。此行一路凶险，师兄本不愿前往——他热爱锻冶、机括、炽热的金属与叮当作响的车床，却唯独缺乏挥剑厮杀的天赋。几乎无人见过他真正使用兵器。\n但既然师姐答应了，师兄便放下手里尚未完成的图纸，随她一同北行。那一趟走了很久，直至宏山落雪，师兄才独自归来。而师姐……被永远埋葬在了那座天使出没的深谷里。\n此后，师兄总说他做了一个梦——山道狭窄，朔风如刀，天使的长角刺穿师姐的胸膛，他脚下散落着自己亲手锻造的锋刃，却没有一件能握在手里，保护身边的人。\n师兄再也没有提笔完成原型的设计。数月后，他悄然离开了选剑局。\n我们不是没找过他，尤其是老师——他追着传言里师兄出现的地方，但总是落空。后来病痛侵蚀了他的身躯，他再也无力远行。临终时，他干枯的手仍攥着那张未完成的图纸——三人的笔迹清晰，却唯独在剑镡那一块留了白。\n后来，我们陆陆续续听说过一些疑似是师兄的消息。有人说，在菈梵朵玛看到了一个酷似他的酒保，每逢夜深便自己先喝得烂醉如泥，直到被每一间酒吧都赶了出去。有人说，看到他在艾什柏环岛登上拳台，结果被不耐烦的对手一把扔飞了出去。有人说，在特里格拉夫的轨道上曾横卧着一个流浪汉，留着长长的头发，指甲里嵌满泥土和污垢，杜林工人将他搬开时，衣角露出了一个炎国风格的红丝绳结……\n所幸，那些都不是他。\n一个红叶飘落的傍晚，师兄回来了。\n若不是身上的旧衣服，我们几乎认不出他。他瘦得骇人，颧骨高耸，眼如死水，目光转动起来却如同剜刀一般。他是从北边的前线回来的。这么多年里，他没有如愿成为一个强大的战士，只是变成了个为伤痛所困的普通军人。这次，他要了间小屋，让我们从库房找出积满灰尘的图纸，交到他手里。\n刚开始，他画得很吃力，几年里留下的旧伤让他握笔的手不住颤抖。我只能按住他的胳膊，让线条一笔一画重新落到纸上。不一会儿，他便汗流浃背。但他没有停下来，仿佛害怕自己第二天就会不在人世一般，直到深夜都还不停地画，不停地写。\n十天过去了，师兄补上了设计图的空白。一年后，那款大剑正式量产——长五尺一寸，宽八寸有余，重七十九斤，一击便足以粉碎天使，被誉为选剑局近十年来最成功的作品之一。\n师兄没有接受任何相关的褒奖。在完成了设计之后，他就回到了北边，再也没有回来。我们收到过一封以铁誓军名义订购那款大剑的来函，依稀是师兄的字迹。之后，他就牺牲在了那场被写入史册的战役之中。","weaponId","weaponPotentialSkill","sk_wpn_claym_0017","weaponSkillList",[51,52,48],"wpn_attr_str_high","wpn_sp_attr_atk_high","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","宏山选剑局积十余年之功设计、制作的大剑。规制严整，挥舞起来刚猛至极，是重型兵刃的典范之作。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",71,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,109,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,331,335,340,345,349,354,358,363,368,373,378,382,387,392,397,402,406,411,416,420,424,428,433,438,443,448,452,457,462,466,471,475,480,485,490,495,500,503,508],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",52,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":108},57,2,{"_100":110,"_102":103,"_104":86,"_105":54},62,{"_100":112,"_102":113,"_104":86,"_105":114},67,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},72,40,{"_100":119,"_102":120,"_104":86,"_105":41},77,50,{"_100":122,"_102":123,"_104":86,"_105":124},82,80,7,{"_100":126,"_102":127,"_104":86,"_105":128},88,110,8,{"_100":130,"_102":131,"_104":86,"_105":132},93,150,9,{"_100":134,"_102":135,"_104":103,"_105":103},98,200,{"_100":137,"_102":138,"_104":103,"_105":139},103,