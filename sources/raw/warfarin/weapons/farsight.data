[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_776":777},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0026","slug","farsight","name","遥望","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_C_3","engName","Farsight","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0026.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","这片大地或许也没什么特别的。\n一样的草原、一样的空气、一样的海洋，除了那个在白天也清晰可见的大天体和晚上没有双月陪伴外，这里的生活与泰拉并没有什么不同。\n这是一件好事吗？我不知道。\n国家征召了我，于是我便来了。只为领份工钱好糊口，仅此而已。\n\n可时间一长，我确实能感觉到一些变化。\n这片大地没有源石，国家之间的界限也很模糊，我本以为是哥伦比亚式的拓荒，在荒地上累死累活吃口饱饭。但今天，一位莱塔尼亚高塔贵族模样的人居然向我这个工人打听零件规格和设备操作的问题。\n他是认真的。\n“乌萨斯人”“莱塔尼亚人”“哥伦比亚人”……所有曾经分割我们的前缀被减缩成了“兄弟姐妹”与“朋友”。\n这当然是件大好事！可为什么会变成这样，我不太明白。\n于是我问了许多人，但他们都有同样的疑惑，我也就没能得到答案。直到——\n\n“什么是终末地？”\n在我入职的第一天，我向我那健壮的萨卡兹组长抛出了这个问题，在我看来，作为一个开拓组织，这个名字似乎不太吉利。\n他没说什么，只是带着我们去了这艘暂时用作终末地总部的舰船顶端，让我们看看这颗星球，这个世界。\n“星球”“世界”……他用了些偏门的词汇。\n组长听出了我的疑问，然后笑着告诉我们这就是终末地的意义。\n“是因为我们要用些新词吗？”\n“是因为我们把过去留在了泰拉。”\n\n或许他是正确的。\n在决定穿过星门来到这里时，我、我们就都把一些东西永远留在了泰拉。\n那些在矿井中挣扎的人，在荒野中奔驰的人，在城市中工作的人，在高塔上演奏的人……最终都站在了这艘舰船上，肩并着肩，一同创造未来。\n命运给了我们选择，而我们选择了与过去不同的、继续生活的方式。\n\n这个世界是什么样的？我还没有答案。\n因为我们正在建设它。\n当建筑拔地而起，当作物破土而出。\n它便是我们最有力的回答。","weaponId","weaponPotentialSkill","sk_wpn_sword_0026","weaponSkillList",[51,52,48],"wpn_attr_main_high","wpn_sp_attr_phy_spell_high","weaponType",1,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":54},"backpackCanDiscard",false,"decoDesc","终末地工业探索武器规格时制作的范本之一。以通用为目的，投入高端素材完成的全能武器，承载着武库干员们对于终末地的理想。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_activity","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",77,5,"valuableDepotRedDot","valuableTabType","weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,330,335,340,345,350,354,359,364,369,374,378,383,388,393,398,402,407,412,417,421,425,430,435,440,445,449,453,458,463,467,471,475,480,485,490,493,498,502,507],{"_99":100,"_101":102,"_103":86,"_104":54},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},56,2,{"_99":109,"_101":102,"_103":86,"_104":110},61,3,{"_99":112,"_101":113,"_103":86,"_104":114},66,20,4,{"_99":116,"_101":117,"_103":86,"_104":91},71,40,{"_99":119,"_101":120,"_103":86,"_104":41},76,50,{"_99":122,"_101":123,"_103":86,"_104":124},81,80,7,{"_99":126,"_101":127,"_103":86,"_104":128},86,110,8,{"_99":130,"_101":131,"_103":86,"_104":132},91,150,9,{"_99":134,"_101":135,"_103":102,"_104":102},96,200,{"_99":137,"_101":138,"_103":102,"_104":139},101,270,11,{"_99":141,"_101":142,"_103":102,"_104":143},106,370,12,{"_99":145,"_101":146,"_103":113,"_104":147},111,480,13,{"_99":149,"_101":150,"_103":151,"_104":152},116,620,30,14,{"_99":154,"_101":155,"_103":120,"_104":156},121,780,15,{"_99":158,"_101":159,"_103":160,"_104":161},126,990,70,16,{"_99":163,"_101":164,"_103":165,"_104":166},131,1250,100,17,{"_99":168,"_101":169,"_103":170,"_104":171},136,1550,140,18,{"_99":173,"_101":174,"_103":135,"_104":175},141,1900,19,{"_99":177,"_101":178,"_103":179,"