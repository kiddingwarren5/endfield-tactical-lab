,"_799":1278,"_802":1279},[801,801,801],[1280,1280,1280],"<color=#FFCC00>","scene_grade.down",{"_15":1281,"_799":1283,"_802":1284},[801,801,801],[1285,1285,1285],"<color=#D12E42>","set.key",{"_15":1286,"_799":1288,"_802":1289},[801,801,801],[1290,1290,1290],"<color=#A7A7A7>","tech.get",{"_15":1291,"_799":1293,"_802":1294},[801,801,801],[1295,1295,1295],"<color=#1e1e1e>","tips.key",{"_15":1296,"_799":1298,"_802":1299},[801,801,801],[1300,1301,1300],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1302,"_799":1304,"_802":1305},[801,801,801],[1089,1090,1091],"toast_focal.key",{"_15":1306,"_799":1308,"_802":1309},[801,801,801],[1301,1301,1301],"weapon.stress",{"_15":1310,"_799":1312,"_802":1313},[801,801,801],[1314,1314,1314],"<color=#fe5a00>","weekraid.key",{"_15":1315,"_799":1317,"_802":1318},[958,958,958],[1319,1319,1320],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_1323":1324,"_1330":1331,"_1012":1335,"_1340":1341,"_1344":1345,"_1349":1350,"_1353":1354,"_1358":1359,"_1362":1363,"_1367":1368,"_1371":1372,"_827":1376,"_1381":1382,"_1385":1386,"_1390":1391,"_1395":1396,"_1399":1400,"_1404":1405,"_910":1408,"_1413":1414,"_1417":1418,"_1423":1424,"_916":1427,"_1432":1433,"_1436":1437,"_934":1441,"_1446":1447,"_1450":1451,"_941":1455,"_1460":1461,"_1466":1467,"_965":1471,"_1476":1477,"_1481":1482,"_1486":1487,"_1491":1492,"_972":1496,"_1500":1501,"_1505":1506,"_1510":1511,"_1514":1515,"_1520":1521,"_1525":1526,"_1002":1530,"_1535":1536,"_1540":1541,"_1543":1544,"_1547":1548,"_1552":1553,"_1556":1557,"_1562":1563,"_1566":1567,"_1571":1572,"_1576":1577,"_1019":1581,"_1585":1586,"_1588":1589,"_1039":1593,"_1597":1598,"_1602":1603,"_1607":1608,"_1612":1613,"_1616":1617,"_1621":1622,"_839":1627,"_878":1631,"_1636":1637,"_1641":1642,"_1646":1647,"_1065":1651,"_1656":1657,"_1659":1660,"_1663":1664,"_1667":1668,"_1672":1673,"_1677":1678,"_1681":1682,"_1686":1687,"_1105":1691,"_1695":1696,"_1700":1701,"_1705":1706,"_1710":1711,"_1714":1715,"_1718":1719,"_1723":1724,"_1728":1729,"_1732":1733,"_1738":1739,"_1742":1743,"_1746":1747,"_1751":1752,"_1755":1756,"_1759":1760,"_1763":1764,"_1769":1770,"_1774":1775,"_1779":1780,"_1784":1785,"_1789":1790,"_1794":1795,"_1799":1800,"_1804":1805,"_1809":1810,"_1814":1815,"_1819":1820,"_1824":1825,"_1829":1830,"_1834":1835},"adv.electricFence",{"_61":1325,"_1326":64,"_15":1323,"_1327":64,"_19":1328,"_1329":895},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_61":1332,"_1326":1333,"_15":1330,"_1327":64,"_19":1334,"_1329":948},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_61":1336,"_1326":1337,"_15":1012,"_1327":1338,"_19":1339,"_1329":1077},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_61":1342,"_1326":64,"_15":1340,"_1327":64,"_19":1343,"_1329":895},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_61":1346,"_1326":1347,"_15":1344,"_1327":64,"_19":1348,"_1329":895},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_61":1351,"_1326":64,"_15":1349,"_1327":64,"_19":1352,"_1329":895},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_61":1355,"_1326":1356,"_15":1353,"_1327":64,"_19":1357,"_1329":989},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_61":1360,"_1326":64,"_15":1358,"_1327":64,"_19":1361,"_1329":895},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_61":1364,"_1326":1365,"_15":1362,"_1327":64,"_19":1366,"_1329":895},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_61":1369,"_1326":64,"_15":1367,"_1327":64,"_19":1370,"_1329":64},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_61":1373,"_1326":1374,"_15":1371,"_1327":64,"_19":1375,"_1329":948},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_61":1377,"_1326":1378,"_15":827,"_1327":1379,"_19":1380,"_1329":1077},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_61":1383,"_1326":64,"_15":1381,"_1327":64,"_19":1384,"_1329":895},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_61":1387,"_1326":1388,"_15":1385,"_1327":64,"_19":1389,"_1329":895},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_61":1392,"_1326":1393,"_15":1390,"_1327":64,"_19":1394,"_1329":895},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_61":1397,"_1326":64,"_15":1395,"_1327":64,"_19":1398,"_1329":922},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_61":1401,"_1326":1402,"_15":1399,"_1327":64,"_19":1403,"_1329":895},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_61":1406,"_1326":64,"_15":1404,"_1327":64,"_19":1407,"_1329":922},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_61":1409,"_1326":1410,"_15":910,"_1327":1411,"_19":1412,"_1329":989},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_61":1415,"_1326":1410,"_15":1413,"_1327":64,"_19":1416,"_1329":989},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_61":1419,"_1326":1420,"_15":1417,"_1327":1421,"_19":1422,"_1329":922},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_61":1425,"_1326":64,"_15":1423,"_1327":64,"_19":1426,"_1329":922},"持续时间内，受影响的目标暂停行动。","定身",{"_61":1428,"_1326":1429,"_15":916,"_1327":1430,"_19":1431,"_1329":1101},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_61":1434,"_1326":1429,"_15":1432,"_1327":64,"_19":1435,"_1329":1101},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_61":1438,"_1326":64,"_15":1436,"_1327":1439,"_19":1440,"_1329":64},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_61":1442,"_1326":1443,"_15":934,"_1327":1444,"_19":1445,"_1329":1051},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_61":1448,"_1326":1443,"_15":1446,"_1327":64,"_19":1449,"_1329":1051},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_61":1452,"_1326":1453,"_15":1450,"_1327":64,"_19":1454,"_1329":895},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_61":1456,"_1326":1457,"_15":941,"_1327":1458,"_19":1459,"_1329":1077},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_61":1462,"_1326":1463,"_15":1460,"_1327":1464,"_19":1465,"_1329":922},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_61":1468,"_1326":1469,"_15":1466,"_1327":64,"_19":1470,"_1329":922},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_61":1472,"_1326":1473,"_15":965,"_1327":1474,"_19":1475,"_1329":948},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_61":1478,"_1326":64,"_15":1476,"_1327":1479,"_19":1480,"_1329":948},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_61":1483,"_1326":1484,"_15":1481,"_1327":64,"_19":1485,"_1329":895},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_61":1488,"_1326":1489,"_15":1486,"_1327":64,"_19":1490,"_1329":895},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_61":1493,"_1326":1494,"_15":1491,"_1327":64,"_19":1495,"_1329":948},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_61":1497,"_1326":1333,"_15":972,"_1327":1498,"_19":1499,"_1329":948},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_61":1502,"_1326":64,"_15":1500,"_1327":1503,"_19":1504,"_1329":922},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_61":1507,"_1326":1508,"_15":1505,"_1327":64,"_19":1509,"_1329":895},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_61":1512,"_1326":64,"_15":1510,"_1327":64,"_19":1513,"_1329":64},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_61":1516,"_1326":1517,"_15":1514,"_1327":1518,"_19":1519,"_1329":922},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_61":1522,"_1326":1523,"_15":1520,"_1327":64,"_19":1524,"_1329":895},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_61":1527,"_1326":64,"_15":1525,"_1327":1528,"_19":1529,"_1329":989},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_61":1531,"_1326":1532,"_15":1002,"_1327":1533,"_19":1534,"_1329":989},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_61":1537,"_1326":1538,"_15":1535,"_1327":64,"_19":1539,"_1329":895},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_61":1415,"_1326":1532,"_15":1540,"_1327":64,"_19":1542,"_1329":989},"干员受到灼热附着","sys.tacticalItem",{"_61":1545,"_1326":64,"_15":1543,"_1327":64,"_19":1546,"_1329":895},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_61":1549,"_1326":1550,"_15":1547,"_1327":64,"_19":1551,"_1329":989},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_61":1434,"_1326":1554,"_15":1552,"_1327":64,"_19":1555,"_1329":1101},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_61":1558,"_1326":1559,"_15":1556,"_1327":1560,"_19":1561,"_1329":922},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_61":1564,"_1326":64,"_15":1562,"_1327":64,"_19":1565,"_1329":922},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_61":1568,"_1326":1569,"_15":1566,"_1327":64,"_19":1570,"_1329":1077},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_61":1573,"_1326":1574,"_15":1571,"_1327":64,"_19":1575,"_1329":1101},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_61":1578,"_1326":1579,"_15":1576,"_1327":64,"_19":1580,"_1329":922},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_61":1582,"_1326":1583,"_15":1019,"_1327":1474,"_19":1584,"_1329":948},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_61":1332,"_1326":1583,"_15":1585,"_1327":64,"_19":1587,"_1329":948},"干员受到冻结","ba.naturalvul",{"_61":1590,"_1326":1591,"_15":1588,"_1327":64,"_19":1592,"_1329":1051},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_61":1377,"_1326":1594,"_15":1039,"_1327":1595,"_19":1596,"_1329":1077},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_61":1599,"_1326":1600,"_15":1597,"_1327":64,"_19":1601,"_1329":895},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_61":1604,"_1326":1605,"_15":1602,"_1327":64,"_19":1606,"_1329":895},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_61":1609,"_1326":1610,"_15":1607,"_1327":64,"_19":1611,"_1329":895},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_61":1614,"_1326":64,"_15":1612,"_1327":64,"_19":1615,"_1329":895},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_61":1618,"_1326":64,"_15":1616,"_1327":1619,"_19":1620,"_1329":64},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_61":1623,"_1326":1624,"_15":1621,"_1327":1625,"_19":1626,"_1329":922},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_61":1628,"_1326":64,"_15":839,"_1327":1629,"_19":1630,"_1329":1051},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_61":1632,"_1326":1633,"_15":878,"_1327":1634,"_19":1635,"_1329":1077},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_61":1638,"_1326":1639,"_15":1636,"_1327":64,"_19":1640,"_1329":895},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_61":1643,"_1326":1644,"_15":1641,"_1327":64,"_19":1645,"_1329":1051},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_61":1648,"_1326":1649,"_15":1646,"_1327":64,"_19":1650,"_1329":895},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_61":1652,"_1326":1653,"_15":1065,"_1327":1654,"_19":1655,"_1329":1051},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_61":1448,"_1326":1653,"_15":1656,"_1327":64,"_19":1658,"_1329":1051},"干员受到自然附着","ba.originium",{"_61":1661,"_1326":64,"_15":1659,"_1327":64,"_19":1662,"_1329":922},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_61":1665,"_1326":64,"_15":1663,"_1327":64,"_19":1666,"_1329":1077},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_61":1669,"_1326":1670,"_15":1667,"_1327":64,"_19":1671,"_1329":1077},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_61":1674,"_1326":64,"_15":1672,"_1327":1675,"_19":1676,"_1329":1085},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_61":1679,"_1326":64,"_15":1677,"_1327":64,"_19":1680,"_1329":895},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_61":1683,"_1326":64,"_15":1681,"_1327":1684,"_19":1685,"_1329":1101},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_61":1688,"_1326":1689,"_15":1686,"_1327":64,"_19":1690,"_1329":895},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_61":1692,"_1326":1554,"_15":1105,"_1327":1693,"_19":1694,"_1329":1101},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_61":1697,"_1326":1698,"_15":1695,"_1327":64,"_19":1699,"_1329":1101},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_61":1702,"_1326":64,"_15":1700,"_1327":1703,"_19":1704,"_1329":922},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_61":1707,"_1326":64,"_15":1705,"_1327":1708,"_19":1709,"_1329":64},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_61":1712,"_1326":64,"_15":1710,"_1327":64,"_19":1713,"_1329":895},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_61":1716,"_1326":64,"_15":1714,"_1327":64,"_19":1717,"_1329":922},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_61":1720,"_1326":1721,"_15":1718,"_1327":64,"_19":1722,"_1329":895},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_61":1725,"_1326":64,"_15":1723,"_1327":1726,"_19":1727,"_1329":922},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_61":1730,"_1326":64,"_15":1728,"_1327":64,"_19":1731,"_1329":895},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_61":1734,"_1326":1735,"_15":1732,"_1327":1736,"_19":1737,"_1329":922},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_61":1740,"_1326":64,"_15":1738,"_1327":64,"_19":1741,"_1329":922},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_61":1744,"_1326":64,"_15":1742,"_1327":64,"_19":1745,"_1329":922},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_61":1748,"_1326":1749,"_15":1746,"_1327":64,"_19":1750,"_1329":895},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_61":1753,"_1326":64,"_15":1751,"_1327":64,"_19":1754,"_1329":922},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_61":1757,"_1326":64,"_15":1755,"_1327":64,"_19":1758,"_1329":922},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_61":1761,"_1326":64,"_15":1759,"_1327":64,"_19":1762,"_1329":922},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_61":1765,"_1326":1766,"_15":1763,"_1327":1767,"_19":1768,"_1329":922},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_61":1771,"_1326":1772,"_15":1769,"_1327":64,"_19":1773,"_1329":895},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_61":1776,"_1326":1777,"_15":1774,"_1327":64,"_19":1778,"_1329":895},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_61":1781,"_1326":1782,"_15":1779,"_1327":64,"_19":1783,"_1329":895},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_61":1786,"_1326":1787,"_15":1784,"_1327":64,"_19":1788,"_1329":895},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_61":1791,"_1326":1792,"_15":1789,"_1327":64,"_19":1793,"_1329":895},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_61":1796,"_1326":1797,"_15":1794,"_1327":64,"_19":1798,"_1329":895},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_61":1801,"_1326":1802,"_15":1799,"_1327":64,"_19":1803,"_1329":895},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_61":1806,"_1326":1807,"_15":1804,"_1327":64,"_19":1808,"_1329":895},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_61":1811,"_1326":1812,"_15":1809,"_1327":64,"_19":1813,"_1329":895},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_61":1816,"_1326":1817,"_15":1814,"_1327":64,"_19":1818,"_1329":895},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_61":1821,"_1326":1822,"_15":1819,"_1327":64,"_19":1823,"_1329":895},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_61":1826,"_1326":1827,"_15":1824,"_1327":64,"_19":1828,"_1329":895},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_61":1831,"_1326":1832,"_15":1829,"_1327":64,"_19":1833,"_1329":895},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_61":1836,"_1326":1837,"_15":1834,"_1327":64,"_19":1838,"_1329":895},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维",{"_516":1840,"_531":1842,"_541":1844,"_550":1846,"_552":1848,"_562":1850,"_564":1852,"_1854":1855},{"_15":516,"_65":516,"_19":1841,"_40":110},"强固模具",{"_15":531,"_65":531,"_19":1843,"_40":114},"轻黯石",{"_15":541,"_65":541,"_19":1845,"_40":114},"中黯石",{"_15":550,"_65":550,"_19":1847,"_40":114},"重型强固模具",{"_15":552,"_65":552,"_19":1849,"_40":114},"重黯石",{"_15":562,"_65":562,"_19":1851,"_40":91},"快子遴捡晶格",{"_15":564,"_65":564,"_19":1853,"_40":91},"协议纹石","item_gold",{"_15":1854,"_65":1854,"_19":1856,"_40":114},"折金票"]
