[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_761":762},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_pistol_0004","slug","rational-farewell","name","理性告别","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_1","engName","Rational Farewell","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_pistol_0004.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","“所以我们算是困在这里了，我和你，一个雷神工业冉冉升起的新星流水线工人，和一个经验老到，面容坚毅的工团……呃……老哥你是做什么的？”\n“武器，我给铳械加装最后的源石保险机构。”\n“好，那就是一个高手武器匠。总之我们被困在这儿了，被一场侵蚀带来的道路阻断困着，等咱们脱困，我要把这段故事讲给所有工友听……哎，你这绷带绑得可真是好，要是我一个人在这儿，可没办法处理自己的手指骨折问题。”\n“你驻扎在荒野，不学一些急救知识？”\n“初来乍到没有经验嘛，哈哈，我本以为我不会出外勤，但谁让人手紧张，跟车这种工作也被我抽中了呢。我和你说，离家之前我攒了半年的工资，一大卷钞票，这么大一卷，我用它买了三年的综合保险以及近文明环带区域应急救援保险，结果，哎呀，屁用没有……嗯？你怎么看起来很茫然？”\n“抱歉，想到了一些小事，我在想我好像很久没有摸过纸钞了。”\n“对对对对对！没错！听说工团没有工资和钱的概念，你们固定每周会发生活物资是吧，真的假的？”\n“钱，工资，这些都会有，只是……不太用得到。我们大部分生产基地都地处偏僻，拿这次任务说吧，对你来说，属于来到了荒野，对我来说，则算是向后，向安全区退了一些……每个基地配发物资都算齐全，钱……很多时候的确用不到。”\n“听着有点……呃……枯燥，那你要不来雷神工业？对呀！我怎么把这件事忘了，我们最近引荐新人有奖励……你扔了个什么东西过来？工牌？雷神工业？开玩笑，咱们这不是同事吗？”\n“是旧工牌，芯片取走了，留着外壳做纪念，几年前我在雷神。”\n“那你为什么……”\n“因为这么多年我一直不太能习惯技术革新与商业化的直接挂钩，当然，雷神是家好公司，离开那里是因为我的奇怪洁癖。另外，总要有人抱成一团向外走，去开辟险地，你说对不对？”\n“道理是这样的道理，可……咦？什么东西在滴滴作响……”\n“通信器，我的工友定位到了我的信标异常，正在赶来救援，我们要向边界位置靠拢一些。”\n“不愧是高手！哎，你真不考虑回雷神工业吗？重新入职说不定……”\n“走了走了。”","weaponId","weaponPotentialSkill","sk_wpn_pistol_0004","weaponSkillList",[51,52,48],"wpn_attr_str_mid","wpn_sp_attr_firedam_mid","weaponType",6,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","雷神工业为支持人类对外探索而设计生产的高能型铳械，具有较强的环境适应能力，是大多探索者的标配武器。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",33,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,183,188,193,198,203,208,213,218,223,227,232,237,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},46,2,{"_99":109,"_101":102,"_103":86,"_104":110},50,3,{"_99":112,"_101":113,"_103":86,"_104":114},54,20,4,{"_99":116,"_101":117,"_103":86,"_104":41},58,40,{"_99":119,"_101":109,"_103":86,"_104":54},62,{"_99":121,"_101":122,"_103":86,"_104":123},66,80,7,{"_99":125,"_101":126,"_103":86,"_104":127},71,110,8,{"_99":129,"_101":130,"_103":86,"_104":131},75,150,9,{"_99":133,"_101":134,"_103":102,"_104":102},79,200,{"_99":136,"_101":137,"_103":102,"_104":138},83,270,11,{"_99":140,"_101":141,"_103":102,"_104":142},87,370,12,{"_99":144,"_101":145,"_103":113,"_104":146},91,480,13,{"_99":148,"_101":149,"_103":150,"_104":151},95,620,30,14,{"_99":153,"_101":154,"_103":109,"_104":155},100,780,15,{"_99":157,"_101":158,"_103":159,"_104":160},104,990,70,16,{"_99":162,"_101":163,"_103":153,"_104":164},108,1250,17,{"_99":166,"_101":167,"_103":168,"_104":169},112,1550,140,18,{"_99