[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_793":794},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0018","slug","junction-point","name","联结点","type","weapon","version","1.6",{"_26":27,"_56":57,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_B_1","engName","Junction Point","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0018.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","你敢相信吗，洛娜，现在发出这封信件的我，并不在塔卫二上。\n想必你也猜到了，是的，我正在帝江号，作为环塔商会特别代表团的一分子，出席我们与终末地的闭门会议。\n这是我第一次登上这座游于星海的飞船——那真的是海，只是比它更深邃，更安静，只有粼粼星光在远端闪烁着。塔卫二躺在我们面前，就像是婴儿床里熟睡的小贝里。\n哦，贝里，我的小可爱，记得代我亲亲他的额头。\n当我以为星海与眼前的塔卫二足以满足我一切好奇心的时候，第四天，作为招待的一部分，终末地安排代表团参观了无重力体验室。那是一间空旷、简洁的房间，当我们准备完毕后，灯光变得暗淡，天窗缓缓打开，巨大的塔罗斯带来新的光亮，也吸引走了我们全部的目光。\n而后——重力消失了。\n那些谈判专家与职业经理人的稳重在那一刻被本能接管，我的耳边响起了一声声惊叹。我还听到了一声轻笑，那一定属于带我们前来参观的终末地干员。这是一种纯粹的乐趣，谁不想看看那些大人物如孩子般失态的瞬间呢，要不是出于保密，我想这间体验室里一定会贴满“受害者”的照片。\n至于我……我不知道怎么和你形容，洛娜。在我卸下每一丝重量，被地面抛弃，在半空悬浮，面对眼前的天体，任凭自由感充盈全身的时候，我——\n我感受到了一种使命。\n一种绝无可能实现的使命。\n我、我想把这种体验带给文明环带的所有民众。\n生在塔卫二的我们是重力的孩子，帝江号的诞生第一次赋予了所有人体验另一种生活的机会。\n我还记得父亲和我说过，最昂贵的东西，不是豪宅，不是商品，而是生活方式。\n还有什么生活方式比在星海之间，超脱大地更加独特？\n在未来，我们会有人工静止轨道体验舱，从最基础的停留做起，然后是商业综合体、星间体育场，所有运动形式在无重力环境下将有新的规则、新的赛事、新的明星。当骑士们背着喷射背包纵情冲刺，当赛车在环形赛道上留下一道弧线，当球在动力与引力的作用下从天穹落入球门，洛娜，我们的成就将无法用金钱来计数。\n当然，这一切的前提来自于你的支持，亲爱的。记得看一下附件里的设计图，就算我们没机会实现，也让我们为这种想法留下些什么吧。如果你认同我，我们就一起完成这件作品，丢到概念设计比赛上去，让公司，让环塔商会来铭记我们的想法。\n我很快就能回来了，有机会能在到家的时候听到你的回复吗，洛娜？\n爱你。\n\n该信件包含了一份施术单元的设计草稿，草稿的右下角写明了施术单元的制作规格，以及一个暂定命名：\n“联结点”","weaponId","weaponPotentialSkill","sk_wpn_funnel_0018","weaponSkillList",[52,53,49],"wpn_attr_wisd_high","wpn_sp_attr_usgs_high","weaponType",2,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":95},"backpackCanDiscard",false,"decoDesc","梅什科工业概念设计比赛优胜作品。微秒级加速与优异的悬停性能融入了设计者对无重力的独特理解。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",75,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_98":99},"list",[100,107,109,112,116,119,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,331,336,341,345,350,355,360,365,369,374,379,384,389,393,398,403,408,413,417,421,426,431,436,440,444,449,454,459,463,467,472,477,482,485,490,495,500,504,508],{"_101":102,"_103":104,"_105":87,"_106":95},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_101":108,"_103":104,"_105":87,"_106":55},54,{"_101":110,"_103":104,"_105":87,"_106":111},59,3,{"_101":113,"_103":114,"_105":87,"_106":115},64,20,4,{"_101":117,"_103":118,"_105":87,"_106":92},69,40,{"_101":120,"_103":102,"_105":87,"_106":42},74,{"_101":122,"_103":123,"_105":87,"_106":124},79,80,7,{"_101":126,"_103":127,"_105":87,"_106":128},84,110,8,{"_101":130,"_103":131,"_105":87,"_106":132},89,150,9,{"_101":134,"_103":135,"_105":104,"_106":104},94,200,{"_101":137,"_103":138,"_105":104,"_106":139},99,270,11,{"_101":141,"_103":142,"_105":104,"_106":143},104,370,12,{"_101":145,"_103":146,"_105":114,"_106":147},109,480,13,{"_101":149,"_103":150,"_105":151,"_106":152},114,620,30,14,{"_101":154,"_103":155,"_105":102,"_106":156},119,780,15,