[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_740":741},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0010","slug","valiant","name","骁勇","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_494":495,"_556":557},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_C_1","engName","Valiant","levelTemplateId","weapon_upgrade_curve_6star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0010.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","我当然承认“美德”具有价值，我甚至无比支持这一点！但，先生，价值是可量化的。\n忠诚与勇气哪个更博人眼球？慷慨与怜悯哪个更令人青睐？我们从不需要一位公正的裁决人，我们有更靠谱的东西——市场！我的先生，想必以您的年纪，还对那些屏幕上跳动的数字与惊心动魄的折线图有印象吧？哦！您曾跟着祖父去过商业联……？那太好了！多棒的童年回忆！那么，无需我多言，您该知道，所见的那些便是“美德”被量化过的结果：一份可交易的价值。\n是的，是的，商业一定是独属于人类的智慧。哦，听我的，忘了那些对金融学尖酸刻薄的批判吧。我向来不在乎脚下的东西是球体，是三角，还是圆柱——只要在这之上生活的还是人类，对于我们来说就没有本质上的差别。在泰拉如此，在塔卫二亦是如此。我们从未离开我们自己，不是吗？我的意思是，您换一间屋子，难道还会换一颗脑子吗？\n那些一门心思往前走的人把这儿描绘成一片险象环生的土地，但换而言之，这又何尝不是一片尚未被人涉足的土地！我必须声明，该项目的投资前景与发展潜质难以估量。推出“美德”系列装备只是这个战略布局中最小的一步……而我，您听着，我绝不是唯一嗅到商机的人。\n在这片土地人满为患之前，在“美德”尚可估价之时……德里安先生，我保证，您今日在这张合约上落下的每一笔，都能在未来兑成取之不尽的财富。\n对，对！就签在这儿……瞧瞧，我就知道您是个投资眼光相当毒辣的人——哦，什么？好的，让他到贵宾室等一下。\n——那么，我便不留您了。","weaponId","weaponPotentialSkill","sk_wpn_lance_0010","weaponSkillList",[51,52,48],"wpn_attr_agi_high","wpn_sp_attr_phydam_high","weaponType",5,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":54,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","梅什科工业的中端线产品之一。复古的巨箭型设计以及不俗的实战实用性，使其至今仍有市无价。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackC