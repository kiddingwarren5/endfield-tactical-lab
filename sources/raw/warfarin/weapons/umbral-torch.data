[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_775":776},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_sword_0010","slug","umbral-torch","name","黯色火炬","type","weapon","version","1.6",{"_26":27,"_56":57,"_95":96,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_A_1","engName","Umbral Torch","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_sword_0010.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","“哈……詹宁斯，你终于接电话了。\n“你听着，这是一场商业战争，不，是政治迫害！他们知道我们掌握了什么，知道了这东西面世会产生什么影响！\n“所以那帮该死的，那帮混球，他们盯上了我们的研究成果，他们在找我们，在满世界地找我们！\n“他们会为自己的所作所为后悔！我不会忘了他们现在的嘴脸，这是我费尽心血得来的成果，雷神工业保护不了我们，交出它的一瞬间我们就没活路了！\n“我不会让他们得逞的，他们永远别想拿到想要的东西。我现在就到你那里去，‘核桃’帮我们准备了一辆车，我们要离开环带，有朋友在外面等我们。\n“那是一群好战分子，我知道你不喜欢他们，但他们也比那些玻璃大楼里的杂碎值得信任！\n“没有别的选择，这东西会颠覆一切的！他们不希望结束垄断，他们会后悔的。但我们得先活着，詹宁斯。只有先活着才有未来。\n“喂，詹宁斯，你能听见吗？詹宁斯？”\n“嘟……嘟……嘟……”\n男人站在窗前，玻璃上反射着他那副惨淡的面容。深凹的眼窝证明了男人很久未曾阖眼入眠了。一刹间，男人有点认不出眼前的人竟是自己。\n“该死的！”","weaponId","weaponPotentialSkill","sk_wpn_sword_0010","weaponSkillList",[52,53,49],"wpn_attr_wisd_high","wpn_sp_attr_firedam_high","weaponType",1,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":55},"backpackCanDiscard",false,"decoDesc","雷神工业推出的新一代轻量化武器。整个剑身均采用特制的合成金属作为材料。深受“专业人士”青睐。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainSho