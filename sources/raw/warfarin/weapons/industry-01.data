[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_734":735},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0003","slug","industry-01","name","工业零点一","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_499":500,"_561":562},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_D_1","engName","Industry 0.1","levelTemplateId","weapon_upgrade_curve_4star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0003.prefab","potentialUpItemList",[],"rarity",4,"talentTemplateId","wpn_potential_456star","weaponDesc","我不是第一次听他们提到“文明的食腐动物”这个话题，只是我还没有亲眼见过。\n很多人难以理解，塔卫二的生活充满了困难。城市与社区之间需要团结一致才能渡过难关，但仍然有不少人选择离开城市，过着流浪者和投机者的生活。\n但是我并不会感到奇怪，有些人失去得太多了。就像我上周采访的那十几位难民，他们的社区遭遇了灾害，食物严重短缺，根本没有选择。\n但也有一部分人，他们单纯地不愿意遵守某种秩序，或是天生坏种，他们自愿生活在暴力和危险之中。\n但归根究底，他们无法摆脱“文明”本身。我上周看到这些人正在使用捡来的机械工具制造武器，我真的很好奇，他们是从哪里弄到一台完整的车床的。然而，最终的答案其实很简单，他们会从城市的垃圾堆中碰碰运气，找到他们所需的一切。\n“文明的食腐动物”这个说法非常贴切，对吧？\n顺便提一下，报社的那个小记者，下次不要让她跟着我。她这一辈子就应该待在围墙后面，生活在城市里。一个连睡袋都难以接受的人，不应该在开拓区乱跑。老老实实去当个明星跟班更适合她。","weaponId","weaponPotentialSkill","sk_wpn_claym_0003","weaponSkillList",[51,52,48],"wpn_attr_str_low","wpn_sp_attr_atk_low","weaponType",3,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","在开拓区常见的一种武器类型，基础设计已难以追溯。这种武器制造工艺并不复杂，常见工业设备都可生产。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_o