[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_783":784},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_pistol_0006","slug","opus-the-living","name","作品：众生","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_2","engName","Opus: The Living","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_pistol_0006.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","萨科塔穿过战场，停在一位重伤倒地的工团成员身前。她俯下身，简单地查看了伤势，恐怕这名伤员已撑不到医护人员赶来。\n\n“愿你终将寻到安宁。”\n\n萨科塔抓住他的双手，祈祷这可怜的人能够得到安息。\n他是第几个？第三十个？还是第三百个？萨科塔思索着，握着那双早已冰冷的手，直到背后传来土石的响动。她闪电般拔出了铳——那是一只天使，头顶一轮忽明忽暗的光环。\n萨科塔缓步走向这只瘫倒的天使，它已不再具有威胁，大半身体已被工人卫队的炮火击碎。\n\n萨科塔的心中存在疑问，而她知道自己不会从眼下的境况中得到答案。从寂语修会庞大的移动修道院行驶在塔卫二的那天起，在萨科塔们亲眼目击第一只天使后，他们——我们就注定无法依靠他人得到答案。\n\n“律法恩典，引我踏上归途……”\n\n每一位寂语修会的萨科塔都会唱这首圣歌。萨科塔沐浴在圣徒的目光中跨过星门，颂唱着同一首圣歌，奔走在散落塔卫二的残迹间。\n她仍记得，伏龙达院长在晨祷时讲述过一个故事：在那史书尚未记载的时代，提卡兹寻求主的庇佑，成为了萨科塔；在主离开圣殿的时代，最初的圣徒向萨科塔展示了她提卡兹的容貌。但这个故事，却让她充满了疑惑。\n如若光环是主亲手赐予萨科塔的、独一无二的礼物，那么光环下成群的、称不上拥有生命的塔卫二天使，从何而来？\n\n又是什么塑造了你们？\n\n萨科塔握紧了手中的铳，无人解答她的疑惑。仿佛这世界只有手中的铳能被称作真实。\n很快，最后一根锚点消失在地平线上，前线传来了宣告胜利的汽笛声。联盟工团再次完成了他们的开拓使命，从此刻起，文明环带将在另一片荒芜之地上站稳脚跟。\n在欢呼声中，她将双手放在了这“濒死”的天使头上。她似乎能从这本应没有任何情绪的异物上感到一股细微的波动……最终归为一片全然空无的宁静。\n主为萨科塔赐予了光环，但这份恩赐似乎并不独属于萨科塔。她思索着这一切背后可能的意义，直至信仰再度充盈她的心房。此时此刻，在此处，来自寂语修会的萨科塔有另一场临终祷告要做。\n\n“无论来自何处，愿你终将寻到安宁。”\n\n碎石崩落，尘土溢出萨科塔的指缝。那隐隐显现的光环，终于消散在空气中。","weaponId","weaponPotentialSkill","sk_wpn_pistol_0006","weaponSkillList",[51,52,48],"wpn_attr_agi_mid","wpn_sp_attr_magicdam_mid","weaponType",6,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","轻超域技术实验室受托定制作品。艺术家大胆地使用遗迹残石包覆铳膛，并在残石上刻下了特殊的脉络。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",21,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,182,187,192,197,202,207,212,217,222,226,231,236,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},46,2,{"_99":109,"_101":102,"_103":86,"_104":110},50,3,{"_99":112,"_101":113,"_103":86,"_104":114},54,20,4,{"_99":116,"_101":117,"_103":86,"_104":41},58,40,{"_99":119,"_101":109,"_103":86,"_104":54},62,{"_99":121,"_101":122,"_103":86,"_104":123},66,80,7,{"_99":125,"_101":126,"_103":86,"_104":127},71,110,8,{"_99":129,"_101":130,"_103":86,"_104":131},75,150,9,{"_99":133,"_101":134,"_103":102,"_104":102},79,200,{"_99":136,"_101":137,"_103":102,"_104":138},83,270,11,{"_99":140,"_101":141,"_103":102,"_104":142},87,370,12,{"_99":144,"_101":145,"_103":113,"_104":146},91,480,13,{"_99":148,"_101":149,"_103":150,"_104":151},95,620,30,14,{"_99":153,"_101":154,"_103":109,"_104":155},100,780,15,{"_99":157,"_101":158,"_103":159,"_104":160},104,990,70,16,{"_99":162,"_101":163,"_103":153,"_104":164},108,1250,17,{"_99":166,"_101":167,"_103":168,