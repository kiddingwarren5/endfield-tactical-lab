[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_743":744},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0007","slug","monaihe","name","莫奈何","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_1","engName","Monaihe","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0007.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","孩子，明天你就要参加结业测试了。这场测试的重要性不言而喻，它将决定你未来的岗位分配。我多么希望能亲自送你去测试，但我必须要盯紧侵蚀潮，这是我的职责。\n我相信你已经做好了充分准备。不过，关于源石技艺精确度的测试，我还是要特别叮嘱几句。这个环节淘汰的人最多。如果你想加入应龙特勤队，这一关必须过。\n测试使用的是宏山选剑局为武陵城特别研发的施术单元。它采用了息壤材料，因此其源石回路会和以往的施术单元有所不同。这将是对你专注力和敏锐度的极大考验。\n当然，这些信息你早就烂熟于心。听说你们这些年轻人给它起了个绰号“莫奈何”，确实贴切。现在我们也都这么称呼它了。\n为确保测试公平，我不能透露更多关于这个施术单元的细节。但我对你充满信心。还记得我小时候经常带你玩的木锁吗？虽然棘手，但你很快就找到了窍门。你现在要做的和那时一样——专注于眼前的挑战，享受这个过程。\n祝你顺利。","weaponId","weaponPotentialSkill","sk_wpn_funnel_0007","weaponSkillList",[51,52,48],"wpn_attr_will_mid","wpn_sp_attr_usgs_mid","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","宏山选剑局研发的施术单元，采用了珍贵的息壤材料。因其材料特性，使用者必须具备极高的操控准确度。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotC