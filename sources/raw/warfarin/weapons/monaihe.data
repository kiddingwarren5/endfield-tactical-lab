":1123,"_766":1125,"_769":1126},[768,768,768],[1127,1127,1127],"<color=#FF0000>","dlg.r_name",{"_15":1128,"_766":1130,"_769":1131},[768,768,768],[1132,1132,1132],"<color=#87CEFA>","nar.blue",{"_15":1133,"_766":1135,"_769":1136},[768,768,768],[893,1137,895],"<color=#00ffff>","dung.feature",{"_15":1138,"_766":1140,"_769":1141},[768,768,768],[1017,1017,1017],"dung.key",{"_15":1142,"_766":1144,"_769":1145},[768,768,768],[821,821,821],"sns.key",{"_15":1146,"_766":1148,"_769":1149},[768,768,768],[1150,1150,1150],"<color=#169ED9>","fac.blue",{"_15":1151,"_766":1153,"_769":1154},[768,768,768],[1155,1155,1155],"<color=#2f8baf>","gembox.num",{"_15":1156,"_766":1158,"_769":1159},[768,768,768],[1160,1160,1160],"<color=#fff100>","gray.note",{"_15":1161,"_766":1163,"_769":1164},[768,768,768],[1165,1165,1165],"<color=#7a7a7a>","ld.key",{"_15":1166,"_766":1168,"_769":1169},[768,768,768],[837,837,837],"nar.center",{"_15":1170,"_766":1172,"_769":1173},[1105,1105,1105],[1174,1174,1174],"<align=\"center\">","scene_grade.up",{"_15":1175,"_766":1177,"_769":1178},[768,768,768],[1179,1179,1179],"<color=#ABCD47>","tech.key",{"_15":1180,"_766":1182,"_769":1183},[768,768,768],[821,821,821],"nar.clue",{"_15":1184,"_766":1186,"_769":1187},[768,768,768],[1188,1189,861],"<color=##333333>","<color=#f2f2f2>","nar.enter",{"_15":1190,"_766":1192,"_769":1193},[],[1194,1194,1194],"<br>","nar.left",{"_15":1195,"_766":1197,"_769":1198},[1105,1105,1105],[1199,1199,1199],"<align=\"left\">","nar.mark",{"_15":1200,"_766":1202,"_769":1204},[1203,1203,1203],"</color></mark>",[1205,1206,1205],"<mark=#444444><color=#44444400>","<mark=#E6E6E6><color=#E6E6E600>","qu.largenumdown",{"_15":1207,"_766":1209,"_769":1211},[1210,1210,1210],"</color></size>",[1212,1212,1212],"<size=54><color=#e74414>","nar.quote",{"_15":1213,"_766":1215,"_769":1217},[1216,1216,1216],"</i>",[1218,1218,1218],"<i>","nar.right",{"_15":1219,"_766":1221,"_769":1222},[1105,1105,1105],[1223,1223,1223],"<align=\"right\">","opt.key",{"_15":1224,"_766":1226,"_769":1227},[768,768,768],[1228,1228,1228],"<color=#5ECDFF>","qu.numdown",{"_15":1229,"_766":1231,"_769":1232},[768,768,768],[1233,1233,1233],"<color=#e74414>","toast_craft.key",{"_15":1234,"_766":1236,"_769":1237},[768,768,768],[821,821,822],"qu.numup",{"_15":1238,"_766":1240,"_769":1241},[768,768,768],[1242,1242,1242],"<color=#c7fe02>","rac.tec",{"_15":1243,"_766":1245,"_769":1246},[768,768,768],[1247,1247,1247],"<color=#FFCC00>","scene_grade.down",{"_15":1248,"_766":1250,"_769":1251},[768,768,768],[1252,1252,1252],"<color=#D12E42>","set.key",{"_15":1253,"_766":1255,"_769":1256},[768,768,768],[1257,1257,1257],"<color=#A7A7A7>","tech.get",{"_15":1258,"_766":1260,"_769":1261},[768,768,768],[1262,1262,1262],"<color=#1e1e1e>","tips.key",{"_15":1263,"_766":1265,"_769":1266},[768,768,768],[1267,1268,1267],"<color=#444444>","<color=#FFFFFF>","tips.orange",{"_15":1269,"_766":1271,"_769":1272},[768,768,768],[1056,1057,1058],"toast_focal.key",{"_15":1273,"_766":1275,"_769":1276},[768,768,768],[1268,1268,1268],"weapon.stress",{"_15":1277,"_766":1279,"_769":1280},[768,768,768],[1281,1281,1281],"<color=#fe5a00>","weekraid.key",{"_15":1282,"_766":1284,"_769":1285},[925,925,925],[1286,1286,1287],"<color=#ffcc00><u>","<color=#cc9900><u>","hyperlinkTextTable",{"_1290":1291,"_1297":1298,"_979":1302,"_1307":1308,"_1311":1312,"_1316":1317,"_1320":1321,"_1325":1326,"_1329":1330,"_1334":1335,"_1338":1339,"_794":1343,"_1348":1349,"_1352":1353,"_1357":1358,"_1362":1363,"_1366":1367,"_1371":1372,"_877":1375,"_1380":1381,"_1384":1385,"_1390":1391,"_883":1394,"_1399":1400,"_1403":1404,"_901":1408,"_1413":1414,"_1417":1418,"_908":1422,"_1427":1428,"_1433":1434,"_932":1438,"_1443":1444,"_1448":1449,"_1453":1454,"_1458":1459,"_939":1463,"_1467":1468,"_1472":1473,"_1477":1478,"_1481":1482,"_1487":1488,"_1492":1493,"_969":1497,"_1502":1503,"_1507":1508,"_1510":1511,"_1514":1515,"_1519":1520,"_1523":1524,"_1529":1530,"_1533":1534,"_1538":1539,"_1543":1544,"_986":1548,"_1552":1553,"_1555":1556,"_1006":1560,"_1564":1565,"_1569":1570,"_1574":1575,"_1579":1580,"_1583":1584,"_1588":1589,"_806":1594,"_845":1598,"_1603":1604,"_1608":1609,"_1613":1614,"_1032":1618,"_1623":1624,"_1626":1627,"_1630":1631,"_1634":1635,"_1639":1640,"_1644":1645,"_1648":1649,"_1653":1654,"_1072":1658,"_1662":1663,"_1667":1668,"_1672":1673,"_1677":1678,"_1681":1682,"_1685":1686,"_1690":1691,"_1695":1696,"_1699":1700,"_1705":1706,"_1709":1710,"_1713":1714,"_1718":1719,"_1722":1723,"_1726":1727,"_1730":1731,"_1736":1737,"_1741":1742,"_1746":1747,"_1751":1752,"_1756":1757,"_1761":1762,"_1766":1767,"_1771":1772,"_1776":1777,"_1781":1782,"_1786":1787,"_1791":1792,"_1796":1797,"_1801":1802},"adv.electricFence",{"_61":1292,"_1293":64,"_15":1290,"_1294":64,"_19":1295,"_1296":862},"在激活状态下的高压阻拦网是无法通过的。\n沿着电线找到其对应的开关，即可关闭高压阻拦网，通过其封锁的路段。","iconPath","jumpWikiId","高压阻拦网","richTextId","ba.crystonchar",{"_61":1299,"_1293":1300,"_15":1297,"_1294":64,"_19":1301,"_1296":915},"一些敌人的技能会给干员施加<@ba.crystinflict>寒冷附着</>。\n达到4层时，干员会进入<@ba.frozen>冻结</>状态：一段时间内无法行动。","TermIcon/icon_term_ba_crystinflict","干员受到寒冷附着",{"_61":1303,"_1293":1304,"_15":979,"_1294":1305,"_19":1306,"_1296":1044},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数，造成<@ba.phy>物理伤害</>，并使其在一段时间内受到的<@ba.pd>物理伤害</>提高。","TermIcon/icon_term_ba_fracture","wiki_tut_bat_breakarmor","物理异常 - 碎甲","adv.eswitch",{"_61":1309,"_1293":64,"_15":1307,"_1294":64,"_19":1310,"_1296":862},"受击装置在受到攻击或是爆炸冲击后，会改变运行状态。\n一般用来关闭<#adv.electricFence>高压阻拦网</>或启用<#adv.jumpMachine>弹射装置</>。","受击装置","item.glassBottle",{"_61":1313,"_1293":1314,"_15":1311,"_1294":64,"_19":1315,"_1296":862},"由<#item.quartzGlass>紫晶纤维</>通过工业设备塑形后得到的瓶子。\n可用于其他材料合成。","TermIcon/icon_term_item_glassBottle","紫晶质瓶","adv.jumpMachine",{"_61":1318,"_1293":64,"_15":1316,"_1294":64,"_19":1319,"_1296":862},"主控干员可使用弹射装置进行一次长距离的跳跃，能够抵达普通跳跃无法触达的高处。\n在通电时，弹射装置为可用状态。此时操控主控干员站立在装置上方并进行跳跃即可使用。","弹射装置","ba.fireenhance",{"_61":1322,"_1293":1323,"_15":1320,"_1294":64,"_19":1324,"_1296":956},"一定时间内目标造成的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_fireenhance","灼热增幅","adv.powerTerminal",{"_61":1327,"_1293":64,"_15":1325,"_1294":64,"_19":1328,"_1296":862},"作为电路末端的终端设备，可接入电网为其他设备供电。\n供电终端通常为大门、开关等设备供电。使用中继器为供电终端运输电力后，即可控制大门或开关。","供电终端","item.plantMossSeed1",{"_61":1331,"_1293":1332,"_15":1329,"_1294":64,"_19":1333,"_1296":862},"由<#item.plantMoss1>荞花</>通过工业设备采种得到的种子。\n在工业设备中种植荞花种子，可获得荞花。或将荞花种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss1>荞花田块</>。","TermIcon/icon_term_item_plantMossSeed1","荞花种子","ba.absorb",{"_61":1336,"_1293":64,"_15":1334,"_1294":64,"_19":1337,"_1296":64},"状态以特殊的方式提前结束。<@ba.key>吸收</>不算作<#ba.consume>消耗</>。","吸收","ba.crystvul",{"_61":1340,"_1293":1341,"_15":1338,"_1294":64,"_19":1342,"_1296":915},"一定时间内目标受到的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystvul","寒冷脆弱",{"_61":1344,"_1293":1345,"_15":794,"_1294":1346,"_19":1347,"_1296":1044},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则叠加一层<#ba.noguard>破防</>，造成<@ba.phy>物理伤害</>并累积<@ba.poise>失衡值</>。","TermIcon/icon_term_ba_airborne","wiki_tut_bat_airborne","物理异常 - 击飞","fac.hub",{"_61":1350,"_1293":64,"_15":1348,"_1294":64,"_19":1351,"_1296":862},"协议核心是集成工业系统的中枢设备，承担了诸多功能，是进行工业建设的核心。\n在协议核心所在的集成核心区域内，可以进行仓储管理。","协议核心","item.originium",{"_61":1354,"_1293":1355,"_15":1352,"_1294":64,"_19":1356,"_1296":862},"一种可在野外源矿矿点采集的矿石，可用于集成工业系统发电。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.crystalShell>晶体外壳</>。","TermIcon/icon_term_item_originium","源矿","item.portSoilSp1",{"_61":1359,"_1293":1360,"_15":1357,"_1294":64,"_19":1361,"_1296":862},"可以在生态种植园中进行进行精细化培育以收获<#item.plantSp1>灰芦麦</>的田块。\n由<#item.plantSpSeed1>灰芦麦种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量灰芦麦。","TermIcon/icon_term_item_portSoilSp1","灰芦麦田块","ba.arrowenergy",{"_61":1364,"_1293":64,"_15":1362,"_1294":64,"_19":1365,"_1296":889},"提弗洛斯消耗敌人身上的<@ba.naturalinflict>自然附着</>和敌人受到<#ba.naturalburst>自然爆发</>时可以积攒它，使用连携技可以将它转换成<#ba.arrownum>猎矢</>。","启示","item.originiumEnrPowder",{"_61":1368,"_1293":1369,"_15":1366,"_1294":64,"_19":1370,"_1296":862},"由<#item.originiumPowder>源石粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumEnrPowder","致密源石粉末","ba.arrownum",{"_61":1373,"_1293":64,"_15":1371,"_1294":64,"_19":1374,"_1296":889},"提弗洛斯可以在<@ba.key>浮空</>状态时消耗它来强化自己的射击，造成更高的伤害同时还能额外触发<#ba.naturalburst>自然爆发</>。","猎矢",{"_61":1376,"_1293":1377,"_15":877,"_1294":1378,"_19":1379,"_1296":956},"<@ba.burning>燃烧</>状态下，敌人持续受到<@ba.fire>灼热伤害</>。\n<@ba.burning>燃烧</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</>","TermIcon/icon_term_ba_burning","wiki_tut_bat_combust","法术异常 - 燃烧","ba.burningonchar",{"_61":1382,"_1293":1377,"_15":1380,"_1294":64,"_19":1383,"_1296":956},"一些敌人的技能会给干员施加<@ba.fireinflict>灼热附着</>。\n达到4层时，干员会进入<@ba.burning>燃烧</>状态：一段时间内，持续受到无视防御力的<@ba.fire>灼热伤害</>。","干员受到燃烧","ba.combo",{"_61":1386,"_1293":1387,"_15":1384,"_1294":1388,"_19":1389,"_1296":889},"全队的下个战技或终结技的伤害提高，对战技的提高幅度更大，触发后效果清空。同类效果可以叠加，但效果有衰减。","TermIcon/icon_term_ba_combo","wiki_tut_bat_combohint","连击","ba.static",{"_61":1392,"_1293":64,"_15":1390,"_1294":64,"_19":1393,"_1296":889},"持续时间内，受影响的目标暂停行动。","定身",{"_61":1395,"_1293":1396,"_15":883,"_1294":1397,"_19":1398,"_1296":1068},"<@ba.conduct>导电</>状态下，敌人受到的<#ba.spelldmg>法术伤害</>提高。\n<@ba.conduct>导电</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</>","TermIcon/icon_term_ba_conduct","wiki_tut_bat_conduct","法术异常 - 导电","ba.conductonchar",{"_61":1401,"_1293":1396,"_15":1399,"_1294":64,"_19":1402,"_1296":1068},"一些敌人的技能会给干员施加<@ba.pulseinflict>电磁附着</>。\n达到4层时，干员会进入<@ba.conduct>导电</>状态：短暂眩晕，且一段时间内，受到的<#ba.spelldmg>法术伤害</>提高。","干员受到导电","ba.consume",{"_61":1405,"_1293":64,"_15":1403,"_1294":1406,"_19":1407,"_1296":64},"状态以特殊的方式提前结束（如<#ba.crush>猛击</>消耗<#ba.noguard>破防</>状态，<#ba.burning>燃烧</>消耗<#ba.spellinflict>法术附着</>状态）。","wiki_tut_bat_consume","状态消耗",{"_61":1409,"_1293":1410,"_15":901,"_1294":1411,"_19":1412,"_1296":1018},"<@ba.corrupt>腐蚀</>状态下，敌人的所有抗性逐渐下降。\n<@ba.corrupt>腐蚀</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</>","TermIcon/icon_term_ba_corrupt","wiki_tut_bat_corrode","法术异常 - 腐蚀","ba.corruptonchar",{"_61":1415,"_1293":1410,"_15":1413,"_1294":64,"_19":1416,"_1296":1018},"一些敌人的技能会给干员施加<@ba.naturalinflict>自然附着</>。\n达到4层时，干员会进入<@ba.corrupt>腐蚀</>状态：一段时间内无法冲刺，且移动速度降低。","干员受到腐蚀","item.plantSpSeed1",{"_61":1419,"_1293":1420,"_15":1417,"_1294":64,"_19":1421,"_1296":862},"由<#item.plantSp1>灰芦麦</>通过工业设备采种后得到的种子。\n将灰芦麦种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilSp1>灰芦麦田块</>。","TermIcon/icon_term_item_plantSpSeed1","灰芦麦种子",{"_61":1423,"_1293":1424,"_15":908,"_1294":1425,"_19":1426,"_1296":1044},"对敌人造成<#ba.noguard>破防</>，如果敌人已经<#ba.noguard>破防</>，则会<#ba.consume>消耗</>所有<#ba.noguard>破防</>层数并造成大量<@ba.phy>物理伤害</>。","TermIcon/icon_term_ba_crush","wiki_tut_bat_knockback","物理异常 - 猛击","ba.guard",{"_61":1429,"_1293":1430,"_15":1427,"_1294":1431,"_19":1432,"_1296":889},"一定时间内目标受到的伤害降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_guard","wiki_tut_bat_guard","庇护","ba.spellvul",{"_61":1435,"_1293":1436,"_15":1433,"_1294":64,"_19":1437,"_1296":889},"一定时间内目标受到的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellvul","法术脆弱",{"_61":1439,"_1293":1440,"_15":932,"_1294":1441,"_19":1442,"_1296":915},"对处于<#ba.frozen>冻结</>状态的敌人施加<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>时触发，<#ba.consume>消耗</>目标的<#ba.frozen>冻结</>状态，并对其造成大量<@ba.pd>物理伤害</>。","TermIcon/icon_term_ba_crystbreak","wiki_tut_bat_freeze","碎冰","ba.crystburst",{"_61":1445,"_1293":64,"_15":1443,"_1294":1446,"_19":1447,"_1296":915},"<#ba.crystinflict>寒冷附着</> + <#ba.crystinflict>寒冷附着</>会触发<@ba.cryst>寒冷爆发</>，对敌人造成一定<@ba.cryst>寒冷伤害</>。","wiki_tut_bat_cold_outbreak","法术爆发 - 寒冷","item.glassCmpt",{"_61":1450,"_1293":1451,"_15":1448,"_1294":64,"_19":1452,"_1296":862},"由<#item.quartzGlass>紫晶纤维</>通过工业设备配件后得到的零件。\n可用于其他材料合成。","TermIcon/icon_term_item_glassCmpt","紫晶零件","item.ironNugget",{"_61":1455,"_1293":1456,"_15":1453,"_1294":64,"_19":1457,"_1296":862},"由<#item.ironOre>蓝铁矿</>通过工业设备精炼后得到的金属块。\n可用于其他材料合成。","TermIcon/icon_term_item_ironNugget","蓝铁块","ba.crystenhance",{"_61":1460,"_1293":1461,"_15":1458,"_1294":64,"_19":1462,"_1296":915},"一定时间内目标造成的<@ba.cryst>寒冷伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_crystenhance","寒冷增幅",{"_61":1464,"_1293":1300,"_15":939,"_1294":1465,"_19":1466,"_1296":915},"<@ba.crystinflict>寒冷附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.crystinflict>寒冷附着</>最多叠加4层，叠加时会触发<#ba.crystburst>寒冷爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</> = <#ba.frozen>冻结</>","wiki_tut_bat_cold","法术附着 - 寒冷","ba.dispel",{"_61":1469,"_1293":64,"_15":1467,"_1294":1470,"_19":1471,"_1296":889},"清除干员的特定异常状态。","wiki_tut_bat_dispel","净化","item.bbflowerPowder",{"_61":1474,"_1293":1475,"_15":1472,"_1294":64,"_19":1476,"_1296":862},"由<#item.bbflower>酮化灌木</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_bbflowerPowder","酮化灌木粉末","ba.dot",{"_61":1479,"_1293":64,"_15":1477,"_1294":64,"_19":1480,"_1296":64},"持续伤害无法触发暴击。","持续伤害","ba.enhance",{"_61":1483,"_1293":1484,"_15":1481,"_1294":1485,"_19":1486,"_1296":889},"一定时间内目标造成的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_enhance","wiki_tut_bat_enhance","增幅","item.plantMossSeed3",{"_61":1489,"_1293":1490,"_15":1487,"_1294":64,"_19":1491,"_1296":862},"由<#item.plantMoss3>砂叶</>通过工业设备采种得到的种子。\n在工业设备中种植砂叶种子，可获得砂叶。\n将砂叶种子与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilMoss3>砂叶田块</>。","TermIcon/icon_term_item_item_plantMossSeed3","砂叶种子","ba.fireburst",{"_61":1494,"_1293":64,"_15":1492,"_1294":1495,"_19":1496,"_1296":956},"<#ba.fireinflict>灼热附着</> + <#ba.fireinflict>灼热附着</>会触发<@ba.fire>灼热爆发</>，对敌人造成一定<@ba.fire>灼热伤害</>。","wiki_tut_bat_fire_outbreak","法术爆发 - 灼热",{"_61":1498,"_1293":1499,"_15":969,"_1294":1500,"_19":1501,"_1296":956},"<@ba.fireinflict>灼热附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.fireinflict>灼热附着</>最多叠加4层，叠加时会触发<#ba.fireburst>灼热爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.fireinflict>灼热附着</> = <#ba.burning>燃烧</>","TermIcon/icon_term_ba_fireinflict","wiki_tut_bat_fire","法术附着 - 灼热","item.quartzPowder",{"_61":1504,"_1293":1505,"_15":1502,"_1294":64,"_19":1506,"_1296":862},"由<#item.quartzGlass>紫晶纤维</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzPowder","紫晶粉末","ba.fireonchar",{"_61":1382,"_1293":1499,"_15":1507,"_1294":64,"_19":1509,"_1296":956},"干员受到灼热附着","sys.tacticalItem",{"_61":1512,"_1293":64,"_15":1510,"_1294":64,"_19":1513,"_1296":862},"战术物品可以为战斗带来增益效果，每种战术物品都有不同的生效条件及使用次数上限。\n战斗前，可为每名干员装备一种战术物品。战斗中，当符合其生效条件时，干员会自动使用已装备的战术物品。\n当战术物品的使用次数在单次战斗中耗尽后，会在一段时间后恢复一次使用次数。","战术物品","ba.firevul",{"_61":1516,"_1293":1517,"_15":1514,"_1294":64,"_19":1518,"_1296":956},"一定时间内目标受到的<@ba.fire>灼热伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_firevul","灼热脆弱","ba.pulseonchar",{"_61":1401,"_1293":1521,"_15":1519,"_1294":64,"_19":1522,"_1296":1068},"TermIcon/icon_term_ba_pulseinflict","干员受到电磁附着","ba.slow",{"_61":1525,"_1293":1526,"_15":1523,"_1294":1527,"_19":1528,"_1296":889},"一定时间内目标的移动速度降低（数值代表降低的幅度）。同类效果会取效果最高值。","TermIcon/icon_term_ba_slow","wiki_tut_bat_slow","缓速","ba.fixeddamage",{"_61":1531,"_1293":64,"_15":1529,"_1294":64,"_19":1532,"_1296":889},"固定伤害无视目标的防御和抗性，伤害量不会受到伤害提高或降低效果的影响。","固定伤害","ba.physicalenhance",{"_61":1535,"_1293":1536,"_15":1533,"_1294":64,"_19":1537,"_1296":1044},"一定时间内目标造成的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalenhance","物理增幅","ba.pulseenhance",{"_61":1540,"_1293":1541,"_15":1538,"_1294":64,"_19":1542,"_1296":1068},"一定时间内目标造成的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulseenhance","电磁增幅","ba.spellenhance",{"_61":1545,"_1293":1546,"_15":1543,"_1294":64,"_19":1547,"_1296":889},"一定时间内目标造成的<#ba.spelldmg>法术伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_spellenhance","法术增幅",{"_61":1549,"_1293":1550,"_15":986,"_1294":1441,"_19":1551,"_1296":915},"<@ba.frozen>冻结</>状态下，敌人无法行动，此时若受到<#ba.noguard>破防</>或<#ba.physicalstatus>物理异常</>，会触发<#ba.crystbreak>碎冰</>。\n<@ba.frozen>冻结</> = 其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.crystinflict>寒冷附着</>","TermIcon/icon_term_ba_frozen","法术异常 - 冻结","ba.frozenonchar",{"_61":1299,"_1293":1550,"_15":1552,"_1294":64,"_19":1554,"_1296":915},"干员受到冻结","ba.naturalvul",{"_61":1557,"_1293":1558,"_15":1555,"_1294":64,"_19":1559,"_1296":1018},"一定时间内目标受到的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalvul","自然脆弱",{"_61":1344,"_1293":1561,"_15":1006,"_1294":1562,"_19":1563,"_1296":1044},"TermIcon/icon_term_ba_knockdown","wiki_tut_bat_knockdown","物理异常 - 倒地","item.ironEnrPowder",{"_61":1566,"_1293":1567,"_15":1564,"_1294":64,"_19":1568,"_1296":862},"由<#item.ironPowder>蓝铁粉末</>与<#item.plantMossPowder3>砂叶粉末</>通过工业设备研磨后得到的细粉。\n可用于其他材料合成。","TermIcon/icon_term_item_ironEnrPowder","致密蓝铁粉末","item.portSoilMoss1",{"_61":1571,"_1293":1572,"_15":1569,"_1294":64,"_19":1573,"_1296":862},"可以在生态种植园中进行精细化培育以收获<#item.plantMoss1>荞花</>的田块\n由<#item.plantMossSeed1>荞花种子</>与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>获得。\n收获时可获得大量荞花，且有较高概率额外获得<#item.plantMossSpc1>映火荞花</>。","TermIcon/icon_term_item_portSoilMoss1","荞花田块","item.quartzSand",{"_61":1576,"_1293":1577,"_15":1574,"_1294":64,"_19":1578,"_1296":862},"一种可在野外紫晶矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.quartzGlass>紫晶纤维</>。","TermIcon/icon_term_item_quartzSand","紫晶矿","sys.manualCraft",{"_61":1581,"_1293":64,"_15":1579,"_1294":64,"_19":1582,"_1296":862},"可在背包中进行简易制作，将不同的原材料制作成各种可用的物品。\n例如可通过简易制作，将<#item.plantMoss1>荞花</>制作成能够回复生命值的<#item.plantMossSeed1>荞花粉末</>。","简易制作","ba.lastcombo",{"_61":1585,"_1293":64,"_15":1583,"_1294":1586,"_19":1587,"_1296":64},"重击是干员普通攻击的最后一段。主控干员的重击命中敌人时，会额外累积<@ba.poise>失衡值</>，并恢复一定技力。","wiki_tut_bat_heavy_attack","重击","ba.vulnerable",{"_61":1590,"_1293":1591,"_15":1588,"_1294":1592,"_19":1593,"_1296":889},"一定时间内目标受到的特定属性伤害提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_vulnerable","wiki_tut_bat_vulnerable","脆弱",{"_61":1595,"_1293":64,"_15":806,"_1294":1596,"_19":1597,"_1296":1018},"<#ba.naturalinflict>自然附着</> + <#ba.naturalinflict>自然附着</>会触发<@ba.natur>自然爆发</>，对敌人造成一定<@ba.natur>自然伤害</>。","wiki_tut_bat_nature_outbreak","法术爆发 - 自然",{"_61":1599,"_1293":1600,"_15":845,"_1294":1601,"_19":1602,"_1296":1044},"当敌人首次受到<#ba.physicalstatus>物理异常</>时，不会直接触发异常效果，而是进入<@ba.noguard>破防</>状态。\n<@ba.phy>破防</>状态可以被<#ba.airborne>击飞</>和<#ba.knockdown>倒地</>叠加（最多4层），且会被<#ba.crush>猛击</>和<#ba.fracture>碎甲</><#ba.consume>消耗</>。","TermIcon/icon_term_ba_noguard","wiki_tut_bat_break_defence","破防","item.ironOre",{"_61":1605,"_1293":1606,"_15":1603,"_1294":64,"_19":1607,"_1296":862},"一种可在野外蓝铁矿矿点采集的矿石。\n可使用工业设备对其进行加工，比如在精炼后得到<#item.ironNugget>蓝铁块</>。","TermIcon/icon_term_item_ironOre","蓝铁矿","ba.naturalenhance",{"_61":1610,"_1293":1611,"_15":1608,"_1294":64,"_19":1612,"_1296":1018},"一定时间内目标造成的<@ba.natur>自然伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_naturalenhance","自然增幅","item.originiumPowder",{"_61":1615,"_1293":1616,"_15":1613,"_1294":64,"_19":1617,"_1296":862},"由<#item.originium>源矿</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_originiumPowder","源石粉末",{"_61":1619,"_1293":1620,"_15":1032,"_1294":1621,"_19":1622,"_1296":1018},"<@ba.naturalinflict>自然附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.naturalinflict>自然附着</>最多叠加4层，叠加时会触发<#ba.naturalburst>自然爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_pulse\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>）+ <@ba.naturalinflict>自然附着</> = <#ba.corrupt>腐蚀</>","TermIcon/icon_term_ba_naturalinflict","wiki_tut_bat_nature","法术附着 - 自然","ba.naturalonchar",{"_61":1415,"_1293":1620,"_15":1623,"_1294":64,"_19":1625,"_1296":1018},"干员受到自然附着","ba.originium",{"_61":1628,"_1293":64,"_15":1626,"_1294":64,"_19":1629,"_1296":889},"管理员的连携技会对敌人附着源石结晶，使敌人无法行动。","源石结晶","ba.physicalstatus",{"_61":1632,"_1293":64,"_15":1630,"_1294":64,"_19":1633,"_1296":1044},"物理异常是通过物理方式对敌人施加的异常效果，包含<#ba.airborne>击飞</>、<#ba.knockdown>倒地</>、<#ba.crush>猛击</>、<#ba.fracture>碎甲</>。","物理异常","ba.physicalvul",{"_61":1636,"_1293":1637,"_15":1634,"_1294":64,"_19":1638,"_1296":1044},"一定时间内目标受到的<@ba.pd>物理伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_physicalvul","物理脆弱","ba.poiseknot",{"_61":1641,"_1293":64,"_15":1639,"_1294":1642,"_19":1643,"_1296":1052},"部分强大的敌人存在<@ba.poise>失衡节点</>。<@ba.poise>失衡值</>累积到<@ba.poise>失衡节点</>时，会打断敌人行动并让敌人踉跄。","wiki_tut_bat_poise_point","失衡节点","sys.manualCraftDish",{"_61":1646,"_1293":64,"_15":1644,"_1294":64,"_19":1647,"_1296":862},"精制食药可以作为<#sys.tacticalItem>战术物品</>使用。\n不同于<#sys.manualCraftTonic>应急食药</>，精致食药只能通过<#sys.manualCraft>简易制作</>获取。","精制食药","ba.pulseburst",{"_61":1650,"_1293":64,"_15":1648,"_1294":1651,"_19":1652,"_1296":1068},"<#ba.pulseinflict>电磁附着</> + <#ba.pulseinflict>电磁附着</>会触发<@ba.pulse>电磁爆发</>，对敌人造成一定<@ba.pulse>电磁伤害</>。","wiki_tut_bat_pulse_outbreak","法术爆发 - 电磁","item.portSoilMoss3",{"_61":1655,"_1293":1656,"_15":1653,"_1294":64,"_19":1657,"_1296":862},"可以在生态种植园中进行进行精细化培育以收获<#item.plantMoss3>砂叶</>的田块。\n由<#item.plantMossSeed3>砂叶种子</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量砂叶。","TermIcon/icon_term_item_item_portSoilMoss3","砂叶田块",{"_61":1659,"_1293":1521,"_15":1072,"_1294":1660,"_19":1661,"_1296":1068},"<@ba.pulseinflict>电磁附着</>是一种<#ba.spellinflict>法术附着</>。\n<@ba.pulseinflict>电磁附着</>最多叠加4层，叠加时会触发<#ba.pulseburst>电磁爆发</>。\n其他<#ba.spellinflict>法术附着</>（<image=\"BuffIcon/icon_energy_fusion_fire\" scale=1.25>/<image=\"BuffIcon/icon_energy_fusion_cryst\" scale=1.25>/<image=\"BuffIcon/icon_infliction_nature\" scale=1.25>）+ <@ba.pulseinflict>电磁附着</> = <#ba.conduct>导电</>","wiki_tut_bat_pulse","法术附着 - 电磁","ba.pulsevul",{"_61":1664,"_1293":1665,"_15":1662,"_1294":64,"_19":1666,"_1296":1068},"一定时间内目标受到的<@ba.pulse>电磁伤害</>提高（数值代表提高的幅度）。同类效果可以叠加。","TermIcon/icon_term_ba_pulsevul","电磁脆弱","ba.spelldmg",{"_61":1669,"_1293":64,"_15":1667,"_1294":1670,"_19":1671,"_1296":889},"伤害分为<@ba.pd>物理伤害</>、<@ba.key>法术伤害</>、<@ba.ether>超域伤害</>。\n其中，<@ba.key>法术伤害</>又分为<@ba.fire>灼热伤害</>、<@ba.pulse>电磁伤害</>、<@ba.cryst>寒冷伤害</>、<@ba.natur>自然伤害</>。","wiki_tut_bat_dmg_type","伤害类型","ba.return",{"_61":1674,"_1293":64,"_15":1672,"_1294":1675,"_19":1676,"_1296":64},"消耗技力后，满足一定条件时，重新获得的一部分技力。\n返还技力并不算作“恢复技力”，不会触发恢复技力时触发的效果，且这部分技力消耗时不会获得终结技能量。","wiki_tut_bat_return","返还技力","sys.manualCraftTonic",{"_61":1679,"_1293":64,"_15":1677,"_1294":64,"_19":1680,"_1296":862},"应急食药可以作为<#sys.tacticalItem>战术物品</>使用。\n可以通过<#sys.manualCraft>简易制作</>或工业设备生产获取。","应急食药","ba.rossi",{"_61":1683,"_1293":64,"_15":1681,"_1294":64,"_19":1684,"_1296":889},"洛茜的战技对敌人造成的特殊效果。受影响的目标会持续受到<@ba.pd>物理伤害</>，并且受到的物理和灼热伤害会增加。","爪印斫痕","item.ironPowder",{"_61":1687,"_1293":1688,"_15":1685,"_1294":64,"_19":1689,"_1296":862},"由<#item.ironNugget>蓝铁块</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成。","TermIcon/icon_term_item_ironPowder","蓝铁粉末","ba.shield",{"_61":1692,"_1293":64,"_15":1690,"_1294":1693,"_19":1694,"_1296":889},"护盾可以在持续时间内吸收伤害。部分护盾只会吸收特定类型的伤害。","wiki_tut_bat_shield","护盾","sys.manualCraftField",{"_61":1697,"_1293":64,"_15":1695,"_1294":64,"_19":1698,"_1296":862},"在<#sys.manualCraft>简易制作</>中，可将一些植物的种子与<#item.carbonMtl>碳块</>调配成对应植物的田块。\n可以进一步在生态种植区中对田块种植培育。","种植调配","ba.speedup",{"_61":1701,"_1293":1702,"_15":1699,"_1294":1703,"_19":1704,"_1296":889},"一定时间内目标的移动速度提高（数值代表提高的幅度）。同类效果可以叠加，直到达到上限。","TermIcon/icon_term_ba_speedup","wiki_tut_bat_speedup","加速","ba.spellburst",{"_61":1707,"_1293":64,"_15":1705,"_1294":64,"_19":1708,"_1296":889},"<@ba.key>法术爆发</>是同类型的<#ba.spellinflict>法术附着</>叠加时产生的伤害效果，包含<#ba.fireburst>灼热爆发</>、<#ba.pulseburst>电磁爆发</>、<#ba.crystburst>寒冷爆发</>、<#ba.naturalburst>自然爆发</>。","法术爆发","ba.spellinflict",{"_61":1711,"_1293":64,"_15":1709,"_1294":64,"_19":1712,"_1296":889},"<@ba.key>法术附着</>是一种附着在敌人身上的法术标记，包括<#ba.fireinflict>灼热附着</>、<#ba.pulseinflict>电磁附着</>、<#ba.crystinflict>寒冷附着</>、<#ba.naturalinflict>自然附着</>。\n同类型的<@ba.key>法术附着</>可以叠加，最多4层。","法术附着","item.procBattery1",{"_61":1715,"_1293":1716,"_15":1713,"_1294":64,"_19":1717,"_1296":862},"由<#item.glassCmpt>紫晶零件</>与<#item.originiumPowder>源石粉末</>通过工业设备封装得到的电池。\n可用于发电、设备充能或与据点进行交易。","TermIcon/icon_term_item_procBattery1","低容谷地电池","ba.spellinflictonchar",{"_61":1720,"_1293":64,"_15":1718,"_1294":64,"_19":1721,"_1296":889},"一些敌人的技能会给干员施加<#ba.burningonchar>灼热附着</>、<#ba.conductonchar>电磁附着</>、<#ba.frozenonchar>寒冷附着</>或<#ba.corruptonchar>自然附着</>。\n达到4层时，会分别让干员受到<#ba.burningonchar>燃烧</>、<#ba.conductonchar>导电</>、<#ba.frozenonchar>冻结</>或<#ba.corruptonchar>腐蚀</>。","干员受到法术附着/异常","ba.spellstatus",{"_61":1724,"_1293":64,"_15":1722,"_1294":64,"_19":1725,"_1296":889},"<@ba.key>法术异常</>是通过法术方式对敌人施加的异常效果，包含<#ba.burning>燃烧</>、<#ba.conduct>导电</>、<#ba.frozen>冻结</>、<#ba.corrupt>腐蚀</>。","法术异常","ba.statuslevel",{"_61":1728,"_1293":64,"_15":1726,"_1294":64,"_19":1729,"_1296":889},"异常等级等于触发<#ba.physicalstatus>物理异常</>或<#ba.spellstatus>法术异常</>时<#ba.consume>消耗</>的<#ba.noguard>破防</>或<#ba.spellinflict>法术附着</>层数（最高4级）。<#ba.statuslevel>异常等级</>越高，<#ba.physicalstatus>物理异常</>和<#ba.spellstatus>法术异常</>的效果就越强。","异常等级","ba.weak",{"_61":1732,"_1293":1733,"_15":1730,"_1294":1734,"_19":1735,"_1296":889},"一定时间内目标造成的伤害降低（数值代表降低的幅度）。同类效果会以非线性方式叠加。","TermIcon/icon_term_ba_weak","wiki_tut_bat_weak","虚弱","item.bbflower",{"_61":1738,"_1293":1739,"_15":1736,"_1294":64,"_19":1740,"_1296":862},"一种可在野外采集的植物，内含易燃易爆成分。\n可使用工业设备培育获得，或在<#item.portSoilBbflower>酮化灌木田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.bbflowerPowder>酮化灌木粉末</>。","TermIcon/icon_term_item_bbflower","酮化灌木","item.bbflowerSeed",{"_61":1743,"_1293":1744,"_15":1741,"_1294":64,"_19":1745,"_1296":862},"由<#item.bbflower>酮化灌木</>通过工业设备采种得到的种子。\n在工业设备中种植酮化树种，可获得酮化灌木。\n将酮化树种与<#item.carbonMtl>碳块</>一起进行<#sys.manualCraftField>种植调配</>，可以获得<#item.portSoilBbflower>酮化灌木田块</>。","TermIcon/icon_term_item_bbflowerSeed","酮化树种","item.plantMoss3",{"_61":1748,"_1293":1749,"_15":1746,"_1294":64,"_19":1750,"_1296":862},"一种可在野外采集的叶片粗粝的植物。\n可使用工业设备培育获得，或在<#item.portSoilMoss3>砂叶田块</>中种植获得。\n也可使用工业设备对其进行加工，比如在粉碎后得到<#item.plantMossPowder3>砂叶粉末</>。","TermIcon/icon_term_item_plantMoss3","砂叶","item.bottledRecHp1",{"_61":1753,"_1293":1754,"_15":1751,"_1294":64,"_19":1755,"_1296":862},"由<#item.plantMossPowder1>荞花粉末</>与<#item.glassBottle>紫晶质瓶</>通过<#sys.manualCraft>简易制作</>或工业设备灌装得到的胶囊。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。\n","TermIcon/icon_term_item_bottledRecHp1","荞愈胶囊","item.carbonMtl",{"_61":1758,"_1293":1759,"_15":1756,"_1294":64,"_19":1760,"_1296":862},"由<#item.plantMoss1>荞花</>通过工业设备精炼得来的碳材料。\n是<#sys.manualCraftField>种植调配</>田块必不可少的材料，也可用于其他材料的合成。","TermIcon/icon_term_item_carbonMtl","碳块","item.crystalShell",{"_61":1763,"_1293":1764,"_15":1761,"_1294":64,"_19":1765,"_1296":862},"由<#item.originium>源矿</>通过工业设备精炼后得到的外壳。\n可用于其他材料合成。\n","TermIcon/icon_term_item_crystalShell","晶体外壳","item.plantMoss1",{"_61":1768,"_1293":1769,"_15":1766,"_1294":64,"_19":1770,"_1296":862},"荞花是一种可在野外采集的艳丽花朵。\n可使用工业设备培育获得，或在<#item.portSoilMoss1>荞花田块</>中种植获得。\n可用于<#sys.tacticalItem>战术物品</>制作或其他材料合成。","TermIcon/icon_term_item_plantMoss1","荞花","item.plantMossPowder1",{"_61":1773,"_1293":1774,"_15":1771,"_1294":64,"_19":1775,"_1296":862},"由<#item.plantMoss1>荞花</>通过<#sys.manualCraft>简易制作</>或工业设备粉碎后得到的粉末。\n使用后，可以回复干员的生命值。也可作为<#sys.tacticalItem>战术物品</>进行装备。","TermIcon/icon_term_item_plantMossPowder1","荞花粉末","item.plantMossPowder3",{"_61":1778,"_1293":1779,"_15":1776,"_1294":64,"_19":1780,"_1296":862},"由<#item.plantMoss3>砂叶</>通过工业设备粉碎后得到的粉末。\n可用于其他材料合成，常用于研磨。","TermIcon/icon_term_item_plantMossPowder3","砂叶粉末","item.plantMossSpc1",{"_61":1783,"_1293":1784,"_15":1781,"_1294":64,"_19":1785,"_1296":862},"映火荞花是一种可在野外采集的特殊艳丽花朵。\n在采集<#item.plantMoss1>荞花</>时有概率额外获得映火荞花。\n可用于<#sys.tacticalItem>战术物品</>制作。","TermIcon/icon_term_item_plantMossSpc1","映火荞花","item.plantSp1",{"_61":1788,"_1293":1789,"_15":1786,"_1294":64,"_19":1790,"_1296":862},"灰芦麦是一种可在野外采集的作物，也可在<#item.portSoilSp1>灰芦麦田块</>中种植获得。\n可直接用于<#sys.manualCraftDish>精制食药</>的制作。","TermIcon/icon_term_item_plantSp1","灰芦麦","item.portSoilBbflower",{"_61":1793,"_1293":1794,"_15":1791,"_1294":64,"_19":1795,"_1296":862},"可以在生态种植园中进行进行精细化培育以收获<#item.bbflower>酮化灌木</>的田块。\n由<#item.bbflowerSeed>酮化树种</>与<#item.carbonMtl>碳块</>一起进行种植调配获得。\n收获时可获得大量酮化灌木。","TermIcon/icon_term_item_portSoilBbflower","酮化灌木田块","item.procBomb",{"_61":1798,"_1293":1799,"_15":1796,"_1294":64,"_19":1800,"_1296":862},"工业爆炸物是一种可生产的爆炸物。\n由<#item.glassCmpt>紫晶零件</>与<#item.bbflowerPowder>酮化灌木粉末</>通过工业设备封装后获得。\n使用工业爆炸物，可对爆炸范围内的敌人造成伤害，也可对范围内可被爆破的物体造成破坏。","TermIcon/icon_term_item_procBomb","工业爆炸物","item.quartzGlass",{"_61":1803,"_1293":1804,"_15":1801,"_1294":64,"_19":1805,"_1296":862},"由<#item.quartzSand>紫晶矿</>通过工业设备精炼后得到的纤维。\n可用于其他材料合成。","TermIcon/icon_term_item_quartzGlass","紫晶纤维",{"_513":1807,"_528":1809,"_538":1811,"_547":1813,"_549":1815,"_559":1817,"_561":1819,"_1821":1822},{"_15":513,"_65":513,"_19":1808,"_40":109},"强固模具",{"_15":528,"_65":528,"_19":1810,"_40":112},"轻黯石",{"_15":538,"_65":538,"_19":1812,"_40":112},"中黯石",{"_15":547,"_65":547,"_19":1814,"_40":112},"重型强固模具",{"_15":549,"_65":549,"_19":1816,"_40":112},"重黯石",{"_15":559,"_65":559,"_19":1818,"_40":41},"三相纳米片",{"_15":561,"_65":561,"_19":1820,"_40":41},"燎石","item_gold",{"_15":1821,"_65":1821,"_19":1823,"_40":112},"折金票"]
