[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_766":767},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_claym_0016","slug","phantom-pain","name","幻想苦痛","type","weapon","version","1.6",{"_26":27,"_56":57,"_96":97,"_509":510,"_571":572},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_41":42,"_43":44,"_45":46,"_47":16,"_48":49,"_50":51,"_54":55},"breakthroughTemplateId","weapon_breakthrough_456star_C_1","engName","Phantom Pain","levelTemplateId","weapon_upgrade_curve_6star_0.99","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_claym_0016.prefab","potentialUpItemList",[40],"item_wpnpotentialup_bp","rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","你还在折磨我。\n我很清楚这件事，这是我第一千二百九十九次试图忘记你，试图无视你对我的勾引，但我失败了……我们曾是那样地亲密无间，曾相互陪伴着一起走过这么长的岁月，这些我怎么可能忘记……\n我亲爱的左手。\n因为材料学实验中受到侵蚀而将你切下已经过去了将近一年，但我仍能感受到你，每一次屈伸手指，每一次挥动手掌，我都能感受到你对我的回馈。医生说我这是常见的幻肢痛，需要放松心情，接受治疗和疏导，但我很清楚，他这是在胡说八道。\n我只是与你分开了，但我并没有失去你，这件事我很清楚，我知道你在哪儿，只是我暂时无法抵达你的身边。\n你就在超域之中。\n…………\n超域，亲爱的，这是我们一起面对过的，最大的困局。从还是学生开始，一直到加入轻超域技术实验室，我们的生活一直和这两个字息息相关，这个世界上还有什么人比我们更了解这东西吗？我想应该是没有了……不……应该是有的……终末地的那些人……商会、工团那几个顶尖的实验室，游荡在荒地上的古怪人才，他们都很了解。\n所以我茫然了，亲爱的，找不到你这件事让我意识到原来我并不了解超域。超域内是不会存在生命的，因此我本不应该感受到你，但自断腕处传来的温柔触感又是如此清晰，我思维的一部分开始与我思维的另一部分厮杀，其结果就是这么多年来搭建起的认知体系轰然崩塌。\n我想我应该出去走走。\n…………\n他们开始给我注射镇定剂了。\n…………\n我去找了老同学，我们从小一起长大，一起学习，互相攀比研究项目和工资，他诧异于我为什么问他这么浅显的问题……我询问他怎样看待超域，他却反问我如何看待日升月落，如何看待春夏秋冬。我说，我便是春夏秋冬的一部分，我的一部分在日升月落中。\n他报警了，菈梵朵玛警察来得很快。\n…………\n这里应该是工团的某一个自动化农场，我费了好大力气才和负责安保的退役老铁誓军说清楚我并非化装潜入的裂地者。他给了我一些食物，我们坐在火炉前，用彼此仅剩的右手碰杯。我也问了他那个问题，他的眼中亮起愤怒、仇恨以及一点点怯懦的光芒。把酒喝干后，他和我讲了一个小时候听来的故事，一个有关杀死大海的故事。\n他的心里有一团火，我不能让他灼伤你，万幸，我还剩下一些安眠药。\n…………\n我对你的感觉更清晰了。\n…………\n那个坐在巢雕群中的女人，那个阿达克利斯，哈哈，她以为自己的表演很精彩，但我看穿了她。你曾为我翻过那么多书页，其中记录过那些征服者，那些君主……我能清楚地辨识出这种人的谎言。听听她的声音，看看她粉饰过的空洞躯壳，她将超域当成工具……当然，也可能是过度饥饿让我的判断出了问题。如果她演技中的演技骗过了我，那她真是好样的。\n…………\n我无法等待了，我要去找你。那擅使雷法的天师没有发现我，我悄悄地到了禁区之中……这里应该能找到通向你的道路。\n…………\n真漂亮，这些颜色。走吧，走吧……就让我融入其中。","weaponId","weaponPotentialSkill","sk_wpn_claym_0016","weaponSkillList",[52,53,49],"wpn_attr_str_high","wpn_sp_attr_phy_spell_high","weaponType",3,"itemTable",{"_58":59,"_60":61,"_62":63,"_64":65,"_66":16,"_15":16,"_67":68,"_69":68,"_70":71,"_19":20,"_72":73,"_74":65,"_75":76,"_77":78,"_79":65,"_80":81,"_83":84,"_41":42,"_85":59,"_86":87,"_88":89,"_90":91,"_21":92,"_93":59,"_94":95},"backpackCanDiscard",false,"decoDesc","轻超域技术实验室的实验型产品，剑身使用了前沿性材料，因此重量极轻。当然，它的破坏力并未降低。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[82],"item_obtain_bp","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",69,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_98":99},"list",[100,107,110,112,116,118,120,124,128,132,135,139,143,147,152,156,161,166,171,175,179,184,189,194,199,204,209,214,219,224,228,233,238,243,248,253,258,262,267,272,276,281,286,291,296,301,306,311,316,321,325,330,335,340,344,349,354,359,364,368,373,378,383,388,392,397,402,407,412,416,420,425,430,435,439,444,449,454,459,463,467,472,477,482,485,490,495,500,504,508],{"_101":102,"_103":104,"_105":87,"_106":95},"baseAtk",50,"lvUpExp",10,"lvUpGold","weaponLv",{"_101":108,"_103":104,"_105":87,"_106":109},54,2,{"_101":111,"_103":104,"_105":87,"_106":55},59,{"_101":113,"_103":114,"_105":87,"_106":115},64,20,4,{"_101":91,"_103":117,"_105":87,"_106":92},40,{"_101":119,"_103":102,"_105":87,"_106":42},74,{"_101":121,"_103":122,"_105":87,"_106":123},79,80,7,{"_101":125,"_103":126,"_105":87,"_106":127},84,110,8,{"_101":129,"_103":130,"_105":87,"_106":131},89,150,9,{"_101":133,"_103":134,"_105":104,"_106":104},94,200,{"_101":136,"_103":137,"_105":104,"_106":138},99,270,11,{"_101":140,"_103":141,"_105":104,"_106":142},104,370,12,{"_1