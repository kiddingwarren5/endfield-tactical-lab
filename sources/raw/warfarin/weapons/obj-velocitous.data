[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_753":754},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_pistol_0012","slug","obj-velocitous","name","O.B.J.迅极","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_505":506,"_567":568},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_2","engName","OBJ Velocitous","levelTemplateId","weapon_upgrade_curve_5star_1","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_pistol_0012.prefab","potentialUpItemList",[],"rarity",5,"talentTemplateId","wpn_potential_456star","weaponDesc","我曾三次举起手铳。\n第一次举起手铳，我以为全世界都握在了我的手上。\n我与父亲爆发了一场争吵，我并不想为了所谓的前程去读工团的医学院。我躲到了自己的被窝里，偷偷在终端上看父亲从不允许我看的影像：高举着铳的伊比利亚审判官、所向披靡的拉特兰铳骑。我学着终端上的影像，摆弄着父亲的手铳，想象着源石技艺顺着我的手指传入源石回路，让那颗并不存在的蚀刻弹药在墙上射出个窟窿。\n…………\n第二次举起手铳，我以为这会是我最后一次握住它。\n我从四号谷地出发，前往附近的一个聚落执行外勤医疗救助任务。但在任务的过程中，我们遇到了一群凶残的裂地者。此时此刻，我们都只感到惊慌。为什么在如此靠近四号谷地的地方会遇见裂地者？\n我打开源石通信设备，想要向谷地要塞求救。裂地者的叫嚷声越来越近，我调试频段的手也越来越快，但设备里却只传出了杂音。我举起手铳，盲目地扣动扳机，带着孩子们向位于地平线上的谷地要塞拼命奔跑。\n…………\n我不记得在荒野上跑了多久，只知道天色已晚。身后追赶我们的裂地者早已不见了踪影，但我不敢带着孩子们返回聚落，万一是个陷阱呢？挨了几支弩箭之后，我的视线便开始模糊，看不清远处谷地要塞的轮廓，只能凭借记忆里乘车时看到的景象向前摸索。\n…………\n我太累了，倒头栽了下去，我的身体蜷成一团，孩子们哭着围上来摇着我的躯体。我告诉自己不要睡着，但最终还是闭上了眼。第二天醒来时，我发现自己正躺在另一个灰医生的驻地里。这时我才知道，昨晚我们走错了方向，这里离四号谷地已经很远，是孩子们的哭声将他吸引了过来……\n有了这次经历，我感觉到自己的无力。我只是个普通的医生，不如等身体恢复了就递交辞呈，回去继承家里的诊所。\n…………\n第三次举起手铳，是因为一枚勋章。\n我在梦中找回了学生时代的记忆。我记得父亲正板着一张脸，听医学院的几位老师说我是怎样的一个怪胎。后来，父亲来到了我的宿舍，但他没有收走我的终端，反而是和我一起坐下看着里面的影像。也是在这时，我看见父亲从胸前的口袋里取出了一枚他从未佩戴过的勋章。\n我又梦见了许多。我好像来到了影像里的那片大地，手持铳械在一片原野上奔跑，那枚勋章变成了一颗子弹，向天空射击。\n梦到这里便醒了，这场梦似乎抽走了我所有的力气。\n正当我在病床上汗如雨下时，外面传来了阵阵惊呼声。不止是裂地者，还有锚点？\n我从枕头下摸出那把手铳，那是父亲得知我入职终末地工业后送我的礼物。\n此时此刻，我知道我还会继续举起这把手铳，无论是第四次、第五次，还是第六次……","weaponId","weaponPotentialSkill","sk_wpn_pistol_0012","weaponSkillList",[51,52,48],"wpn_attr_agi_mid","wpn_sp_attr_usgs_mid","weaponType",6,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":41,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","终末地工业出品的系列制式装备。由资深武库工程师奥佩罗所组建的原型创意组设计。采用轻量材质，扎实耐用。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",32,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,120,124,128,132,135,139,143,147,152,156,161,165,170,174,178,183,188,193,198,203,208,213,218,223,227,232,236,241,246,251,256,260,265,270,274,279,283,288,293,298,302,307,312,317,321,326,331,336,340,345,349,354,358,363,368,373,377,382,387,392,396,401,406,411,415,419,424,429,434,438,443,448,453,457,461,466,471,475,480,484,489,493,498,503],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",42,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},46,2,{"_99":109,"_101":102,"_103":86,"_104":110},50,3,{"_99":112,"_101":113,"_103":86,"_104":114},54,20,4,{"_99":116,"_101":117,"_103":86,"_104":41},58,40,{"_99":119,"_101":109,"_103":86,"_104":54},62,{"_99":121,"_101":122,"_103":86,"_104":123},66,80,7,{"_99":125,"_101":126,"_103":86,"_104":127},71,110,8,{"_99":129,"_101":130,"_103":86,"_104":131},75,150,9,{"_99":133,"_101":134,"_103":102,"_104":102},79,200,{"_99":136,"_101":137,"_103":102,"_104":138},83,270,11,{"_99":140,"_101":141,"_103":102,"_104":142},87,370,12,{"_99":144,"_101":145,"_103":113,"_104":146},91,480,13,{"_99":148,"_101":149,"_103":150,"_104":151},95,620,30,14,{"_99":153,"_101":154,"_103":109,"_104":155},100,