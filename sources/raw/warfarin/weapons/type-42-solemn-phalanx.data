[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_833":834},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_funnel_0016","slug","type-42-solemn-phalanx","name","四二式·肃阵","type","weapon","version","1.6",{"_26":27,"_55":56,"_95":96,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_E_3","engName","Type 42: Solemn Phalanx","levelTemplateId","weapon_upgrade_curve_6star_1.02","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_funnel_0016.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","尊敬的宏山科学院天师：\n你们好。\n这封信，我已思忖许久，实在不知道该寄给谁。只能拜托一位在贵院的友人，代笔写下这封感谢信，并随信附上一面我专程定制的锦旗，以及一箱薄礼。恳请各位能将这份谢意，转交给那三位曾救我一命的恩人。\n我是环塔商会的一名行商，常年奔走于各地。前段时间，我在合金萝卜城附近的一处矿镇稍作休整，本来只是为了补充物资，没想到当夜就遭遇了天使袭击。天气突然变得十分恶劣，环塔商会的企业安保人员很难即刻抵达，我与镇上居民只能各自躲藏，以求自保。\n那天晚上，我藏身在矿镇边缘一处废弃厂房的高处，正因如此，才目睹了之后发生的一切。\n有三个人，自镇外那片不知何时出现的侵蚀中走来。他们使用着我从未见过的装备，看似厚重，行动却异常利落。黑暗之中，时而有微光亮起，伴随着低沉声响，犹如裂兽嘶鸣——我无法确切形容那是什么，只知道他们使用的绝非常见之物。三人分散行动，其中一人在天使群中冲杀，另外两人则只是站在高处，不时出手解决掉意外游荡至镇民附近的天使。三人默契非常，仿佛在执行一件早已重复过无数遍的任务。我行商多年，见过不少工人卫队，或是企业安保人员战斗的场面，而那一夜的景象——特别是在天使群中冲杀的那一位，我从未见过这般身手，就像是炎国古话里说的“一人成军”那样——至今仍清晰地烙印在我的脑海之中。\n虽然天使引发的骚乱很快被他们平息，但我们一直躲藏至天明，直到几名胆大的镇民率先出去探查，才敢走出各自的藏身处。危险消失了，只留下满地碎石，那三人也不见了踪影。尽管不知道他们的姓名，但我确信，他们并非本地住民，也非镇民们所猜测的萨卡兹雇佣兵——他们的行事风格与装备样式，让我坚信他们一定来自宏科院。\n他们救了我的命，也救了矿镇所有居民的命，这种恩情我们不敢忘。我沿商路打听了几日，却无人知晓他们的来历。思虑再三，唯有将感谢信与锦旗送至宏科院，祈盼各位天师能将我们的感激之情，转达给那三位行走于侵蚀之中的人。信不长，金票不多，锦旗也不是什么重礼，却已是我们所能尽的最大心意。\n倘若此信有幸被转交，也请代我们告诉他们：那一夜，有人看见了，也始终记得。\n一名行商 敬上\n\n“……给我干嘛，我只是路过。我就教了他们些小把戏。就是他们三个？所以他们知道咯？难怪写报告都这么高兴。行了，我很忙，你们自行处置，别给我！传出去还以为我多闲呢。”","weaponId","weaponPotentialSkill","sk_wpn_funnel_0016","weaponSkillList",[51,52,48],"wpn_attr_wisd_high","wpn_sp_attr_usgs_high","weaponType",2,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":91,"_92":58,"_93":94},"backpackCanDiscard",false,"decoDesc","宏山选剑局研发的制式施术单元，应龙特勤队的现役装备之一。拥有优异的稳定性与功能性，能够适应严苛的环境。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",73,5,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_97":98},"list",[99,106,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,267,272,276,281,286,291,295,300,305,310,315,320,324,328,333,338,343,348,352,357,362,367,372,376,381,386,391,396,400,405,410,415,419,423,428,432,437,442,447,451,456,461,465,470,474,479,484,489,494,497,502,506],{"_100":101,"_102":103,"_104":86,"_105":94},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_100":107,"_102":103,"_104":86,"_105":54},56,{"_100":109,"_102":103,"_104":86,"_105":110},61,3,{"_100":112,"_102":113,"_104":86,"_105":114},66,20,4,{"_100":116,"_102":117,"_104":86,"_105":91},71,40,{"_100":119,"_102":120,"_104":86,"_105":41},77,50,{"_100":122,"_102":123,"_104":86,"_105":124},82,80,7,{"_100":126,"_102":127,"_104":86,"_105":128},87,110,8,{"_100":130,"_102":131,"_104":86,"_105":132},92,150,9,{"_100":134,"_102":135,"_104":103,"_105":103},97,200,{"_100":137,"_102":138,"_104":103,"_105":139},102,270,11,{"_100":141,"_102":142,"_104":103,"_105":143},107,370,12,{"_100":145,"_102":146,"_104":113,"_105":147},112,480,13,{"_100":149,"_102":150,"_104":151,"_105":152},117,620,30,14,{"_100":154,"_102":155,"_104":120,"_105":156},122,780,15,{"_100":158,"_102":159