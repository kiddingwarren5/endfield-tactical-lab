[{"_1":2,"_4":5,"_6":7},"root",{"_3":-5},"data","routes/$lang",{"_3":-5},"routes/$lang.weapons.$slug",{"_3":8},{"_9":10,"_11":12},"lang","cn","response",{"_13":14,"_3":25,"_773":774},"meta",{"_15":16,"_17":18,"_19":20,"_9":10,"_21":22,"_23":24},"id","wpn_lance_0014","slug","bedazzling-night-debut","name","曜夜的首演","type","weapon","version","1.6",{"_26":27,"_55":56,"_94":95,"_508":509,"_570":571},"weaponBasicTable",{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":16,"_47":48,"_49":50,"_53":54},"breakthroughTemplateId","weapon_breakthrough_456star_A_3","engName","Bedazzling Night Debut","levelTemplateId","weapon_upgrade_curve_6star_1.01","maxLv",90,"modelPath","Gameplay/Prefabs/Weapons/wpn_lance_0014.prefab","potentialUpItemList",[],"rarity",6,"talentTemplateId","wpn_potential_456star","weaponDesc","青年第六次看向房间内的钟表。\n随着指针缓缓移向左下的数字，他已经在这个房间等候了三个小时。\n三个小时——够他开完两场例行会议，处理四个集团的诉求，外加写一份重建进展报告，为下次联席会议提供议题了。\n换作平常，青年不会允许自己的时间被这样挥霍，但说服房间主人放弃那个提案的意义是如此重要，让他甚至愿意违背一些固有的习惯。\n比如这段望不见头的枯坐等候，又比如此刻耐性不足的贸然发言：“先生，无论如何，我希望您能再认真考虑一下。菈梵朵玛才建成不到半年，目前至少还有四成的设施需要尽早完工，不少居民连住处都是临时的，音乐节可以再等等——”\n“玛尔斯。”老者——也是房间的主人，轻声打断了青年语速越来越快的话语，然后在那张古高卢样式高脚桌上为老式唱片机换了张碟。\n宛如夏日海岸边徐徐晚风的旋律就这样吹遍了整个房间。\n“听听，我最喜欢的一张——《退潮》，是我外公的成人礼礼物。听说这张碟在当年的汐斯塔很难找，只有一家唱片店能找到……”\n望着老者略显陶醉的神情，青年只能暗自叹了口气，干巴巴地附和了一句：“旋律很美……我不否认。”\n随后他又紧紧地握住了椅子的扶手，“先生，我是在塔卫二出生的，或许我不如您了解泰拉的音乐，也缺乏对艺术的鉴赏能力……但身为菈梵朵玛建设项目的主管，我必须为更多人的生计负责。您想必是清楚的，以您对环塔商会的贡献，绝不会有哪家企业愿意公然反对您的提案，但这不代表他们就觉得应该在这个节骨眼上办一次那种规模的大型音乐节，否则——”\n“你就不会在这里，试图劝谏一位顽固的老人。”老者心平气和地接下了青年的话，慢悠悠地调试了一下唱片机，让稍有卡顿的部分变得流畅起来。“我很清楚。不管是菈梵朵玛的现状，还是其他集团的顾虑……但在我看来，这些正是我决心举办音乐节的原因。”\n“……这是什么意思？”\n“玛尔斯，我们不能只是‘活下去’。绝不能。\n“每个人都需要一个契机、一个理由，让自己能在短暂的时间里得以走出囚笼，为困苦的内心找到些许慰藉——而从汐斯塔到菈梵朵玛，没有什么是比‘音乐节’更合适的答案了。\n“我无比地渴望，渴望将记忆中的那片海岸带到这里，让更多的年轻人看看它……最好是记住它。”\n唱片刚好播至了最后一曲，青年似乎也沉浸在了这段颇为悠远的乐段里，直到曲终才沉声作出了回应。\n“您的意思……我大概理解了。但您必须明白，以我们当下的财政状况，负担不起一场大规模的音乐节庆典。”\n老者只是笑了笑，像是早就料到他会这么说一样，从装唱片的架子上拿下来一个圆铁盒，将它郑重地放到了青年的手中。\n“里面不是唱片？这是……您个人的资产记录？等等，这份授权书难道是……”\n“嗯，我想趁着我还能动弹的时候，把它们用在有点意义的事情上……而不是沦为他人争夺的一堆废纸。”\n“我明白了。对了……虽然只是粗估，但以我个人的经验，一场公众娱乐活动还用不完这里面的一张纸，剩余的您打算……？”\n“给那些被迫拿起武器的音乐家，给那些刚起步的唱片公司，给一切能为人们带来笑容的事业——\n“只要能为菈梵朵玛的夜空送去更多的星光，怎样都是值得的。”","weaponId","weaponPotentialSkill","sk_wpn_lance_0014","weaponSkillList",[51,52,48],"wpn_attr_will_high","wpn_sp_attr_heal_high","weaponType",5,"itemTable",{"_57":58,"_59":60,"_61":62,"_63":64,"_65":16,"_15":16,"_66":67,"_68":67,"_69":70,"_19":20,"_71":72,"_73":64,"_74":75,"_76":77,"_78":64,"_79":80,"_82":83,"_40":41,"_84":58,"_85":86,"_87":88,"_89":90,"_21":54,"_91":58,"_92":93},"backpackCanDiscard",false,"decoDesc","梅什科工业专为流行艺术家定制的高端线产品。梦幻张扬的麦克风造型搭配意外强劲的性能，让不少试用者都印象深刻。","desc","终末地干员用武器，装备之后可以显著提升干员的作战能力。","iconCompositeId","","iconId","maxBackpackStackCount",-1,"maxStackCount","modelKey","int_drop_weapon","noObtainWayConditionId",[],"noObtainWayHint","noObtainWayId",[],"notObtainShow",true,"notObtainShowTimeId","obtainWayIds",[81],"item_obtain_payshop_weapon","outcomeItemIds",[],"showAllDepotCount","showingType",0,"sortId1",-35,"sortId2",74,"valuableDepotRedDot","valuableTabType",1,"weaponUpgradeTemplateTable",{"_96":97},"list",[98,105,108,111,115,118,121,125,129,133,136,140,144,148,153,157,162,167,172,176,180,185,190,195,200,205,210,215,220,225,229,234,239,244,249,254,259,263,268,273,277,282,287,292,297,302,307,312,317,322,326,330,335,340,345,350,354,359,364,369,374,378,383,388,393,398,402,407,412,417,421,425,430,435,439,444,448,453,458,463,467,471,475,480,485,490,493,498,502,507],{"_99":100,"_101":102,"_103":86,"_104":93},"baseAtk",51,"lvUpExp",10,"lvUpGold","weaponLv",{"_99":106,"_101":102,"_103":86,"_104":107},56,2,{"_99":109,"_101":102,"_103":86,"_104":110},61,3,{"_99":112,"_101":113,"_103":86,"_104":114},66,20,4,{"_99":116,"_101":117,"_103":86,"_104":54},71,40,{"_99":119,"_101":120,"_103":86,"_104":41},76,50,{"_99":122,"_101":123,"_103":86,"_104":124},81,80,7,{"_99":126,"_101":127,"_103":86,"_104":128},86,110,8,{"_99":130,"_101":131,"_103":86,"_104":132},91,150,9,{"_99":134,"_101":135,"_103":102,"_104":102},96,200,{"_99":137,"_10